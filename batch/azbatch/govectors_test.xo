fn show_replace_node_user_response(r: ReplaceNodeUserResponse) -> Str {
  var parts: List[Str] = []
  if let Some(v) = r.client_request_id {
    parts.push("ClientRequestID=${v}")
  }
  if let Some(v) = r.data_service_id {
    parts.push("DataServiceID=${v}")
  }
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  if let Some(v) = r.last_modified {
    parts.push("LastModified=${t3339(v)}")
  }
  if let Some(v) = r.request_id {
    parts.push("RequestID=${v}")
  }
  parts.join(" ")
}

