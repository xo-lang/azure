  match c.update_pool("id1/ x", (json.decode_str[UpdatePoolContent]("{\"applicationPackageReferences\":[{\"applicationId\":\"s-applicationid\",\"version\":\"s-version\"}],\"certificateReferences\":[{\"storeLocation\":\"s-storelocation\",\"storeName\":\"s-storename\",\"thumbprint\":\"s-thumbprint\",\"thumbprintAlgorithm\":\"s-thumbprintalgorithm\",\"visibility\":[\"s-visibility\"]}],\"displayName\":\"s-displayname\",\"enableInterNodeCommunication\":true,\"metadata\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"mountConfiguration\":[{\"azureBlobFileSystemConfiguration\":{\"accountKey\":\"s-accountkey\",\"accountName\":\"s-accountname\",\"blobfuseOptions\":\"s-blobfuseoptions\",\"containerName\":\"s-containername\",\"identityReference\":{\"resourceId\":\"s-resourceid\"},\"relativeMountPath\":\"s-relativemountpath\",\"sasKey\":\"s-saskey\"},\"azureFileShareConfiguration\":{\"accountKey\":\"s-accountkey\",\"accountName\":\"s-accountname\",\"azureFileUrl\":\"s-azurefileurl\",\"mountOptions\":\"s-mountoptions\",\"relativeMountPath\":\"s-relativemountpath\"},\"cifsMountConfiguration\":{\"mountOptions\":\"s-mountoptions\",\"password\":\"s-password\",\"relativeMountPath\":\"s-relativemountpath\",\"source\":\"s-source\",\"username\":\"s-username\"},\"nfsMountConfiguration\":{\"mountOptions\":\"s-mountoptions\",\"relativeMountPath\":\"s-relativemountpath\",\"source\":\"s-source\"}}],\"networkConfiguration\":{\"dynamicVNetAssignmentScope\":\"s-dynamicvnetassignmentscope\",\"enableAcceleratedNetworking\":true,\"endpointConfiguration\":{\"inboundNATPools\":[{\"backendPort\":7,\"frontendPortRangeEnd\":7,\"frontendPortRangeStart\":7,\"name\":\"s-name\",\"protocol\":\"s-protocol\"}]},\"publicIPAddressConfiguration\":{\"ipAddressIds\":[\"s-ipaddressids\"],\"provision\":\"s-ipaddressprovisioningtype\"},\"subnetId\":\"s-subnetid\"},\"resourceTags\":{\"k1\":\"s-resourcetags\"},\"startTask\":{\"commandLine\":\"s-commandline\",\"containerSettings\":{\"containerHostBatchBindMounts\":[{\"isReadOnly\":true,\"source\":\"s-source\"}],\"containerRunOptions\":\"s-containerrunoptions\",\"imageName\":\"s-imagename\",\"registry\":{\"identityReference\":{\"resourceId\":\"s-resourceid\"},\"password\":\"s-password\",\"registryServer\":\"s-registryserver\",\"username\":\"s-username\"},\"workingDirectory\":\"s-workingdirectory\"},\"environmentSettings\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"maxTaskRetryCount\":7,\"resourceFiles\":[{\"autoStorageContainerName\":\"s-autostoragecontainername\",\"blobPrefix\":\"s-blobprefix\",\"fileMode\":\"s-filemode\",\"filePath\":\"s-filepath\",\"httpUrl\":\"s-httpurl\",\"identityReference\":{\"resourceId\":\"s-resourceid\"},\"storageContainerUrl\":\"s-storagecontainerurl\"}],\"userIdentity\":{\"autoUser\":{\"elevationLevel\":\"s-elevationlevel\",\"scope\":\"s-scope\"},\"username\":\"s-username\"},\"waitForSuccess\":true},\"targetNodeCommunicationMode\":\"s-targetnodecommunicationmode\",\"taskSchedulingPolicy\":{\"nodeFillType\":\"s-nodefilltype\"},\"taskSlotsPerNode\":7,\"upgradePolicy\":{\"automaticOSUpgradePolicy\":{\"disableAutomaticRollback\":true,\"enableAutomaticOSUpgrade\":true,\"osRollingUpgradeDeferral\":true,\"useRollingUpgradePolicy\":true},\"mode\":\"s-mode\",\"rollingUpgradePolicy\":{\"enableCrossZoneUpgrade\":true,\"maxBatchInstancePercent\":7,\"maxUnhealthyInstancePercent\":7,\"maxUnhealthyUpgradedInstancePercent\":7,\"pauseTimeBetweenBatches\":\"s-pausetimebetweenbatches\",\"prioritizeUnhealthyInstances\":true,\"rollbackFailedInstancesOnPolicyBreach\":true}},\"userAccounts\":[{\"elevationLevel\":\"s-elevationlevel\",\"linuxUserConfiguration\":{\"gid\":7,\"sshPrivateKey\":\"s-sshprivatekey\",\"uid\":7},\"name\":\"s-name\",\"password\":\"s-password\",\"windowsUserConfiguration\":{\"loginMode\":\"s-loginmode\"}}],\"virtualMachineConfiguration\":{\"containerConfiguration\":{\"containerImageNames\":[\"s-containerimagenames\"],\"containerRegistries\":[{\"password\":\"s-password\",\"registryServer\":\"s-regist