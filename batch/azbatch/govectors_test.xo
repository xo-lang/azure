test "Go's NewListJobSchedulesPager" {
  let f = new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, EP, Cred{}, opts())
  set(f, 200, "{\"odata.nextLink\":\"https://batch.example.test/next?\$skiptoken=2\",\"value\":[{\"creationTime\":\"2026-11-06T10:00:00Z\",\"displayName\":\"s-displayname\",\"eTag\":\"s-etag\",\"executionInfo\":{\"endTime\":\"2026-11-06T10:00:00Z\",\"nextRunTime\":\"2026-11-06T10:00:00Z\",\"recentJob\":{\"id\":\"s-id\",\"url\":\"s-url\"}},\"id\":\"s-id\",\"jobSpecification\":{\"allowTaskPreemption\":true,\"commonEnvironmentSettings\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"constraints\":{\"maxTaskRetryCount\":7,\"maxWallClockTime\":\"s-maxwallclocktime\"},\"displayName\":\"s-displayname\",\"jobManagerTask\":{\"allowLowPriorityNode\":true,\"commandLine\":\"s-commandline\",\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"killJobOnCompletion\":true,\"requiredSlots\":7,\"runExclusive\":true},\"jobPreparationTask\":{\"commandLine\":\"s-commandline\",\"id\":\"s-id\",\"rerunOnNodeRebootAfterSuccess\":true,\"waitForSuccess\":true},\"jobReleaseTask\":{\"commandLine\":\"s-commandline\",\"id\":\"s-id\",\"maxWallClockTime\":\"s-maxwallclocktime\",\"retentionTime\":\"s-retentiontime\"},\"maxParallelTasks\":7,\"metadata\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"networkConfiguration\":{\"skipWithdrawFromVNet\":true,\"subnetId\":\"s-subnetid\"},\"onAllTasksComplete\":\"s-onalltaskscomplete\",\"onTaskFailure\":\"s-ontaskfailure\",\"poolInfo\":{\"poolId\":\"s-poolid\"},\"priority\":7,\"usesTaskDependencies\":true},\"lastModified\":\"2026-11-06T10:00:00Z\",\"metadata\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"previousState\":\"s-previousstate\",\"previousStateTransitionTime\":\"2026-11-06T10:00:00Z\",\"schedule\":{\"doNotRunAfter\":\"2026-11-06T10:00:00Z\",\"doNotRunUntil\":\"2026-11-06T10:00:00Z\",\"recurrenceInterval\":\"s-recurrenceinterval\",\"startWindow\":\"s-startwindow\"},\"state\":\"s-state\",\"stateTransitionTime\":\"2026-11-06T10:00:00Z\",\"stats\":{\"kernelCPUTime\":\"s-kernelcputime\",\"lastUpdateTime\":\"2026-11-06T10:00:00Z\",\"numFailedTasks\":\"7\",\"numSucceededTasks\":\"7\",\"numTaskRetries\":\"7\",\"readIOGiB\":1.5,\"readIOps\":\"7\",\"startTime\":\"2026-11-06T10:00:00Z\",\"url\":\"s-url\",\"userCPUTime\":\"s-usercputime\",\"waitTime\":\"s-waittime\",\"wallClockTime\":\"s-wallclocktime\",\"writeIOGiB\":1.5,\"writeIOps\":\"7\"},\"url\":\"s-url\"}]}")
  note(f, "CALL NewListJobSchedulesPager")
  var pg = c.new_list_job_schedules_pager(ListJobSchedulesOptions{client_request_id: Some("s-clientrequestid"), expand: Some(["s-expand"]), filter: Some("s-filter"), max_results: Some(7), ocp_date: Some(at3339("2026-11-06T10:00:00Z")), return_client_request_id: Some(true), select_param: Some(["s-selectparam"]), timeout: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_list_job_schedules_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_44)
}

fn show_list_jobs_from_schedule_response(r: ListJobsFromScheduleResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.job_list_result).to_str_lossy()}")
  if let Some(v) = r.client_request_id {
    parts.push("ClientRequestID=${v}")
  }
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  if let Some(v) = r.last_modified {
    parts.push("LastModified=${t3339(v)}")
  }
  if let Some(v) = r.request_id {
    parts.push("RequestID=${v}")
  }
  parts.join(" ")
}

