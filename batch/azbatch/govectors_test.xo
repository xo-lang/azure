  compare(log_of(f), GO_74)
}

fn show_upload_node_logs_response(r: UploadNodeLogsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.upload_node_logs_result).to_str_lossy()}")
  if let Some(v) = r.client_request_id {
    parts.push("ClientRequestID=${v}")
  }
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  if let Some(v) = r.last_modified {
    parts.push("LastModified=${t3339(v)}")
  }
  if let Some(v) = r.request_id {
    parts.push("RequestID=${v}")
  }
  parts.join(" ")
}

const GO_75: List[Str] = [
  "CALL UploadNodeLogs",
  "REQ POST https://batch.example.test/pools/id1%2F%20x/nodes/id2%2F%20x/uploadbatchservicelogs?api-version=2024-07-01.20.0&timeOut=7",
  "  H accept=application/json | authorization=Bearer tok | client-request-id=s-clientrequestid | content-type=application/json; odata=minimalmetadata | ocp-date=Fri, 06 Nov 2026 10:00:00 UTC | return-client-request-id=true",
  "  B {\"containerUrl\":\"s-containerurl\",\"endTime\":\"2026-11-06T10:00:00Z\",\"identityReference\":{\"resourceId\":\"s-resourceid\"},\"startTime\":\"2026-11-06T10:00:00Z\"}",
  "  SERVED 200 {\"numberOfFilesUploaded\":7,\"virtualDirectoryName\":\"s-virtualdirectoryname\"}",
  "OUT: body={\"numberOfFilesUploaded\":7,\"virtualDirectoryName\":\"s-virtualdirectoryname\"} ClientRequestID=crid-1 ETag=\"0x8D\" LastModified=2026-11-06T10:00:00Z RequestID=rid-1",
]

test "Go's UploadNodeLogs" {
  let f = new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, EP, Cred{}, opts())
  set(f, 200, "{\"numberOfFilesUploaded\":7,\"virtualDirectoryName\":\"s-virtualdirectoryname\"}")
  note(f, "CALL UploadNodeLogs")
  match c.upload_node_logs("id1/ x", "id2/ x", (json.decode_str[UploadNodeLogsContent]("{\"containerUrl\":\"s-containerurl\",\"endTime\":\"2026-11-06T10:00:00Z\",\"identityReference\":{\"resourceId\":\"s-resourceid\"},\"startTime\":\"2026-11-06T10:00:00Z\"}") ?? e => fault("${e}")), UploadNodeLogsOptions{client_request_id: Some("s-clientrequestid"), ocp_date: Some(at3339("2026-11-06T10:00:00Z")), return_client_request_id: Some(true), timeout: Some(7)}) {
    Ok(r) => note(f, "OUT: ${show_upload_node_logs_response(r)}")
    Err(e) => note_lines(f, "OUT: error: ${err_text(e)}")
  }
  compare(log_of(f), GO_75)
}
