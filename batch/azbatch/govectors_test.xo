fn show_get_task_file_response(r: GetTaskFileResponse) -> Str {
  var parts: List[Str] = []
  parts.push("Body=${go_q(r.body)}")
  if let Some(v) = r.client_request_id {
    parts.push("ClientRequestID=${v}")
  }
  if let Some(v) = r.content_length {
    parts.push("ContentLength=${"${v}"}")
  }
  if let Some(v) = r.content_type {
    parts.push("ContentType=${v}")
  }
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  if let Some(v) = r.last_modified {
    parts.push("LastModified=${t3339(v)}")
  }
  if let Some(v) = r.ocp_batch_file_is_directory {
    parts.push("OCPBatchFileIsDirectory=${"${v}"}")
  }
  if let Some(v) = r.ocp_batch_file_mode {
    parts.push("OCPBatchFileMode=${v}")
  }
  if let Some(v) = r.ocp_batch_file_url {
    parts.push("OCPBatchFileURL=${v}")
  }
  if let Some(v) = r.ocp_creation_time {
    parts.push("OCPCreationTime=${t3339(v)}")
  }
  if let Some(v) = r.request_id {
    parts.push("RequestID=${v}")
  }
  parts.join(" ")
}

