// public method of azbatch v0.1.0 (azcore v1.23.0) by reflection, every
// argument and option filled, against a fake transport answering each
// operation's success status; do not edit (mkvec_batch.py). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime


fn show_cancel_certificate_deletion_response(r: CancelCertificateDeletionResponse) -> Str {
  var parts: List[Str] = []
  if let Some(v) = r.client_request_id {
    parts.push("ClientRequestID=${v}")
  }
  if let Some(v) = r.data_service_id {
    parts.push("DataServiceID=${v}")
  }
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  if let Some(v) = r.last_modified {
    parts.push("LastModified=${t3339(v)}")
  }
  if let Some(v) = r.request_id {
    parts.push("RequestID=${v}")
  }
  parts.join(" ")
}

