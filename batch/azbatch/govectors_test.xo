test "Go's NewListCertificatesPager" {
  let f = new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, EP, Cred{}, opts())
  set(f, 200, "{\"odata.nextLink\":\"https://batch.example.test/next?\$skiptoken=2\",\"value\":[{\"certificateFormat\":\"s-format\",\"data\":\"s-data\",\"deleteCertificateError\":{\"code\":\"s-code\",\"message\":\"s-message\",\"values\":[{\"name\":\"s-name\",\"value\":\"s-value\"}]},\"password\":\"s-password\",\"previousState\":\"s-previousstate\",\"previousStateTransitionTime\":\"2026-11-06T10:00:00Z\",\"publicData\":\"s-publicdata\",\"state\":\"s-state\",\"stateTransitionTime\":\"2026-11-06T10:00:00Z\",\"thumbprint\":\"s-thumbprint\",\"thumbprintAlgorithm\":\"s-thumbprintalgorithm\",\"url\":\"s-url\"}]}")
  note(f, "CALL NewListCertificatesPager")
  var pg = c.new_list_certificates_pager(ListCertificatesOptions{client_request_id: Some("s-clientrequestid"), filter: Some("s-filter"), max_results: Some(7), ocp_date: Some(at3339("2026-11-06T10:00:00Z")), return_client_request_id: Some(true), select_param: Some(["s-selectparam"]), timeout: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
