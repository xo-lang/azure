fn show_list_node_extensions_response(r: ListNodeExtensionsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.node_vm_extension_list_result).to_str_lossy()}")
  if let Some(v) = r.client_request_id {
    parts.push("ClientRequestID=${v}")
  }
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  if let Some(v) = r.last_modified {
    parts.push("LastModified=${t3339(v)}")
  }
  if let Some(v) = r.request_id {
    parts.push("RequestID=${v}")
  }
  parts.join(" ")
}

