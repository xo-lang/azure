test "Go's NewListTasksPager" {
  let f = new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, EP, Cred{}, opts())
  set(f, 200, "{\"odata.nextLink\":\"https://batch.example.test/next?\$skiptoken=2\",\"value\":[{\"affinityInfo\":{\"affinityId\":\"s-affinityid\"},\"applicationPackageReferences\":[{\"applicationId\":\"s-applicationid\",\"version\":\"s-version\"}],\"authenticationTokenSettings\":{\"access\":[\"s-access\"]},\"commandLine\":\"s-commandline\",\"constraints\":{\"maxTaskRetryCount\":7,\"maxWallClockTime\":\"s-maxwallclocktime\",\"retentionTime\":\"s-retentiontime\"},\"containerSettings\":{\"containerHostBatchBindMounts\":[{\"isReadOnly\":true,\"source\":\"s-source\"}],\"containerRunOptions\":\"s-containerrunoptions\",\"imageName\":\"s-imagename\",\"registry\":{\"password\":\"s-password\",\"registryServer\":\"s-registryserver\",\"username\":\"s-username\"},\"workingDirectory\":\"s-workingdirectory\"},\"creationTime\":\"2026-11-06T10:00:00Z\",\"dependsOn\":{\"taskIdRanges\":[{\"end\":7,\"start\":7}],\"taskIds\":[\"s-taskids\"]},\"displayName\":\"s-displayname\",\"eTag\":\"s-etag\",\"environmentSettings\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"executionInfo\":{\"containerInfo\":{\"containerId\":\"s-containerid\",\"error\":\"s-error\",\"state\":\"s-state\"},\"endTime\":\"2026-11-06T10:00:00Z\",\"exitCode\":7,\"failureInfo\":{\"category\":\"s-category\",\"code\":\"s-code\",\"message\":\"s-message\"},\"lastRequeueTime\":\"2026-11-06T10:00:00Z\",\"lastRetryTime\":\"2026-11-06T10:00:00Z\",\"requeueCount\":7,\"result\":\"s-result\",\"retryCount\":7,\"startTime\":\"2026-11-06T10:00:00Z\"},\"exitConditions\":{\"default\":{\"dependencyAction\":\"s-dependencyaction\",\"jobAction\":\"s-jobaction\"},\"exitCodeRanges\":[{\"end\":7,\"start\":7}],\"exitCodes\":[{\"code\":7}],\"fileUploadError\":{\"dependencyAction\":\"s-dependencyaction\",\"jobAction\":\"s-jobaction\"},\"preProcessingError\":{\"dependencyAction\":\"s-dependencyaction\",\"jobAction\":\"s-jobaction\"}},\"id\":\"s-id\",\"lastModified\":\"2026-11-06T10:00:00Z\",\"multiInstanceSettings\":{\"commonResourceFiles\":[{\"autoStorageContainerName\":\"s-autostoragecontainername\",\"blobPrefix\":\"s-blobprefix\",\"fileMode\":\"s-filemode\",\"filePath\":\"s-filepath\",\"httpUrl\":\"s-httpurl\",\"storageContainerUrl\":\"s-storagecontainerurl\"}],\"coordinationCommandLine\":\"s-coordinationcommandline\",\"numberOfInstances\":7},\"nodeInfo\":{\"affinityId\":\"s-affinityid\",\"nodeId\":\"s-nodeid\",\"nodeUrl\":\"s-nodeurl\",\"poolId\":\"s-poolid\",\"taskRootDirectory\":\"s-taskrootdirectory\",\"taskRootDirectoryUrl\":\"s-taskrootdirectoryurl\"},\"outputFiles\":[{\"filePattern\":\"s-filepattern\"}],\"previousState\":\"s-previousstate\",\"previousStateTransitionTime\":\"2026-11-06T10:00:00Z\",\"requiredSlots\":7,\"resourceFiles\":[{\"autoStorageContainerName\":\"s-autostoragecontainername\",\"blobPrefix\":\"s-blobprefix\",\"fileMode\":\"s-filemode\",\"filePath\":\"s-filepath\",\"httpUrl\":\"s-httpurl\",\"storageContainerUrl\":\"s-storagecontainerurl\"}],\"state\":\"s-state\",\"stateTransitionTime\":\"2026-11-06T10:00:00Z\",\"stats\":{\"kernelCPUTime\":\"s-kernelcputime\",\"lastUpdateTime\":\"2026-11-06T10:00:00Z\",\"readIOGiB\":1.5,\"readIOps\":\"7\",\"startTime\":\"2026-11-06T10:00:00Z\",\"url\":\"s-url\",\"userCPUTime\":\"s-usercputime\",\"waitTime\":\"s-waittime\",\"wallClockTime\":\"s-wallclocktime\",\"writeIOGiB\":1.5,\"writeIOps\":\"7\"},\"url\":\"s-url\",\"userIdentity\":{\"autoUser\":{\"elevationLevel\":\"s-elevationlevel\",\"scope\":\"s-scope\"},\"username\":\"s-username\"}}]}")
  note(f, "CALL NewListTasksPager")
  var pg = c.new_list_tasks_pager("id1/ x", ListTasksOptions{client_request_id: Some("s-clientrequestid"), expand: Some(["s-expand"]), filter: Some("s-filter"), max_results: Some(7), ocp_date: Some(at3339("2026-11-06T10:00:00Z")), return_client_request_id: Some(true), select_param: Some(["s-selectparam"]), timeout: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_list_tasks_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_55)
}

fn show_pool_exists_response(r: PoolExistsResponse) -> Str {
  var parts: List[Str] = []
  if let Some(v) = r.client_request_id {
    parts.push("ClientRequestID=${v}")
  }
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  if let Some(v) = r.last_modified {
    parts.push("LastModified=${t3339(v)}")
  }
  if let Some(v) = r.request_id {
    parts.push("RequestID=${v}")
  }
  parts.join(" ")
}

