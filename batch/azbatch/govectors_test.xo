test "Go's CancelCertificateDeletion" {
  let f = new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, EP, Cred{}, opts())
  set(f, 204, "")
  note(f, "CALL CancelCertificateDeletion")
  match c.cancel_certificate_deletion("id1/ x", "id2/ x", CancelCertificateDeletionOptions{client_request_id: Some("s-clientrequestid"), ocp_date: Some(at3339("2026-11-06T10:00:00Z")), return_client_request_id: Some(true), timeout: Some(7)}) {
    Ok(r) => note(f, "OUT: ${show_cancel_certificate_deletion_response(r)}")
    Err(e) => note_lines(f, "OUT: error: ${err_text(e)}")
  }
  compare(log_of(f), GO_0)
}

