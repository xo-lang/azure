test "Go's PoolExists" {
  let f = new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, EP, Cred{}, opts())
  set(f, 200, "")
  note(f, "CALL PoolExists")
  match c.pool_exists("id1/ x", PoolExistsOptions{client_request_id: Some("s-clientrequestid"), if_match: Some("s-ifmatch"), if_modified_since: Some(at3339("2026-11-06T10:00:00Z")), if_none_match: Some("s-ifnonematch"), if_unmodified_since: Some(at3339("2026-11-06T10:00:00Z")), ocp_date: Some(at3339("2026-11-06T10:00:00Z")), return_client_request_id: Some(true), timeout: Some(7)}) {
    Ok(r) => note(f, "OUT: ${show_pool_exists_response(r)}")
    Err(e) => note_lines(f, "OUT: error: ${err_text(e)}")
  }
  compare(log_of(f), GO_56)
}

fn show_reactivate_task_response(r: ReactivateTaskResponse) -> Str {
  var parts: List[Str] = []
  if let Some(v) = r.client_request_id {
    parts.push("ClientRequestID=${v}")
  }
  if let Some(v) = r.data_service_id {
    parts.push("DataServiceID=${v}")
  }
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  if let Some(v) = r.last_modified {
    parts.push("LastModified=${t3339(v)}")
  }
  if let Some(v) = r.request_id {
    parts.push("RequestID=${v}")
  }
  parts.join(" ")
}

