      Ok(r) => note(f, "OUT page ${page}: ${show_list_applications_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_41)
}

