e\":\"2026-11-06T10:00:00Z\",\"url\":\"s-url\",\"userCPUTime\":\"s-usercputime\",\"waitTime\":\"s-waittime\",\"wallClockTime\":\"s-wallclocktime\",\"writeIOGiB\":1.5,\"writeIOps\":\"7\"},\"url\":\"s-url\",\"usesTaskDependencies\":true}]}")
  note(f, "CALL NewListJobsFromSchedulePager")
  var pg = c.new_list_jobs_from_schedule_pager("id1/ x", ListJobsFromScheduleOptions{client_request_id: Some("s-clientrequestid"), expand: Some(["s-expand"]), filter: Some("s-filter"), max_results: Some(7), ocp_date: Some(at3339("2026-11-06T10:00:00Z")), return_client_request_id: Some(true), select_param: Some(["s-selectparam"]), timeout: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_list_jobs_from_schedule_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_45)
}

fn show_list_jobs_response(r: ListJobsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.job_list_result).to_str_lossy()}")
  if let Some(v) = r.client_request_id {
    parts.push("ClientRequestID=${v}")
  }
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  if let Some(v) = r.last_modified {
    parts.push("LastModified=${t3339(v)}")
  }
  if let Some(v) = r.request_id {
    parts.push("RequestID=${v}")
  }
  parts.join(" ")
}

