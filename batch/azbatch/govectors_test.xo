  var pg = c.new_list_applications_pager(ListApplicationsOptions{client_request_id: Some("s-clientrequestid"), max_results: Some(7), ocp_date: Some(at3339("2026-11-06T10:00:00Z")), return_client_request_id: Some(true), timeout: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
