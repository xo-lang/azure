  match c.create_certificate((json.decode_str[Certificate]("{\"certificateFormat\":\"s-format\",\"data\":\"s-data\",\"deleteCertificateError\":{\"code\":\"s-code\",\"message\":\"s-message\",\"values\":[{\"name\":\"s-name\",\"value\":\"s-value\"}]},\"password\":\"s-password\",\"previousState\":\"s-previousstate\",\"previousStateTransitionTime\":\"2026-11-06T10:00:00Z\",\"publicData\":\"s-publicdata\",\"state\":\"s-state\",\"stateTransitionTime\":\"2026-11-06T10:00:00Z\",\"thumbprint\":\"s-thumbprint\",\"thumbprintAlgorithm\":\"s-thumbprintalgorithm\",\"url\":\"s-url\"}") ?? e => fault("${e}")), CreateCertificateOptions{client_request_id: Some("s-clientrequestid"), ocp_date: Some(at3339("2026-11-06T10:00:00Z")), return_client_request_id: Some(true), timeout: Some(7)}) {
