  var path = "/pools/{poolId}/resize"
  if pool_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter poolID cannot be empty"))
  }
  path = path.replace("{poolId}", url.path_escape(pool_id))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  if let Some(v) = options.timeout {
    q.add("timeOut", "${v}")
