  pub values as "values,omitempty": List[NameValuePair]? = None
} derive Json

/// A Certificate that can be installed on Compute Nodes and can be used to authenticate operations on the machine.
pub struct Certificate {
  /// The format of the Certificate data.
  pub format as "certificateFormat,omitempty": CertificateFormat? = None
  /// The base64-encoded contents of the Certificate. The maximum size is 10KB.
  pub data as "data,omitempty": Str? = None
  /// The error that occurred on the last attempt to delete this Certificate. This property is set only if the Certificate is in the DeleteFailed state.
  pub delete_certificate_error as "deleteCertificateError,omitempty": DeleteCertificateError? = None
  /// The password to access the Certificate's private key. This must be omitted if the Certificate format is cer.
  pub password as "password,omitempty": Str? = None
  /// The previous state of the Certificate. This property is not set if the Certificate is in its initial active state.
  pub previous_state as "previousState,omitempty": CertificateState? = None
  /// The time at which the Certificate entered its previous state. This property is not set if the Certificate is in its initial Active state.
  pub previous_state_transition_time as "previousStateTransitionTime,omitempty": azcore.DateTime? = None
  /// The public part of the Certificate as a base-64 encoded .cer file.
  pub public_data as "publicData,omitempty": Str? = None
  /// The state of the Certificate.
  pub state as "state,omitempty": CertificateState? = None
  /// The time at which the Certificate entered its current state.
  pub state_transition_time as "stateTransitionTime,omitempty": azcore.DateTime? = None
  /// The X.509 thumbprint of the Certificate. This is a sequence of up to 40 hex digits (it may include spaces but these are removed).
  pub thumbprint as "thumbprint,omitempty": Str? = None
  /// The algorithm used to derive the thumbprint. This must be sha1.
  pub thumbprint_algorithm as "thumbprintAlgorithm,omitempty": Str? = None
  /// The URL of the Certificate.
  pub url as "url,omitempty": Str? = None
} derive Json

