// NOTICE.md). The operations are generated (client.xo, models.xo).

use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/policy
use github.com/xo-lang/azure/runtime

/// The scope of Entra ID tokens for Batch, as Go writes it (with its
/// double `/`).
pub const TOKEN_SCOPE: Str = "https://batch.core.windows.net//.default"

/// Options of new_client.
pub struct ClientOptions[fx: Effects] {
  pub client: policy.ClientOptions[fx] = policy.ClientOptions{}
  /// Send tokens over plain HTTP too (azcore's
  /// InsecureAllowCredentialWithHTTP; tests against a local fake only).
  pub insecure_allow_credential_with_http: Bool = false
}

struct Setup[fx: Effects] {
  pipeline: runtime.Pipeline[fx]
  endpoint: Str
}

/// Client: one Batch account's pools, jobs, tasks, nodes and more.
pub struct Client[fx: Effects] {
  setup: Setup[fx]
}

/// A client for the Batch account at `endpoint`
/// (`https://<account>.<region>.batch.azure.com`), authorized by Entra
/// ID tokens (NewClient).
pub fn new_client[fx: Effects](net: Net, clock: Clock, rand: Rand, endpoint: Str, credential: azcore.TokenCredential[fx], options: ClientOptions[fx] = ClientOptions{}) -> Client[fx] {
  let auth = runtime.new_bearer_token_policy(credential, [TOKEN_SCOPE], clock, runtime.BearerTokenOptions{insecure_allow_credential_with_http: options.insecure_allow_credential_with_http})
  let pl = runtime.new_pipeline(MODULE, VERSION, net, clock, rand, runtime.PipelineOptions{per_retry: [auth]}, options.client)
  Client{setup: Setup{pipeline: pl, endpoint: endpoint}}
}
