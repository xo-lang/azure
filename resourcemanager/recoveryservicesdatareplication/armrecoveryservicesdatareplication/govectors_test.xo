test "Go's ReplicationExtensionClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_replication_extension_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"customProperties\":{\"asrServiceUri\":\"s-asrserviceuri\",\"azStackHciFabricArmId\":\"s-azstackhcifabricarmid\",\"azStackHciSiteId\":\"s-azstackhcisiteid\",\"gatewayServiceUri\":\"s-gatewayserviceuri\",\"hyperVFabricArmId\":\"s-hypervfabricarmid\",\"hyperVSiteId\":\"s-hypervsiteid\",\"instanceType\":\"HyperVToAzStackHCI\",\"rcmServiceUri\":\"s-rcmserviceuri\",\"resourceGroup\":\"s-resourcegroup\",\"resourceLocation\":\"s-resourcelocation\",\"sourceGatewayServiceId\":\"s-sourcegatewayserviceid\",\"sourceStorageContainerName\":\"s-sourcestoragecontainername\",\"storageAccountId\":\"s-storageaccountid\",\"storageAccountSasSecretName\":\"s-storageaccountsassecretname\",\"subscriptionId\":\"s-subscriptionid\",\"targetGatewayServiceId\":\"s-targetgatewayserviceid\",\"targetStorageContainerName\":\"s-targetstoragecontainername\"},\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ReplicationExtensionClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ReplicationExtensionClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_replication_extension_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_48)
}

