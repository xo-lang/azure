fn show_protected_item_client_list_response(r: ProtectedItemClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.protected_item_model_list_result).to_str_lossy()}")
  parts.join(" ")
}

