  let c = new_recovery_point_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"customProperties\":{\"diskIds\":[\"s-diskids\"],\"instanceType\":\"HyperVToAzStackHCI\"},\"provisioningState\":\"Succeeded\",\"recoveryPointTime\":\"2026-11-06T10:00:00Z\",\"recoveryPointType\":\"s-recoverypointtype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
