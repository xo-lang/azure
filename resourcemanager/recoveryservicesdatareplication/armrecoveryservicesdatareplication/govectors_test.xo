test "Go's FabricAgentClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_fabric_agent_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"authenticationIdentity\":{\"aadAuthority\":\"s-aadauthority\",\"applicationId\":\"s-applicationid\",\"audience\":\"s-audience\",\"objectId\":\"s-objectid\",\"tenantId\":\"s-tenantid\"},\"correlationId\":\"s-correlationid\",\"customProperties\":{\"biosId\":\"s-biosid\",\"instanceType\":\"VMware\",\"marsAuthenticationIdentity\":{\"aadAuthority\":\"s-aadauthority\",\"applicationId\":\"s-applicationid\",\"audience\":\"s-audience\",\"objectId\":\"s-objectid\",\"tenantId\":\"s-tenantid\"}},\"healthErrors\":[{\"affectedResourceCorrelationIds\":[\"s-affectedresourcecorrelationids\"],\"affectedResourceType\":\"s-affectedresourcetype\",\"category\":\"s-category\",\"causes\":\"s-causes\",\"code\":\"s-code\",\"creationTime\":\"2026-11-06T10:00:00Z\",\"healthCategory\":\"s-healthcategory\",\"isCustomerResolvable\":true,\"message\":\"s-message\",\"recommendation\":\"s-recommendation\",\"severity\":\"s-severity\",\"source\":\"s-source\",\"summary\":\"s-summary\"}],\"isResponsive\":true,\"lastHeartbeat\":\"2026-11-06T10:00:00Z\",\"machineId\":\"s-machineid\",\"machineName\":\"s-machinename\",\"provisioningState\":\"Succeeded\",\"resourceAccessIdentity\":{\"aadAuthority\":\"s-aadauthority\",\"applicationId\":\"s-applicationid\",\"audience\":\"s-audience\",\"objectId\":\"s-objectid\",\"tenantId\":\"s-tenantid\"},\"versionNumber\":\"s-versionnumber\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL FabricAgentClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", FabricAgentClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_fabric_agent_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_10)
}

