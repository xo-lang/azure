test "Go's EventClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_event_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"correlationId\":\"s-correlationid\",\"customProperties\":{\"eventSourceFriendlyName\":\"s-eventsourcefriendlyname\",\"instanceType\":\"HyperVToAzStackHCI\",\"protectedItemFriendlyName\":\"s-protecteditemfriendlyname\",\"serverType\":\"s-servertype\",\"sourceApplianceName\":\"s-sourceappliancename\",\"targetApplianceName\":\"s-targetappliancename\"},\"description\":\"s-description\",\"eventName\":\"s-eventname\",\"eventType\":\"s-eventtype\",\"healthErrors\":[{\"affectedResourceCorrelationIds\":[\"s-affectedresourcecorrelationids\"],\"affectedResourceType\":\"s-affectedresourcetype\",\"category\":\"s-category\",\"causes\":\"s-causes\",\"code\":\"s-code\",\"creationTime\":\"2026-11-06T10:00:00Z\",\"healthCategory\":\"s-healthcategory\",\"isCustomerResolvable\":true,\"message\":\"s-message\",\"recommendation\":\"s-recommendation\",\"severity\":\"s-severity\",\"source\":\"s-source\",\"summary\":\"s-summary\"}],\"provisioningState\":\"Succeeded\",\"resourceName\":\"s-resourcename\",\"resourceType\":\"s-resourcetype\",\"severity\":\"s-severity\",\"timeOfOccurrence\":\"2026-11-06T10:00:00Z\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EventClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", EventClientListOptions{continuation_token: Some("s-continuationtoken"), o_data_options: Some("s-odataoptions"), page_size: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_event_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_6)
}

