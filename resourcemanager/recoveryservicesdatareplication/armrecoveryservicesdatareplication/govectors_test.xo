  gv_note(f, "CALL VaultClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", VaultClientListOptions{continuation_token: Some("s-continuationtoken")}) ?? e => fault("${e}")
  for page in [1, 2] {
