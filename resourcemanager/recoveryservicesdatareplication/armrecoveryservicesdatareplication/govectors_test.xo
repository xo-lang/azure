test "Go's ProtectedItemClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_protected_item_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"allowedJobs\":[\"s-allowedjobs\"],\"correlationId\":\"s-correlationid\",\"currentJob\":{\"displayName\":\"s-displayname\",\"endTime\":\"2026-11-06T10:00:00Z\",\"id\":\"s-id\",\"name\":\"s-name\",\"scenarioName\":\"s-scenarioname\",\"startTime\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\"},\"customProperties\":{\"activeLocation\":\"s-activelocation\",\"customLocationRegion\":\"s-customlocationregion\",\"dynamicMemoryConfig\":{\"maximumMemoryInMegaBytes\":7,\"minimumMemoryInMegaBytes\":7,\"targetMemoryBufferPercentage\":7},\"fabricDiscoveryMachineId\":\"s-fabricdiscoverymachineid\",\"failoverRecoveryPointId\":\"s-failoverrecoverypointid\",\"firmwareType\":\"s-firmwaretype\",\"hyperVGeneration\":\"s-hypervgeneration\",\"initialReplicationProgressPercentage\":7,\"instanceType\":\"HyperVToAzStackHCI\",\"isDynamicRam\":true,\"lastRecoveryPointId\":\"s-lastrecoverypointid\",\"lastRecoveryPointReceived\":\"2026-11-06T10:00:00Z\",\"lastReplicationUpdateTime\":\"2026-11-06T10:00:00Z\",\"osName\":\"s-osname\",\"osType\":\"s-ostype\",\"resyncProgressPercentage\":7,\"runAsAccountId\":\"s-runasaccountid\",\"sourceApplianceName\":\"s-sourceappliancename\",\"sourceCpuCores\":7,\"sourceFabricAgentName\":\"s-sourcefabricagentname\",\"sourceMemoryInMegaBytes\":1.5,\"sourceVmName\":\"s-sourcevmname\",\"storageContainerId\":\"s-storagecontainerid\",\"targetApplianceName\":\"s-targetappliancename\",\"targetArcClusterCustomLocationId\":\"s-targetarcclustercustomlocationid\",\"targetAzStackHciClusterName\":\"s-targetazstackhciclustername\",\"targetCpuCores\":7,\"targetFabricAgentName\":\"s-targetfabricagentname\",\"targetHciClusterId\":\"s-targethciclusterid\",\"targetLocation\":\"s-targetlocation\",\"targetMemoryInMegaBytes\":7,\"targetNetworkId\":\"s-targetnetworkid\",\"targetResourceGroupId\":\"s-targetresourcegroupid\",\"targetVmBiosId\":\"s-targetvmbiosid\",\"targetVmName\":\"s-targetvmname\",\"testNetworkId\":\"s-testnetworkid\"},\"fabricAgentId\":\"s-fabricagentid\",\"fabricId\":\"s-fabricid\",\"fabricObjectId\":\"s-fabricobjectid\",\"fabricObjectName\":\"s-fabricobjectname\",\"healthErrors\":[{\"affectedResourceCorrelationIds\":[\"s-affectedresourcecorrelationids\"],\"affectedResourceType\":\"s-affectedresourcetype\",\"category\":\"s-category\",\"causes\":\"s-causes\",\"code\":\"s-code\",\"creationTime\":\"2026-11-06T10:00:00Z\",\"healthCategory\":\"s-healthcategory\",\"isCustomerResolvable\":true,\"message\":\"s-message\",\"recommendation\":\"s-recommendation\",\"severity\":\"s-severity\",\"source\":\"s-source\",\"summary\":\"s-summary\"}],\"lastFailedEnableProtectionJob\":{\"displayName\":\"s-displayname\",\"endTime\":\"2026-11-06T10:00:00Z\",\"id\":\"s-id\",\"name\":\"s-name\",\"scenarioName\":\"s-scenarioname\",\"startTime\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\"},\"lastFailedPlannedFailoverJob\":{\"displayName\":\"s-displayname\",\"endTime\":\"2026-11-06T10:00:00Z\",\"id\":\"s-id\",\"name\":\"s-name\",\"scenarioName\":\"s-scenarioname\",\"startTime\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\"},\"lastSuccessfulPlannedFailoverTime\":\"2026-11-06T10:00:00Z\",\"lastSuccessfulTestFailoverTime\":\"2026-11-06T10:00:00Z\",\"lastSuccessfulUnplannedFailoverTime\":\"2026-11-06T10:00:00Z\",\"lastTestFailoverJob\":{\"displayName\":\"s-displayname\",\"endTime\":\"2026-11-06T10:00:00Z\",\"id\":\"s-id\",\"name\":\"s-name\",\"scenarioName\":\"s-scenarioname\",\"startTime\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\"},\"policyName\":\"s-policyname\",\"protectionState\":\"s-protectionstate\",\"protectionStateDescription\":\"s-protectionstatedescription\",\"provisioningState\":\"Succeeded\",\"replicationExtensionName\":\"s-replicationextensionname\",\"replicationHealth\":\"s-replicationhealth\",\"resyncRequired\":true,\"resynchronizationState\":\"s-resynchronizationstate\",\"sourceFabricProviderId\":\"s-sourcefabricproviderid\",\"targetFabricAgentId\":\"s-targetfabricagentid\",\"targetFabricId\":\"s-targetfabricid\",\"targetFabricProviderId\":\"s-targetfabricproviderid\",\"testFailoverState\":\"s-testfailoverstate\",\"testFailoverStateDescription\":\"s-testfailoverstatedescription\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ProtectedItemClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ProtectedItemClientListOptions{continuation_token: Some("s-continuationtoken"), o_data_options: Some("s-odataoptions"), page_size: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_protected_item_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_42)
}

