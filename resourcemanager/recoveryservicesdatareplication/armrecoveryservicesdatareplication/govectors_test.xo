test "Go's PrivateEndpointConnectionProxiesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_private_endpoint_connection_proxies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\",\"remotePrivateEndpoint\":{\"connectionDetails\":[{\"groupId\":\"s-groupid\",\"id\":\"s-id\",\"linkIdentifier\":\"https://management.example.test/next?\$skiptoken=2\",\"memberName\":\"s-membername\",\"privateIpAddress\":\"s-privateipaddress\"}],\"id\":\"s-id\",\"manualPrivateLinkServiceConnections\":[{\"name\":\"s-name\",\"requestMessage\":\"s-requestmessage\"}],\"privateLinkServiceConnections\":[{\"name\":\"s-name\",\"requestMessage\":\"s-requestmessage\"}],\"privateLinkServiceProxies\":[{\"id\":\"s-id\"}]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PrivateEndpointConnectionProxiesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", PrivateEndpointConnectionProxiesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_private_endpoint_connection_proxies_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_29)
}

