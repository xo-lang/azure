pub const VM_NIC_SELECTION_NOT_SELECTED: VMNicSelection = VMNicSelection("NotSelected")
/// Default selection by ASR.
pub const VM_NIC_SELECTION_SELECTED_BY_DEFAULT: VMNicSelection = VMNicSelection("SelectedByDefault")
/// Selected by user.
pub const VM_NIC_SELECTION_SELECTED_BY_USER: VMNicSelection = VMNicSelection("SelectedByUser")
/// NIC configuration overridden by user. Differs from SelectedByUser in the sense that the legacy SelectedByUser is used both for explicit modification by user and implicit approval of user if the settings are used for TFO/FO. SelectedByUserOverride implies user overriding at least one of the configurations.
pub const VM_NIC_SELECTION_SELECTED_BY_USER_OVERRIDE: VMNicSelection = VMNicSelection("SelectedByUserOverride")

/// The values of VMNicSelection this version knows; the service may send others.
pub fn possible_vm_nic_selection_values() -> List[VMNicSelection] {
  [VM_NIC_SELECTION_NOT_SELECTED, VM_NIC_SELECTION_SELECTED_BY_DEFAULT, VM_NIC_SELECTION_SELECTED_BY_USER, VM_NIC_SELECTION_SELECTED_BY_USER_OVERRIDE]
}

