  let c = new_sql_servers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"cores\":7,\"edition\":\"s-edition\",\"propertyBag\":\"s-propertybag\",\"registrationID\":\"s-registrationid\",\"version\":\"s-version\"},\"type\":\"s-type\"}]}")
