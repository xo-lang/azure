  gv_note(f, "CALL DeploymentsClient.BeginUpdate")
  match c.begin_update("id1/ x", "id2/ x", (json.decode_str[DeploymentUpdateParameters]("{\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"properties\":{\"autoUpgradeProfile\":{\"upgradeChannel\":\"s-upgradechannel\"},\"enableDiagnosticsSupport\":true,\"logging\":{\"storageAccount\":{\"accountName\":\"s-accountname\",\"containerName\":\"s-containername\"}},\"networkProfile\":{\"frontEndIPConfiguration\":{\"privateIPAddresses\":[{\"privateIPAddress\":\"s-privateipaddress\",\"privateIPAllocationMethod\":\"s-privateipallocationmethod\",\"subnetId\":\"s-subnetid\"}],\"publicIPAddresses\":[{\"id\":\"s-id\"}]},\"networkInterfaceConfiguration\":{\"subnetId\":\"s-subnetid\"}},\"nginxAppProtect\":{\"webApplicationFirewallSettings\":{\"activationState\":\"s-activationstate\"}},\"scalingProperties\":{\"autoScaleSettings\":{\"profiles\":[{\"capacity\":{\"max\":7,\"min\":7},\"name\":\"s-name\"}]},\"capacity\":7},\"userProfile\":{\"preferredEmail\":\"s-preferredemail\"}},\"sku\":{\"name\":\"s-name\"},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), DeploymentsClientBeginUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_deployments_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
