test "Go's OffersClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_offers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"contentUrl\":\"s-contenturl\",\"contentVersion\":\"s-contentversion\",\"marketplaceSkus\":[{\"catalogPlanId\":\"s-catalogplanid\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"displayRank\":7,\"generation\":\"s-generation\",\"longSummary\":\"s-longsummary\",\"marketplaceSkuId\":\"s-marketplaceskuid\",\"operatingSystem\":{\"family\":\"s-family\",\"name\":\"s-name\",\"type\":\"s-type\"},\"summary\":\"s-summary\",\"type\":\"s-type\"}],\"offerContent\":{\"availability\":\"s-availability\",\"categoryIds\":[\"s-categoryids\"],\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"iconFileUris\":{\"large\":\"s-large\",\"medium\":\"s-medium\",\"small\":\"s-small\",\"wide\":\"s-wide\"},\"longSummary\":\"s-longsummary\",\"offerId\":\"s-offerid\",\"offerPublisher\":{\"publisherDisplayName\":\"s-publisherdisplayname\",\"publisherId\":\"s-publisherid\"},\"offerType\":\"s-offertype\",\"operatingSystems\":[\"s-operatingsystems\"],\"popularity\":7,\"releaseType\":\"s-releasetype\",\"summary\":\"s-summary\",\"supportUri\":\"s-supporturi\",\"termsAndConditions\":{\"legalTermsType\":\"s-legaltermstype\",\"legalTermsUri\":\"s-legaltermsuri\",\"privacyPolicyUri\":\"s-privacypolicyuri\"}},\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL OffersClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(OffersClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_offers_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_3)
}

