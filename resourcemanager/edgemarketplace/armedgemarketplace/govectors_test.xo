fn show_offers_client_generate_access_token_response(r: OffersClientGenerateAccessTokenResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.disk_access_token).to_str_lossy()}")
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL OffersClient.BeginGenerateAccessToken",
  "REQ POST https://management.example.test/id1/%20x/providers/Microsoft.EdgeMarketplace/offers/id2/%20x/generateAccessToken?api-version=2025-10-01-preview",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"deviceSku\":\"s-devicesku\",\"deviceVersion\":\"s-deviceversion\",\"edgeMarketPlaceRegion\":\"s-edgemarketplaceregion\",\"egeMarketPlaceResourceId\":\"s-egemarketplaceresourceid\",\"hypervGeneration\":\"s-hypervgeneration\",\"marketPlaceSku\":\"s-marketplacesku\",\"marketPlaceSkuVersion\":\"s-marketplaceskuversion\",\"publisherName\":\"s-publishername\"}",
  "  SERVED 200 {\"accessToken\":\"s-accesstoken\",\"diskId\":\"s-diskid\",\"status\":\"s-status\"}",
  "OUT: body={\"accessToken\":\"s-accesstoken\",\"diskId\":\"s-diskid\",\"status\":\"s-status\"}",
]

test "Go's OffersClient.BeginGenerateAccessToken" {
  let f = gv_new_fake(os.net)
  let c = new_offers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"accessToken\":\"s-accesstoken\",\"diskId\":\"s-diskid\",\"status\":\"s-status\"}")
  gv_note(f, "CALL OffersClient.BeginGenerateAccessToken")
  match c.begin_generate_access_token("id1/ x", "id2/ x", (json.decode_str[AccessTokenRequest]("{\"deviceSku\":\"s-devicesku\",\"deviceVersion\":\"s-deviceversion\",\"edgeMarketPlaceRegion\":\"s-edgemarketplaceregion\",\"egeMarketPlaceResourceId\":\"s-egemarketplaceresourceid\",\"hypervGeneration\":\"s-hypervgeneration\",\"marketPlaceSku\":\"s-marketplacesku\",\"marketPlaceSkuVersion\":\"s-marketplaceskuversion\",\"publisherName\":\"s-publishername\"}") ?? e => fault("${e}")), OffersClientBeginGenerateAccessTokenOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_offers_client_generate_access_token_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

