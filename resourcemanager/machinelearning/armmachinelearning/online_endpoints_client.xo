pub fn (c: OnlineEndpointsClient) get_token(resource_group_name: Str, workspace_name: Str, endpoint_name: Str, options: OnlineEndpointsClientGetTokenOptions = OnlineEndpointsClientGetTokenOptions{}) -> OnlineEndpointsClientGetTokenResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.get_token_create_request(resource_group_name, workspace_name, endpoint_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  online_endpoints_get_token_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
