/// Forecasting specific parameters.
pub struct ForecastingSettings {
  /// Country or region for holidays for forecasting tasks. These should be ISO 3166 two-letter country/region codes, for example 'US' or 'GB'.
  pub country_or_region_for_holidays as "countryOrRegionForHolidays,omitempty": Str? = None
  /// Number of periods between the origin time of one CV fold and the next fold. For example, if `CVStepSize` = 3 for daily data, the origin time for each fold will be three days apart.
  pub cv_step_size as "cvStepSize,omitempty": Int? = None
  /// Flag for generating lags for the numeric features with 'auto' or null.
  pub feature_lags as "featureLags,omitempty": FeatureLags? = None
  /// The desired maximum forecast horizon in units of time-series frequency.
  pub forecast_horizon as "forecastHorizon,omitempty": ForecastHorizonClassification? = None
  /// When forecasting, this parameter represents the period with which the forecast is desired, for example daily, weekly, yearly, etc. The forecast frequency is dataset frequency by default.
  pub frequency as "frequency,omitempty": Str? = None
  /// Set time series seasonality as an integer multiple of the series frequency. If seasonality is set to 'auto', it will be inferred.
  pub seasonality as "seasonality,omitempty": SeasonalityClassification? = None
  /// The parameter defining how if AutoML should handle short time series.
  pub short_series_handling_config as "shortSeriesHandlingConfig,omitempty": ShortSeriesHandlingConfiguration? = None
  /// The function to be used to aggregate the time series target column to conform to a user specified frequency. If the TargetAggregateFunction is set i.e. not 'None', but the freq parameter is not set, the error is raised. The possible target aggregation functions are: "sum", "max", "min" and "mean".
  pub target_aggregate_function as "targetAggregateFunction,omitempty": TargetAggregationFunction? = None
  /// The number of past periods to lag from the target column.
  pub target_lags as "targetLags,omitempty": TargetLagsClassification? = None
  /// The number of past periods used to create a rolling window average of the target column.
  pub target_rolling_window_size as "targetRollingWindowSize,omitempty": TargetRollingWindowSizeClassification? = None
  /// The name of the time column. This parameter is required when forecasting to specify the datetime column in the input data used for building the time series and inferring its frequency.
  pub time_column_name as "timeColumnName,omitempty": Str? = None
  /// The names of columns used to group a timeseries. It can be used to create multiple series. If grain is not defined, the data set is assumed to be one time-series. This parameter is used with task type forecasting.
  pub time_series_id_column_names as "timeSeriesIdColumnNames,omitempty": List[Str]? = None
  /// Configure STL Decomposition of the time-series target column.
  pub use_stl as "useStl,omitempty": UseStl? = None
} derive Json

