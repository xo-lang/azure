/// The Spearman's rank coefficient of correlation is a nonparametric measure of rank correlation.
pub const REGRESSION_PRIMARY_METRICS_SPEARMAN_CORRELATION: RegressionPrimaryMetrics = RegressionPrimaryMetrics("SpearmanCorrelation")

/// The values of RegressionPrimaryMetrics this version knows; the service may send others.
