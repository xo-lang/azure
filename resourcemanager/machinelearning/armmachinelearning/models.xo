/// The status of a job.
pub type JobStatus struct(Str)
/// Cancellation has been requested for the job.
pub const JOB_STATUS_CANCEL_REQUESTED: JobStatus = JobStatus("CancelRequested")
/// Following cancellation request, the job is now successfully canceled.
pub const JOB_STATUS_CANCELED: JobStatus = JobStatus("Canceled")
/// Job completed successfully. This reflects that both the job itself and output collection states completed successfully
pub const JOB_STATUS_COMPLETED: JobStatus = JobStatus("Completed")
/// Job failed.
pub const JOB_STATUS_FAILED: JobStatus = JobStatus("Failed")
/// Job is completed in the target. It is in output collection state now.
pub const JOB_STATUS_FINALIZING: JobStatus = JobStatus("Finalizing")
/// When heartbeat is enabled, if the run isn't updating any information to RunHistory then the run goes to NotResponding state. NotResponding is the only state that is exempt from strict transition orders. A run can go from NotResponding to any of the previous states.
pub const JOB_STATUS_NOT_RESPONDING: JobStatus = JobStatus("NotResponding")
/// Run hasn't started yet.
pub const JOB_STATUS_NOT_STARTED: JobStatus = JobStatus("NotStarted")
/// The job is paused by users. Some adjustment to labeling jobs can be made only in paused state.
pub const JOB_STATUS_PAUSED: JobStatus = JobStatus("Paused")
/// The run environment is being prepared.
pub const JOB_STATUS_PREPARING: JobStatus = JobStatus("Preparing")
/// (Not used currently) It will be used if ES is creating the compute target.
pub const JOB_STATUS_PROVISIONING: JobStatus = JobStatus("Provisioning")
/// The job is queued in the compute target. For example, in BatchAI the job is in queued state, while waiting for all required nodes to be ready.
pub const JOB_STATUS_QUEUED: JobStatus = JobStatus("Queued")
/// The job started to run in the compute target.
pub const JOB_STATUS_RUNNING: JobStatus = JobStatus("Running")
/// Run has started. The user has a run ID.
pub const JOB_STATUS_STARTING: JobStatus = JobStatus("Starting")
/// Default job status if not mapped to all other statuses
pub const JOB_STATUS_UNKNOWN: JobStatus = JobStatus("Unknown")

/// The values of JobStatus this version knows; the service may send others.
pub fn possible_job_status_values() -> List[JobStatus] {
  [JOB_STATUS_CANCEL_REQUESTED, JOB_STATUS_CANCELED, JOB_STATUS_COMPLETED, JOB_STATUS_FAILED, JOB_STATUS_FINALIZING, JOB_STATUS_NOT_RESPONDING, JOB_STATUS_NOT_STARTED, JOB_STATUS_PAUSED, JOB_STATUS_PREPARING, JOB_STATUS_PROVISIONING, JOB_STATUS_QUEUED, JOB_STATUS_RUNNING, JOB_STATUS_STARTING, JOB_STATUS_UNKNOWN]
}

