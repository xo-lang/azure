/// Enum to determine forecast horizon selection mode.
pub type ForecastHorizonMode struct(Str)
/// Forecast horizon to be determined automatically.
pub const FORECAST_HORIZON_MODE_AUTO: ForecastHorizonMode = ForecastHorizonMode("Auto")
/// Use the custom forecast horizon.
pub const FORECAST_HORIZON_MODE_CUSTOM: ForecastHorizonMode = ForecastHorizonMode("Custom")

/// The values of ForecastHorizonMode this version knows; the service may send others.
pub fn possible_forecast_horizon_mode_values() -> List[ForecastHorizonMode] {
  [FORECAST_HORIZON_MODE_AUTO, FORECAST_HORIZON_MODE_CUSTOM]
}

/// Flag for generating lags for the numeric features.
pub type FeatureLags struct(Str)
/// System auto-generates feature lags.
pub const FEATURE_LAGS_AUTO: FeatureLags = FeatureLags("Auto")
/// No feature lags generated.
pub const FEATURE_LAGS_NONE: FeatureLags = FeatureLags("None")

/// The values of FeatureLags this version knows; the service may send others.
pub fn possible_feature_lags_values() -> List[FeatureLags] {
  [FEATURE_LAGS_AUTO, FEATURE_LAGS_NONE]
}

/// Forecasting seasonality mode.
pub type SeasonalityMode struct(Str)
/// Seasonality to be determined automatically.
pub const SEASONALITY_MODE_AUTO: SeasonalityMode = SeasonalityMode("Auto")
/// Use the custom seasonality value.
pub const SEASONALITY_MODE_CUSTOM: SeasonalityMode = SeasonalityMode("Custom")

/// The values of SeasonalityMode this version knows; the service may send others.
pub fn possible_seasonality_mode_values() -> List[SeasonalityMode] {
  [SEASONALITY_MODE_AUTO, SEASONALITY_MODE_CUSTOM]
}

/// The parameter defining how if AutoML should handle short time series.
pub type ShortSeriesHandlingConfiguration struct(Str)
/// Short series will be padded if there are no long series, otherwise short series will be dropped.
pub const SHORT_SERIES_HANDLING_CONFIGURATION_AUTO: ShortSeriesHandlingConfiguration = ShortSeriesHandlingConfiguration("Auto")
/// All the short series will be dropped.
pub const SHORT_SERIES_HANDLING_CONFIGURATION_DROP: ShortSeriesHandlingConfiguration = ShortSeriesHandlingConfiguration("Drop")
/// Represents no/null value.
pub const SHORT_SERIES_HANDLING_CONFIGURATION_NONE: ShortSeriesHandlingConfiguration = ShortSeriesHandlingConfiguration("None")
/// All the short series will be padded.
pub const SHORT_SERIES_HANDLING_CONFIGURATION_PAD: ShortSeriesHandlingConfiguration = ShortSeriesHandlingConfiguration("Pad")

/// The values of ShortSeriesHandlingConfiguration this version knows; the service may send others.
pub fn possible_short_series_handling_configuration_values() -> List[ShortSeriesHandlingConfiguration] {
  [SHORT_SERIES_HANDLING_CONFIGURATION_AUTO, SHORT_SERIES_HANDLING_CONFIGURATION_DROP, SHORT_SERIES_HANDLING_CONFIGURATION_NONE, SHORT_SERIES_HANDLING_CONFIGURATION_PAD]
}

