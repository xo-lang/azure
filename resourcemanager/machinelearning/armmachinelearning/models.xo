/// AutoMLJob class. Use this class for executing AutoML tasks like Classification/Regression etc. See TaskType enum for all the tasks supported.
pub struct AutoMLJob {
  /// ARM resource ID of the component resource.
  pub component_id as "componentId,omitempty": Str? = None
  /// ARM resource ID of the compute resource.
  pub compute_id as "computeId,omitempty": Str? = None
  /// The asset description text.
  pub description as "description,omitempty": Str? = None
  /// Display name of job.
  pub display_name as "displayName,omitempty": Str? = None
  /// The ARM resource ID of the Environment specification for the job. This is optional value to provide, if not provided, AutoML will default this to Production AutoML curated environment version when running the job.
  pub environment_id as "environmentId,omitempty": Str? = None
  /// Environment variables included in the job.
  pub environment_variables as "environmentVariables,omitempty": Map[Str, Str]? = None
  /// The name of the experiment the job belongs to. If not set, the job is placed in the "Default" experiment.
  pub experiment_name as "experimentName,omitempty": Str? = None
  /// Identity configuration. If set, this should be one of AmlToken, ManagedIdentity, UserIdentity or null. Defaults to AmlToken if null.
  pub identity as "identity,omitempty": IdentityConfigurationClassification? = None
  /// Is the asset archived?
  pub is_archived as "isArchived,omitempty": Bool? = None
  /// [Required] Specifies the type of job.
  pub job_type as "jobType,omitempty": JobType? = None
  /// Notification setting for the job
  pub notification_setting as "notificationSetting,omitempty": NotificationSetting? = None
  /// Mapping of output data bindings used in the job.
  pub outputs as "outputs,omitempty": Map[Str, JobOutputClassification]? = None
  /// The asset property dictionary.
  pub properties as "properties,omitempty": Map[Str, Str]? = None
  /// Queue settings for the job
  pub queue_settings as "queueSettings,omitempty": QueueSettings? = None
  /// Compute Resource configuration for the job.
  pub resources as "resources,omitempty": JobResourceConfiguration? = None
  /// List of JobEndpoints. For local jobs, a job endpoint will have an endpoint value of FileStreamObject.
  pub services as "services,omitempty": Map[Str, JobService]? = None
  /// Status of the job.
  pub status as "status,omitempty": JobStatus? = None
  /// Tag dictionary. Tags can be added, removed, and updated.
  pub tags as "tags,omitempty": Map[Str, Str]? = None
  /// [Required] This represents scenario which can be one of Tables/NLP/Image
