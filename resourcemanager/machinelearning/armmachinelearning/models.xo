  /// Whether to use distributed training.
  pub distributed as "distributed,omitempty": Bool? = None
  /// Enable early stopping logic during training.
  pub early_stopping as "earlyStopping,omitempty": Bool? = None
  /// Minimum number of epochs or validation evaluations to wait before primary metric improvement is tracked for early stopping. Must be a positive integer.
  pub early_stopping_delay as "earlyStoppingDelay,omitempty": Int? = None
  /// Minimum number of epochs or validation evaluations with no primary metric improvement before the run is stopped. Must be a positive integer.
  pub early_stopping_patience as "earlyStoppingPatience,omitempty": Int? = None
  /// Enable normalization when exporting ONNX model.
  pub enable_onnx_normalization as "enableOnnxNormalization,omitempty": Bool? = None
  /// Frequency to evaluate validation dataset to get metric scores. Must be a positive integer.
  pub evaluation_frequency as "evaluationFrequency,omitempty": Int? = None
