  /// Policy for sharing applications on this compute instance among users of parent workspace. If Personal, only the creator can access applications on this compute instance. When Shared, any workspace user can access applications on this instance depending on his/her assigned role.
  pub application_sharing_policy as "applicationSharingPolicy,omitempty": ApplicationSharingPolicy? = None
  /// Describes available applications and their endpoints on this ComputeInstance.
  pub applications as "applications,omitempty": List[ComputeInstanceApplication]? = None
  /// The Compute Instance Authorization type. Available values are personal (default).
  pub compute_instance_authorization_type as "computeInstanceAuthorizationType,omitempty": ComputeInstanceAuthorizationType? = None
  /// Describes all connectivity endpoints available for this ComputeInstance.
  pub connectivity_endpoints as "connectivityEndpoints,omitempty": ComputeInstanceConnectivityEndpoints? = None
  /// Describes informations of containers on this ComputeInstance.
  pub containers as "containers,omitempty": List[ComputeInstanceContainer]? = None
  /// Describes information on user who created this ComputeInstance.
  pub created_by as "createdBy,omitempty": ComputeInstanceCreatedBy? = None
  /// List of Custom Services added to the compute.
  pub custom_services as "customServices,omitempty": List[CustomService]? = None
  /// Describes informations of dataDisks on this ComputeInstance.
  pub data_disks as "dataDisks,omitempty": List[ComputeInstanceDataDisk]? = None
  /// Describes informations of dataMounts on this ComputeInstance.
  pub data_mounts as "dataMounts,omitempty": List[ComputeInstanceDataMount]? = None
  /// Enable or disable node public IP address provisioning. Possible values are: Possible values are: true - Indicates that the compute nodes will have public IPs provisioned. false - Indicates that the compute nodes will have a private endpoint and no public IPs.
  pub enable_node_public_ip as "enableNodePublicIp,omitempty": Bool? = None
  /// Collection of errors encountered on this ComputeInstance.
  pub errors as "errors,omitempty": List[ErrorResponse]? = None
  /// The last operation on ComputeInstance.
  pub last_operation as "lastOperation,omitempty": ComputeInstanceLastOperation? = None
  /// Returns metadata about the operating system image for this compute instance.
  pub os_image_metadata as "osImageMetadata,omitempty": ImageMetadata? = None
  /// Settings for a personal compute instance.
  pub personal_compute_instance_settings as "personalComputeInstanceSettings,omitempty": PersonalComputeInstanceSettings? = None
  /// The list of schedules to be applied on the computes.
  pub schedules as "schedules,omitempty": ComputeSchedules? = None
  /// Details of customized scripts to execute for setting up the cluster.
  pub setup_scripts as "setupScripts,omitempty": SetupScripts? = None
  /// Specifies policy and settings for SSH access.
  pub ssh_settings as "sshSettings,omitempty": ComputeInstanceSSHSettings? = None
  /// The current state of this ComputeInstance.
  pub state as "state,omitempty": ComputeInstanceState? = None
  /// Virtual network subnet resource ID the compute nodes belong to.
  pub subnet as "subnet,omitempty": ResourceID? = None
  /// ComputeInstance version.
  pub versions as "versions,omitempty": ComputeInstanceVersion? = None
  /// Virtual Machine Size
  pub vm_size as "vmSize,omitempty": Str? = None
} derive Json

