/// Default meta-learners are LogisticRegression for regression task when CV is on.
pub const STACK_META_LEARNER_TYPE_ELASTIC_NET_CV: StackMetaLearnerType = StackMetaLearnerType("ElasticNetCV")
pub const STACK_META_LEARNER_TYPE_LIGHT_GBM_CLASSIFIER: StackMetaLearnerType = StackMetaLearnerType("LightGBMClassifier")
pub const STACK_META_LEARNER_TYPE_LIGHT_GBM_REGRESSOR: StackMetaLearnerType = StackMetaLearnerType("LightGBMRegressor")
pub const STACK_META_LEARNER_TYPE_LINEAR_REGRESSION: StackMetaLearnerType = StackMetaLearnerType("LinearRegression")
/// Default meta-learners are LogisticRegression for classification tasks.
pub const STACK_META_LEARNER_TYPE_LOGISTIC_REGRESSION: StackMetaLearnerType = StackMetaLearnerType("LogisticRegression")
/// Default meta-learners are LogisticRegression for classification task when CV is on.
pub const STACK_META_LEARNER_TYPE_LOGISTIC_REGRESSION_CV: StackMetaLearnerType = StackMetaLearnerType("LogisticRegressionCV")
pub const STACK_META_LEARNER_TYPE_NONE: StackMetaLearnerType = StackMetaLearnerType("None")

/// The values of StackMetaLearnerType this version knows; the service may send others.
pub fn possible_stack_meta_learner_type_values() -> List[StackMetaLearnerType] {
  [STACK_META_LEARNER_TYPE_ELASTIC_NET, STACK_META_LEARNER_TYPE_ELASTIC_NET_CV, STACK_META_LEARNER_TYPE_LIGHT_GBM_CLASSIFIER, STACK_META_LEARNER_TYPE_LIGHT_GBM_REGRESSOR, STACK_META_LEARNER_TYPE_LINEAR_REGRESSION, STACK_META_LEARNER_TYPE_LOGISTIC_REGRESSION, STACK_META_LEARNER_TYPE_LOGISTIC_REGRESSION_CV, STACK_META_LEARNER_TYPE_NONE]
}

/// Enum for all classification models supported by AutoML.
pub type ClassificationModels struct(Str)
/// Naive Bayes classifier for multivariate Bernoulli models.
pub const CLASSIFICATION_MODELS_BERNOULLI_NAIVE_BAYES: ClassificationModels = ClassificationModels("BernoulliNaiveBayes")
/// Decision Trees are a non-parametric supervised learning method used for both classification and regression tasks. The goal is to create a model that predicts the value of a target variable by learning simple decision rules inferred from the data features.
pub const CLASSIFICATION_MODELS_DECISION_TREE: ClassificationModels = ClassificationModels("DecisionTree")
/// Extreme Trees is an ensemble machine learning algorithm that combines the predictions from many decision trees. It is related to the widely used random forest algorithm.
pub const CLASSIFICATION_MODELS_EXTREME_RANDOM_TREES: ClassificationModels = ClassificationModels("ExtremeRandomTrees")
/// The technique of transiting week learners into a strong learner is called Boosting. The gradient boosting algorithm process works on this theory of execution.
pub const CLASSIFICATION_MODELS_GRADIENT_BOOSTING: ClassificationModels = ClassificationModels("GradientBoosting")
/// K-nearest neighbors (KNN) algorithm uses 'feature similarity' to predict the values of new datapoints which further means that the new data point will be assigned a value based on how closely it matches the points in the training set.
pub const CLASSIFICATION_MODELS_KNN: ClassificationModels = ClassificationModels("KNN")
/// LightGBM is a gradient boosting framework that uses tree based learning algorithms.
pub const CLASSIFICATION_MODELS_LIGHT_GBM: ClassificationModels = ClassificationModels("LightGBM")
/// A support vector machine (SVM) is a supervised machine learning model that uses classification algorithms for two-group classification problems. After giving an SVM model sets of labeled training data for each category, they're able to categorize new text. Linear SVM performs best when input data is linear, i.e., data can be easily classified by drawing the straight line between classified values on a plotted graph.
pub const CLASSIFICATION_MODELS_LINEAR_SVM: ClassificationModels = ClassificationModels("LinearSVM")
/// Logistic regression is a fundamental classification technique. It belongs to the group of linear classifiers and is somewhat similar to polynomial and linear regression. Logistic regression is fast and relatively uncomplicated, and it's convenient for you to interpret the results. Although it's essentially a method for binary classification, it can also be applied to multiclass problems.
pub const CLASSIFICATION_MODELS_LOGISTIC_REGRESSION: ClassificationModels = ClassificationModels("LogisticRegression")
/// The multinomial Naive Bayes classifier is suitable for classification with discrete features (e.g., word counts for text classification). The multinomial distribution normally requires integer feature counts. However, in practice, fractional counts such as tf-idf may also work.
pub const CLASSIFICATION_MODELS_MULTINOMIAL_NAIVE_BAYES: ClassificationModels = ClassificationModels("MultinomialNaiveBayes")
/// Random forest is a supervised learning algorithm. The "forest" it builds, is an ensemble of decision trees, usually trained with the “bagging” method. The general idea of the bagging method is that a combination of learning models increases the overall result.
pub const CLASSIFICATION_MODELS_RANDOM_FOREST: ClassificationModels = ClassificationModels("RandomForest")
/// SGD: Stochastic gradient descent is an optimization algorithm often used in machine learning applications to find the model parameters that correspond to the best fit between predicted and actual outputs.
pub const CLASSIFICATION_MODELS_SGD: ClassificationModels = ClassificationModels("SGD")
/// A support vector machine (SVM) is a supervised machine learning model that uses classification algorithms for two-group classification problems. After giving an SVM model sets of labeled training data for each category, they're able to categorize new text.
pub const CLASSIFICATION_MODELS_SVM: ClassificationModels = ClassificationModels("SVM")
/// XGBoost: Extreme Gradient Boosting Algorithm. This algorithm is used for structured data where target column values can be divided into distinct class values.
pub const CLASSIFICATION_MODELS_XG_BOOST_CLASSIFIER: ClassificationModels = ClassificationModels("XGBoostClassifier")

/// The values of ClassificationModels this version knows; the service may send others.
pub fn possible_classification_models_values() -> List[ClassificationModels] {
  [CLASSIFICATION_MODELS_BERNOULLI_NAIVE_BAYES, CLASSIFICATION_MODELS_DECISION_TREE, CLASSIFICATION_MODELS_EXTREME_RANDOM_TREES, CLASSIFICATION_MODELS_GRADIENT_BOOSTING, CLASSIFICATION_MODELS_KNN, CLASSIFICATION_MODELS_LIGHT_GBM, CLASSIFICATION_MODELS_LINEAR_SVM, CLASSIFICATION_MODELS_LOGISTIC_REGRESSION, CLASSIFICATION_MODELS_MULTINOMIAL_NAIVE_BAYES, CLASSIFICATION_MODELS_RANDOM_FOREST, CLASSIFICATION_MODELS_SGD, CLASSIFICATION_MODELS_SVM, CLASSIFICATION_MODELS_XG_BOOST_CLASSIFIER]
}

