/// Stochastic optimizer for image models.
pub type StochasticOptimizer struct(Str)
/// Adam is algorithm the optimizes stochastic objective functions based on adaptive estimates of moments
pub const STOCHASTIC_OPTIMIZER_ADAM: StochasticOptimizer = StochasticOptimizer("Adam")
/// AdamW is a variant of the optimizer Adam that has an improved implementation of weight decay.
pub const STOCHASTIC_OPTIMIZER_ADAMW: StochasticOptimizer = StochasticOptimizer("Adamw")
/// No optimizer selected.
pub const STOCHASTIC_OPTIMIZER_NONE: StochasticOptimizer = StochasticOptimizer("None")
/// Stochastic Gradient Descent optimizer.
pub const STOCHASTIC_OPTIMIZER_SGD: StochasticOptimizer = StochasticOptimizer("Sgd")

/// The values of StochasticOptimizer this version knows; the service may send others.
pub fn possible_stochastic_optimizer_values() -> List[StochasticOptimizer] {
  [STOCHASTIC_OPTIMIZER_ADAM, STOCHASTIC_OPTIMIZER_ADAMW, STOCHASTIC_OPTIMIZER_NONE, STOCHASTIC_OPTIMIZER_SGD]
}

/// Primary metrics for classification multilabel tasks.
pub type ClassificationMultilabelPrimaryMetrics struct(Str)
/// AUC is the Area under the curve. This metric represents arithmetic mean of the score for each class, weighted by the number of true instances in each class.
pub const CLASSIFICATION_MULTILABEL_PRIMARY_METRICS_AUC_WEIGHTED: ClassificationMultilabelPrimaryMetrics = ClassificationMultilabelPrimaryMetrics("AUCWeighted")
/// Accuracy is the ratio of predictions that exactly match the true class labels.
pub const CLASSIFICATION_MULTILABEL_PRIMARY_METRICS_ACCURACY: ClassificationMultilabelPrimaryMetrics = ClassificationMultilabelPrimaryMetrics("Accuracy")
/// The arithmetic mean of the average precision score for each class, weighted by the number of true instances in each class.
pub const CLASSIFICATION_MULTILABEL_PRIMARY_METRICS_AVERAGE_PRECISION_SCORE_WEIGHTED: ClassificationMultilabelPrimaryMetrics = ClassificationMultilabelPrimaryMetrics("AveragePrecisionScoreWeighted")
/// Intersection Over Union. Intersection of predictions divided by union of predictions.
pub const CLASSIFICATION_MULTILABEL_PRIMARY_METRICS_IOU: ClassificationMultilabelPrimaryMetrics = ClassificationMultilabelPrimaryMetrics("IOU")
/// Normalized macro recall is recall macro-averaged and normalized, so that random performance has a score of 0, and perfect performance has a score of 1.
pub const CLASSIFICATION_MULTILABEL_PRIMARY_METRICS_NORM_MACRO_RECALL: ClassificationMultilabelPrimaryMetrics = ClassificationMultilabelPrimaryMetrics("NormMacroRecall")
/// The arithmetic mean of precision for each class, weighted by number of true instances in each class.
pub const CLASSIFICATION_MULTILABEL_PRIMARY_METRICS_PRECISION_SCORE_WEIGHTED: ClassificationMultilabelPrimaryMetrics = ClassificationMultilabelPrimaryMetrics("PrecisionScoreWeighted")

/// The values of ClassificationMultilabelPrimaryMetrics this version knows; the service may send others.
pub fn possible_classification_multilabel_primary_metrics_values() -> List[ClassificationMultilabelPrimaryMetrics] {
  [CLASSIFICATION_MULTILABEL_PRIMARY_METRICS_AUC_WEIGHTED, CLASSIFICATION_MULTILABEL_PRIMARY_METRICS_ACCURACY, CLASSIFICATION_MULTILABEL_PRIMARY_METRICS_AVERAGE_PRECISION_SCORE_WEIGHTED, CLASSIFICATION_MULTILABEL_PRIMARY_METRICS_IOU, CLASSIFICATION_MULTILABEL_PRIMARY_METRICS_NORM_MACRO_RECALL, CLASSIFICATION_MULTILABEL_PRIMARY_METRICS_PRECISION_SCORE_WEIGHTED]
}

