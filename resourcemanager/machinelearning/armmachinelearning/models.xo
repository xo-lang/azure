}

/// Enum for all forecasting models supported by AutoML.
pub type ForecastingModels struct(Str)
/// An Autoregressive Integrated Moving Average with Explanatory Variable (ARIMAX) model can be viewed as a multiple regression model with one or more autoregressive (AR) terms and/or one or more moving average (MA) terms. This method is suitable for forecasting when data is stationary/non stationary, and multivariate with any type of data pattern, i.e., level/trend /seasonality/cyclicity.
pub const FORECASTING_MODELS_ARIMAX: ForecastingModels = ForecastingModels("Arimax")
/// Auto-Autoregressive Integrated Moving Average (ARIMA) model uses time-series data and statistical analysis to interpret the data and make future predictions. This model aims to explain data by using time series data on its past values and uses linear regression to make predictions.
pub const FORECASTING_MODELS_AUTO_ARIMA: ForecastingModels = ForecastingModels("AutoArima")
/// The Average forecasting model makes predictions by carrying forward the average of the target values for each time-series in the training data.
pub const FORECASTING_MODELS_AVERAGE: ForecastingModels = ForecastingModels("Average")
/// Decision Trees are a non-parametric supervised learning method used for both classification and regression tasks. The goal is to create a model that predicts the value of a target variable by learning simple decision rules inferred from the data features.
pub const FORECASTING_MODELS_DECISION_TREE: ForecastingModels = ForecastingModels("DecisionTree")
/// Elastic net is a popular type of regularized linear regression that combines two popular penalties, specifically the L1 and L2 penalty functions.
pub const FORECASTING_MODELS_ELASTIC_NET: ForecastingModels = ForecastingModels("ElasticNet")
/// Exponential smoothing is a time series forecasting method for univariate data that can be extended to support data with a systematic trend or seasonal component.
pub const FORECASTING_MODELS_EXPONENTIAL_SMOOTHING: ForecastingModels = ForecastingModels("ExponentialSmoothing")
/// Extreme Trees is an ensemble machine learning algorithm that combines the predictions from many decision trees. It is related to the widely used random forest algorithm.
pub const FORECASTING_MODELS_EXTREME_RANDOM_TREES: ForecastingModels = ForecastingModels("ExtremeRandomTrees")
/// The technique of transiting week learners into a strong learner is called Boosting. The gradient boosting algorithm process works on this theory of execution.
pub const FORECASTING_MODELS_GRADIENT_BOOSTING: ForecastingModels = ForecastingModels("GradientBoosting")
/// K-nearest neighbors (KNN) algorithm uses 'feature similarity' to predict the values of new datapoints which further means that the new data point will be assigned a value based on how closely it matches the points in the training set.
pub const FORECASTING_MODELS_KNN: ForecastingModels = ForecastingModels("KNN")
/// Lasso model fit with Least Angle Regression a.k.a. Lars. It is a Linear Model trained with an L1 prior as regularizer.
pub const FORECASTING_MODELS_LASSO_LARS: ForecastingModels = ForecastingModels("LassoLars")
/// LightGBM is a gradient boosting framework that uses tree based learning algorithms.
pub const FORECASTING_MODELS_LIGHT_GBM: ForecastingModels = ForecastingModels("LightGBM")
/// The Naive forecasting model makes predictions by carrying forward the latest target value for each time-series in the training data.
pub const FORECASTING_MODELS_NAIVE: ForecastingModels = ForecastingModels("Naive")
/// Prophet is a procedure for forecasting time series data based on an additive model where non-linear trends are fit with yearly, weekly, and daily seasonality, plus holiday effects. It works best with time series that have strong seasonal effects and several seasons of historical data. Prophet is robust to missing data and shifts in the trend, and typically handles outliers well.
pub const FORECASTING_MODELS_PROPHET: ForecastingModels = ForecastingModels("Prophet")
/// Random forest is a supervised learning algorithm. The "forest" it builds, is an ensemble of decision trees, usually trained with the “bagging” method. The general idea of the bagging method is that a combination of learning models increases the overall result.
pub const FORECASTING_MODELS_RANDOM_FOREST: ForecastingModels = ForecastingModels("RandomForest")
/// SGD: Stochastic gradient descent is an optimization algorithm often used in machine learning applications to find the model parameters that correspond to the best fit between predicted and actual outputs. It's an inexact but powerful technique.
pub const FORECASTING_MODELS_SGD: ForecastingModels = ForecastingModels("SGD")
/// The Seasonal Average forecasting model makes predictions by carrying forward the average value of the latest season of data for each time-series in the training data.
pub const FORECASTING_MODELS_SEASONAL_AVERAGE: ForecastingModels = ForecastingModels("SeasonalAverage")
/// The Seasonal Naive forecasting model makes predictions by carrying forward the latest season of target values for each time-series in the training data.
pub const FORECASTING_MODELS_SEASONAL_NAIVE: ForecastingModels = ForecastingModels("SeasonalNaive")
/// TCNForecaster: Temporal Convolutional Networks Forecaster. //TODO: Ask forecasting team for brief intro.
pub const FORECASTING_MODELS_TCN_FORECASTER: ForecastingModels = ForecastingModels("TCNForecaster")
/// XGBoostRegressor: Extreme Gradient Boosting Regressor is a supervised machine learning model using ensemble of base learners.
pub const FORECASTING_MODELS_XG_BOOST_REGRESSOR: ForecastingModels = ForecastingModels("XGBoostRegressor")

/// The values of ForecastingModels this version knows; the service may send others.
pub fn possible_forecasting_models_values() -> List[ForecastingModels] {
  [FORECASTING_MODELS_ARIMAX, FORECASTING_MODELS_AUTO_ARIMA, FORECASTING_MODELS_AVERAGE, FORECASTING_MODELS_DECISION_TREE, FORECASTING_MODELS_ELASTIC_NET, FORECASTING_MODELS_EXPONENTIAL_SMOOTHING, FORECASTING_MODELS_EXTREME_RANDOM_TREES, FORECASTING_MODELS_GRADIENT_BOOSTING, FORECASTING_MODELS_KNN, FORECASTING_MODELS_LASSO_LARS, FORECASTING_MODELS_LIGHT_GBM, FORECASTING_MODELS_NAIVE, FORECASTING_MODELS_PROPHET, FORECASTING_MODELS_RANDOM_FOREST, FORECASTING_MODELS_SGD, FORECASTING_MODELS_SEASONAL_AVERAGE, FORECASTING_MODELS_SEASONAL_NAIVE, FORECASTING_MODELS_TCN_FORECASTER, FORECASTING_MODELS_XG_BOOST_REGRESSOR]
}

