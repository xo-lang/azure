/// Enum for all classification models supported by AutoML.
pub type BlockedTransformers struct(Str)
/// Target encoding for categorical data.
pub const BLOCKED_TRANSFORMERS_CAT_TARGET_ENCODER: BlockedTransformers = BlockedTransformers("CatTargetEncoder")
/// Count Vectorizer converts a collection of text documents to a matrix of token counts.
pub const BLOCKED_TRANSFORMERS_COUNT_VECTORIZER: BlockedTransformers = BlockedTransformers("CountVectorizer")
/// Hashing One Hot Encoder can turn categorical variables into a limited number of new features. This is often used for high-cardinality categorical features.
pub const BLOCKED_TRANSFORMERS_HASH_ONE_HOT_ENCODER: BlockedTransformers = BlockedTransformers("HashOneHotEncoder")
/// Label encoder converts labels/categorical variables in a numerical form.
pub const BLOCKED_TRANSFORMERS_LABEL_ENCODER: BlockedTransformers = BlockedTransformers("LabelEncoder")
/// Naive Bayes is a classified that is used for classification of discrete features that are categorically distributed.
pub const BLOCKED_TRANSFORMERS_NAIVE_BAYES: BlockedTransformers = BlockedTransformers("NaiveBayes")
/// Ohe hot encoding creates a binary feature transformation.
pub const BLOCKED_TRANSFORMERS_ONE_HOT_ENCODER: BlockedTransformers = BlockedTransformers("OneHotEncoder")
/// Target encoding for text data.
pub const BLOCKED_TRANSFORMERS_TEXT_TARGET_ENCODER: BlockedTransformers = BlockedTransformers("TextTargetEncoder")
/// Tf-Idf stands for, term-frequency times inverse document-frequency. This is a common term weighting scheme for identifying information from documents.
pub const BLOCKED_TRANSFORMERS_TF_IDF: BlockedTransformers = BlockedTransformers("TfIdf")
/// Weight of Evidence encoding is a technique used to encode categorical variables. It uses the natural log of the P(1)/P(0) to create weights.
pub const BLOCKED_TRANSFORMERS_WO_E_TARGET_ENCODER: BlockedTransformers = BlockedTransformers("WoETargetEncoder")
/// Word embedding helps represents words or phrases as a vector, or a series of numbers.
pub const BLOCKED_TRANSFORMERS_WORD_EMBEDDING: BlockedTransformers = BlockedTransformers("WordEmbedding")

/// The values of BlockedTransformers this version knows; the service may send others.
pub fn possible_blocked_transformers_values() -> List[BlockedTransformers] {
  [BLOCKED_TRANSFORMERS_CAT_TARGET_ENCODER, BLOCKED_TRANSFORMERS_COUNT_VECTORIZER, BLOCKED_TRANSFORMERS_HASH_ONE_HOT_ENCODER, BLOCKED_TRANSFORMERS_LABEL_ENCODER, BLOCKED_TRANSFORMERS_NAIVE_BAYES, BLOCKED_TRANSFORMERS_ONE_HOT_ENCODER, BLOCKED_TRANSFORMERS_TEXT_TARGET_ENCODER, BLOCKED_TRANSFORMERS_TF_IDF, BLOCKED_TRANSFORMERS_WO_E_TARGET_ENCODER, BLOCKED_TRANSFORMERS_WORD_EMBEDDING]
}

/// Primary metrics for classification tasks.
pub type ClassificationPrimaryMetrics struct(Str)
/// AUC is the Area under the curve. This metric represents arithmetic mean of the score for each class, weighted by the number of true instances in each class.
pub const CLASSIFICATION_PRIMARY_METRICS_AUC_WEIGHTED: ClassificationPrimaryMetrics = ClassificationPrimaryMetrics("AUCWeighted")
/// Accuracy is the ratio of predictions that exactly match the true class labels.
pub const CLASSIFICATION_PRIMARY_METRICS_ACCURACY: ClassificationPrimaryMetrics = ClassificationPrimaryMetrics("Accuracy")
/// The arithmetic mean of the average precision score for each class, weighted by the number of true instances in each class.
pub const CLASSIFICATION_PRIMARY_METRICS_AVERAGE_PRECISION_SCORE_WEIGHTED: ClassificationPrimaryMetrics = ClassificationPrimaryMetrics("AveragePrecisionScoreWeighted")
/// Normalized macro recall is recall macro-averaged and normalized, so that random performance has a score of 0, and perfect performance has a score of 1.
pub const CLASSIFICATION_PRIMARY_METRICS_NORM_MACRO_RECALL: ClassificationPrimaryMetrics = ClassificationPrimaryMetrics("NormMacroRecall")
/// The arithmetic mean of precision for each class, weighted by number of true instances in each class.
pub const CLASSIFICATION_PRIMARY_METRICS_PRECISION_SCORE_WEIGHTED: ClassificationPrimaryMetrics = ClassificationPrimaryMetrics("PrecisionScoreWeighted")

/// The values of ClassificationPrimaryMetrics this version knows; the service may send others.
pub fn possible_classification_primary_metrics_values() -> List[ClassificationPrimaryMetrics] {
  [CLASSIFICATION_PRIMARY_METRICS_AUC_WEIGHTED, CLASSIFICATION_PRIMARY_METRICS_ACCURACY, CLASSIFICATION_PRIMARY_METRICS_AVERAGE_PRECISION_SCORE_WEIGHTED, CLASSIFICATION_PRIMARY_METRICS_NORM_MACRO_RECALL, CLASSIFICATION_PRIMARY_METRICS_PRECISION_SCORE_WEIGHTED]
}

/// The meta-learner is a model trained on the output of the individual heterogeneous models. Default meta-learners are LogisticRegression for classification tasks (or LogisticRegressionCV if cross-validation is enabled) and ElasticNet for regression/forecasting tasks (or ElasticNetCV if cross-validation is enabled). This parameter can be one of the following strings: LogisticRegression, LogisticRegressionCV, LightGBMClassifier, ElasticNet, ElasticNetCV, LightGBMRegressor, or LinearRegression
pub type StackMetaLearnerType struct(Str)
/// Default meta-learners are LogisticRegression for regression task.
