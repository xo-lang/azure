  let c = new_environment_versions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"autoRebuild\":\"s-autorebuild\",\"build\":{\"contextUri\":\"s-contexturi\",\"dockerfilePath\":\"s-dockerfilepath\"},\"condaFile\":\"s-condafile\",\"description\":\"s-description\",\"environmentType\":\"s-environmenttype\",\"image\":\"s-image\",\"inferenceConfig\":{\"livenessRoute\":{\"path\":\"s-path\",\"port\":7},\"readinessRoute\":{\"path\":\"s-path\",\"port\":7},\"scoringRoute\":{\"path\":\"s-path\",\"port\":7}},\"isAnonymous\":true,\"isArchived\":true,\"osType\":\"s-ostype\",\"properties\":{\"k1\":\"s-properties\"},\"provisioningState\":\"Succeeded\",\"stage\":\"s-stage\",\"tags\":{\"k1\":\"s-tags\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EnvironmentVersionsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", EnvironmentVersionsClientListOptions{list_view_type: Some(ListViewType("s-listviewtype")), order_by: Some("s-orderby"), skip: Some("s-skip"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_environment_versions_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_62)
}

