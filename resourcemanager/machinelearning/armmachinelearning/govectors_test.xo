test "Go's ComputeClient.NewListNodesPager" {
  let f = gv_new_fake(os.net)
  let c = new_compute_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"nodes\":[{\"nodeId\":\"s-nodeid\",\"nodeState\":\"s-nodestate\",\"port\":7,\"privateIpAddress\":\"s-privateipaddress\",\"publicIpAddress\":\"s-publicipaddress\",\"runId\":\"s-runid\"}]}")
  gv_note(f, "CALL ComputeClient.NewListNodesPager")
  var pg = c.new_list_nodes_pager("id1/ x", "id2/ x", "id3/ x", ComputeClientListNodesOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_compute_client_list_nodes_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_38)
}

