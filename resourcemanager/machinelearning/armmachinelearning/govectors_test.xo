  let c = new_schedules_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"action\":{\"actionType\":\"CreateMonitor\",\"monitorDefinition\":{\"computeConfiguration\":{\"computeIdentity\":{\"computeIdentityType\":\"AmlToken\"},\"computeType\":\"ServerlessSpark\",\"instanceType\":\"s-instancetype\",\"runtimeVersion\":\"s-runtimeversion\"},\"signals\":{\"k1\":{\"componentId\":\"s-componentid\",\"inputAssets\":{\"k1\":{\"columns\":{\"k1\":\"s-columns\"},\"dataContext\":\"s-datacontext\",\"inputDataType\":\"Fixed\",\"jobInputType\":\"s-jobinputtype\",\"uri\":\"s-uri\"}},\"inputs\":{\"k1\":{\"description\":\"s-description\",\"jobInputType\":\"custom_model\",\"mode\":\"s-mode\",\"uri\":\"s-uri\"}},\"properties\":{\"k1\":\"s-properties\"},\"signalType\":\"Custom\"}}}},\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isEnabled\":true,\"properties\":{\"k1\":\"s-properties\"},\"provisioningState\":\"Succeeded\",\"tags\":{\"k1\":\"s-tags\"},\"trigger\":{\"endTime\":\"s-endtime\",\"expression\":\"s-expression\",\"startTime\":\"s-starttime\",\"timeZone\":\"s-timezone\",\"triggerType\":\"Cron\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SchedulesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", SchedulesClientListOptions{list_view_type: Some(ScheduleListViewType("s-listviewtype")), skip: Some("s-skip")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_schedules_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_182)
}

