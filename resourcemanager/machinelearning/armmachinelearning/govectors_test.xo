  let f = gv_new_fake(os.net)
  let c = new_code_versions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"codeUri\":\"s-codeuri\",\"description\":\"s-description\",\"isAnonymous\":true,\"isArchived\":true,\"properties\":{\"k1\":\"s-properties\"},\"provisioningState\":\"Succeeded\",\"tags\":{\"k1\":\"s-tags\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
