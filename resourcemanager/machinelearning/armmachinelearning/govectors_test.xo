test "Go's RegistriesClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_registries_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"discoveryUrl\":\"s-discoveryurl\",\"intellectualPropertyPublisher\":\"s-intellectualpropertypublisher\",\"managedResourceGroup\":{\"resourceId\":\"s-resourceid\"},\"mlFlowRegistryUri\":\"s-mlflowregistryuri\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"regionDetails\":[{\"location\":\"s-location\"}],\"registryPrivateEndpointConnections\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"properties\":{\"provisioningState\":\"Succeeded\"}}]},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RegistriesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(RegistriesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_registries_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_132)
}

