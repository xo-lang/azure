  gv_note(f, "CALL WorkspacesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", WorkspacesClientListByResourceGroupOptions{skip: Some("s-skip")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workspaces_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_210)
}

