test "Go's WorkspacesClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_workspaces_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"allowPublicAccessWhenBehindVnet\":true,\"applicationInsights\":\"s-applicationinsights\",\"associatedWorkspaces\":[\"s-associatedworkspaces\"],\"containerRegistry\":\"s-containerregistry\",\"description\":\"s-description\",\"discoveryUrl\":\"s-discoveryurl\",\"enableDataIsolation\":true,\"encryption\":{\"identity\":{\"userAssignedIdentity\":\"s-userassignedidentity\"},\"keyVaultProperties\":{\"identityClientId\":\"s-identityclientid\",\"keyIdentifier\":\"s-keyidentifier\",\"keyVaultArmId\":\"s-keyvaultarmid\"},\"status\":\"s-status\"},\"featureStoreSettings\":{\"computeRuntime\":{\"sparkRuntimeVersion\":\"s-sparkruntimeversion\"},\"offlineStoreConnectionName\":\"s-offlinestoreconnectionname\",\"onlineStoreConnectionName\":\"s-onlinestoreconnectionname\"},\"friendlyName\":\"s-friendlyname\",\"hbiWorkspace\":true,\"hubResourceId\":\"s-hubresourceid\",\"imageBuildCompute\":\"s-imagebuildcompute\",\"keyVault\":\"s-keyvault\",\"managedNetwork\":{\"isolationMode\":\"s-isolationmode\",\"networkId\":\"s-networkid\",\"outboundRules\":{\"k1\":{\"category\":\"s-category\",\"destination\":\"s-destination\",\"status\":\"s-status\",\"type\":\"FQDN\"}},\"status\":{\"sparkReady\":true,\"status\":\"s-status\"}},\"mlFlowTrackingUri\":\"s-mlflowtrackinguri\",\"notebookInfo\":{\"fqdn\":\"s-fqdn\",\"notebookPreparationError\":{\"errorMessage\":\"s-errormessage\",\"statusCode\":7},\"resourceId\":\"s-resourceid\"},\"primaryUserAssignedIdentity\":\"s-primaryuserassignedidentity\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}],\"privateLinkCount\":7,\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"serverlessComputeSettings\":{\"serverlessComputeCustomSubnet\":\"s-serverlesscomputecustomsubnet\",\"serverlessComputeNoPublicIP\":true},\"serviceManagedResourcesSettings\":{\"cosmosDb\":{\"collectionsThroughput\":7}},\"serviceProvisionedResourceGroup\":\"s-serviceprovisionedresourcegroup\",\"sharedPrivateLinkResources\":[{\"name\":\"s-name\",\"properties\":{\"groupId\":\"s-groupid\",\"privateLinkResourceId\":\"https://management.example.test/next?\$skiptoken=2\",\"requestMessage\":\"s-requestmessage\",\"status\":\"s-status\"}}],\"storageAccount\":\"s-storageaccount\",\"storageHnsEnabled\":true,\"tenantId\":\"s-tenantid\",\"v1LegacyMode\":true,\"workspaceHubConfig\":{\"additionalWorkspaceStorageAccounts\":[\"s-additionalworkspacestorageaccounts\"],\"defaultWorkspaceResourceGroup\":\"s-defaultworkspaceresourcegroup\"},\"workspaceId\":\"s-workspaceid\"},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkspacesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(WorkspacesClientListBySubscriptionOptions{skip: Some("s-skip")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workspaces_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_211)
}
