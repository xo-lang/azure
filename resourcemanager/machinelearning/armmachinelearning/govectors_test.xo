  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.MachineLearningServices/workspaces/id2%2F%20x/listStorageAccountKeys?api-version=2024-04-01",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"userStorageKey\":\"s-userstoragekey\"}",
  "OUT: body={\"userStorageKey\":\"s-userstoragekey\"}",
]

test "Go's WorkspacesClient.ListStorageAccountKeys" {
  let f = gv_new_fake(os.net)
  let c = new_workspaces_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"userStorageKey\":\"s-userstoragekey\"}")
  gv_note(f, "CALL WorkspacesClient.ListStorageAccountKeys")
  match c.list_storage_account_keys("id1/ x", "id2/ x", WorkspacesClientListStorageAccountKeysOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_workspaces_client_list_storage_account_keys_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_209)
}

fn show_workspaces_client_list_by_resource_group_response(r: WorkspacesClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.workspace_list_result).to_str_lossy()}")
  parts.join(" ")
}

