test "Go's FileSystemsClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_file_systems_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"adminPassword\":\"s-adminpassword\",\"availabilityZone\":\"s-availabilityzone\",\"clusterLoginUrl\":\"s-clusterloginurl\",\"delegatedSubnetId\":\"s-delegatedsubnetid\",\"marketplaceDetails\":{\"marketplaceSubscriptionId\":\"s-marketplacesubscriptionid\",\"marketplaceSubscriptionStatus\":\"s-marketplacesubscriptionstatus\",\"offerId\":\"s-offerid\",\"planId\":\"s-planid\",\"publisherId\":\"s-publisherid\",\"termUnit\":\"s-termunit\"},\"performanceTier\":\"s-performancetier\",\"privateIPs\":[\"s-privateips\"],\"provisioningState\":\"Succeeded\",\"storageSku\":\"s-storagesku\",\"userDetails\":{\"email\":\"s-email\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL FileSystemsClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(FileSystemsClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_file_systems_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_4)
}

