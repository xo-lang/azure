test "Go's ConnectedClusterClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_connected_cluster_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"agentPublicKeyCertificate\":\"s-agentpublickeycertificate\",\"agentVersion\":\"s-agentversion\",\"connectivityStatus\":\"s-connectivitystatus\",\"distribution\":\"s-distribution\",\"infrastructure\":\"s-infrastructure\",\"kubernetesVersion\":\"s-kubernetesversion\",\"lastConnectivityTime\":\"2026-11-06T10:00:00Z\",\"managedIdentityCertificateExpirationTime\":\"2026-11-06T10:00:00Z\",\"offering\":\"s-offering\",\"provisioningState\":\"Succeeded\",\"totalCoreCount\":7,\"totalNodeCount\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ConnectedClusterClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(ConnectedClusterClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_connected_cluster_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_5)
}

fn show_connected_cluster_client_update_response(r: ConnectedClusterClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.connected_cluster).to_str_lossy()}")
  parts.join(" ")
}

