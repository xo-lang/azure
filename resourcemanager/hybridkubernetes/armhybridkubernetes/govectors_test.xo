  let f = gv_new_fake(os.net)
  let c = new_connected_cluster_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"agentPublicKeyCertificate\":\"s-agentpublickeycertificate\",\"agentVersion\":\"s-agentversion\",\"connectivityStatus\":\"s-connectivitystatus\",\"distribution\":\"s-distribution\",\"infrastructure\":\"s-infrastructure\",\"kubernetesVersion\":\"s-kubernetesversion\",\"lastConnectivityTime\":\"2026-11-06T10:00:00Z\",\"managedIdentityCertificateExpirationTime\":\"2026-11-06T10:00:00Z\",\"offering\":\"s-offering\",\"provisioningState\":\"Succeeded\",\"totalCoreCount\":7,\"totalNodeCount\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ConnectedClusterClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[ConnectedClusterPatch]("{\"properties\":{\"k\":\"v\"},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), ConnectedClusterClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_connected_cluster_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_6)
}

