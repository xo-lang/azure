test "Go's AzureBareMetalInstancesClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_azure_bare_metal_instances_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"azureBareMetalInstanceId\":\"s-azurebaremetalinstanceid\",\"hardwareProfile\":{\"azureBareMetalInstanceSize\":\"s-azurebaremetalinstancesize\",\"hardwareType\":\"s-hardwaretype\"},\"hwRevision\":\"s-hwrevision\",\"networkProfile\":{\"circuitId\":\"s-circuitid\",\"networkInterfaces\":[{\"ipAddress\":\"s-ipaddress\"}]},\"osProfile\":{\"computerName\":\"s-computername\",\"osType\":\"s-ostype\",\"sshPublicKey\":\"s-sshpublickey\",\"version\":\"s-version\"},\"partnerNodeId\":\"s-partnernodeid\",\"powerState\":\"s-powerstate\",\"provisioningState\":\"Succeeded\",\"proximityPlacementGroup\":\"s-proximityplacementgroup\",\"storageProfile\":{\"nfsIpAddress\":\"s-nfsipaddress\",\"osDisks\":[{\"diskSizeGB\":7,\"lun\":7,\"name\":\"s-name\"}]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL AzureBareMetalInstancesClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[Tags]("{\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), AzureBareMetalInstancesClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_azure_bare_metal_instances_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_3)
}

fn show_operations_client_list_response(r: OperationsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_list).to_str_lossy()}")
  parts.join(" ")
}

const GO_4: List[Str] = [
  "CALL OperationsClient.NewListPager",
  "REQ GET https://management.example.test/providers/Microsoft.BareMetalInfrastructure/operations?api-version=2021-08-09",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\"}]}",
  "OUT page 1: body={\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\"}]}",
  "OUT page 2: no more",
]

test "Go's OperationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_operations_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\"}]}")
  gv_note(f, "CALL OperationsClient.NewListPager")
  var pg = c.new_list_pager(OperationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_operations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_4)
}
