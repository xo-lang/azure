test "Go's AgriServiceClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_agri_service_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"config\":{\"appServiceResourceId\":\"s-appserviceresourceid\",\"cosmosDbResourceId\":\"s-cosmosdbresourceid\",\"instanceUri\":\"s-instanceuri\",\"keyVaultResourceId\":\"s-keyvaultresourceid\",\"redisCacheResourceId\":\"s-rediscacheresourceid\",\"storageAccountResourceId\":\"s-storageaccountresourceid\",\"version\":\"s-version\"},\"dataConnectorCredentials\":[{\"key\":\"s-key\",\"value\":{\"clientId\":\"s-clientid\",\"keyName\":\"s-keyname\",\"keyVaultUri\":\"s-keyvaulturi\",\"keyVersion\":\"s-keyversion\",\"kind\":\"s-kind\"}}],\"installedSolutions\":[{\"key\":\"s-key\",\"value\":{\"applicationName\":\"s-applicationname\",\"marketPlacePublisherId\":\"s-marketplacepublisherid\",\"partnerId\":\"s-partnerid\",\"planId\":\"s-planid\",\"saasSubscriptionId\":\"s-saassubscriptionid\",\"saasSubscriptionName\":\"s-saassubscriptionname\"}}],\"managedOnBehalfOfConfiguration\":{\"moboBrokerResources\":[{\"id\":\"s-id\"}]},\"provisioningState\":\"Succeeded\"},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AgriServiceClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(AgriServiceClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_agri_service_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_6)
}

fn show_operations_client_list_response(r: OperationsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_list_result).to_str_lossy()}")
  parts.join(" ")
}

