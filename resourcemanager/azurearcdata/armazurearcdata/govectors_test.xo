test "Go's SQLServerInstancesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_sql_server_instances_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"azureDefenderStatus\":\"s-azuredefenderstatus\",\"azureDefenderStatusLastUpdated\":\"2026-11-06T10:00:00Z\",\"collation\":\"s-collation\",\"containerResourceId\":\"s-containerresourceid\",\"createTime\":\"s-createtime\",\"currentVersion\":\"s-currentversion\",\"edition\":\"s-edition\",\"hostType\":\"s-hosttype\",\"instanceName\":\"s-instancename\",\"licenseType\":\"s-licensetype\",\"patchLevel\":\"s-patchlevel\",\"productId\":\"s-productid\",\"provisioningState\":\"Succeeded\",\"status\":\"s-status\",\"tcpDynamicPorts\":\"s-tcpdynamicports\",\"tcpStaticPorts\":\"s-tcpstaticports\",\"vCore\":\"s-vcore\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SQLServerInstancesClient.NewListPager")
  var pg = c.new_list_pager(SQLServerInstancesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_sql_server_instances_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_27)
}

fn show_sql_server_instances_client_update_response(r: SQLServerInstancesClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.sql_server_instance).to_str_lossy()}")
  parts.join(" ")
}

