  let c = new_sql_server_instances_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"azureDefenderStatus\":\"s-azuredefenderstatus\",\"azureDefenderStatusLastUpdated\":\"2026-11-06T10:00:00Z\",\"collation\":\"s-collation\",\"containerResourceId\":\"s-containerresourceid\",\"createTime\":\"s-createtime\",\"currentVersion\":\"s-currentversion\",\"edition\":\"s-edition\",\"hostType\":\"s-hosttype\",\"instanceName\":\"s-instancename\",\"licenseType\":\"s-licensetype\",\"patchLevel\":\"s-patchlevel\",\"productId\":\"s-productid\",\"provisioningState\":\"Succeeded\",\"status\":\"s-status\",\"tcpDynamicPorts\":\"s-tcpdynamicports\",\"tcpStaticPorts\":\"s-tcpstaticports\",\"vCore\":\"s-vcore\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL SQLServerInstancesClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[SQLServerInstanceUpdate]("{\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), SQLServerInstancesClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_sql_server_instances_client_update_response(r)}")
