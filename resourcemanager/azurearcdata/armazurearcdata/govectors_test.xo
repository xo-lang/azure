  let c = new_postgres_instances_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"admin\":\"s-admin\",\"basicLoginInformation\":{\"password\":\"s-password\",\"username\":\"s-username\"},\"dataControllerId\":\"s-datacontrollerid\",\"k8sRaw\":{\"k\":\"v\"},\"lastUploadedDate\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\"},\"sku\":{\"capacity\":7,\"dev\":true,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"Hyperscale\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
