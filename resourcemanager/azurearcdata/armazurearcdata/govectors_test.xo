  "OUT: body={\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"azureDefenderStatus\":\"s-azuredefenderstatus\",\"azureDefenderStatusLastUpdated\":\"2026-11-06T10:00:00Z\",\"collation\":\"s-collation\",\"containerResourceId\":\"s-containerresourceid\",\"createTime\":\"s-createtime\",\"currentVersion\":\"s-currentversion\",\"edition\":\"s-edition\",\"hostType\":\"s-hosttype\",\"instanceName\":\"s-instancename\",\"licenseType\":\"s-licensetype\",\"patchLevel\":\"s-patchlevel\",\"productId\":\"s-productid\",\"provisioningState\":\"Succeeded\",\"status\":\"s-status\",\"tcpDynamicPorts\":\"s-tcpdynamicports\",\"tcpStaticPorts\":\"s-tcpstaticports\",\"vCore\":\"s-vcore\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}",
