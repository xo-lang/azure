test "Go's MHSMRegionsClient.NewListByResourcePager" {
  let f = gv_new_fake(os.net)
  let c = new_mhsm_regions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"isPrimary\":true,\"name\":\"s-name\",\"provisioningState\":\"Succeeded\"}]}")
  gv_note(f, "CALL MHSMRegionsClient.NewListByResourcePager")
  var pg = c.new_list_by_resource_pager("id1/ x", "id2/ x", MHSMRegionsClientListByResourceOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_mhsm_regions_client_list_by_resource_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_10)
}

