  "  B {\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessPolicies\":[{\"applicationId\":\"s-applicationid\",\"objectId\":\"s-objectid\",\"permissions\":{\"certificates\":[\"s-certificates\"],\"keys\":[\"s-keys\"],\"secrets\":[\"s-secrets\"],\"storage\":[\"s-storage\"]},\"tenantId\":\"s-tenantid\"}]},\"type\":\"s-type\"}",
  "  SERVED 200 {\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessPolicies\":[{\"applicationId\":\"s-applicationid\",\"objectId\":\"s-objectid\",\"permissions\":{\"certificates\":[\"s-certificates\"],\"keys\":[\"s-keys\"],\"secrets\":[\"s-secrets\"],\"storage\":[\"s-storage\"]},\"tenantId\":\"s-tenantid\"}]},\"type\":\"s-type\"}",
  "OUT: body={\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessPolicies\":[{\"applicationId\":\"s-applicationid\",\"objectId\":\"s-objectid\",\"permissions\":{\"certificates\":[\"s-certificates\"],\"keys\":[\"s-keys\"],\"secrets\":[\"s-secrets\"],\"storage\":[\"s-storage\"]},\"tenantId\":\"s-tenantid\"}]},\"type\":\"s-type\"}",
]

test "Go's VaultsClient.UpdateAccessPolicy" {
  let f = gv_new_fake(os.net)
  let c = new_vaults_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessPolicies\":[{\"applicationId\":\"s-applicationid\",\"objectId\":\"s-objectid\",\"permissions\":{\"certificates\":[\"s-certificates\"],\"keys\":[\"s-keys\"],\"secrets\":[\"s-secrets\"],\"storage\":[\"s-storage\"]},\"tenantId\":\"s-tenantid\"}]},\"type\":\"s-type\"}")
  gv_note(f, "CALL VaultsClient.UpdateAccessPolicy")
  match c.update_access_policy("id1/ x", "id2/ x", AccessPolicyUpdateKind("sha1"), (json.decode_str[VaultAccessPolicyParameters]("{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessPolicies\":[{\"applicationId\":\"s-applicationid\",\"objectId\":\"s-objectid\",\"permissions\":{\"certificates\":[\"s-certificates\"],\"keys\":[\"s-keys\"],\"secrets\":[\"s-secrets\"],\"storage\":[\"s-storage\"]},\"tenantId\":\"s-tenantid\"}]},\"type\":\"s-type\"}") ?? e => fault("${e}")), VaultsClientUpdateAccessPolicyOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_vaults_client_update_access_policy_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_47)
}
