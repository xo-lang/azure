test "Go's SecretsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_secrets_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"attributes\":{\"created\":1793959200,\"enabled\":true,\"exp\":1793959200,\"nbf\":1793959200,\"updated\":1793959200},\"contentType\":\"s-contenttype\",\"secretUri\":\"s-secreturi\",\"secretUriWithVersion\":\"s-secreturiwithversion\",\"value\":\"s-value\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SecretsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", SecretsClientListOptions{top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_secrets_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_34)
}

