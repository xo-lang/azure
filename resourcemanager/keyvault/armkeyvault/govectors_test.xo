test "Go's ManagedHsmKeysClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_managed_hsm_keys_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"attributes\":{\"created\":7,\"enabled\":true,\"exp\":7,\"exportable\":true,\"nbf\":7,\"recoveryLevel\":\"s-recoverylevel\",\"updated\":7},\"curveName\":\"s-curvename\",\"keyOps\":[\"s-keyops\"],\"keySize\":7,\"keyUri\":\"s-keyuri\",\"keyUriWithVersion\":\"s-keyuriwithversion\",\"kty\":\"s-kty\",\"release_policy\":{\"contentType\":\"s-contenttype\",\"data\":\"YWI\"},\"rotationPolicy\":{\"attributes\":{\"created\":7,\"expiryTime\":\"s-expirytime\",\"updated\":7},\"lifetimeActions\":[{}]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ManagedHsmKeysClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ManagedHsmKeysClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_managed_hsm_keys_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_14)
}

