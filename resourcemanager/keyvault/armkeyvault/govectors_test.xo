  let f = gv_new_fake(os.net)
  let c = new_keys_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"attributes\":{\"created\":7,\"enabled\":true,\"exp\":7,\"exportable\":true,\"nbf\":7,\"recoveryLevel\":\"s-recoverylevel\",\"updated\":7},\"curveName\":\"s-curvename\",\"keyOps\":[\"s-keyops\"],\"keySize\":7,\"keyUri\":\"s-keyuri\",\"keyUriWithVersion\":\"s-keyuriwithversion\",\"kty\":\"s-kty\",\"release_policy\":{\"contentType\":\"s-contenttype\",\"data\":\"YWI\"},\"rotationPolicy\":{\"attributes\":{\"created\":7,\"expiryTime\":\"s-expirytime\",\"updated\":7},\"lifetimeActions\":[{\"action\":{\"type\":\"s-type\"},\"trigger\":{\"timeAfterCreate\":\"s-timeaftercreate\",\"timeBeforeExpiry\":\"s-timebeforeexpiry\"}}]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL KeysClient.CreateIfNotExist")
  match c.create_if_not_exist("id1/ x", "id2/ x", "id3/ x", (json.decode_str[KeyCreateParameters]("{\"properties\":{\"attributes\":{\"created\":7,\"enabled\":true,\"exp\":7,\"exportable\":true,\"nbf\":7,\"recoveryLevel\":\"s-recoverylevel\",\"updated\":7},\"curveName\":\"s-curvename\",\"keyOps\":[\"s-keyops\"],\"keySize\":7,\"keyUri\":\"s-keyuri\",\"keyUriWithVersion\":\"s-keyuriwithversion\",\"kty\":\"s-kty\",\"release_policy\":{\"contentType\":\"s-contenttype\",\"data\":\"YWI\"},\"rotationPolicy\":{\"attributes\":{\"created\":7,\"expiryTime\":\"s-expirytime\",\"updated\":7},\"lifetimeActions\":[{\"action\":{\"type\":\"s-type\"},\"trigger\":{\"timeAfterCreate\":\"s-timeaftercreate\",\"timeBeforeExpiry\":\"s-timebeforeexpiry\"}}]}},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), KeysClientCreateIfNotExistOptions{}) {
