test "Go's ProfilesClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_profiles_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"allowedEndpointRecordTypes\":[\"s-allowedendpointrecordtypes\"],\"dnsConfig\":{\"fqdn\":\"s-fqdn\",\"relativeName\":\"s-relativename\",\"ttl\":7},\"endpoints\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"alwaysServe\":\"s-alwaysserve\",\"endpointLocation\":\"s-endpointlocation\",\"endpointMonitorStatus\":\"s-endpointmonitorstatus\",\"endpointStatus\":\"s-endpointstatus\",\"minChildEndpoints\":7,\"minChildEndpointsIPv4\":7,\"minChildEndpointsIPv6\":7,\"priority\":7,\"target\":\"s-target\",\"targetResourceId\":\"s-targetresourceid\",\"weight\":7},\"type\":\"s-type\"}],\"maxReturn\":7,\"monitorConfig\":{\"customHeaders\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"expectedStatusCodeRanges\":[{\"max\":7,\"min\":7}],\"intervalInSeconds\":7,\"path\":\"s-path\",\"port\":7,\"profileMonitorStatus\":\"s-profilemonitorstatus\",\"protocol\":\"s-protocol\",\"timeoutInSeconds\":7,\"toleratedNumberOfFailures\":7},\"profileStatus\":\"s-profilestatus\",\"recordType\":\"s-recordtype\",\"trafficRoutingMethod\":\"s-trafficroutingmethod\",\"trafficViewEnrollmentStatus\":\"s-trafficviewenrollmentstatus\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ProfilesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(ProfilesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_profiles_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_12)
}

