test "Go's PoolsClient.NewListByProjectPager" {
  let f = gv_new_fake(os.net)
  let c = new_pools_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"devBoxCount\":7,\"devBoxDefinitionName\":\"s-devboxdefinitionname\",\"displayName\":\"s-displayname\",\"healthStatus\":\"s-healthstatus\",\"healthStatusDetails\":[{\"code\":\"s-code\",\"message\":\"s-message\"}],\"licenseType\":\"s-licensetype\",\"localAdministrator\":\"s-localadministrator\",\"managedVirtualNetworkRegions\":[\"s-managedvirtualnetworkregions\"],\"networkConnectionName\":\"s-networkconnectionname\",\"provisioningState\":\"Succeeded\",\"singleSignOnStatus\":\"s-singlesignonstatus\",\"stopOnDisconnect\":{\"gracePeriodMinutes\":7,\"status\":\"s-status\"},\"virtualNetworkType\":\"s-virtualnetworktype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PoolsClient.NewListByProjectPager")
  var pg = c.new_list_by_project_pager("id1/ x", "id2/ x", PoolsClientListByProjectOptions{top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_pools_client_list_by_project_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_65)
}

