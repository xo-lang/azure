test "Go's DevCentersClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_dev_centers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"devCenterUri\":\"s-devcenteruri\",\"displayName\":\"s-displayname\",\"encryption\":{\"customerManagedKeyEncryption\":{\"keyEncryptionKeyIdentity\":{\"delegatedIdentityClientId\":\"s-delegatedidentityclientid\",\"identityType\":\"s-identitytype\",\"userAssignedIdentityResourceId\":\"s-userassignedidentityresourceid\"},\"keyEncryptionKeyUrl\":\"s-keyencryptionkeyurl\"}},\"projectCatalogSettings\":{\"catalogItemSyncEnableStatus\":\"s-catalogitemsyncenablestatus\"},\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DevCentersClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", DevCentersClientListByResourceGroupOptions{top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_dev_centers_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_27)
}

