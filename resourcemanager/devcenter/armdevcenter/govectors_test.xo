test "Go's CatalogsClient.NewListByDevCenterPager" {
  let f = gv_new_fake(os.net)
  let c = new_catalogs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"adoGit\":{\"branch\":\"s-branch\",\"path\":\"s-path\",\"secretIdentifier\":\"s-secretidentifier\",\"uri\":\"s-uri\"},\"connectionState\":\"s-connectionstate\",\"gitHub\":{\"branch\":\"s-branch\",\"path\":\"s-path\",\"secretIdentifier\":\"s-secretidentifier\",\"uri\":\"s-uri\"},\"lastConnectionTime\":\"2026-11-06T10:00:00Z\",\"lastSyncStats\":{\"added\":7,\"removed\":7,\"syncedCatalogItemTypes\":[\"s-syncedcatalogitemtypes\"],\"synchronizationErrors\":7,\"unchanged\":7,\"updated\":7,\"validationErrors\":7},\"lastSyncTime\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"syncState\":\"s-syncstate\",\"syncType\":\"s-synctype\",\"tags\":{\"k1\":\"s-tags\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL CatalogsClient.NewListByDevCenterPager")
  var pg = c.new_list_by_dev_center_pager("id1/ x", "id2/ x", CatalogsClientListByDevCenterOptions{top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_catalogs_client_list_by_dev_center_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_13)
}

