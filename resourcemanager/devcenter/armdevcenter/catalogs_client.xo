    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "CatalogsClientConnectResponse", fn(r: http.Response) -> CatalogsClientConnectResponse ! Str { catalogs_connect_handle(r) }, traced: true)
  }
  let sp = runtime.start_span({}, "CatalogsClient.BeginConnect", c.setup.pipeline.tracer)
  let req = c.connect_create_request(resource_group_name, dev_center_name, catalog_name, options) ?? e => return Err(sp.fail(e))
  let resp = c.setup.pipeline.send(sp.on(req)) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![202].contains(resp.status) {
    return Err(sp.fail(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  sp.end()
  runtime.new_poller(c.setup.pipeline, req, resp, "azure-async-operation", "CatalogsClientConnectResponse", fn(r: http.Response) -> CatalogsClientConnectResponse ! Str { catalogs_connect_handle(r) }, traced: true)
}
