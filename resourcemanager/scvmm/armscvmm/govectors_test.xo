test "Go's VirtualMachineInstancesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_machine_instances_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"availabilitySets\":[{\"id\":\"s-id\",\"name\":\"s-name\"}],\"hardwareProfile\":{\"cpuCount\":7,\"dynamicMemoryEnabled\":\"s-dynamicmemoryenabled\",\"dynamicMemoryMaxMB\":7,\"dynamicMemoryMinMB\":7,\"isHighlyAvailable\":\"s-ishighlyavailable\",\"limitCpuForMigration\":\"s-limitcpuformigration\",\"memoryMB\":7},\"infrastructureProfile\":{\"biosGuid\":\"s-biosguid\",\"checkpointType\":\"s-checkpointtype\",\"checkpoints\":[{\"checkpointID\":\"s-checkpointid\",\"description\":\"s-description\",\"name\":\"s-name\",\"parentCheckpointID\":\"s-parentcheckpointid\"}],\"cloudId\":\"s-cloudid\",\"generation\":7,\"inventoryItemId\":\"s-inventoryitemid\",\"lastRestoredVMCheckpoint\":{\"checkpointID\":\"s-checkpointid\",\"description\":\"s-description\",\"name\":\"s-name\",\"parentCheckpointID\":\"s-parentcheckpointid\"},\"templateId\":\"s-templateid\",\"uuid\":\"s-uuid\",\"vmName\":\"s-vmname\",\"vmmServerId\":\"s-vmmserverid\"},\"networkProfile\":{\"networkInterfaces\":[{\"displayName\":\"s-displayname\",\"ipv4AddressType\":\"s-ipv4addresstype\",\"ipv6AddressType\":\"s-ipv6addresstype\",\"macAddress\":\"s-macaddress\",\"macAddressType\":\"s-macaddresstype\",\"name\":\"s-name\",\"networkName\":\"s-networkname\",\"nicId\":\"s-nicid\",\"virtualNetworkId\":\"s-virtualnetworkid\"}]},\"osProfile\":{\"adminPassword\":\"s-adminpassword\",\"computerName\":\"s-computername\",\"osSku\":\"s-ossku\",\"osType\":\"s-ostype\",\"osVersion\":\"s-osversion\"},\"powerState\":\"s-powerstate\",\"provisioningState\":\"Succeeded\",\"storageProfile\":{\"disks\":[{\"bus\":7,\"busType\":\"s-bustype\",\"createDiffDisk\":\"s-creatediffdisk\",\"diskId\":\"s-diskid\",\"diskSizeGB\":7,\"displayName\":\"s-displayname\",\"lun\":7,\"maxDiskSizeGB\":7,\"name\":\"s-name\",\"templateDiskId\":\"s-templatediskid\",\"vhdFormatType\":\"s-vhdformattype\",\"vhdType\":\"s-vhdtype\",\"volumeType\":\"s-volumetype\"}]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualMachineInstancesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", VirtualMachineInstancesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_machine_instances_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_33)
}

fn show_virtual_machine_templates_client_create_or_update_response(r: VirtualMachineTemplatesClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.virtual_machine_template).to_str_lossy()}")
  parts.join(" ")
}

