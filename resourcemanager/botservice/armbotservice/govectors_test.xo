test "Go's BotConnectionClient.NewListByBotServicePager" {
  let f = gv_new_fake(os.net)
  let c = new_bot_connection_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"clientId\":\"s-clientid\",\"clientSecret\":\"s-clientsecret\",\"parameters\":[{\"key\":\"s-key\",\"value\":\"s-value\"}],\"provisioningState\":\"Succeeded\",\"scopes\":\"s-scopes\",\"serviceProviderDisplayName\":\"s-serviceproviderdisplayname\",\"serviceProviderId\":\"s-serviceproviderid\",\"settingId\":\"s-settingid\"},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
  gv_note(f, "CALL BotConnectionClient.NewListByBotServicePager")
  var pg = c.new_list_by_bot_service_pager("id1/ x", "id2/ x", BotConnectionClientListByBotServiceOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_bot_connection_client_list_by_bot_service_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_5)
}

