test "Go's BotsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_bots_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"allSettings\":{\"k1\":\"s-allsettings\"},\"appPasswordHint\":\"s-apppasswordhint\",\"cmekEncryptionStatus\":\"s-cmekencryptionstatus\",\"cmekKeyVaultUrl\":\"s-cmekkeyvaulturl\",\"configuredChannels\":[\"s-configuredchannels\"],\"description\":\"s-description\",\"developerAppInsightKey\":\"s-developerappinsightkey\",\"developerAppInsightsApiKey\":\"s-developerappinsightsapikey\",\"developerAppInsightsApplicationId\":\"s-developerappinsightsapplicationid\",\"disableLocalAuth\":true,\"displayName\":\"s-displayname\",\"enabledChannels\":[\"s-enabledchannels\"],\"endpoint\":\"s-endpoint\",\"endpointVersion\":\"s-endpointversion\",\"iconUrl\":\"s-iconurl\",\"isCmekEnabled\":true,\"isDeveloperAppInsightsApiKeySet\":true,\"isStreamingSupported\":true,\"luisAppIds\":[\"s-luisappids\"],\"luisKey\":\"s-luiskey\",\"manifestUrl\":\"s-manifesturl\",\"migrationToken\":\"s-migrationtoken\",\"msaAppId\":\"s-msaappid\",\"msaAppMSIResourceId\":\"s-msaappmsiresourceid\",\"msaAppTenantId\":\"s-msaapptenantid\",\"msaAppType\":\"s-msaapptype\",\"openWithHint\":\"s-openwithhint\",\"parameters\":{\"k1\":\"s-parameters\"},\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"publishingCredentials\":\"s-publishingcredentials\",\"schemaTransformationVersion\":\"s-schematransformationversion\",\"storageResourceId\":\"s-storageresourceid\",\"tenantId\":\"s-tenantid\"},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
  gv_note(f, "CALL BotsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", BotsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_bots_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_11)
}

fn show_bots_client_list_response(r: BotsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.bot_response_list).to_str_lossy()}")
  parts.join(" ")
}

