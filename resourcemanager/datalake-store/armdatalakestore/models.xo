  /// The default owner group for all new folders and files created in the Data Lake Store account.
  pub default_group as "defaultGroup,omitempty": json.Patch[Str] = json.Patch.Absent
  /// Used for rotation of user managed Key Vault keys. Can only be used to rotate a user managed encryption Key Vault key.
  pub encryption_config as "encryptionConfig,omitempty": json.Patch[UpdateEncryptionConfig] = json.Patch.Absent
  /// The current state of allowing or disallowing IPs originating within Azure through the firewall. If the firewall is disabled, this is not enforced.
  pub firewall_allow_azure_ips as "firewallAllowAzureIps,omitempty": json.Patch[FirewallAllowAzureIPsState] = json.Patch.Absent
  /// The list of firewall rules associated with this Data Lake Store account.
  pub firewall_rules as "firewallRules,omitempty": json.Patch[List[UpdateFirewallRuleWithAccountParameters]] = json.Patch.Absent
  /// The current state of the IP address firewall for this Data Lake Store account. Disabling the firewall does not remove existing rules, they will just be ignored until the firewall is re-enabled.
  pub firewall_state as "firewallState,omitempty": json.Patch[FirewallState] = json.Patch.Absent
  /// The commitment tier to use for next month.
  pub new_tier as "newTier,omitempty": json.Patch[TierType] = json.Patch.Absent
  /// The current state of the trusted identity provider feature for this Data Lake Store account. Disabling trusted identity provider functionality does not remove the providers, they will just be ignored until this feature is re-enabled.
  pub trusted_id_provider_state as "trustedIdProviderState,omitempty": json.Patch[TrustedIDProviderState] = json.Patch.Absent
  /// The list of trusted identity providers associated with this Data Lake Store account.
  pub trusted_id_providers as "trustedIdProviders,omitempty": json.Patch[List[UpdateTrustedIDProviderWithAccountParameters]] = json.Patch.Absent
  /// The list of virtual network rules associated with this Data Lake Store account.
  pub virtual_network_rules as "virtualNetworkRules,omitempty": json.Patch[List[UpdateVirtualNetworkRuleWithAccountParameters]] = json.Patch.Absent
} derive Json

/// Data Lake Store account information to update.
pub struct UpdateDataLakeStoreAccountParameters {
  /// The Data Lake Store account properties to update.
  pub properties as "properties,omitempty": json.Patch[UpdateDataLakeStoreAccountProperties] = json.Patch.Absent
  /// Resource tags
  pub tags as "tags,omitempty": json.Patch[Map[Str, Str]] = json.Patch.Absent
} derive Json

