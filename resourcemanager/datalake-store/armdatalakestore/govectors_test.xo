  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"subnetId\":\"s-subnetid\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualNetworkRulesClient.NewListByAccountPager")
  var pg = c.new_list_by_account_pager("id1/ x", "id2/ x", VirtualNetworkRulesClientListByAccountOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_network_rules_client_list_by_account_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_24)
}

fn show_virtual_network_rules_client_update_response(r: VirtualNetworkRulesClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.virtual_network_rule).to_str_lossy()}")
  parts.join(" ")
}

const GO_25: List[Str] = [
  "CALL VirtualNetworkRulesClient.Update",
  "REQ PATCH https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.DataLakeStore/accounts/id2%2F%20x/virtualNetworkRules/id3%2F%20x?api-version=2016-11-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"properties\":{\"subnetId\":\"s-subnetid\"}}",
  "  SERVED 200 {\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"subnetId\":\"s-subnetid\"},\"type\":\"s-type\"}",
  "OUT: body={\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"subnetId\":\"s-subnetid\"},\"type\":\"s-type\"}",
]

test "Go's VirtualNetworkRulesClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_network_rules_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"subnetId\":\"s-subnetid\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL VirtualNetworkRulesClient.Update")
  match c.update("id1/ x", "id2/ x", "id3/ x", VirtualNetworkRulesClientUpdateOptions{parameters: Some((json.decode_str[UpdateVirtualNetworkRuleParameters]("{\"properties\":{\"subnetId\":\"s-subnetid\"}}") ?? e => fault("${e}")))}) {
    Ok(r) => gv_note(f, "OUT: ${show_virtual_network_rules_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_25)
}
