fn show_workspaces_client_list_by_resource_group_response(r: WorkspacesClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.workspace_list_result).to_str_lossy()}")
  parts.join(" ")
}

