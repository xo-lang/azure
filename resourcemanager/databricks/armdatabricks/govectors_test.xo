test "Go's WorkspacesClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_workspaces_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessConnector\":{\"id\":\"s-id\",\"identityType\":\"s-identitytype\",\"userAssignedIdentityId\":\"s-userassignedidentityid\"},\"authorizations\":[{\"principalId\":\"s-principalid\",\"roleDefinitionId\":\"s-roledefinitionid\"}],\"computeMode\":\"s-computemode\",\"createdBy\":{\"applicationId\":\"s-applicationid\",\"oid\":\"s-oid\",\"puid\":\"s-puid\"},\"createdDateTime\":\"2026-11-06T10:00:00Z\",\"defaultCatalog\":{\"initialName\":\"s-initialname\",\"initialType\":\"s-initialtype\"},\"defaultStorageFirewall\":\"s-defaultstoragefirewall\",\"diskEncryptionSetId\":\"s-diskencryptionsetid\",\"encryption\":{\"entities\":{\"managedDisk\":{\"keySource\":\"s-keysource\",\"rotationToLatestKeyVersionEnabled\":true},\"managedServices\":{\"keySource\":\"s-keysource\"}}},\"enhancedSecurityCompliance\":{\"automaticClusterUpdate\":{\"value\":\"s-value\"},\"complianceSecurityProfile\":{\"complianceStandards\":[\"s-compliancestandards\"],\"value\":\"s-value\"},\"enhancedSecurityMonitoring\":{\"value\":\"s-value\"}},\"isUcEnabled\":true,\"managedDiskIdentity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"managedResourceGroupId\":\"s-managedresourcegroupid\",\"parameters\":{\"amlWorkspaceId\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"customPrivateSubnetName\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"customPublicSubnetName\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"customVirtualNetworkId\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"enableNoPublicIp\":{\"type\":\"s-type\",\"value\":true},\"encryption\":{\"type\":\"s-type\",\"value\":{\"KeyName\":\"s-keyname\",\"keySource\":\"s-keysource\",\"keyvaulturi\":\"s-keyvaulturi\",\"keyversion\":\"s-keyversion\"}},\"loadBalancerBackendPoolName\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"loadBalancerId\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"natGatewayName\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"prepareEncryption\":{\"type\":\"s-type\",\"value\":true},\"publicIpName\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"requireInfrastructureEncryption\":{\"type\":\"s-type\",\"value\":true},\"resourceTags\":{\"type\":\"s-type\",\"value\":{\"k\":\"v\"}},\"storageAccountName\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"storageAccountSkuName\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"vnetAddressPrefix\":{\"type\":\"s-type\",\"value\":\"s-value\"}},\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"requiredNsgRules\":\"s-requirednsgrules\",\"storageAccountIdentity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"uiDefinitionUri\":\"s-uidefinitionuri\",\"updatedBy\":{\"applicationId\":\"s-applicationid\",\"oid\":\"s-oid\",\"puid\":\"s-puid\"},\"workspaceId\":\"s-workspaceid\",\"workspaceUrl\":\"s-workspaceurl\"},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkspacesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", WorkspacesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workspaces_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_22)
}

fn show_workspaces_client_list_by_subscription_response(r: WorkspacesClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.workspace_list_result).to_str_lossy()}")
  parts.join(" ")
}

