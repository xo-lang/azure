  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if storage_mover_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter storageMoverName cannot be empty"))
  }
  path = path.replace("{storageMoverName}", url.path_escape(storage_mover_name))
  if project_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter projectName cannot be empty"))
  }
  path = path.replace("{projectName}", url.path_escape(project_name))
  if job_definition_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter jobDefinitionName cannot be empty"))
  }
  path = path.replace("{jobDefinitionName}", url.path_escape(job_definition_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: b""})
}

/// Requests the Agent of any active instance of this Job Definition to stop.
pub fn (c: JobDefinitionsClient) stop_job(resource_group_name: Str, storage_mover_name: Str, project_name: Str, job_definition_name: Str, options: JobDefinitionsClientStopJobOptions = JobDefinitionsClientStopJobOptions{}) -> JobDefinitionsClientStopJobResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let sp = runtime.start_span({}, "JobDefinitionsClient.StopJob", c.setup.pipeline.tracer)
  let req = sp.on(c.stop_job_create_request(resource_group_name, storage_mover_name, project_name, job_definition_name, options) ?? e => return Err(sp.fail(e)))
  let resp = c.setup.pipeline.send(req) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![200].contains(resp.status) {
    return Err(sp.close(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  let out = job_definitions_stop_job_handle(resp) ?? e => return Err(sp.close(azcore.CallErr.Decode(e)))
  sp.end()
  Ok(out)
}
