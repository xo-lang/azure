test "Go's AgentsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_agents_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"agentStatus\":\"s-agentstatus\",\"agentVersion\":\"s-agentversion\",\"arcResourceId\":\"s-arcresourceid\",\"arcVmUuid\":\"s-arcvmuuid\",\"description\":\"s-description\",\"errorDetails\":{\"code\":\"s-code\",\"message\":\"s-message\"},\"lastStatusUpdate\":\"2026-11-06T10:00:00Z\",\"localIPAddress\":\"s-localipaddress\",\"memoryInMB\":7,\"numberOfCores\":7,\"provisioningState\":\"Succeeded\",\"timeZone\":\"s-timezone\",\"uploadLimitSchedule\":{\"weeklyRecurrences\":[{\"limitInMbps\":7}]},\"uptimeInSeconds\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AgentsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", AgentsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_agents_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_3)
}

