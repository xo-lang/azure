  let c = new_agents_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"agentStatus\":\"s-agentstatus\",\"agentVersion\":\"s-agentversion\",\"arcResourceId\":\"s-arcresourceid\",\"arcVmUuid\":\"s-arcvmuuid\",\"description\":\"s-description\",\"errorDetails\":{\"code\":\"s-code\",\"message\":\"s-message\"},\"lastStatusUpdate\":\"2026-11-06T10:00:00Z\",\"localIPAddress\":\"s-localipaddress\",\"memoryInMB\":7,\"numberOfCores\":7,\"provisioningState\":\"Succeeded\",\"timeZone\":\"s-timezone\",\"uploadLimitSchedule\":{\"weeklyRecurrences\":[{\"days\":[\"s-days\"],\"endTime\":{\"hour\":7,\"minute\":7},\"limitInMbps\":7,\"startTime\":{\"hour\":7,\"minute\":7}}]},\"uptimeInSeconds\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL AgentsClient.Update")
