pub fn (c: VPNLinkConnectionsClient) list_default_shared_key(resource_group_name: Str, gateway_name: Str, connection_name: Str, link_connection_name: Str, options: VPNLinkConnectionsClientListDefaultSharedKeyOptions = VPNLinkConnectionsClientListDefaultSharedKeyOptions{}) -> VPNLinkConnectionsClientListDefaultSharedKeyResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.list_default_shared_key_create_request(resource_group_name, gateway_name, connection_name, link_connection_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  vpn_link_connections_list_default_shared_key_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
