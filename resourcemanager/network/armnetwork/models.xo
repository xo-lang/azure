pub fn possible_diagnostic_operation_values() -> List[DiagnosticOperation] {
  [DIAGNOSTIC_OPERATION_CONNECTIVITY_CHECK, DIAGNOSTIC_OPERATION_EXPRESS_ROUTE_DIAGNOSTIC, DIAGNOSTIC_OPERATION_NSG, DIAGNOSTIC_OPERATION_NEXT_HOP, DIAGNOSTIC_OPERATION_PORT_SCAN]
}

