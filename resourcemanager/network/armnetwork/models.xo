/// ManagedServiceIdentityPatch: ManagedServiceIdentity in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct ManagedServiceIdentityPatch {
  /// The principal id of the system assigned identity. This property will only be provided for a system assigned identity.
  pub principal_id as "principalId,omitempty": json.Patch[Str] = json.Patch.Absent
  /// The tenant id of the system assigned identity. This property will only be provided for a system assigned identity.
  pub tenant_id as "tenantId,omitempty": json.Patch[Str] = json.Patch.Absent
  /// The type of identity used for the resource. The type 'SystemAssigned, UserAssigned' includes both an implicitly created identity and a set of user assigned identities. The type 'None' will remove any identities from the virtual machine.
  pub type_ as "type,omitempty": json.Patch[ResourceIdentityType] = json.Patch.Absent
  /// The list of user identities associated with resource. The user identity dictionary key references will be ARM resource ids in the form: '/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.ManagedIdentity/userAssignedIdentities/{identityName}'.
  pub user_assigned_identities as "userAssignedIdentities,omitempty": json.Patch[Map[Str, ManagedServiceIdentityUserAssignedIdentities]] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: ManagedServiceIdentity) patch() -> ManagedServiceIdentityPatch {
  ManagedServiceIdentityPatch{
    principal_id: match m.principal_id {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    tenant_id: match m.tenant_id {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    type_: match m.type_ {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    user_assigned_identities: match m.user_assigned_identities {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
