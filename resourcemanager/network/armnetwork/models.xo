pub const DIAGNOSTIC_OPERATION_NSG: DiagnosticOperation = DiagnosticOperation("NSG")
/// Determines the next hop for traffic from the source to the destination.
pub const DIAGNOSTIC_OPERATION_NEXT_HOP: DiagnosticOperation = DiagnosticOperation("NextHop")
/// Scans the destination ports to determine their reachability.
pub const DIAGNOSTIC_OPERATION_PORT_SCAN: DiagnosticOperation = DiagnosticOperation("PortScan")

