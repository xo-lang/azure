  pub selector as "selector,omitempty": Str? = None
  /// When matchVariable is a collection, operate on the selector to specify which elements in the collection this rule applies to.
  pub selector_match_operator as "selectorMatchOperator,omitempty": ScrubbingRuleEntryMatchOperator? = None
  /// Defines the state of log scrubbing rule. Default value is Enabled.
  pub state as "state,omitempty": ScrubbingRuleEntryState? = None
} derive Json

