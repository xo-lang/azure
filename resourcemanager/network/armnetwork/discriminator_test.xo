// Go's JSON for polymorphic models, from a Go program over Go's
// armnetwork/v12 v12.1.0: a subtype alone (its discriminator unset, or set to
// another value), the base alone, and each through a field of the
// base's interface type. Go's subtype writes its own value always.

use github.com/xo-lang/azure/runtime

/// Where ours still differs from Go's: (Go's line, ours).
const DISC_KNOWN: List[(Str, Str)] = []

test "polymorphic models encode as Go's, alone and through the base" {
  let got = [
    "network.derived ${runtime.marshal_json(ApplicationRule{name: Some("r1")}).to_str_lossy()}",
    "network.derived_other ${runtime.marshal_json(ApplicationRule{name: Some("r1"), rule_type: Some(FIREWALL_POLICY_RULE_TYPE_NAT_RULE)}).to_str_lossy()}",
    "network.base ${runtime.marshal_json(FirewallPolicyRule{name: Some("r1")}).to_str_lossy()}",
    "network.base_set ${runtime.marshal_json(FirewallPolicyRule{name: Some("r1"), rule_type: Some(FIREWALL_POLICY_RULE_TYPE_NAT_RULE)}).to_str_lossy()}",
    "network.through ${runtime.marshal_json(FirewallPolicyFilterRuleCollection{rules: Some([FirewallPolicyRuleClassification.ApplicationRule(ApplicationRule{name: Some("a")}), FirewallPolicyRuleClassification.FirewallPolicyRule(FirewallPolicyRule{name: Some("b")})])}).to_str_lossy()}",
  ]
  let want = [
    "network.derived {\"name\":\"r1\",\"ruleType\":\"ApplicationRule\"}",
    "network.derived_other {\"name\":\"r1\",\"ruleType\":\"ApplicationRule\"}",
    "network.base {\"name\":\"r1\"}",
    "network.base_set {\"name\":\"r1\",\"ruleType\":\"NatRule\"}",
    "network.through {\"ruleCollectionType\":\"FirewallPolicyFilterRuleCollection\",\"rules\":[{\"name\":\"a\",\"ruleType\":\"ApplicationRule\"},{\"name\":\"b\"}]}",
  ]
  expect(got.len()) == want.len()
  var bad: List[Str] = []
  var i = 0
  while i < want.len() {
    let w = want[i]
    let ours = DISC_KNOWN.filter(fn(p: (Str, Str)) -> Bool { p.0 == w }).get(0).map(fn(p: (Str, Str)) -> Str { p.1 }) ?? w
    if got[i] != ours {
      bad.push("want: ${ours}\n  got:  ${got[i]}")
    }
    i += 1
  }
  expect(bad.join("\n")) == ""
}
