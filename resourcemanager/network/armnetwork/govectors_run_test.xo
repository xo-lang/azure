// The VirtualNetworks client against the Go program's fake Resource
// Manager: each request, decoded result, page and resume token must be
// Go's (govectors_test.xo).

use std/json
use github.com/xo-lang/azure/arm

const GV_VNB: Str = "{\"id\":\"/subscriptions/sub-test/resourceGroups/rg1/providers/Microsoft.Network/virtualNetworks/vn1\",\"name\":\"vn1\",\"etag\":\"W/\\\"e1\\\"\",\"location\":\"westus\",\"properties\":{\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"00000000-0000-0000-0000-000000000000\",\"addressSpace\":{\"addressPrefixes\":[\"10.0.0.0/16\"]},\"subnets\":[{\"id\":\"/subscriptions/sub-test/resourceGroups/rg1/providers/Microsoft.Network/virtualNetworks/vn1/subnets/s1\",\"name\":\"s1\",\"properties\":{\"addressPrefix\":\"10.0.0.0/24\",\"privateEndpointNetworkPolicies\":\"Disabled\"}}],\"enableDdosProtection\":false}}"
const GV_VNB_UPDATING: Str = "{\"id\":\"/subscriptions/sub-test/resourceGroups/rg1/providers/Microsoft.Network/virtualNetworks/vn1\",\"name\":\"vn1\",\"etag\":\"W/\\\"e1\\\"\",\"location\":\"westus\",\"properties\":{\"provisioningState\":\"Updating\",\"resourceGuid\":\"00000000-0000-0000-0000-000000000000\",\"addressSpace\":{\"addressPrefixes\":[\"10.0.0.0/16\"]},\"subnets\":[{\"id\":\"/subscriptions/sub-test/resourceGroups/rg1/providers/Microsoft.Network/virtualNetworks/vn1/subnets/s1\",\"name\":\"s1\",\"properties\":{\"addressPrefix\":\"10.0.0.0/24\",\"privateEndpointNetworkPolicies\":\"Disabled\"}}],\"enableDdosProtection\":false}}"
const GV_VN: Str = "/subscriptions/sub-test/resourceGroups/rg1/providers/Microsoft.Network/virtualNetworks/vn1"
const GV_OP: Str = "/subscriptions/sub-test/providers/Microsoft.Network/locations/westus/operations/op4"
const GV_ALL: Str = "/subscriptions/sub-test/providers/Microsoft.Network/virtualNetworks"

test "the create poller with its final GET, get and the list pages match Go's" {
  let f = gv_serve(os.net)
  let c = new_virtual_networks_client(os.net, os.clock, os.rand, SUB, Fixed{}, arm.ClientOptions{endpoint: EP})?
  gv_add(f, "PUT", GV_VN, GvReply{status: 201, body: GV_VNB_UPDATING, headers: [("Azure-AsyncOperation", "${EP}${GV_OP}?api-version=2025-03-01")]})
  gv_add(f, "GET", GV_OP, GvReply{status: 200, body: "{\"status\":\"InProgress\"}"})
  gv_add(f, "GET", GV_OP, GvReply{status: 200, body: "{\"status\":\"Succeeded\"}"})
  gv_add(f, "GET", GV_VN, GvReply{status: 200, body: GV_VNB})
  let vn = VirtualNetwork{location: Some("westus"), properties: Some(VirtualNetworkPropertiesFormat{address_space: Some(AddressSpace{address_prefixes: Some(["10.0.0.0/16"])})})}
  match c.begin_create_or_update("rg1", "vn1", vn) {
    Ok(p0) => {
      var p = p0
      gv_token(f, "create_or_update", p)
      gv_show(f, "create_or_update", p.poll_until_done(os.clock, frequency: 1ms), fn(r: VirtualNetworksClientCreateOrUpdateResponse) -> Str { gv_json(json.to_value(r.virtual_network)) })
    }
    Err(e) => gv_note(f, "ERR begin_create_or_update: ${gv_err(e)}")
  }
  gv_add(f, "GET", GV_VN, GvReply{status: 200, body: GV_VNB})
  gv_show(f, "get", c.get("rg1", "vn1", VirtualNetworksClientGetOptions{expand: Some("subnets/ipConfigurations")}), fn(r: VirtualNetworksClientGetResponse) -> Str { gv_json(json.to_value(r.virtual_network)) })
  gv_add(f, "GET", GV_ALL, GvReply{status: 200, body: "{\"value\":[${GV_VNB}],\"nextLink\":\"${EP}${GV_ALL}?api-version=2025-03-01&\$skipToken=n%2F1\"}"})
  gv_add(f, "GET", GV_ALL, GvReply{status: 200, body: "{\"value\":[]}"})
  var pl = c.new_list_all_pager()?
  while pl.more() {
    let pg = pl.next_page()
    gv_show(f, "list_all_page", pg, fn(r: VirtualNetworksClientListAllResponse) -> Str { gv_json(json.to_value(r.virtual_network_list_result)) })
    if pg.is_err() {
      break
    }
  }
  gv_check(f)
}
