  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"addressLocation\":\"s-addresslocation\",\"addresses\":[{\"address\":\"s-address\",\"services\":[\"s-services\"]}]}]}",
