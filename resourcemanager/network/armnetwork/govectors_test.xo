test "Go's SecurityUserRulesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_security_user_rules_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"destinationPortRanges\":[\"s-destinationportranges\"],\"destinations\":[{\"addressPrefix\":\"s-addressprefix\",\"addressPrefixType\":\"s-addressprefixtype\"}],\"direction\":\"s-direction\",\"protocol\":\"s-protocol\",\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"sourcePortRanges\":[\"s-sourceportranges\"],\"sources\":[{\"addressPrefix\":\"s-addressprefix\",\"addressPrefixType\":\"s-addressprefixtype\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SecurityUserRulesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", SecurityUserRulesClientListOptions{skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_security_user_rules_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_573)
}

