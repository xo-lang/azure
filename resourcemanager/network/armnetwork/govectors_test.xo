  let c = new_service_gateways_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"routeTargetAddress\":{\"privateIPAddress\":\"s-privateipaddress\",\"privateIPAllocationMethod\":\"s-privateipallocationmethod\",\"subnet\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"addressPrefix\":\"s-addressprefix\",\"defaultOutboundAccess\":true,\"privateEndpointNetworkPolicies\":\"s-privateendpointnetworkpolicies\",\"privateLinkServiceNetworkPolicies\":\"https://management.example.test/next?\$skiptoken=2\",\"provisioningState\":\"Succeeded\",\"purpose\":\"s-purpose\",\"sharingScope\":\"s-sharingscope\"},\"type\":\"s-type\"}},\"routeTargetAddressV6\":{\"privateIPAddress\":\"s-privateipaddress\",\"privateIPAllocationMethod\":\"s-privateipallocationmethod\",\"subnet\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"addressPrefix\":\"s-addressprefix\",\"defaultOutboundAccess\":true,\"privateEndpointNetworkPolicies\":\"s-privateendpointnetworkpolicies\",\"privateLinkServiceNetworkPolicies\":\"https://management.example.test/next?\$skiptoken=2\",\"provisioningState\":\"Succeeded\",\"purpose\":\"s-purpose\",\"sharingScope\":\"s-sharingscope\"},\"type\":\"s-type\"}},\"virtualNetwork\":{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"addressSpace\":{},\"bgpCommunities\":{\"regionalCommunity\":\"s-regionalcommunity\",\"virtualNetworkCommunity\":\"s-virtualnetworkcommunity\"},\"ddosProtectionPlan\":{\"id\":\"s-id\"},\"defaultPublicNatGateway\":{\"id\":\"s-id\"},\"dhcpOptions\":{},\"enableDdosProtection\":true,\"enableVmProtection\":true,\"encryption\":{\"enabled\":true,\"enforcement\":\"s-enforcement\"},\"flowTimeoutInMinutes\":7,\"privateEndpointVNetPolicies\":\"s-privateendpointvnetpolicies\",\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"summarizedGatewayPrefixes\":{}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
  gv_note(f, "CALL ServiceGatewaysClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", ServiceGatewaysClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_service_gateways_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_591)
}

