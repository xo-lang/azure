test "Go's DscpConfigurationClient.NewListAllPager" {
  let f = gv_new_fake(os.net)
  let c = new_dscp_configuration_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"associatedNetworkInterfaces\":[{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"auxiliaryMode\":\"s-auxiliarymode\",\"auxiliarySku\":\"s-auxiliarysku\",\"defaultOutboundConnectivityEnabled\":true,\"disableTcpStateTracking\":true,\"enableAcceleratedNetworking\":true,\"enableIPForwarding\":true,\"macAddress\":\"s-macaddress\",\"migrationPhase\":\"s-migrationphase\",\"nicType\":\"s-nictype\",\"primary\":true,\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"vnetEncryptionSupported\":true,\"workloadType\":\"s-workloadtype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}],\"destinationIpRanges\":[{\"endIP\":\"s-endip\",\"startIP\":\"s-startip\"}],\"destinationPortRanges\":[{\"end\":7,\"start\":7}],\"markings\":[7],\"protocol\":\"s-protocol\",\"provisioningState\":\"Succeeded\",\"qosCollectionId\":\"s-qoscollectionid\",\"qosDefinitionCollection\":[{\"markings\":[7],\"protocol\":\"s-protocol\"}],\"resourceGuid\":\"s-resourceguid\",\"sourceIpRanges\":[{\"endIP\":\"s-endip\",\"startIP\":\"s-startip\"}],\"sourcePortRanges\":[{\"end\":7,\"start\":7}]},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DscpConfigurationClient.NewListAllPager")
  var pg = c.new_list_all_pager(DscpConfigurationClientListAllOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_dscp_configuration_client_list_all_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_117)
}

