fn show_vpn_gateways_client_reset_response(r: VPNGatewaysClientResetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.vpn_gateway).to_str_lossy()}")
  parts.join(" ")
}

