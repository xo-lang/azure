test "Go's ProfilesClient.UpdateTags" {
  let f = gv_new_fake(os.net)
  let c = new_profiles_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"containerNetworkInterfaceConfigurations\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"containerNetworkInterfaces\":[{\"id\":\"s-id\"}],\"ipConfigurations\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"containerNetworkInterfaces\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"container\":{\"id\":\"s-id\"},\"containerNetworkInterfaceConfiguration\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"},\"ipConfigurations\":[{\"etag\":\"s-etag\",\"name\":\"s-name\",\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ProfilesClient.UpdateTags")
  match c.update_tags("id1/ x", "id2/ x", (json.decode_str[TagsObject]("{\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), ProfilesClientUpdateTagsOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_profiles_client_update_tags_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_437)
}

fn show_public_ip_addresses_client_create_or_update_response(r: PublicIPAddressesClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.public_ip_address).to_str_lossy()}")
  parts.join(" ")
}

