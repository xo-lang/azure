fn show_interfaces_client_get_cloud_service_network_interface_response(r: InterfacesClientGetCloudServiceNetworkInterfaceResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.interface_).to_str_lossy()}")
  parts.join(" ")
}

