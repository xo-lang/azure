test "Go's InboundNatRulesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_inbound_nat_rules_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"backendAddressPool\":{\"id\":\"s-id\"},\"backendIPConfiguration\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"gatewayLoadBalancer\":{\"id\":\"s-id\"},\"primary\":true,\"privateIPAddress\":\"s-privateipaddress\",\"privateIPAddressPrefixLength\":7,\"privateIPAddressVersion\":\"s-privateipaddressversion\",\"privateIPAllocationMethod\":\"s-privateipallocationmethod\",\"privateLinkConnectionProperties\":{\"groupId\":\"s-groupid\",\"requiredMemberName\":\"s-requiredmembername\"},\"provisioningState\":\"Succeeded\",\"publicIPAddress\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"},\"subnet\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"}},\"type\":\"s-type\"},\"backendPort\":7,\"enableFloatingIP\":true,\"enableTcpReset\":true,\"frontendIPConfiguration\":{\"id\":\"s-id\"},\"frontendPort\":7,\"frontendPortRangeEnd\":7,\"frontendPortRangeStart\":7,\"idleTimeoutInMinutes\":7,\"protocol\":\"s-protocol\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL InboundNatRulesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", InboundNatRulesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_inbound_nat_rules_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_282)
}

