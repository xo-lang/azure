  let f = gv_new_fake(os.net)
  let c = new_load_balancer_probes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"intervalInSeconds\":7,\"loadBalancingRules\":[{\"id\":\"s-id\"}],\"noHealthyBackendsBehavior\":\"s-nohealthybackendsbehavior\",\"numberOfProbes\":7,\"port\":7,\"probeThreshold\":7,\"protocol\":\"s-protocol\",\"provisioningState\":\"Succeeded\",\"requestPath\":\"s-requestpath\"},\"type\":\"s-type\"}]}")
