test "Go's P2SVPNGatewaysClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_p2_svpn_gateways_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"customDnsServers\":[\"s-customdnsservers\"],\"isRoutingPreferenceInternet\":true,\"p2SConnectionConfigurations\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"enableInternetSecurity\":true,\"provisioningState\":\"Succeeded\"}}],\"provisioningState\":\"Succeeded\",\"virtualHub\":{\"id\":\"s-id\"},\"vpnClientConnectionHealth\":{\"allocatedIpAddresses\":[\"s-allocatedipaddresses\"],\"totalEgressBytesTransferred\":7,\"totalIngressBytesTransferred\":7,\"vpnClientConnectionsCount\":7},\"vpnGatewayScaleUnit\":7,\"vpnServerConfiguration\":{\"id\":\"s-id\"}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL P2SVPNGatewaysClient.NewListPager")
  var pg = c.new_list_pager(P2SVPNGatewaysClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_p2_svpn_gateways_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_401)
}

