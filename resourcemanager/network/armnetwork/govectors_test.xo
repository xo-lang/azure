test "Go's InterfacesClient.BeginListEffectiveNetworkSecurityGroups" {
  let f = gv_new_fake(os.net)
  let c = new_interfaces_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"association\":{\"networkInterface\":{\"id\":\"s-id\"},\"networkManager\":{\"id\":\"s-id\"},\"subnet\":{\"id\":\"s-id\"}},\"effectiveSecurityRules\":[{\"access\":\"s-access\",\"destinationAddressPrefix\":\"s-destinationaddressprefix\",\"destinationAddressPrefixes\":[\"s-destinationaddressprefixes\"],\"destinationPortRange\":\"s-destinationportrange\",\"destinationPortRanges\":[\"s-destinationportranges\"],\"direction\":\"s-direction\",\"expandedDestinationAddressPrefix\":[\"s-expandeddestinationaddressprefix\"],\"expandedSourceAddressPrefix\":[\"s-expandedsourceaddressprefix\"],\"name\":\"s-name\",\"priority\":7,\"protocol\":\"s-protocol\",\"sourceAddressPrefix\":\"s-sourceaddressprefix\",\"sourceAddressPrefixes\":[\"s-sourceaddressprefixes\"],\"sourcePortRange\":\"s-sourceportrange\",\"sourcePortRanges\":[\"s-sourceportranges\"]}],\"networkSecurityGroup\":{\"id\":\"s-id\"},\"tagMap\":{\"k1\":[\"s-tagmap\"]}}]}")
  gv_note(f, "CALL InterfacesClient.BeginListEffectiveNetworkSecurityGroups")
  match c.begin_list_effective_network_security_groups("id1/ x", "id2/ x", InterfacesClientBeginListEffectiveNetworkSecurityGroupsOptions{}) {
    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(r) => gv_note(f, "OUT: ${show_interfaces_client_list_effective_network_security_groups_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_302)
}

fn show_interfaces_client_get_response(r: InterfacesClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.interface_).to_str_lossy()}")
  parts.join(" ")
}

