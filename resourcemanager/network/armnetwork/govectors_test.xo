test "Go's VirtualHubRouteTableV2SClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_hub_route_table_v2_s_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"attachedConnections\":[\"s-attachedconnections\"],\"provisioningState\":\"Succeeded\",\"routes\":[{\"destinationType\":\"s-destinationtype\",\"destinations\":[\"s-destinations\"],\"nextHopType\":\"s-nexthoptype\",\"nextHops\":[\"s-nexthops\"]}]}}]}")
  gv_note(f, "CALL VirtualHubRouteTableV2SClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", VirtualHubRouteTableV2SClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_hub_route_table_v2_s_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_702)
}

