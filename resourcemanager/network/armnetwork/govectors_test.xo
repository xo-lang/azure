  gv_note(f, "CALL ApplicationGatewaysClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", ApplicationGatewaysClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_application_gateways_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_34)
}

fn show_application_gateways_client_update_tags_response(r: ApplicationGatewaysClientUpdateTagsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.application_gateway).to_str_lossy()}")
  parts.join(" ")
}

