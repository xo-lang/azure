fn show_profiles_client_delete_response(r: ProfilesClientDeleteResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_432: List[Str] = [
  "CALL ProfilesClient.BeginDelete",
  "REQ DELETE https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.Network/networkProfiles/id2%2F%20x?api-version=2026-03-01",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 ",
  "OUT: ",
]

test "Go's ProfilesClient.BeginDelete" {
  let f = gv_new_fake(os.net)
  let c = new_profiles_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL ProfilesClient.BeginDelete")
  match c.begin_delete("id1/ x", "id2/ x", ProfilesClientBeginDeleteOptions{}) {
    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(r) => gv_note(f, "OUT: ${show_profiles_client_delete_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_432)
}

fn show_profiles_client_create_or_update_response(r: ProfilesClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.profile).to_str_lossy()}")
  parts.join(" ")
}

