fn show_virtual_networks_client_create_or_update_response(r: VirtualNetworksClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.virtual_network).to_str_lossy()}")
  parts.join(" ")
}

