  match c.begin_delete("id1/ x", "id2/ x", VPNGatewaysClientBeginDeleteOptions{}) {
    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(r) => gv_note(f, "OUT: ${show_vpn_gateways_client_delete_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
