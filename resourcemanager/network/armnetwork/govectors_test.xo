  gv_note(f, "CALL RouteFiltersClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", RouteFiltersClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
