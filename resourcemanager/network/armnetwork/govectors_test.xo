  gv_note(f, "CALL InterfacesClient.NewListCloudServiceNetworkInterfacesPager")
  var pg = c.new_list_cloud_service_network_interfaces_pager("id1/ x", "id2/ x", InterfacesClientListCloudServiceNetworkInterfacesOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_interfaces_client_list_cloud_service_network_interfaces_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_308)
}

fn show_interfaces_client_list_cloud_service_role_instance_network_interfaces_response(r: InterfacesClientListCloudServiceRoleInstanceNetworkInterfacesResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.interface_list_result).to_str_lossy()}")
  parts.join(" ")
}

