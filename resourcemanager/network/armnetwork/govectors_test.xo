test "Go's ExpressRouteCircuitsClient.NewListAllPager" {
  let f = gv_new_fake(os.net)
  let c = new_express_route_circuits_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"activationKey\":\"s-activationkey\",\"allowClassicOperations\":true,\"authorizationKey\":\"s-authorizationkey\",\"authorizationStatus\":\"s-authorizationstatus\",\"authorizations\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"authorizationKey\":\"s-authorizationkey\",\"authorizationUseStatus\":\"s-authorizationusestatus\",\"connectionResourceUri\":\"s-connectionresourceuri\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"bandwidthInGbps\":1.5,\"circuitProvisioningState\":\"s-circuitprovisioningstate\",\"enableDirectPortRateLimit\":true,\"expressRouteLag\":{\"id\":\"s-id\"},\"expressRoutePort\":{\"id\":\"s-id\"},\"gatewayManagerEtag\":\"s-gatewaymanageretag\",\"globalReachEnabled\":true,\"partnerAccountId\":\"s-partneraccountid\",\"peerings\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"azureASN\":7,\"gatewayManagerEtag\":\"s-gatewaymanageretag\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"peerASN\":7,\"peeringType\":\"s-peeringtype\",\"primaryAzurePort\":\"s-primaryazureport\",\"primaryPeerAddressPrefix\":\"s-primarypeeraddressprefix\",\"provisioningState\":\"Succeeded\",\"secondaryAzurePort\":\"s-secondaryazureport\",\"secondaryPeerAddressPrefix\":\"s-secondarypeeraddressprefix\",\"sharedKey\":\"s-sharedkey\",\"state\":\"s-state\",\"vlanId\":7},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"resiliencyLevel\":\"s-resiliencylevel\",\"serviceKey\":\"s-servicekey\",\"serviceProviderNotes\":\"s-serviceprovidernotes\",\"serviceProviderProperties\":{\"bandwidthInMbps\":7,\"peeringLocation\":\"s-peeringlocation\",\"serviceProviderName\":\"s-serviceprovidername\"},\"serviceProviderProvisioningState\":\"s-serviceproviderprovisioningstate\",\"stag\":7},\"sku\":{\"family\":\"s-family\",\"name\":\"s-name\",\"tier\":\"s-tier\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ExpressRouteCircuitsClient.NewListAllPager")
  var pg = c.new_list_all_pager(ExpressRouteCircuitsClientListAllOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_express_route_circuits_client_list_all_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_144)
}

