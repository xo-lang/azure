test "Go's PrivateLinkServicesClient.BeginCheckPrivateLinkServiceVisibility" {
  let f = gv_new_fake(os.net)
  let c = new_private_link_services_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"visible\":true}")
  gv_note(f, "CALL PrivateLinkServicesClient.BeginCheckPrivateLinkServiceVisibility")
  match c.begin_check_private_link_service_visibility("id1/ x", (json.decode_str[CheckPrivateLinkServiceVisibilityRequest]("{\"privateLinkServiceAlias\":\"https://management.example.test/next?\$skiptoken=2\"}") ?? e => fault("${e}")), PrivateLinkServicesClientBeginCheckPrivateLinkServiceVisibilityOptions{}) {
    Ok(p0) => {
      var p = p0
