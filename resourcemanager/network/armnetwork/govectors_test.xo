test "Go's RouteTablesClient.NewListAllPager" {
  let f = gv_new_fake(os.net)
  let c = new_route_tables_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"disableBgpRoutePropagation\":true,\"disablePeeringRoute\":\"s-disablepeeringroute\",\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"routes\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"addressPrefix\":\"s-addressprefix\",\"hasBgpOverride\":true,\"nextHopIpAddress\":\"s-nexthopipaddress\",\"nextHopType\":\"s-nexthoptype\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"subnets\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"addressPrefix\":\"s-addressprefix\",\"defaultOutboundAccess\":true,\"privateEndpointNetworkPolicies\":\"s-privateendpointnetworkpolicies\",\"privateLinkServiceNetworkPolicies\":\"https://management.example.test/next?\$skiptoken=2\",\"provisioningState\":\"Succeeded\",\"purpose\":\"s-purpose\",\"sharingScope\":\"s-sharingscope\"},\"type\":\"s-type\"}]},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RouteTablesClient.NewListAllPager")
  var pg = c.new_list_all_pager(RouteTablesClientListAllOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_route_tables_client_list_all_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_485)
}

