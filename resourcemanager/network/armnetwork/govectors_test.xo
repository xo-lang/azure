test "Go's ServiceGatewaysClient.NewGetAddressLocationsPager" {
  let f = gv_new_fake(os.net)
  let c = new_service_gateways_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"addressLocation\":\"s-addresslocation\",\"addresses\":[{\"address\":\"s-address\",\"services\":[\"s-services\"]}]}]}")
  gv_note(f, "CALL ServiceGatewaysClient.NewGetAddressLocationsPager")
  var pg = c.new_get_address_locations_pager("id1/ x", "id2/ x", ServiceGatewaysClientGetAddressLocationsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_service_gateways_client_get_address_locations_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_588)
}

