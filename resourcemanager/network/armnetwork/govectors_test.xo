  let c = new_connection_monitors_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"autoStart\":true,\"connectionMonitorType\":\"s-connectionmonitortype\",\"destination\":{\"address\":\"s-address\",\"port\":7,\"resourceId\":\"s-resourceid\"},\"endpoints\":[{\"address\":\"s-address\",\"coverageLevel\":\"s-coveragelevel\",\"filter\":{\"type\":\"s-type\"},\"locationDetails\":{\"region\":\"s-region\"},\"name\":\"s-name\",\"resourceId\":\"s-resourceid\",\"scope\":{},\"subscriptionId\":\"s-subscriptionid\",\"type\":\"s-type\"}],\"monitoringIntervalInSeconds\":7,\"monitoringStatus\":\"s-monitoringstatus\",\"notes\":\"s-notes\",\"outputs\":[{\"type\":\"s-type\",\"workspaceSettings\":{\"workspaceResourceId\":\"s-workspaceresourceid\"}}],\"provisioningState\":\"Succeeded\",\"source\":{\"port\":7,\"resourceId\":\"s-resourceid\"},\"startTime\":\"2026-11-06T10:00:00Z\",\"testConfigurations\":[{\"httpConfiguration\":{\"method\":\"s-method\",\"path\":\"s-path\",\"port\":7,\"preferHTTPS\":true},\"icmpConfiguration\":{\"disableTraceRoute\":true},\"name\":\"s-name\",\"preferredIPVersion\":\"s-preferredipversion\",\"protocol\":\"s-protocol\",\"successThreshold\":{\"checksFailedPercent\":7,\"roundTripTimeMs\":1.5},\"tcpConfiguration\":{\"destinationPortBehavior\":\"s-destinationportbehavior\",\"disableTraceRoute\":true,\"port\":7},\"testFrequencySec\":7}],\"testGroups\":[{\"destinations\":[\"s-destinations\"],\"disable\":true,\"name\":\"s-name\",\"sources\":[\"s-sources\"],\"testConfigurations\":[\"s-testconfigurations\"]}]},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ConnectionMonitorsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ConnectionMonitorsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_connection_monitors_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_84)
}

