  let f = gv_new_fake(os.net)
  let c = new_connection_policies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"associatedConnections\":[\"s-associatedconnections\"],\"enableInternetSecurity\":true,\"provisioningState\":\"Succeeded\",\"routingConfiguration\":{\"associatedRouteTable\":{\"id\":\"s-id\"},\"inboundRouteMap\":{\"id\":\"s-id\"},\"outboundRouteMap\":{\"id\":\"s-id\"},\"propagatedRouteTables\":{\"labels\":[\"s-labels\"]},\"vnetRoutes\":{\"staticRoutesConfig\":{\"propagateStaticRoutes\":true,\"vnetLocalRouteOverrideCriteria\":\"s-vnetlocalrouteoverridecriteria\"}}}},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ConnectionPoliciesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ConnectionPoliciesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_connection_policies_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_89)
}

