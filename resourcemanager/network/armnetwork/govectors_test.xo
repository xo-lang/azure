"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"destinationPort\":7,\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL InterfaceIPConfigurationsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", InterfaceIPConfigurationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_interface_ip_configurations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_293)
}

fn show_interface_load_balancers_client_list_response(r: InterfaceLoadBalancersClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.interface_load_balancer_list_result).to_str_lossy()}")
  parts.join(" ")
}

