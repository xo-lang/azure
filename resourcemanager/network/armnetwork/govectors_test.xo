fn show_virtual_networks_client_list_all_response(r: VirtualNetworksClientListAllResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.virtual_network_list_result).to_str_lossy()}")
  parts.join(" ")
}

