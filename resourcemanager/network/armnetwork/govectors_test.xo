oundRules\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"allocatedOutboundPorts\":7,\"enableTcpReset\":true,\"idleTimeoutInMinutes\":7,\"protocol\":\"s-protocol\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"probes\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"intervalInSeconds\":7,\"noHealthyBackendsBehavior\":\"s-nohealthybackendsbehavior\",\"numberOfProbes\":7,\"port\":7,\"probeThreshold\":7,\"protocol\":\"s-protocol\",\"provisioningState\":\"Succeeded\",\"requestPath\":\"s-requestpath\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"scope\":\"s-scope\"},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL LoadBalancersClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", LoadBalancersClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_load_balancers_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_343)
}

fn show_load_balancers_client_update_tags_response(r: LoadBalancersClientUpdateTagsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.load_balancer).to_str_lossy()}")
  parts.join(" ")
}

