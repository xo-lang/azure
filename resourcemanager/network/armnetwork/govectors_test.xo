1\":\"s-tags\"},\"type\":\"s-type\"}],\"privateLinkServiceNetworkPolicies\":\"https://management.example.test/next?\$skiptoken=2\",\"provisioningState\":\"Succeeded\",\"purpose\":\"s-purpose\",\"resourceNavigationLinks\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"link\":\"https://management.example.test/next?\$skiptoken=2\",\"linkedResourceType\":\"https://management.example.test/next?\$skiptoken=2\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"routeTable\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"disableBgpRoutePropagation\":true,\"disablePeeringRoute\":\"s-disablepeeringroute\",\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"},\"serviceAssociationLinks\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"allowDelete\":true,\"link\":\"https://management.example.test/next?\$skiptoken=2\",\"linkedResourceType\":\"https://management.example.test/next?\$skiptoken=2\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"serviceEndpointPolicies\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"serviceAlias\":\"s-servicealias\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}],\"serviceEndpoints\":[{\"locations\":[\"s-locations\"],\"networkIdentifier\":{\"id\":\"s-id\"},\"provisioningState\":\"Succeeded\",\"service\":\"s-service\"}],\"serviceGateway\":{\"id\":\"s-id\"},\"sharingScope\":\"s-sharingscope\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SubnetsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", SubnetsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_subnets_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_612)
}

