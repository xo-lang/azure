  match c.migrate_to_ip_based("id1/ x", "id2/ x", LoadBalancersClientMigrateToIPBasedOptions{parameters: Some((json.decode_str[MigrateLoadBalancerToIPBasedRequest]("{\"pools\":[\"s-pools\"]}") ?? e => fault("${e}")))}) {
