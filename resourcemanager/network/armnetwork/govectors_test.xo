test "Go's InterfaceTapConfigurationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_interface_tap_configurations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\",\"virtualNetworkTap\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"destinationLoadBalancerFrontEndIPConfiguration\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"},\"destinationNetworkInterfaceIPConfiguration\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"},\"destinationPort\":7,\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL InterfaceTapConfigurationsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", InterfaceTapConfigurationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_interface_tap_configurations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_298)
}

