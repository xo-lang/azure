  let c = new_interconnect_groups_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"scope\":\"s-scope\",\"subgroupProfile\":{\"scope\":\"s-scope\",\"size\":7,\"vmSize\":\"s-vmsize\"},\"subgroups\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"internalSubgroupId\":\"s-internalsubgroupid\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}]},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL InterconnectGroupsClient.NewListAllPager")
  var pg = c.new_list_all_pager(InterconnectGroupsClientListAllOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
