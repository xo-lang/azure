test "Go's LoadBalancersClient.NewListAllPager" {
  let f = gv_new_fake(os.net)
  let c = new_load_balancers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"backendAddressPools\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"drainPeriodInSeconds\":7,\"location\":\"s-location\",\"provisioningState\":\"Succeeded\",\"syncMode\":\"s-syncmode\"},\"type\":\"s-type\"}],\"frontendIPConfigurations\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"enableConnectionTracking\":true,\"privateIPAddress\":\"s-privateipaddress\",\"privateIPAddressVersion\":\"s-privateipaddressversion\",\"privateIPAllocationMethod\":\"s-privateipallocationmethod\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}],\"inboundNatPools\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"backendPort\":7,\"enableFloatingIP\":true,\"enableTcpReset\":true,\"frontendPortRangeEnd\":7,\"frontendPortRangeStart\":7,\"idleTimeoutInMinutes\":7,\"protocol\":\"s-protocol\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"inboundNatRules\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"backendPort\":7,\"enableFloatingIP\":true,\"enableTcpReset\":true,\"frontendPort\":7,\"frontendPortRangeEnd\":7,\"frontendPortRangeStart\":7,\"idleTimeoutInMinutes\":7,\"protocol\":\"s-protocol\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"loadBalancingRules\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"backendPort\":7,\"disableOutboundSnat\":true,\"enableConnectionTracking\":true,\"enableFloatingIP\":true,\"enableTcpReset\":true,\"frontendPort\":7,\"idleTimeoutInMinutes\":7,\"loadDistribution\":\"s-loaddistribution\",\"protocol\":\"s-protocol\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"mode\":\"s-mode\",\"outboundRules\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"allocatedOutboundPorts\":7,\"enableTcpReset\":true,\"idleTimeoutInMinutes\":7,\"protocol\":\"s-protocol\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"probes\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"intervalInSeconds\":7,\"noHealthyBackendsBehavior\":\"s-nohealthybackendsbehavior\",\"numberOfProbes\":7,\"port\":7,\"probeThreshold\":7,\"protocol\":\"s-protocol\",\"provisioningState\":\"Succeeded\",\"requestPath\":\"s-requestpath\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"scope\":\"s-scope\"},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL LoadBalancersClient.NewListAllPager")
  var pg = c.new_list_all_pager(LoadBalancersClientListAllOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_load_balancers_client_list_all_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_342)
}

fn show_load_balancers_client_list_response(r: LoadBalancersClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.load_balancer_list_result).to_str_lossy()}")
  parts.join(" ")
}

