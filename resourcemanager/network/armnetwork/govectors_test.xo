test "Go's ServiceTagInformationClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_service_tag_information_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"addressPrefixes\":[\"s-addressprefixes\"],\"changeNumber\":\"s-changenumber\",\"region\":\"s-region\",\"state\":\"s-state\",\"systemService\":\"s-systemservice\"},\"serviceTagChangeNumber\":\"s-servicetagchangenumber\"}]}")
  gv_note(f, "CALL ServiceTagInformationClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", ServiceTagInformationClientListOptions{no_address_prefixes: Some(true), tag_name: Some("s-tagname")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_service_tag_information_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_595)
}

