test "Go's VirtualNetworksClient.NewListUsagePager" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_networks_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"currentValue\":1.5,\"id\":\"s-id\",\"limit\":1.5,\"name\":{\"localizedValue\":\"s-localizedvalue\",\"value\":\"s-value\"},\"unit\":\"s-unit\"}]}")
  gv_note(f, "CALL VirtualNetworksClient.NewListUsagePager")
  var pg = c.new_list_usage_pager("id1/ x", "id2/ x", VirtualNetworksClientListUsageOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_networks_client_list_usage_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_790)
}

