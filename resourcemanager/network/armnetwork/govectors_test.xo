test "Go's VirtualNetworkPeeringsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_network_peerings_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"allowForwardedTraffic\":true,\"allowGatewayTransit\":true,\"allowVirtualNetworkAccess\":true,\"doNotVerifyRemoteGateways\":true,\"enableOnlyIPv6Peering\":true,\"localAddressSpace\":{\"addressPrefixes\":[\"s-addressprefixes\"],\"ipamPoolPrefixAllocations\":[{\"numberOfIpAddresses\":\"s-numberofipaddresses\"}]},\"localSubnetNames\":[\"s-localsubnetnames\"],\"localVirtualNetworkAddressSpace\":{\"addressPrefixes\":[\"s-addressprefixes\"],\"ipamPoolPrefixAllocations\":[{\"numberOfIpAddresses\":\"s-numberofipaddresses\"}]},\"peerCompleteVnets\":true,\"peeringState\":\"s-peeringstate\",\"peeringSyncLevel\":\"s-peeringsynclevel\",\"provisioningState\":\"Succeeded\",\"remoteAddressSpace\":{\"addressPrefixes\":[\"s-addressprefixes\"],\"ipamPoolPrefixAllocations\":[{\"numberOfIpAddresses\":\"s-numberofipaddresses\"}]},\"remoteBgpCommunities\":{\"regionalCommunity\":\"s-regionalcommunity\",\"virtualNetworkCommunity\":\"s-virtualnetworkcommunity\"},\"remoteSubnetNames\":[\"s-remotesubnetnames\"],\"remoteVirtualNetwork\":{\"id\":\"s-id\"},\"remoteVirtualNetworkAddressSpace\":{\"addressPrefixes\":[\"s-addressprefixes\"],\"ipamPoolPrefixAllocations\":[{\"numberOfIpAddresses\":\"s-numberofipaddresses\"}]},\"remoteVirtualNetworkEncryption\":{\"enabled\":true,\"enforcement\":\"s-enforcement\"},\"resourceGuid\":\"s-resourceguid\",\"useRemoteGateways\":true},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualNetworkPeeringsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", VirtualNetworkPeeringsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_network_peerings_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_775)
}

