test "Go's ManagementClient.BeginGetActiveSessions" {
  let f = gv_new_fake(os.net)
  let c = new_management_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"protocol\":\"s-protocol\",\"resourceType\":\"s-resourcetype\",\"sessionDurationInMins\":1.5,\"sessionId\":\"s-sessionid\",\"startTime\":{\"k\":\"v\"},\"targetHostName\":\"s-targethostname\",\"targetIpAddress\":\"s-targetipaddress\",\"targetResourceGroup\":\"s-targetresourcegroup\",\"targetResourceId\":\"s-targetresourceid\",\"targetSubscriptionId\":\"s-targetsubscriptionid\",\"userName\":\"s-username\"}]}")
  gv_note(f, "CALL ManagementClient.BeginGetActiveSessions")
  match c.begin_get_active_sessions("id1/ x", "id2/ x", ManagementClientBeginGetActiveSessionsOptions{}) {
    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(pg0) => {
          var pg = pg0
          for page in [1, 2] {
            if !pg.more() {
              gv_note(f, "OUT page ${page}: no more")
              break
            }
            match pg.next_page() {
              Ok(r) => gv_note(f, "OUT page ${page}: ${show_management_client_get_active_sessions_response(r)}")
              Err(e) => {
                gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
                break
              }
            }
          }
        }
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  // Go panics at line 5 (its pager has no handler); ours reads page one
  let got = gv_log_of(f)
  gv_compare(got[0..5], GO_353[0..5])
  expect(got[5].starts_with("OUT page 1: ")) == true
}

