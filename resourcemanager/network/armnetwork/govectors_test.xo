test "Go's InterfacesClient.NewListAllPager" {
  let f = gv_new_fake(os.net)
  let c = new_interfaces_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"auxiliaryMode\":\"s-auxiliarymode\",\"auxiliarySku\":\"s-auxiliarysku\",\"defaultOutboundConnectivityEnabled\":true,\"disableTcpStateTracking\":true,\"dnsSettings\":{\"appliedDnsServers\":[\"s-applieddnsservers\"],\"dnsServers\":[\"s-dnsservers\"],\"internalDnsNameLabel\":\"s-internaldnsnamelabel\",\"internalDomainNameSuffix\":\"s-internaldomainnamesuffix\",\"internalFqdn\":\"s-internalfqdn\"},\"dscpConfiguration\":{\"id\":\"s-id\"},\"enableAcceleratedNetworking\":true,\"enableIPForwarding\":true,\"hostedWorkloads\":[\"s-hostedworkloads\"],\"ipConfigurations\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"primary\":true,\"privateIPAddress\":\"s-privateipaddress\",\"privateIPAddressPrefixLength\":7,\"privateIPAddressVersion\":\"s-privateipaddressversion\",\"privateIPAllocationMethod\":\"s-privateipallocationmethod\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"macAddress\":\"s-macaddress\",\"migrationPhase\":\"s-migrationphase\",\"networkSecurityGroup\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"flushConnection\":true,\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"},\"nicType\":\"s-nictype\",\"primary\":true,\"privateEndpoint\":{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"billingSku\":\"s-billingsku\",\"customNetworkInterfaceName\":\"s-customnetworkinterfacename\",\"ipVersionType\":\"s-ipversiontype\",\"provisioningState\":\"Succeeded\",\"subnet\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"},\"privateLinkService\":{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessMode\":\"s-accessmode\",\"alias\":\"s-alias\",\"autoApproval\":{},\"destinationIPAddress\":\"s-destinationipaddress\",\"enableProxyProtocol\":true,\"fqdns\":[\"s-fqdns\"],\"provisioningState\":\"Succeeded\",\"visibility\":{}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"},\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"tapConfigurations\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"virtualMachine\":{\"id\":\"s-id\"},\"vnetEncryptionSupported\":true,\"workloadType\":\"s-workloadtype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL InterfacesClient.NewListAllPager")
  var pg = c.new_list_all_pager(InterfacesClientListAllOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_interfaces_client_list_all_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_307)
}

fn show_interfaces_client_list_cloud_service_network_interfaces_response(r: InterfacesClientListCloudServiceNetworkInterfacesResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.interface_list_result).to_str_lossy()}")
  parts.join(" ")
}

