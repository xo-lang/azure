const GO_784: List[Str] = [
  "CALL VirtualNetworksClient.BeginListDdosProtectionStatus",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.Network/virtualNetworks/id2%2F%20x/ddosProtectionStatus?api-version=2026-03-01&skipToken=s-skiptoken&top=7",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"ddosProtectionPlanId\":\"s-ddosprotectionplanid\",\"isWorkloadProtected\":\"s-isworkloadprotected\",\"publicIpAddress\":\"s-publicipaddress\",\"publicIpAddressId\":\"s-publicipaddressid\"}]}",
  "OUT page 1: panic: runtime error: invalid memory address or nil pointer dereference",
]

test "Go's VirtualNetworksClient.BeginListDdosProtectionStatus" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_networks_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"ddosProtectionPlanId\":\"s-ddosprotectionplanid\",\"isWorkloadProtected\":\"s-isworkloadprotected\",\"publicIpAddress\":\"s-publicipaddress\",\"publicIpAddressId\":\"s-publicipaddressid\"}]}")
  gv_note(f, "CALL VirtualNetworksClient.BeginListDdosProtectionStatus")
  match c.begin_list_ddos_protection_status("id1/ x", "id2/ x", VirtualNetworksClientBeginListDdosProtectionStatusOptions{skip_token: Some("s-skiptoken"), top: Some(7)}) {
    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(pg0) => {
          var pg = pg0
          for page in [1, 2] {
            if !pg.more() {
              gv_note(f, "OUT page ${page}: no more")
              break
            }
            match pg.next_page() {
              Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_networks_client_list_ddos_protection_status_response(r)}")
              Err(e) => {
                gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
                break
              }
            }
          }
        }
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  // Go panics at line 5 (its pager has no handler); ours reads page one
  let got = gv_log_of(f)
  gv_compare(got[0..5], GO_784[0..5])
  expect(got[5].starts_with("OUT page 1: ")) == true
}

