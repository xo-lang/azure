  let c = new_virtual_network_appliances_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL VirtualNetworkAppliancesClient.BeginDelete")
  match c.begin_delete("id1/ x", "id2/ x", VirtualNetworkAppliancesClientBeginDeleteOptions{}) {
    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(r) => gv_note(f, "OUT: ${show_virtual_network_appliances_client_delete_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_717)
}

fn show_virtual_network_appliances_client_get_response(r: VirtualNetworkAppliancesClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.virtual_network_appliance).to_str_lossy()}")
  parts.join(" ")
}

