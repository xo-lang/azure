  "REQ DELETE https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.Network/networkSecurityGroups/id2%2F%20x?api-version=2026-03-01",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 ",
  "OUT: ",
]

test "Go's SecurityGroupsClient.BeginDelete" {
  let f = gv_new_fake(os.net)
  let c = new_security_groups_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL SecurityGroupsClient.BeginDelete")
  match c.begin_delete("id1/ x", "id2/ x", SecurityGroupsClientBeginDeleteOptions{}) {
    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(r) => gv_note(f, "OUT: ${show_security_groups_client_delete_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_513)
}

fn show_security_groups_client_get_response(r: SecurityGroupsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.security_group).to_str_lossy()}")
  parts.join(" ")
}

