  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_interfaces_client_list_virtual_machine_scale_set_vm_network_interfaces_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_313)
}

fn show_interfaces_client_update_tags_response(r: InterfacesClientUpdateTagsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.interface_).to_str_lossy()}")
  parts.join(" ")
}

