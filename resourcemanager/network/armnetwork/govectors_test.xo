test "Go's FlowLogsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_flow_logs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"enabled\":true,\"enabledFilteringCriteria\":\"s-enabledfilteringcriteria\",\"flowAnalyticsConfiguration\":{\"networkWatcherFlowAnalyticsConfiguration\":{\"enabled\":true,\"trafficAnalyticsInterval\":7,\"workspaceId\":\"s-workspaceid\",\"workspaceRegion\":\"s-workspaceregion\",\"workspaceResourceId\":\"s-workspaceresourceid\"}},\"format\":{\"type\":\"s-type\",\"version\":7},\"provisioningState\":\"Succeeded\",\"recordTypes\":\"s-recordtypes\",\"retentionPolicy\":{\"days\":7,\"enabled\":true},\"storageId\":\"s-storageid\",\"targetResourceGuid\":\"s-targetresourceguid\",\"targetResourceId\":\"s-targetresourceid\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL FlowLogsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", FlowLogsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_flow_logs_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_253)
}

