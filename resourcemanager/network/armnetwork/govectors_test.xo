test "Go's VirtualNetworkTapsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_network_taps_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"destinationLoadBalancerFrontEndIPConfiguration\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"ddosSettings\":{},\"enableConnectionTracking\":true,\"gatewayLoadBalancer\":{\"id\":\"s-id\"},\"privateIPAddress\":\"s-privateipaddress\",\"privateIPAddressVersion\":\"s-privateipaddressversion\",\"privateIPAllocationMethod\":\"s-privateipallocationmethod\",\"provisioningState\":\"Succeeded\",\"publicIPAddress\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"},\"publicIPPrefix\":{\"id\":\"s-id\"},\"subnet\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"}},\"type\":\"s-type\",\"zones\":[\"s-zones\"]},\"destinationNetworkInterfaceIPConfiguration\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"gatewayLoadBalancer\":{\"id\":\"s-id\"},\"primary\":true,\"privateIPAddress\":\"s-privateipaddress\",\"privateIPAddressPrefixLength\":7,\"privateIPAddressVersion\":\"s-privateipaddressversion\",\"privateIPAllocationMethod\":\"s-privateipallocationmethod\",\"privateLinkConnectionProperties\":{\"groupId\":\"s-groupid\",\"requiredMemberName\":\"s-requiredmembername\"},\"provisioningState\":\"Succeeded\",\"publicIPAddress\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"},\"subnet\":{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"}},\"type\":\"s-type\"},\"destinationPort\":7,\"networkInterfaceTapConfigurations\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualNetworkTapsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", VirtualNetworkTapsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_network_taps_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_780)
}

fn show_virtual_network_taps_client_update_tags_response(r: VirtualNetworkTapsClientUpdateTagsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.virtual_network_tap).to_str_lossy()}")
  parts.join(" ")
}

