test "Go's LoadBalancerBackendAddressPoolsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_load_balancer_backend_address_pools_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"backendIPConfigurations\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"primary\":true,\"privateIPAddress\":\"s-privateipaddress\",\"privateIPAddressPrefixLength\":7,\"privateIPAddressVersion\":\"s-privateipaddressversion\",\"privateIPAllocationMethod\":\"s-privateipallocationmethod\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"drainPeriodInSeconds\":7,\"inboundNatRules\":[{\"id\":\"s-id\"}],\"loadBalancerBackendAddresses\":[{\"name\":\"s-name\",\"properties\":{\"adminState\":\"s-adminstate\",\"ipAddress\":\"s-ipaddress\"}}],\"loadBalancingRules\":[{\"id\":\"s-id\"}],\"location\":\"s-location\",\"outboundRule\":{\"id\":\"s-id\"},\"outboundRules\":[{\"id\":\"s-id\"}],\"provisioningState\":\"Succeeded\",\"syncMode\":\"s-syncmode\",\"tunnelInterfaces\":[{\"identifier\":7,\"port\":7,\"protocol\":\"s-protocol\",\"type\":\"s-type\"}],\"virtualNetwork\":{\"id\":\"s-id\"}},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL LoadBalancerBackendAddressPoolsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", LoadBalancerBackendAddressPoolsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_load_balancer_backend_address_pools_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_325)
}

