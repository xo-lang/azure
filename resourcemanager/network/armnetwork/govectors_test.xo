  let f = gv_new_fake(os.net)
  let c = new_virtual_networks_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"addressSpace\":{\"addressPrefixes\":[\"s-addressprefixes\"],\"ipamPoolPrefixAllocations\":[{\"numberOfIpAddresses\":\"s-numberofipaddresses\"}]},\"bgpCommunities\":{\"regionalCommunity\":\"s-regionalcommunity\",\"virtualNetworkCommunity\":\"s-virtualnetworkcommunity\"},\"ddosProtectionPlan\":{\"id\":\"s-id\"},\"defaultPublicNatGateway\":{\"id\":\"s-id\"},\"dhcpOptions\":{\"dnsServers\":[\"s-dnsservers\"]},\"enableDdosProtection\":true,\"enableVmProtection\":true,\"encryption\":{\"enabled\":true,\"enforcement\":\"s-enforcement\"},\"flowLogs\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"enabled\":true,\"enabledFilteringCriteria\":\"s-enabledfilteringcriteria\",\"provisioningState\":\"Succeeded\",\"recordTypes\":\"s-recordtypes\",\"storageId\":\"s-storageid\",\"targetResourceGuid\":\"s-targetresourceguid\",\"targetResourceId\":\"s-targetresourceid\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}],\"flowTimeoutInMinutes\":7,\"ipAllocations\":[{\"id\":\"s-id\"}],\"privateEndpointVNetPolicies\":\"s-privateendpointvnetpolicies\",\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"subnets\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"addressPrefix\":\"s-addressprefix\",\"defaultOutboundAccess\":true,\"privateEndpointNetworkPolicies\":\"s-privateendpointnetworkpolicies\",\"privateLinkServiceNetworkPolicies\":\"https://management.example.test/next?\$skiptoken=2\",\"provisioningState\":\"Succeeded\",\"purpose\":\"s-purpose\",\"sharingScope\":\"s-sharingscope\"},\"type\":\"s-type\"}],\"summarizedGatewayPrefixes\":{\"addressPrefixes\":[\"s-addressprefixes\"],\"ipamPoolPrefixAllocations\":[{\"numberOfIpAddresses\":\"s-numberofipaddresses\"}]},\"virtualNetworkPeerings\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"allowForwardedTraffic\":true,\"allowGatewayTransit\":true,\"allowVirtualNetworkAccess\":true,\"doNotVerifyRemoteGateways\":true,\"enableOnlyIPv6Peering\":true,\"peerCompleteVnets\":true,\"peeringState\":\"s-peeringstate\",\"peeringSyncLevel\":\"s-peeringsynclevel\",\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"useRemoteGateways\":true},\"type\":\"s-type\"}]},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualNetworksClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", VirtualNetworksClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_networks_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
