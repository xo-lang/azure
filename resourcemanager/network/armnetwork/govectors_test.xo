test "Go's PrivateLinkServicesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_private_link_services_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessMode\":\"s-accessmode\",\"alias\":\"s-alias\",\"autoApproval\":{\"subscriptions\":[\"s-subscriptions\"]},\"destinationIPAddress\":\"s-destinationipaddress\",\"enableProxyProtocol\":true,\"fqdns\":[\"s-fqdns\"],\"ipConfigurations\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"primary\":true,\"privateIPAddress\":\"s-privateipaddress\",\"privateIPAddressVersion\":\"s-privateipaddressversion\",\"privateIPAllocationMethod\":\"s-privateipallocationmethod\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"loadBalancerFrontendIpConfigurations\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"enableConnectionTracking\":true,\"privateIPAddress\":\"s-privateipaddress\",\"privateIPAddressVersion\":\"s-privateipaddressversion\",\"privateIPAllocationMethod\":\"s-privateipallocationmethod\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}],\"networkInterfaces\":[{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"auxiliaryMode\":\"s-auxiliarymode\",\"auxiliarySku\":\"s-auxiliarysku\",\"defaultOutboundConnectivityEnabled\":true,\"disableTcpStateTracking\":true,\"enableAcceleratedNetworking\":true,\"enableIPForwarding\":true,\"macAddress\":\"s-macaddress\",\"migrationPhase\":\"s-migrationphase\",\"nicType\":\"s-nictype\",\"primary\":true,\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"vnetEncryptionSupported\":true,\"workloadType\":\"s-workloadtype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}],\"privateEndpointConnections\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"linkIdentifier\":\"https://management.example.test/next?\$skiptoken=2\",\"privateEndpointLocation\":\"s-privateendpointlocation\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"visibility\":{\"subscriptions\":[\"s-subscriptions\"]}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PrivateLinkServicesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", PrivateLinkServicesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_private_link_services_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_429)
}

fn show_private_link_services_client_list_private_endpoint_connections_response(r: PrivateLinkServicesClientListPrivateEndpointConnectionsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.private_endpoint_connection_list_result).to_str_lossy()}")
  parts.join(" ")
}

