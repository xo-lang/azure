test "Go's VirtualNetworkGatewaysClient.NewListConnectionsPager" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_network_gateways_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"authorizationKey\":\"s-authorizationkey\",\"connectionMode\":\"s-connectionmode\",\"connectionProtocol\":\"s-connectionprotocol\",\"connectionStatus\":\"s-connectionstatus\",\"connectionType\":\"s-connectiontype\",\"egressBytesTransferred\":7,\"enableBgp\":true,\"enablePrivateLinkFastPath\":true,\"expressRouteGatewayBypass\":true,\"gatewayCustomBgpIpAddresses\":[{\"customBgpIpAddress\":\"s-custombgpipaddress\",\"ipConfigurationId\":\"s-ipconfigurationid\"}],\"ingressBytesTransferred\":7,\"ipsecPolicies\":[{\"dhGroup\":\"s-dhgroup\",\"ikeEncryption\":\"s-ikeencryption\",\"ikeIntegrity\":\"s-ikeintegrity\",\"ipsecEncryption\":\"s-ipsecencryption\",\"ipsecIntegrity\":\"s-ipsecintegrity\",\"pfsGroup\":\"s-pfsgroup\",\"saDataSizeKilobytes\":7,\"saLifeTimeSeconds\":7}],\"localNetworkGateway2\":{\"id\":\"s-id\"},\"peer\":{\"id\":\"s-id\"},\"provisioningState\":\"Succeeded\",\"resourceGuid\":\"s-resourceguid\",\"routingConfiguration\":{\"associatedRouteTable\":{\"id\":\"s-id\"},\"inboundRouteMap\":{\"id\":\"s-id\"},\"outboundRouteMap\":{\"id\":\"s-id\"},\"propagatedRouteTables\":{\"labels\":[\"s-labels\"]},\"vnetRoutes\":{\"staticRoutesConfig\":{\"propagateStaticRoutes\":true,\"vnetLocalRouteOverrideCriteria\":\"s-vnetlocalrouteoverridecriteria\"}}},\"routingWeight\":7,\"sharedKey\":\"s-sharedkey\",\"trafficSelectorPolicies\":[{\"localAddressRanges\":[\"s-localaddressranges\"],\"remoteAddressRanges\":[\"s-remoteaddressranges\"]}],\"tunnelConnectionStatus\":[{\"connectionStatus\":\"s-connectionstatus\",\"egressBytesTransferred\":7,\"ingressBytesTransferred\":7,\"lastConnectionEstablishedUtcTime\":\"s-lastconnectionestablishedutctime\",\"tunnel\":\"s-tunnel\"}],\"usePolicyBasedTrafficSelectors\":true,\"virtualNetworkGateway1\":{\"id\":\"s-id\"},\"virtualNetworkGateway2\":{\"id\":\"s-id\"}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualNetworkGatewaysClient.NewListConnectionsPager")
  var pg = c.new_list_connections_pager("id1/ x", "id2/ x", VirtualNetworkGatewaysClientListConnectionsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_network_gateways_client_list_connections_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_768)
}

fn show_virtual_network_gateways_client_list_response(r: VirtualNetworkGatewaysClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.virtual_network_gateway_list_result).to_str_lossy()}")
  parts.join(" ")
}

