test "Go's ServiceEndpointPolicyDefinitionsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_service_endpoint_policy_definitions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"provisioningState\":\"Succeeded\",\"service\":\"s-service\",\"serviceResources\":[\"s-serviceresources\"]},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ServiceEndpointPolicyDefinitionsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", "id2/ x", ServiceEndpointPolicyDefinitionsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_service_endpoint_policy_definitions_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_584)
}

