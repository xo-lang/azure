    return Err(azcore.CallErr.InvalidInput("parameter loadBalancerName cannot be empty"))
  }
  path = path.replace("{loadBalancerName}", url.path_escape(load_balancer_name))
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter client.subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  var body = b""
  if let Some(v) = options.parameters {
    headers.push(("Content-Type", "application/json"))
    body = runtime.marshal_json(v)
  }
  let qs = q.encode()
  Ok(policy.Request{method: "POST", url: "${runtime.join_paths(c.setup.endpoint, path)}${if qs == "" { "" } else { "?${qs}" }}", headers: headers, body: body})
}

/// Migrate load balancer to IP Based
pub fn (c: LoadBalancersClient) migrate_to_ip_based(group_name: Str, load_balancer_name: Str, options: LoadBalancersClientMigrateToIPBasedOptions = LoadBalancersClientMigrateToIPBasedOptions{}) -> LoadBalancersClientMigrateToIPBasedResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.migrate_to_ip_based_create_request(group_name, load_balancer_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  load_balancers_migrate_to_ip_based_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
