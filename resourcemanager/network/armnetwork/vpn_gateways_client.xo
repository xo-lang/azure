}

fn (c: VPNGatewaysClient) stop_packet_capture_create_request(resource_group_name: Str, gateway_name: Str, options: VPNGatewaysClientBeginStopPacketCaptureOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.Network/vpnGateways/{gatewayName}/stoppacketcapture"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if gateway_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter gatewayName cannot be empty"))
  }
  path = path.replace("{gatewayName}", url.path_escape(gateway_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  var body = b""
  if let Some(v) = options.parameters {
    headers.push(("Content-Type", "application/json"))
    body = runtime.marshal_json(v)
  }
  let qs = q.encode().replace("+", "%20")
  Ok(policy.Request{method: "POST", url: "${runtime.join_paths(c.setup.endpoint, path)}${if qs == "" { "" } else { "?${qs}" }}", headers: headers, body: body})
}

/// Stops packet capture on vpn gateway in the specified resource group.
pub fn (c: VPNGatewaysClient[fx]) begin_stop_packet_capture(resource_group_name: Str, gateway_name: Str, options: VPNGatewaysClientBeginStopPacketCaptureOptions = VPNGatewaysClientBeginStopPacketCaptureOptions{}) -> runtime.Poller[VPNGatewaysClientStopPacketCaptureResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "VPNGatewaysClientStopPacketCaptureResponse", fn(r: http.Response) -> VPNGatewaysClientStopPacketCaptureResponse ! Str { vpn_gateways_stop_packet_capture_handle(r) })
  }
  let req = c.stop_packet_capture_create_request(resource_group_name, gateway_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "", "VPNGatewaysClientStopPacketCaptureResponse", fn(r: http.Response) -> VPNGatewaysClientStopPacketCaptureResponse ! Str { vpn_gateways_stop_packet_capture_handle(r) })
}
