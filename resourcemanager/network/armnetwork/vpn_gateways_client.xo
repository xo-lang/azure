/// VPNGatewaysClientStopPacketCaptureResponse: the response of VPNGatewaysClient.begin_stop_packet_capture.
pub struct VPNGatewaysClientStopPacketCaptureResponse {
  pub value: Str
}

fn vpn_gateways_stop_packet_capture_handle(resp: http.Response) -> VPNGatewaysClientStopPacketCaptureResponse ! Str {
  let v = if resp.body.is_empty() { "" } else { json.decode[Str](resp.body) ?? e => return Err(e.display()) }
