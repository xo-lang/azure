  let v = if resp.body.is_empty() { ServiceGatewayActionOkResponseBody{} } else { json.decode[ServiceGatewayActionOkResponseBody](resp.body) ?? e => return Err(e.display()) }
  Ok(ServiceGatewaysClientUpdateServicesResponse{service_gateway_action_ok_response_body: v})
}

fn (c: ServiceGatewaysClient) update_services_create_request(resource_group_name: Str, service_gateway_name: Str, parameters: ServiceGatewayUpdateServicesRequest, options: ServiceGatewaysClientUpdateServicesOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.Network/serviceGateways/{serviceGatewayName}/updateServices"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if service_gateway_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter serviceGatewayName cannot be empty"))
  }
  path = path.replace("{serviceGatewayName}", url.path_escape(service_gateway_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: runtime.marshal_json(parameters)})
}

/// Creates, updates, or deletes services within the service gateway. The request supports both full and partial update modes at the service level.  Full update replaces all existing services with the new list provided in the request. Partial update modifies only the specified services.
pub fn (c: ServiceGatewaysClient) update_services(resource_group_name: Str, service_gateway_name: Str, parameters: ServiceGatewayUpdateServicesRequest, options: ServiceGatewaysClientUpdateServicesOptions = ServiceGatewaysClientUpdateServicesOptions{}) -> ServiceGatewaysClientUpdateServicesResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.update_services_create_request(resource_group_name, service_gateway_name, parameters, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  service_gateways_update_services_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
