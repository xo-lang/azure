  path = path.replace("{azureFirewallName}", url.path_escape(azure_firewall_name))
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionId cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  let qs = q.encode()
  Ok(policy.Request{method: "POST", url: "${c.setup.endpoint}${path}${if qs == "" { "" } else { "?${qs}" }}", headers: headers, body: runtime.marshal_json(parameters)})
}

/// Runs a packet capture operation on AzureFirewall.
pub fn (c: AzureFirewallsClient) begin_packet_capture_operation(resource_group_name: Str, azure_firewall_name: Str, parameters: FirewallPacketCaptureParameters, options: AzureFirewallsClientBeginPacketCaptureOperationOptions = AzureFirewallsClientBeginPacketCaptureOperationOptions{}) -> runtime.Poller[AzureFirewallsClientPacketCaptureOperationResponse] ! azcore.CallErr uses (net.dial, clock, rand) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "AzureFirewallsClientPacketCaptureOperationResponse", fn(r: http.Response) -> AzureFirewallsClientPacketCaptureOperationResponse ! Str { azure_firewalls_packet_capture_operation_handle(r) })
  }
  let req = c.packet_capture_operation_create_request(resource_group_name, azure_firewall_name, parameters, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "location", "AzureFirewallsClientPacketCaptureOperationResponse", fn(r: http.Response) -> AzureFirewallsClientPacketCaptureOperationResponse ! Str { azure_firewalls_packet_capture_operation_handle(r) })
}
