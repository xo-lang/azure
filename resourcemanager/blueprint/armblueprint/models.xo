  /// ID of the published version of a blueprint definition.
  pub blueprint_id as "blueprintId,omitempty": Str? = None
  /// Multi-line explain this resource.
  pub description as "description,omitempty": Str? = None
  /// One-liner string explain this resource.
  pub display_name as "displayName,omitempty": Str? = None
  /// Defines how resources deployed by a blueprint assignment are locked.
  pub locks as "locks,omitempty": AssignmentLockSettings? = None
  /// Blueprint assignment parameter values.
  pub parameters as "parameters,omitempty": Map[Str, ParameterValue]? = None
  /// State of the blueprint assignment.
  pub provisioning_state as "provisioningState,omitempty": AssignmentProvisioningState? = None
  /// Names and locations of resource group placeholders.
  pub resource_groups as "resourceGroups,omitempty": Map[Str, ResourceGroupValue]? = None
  /// The target subscription scope of the blueprint assignment (format: '/subscriptions/{subscriptionId}'). For management group level assignments, the property is required.
  pub scope as "scope,omitempty": Str? = None
  /// Status of blueprint assignment. This field is readonly.
  pub status as "status,omitempty": AssignmentStatus? = None
} derive Json

/// Represents a blueprint assignment.
pub struct Assignment {
  /// String Id used to locate any resource on Azure.
  pub id as "id,omitempty": Str? = None
  /// Managed identity for this blueprint assignment.
  pub identity as "identity,omitempty": ManagedServiceIdentity? = None
  /// The location of this blueprint assignment.
  pub location as "location,omitempty": Str? = None
  /// Name of this resource.
  pub name as "name,omitempty": Str? = None
  /// Properties for blueprint assignment object.
  pub properties as "properties,omitempty": AssignmentProperties? = None
  /// Type of this resource.
  pub type_ as "type,omitempty": Str? = None
} derive Json

/// Response schema for querying the Azure Blueprints service principal in the tenant.
pub struct WhoIsBlueprintContract {
  /// AAD object Id of the Azure Blueprints service principal in the tenant.
  pub object_id as "objectId,omitempty": Str? = None
} derive Json

/// List of blueprint assignments
pub struct AssignmentList {
  /// Link to the next page of results.
  pub next_link as "nextLink,omitempty": Str? = None
  /// List of blueprint assignments.
  pub value as "value,omitempty": List[Assignment]? = None
} derive Json

/// Error code and message
pub struct AzureResourceManagerError {
  /// Error code.
  pub code as "code,omitempty": Str? = None
  /// Error message.
  pub message as "message,omitempty": Str? = None
} derive Json

/// Azure resource created from deployment job.
pub struct AssignmentJobCreatedResource {
  /// String Id used to locate any resource on Azure.
  pub id as "id,omitempty": Str? = None
  /// Name of this resource.
  pub name as "name,omitempty": Str? = None
  /// Additional properties in a dictionary.
  pub properties as "properties,omitempty": Map[Str, Str]? = None
  /// Type of this resource.
  pub type_ as "type,omitempty": Str? = None
} derive Json

/// Result of each individual deployment in a blueprint assignment.
pub struct AssignmentDeploymentJobResult {
  /// Contains error details if deployment job failed.
  pub error as "error,omitempty": AzureResourceManagerError? = None
  /// Resources created as result of the deployment job.
  pub resources as "resources,omitempty": List[AssignmentJobCreatedResource]? = None
} derive Json

/// Represents individual job in given blueprint assignment operation.
pub struct AssignmentDeploymentJob {
  /// Name of the action performed in this job.
  pub action as "action,omitempty": Str? = None
  /// Result of this deployment job for each retry.
  pub history as "history,omitempty": List[AssignmentDeploymentJobResult]? = None
  /// Id of this job.
  pub job_id as "jobId,omitempty": Str? = None
  /// State of this job.
  pub job_state as "jobState,omitempty": Str? = None
  /// Kind of job.
  pub kind as "kind,omitempty": Str? = None
  /// Reference to deployment job resource id.
  pub request_uri as "requestUri,omitempty": Str? = None
  /// Deployment job result.
  pub result as "result,omitempty": AssignmentDeploymentJobResult? = None
} derive Json

/// Properties of AssignmentOperation.
pub struct AssignmentOperationProperties {
  /// State of this blueprint assignment operation.
  pub assignment_state as "assignmentState,omitempty": Str? = None
  /// The published version of the blueprint definition used for the blueprint assignment operation.
  pub blueprint_version as "blueprintVersion,omitempty": Str? = None
  /// List of jobs in this blueprint assignment operation.
  pub deployments as "deployments,omitempty": List[AssignmentDeploymentJob]? = None
  /// Create time of this blueprint assignment operation.
  pub time_created as "timeCreated,omitempty": Str? = None
  /// Finish time of the overall underlying deployments.
  pub time_finished as "timeFinished,omitempty": Str? = None
  /// Start time of the underlying deployment.
  pub time_started as "timeStarted,omitempty": Str? = None
} derive Json

/// Represents underlying deployment detail for each update to the blueprint assignment.
pub struct AssignmentOperation {
  /// String Id used to locate any resource on Azure.
  pub id as "id,omitempty": Str? = None
