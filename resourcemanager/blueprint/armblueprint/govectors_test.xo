test "Go's BlueprintsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_blueprints_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"layout\":{\"k\":\"v\"},\"parameters\":{\"k1\":{\"allowedValues\":[{\"k\":\"v\"}],\"defaultValue\":{\"k\":\"v\"},\"metadata\":{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"strongType\":\"s-strongtype\"},\"type\":\"s-type\"}},\"resourceGroups\":{\"k1\":{\"dependsOn\":[\"s-dependson\"],\"location\":\"s-location\",\"metadata\":{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"strongType\":\"s-strongtype\"},\"name\":\"s-name\",\"tags\":{\"k1\":\"s-tags\"}}},\"status\":{\"lastModified\":\"2026-11-06T10:00:00Z\",\"timeCreated\":\"2026-11-06T10:00:00Z\"},\"targetScope\":\"s-targetscope\",\"versions\":{\"k\":\"v\"}},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BlueprintsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", BlueprintsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_blueprints_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_14)
}

