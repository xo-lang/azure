test "Go's AssignmentsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_assignments_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"blueprintId\":\"s-blueprintid\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"locks\":{\"excludedActions\":[\"s-excludedactions\"],\"excludedPrincipals\":[\"s-excludedprincipals\"],\"mode\":\"s-mode\"},\"parameters\":{\"k1\":{\"reference\":{\"secretName\":\"s-secretname\",\"secretVersion\":\"s-secretversion\"},\"value\":{\"k\":\"v\"}}},\"provisioningState\":\"Succeeded\",\"resourceGroups\":{\"k1\":{\"location\":\"s-location\",\"name\":\"s-name\"}},\"scope\":\"s-scope\",\"status\":{\"lastModified\":\"2026-11-06T10:00:00Z\",\"managedResources\":[\"s-managedresources\"],\"timeCreated\":\"2026-11-06T10:00:00Z\"}},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AssignmentsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", AssignmentsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_assignments_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_9)
}

