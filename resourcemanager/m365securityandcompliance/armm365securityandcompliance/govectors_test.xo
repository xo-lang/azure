  "  B ",
  "  SERVED 200 ",
  "OUT: ",
]

test "Go's ServicesClient.BeginDelete" {
  let f = gv_new_fake(os.net)
  let c = new_services_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL ServicesClient.BeginDelete")
  match c.begin_delete("id1/ x", "id2/ x", ServicesClientBeginDeleteOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_services_client_delete_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_73)
}
