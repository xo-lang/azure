test "Go's PrivateLinkServicesForSCCPowershellClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_private_link_services_for_scc_powershell_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessPolicies\":[{\"objectId\":\"s-objectid\"}],\"authenticationConfiguration\":{\"audience\":\"s-audience\",\"authority\":\"s-authority\",\"smartProxyEnabled\":true},\"corsConfiguration\":{\"allowCredentials\":true,\"headers\":[\"s-headers\"],\"maxAge\":7,\"methods\":[\"s-methods\"],\"origins\":[\"s-origins\"]},\"cosmosDbConfiguration\":{\"keyVaultKeyUri\":\"s-keyvaultkeyuri\",\"offerThroughput\":7},\"exportConfiguration\":{\"storageAccountName\":\"s-storageaccountname\"},\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PrivateLinkServicesForSCCPowershellClient.NewListPager")
  var pg = c.new_list_pager(PrivateLinkServicesForSCCPowershellClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_private_link_services_for_scc_powershell_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_72)
}

fn show_services_client_delete_response(r: ServicesClientDeleteResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

