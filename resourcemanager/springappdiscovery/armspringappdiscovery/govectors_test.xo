test "Go's SummariesClient.Get" {
  let f = gv_new_fake(os.net)
  let c = new_summaries_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"discoveredApps\":7,\"discoveredServers\":7,\"errors\":[{\"code\":\"s-code\",\"id\":7,\"message\":\"s-message\",\"possibleCauses\":\"s-possiblecauses\",\"recommendedAction\":\"s-recommendedaction\",\"runAsAccountId\":\"s-runasaccountid\",\"severity\":\"s-severity\",\"summaryMessage\":\"s-summarymessage\",\"updatedTimeStamp\":\"2026-11-06T10:00:00Z\"}],\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL SummariesClient.Get")
  match c.get("id1/ x", "id2/ x", "id3/ x", SummariesClientGetOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_summaries_client_get_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_20)
}

fn show_summaries_client_list_by_site_response(r: SummariesClientListBySiteResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.summary_list).to_str_lossy()}")
  parts.join(" ")
}

