  gv_note(f, "CALL ErrorSummariesClient.Get")
  match c.get("id1/ x", "id2/ x", "id3/ x", ErrorSummariesClientGetOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_error_summaries_client_get_response(r)}")
