test "Go's SpringbootappsClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_springbootapps_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"appName\":\"s-appname\",\"appPort\":7,\"appType\":\"s-apptype\",\"applicationConfigurations\":[{\"key\":\"s-key\",\"value\":\"s-value\"}],\"artifactName\":\"s-artifactname\",\"bindingPorts\":[7],\"buildJdkVersion\":\"s-buildjdkversion\",\"certificates\":[\"s-certificates\"],\"checksum\":\"s-checksum\",\"connectionStrings\":[\"s-connectionstrings\"],\"dependencies\":[\"s-dependencies\"],\"environments\":[\"s-environments\"],\"errors\":[{\"code\":\"s-code\",\"id\":7,\"message\":\"s-message\",\"possibleCauses\":\"s-possiblecauses\",\"recommendedAction\":\"s-recommendedaction\",\"runAsAccountId\":\"s-runasaccountid\",\"severity\":\"s-severity\",\"summaryMessage\":\"s-summarymessage\",\"updatedTimeStamp\":\"2026-11-06T10:00:00Z\"}],\"instanceCount\":7,\"instances\":[{\"instanceCount\":7,\"jvmMemoryInMB\":7,\"machineArmId\":\"s-machinearmid\"}],\"jarFileLocation\":\"s-jarfilelocation\",\"jvmMemoryInMB\":7,\"jvmOptions\":[\"s-jvmoptions\"],\"lastModifiedTime\":\"2026-11-06T10:00:00Z\",\"lastUpdatedTime\":\"2026-11-06T10:00:00Z\",\"machineArmIds\":[\"s-machinearmids\"],\"miscs\":[{\"key\":\"s-key\",\"value\":\"s-value\"}],\"provisioningState\":\"Succeeded\",\"runtimeJdkVersion\":\"s-runtimejdkversion\",\"servers\":[\"s-servers\"],\"siteName\":\"s-sitename\",\"springBootVersion\":\"s-springbootversion\",\"staticContentLocations\":[\"s-staticcontentlocations\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SpringbootappsClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager("id1/ x", SpringbootappsClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_springbootapps_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_6)
}

