test "Go's ErrorSummariesClient.NewListBySitePager" {
  let f = gv_new_fake(os.net)
  let c = new_error_summaries_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"discoveryScopeErrorSummaries\":[{\"affectedObjectsCount\":7,\"affectedResourceType\":\"s-affectedresourcetype\"}],\"errors\":[{\"code\":\"s-code\",\"id\":7,\"message\":\"s-message\",\"possibleCauses\":\"s-possiblecauses\",\"recommendedAction\":\"s-recommendedaction\",\"runAsAccountId\":\"s-runasaccountid\",\"severity\":\"s-severity\",\"summaryMessage\":\"s-summarymessage\",\"updatedTimeStamp\":\"2026-11-06T10:00:00Z\"}],\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ErrorSummariesClient.NewListBySitePager")
  var pg = c.new_list_by_site_pager("id1/ x", "id2/ x", ErrorSummariesClientListBySiteOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_error_summaries_client_list_by_site_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_1)
}

