/// All snapshot properties.
pub struct SnapshotProperties {
  /// The composition type describes how the key-values within the snapshot are composed. The 'key' composition type ensures there are no two key-values containing the same key. The 'key_label' composition type ensures there are no two key-values containing the same key and label.
  pub composition_type as "compositionType,omitempty": CompositionType? = None
  /// The time that the snapshot was created.
  pub created as "created,omitempty": azcore.DateTime? = None
  /// A value representing the current state of the snapshot.
  pub etag as "etag,omitempty": Str? = None
  /// The time that the snapshot will expire.
  pub expires as "expires,omitempty": azcore.DateTime? = None
  /// A list of filters used to filter the key-values included in the snapshot.
  pub filters as "filters,omitempty": List[KeyValueFilter]? = None
  /// The amount of key-values in the snapshot.
  pub items_count as "itemsCount,omitempty": Int? = None
  /// The provisioning state of the snapshot.
  pub provisioning_state as "provisioningState,omitempty": ProvisioningState? = None
  /// The amount of time, in seconds, that a snapshot will remain in the archived state before expiring. This property is only writable during the creation of a snapshot. If not specified, the default lifetime of key-value revisions will be used.
  pub retention_period as "retentionPeriod,omitempty": Int? = None
  /// The size in bytes of the snapshot.
  pub size as "size,omitempty": Int? = None
  /// The current status of the snapshot.
  pub status as "status,omitempty": SnapshotStatus? = None
  /// The tags of the snapshot. NOTE: These are data plane tags, not Azure Resource Manager (ARM) tags.
  pub tags as "tags,omitempty": Map[Str, Str]? = None
} derive Json

