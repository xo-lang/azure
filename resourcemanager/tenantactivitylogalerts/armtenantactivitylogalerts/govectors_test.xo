  "REQ PATCH https://management.example.test/providers/Microsoft.Management/managementGroups/id1%2F%20x/providers/Microsoft.AlertsManagement/tenantActivityLogAlerts/id2%2F%20x?api-version=2023-04-01-preview",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"properties\":{\"enabled\":true},\"tags\":{\"k1\":\"s-tags\"}}",
  "  SERVED 200 {\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"actions\":{\"actionGroups\":[{\"actionGroupId\":\"s-actiongroupid\",\"actionProperties\":{\"k1\":\"s-actionproperties\"},\"webhookProperties\":{\"k1\":\"s-webhookproperties\"}}]},\"condition\":{\"allOf\":[{\"anyOf\":[{\"equals\":\"s-equals\",\"field\":\"s-field\"}],\"containsAny\":[\"s-containsany\"],\"equals\":\"s-equals\",\"field\":\"s-field\"}]},\"description\":\"s-description\",\"enabled\":true,\"scopes\":[\"s-scopes\"],\"tenantScope\":\"s-tenantscope\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}",
  "OUT: body={\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"actions\":{\"actionGroups\":[{\"actionGroupId\":\"s-actiongroupid\",\"actionProperties\":{\"k1\":\"s-actionproperties\"},\"webhookProperties\":{\"k1\":\"s-webhookproperties\"}}]},\"condition\":{\"allOf\":[{\"anyOf\":[{\"equals\":\"s-equals\",\"field\":\"s-field\"}],\"containsAny\":[\"s-containsany\"],\"equals\":\"s-equals\",\"field\":\"s-field\"}]},\"description\":\"s-description\",\"enabled\":true,\"scopes\":[\"s-scopes\"],\"tenantScope\":\"s-tenantscope\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}",
]

test "Go's Client.Update" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"actions\":{\"actionGroups\":[{\"actionGroupId\":\"s-actiongroupid\",\"actionProperties\":{\"k1\":\"s-actionproperties\"},\"webhookProperties\":{\"k1\":\"s-webhookproperties\"}}]},\"condition\":{\"allOf\":[{\"anyOf\":[{\"equals\":\"s-equals\",\"field\":\"s-field\"}],\"containsAny\":[\"s-containsany\"],\"equals\":\"s-equals\",\"field\":\"s-field\"}]},\"description\":\"s-description\",\"enabled\":true,\"scopes\":[\"s-scopes\"],\"tenantScope\":\"s-tenantscope\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL Client.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[TenantAlertRulePatchObject]("{\"properties\":{\"enabled\":true},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), ClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_5)
}
