  "CALL OperationsClient.NewListPager",
  "REQ GET https://management.example.test/providers/Microsoft.AnalysisServices/operations?api-version=2017-08-01",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\",\"origin\":\"s-origin\",\"properties\":{\"serviceSpecification\":{\"logSpecifications\":[{\"blobDuration\":\"s-blobduration\",\"displayName\":\"s-displayname\",\"name\":\"s-name\"}],\"metricSpecifications\":[{\"aggregationType\":\"s-aggregationtype\",\"displayDescription\":\"s-displaydescription\",\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"unit\":\"s-unit\"}]}}}]}",
