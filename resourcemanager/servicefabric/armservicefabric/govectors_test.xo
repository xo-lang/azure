test "Go's ServicesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_services_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"correlationScheme\":[{\"scheme\":\"s-scheme\",\"serviceName\":\"s-servicename\"}],\"defaultMoveCost\":\"s-defaultmovecost\",\"hasPersistedState\":true,\"minReplicaSetSize\":7,\"partitionDescription\":{\"count\":7,\"partitionScheme\":\"Named\"},\"placementConstraints\":\"s-placementconstraints\",\"provisioningState\":\"Succeeded\",\"quorumLossWaitDuration\":\"2026-11-06T10:00:00Z\",\"replicaRestartWaitDuration\":\"2026-11-06T10:00:00Z\",\"serviceDnsName\":\"s-servicednsname\",\"serviceKind\":\"Stateful\",\"serviceLoadMetrics\":[{\"defaultLoad\":7,\"name\":\"s-name\",\"primaryDefaultLoad\":7,\"secondaryDefaultLoad\":7,\"weight\":\"s-weight\"}],\"servicePackageActivationMode\":\"s-servicepackageactivationmode\",\"serviceTypeName\":\"s-servicetypename\",\"standByReplicaKeepDuration\":\"2026-11-06T10:00:00Z\",\"targetReplicaSetSize\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ServicesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", ServicesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_services_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_29)
}
