test "Go's ClustersClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_clusters_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"addOnFeatures\":[\"s-addonfeatures\"],\"applicationTypeVersionsCleanupPolicy\":{\"maxUnusedVersionsToKeep\":7},\"availableClusterVersions\":[{\"codeVersion\":\"s-codeversion\",\"environment\":\"s-environment\",\"supportExpiryUtc\":\"s-supportexpiryutc\"}],\"azureActiveDirectory\":{\"clientApplication\":\"s-clientapplication\",\"clusterApplication\":\"s-clusterapplication\",\"tenantId\":\"s-tenantid\"},\"certificate\":{\"thumbprint\":\"s-thumbprint\",\"thumbprintSecondary\":\"s-thumbprintsecondary\",\"x509StoreName\":\"s-x509storename\"},\"certificateCommonNames\":{\"commonNames\":[{\"certificateCommonName\":\"s-certificatecommonname\",\"certificateIssuerThumbprint\":\"s-certificateissuerthumbprint\"}],\"x509StoreName\":\"s-x509storename\"},\"clientCertificateCommonNames\":[{\"certificateCommonName\":\"s-certificatecommonname\",\"certificateIssuerThumbprint\":\"s-certificateissuerthumbprint\",\"isAdmin\":true}],\"clientCertificateThumbprints\":[{\"certificateThumbprint\":\"s-certificatethumbprint\",\"isAdmin\":true}],\"clusterCodeVersion\":\"s-clustercodeversion\",\"clusterEndpoint\":\"s-clusterendpoint\",\"clusterId\":\"s-clusterid\",\"clusterState\":\"s-clusterstate\",\"diagnosticsStorageAccountConfig\":{\"blobEndpoint\":\"s-blobendpoint\",\"protectedAccountKeyName\":\"s-protectedaccountkeyname\",\"protectedAccountKeyName2\":\"s-protectedaccountkeyname2\",\"queueEndpoint\":\"s-queueendpoint\",\"storageAccountName\":\"s-storageaccountname\",\"tableEndpoint\":\"s-tableendpoint\"},\"eventStoreServiceEnabled\":true,\"fabricSettings\":[{\"name\":\"s-name\"}],\"infrastructureServiceManager\":true,\"managementEndpoint\":\"s-managementendpoint\",\"nodeTypes\":[{\"applicationPorts\":{\"endPort\":7,\"startPort\":7},\"capacities\":{\"k1\":\"s-capacities\"},\"clientConnectionEndpointPort\":7,\"durabilityLevel\":\"s-durabilitylevel\",\"ephemeralPorts\":{\"endPort\":7,\"startPort\":7},\"httpGatewayEndpointPort\":7,\"isPrimary\":true,\"isStateless\":true,\"multipleAvailabilityZones\":true,\"name\":\"s-name\",\"placementProperties\":{\"k1\":\"s-placementproperties\"},\"reverseProxyEndpointPort\":7,\"vmInstanceCount\":7}],\"notifications\":[{\"isEnabled\":true,\"notificationCategory\":\"s-notificationcategory\",\"notificationLevel\":\"s-notificationlevel\"}],\"provisioningState\":\"Succeeded\",\"reliabilityLevel\":\"s-reliabilitylevel\",\"reverseProxyCertificate\":{\"thumbprint\":\"s-thumbprint\",\"thumbprintSecondary\":\"s-thumbprintsecondary\",\"x509StoreName\":\"s-x509storename\"},\"reverseProxyCertificateCommonNames\":{\"commonNames\":[{\"certificateCommonName\":\"s-certificatecommonname\",\"certificateIssuerThumbprint\":\"s-certificateissuerthumbprint\"}],\"x509StoreName\":\"s-x509storename\"},\"sfZonalUpgradeMode\":\"s-sfzonalupgrademode\",\"upgradeDescription\":{\"deltaHealthPolicy\":{\"maxPercentDeltaUnhealthyApplications\":7,\"maxPercentDeltaUnhealthyNodes\":7,\"maxPercentUpgradeDomainDeltaUnhealthyNodes\":7},\"forceRestart\":true,\"healthCheckRetryTimeout\":\"s-healthcheckretrytimeout\",\"healthCheckStableDuration\":\"s-healthcheckstableduration\",\"healthCheckWaitDuration\":\"s-healthcheckwaitduration\",\"healthPolicy\":{\"maxPercentUnhealthyApplications\":7,\"maxPercentUnhealthyNodes\":7},\"upgradeDomainTimeout\":\"s-upgradedomaintimeout\",\"upgradeReplicaSetCheckTimeout\":\"s-upgradereplicasetchecktimeout\",\"upgradeTimeout\":\"s-upgradetimeout\"},\"upgradeMode\":\"s-upgrademode\",\"upgradePauseEndTimestampUtc\":\"2026-11-06T10:00:00Z\",\"upgradePauseStartTimestampUtc\":\"2026-11-06T10:00:00Z\",\"upgradeWave\":\"s-upgradewave\",\"vmImage\":\"s-vmimage\",\"vmssZonalUpgradeMode\":\"s-vmsszonalupgrademode\",\"waveUpgradePaused\":true},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ClustersClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ClustersClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_clusters_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_22)
}

fn show_clusters_client_list_response(r: ClustersClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster_list_result).to_str_lossy()}")
  parts.join(" ")
}

