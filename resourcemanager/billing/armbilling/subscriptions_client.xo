fn (c: SubscriptionsClient) list_by_enrollment_account_create_request(billing_account_name: Str, enrollment_account_name: Str, options: SubscriptionsClientListByEnrollmentAccountOptions) -> policy.Request ! azcore.CallErr {
  var path = "/providers/Microsoft.Billing/billingAccounts/{billingAccountName}/enrollmentAccounts/{enrollmentAccountName}/billingSubscriptions"
  if billing_account_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter billingAccountName cannot be empty"))
  }
  path = path.replace("{billingAccountName}", url.path_escape(billing_account_name))
  if enrollment_account_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter enrollmentAccountName cannot be empty"))
  }
  path = path.replace("{enrollmentAccountName}", url.path_escape(enrollment_account_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  if let Some(v) = options.filter {
    q.add("filter", v)
  }
  if let Some(v) = options.order_by {
    q.add("orderBy", v)
  }
  if let Some(v) = options.top {
    q.add("top", "${v}")
  }
  if let Some(v) = options.skip {
    q.add("skip", "${v}")
  }
  if let Some(v) = options.count {
    q.add("count", "${v}")
  }
  if let Some(v) = options.search {
    q.add("search", v)
  }
  Ok(policy.Request{method: "GET", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: b""})
}

/// Lists the subscriptions for an enrollment account. The operation is supported for billing accounts with agreement type Enterprise Agreement.
pub fn (c: SubscriptionsClient[fx]) new_list_by_enrollment_account_pager(billing_account_name: Str, enrollment_account_name: Str, options: SubscriptionsClientListByEnrollmentAccountOptions = SubscriptionsClientListByEnrollmentAccountOptions{}) -> runtime.Pager[SubscriptionsClientListByEnrollmentAccountResponse, fx] ! azcore.CallErr {
  let req = c.list_by_enrollment_account_create_request(billing_account_name, enrollment_account_name, options)?
  Ok(runtime.new_next_link_pager(c.setup.pipeline, req, fn(r: http.Response) -> SubscriptionsClientListByEnrollmentAccountResponse ! Str { subscriptions_list_by_enrollment_account_handle(r) }, c.setup.endpoint, fn(r: SubscriptionsClientListByEnrollmentAccountResponse) -> Str? { r.subscription_list_result.next_link }).traced_as("SubscriptionsClientListByEnrollmentAccountResponse"))
}
