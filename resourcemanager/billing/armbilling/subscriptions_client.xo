}

fn subscriptions_list_by_enrollment_account_handle(resp: http.Response) -> SubscriptionsClientListByEnrollmentAccountResponse ! Str {
  let v = if resp.body.is_empty() { SubscriptionListResult{} } else { json.decode[SubscriptionListResult](resp.body) ?? e => return Err(e.display()) }
  Ok(SubscriptionsClientListByEnrollmentAccountResponse{subscription_list_result: v})
