  gv_note(f, "CALL SavingsPlansClient.ValidateUpdateByBillingAccount")
  match c.validate_update_by_billing_account("id1/ x", "id2/ x", "id3/ x", (json.decode_str[SavingsPlanUpdateValidateRequest]("{\"benefits\":[{\"appliedScopeProperties\":{\"displayName\":\"s-displayname\",\"managementGroupId\":\"s-managementgroupid\",\"resourceGroupId\":\"s-resourcegroupid\",\"subscriptionId\":\"s-subscriptionid\",\"tenantId\":\"s-tenantid\"},\"appliedScopeType\":\"s-appliedscopetype\",\"displayName\":\"s-displayname\",\"renew\":true,\"renewProperties\":{\"purchaseProperties\":{\"properties\":{\"appliedScopeProperties\":{\"displayName\":\"s-displayname\",\"managementGroupId\":\"s-managementgroupid\",\"resourceGroupId\":\"s-resourcegroupid\",\"subscriptionId\":\"s-subscriptionid\",\"tenantId\":\"s-tenantid\"},\"appliedScopeType\":\"s-appliedscopetype\",\"billingPlan\":\"s-billingplan\",\"billingScopeId\":\"s-billingscopeid\",\"commitment\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\",\"grain\":\"s-grain\"},\"displayName\":\"s-displayname\",\"renew\":true,\"term\":\"s-term\"},\"sku\":{\"name\":\"s-name\"}}}}]}") ?? e => fault("${e}")), SavingsPlansClientValidateUpdateByBillingAccountOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_savings_plans_client_validate_update_by_billing_account_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_159)
}

