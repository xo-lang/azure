fn show_invoices_client_list_by_billing_account_response(r: InvoicesClientListByBillingAccountResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.invoice_list_result).to_str_lossy()}")
  parts.join(" ")
}

