test "Go's ReservationsClient.NewListByBillingAccountPager" {
  let f = gv_new_fake(os.net)
  let c = new_reservations_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"summary\":{\"cancelledCount\":1.5,\"expiredCount\":1.5,\"expiringCount\":1.5,\"failedCount\":1.5,\"noBenefitCount\":1.5,\"pendingCount\":1.5,\"processingCount\":1.5,\"succeededCount\":1.5,\"warningCount\":1.5},\"value\":[{\"etag\":7,\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"appliedScopeProperties\":{\"displayName\":\"s-displayname\",\"managementGroupId\":\"s-managementgroupid\",\"resourceGroupId\":\"s-resourcegroupid\",\"subscriptionId\":\"s-subscriptionid\",\"tenantId\":\"s-tenantid\"},\"appliedScopeType\":\"s-appliedscopetype\",\"appliedScopes\":[\"s-appliedscopes\"],\"archived\":true,\"benefitStartTime\":\"2026-11-06T10:00:00Z\",\"billingPlan\":\"s-billingplan\",\"billingScopeId\":\"s-billingscopeid\",\"capabilities\":\"s-capabilities\",\"displayName\":\"s-displayname\",\"displayProvisioningState\":\"s-displayprovisioningstate\",\"effectiveDateTime\":\"2026-11-06T10:00:00Z\",\"expiryDate\":\"s-expirydate\",\"expiryDateTime\":\"2026-11-06T10:00:00Z\",\"extendedStatusInfo\":{\"message\":\"s-message\",\"properties\":{\"subscriptionId\":\"s-subscriptionid\"},\"statusCode\":\"s-statuscode\"},\"instanceFlexibility\":\"s-instanceflexibility\",\"lastUpdatedDateTime\":\"2026-11-06T10:00:00Z\",\"mergeProperties\":{\"mergeDestination\":\"s-mergedestination\",\"mergeSources\":[\"s-mergesources\"]},\"productCode\":\"s-productcode\",\"provisioningState\":\"Succeeded\",\"provisioningSubState\":\"s-provisioningsubstate\",\"purchaseDate\":\"2026-11-06\",\"purchaseDateTime\":\"2026-11-06T10:00:00Z\",\"quantity\":1.5,\"renew\":true,\"renewDestination\":\"s-renewdestination\",\"renewProperties\":{\"billingCurrencyTotal\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"pricingCurrencyTotal\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"purchaseProperties\":{\"location\":\"s-location\",\"properties\":{\"appliedScopeType\":\"s-appliedscopetype\",\"billingPlan\":\"s-billingplan\",\"billingScopeId\":\"s-billingscopeid\",\"displayName\":\"s-displayname\",\"instanceFlexibility\":\"s-instanceflexibility\",\"quantity\":7,\"renew\":true,\"reservedResourceType\":\"s-reservedresourcetype\",\"reviewDateTime\":\"2026-11-06T10:00:00Z\",\"term\":\"s-term\"},\"sku\":{\"name\":\"s-name\"}}},\"renewSource\":\"s-renewsource\",\"reservedResourceType\":\"s-reservedresourcetype\",\"reviewDateTime\":\"2026-11-06T10:00:00Z\",\"skuDescription\":\"s-skudescription\",\"splitProperties\":{\"splitDestinations\":[\"s-splitdestinations\"],\"splitSource\":\"s-splitsource\"},\"swapProperties\":{\"swapDestination\":\"s-swapdestination\",\"swapSource\":\"s-swapsource\"},\"term\":\"s-term\",\"userFriendlyAppliedScopeType\":\"s-userfriendlyappliedscopetype\",\"userFriendlyRenewState\":\"s-userfriendlyrenewstate\",\"utilization\":{\"aggregates\":[{\"grain\":1.5,\"grainUnit\":\"s-grainunit\",\"value\":1.5,\"valueUnit\":\"s-valueunit\"}],\"trend\":\"s-trend\"}},\"sku\":{\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ReservationsClient.NewListByBillingAccountPager")
  var pg = c.new_list_by_billing_account_pager("id1/ x", ReservationsClientListByBillingAccountOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), refresh_summary: Some("s-refreshsummary"), selected_state: Some("s-selectedstate"), skiptoken: Some(Float32(1.5)), take: Some(Float32(1.5))}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_reservations_client_list_by_billing_account_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_109)
}

fn show_reservations_client_list_by_billing_profile_response(r: ReservationsClientListByBillingProfileResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.reservations_list_result).to_str_lossy()}")
  parts.join(" ")
}

