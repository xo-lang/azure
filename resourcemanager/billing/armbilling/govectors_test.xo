test "Go's TransactionsClient.NewListByInvoicePager" {
  let f = gv_new_fake(os.net)
  let c = new_transactions_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"azureCreditApplied\":{\"currency\":\"s-currency\",\"value\":1.5},\"azurePlan\":\"s-azureplan\",\"billingCurrency\":\"s-billingcurrency\",\"billingProfileDisplayName\":{\"k\":\"v\"},\"billingProfileId\":\"s-billingprofileid\",\"consumptionCommitmentDecremented\":{\"currency\":\"s-currency\",\"value\":1.5},\"creditType\":\"s-credittype\",\"customerDisplayName\":\"s-customerdisplayname\",\"customerId\":\"s-customerid\",\"date\":\"2026-11-06T10:00:00Z\",\"discount\":1.5,\"effectivePrice\":{\"currency\":\"s-currency\",\"value\":1.5},\"exchangeRate\":1.5,\"invoice\":\"s-invoice\",\"invoiceId\":\"s-invoiceid\",\"invoiceSectionDisplayName\":\"s-invoicesectiondisplayname\",\"invoiceSectionId\":\"s-invoicesectionid\",\"isThirdParty\":true,\"kind\":\"s-kind\",\"marketPrice\":{\"currency\":\"s-currency\",\"value\":1.5},\"partNumber\":\"s-partnumber\",\"pricingCurrency\":\"s-pricingcurrency\",\"productDescription\":\"s-productdescription\",\"productFamily\":\"s-productfamily\",\"productType\":\"s-producttype\",\"productTypeId\":\"s-producttypeid\",\"quantity\":7,\"reasonCode\":\"s-reasoncode\",\"refundTransactionDetails\":{\"amountRefunded\":{\"currency\":\"s-currency\",\"value\":1.5},\"amountRequested\":{\"currency\":\"s-currency\",\"value\":1.5},\"refundOperationId\":\"s-refundoperationid\"},\"servicePeriodEndDate\":\"2026-11-06T10:00:00Z\",\"servicePeriodStartDate\":\"2026-11-06T10:00:00Z\",\"specialTaxationType\":\"s-specialtaxationtype\",\"subTotal\":{\"currency\":\"s-currency\",\"value\":1.5},\"tax\":{\"currency\":\"s-currency\",\"value\":1.5},\"transactionAmount\":{\"currency\":\"s-currency\",\"value\":1.5},\"transactionType\":\"s-transactiontype\",\"unitOfMeasure\":\"s-unitofmeasure\",\"unitType\":\"s-unittype\",\"units\":1.5},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL TransactionsClient.NewListByInvoicePager")
  var pg = c.new_list_by_invoice_pager("id1/ x", "id2/ x", TransactionsClientListByInvoiceOptions{count: Some(true), filter: Some("s-filter"), order_by: Some("s-orderby"), search: Some("s-search"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_transactions_client_list_by_invoice_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_182)
}

fn show_transactions_client_list_by_invoice_section_response(r: TransactionsClientListByInvoiceSectionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.transaction_list_result).to_str_lossy()}")
  parts.join(" ")
}

