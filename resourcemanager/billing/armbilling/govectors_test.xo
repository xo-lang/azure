test "Go's SavingsPlansClient.NewListBySavingsPlanOrderPager" {
  let f = gv_new_fake(os.net)
  let c = new_savings_plans_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"appliedScopeProperties\":{\"displayName\":\"s-displayname\",\"managementGroupId\":\"s-managementgroupid\",\"resourceGroupId\":\"s-resourcegroupid\",\"subscriptionId\":\"s-subscriptionid\",\"tenantId\":\"s-tenantid\"},\"appliedScopeType\":\"s-appliedscopetype\",\"benefitStartTime\":\"2026-11-06T10:00:00Z\",\"billingAccountId\":\"s-billingaccountid\",\"billingPlan\":\"s-billingplan\",\"billingProfileId\":\"s-billingprofileid\",\"billingScopeId\":\"s-billingscopeid\",\"commitment\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\",\"grain\":\"s-grain\"},\"customerId\":\"s-customerid\",\"displayName\":\"s-displayname\",\"displayProvisioningState\":\"s-displayprovisioningstate\",\"effectiveDateTime\":\"2026-11-06T10:00:00Z\",\"expiryDateTime\":\"2026-11-06T10:00:00Z\",\"extendedStatusInfo\":{\"message\":\"s-message\",\"properties\":{\"subscriptionId\":\"s-subscriptionid\"},\"statusCode\":\"s-statuscode\"},\"productCode\":\"s-productcode\",\"provisioningState\":\"Succeeded\",\"purchaseDateTime\":\"2026-11-06T10:00:00Z\",\"renew\":true,\"renewDestination\":\"s-renewdestination\",\"renewProperties\":{\"purchaseProperties\":{\"properties\":{\"appliedScopeType\":\"s-appliedscopetype\",\"billingPlan\":\"s-billingplan\",\"billingScopeId\":\"s-billingscopeid\",\"displayName\":\"s-displayname\",\"renew\":true,\"term\":\"s-term\"},\"sku\":{\"name\":\"s-name\"}}},\"renewSource\":\"s-renewsource\",\"term\":\"s-term\",\"userFriendlyAppliedScopeType\":\"s-userfriendlyappliedscopetype\",\"utilization\":{\"aggregates\":[{\"grain\":1.5,\"grainUnit\":\"s-grainunit\",\"value\":1.5,\"valueUnit\":\"s-valueunit\"}],\"trend\":\"s-trend\"}},\"sku\":{\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SavingsPlansClient.NewListBySavingsPlanOrderPager")
  var pg = c.new_list_by_savings_plan_order_pager("id1/ x", "id2/ x", SavingsPlansClientListBySavingsPlanOrderOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_savings_plans_client_list_by_savings_plan_order_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_158)
}

