00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL AccountsClient.BeginAddPaymentTerms")
  match c.begin_add_payment_terms("id1/ x", (json.decode_str[List[PaymentTerm]]("[{\"endDate\":\"2026-11-06T10:00:00Z\",\"isDefault\":true,\"startDate\":\"2026-11-06T10:00:00Z\",\"term\":\"s-term\"}]") ?? e => fault("${e}")), AccountsClientBeginAddPaymentTermsOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_accounts_client_add_payment_terms_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
