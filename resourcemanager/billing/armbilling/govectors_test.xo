tatus\",\"type\":\"s-type\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AccountsClient.NewListPager")
  var pg = c.new_list_pager(AccountsClientListOptions{expand: Some("s-expand"), filter: Some("s-filter"), include_all: Some(true), include_all_without_billing_profiles: Some(true), include_deleted: Some(true), include_pending_agreement: Some(true), include_resellee: Some(true), legal_owner_oid: Some("s-legalowneroid"), legal_owner_tid: Some("s-legalownertid"), search: Some("s-search"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_accounts_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
