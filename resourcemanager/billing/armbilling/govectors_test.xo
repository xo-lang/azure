test "Go's PropertyClient.Get" {
  let f = gv_new_fake(os.net)
  let c = new_property_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"accountAdminNotificationEmailAddress\":\"s-accountadminnotificationemailaddress\",\"billingAccountAgreementType\":\"s-billingaccountagreementtype\",\"billingAccountDisplayName\":\"s-billingaccountdisplayname\",\"billingAccountId\":\"s-billingaccountid\",\"billingAccountSoldToCountry\":\"s-billingaccountsoldtocountry\",\"billingAccountStatus\":\"s-billingaccountstatus\",\"billingAccountStatusReasonCode\":\"s-billingaccountstatusreasoncode\",\"billingAccountSubType\":\"s-billingaccountsubtype\",\"billingAccountType\":\"s-billingaccounttype\",\"billingCurrency\":\"s-billingcurrency\",\"billingProfileDisplayName\":\"s-billingprofiledisplayname\",\"billingProfileId\":\"s-billingprofileid\",\"billingProfilePaymentMethodFamily\":\"s-billingprofilepaymentmethodfamily\",\"billingProfilePaymentMethodType\":\"s-billingprofilepaymentmethodtype\",\"billingProfileSpendingLimit\":\"s-billingprofilespendinglimit\",\"billingProfileSpendingLimitDetails\":[{\"amount\":1.5,\"currency\":\"s-currency\",\"endDate\":\"2026-11-06T10:00:00Z\",\"startDate\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"type\":\"s-type\"}],\"billingProfileStatus\":\"s-billingprofilestatus\",\"billingProfileStatusReasonCode\":\"s-billingprofilestatusreasoncode\",\"billingTenantId\":\"s-billingtenantid\",\"costCenter\":\"s-costcenter\",\"customerDisplayName\":\"s-customerdisplayname\",\"customerId\":\"s-customerid\",\"customerStatus\":\"s-customerstatus\",\"enrollmentDetails\":{\"departmentDisplayName\":\"s-departmentdisplayname\",\"departmentId\":\"s-departmentid\",\"enrollmentAccountDisplayName\":\"s-enrollmentaccountdisplayname\",\"enrollmentAccountId\":\"s-enrollmentaccountid\",\"enrollmentAccountStatus\":\"s-enrollmentaccountstatus\"},\"invoiceSectionDisplayName\":\"s-invoicesectiondisplayname\",\"invoiceSectionId\":\"s-invoicesectionid\",\"invoiceSectionStatus\":\"s-invoicesectionstatus\",\"invoiceSectionStatusReasonCode\":\"s-invoicesectionstatusreasoncode\",\"isAccountAdmin\":true,\"isTransitionedBillingAccount\":true,\"productId\":\"s-productid\",\"productName\":\"s-productname\",\"skuDescription\":\"s-skudescription\",\"skuId\":\"s-skuid\",\"subscriptionBillingStatus\":\"s-subscriptionbillingstatus\",\"subscriptionBillingStatusDetails\":[{\"effectiveDate\":\"2026-11-06T10:00:00Z\",\"reason\":\"s-reason\"}],\"subscriptionBillingType\":\"s-subscriptionbillingtype\",\"subscriptionServiceUsageAddress\":{\"addressLine1\":\"s-addressline1\",\"addressLine2\":\"s-addressline2\",\"addressLine3\":\"s-addressline3\",\"city\":\"s-city\",\"companyName\":\"s-companyname\",\"country\":\"s-country\",\"district\":\"s-district\",\"email\":\"s-email\",\"firstName\":\"s-firstname\",\"isValidAddress\":true,\"lastName\":\"s-lastname\",\"middleName\":\"s-middlename\",\"phoneNumber\":\"s-phonenumber\",\"postalCode\":\"s-postalcode\",\"region\":\"s-region\"},\"subscriptionWorkloadType\":\"s-subscriptionworkloadtype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL PropertyClient.Get")
  match c.get(PropertyClientGetOptions{include_billing_country: Some(true), include_transition_status: Some(true)}) {
    Ok(r) => gv_note(f, "OUT: ${show_property_client_get_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_91)
}

fn show_property_client_update_response(r: PropertyClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.property).to_str_lossy()}")
  parts.join(" ")
}

