test "Go's SubscriptionsClient.NewListByBillingAccountPager" {
  let f = gv_new_fake(os.net)
  let c = new_subscriptions_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"totalCount\":7,\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"autoRenew\":\"s-autorenew\",\"beneficiary\":{\"objectId\":\"s-objectid\",\"tenantId\":\"s-tenantid\"},\"beneficiaryTenantId\":\"s-beneficiarytenantid\",\"billingFrequency\":\"s-billingfrequency\",\"billingPolicies\":{\"k1\":\"s-billingpolicies\"},\"billingProfileDisplayName\":\"s-billingprofiledisplayname\",\"billingProfileId\":\"s-billingprofileid\",\"billingProfileName\":\"s-billingprofilename\",\"consumptionCostCenter\":\"s-consumptioncostcenter\",\"customerDisplayName\":\"s-customerdisplayname\",\"customerId\":\"s-customerid\",\"customerName\":\"s-customername\",\"displayName\":\"s-displayname\",\"enrollmentAccountDisplayName\":\"s-enrollmentaccountdisplayname\",\"enrollmentAccountId\":\"s-enrollmentaccountid\",\"enrollmentAccountSubscriptionDetails\":{\"enrollmentAccountStartDate\":\"2026-11-06T10:00:00Z\",\"subscriptionEnrollmentAccountStatus\":\"s-subscriptionenrollmentaccountstatus\"},\"invoiceSectionDisplayName\":\"s-invoicesectiondisplayname\",\"invoiceSectionId\":\"s-invoicesectionid\",\"invoiceSectionName\":\"s-invoicesectionname\",\"lastMonthCharges\":{\"currency\":\"s-currency\",\"value\":1.5},\"monthToDateCharges\":{\"currency\":\"s-currency\",\"value\":1.5},\"nextBillingCycleDetails\":{\"billingFrequency\":\"s-billingfrequency\"},\"offerId\":\"s-offerid\",\"operationStatus\":\"s-operationstatus\",\"productCategory\":\"s-productcategory\",\"productType\":\"s-producttype\",\"productTypeId\":\"s-producttypeid\",\"provisioningState\":\"Succeeded\",\"provisioningTenantId\":\"s-provisioningtenantid\",\"purchaseDate\":\"2026-11-06T10:00:00Z\",\"quantity\":7,\"renewalTermDetails\":{\"billingFrequency\":\"s-billingfrequency\",\"productId\":\"s-productid\",\"productTypeId\":\"s-producttypeid\",\"quantity\":7,\"skuId\":\"s-skuid\",\"termDuration\":\"s-termduration\",\"termEndDate\":\"2026-11-06T10:00:00Z\"},\"reseller\":{\"description\":\"s-description\",\"resellerId\":\"s-resellerid\"},\"resourceUri\":\"s-resourceuri\",\"skuDescription\":\"s-skudescription\",\"skuId\":\"s-skuid\",\"status\":\"s-status\",\"subscriptionId\":\"s-subscriptionid\",\"suspensionReasonDetails\":[{\"effectiveDate\":\"2026-11-06T10:00:00Z\",\"reason\":\"s-reason\"}],\"suspensionReasons\":[\"s-suspensionreasons\"],\"systemOverrides\":{\"cancellation\":\"s-cancellation\",\"cancellationAllowedEndDate\":\"2026-11-06T10:00:00Z\"},\"termDuration\":\"s-termduration\",\"termEndDate\":\"2026-11-06T10:00:00Z\",\"termStartDate\":\"2026-11-06T10:00:00Z\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SubscriptionsClient.NewListByBillingAccountPager")
  var pg = c.new_list_by_billing_account_pager("id1/ x", SubscriptionsClientListByBillingAccountOptions{count: Some(true), expand: Some("s-expand"), filter: Some("s-filter"), include_deleted: Some(true), include_failed: Some(true), include_tenant_subscriptions: Some(true), order_by: Some("s-orderby"), search: Some("s-search"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_subscriptions_client_list_by_billing_account_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_171)
}

fn show_subscriptions_client_list_by_billing_profile_response(r: SubscriptionsClientListByBillingProfileResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.subscription_list_result).to_str_lossy()}")
  parts.join(" ")
}

