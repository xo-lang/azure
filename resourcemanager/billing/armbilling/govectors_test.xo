test "Go's ProfilesClient.NewListByBillingAccountPager" {
  let f = gv_new_fake(os.net)
  let c = new_profiles_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"billTo\":{\"addressLine1\":\"s-addressline1\",\"addressLine2\":\"s-addressline2\",\"addressLine3\":\"s-addressline3\",\"city\":\"s-city\",\"companyName\":\"s-companyname\",\"country\":\"s-country\",\"district\":\"s-district\",\"email\":\"s-email\",\"firstName\":\"s-firstname\",\"isValidAddress\":true,\"lastName\":\"s-lastname\",\"middleName\":\"s-middlename\",\"phoneNumber\":\"s-phonenumber\",\"postalCode\":\"s-postalcode\",\"region\":\"s-region\"},\"billingRelationshipType\":\"s-billingrelationshiptype\",\"currency\":\"s-currency\",\"currentPaymentTerm\":{\"endDate\":\"2026-11-06T10:00:00Z\",\"isDefault\":true,\"startDate\":\"2026-11-06T10:00:00Z\",\"term\":\"s-term\"},\"displayName\":\"s-displayname\",\"enabledAzurePlans\":[{\"productId\":\"s-productid\",\"skuDescription\":\"s-skudescription\",\"skuId\":\"s-skuid\"}],\"hasReadAccess\":true,\"indirectRelationshipInfo\":{\"billingAccountName\":\"s-billingaccountname\",\"billingProfileName\":\"s-billingprofilename\",\"displayName\":\"s-displayname\"},\"invoiceDay\":7,\"invoiceEmailOptIn\":true,\"invoiceRecipients\":[\"s-invoicerecipients\"],\"otherPaymentTerms\":[{\"endDate\":\"2026-11-06T10:00:00Z\",\"isDefault\":true,\"startDate\":\"2026-11-06T10:00:00Z\",\"term\":\"s-term\"}],\"poNumber\":\"s-ponumber\",\"provisioningState\":\"Succeeded\",\"shipTo\":{\"addressLine1\":\"s-addressline1\",\"addressLine2\":\"s-addressline2\",\"addressLine3\":\"s-addressline3\",\"city\":\"s-city\",\"companyName\":\"s-companyname\",\"country\":\"s-country\",\"district\":\"s-district\",\"email\":\"s-email\",\"firstName\":\"s-firstname\",\"isValidAddress\":true,\"lastName\":\"s-lastname\",\"middleName\":\"s-middlename\",\"phoneNumber\":\"s-phonenumber\",\"postalCode\":\"s-postalcode\",\"region\":\"s-region\"},\"soldTo\":{\"addressLine1\":\"s-addressline1\",\"addressLine2\":\"s-addressline2\",\"addressLine3\":\"s-addressline3\",\"city\":\"s-city\",\"companyName\":\"s-companyname\",\"country\":\"s-country\",\"district\":\"s-district\",\"email\":\"s-email\",\"firstName\":\"s-firstname\",\"isValidAddress\":true,\"lastName\":\"s-lastname\",\"middleName\":\"s-middlename\",\"phoneNumber\":\"s-phonenumber\",\"postalCode\":\"s-postalcode\",\"region\":\"s-region\"},\"spendingLimit\":\"s-spendinglimit\",\"spendingLimitDetails\":[{\"amount\":1.5,\"currency\":\"s-currency\",\"endDate\":\"2026-11-06T10:00:00Z\",\"startDate\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"type\":\"s-type\"}],\"status\":\"s-status\",\"statusReasonCode\":\"s-statusreasoncode\",\"systemId\":\"s-systemid\",\"tags\":{\"k1\":\"s-tags\"},\"targetClouds\":[\"s-targetclouds\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ProfilesClient.NewListByBillingAccountPager")
  var pg = c.new_list_by_billing_account_pager("id1/ x", ProfilesClientListByBillingAccountOptions{count: Some(true), filter: Some("s-filter"), include_deleted: Some(true), order_by: Some("s-orderby"), search: Some("s-search"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_profiles_client_list_by_billing_account_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_89)
}

fn show_profiles_client_validate_delete_eligibility_response(r: ProfilesClientValidateDeleteEligibilityResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.delete_billing_profile_eligibility_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_90: List[Str] = [
  "CALL ProfilesClient.ValidateDeleteEligibility",
  "REQ POST https://management.example.test/providers/Microsoft.Billing/billingAccounts/id1%2F%20x/billingProfiles/id2%2F%20x/validateDeleteEligibility?api-version=2024-04-01",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"eligibilityDetails\":[{\"code\":\"s-code\",\"message\":\"s-message\"}],\"eligibilityStatus\":\"s-eligibilitystatus\"}",
