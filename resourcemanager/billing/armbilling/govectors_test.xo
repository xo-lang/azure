test "Go's SubscriptionsClient.BeginCancel" {
  let f = gv_new_fake(os.net)
  let c = new_subscriptions_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL SubscriptionsClient.BeginCancel")
  match c.begin_cancel("id1/ x", "id2/ x", (json.decode_str[CancelSubscriptionRequest]("{\"cancellationReason\":\"s-cancellationreason\",\"customerId\":\"s-customerid\"}") ?? e => fault("${e}")), SubscriptionsClientBeginCancelOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_subscriptions_client_cancel_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_163)
}

