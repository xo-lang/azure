amountRequested\":{\"currency\":\"s-currency\",\"value\":1.5},\"approvedOn\":\"2026-11-06T10:00:00Z\",\"completedOn\":\"2026-11-06T10:00:00Z\",\"rebillInvoiceId\":\"s-rebillinvoiceid\",\"refundOperationId\":\"s-refundoperationid\",\"refundReason\":\"s-refundreason\",\"refundStatus\":\"s-refundstatus\",\"requestedOn\":\"2026-11-06T10:00:00Z\",\"transactionCount\":7},\"specialTaxationType\":\"s-specialtaxationtype\",\"status\":\"s-status\",\"subTotal\":{\"currency\":\"s-currency\",\"value\":1.5},\"subscriptionDisplayName\":\"s-subscriptiondisplayname\",\"subscriptionId\":\"s-subscriptionid\",\"taxAmount\":{\"currency\":\"s-currency\",\"value\":1.5},\"totalAmount\":{\"currency\":\"s-currency\",\"value\":1.5}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL InvoicesClient.NewListByBillingSubscriptionPager")
  var pg = c.new_list_by_billing_subscription_pager(InvoicesClientListByBillingSubscriptionOptions{count: Some(true), filter: Some("s-filter"), order_by: Some("s-orderby"), period_end_date: Some(gv_at3339("2026-11-06T10:00:00Z")), period_start_date: Some(gv_at3339("2026-11-06T10:00:00Z")), search: Some("s-search"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
