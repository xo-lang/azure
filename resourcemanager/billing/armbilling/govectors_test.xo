test "Go's RecipientTransfersClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_recipient_transfers_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"allowedProductType\":[\"s-allowedproducttype\"],\"canceledBy\":\"s-canceledby\",\"customerTenantId\":\"s-customertenantid\",\"detailedTransferStatus\":[{\"errorDetails\":{\"code\":\"s-code\",\"message\":\"s-message\"},\"productId\":\"s-productid\",\"productName\":\"s-productname\",\"productType\":\"s-producttype\",\"skuDescription\":\"s-skudescription\",\"transferStatus\":\"s-transferstatus\"}],\"expirationTime\":\"2026-11-06T10:00:00Z\",\"initiatorCustomerType\":\"s-initiatorcustomertype\",\"initiatorEmailId\":\"s-initiatoremailid\",\"recipientEmailId\":\"s-recipientemailid\",\"resellerId\":\"s-resellerid\",\"resellerName\":\"s-resellername\",\"supportedAccounts\":[\"s-supportedaccounts\"],\"transferStatus\":\"s-transferstatus\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RecipientTransfersClient.NewListPager")
  var pg = c.new_list_pager(RecipientTransfersClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_recipient_transfers_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_96)
}

