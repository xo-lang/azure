]

test "Go's ProfilesClient.ValidateDeleteEligibility" {
  let f = gv_new_fake(os.net)
  let c = new_profiles_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"eligibilityDetails\":[{\"code\":\"s-code\",\"message\":\"s-message\"}],\"eligibilityStatus\":\"s-eligibilitystatus\"}")
  gv_note(f, "CALL ProfilesClient.ValidateDeleteEligibility")
  match c.validate_delete_eligibility("id1/ x", "id2/ x", ProfilesClientValidateDeleteEligibilityOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_profiles_client_validate_delete_eligibility_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_90)
}

