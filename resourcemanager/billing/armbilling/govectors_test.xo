  let f = gv_new_fake(os.net)
  let c = new_subscriptions_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"autoRenew\":\"s-autorenew\",\"beneficiary\":{\"objectId\":\"s-objectid\",\"tenantId\":\"s-tenantid\"},\"beneficiaryTenantId\":\"s-beneficiarytenantid\",\"billingFrequency\":\"s-billingfrequency\",\"billingPolicies\":{\"k1\":\"s-billingpolicies\"},\"billingProfileDisplayName\":\"s-billingprofiledisplayname\",\"billingProfileId\":\"s-billingprofileid\",\"billingProfileName\":\"s-billingprofilename\",\"consumptionCostCenter\":\"s-consumptioncostcenter\",\"customerDisplayName\":\"s-customerdisplayname\",\"customerId\":\"s-customerid\",\"customerName\":\"s-customername\",\"displayName\":\"s-displayname\",\"enrollmentAccountDisplayName\":\"s-enrollmentaccountdisplayname\",\"enrollmentAccountId\":\"s-enrollmentaccountid\",\"enrollmentAccountSubscriptionDetails\":{\"enrollmentAccountStartDate\":\"2026-11-06T10:00:00Z\",\"subscriptionEnrollmentAccountStatus\":\"s-subscriptionenrollmentaccountstatus\"},\"invoiceSectionDisplayName\":\"s-invoicesectiondisplayname\",\"invoiceSectionId\":\"s-invoicesectionid\",\"invoiceSectionName\":\"s-invoicesectionname\",\"lastMonthCharges\":{\"currency\":\"s-currency\",\"value\":1.5},\"monthToDateCharges\":{\"currency\":\"s-currency\",\"value\":1.5},\"nextBillingCycleDetails\":{\"billingFrequency\":\"s-billingfrequency\"},\"offerId\":\"s-offerid\",\"operationStatus\":\"s-operationstatus\",\"productCategory\":\"s-productcategory\",\"productType\":\"s-producttype\",\"productTypeId\":\"s-producttypeid\",\"provisioningState\":\"Succeeded\",\"provisioningTenantId\":\"s-provisioningtenantid\",\"purchaseDate\":\"2026-11-06T10:00:00Z\",\"quantity\":7,\"renewalTermDetails\":{\"billingFrequency\":\"s-billingfrequency\",\"productId\":\"s-productid\",\"productTypeId\":\"s-producttypeid\",\"quantity\":7,\"skuId\":\"s-skuid\",\"termDuration\":\"s-termduration\",\"termEndDate\":\"2026-11-06T10:00:00Z\"},\"reseller\":{\"description\":\"s-description\",\"resellerId\":\"s-resellerid\"},\"resourceUri\":\"s-resourceuri\",\"skuDescription\":\"s-skudescription\",\"skuId\":\"s-skuid\",\"status\":\"s-status\",\"subscriptionId\":\"s-subscriptionid\",\"suspensionReasonDetails\":[{\"effectiveDate\":\"2026-11-06T10:00:00Z\",\"reason\":\"s-reason\"}],\"suspensionReasons\":[\"s-suspensionreasons\"],\"systemOverrides\":{\"cancellation\":\"s-cancellation\",\"cancellationAllowedEndDate\":\"2026-11-06T10:00:00Z\"},\"termDuration\":\"s-termduration\",\"termEndDate\":\"2026-11-06T10:00:00Z\",\"termStartDate\":\"2026-11-06T10:00:00Z\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL SubscriptionsClient.BeginSplit")
  match c.begin_split("id1/ x", "id2/ x", (json.decode_str[SubscriptionSplitRequest]("{\"billingFrequency\":\"s-billingfrequency\",\"quantity\":7,\"targetProductTypeId\":\"s-targetproducttypeid\",\"targetSkuId\":\"s-targetskuid\",\"termDuration\":\"s-termduration\"}") ?? e => fault("${e}")), SubscriptionsClientBeginSplitOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_subscriptions_client_split_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_167)
}

fn show_subscriptions_client_update_response(r: SubscriptionsClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.subscription).to_str_lossy()}")
  parts.join(" ")
}

