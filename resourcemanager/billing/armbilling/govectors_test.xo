test "Go's RequestsClient.NewListByInvoiceSectionPager" {
  let f = gv_new_fake(os.net)
  let c = new_requests_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"additionalInformation\":{\"k1\":\"s-additionalinformation\"},\"billingAccountDisplayName\":\"s-billingaccountdisplayname\",\"billingAccountId\":\"s-billingaccountid\",\"billingAccountName\":\"s-billingaccountname\",\"billingAccountPrimaryBillingTenantId\":\"s-billingaccountprimarybillingtenantid\",\"billingProfileDisplayName\":\"s-billingprofiledisplayname\",\"billingProfileId\":\"s-billingprofileid\",\"billingProfileName\":\"s-billingprofilename\",\"billingScope\":\"s-billingscope\",\"createdBy\":{\"objectId\":\"s-objectid\",\"tenantId\":\"s-tenantid\",\"upn\":\"s-upn\"},\"creationDate\":\"2026-11-06T10:00:00Z\",\"customerDisplayName\":\"s-customerdisplayname\",\"customerId\":\"s-customerid\",\"customerName\":\"s-customername\",\"decisionReason\":\"s-decisionreason\",\"expirationDate\":\"2026-11-06T10:00:00Z\",\"invoiceSectionDisplayName\":\"s-invoicesectiondisplayname\",\"invoiceSectionId\":\"s-invoicesectionid\",\"invoiceSectionName\":\"s-invoicesectionname\",\"justification\":\"s-justification\",\"lastUpdatedBy\":{\"objectId\":\"s-objectid\",\"tenantId\":\"s-tenantid\",\"upn\":\"s-upn\"},\"lastUpdatedDate\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"recipients\":[{\"objectId\":\"s-objectid\",\"tenantId\":\"s-tenantid\",\"upn\":\"s-upn\"}],\"requestScope\":\"s-requestscope\",\"reviewalDate\":\"2026-11-06T10:00:00Z\",\"reviewedBy\":{\"objectId\":\"s-objectid\",\"tenantId\":\"s-tenantid\",\"upn\":\"s-upn\"},\"status\":\"s-status\",\"subscriptionDisplayName\":\"s-subscriptiondisplayname\",\"subscriptionId\":\"s-subscriptionid\",\"subscriptionName\":\"s-subscriptionname\",\"type\":\"s-type\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RequestsClient.NewListByInvoiceSectionPager")
  var pg = c.new_list_by_invoice_section_pager("id1/ x", "id2/ x", "id3/ x", RequestsClientListByInvoiceSectionOptions{count: Some(true), filter: Some("s-filter"), order_by: Some("s-orderby"), search: Some("s-search"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_requests_client_list_by_invoice_section_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_103)
}

fn show_requests_client_list_by_user_response(r: RequestsClientListByUserResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.request_list_result).to_str_lossy()}")
  parts.join(" ")
}

