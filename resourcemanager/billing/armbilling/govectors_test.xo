test "Go's PartnerTransfersClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_partner_transfers_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"canceledBy\":\"s-canceledby\",\"detailedTransferStatus\":[{\"errorDetails\":{\"code\":\"s-code\",\"message\":\"s-message\"},\"productId\":\"s-productid\",\"productName\":\"s-productname\",\"productType\":\"s-producttype\",\"skuDescription\":\"s-skudescription\",\"transferStatus\":\"s-transferstatus\"}],\"expirationTime\":\"2026-11-06T10:00:00Z\",\"initiatorCustomerType\":\"s-initiatorcustomertype\",\"initiatorEmailId\":\"s-initiatoremailid\",\"recipientEmailId\":\"s-recipientemailid\",\"resellerId\":\"s-resellerid\",\"resellerName\":\"s-resellername\",\"transferStatus\":\"s-transferstatus\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PartnerTransfersClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", PartnerTransfersClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
