ration\",\"termEndDate\":\"2026-11-06T10:00:00Z\"},\"reseller\":{\"description\":\"s-description\",\"resellerId\":\"s-resellerid\"},\"resourceUri\":\"s-resourceuri\",\"skuDescription\":\"s-skudescription\",\"skuId\":\"s-skuid\",\"status\":\"s-status\",\"subscriptionId\":\"s-subscriptionid\",\"suspensionReasonDetails\":[{\"effectiveDate\":\"2026-11-06T10:00:00Z\",\"reason\":\"s-reason\"}],\"suspensionReasons\":[\"s-suspensionreasons\"],\"systemOverrides\":{\"cancellation\":\"s-cancellation\",\"cancellationAllowedEndDate\":\"2026-11-06T10:00:00Z\"},\"termDuration\":\"s-termduration\",\"termEndDate\":\"2026-11-06T10:00:00Z\",\"termStartDate\":\"2026-11-06T10:00:00Z\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SubscriptionsAliasesClient.NewListByBillingAccountPager")
  var pg = c.new_list_by_billing_account_pager("id1/ x", SubscriptionsAliasesClientListByBillingAccountOptions{count: Some(true), filter: Some("s-filter"), include_deleted: Some(true), order_by: Some("s-orderby"), search: Some("s-search"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_subscriptions_aliases_client_list_by_billing_account_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_162)
}

