  gv_note(f, "CALL SubscriptionsClient.NewListByBillingProfilePager")
  var pg = c.new_list_by_billing_profile_pager("id1/ x", "id2/ x", SubscriptionsClientListByBillingProfileOptions{count: Some(true), expand: Some("s-expand"), filter: Some("s-filter"), include_deleted: Some(true), order_by: Some("s-orderby"), search: Some("s-search"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_subscriptions_client_list_by_billing_profile_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_172)
}

fn show_subscriptions_client_list_by_customer_at_billing_account_response(r: SubscriptionsClientListByCustomerAtBillingAccountResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.subscription_list_result).to_str_lossy()}")
  parts.join(" ")
}

