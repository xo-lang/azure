  gv_note(f, "CALL ReservationsClient.NewListByReservationOrderPager")
  var pg = c.new_list_by_reservation_order_pager("id1/ x", "id2/ x", ReservationsClientListByReservationOrderOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
