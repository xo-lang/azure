  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"benefitPlans\":{\"azureHybridWindowsServerBenefit\":\"s-azurehybridwindowsserverbenefit\",\"windowsServerVmCount\":7},\"billingConfiguration\":{\"autoRenew\":\"s-autorenew\",\"billingStatus\":\"s-billingstatus\",\"current\":{\"cores\":7,\"endDate\":\"2026-11-06\",\"pricingModel\":\"s-pricingmodel\",\"startDate\":\"2026-11-06\"},\"upcoming\":{\"cores\":7,\"endDate\":\"2026-11-06\",\"pricingModel\":\"s-pricingmodel\",\"startDate\":\"2026-11-06\"}},\"billingModel\":\"s-billingmodel\",\"connectionIntent\":\"s-connectionintent\",\"connectionStatus\":\"s-connectionstatus\",\"deviceVersion\":\"s-deviceversion\",\"provisioningState\":\"Succeeded\",\"registrationStatus\":\"s-registrationstatus\",\"stampId\":\"s-stampid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
