  gv_set(f, 200, "{\"compatibleVersions\":[\"s-compatibleversions\"],\"downloadLink\":\"https://management.example.test/next?\$skiptoken=2\",\"linkExpiry\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"releaseDate\":\"2026-11-06\",\"releaseDisplayName\":\"s-releasedisplayname\",\"releaseNotes\":\"s-releasenotes\",\"releaseType\":\"s-releasetype\",\"releaseVersion\":\"s-releaseversion\",\"transactionId\":\"s-transactionid\",\"updateProperties\":{\"agentVersion\":\"s-agentversion\",\"featureUpdates\":\"s-featureupdates\",\"osVersion\":\"s-osversion\",\"securityUpdates\":\"s-securityupdates\",\"systemReboot\":\"s-systemreboot\"}}")
  gv_note(f, "CALL ImagesClient.ListDownloadURI")
  match c.list_download_uri("id1/ x", "id2/ x", "id3/ x", ImagesClientListDownloadURIOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_images_client_list_download_uri_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_15)
}

fn show_images_client_list_by_disconnected_operation_response(r: ImagesClientListByDisconnectedOperationResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.image_list_result).to_str_lossy()}")
  parts.join(" ")
}

