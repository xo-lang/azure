test "Go's ImagesClient.NewListByDisconnectedOperationPager" {
  let f = gv_new_fake(os.net)
  let c = new_images_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"compatibleVersions\":[\"s-compatibleversions\"],\"provisioningState\":\"Succeeded\",\"releaseDate\":\"2026-11-06\",\"releaseDisplayName\":\"s-releasedisplayname\",\"releaseNotes\":\"s-releasenotes\",\"releaseType\":\"s-releasetype\",\"releaseVersion\":\"s-releaseversion\",\"updateProperties\":{\"agentVersion\":\"s-agentversion\",\"featureUpdates\":\"s-featureupdates\",\"osVersion\":\"s-osversion\",\"securityUpdates\":\"s-securityupdates\",\"systemReboot\":\"s-systemreboot\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ImagesClient.NewListByDisconnectedOperationPager")
  var pg = c.new_list_by_disconnected_operation_pager("id1/ x", "id2/ x", ImagesClientListByDisconnectedOperationOptions{filter: Some("s-filter"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_images_client_list_by_disconnected_operation_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_16)
}
