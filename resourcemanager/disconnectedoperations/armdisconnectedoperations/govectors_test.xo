test "Go's Client.ListDeploymentManifest" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"benefitPlans\":{\"azureHybridWindowsServerBenefit\":\"s-azurehybridwindowsserverbenefit\",\"windowsServerVmCount\":7},\"billingConfiguration\":{\"autoRenew\":\"s-autorenew\",\"billingStatus\":\"s-billingstatus\",\"current\":{\"cores\":7,\"endDate\":\"2026-11-06\",\"pricingModel\":\"s-pricingmodel\",\"startDate\":\"2026-11-06\"},\"upcoming\":{\"cores\":7,\"endDate\":\"2026-11-06\",\"pricingModel\":\"s-pricingmodel\",\"startDate\":\"2026-11-06\"}},\"billingModel\":\"s-billingmodel\",\"cloud\":\"s-cloud\",\"connectionIntent\":\"s-connectionintent\",\"location\":\"s-location\",\"resourceId\":\"s-resourceid\",\"resourceName\":\"s-resourcename\",\"stampId\":\"s-stampid\"}")
  gv_note(f, "CALL Client.ListDeploymentManifest")
  match c.list_deployment_manifest("id1/ x", "id2/ x", ClientListDeploymentManifestOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_client_list_deployment_manifest_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_6)
}

fn show_client_list_by_resource_group_response(r: ClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.disconnected_operation_list_result).to_str_lossy()}")
  parts.join(" ")
}

