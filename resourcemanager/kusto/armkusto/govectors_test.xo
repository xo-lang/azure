test "Go's ScriptsClient.NewListByDatabasePager" {
  let f = gv_new_fake(os.net)
  let c = new_scripts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"continueOnErrors\":true,\"forceUpdateTag\":\"s-forceupdatetag\",\"managedIdentityResourceId\":\"s-managedidentityresourceid\",\"principalPermissionsAction\":\"s-principalpermissionsaction\",\"provisioningState\":\"Succeeded\",\"scriptContent\":\"s-scriptcontent\",\"scriptLevel\":\"s-scriptlevel\",\"scriptUrl\":\"s-scripturl\",\"scriptUrlSasToken\":\"s-scripturlsastoken\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ScriptsClient.NewListByDatabasePager")
  var pg = c.new_list_by_database_pager("id1/ x", "id2/ x", "id3/ x", ScriptsClientListByDatabaseOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_scripts_client_list_by_database_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_82)
}
