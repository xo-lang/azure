test "Go's ScriptsClient.BeginUpdate" {
  let f = gv_new_fake(os.net)
  let c = new_scripts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"continueOnErrors\":true,\"forceUpdateTag\":\"s-forceupdatetag\",\"managedIdentityResourceId\":\"s-managedidentityresourceid\",\"principalPermissionsAction\":\"s-principalpermissionsaction\",\"provisioningState\":\"Succeeded\",\"scriptContent\":\"s-scriptcontent\",\"scriptLevel\":\"s-scriptlevel\",\"scriptUrl\":\"s-scripturl\",\"scriptUrlSasToken\":\"s-scripturlsastoken\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ScriptsClient.BeginUpdate")
  match c.begin_update("id1/ x", "id2/ x", "id3/ x", "id4/ x", (json.decode_str[Script]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"continueOnErrors\":true,\"forceUpdateTag\":\"s-forceupdatetag\",\"managedIdentityResourceId\":\"s-managedidentityresourceid\",\"principalPermissionsAction\":\"s-principalpermissionsaction\",\"provisioningState\":\"Succeeded\",\"scriptContent\":\"s-scriptcontent\",\"scriptLevel\":\"s-scriptlevel\",\"scriptUrl\":\"s-scripturl\",\"scriptUrlSasToken\":\"s-scripturlsastoken\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), ScriptsClientBeginUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_scripts_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_79)
}

