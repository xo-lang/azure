  /// Resource qualification state for the operation.
  pub qualification_state as "qualificationState,omitempty": QualificationState? = None
  /// Advisory resource feasibility reviews. Absent when no review was evaluated for this resource.
  pub resource_feasibility_reviews as "resourceFeasibilityReviews,omitempty": List[ResourceFeasibilityReview]? = None
} derive Json

/// Details of resource and its qualification for an operation
pub struct RecoveryResourceQualification {
