/// SystemDataPatch: SystemData in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct SystemDataPatch {
  /// The timestamp of resource creation (UTC).
  pub created_at as "createdAt,omitempty": json.Patch[azcore.DateTimeUTC] = json.Patch.Absent
  /// The identity that created the resource.
  pub created_by as "createdBy,omitempty": json.Patch[Str] = json.Patch.Absent
  /// The type of identity that created the resource.
  pub created_by_type as "createdByType,omitempty": json.Patch[CreatedByType] = json.Patch.Absent
  /// The timestamp of resource last modification (UTC)
  pub last_modified_at as "lastModifiedAt,omitempty": json.Patch[azcore.DateTimeUTC] = json.Patch.Absent
  /// The identity that last modified the resource.
  pub last_modified_by as "lastModifiedBy,omitempty": json.Patch[Str] = json.Patch.Absent
  /// The type of identity that last modified the resource.
  pub last_modified_by_type as "lastModifiedByType,omitempty": json.Patch[CreatedByType] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: SystemData) patch() -> SystemDataPatch {
  SystemDataPatch{
    created_by: match m.created_by {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    created_by_type: match m.created_by_type {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    created_at: match m.created_at {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    last_modified_by: match m.last_modified_by {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    last_modified_by_type: match m.last_modified_by_type {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    last_modified_at: match m.last_modified_at {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
