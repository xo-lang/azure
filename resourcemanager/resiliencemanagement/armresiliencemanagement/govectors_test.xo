test "Go's DrillRunsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_drill_runs_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"attestation\":\"s-attestation\",\"currentActiveOperationId\":\"s-currentactiveoperationid\",\"drillId\":\"s-drillid\",\"drillMode\":\"s-drillmode\",\"duration\":\"s-duration\",\"endTime\":\"2026-11-06T10:00:00Z\",\"errorDetails\":{\"errorCode\":\"s-errorcode\",\"errorMessage\":\"s-errormessage\",\"recommendations\":[\"s-recommendations\"]},\"executionConfigurations\":{\"userConsent\":\"s-userconsent\"},\"jobExtendedInfo\":{\"dynamicErrorMessage\":\"s-dynamicerrormessage\",\"tasksList\":[{\"duration\":\"s-duration\",\"endTime\":\"2026-11-06T10:00:00Z\",\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"taskId\":\"s-taskid\",\"taskName\":\"s-taskname\"}]},\"jobType\":\"DrillRun\",\"notes\":[\"s-notes\"],\"operation\":\"s-operation\",\"report\":{\"availableFormats\":[\"s-availableformats\"],\"finalizationState\":\"s-finalizationstate\",\"generationStatus\":\"s-generationstatus\",\"lastError\":{\"code\":\"s-code\",\"message\":\"s-message\",\"recommendations\":[\"s-recommendations\"]},\"lastGeneratedTimestamp\":\"2026-11-06T10:00:00Z\",\"schemaVersion\":\"s-schemaversion\",\"stageStatuses\":[{\"drillRunStage\":\"s-drillrunstage\",\"generationStatus\":\"s-generationstatus\",\"lastAttemptTimestamp\":\"2026-11-06T10:00:00Z\"}]},\"resourceId\":\"s-resourceid\",\"retryDetails\":[{\"duration\":\"s-duration\",\"endTime\":\"2026-11-06T10:00:00Z\",\"errorDetails\":{\"errorCode\":\"s-errorcode\",\"errorMessage\":\"s-errormessage\"},\"retryAttempt\":7,\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\"}],\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"supportedVerbsForStage\":[{\"drillRunStage\":\"s-drillrunstage\",\"supportedVerbs\":[\"s-supportedverbs\"]}],\"triggeredBy\":\"s-triggeredby\",\"userComments\":[{\"commentTime\":\"2026-11-06T10:00:00Z\",\"commentType\":\"s-commenttype\",\"comments\":\"s-comments\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DrillRunsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", DrillRunsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_drill_runs_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_12)
}

