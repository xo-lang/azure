test "Go's DrillResourcesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_drill_resources_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"activeLocations\":[\"s-activelocations\"],\"advisorRecommendationTypeId\":\"s-advisorrecommendationtypeid\",\"attentionReason\":{\"faultRbacOnTargetResource\":\"s-faultrbacontargetresource\",\"monitoringRbacOnTargets\":\"s-monitoringrbacontargets\",\"resourceState\":[\"s-resourcestate\"],\"runbookFaultRbacOnTargets\":\"s-runbookfaultrbacontargets\"},\"drillType\":\"Regional\",\"faultProperties\":{\"customFault\":{\"faultName\":\"s-faultname\",\"scriptResourceId\":\"s-scriptresourceid\"},\"defaultFault\":{\"faultName\":\"s-faultname\",\"faultUrn\":\"s-faulturn\",\"targetResourceId\":\"s-targetresourceid\"},\"overriddenDefaultFault\":{\"faultName\":\"s-faultname\",\"faultUrn\":\"s-faulturn\",\"targetResourceId\":\"s-targetresourceid\"}},\"faultState\":\"s-faultstate\",\"forceInclusionState\":\"s-forceinclusionstate\",\"inclusionState\":\"s-inclusionstate\",\"monitoringRbacAssignmentError\":{\"code\":\"s-code\",\"message\":\"s-message\",\"recommendations\":[\"s-recommendations\"]},\"provisioningState\":\"Succeeded\",\"rbacAssignmentError\":{\"code\":\"s-code\",\"message\":\"s-message\",\"recommendations\":[\"s-recommendations\"]},\"readinessState\":\"s-readinessstate\",\"recoveryLocations\":[\"s-recoverylocations\"],\"recoveryPlanExclusionReason\":\"s-recoveryplanexclusionreason\",\"recoveryPlanInclusionState\":\"s-recoveryplaninclusionstate\",\"resourceId\":\"s-resourceid\",\"resourceProtectionSolutionType\":\"s-resourceprotectionsolutiontype\",\"resourceType\":\"s-resourcetype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DrillResourcesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", DrillResourcesClientListOptions{skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_drill_resources_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_1)
}

