test "Go's RecoveryJobsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_recovery_jobs_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"duration\":\"s-duration\",\"endTime\":\"2026-11-06T10:00:00Z\",\"errorDetails\":{\"errorCode\":\"s-errorcode\",\"errorMessage\":\"s-errormessage\",\"recommendations\":[\"s-recommendations\"]},\"executionConfigurations\":{\"userConsent\":\"s-userconsent\"},\"jobExtendedInfo\":{\"dynamicErrorMessage\":\"s-dynamicerrormessage\",\"tasksList\":[{\"duration\":\"s-duration\",\"endTime\":\"2026-11-06T10:00:00Z\",\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"taskId\":\"s-taskid\",\"taskName\":\"s-taskname\"}]},\"jobType\":\"RecoveryPlan\",\"operation\":\"s-operation\",\"provisioningState\":\"Succeeded\",\"resourceId\":\"s-resourceid\",\"retryDetails\":[{\"duration\":\"s-duration\",\"endTime\":\"2026-11-06T10:00:00Z\",\"errorDetails\":{\"errorCode\":\"s-errorcode\",\"errorMessage\":\"s-errormessage\"},\"retryAttempt\":7,\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\"}],\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"triggeredBy\":\"s-triggeredby\",\"userComments\":[{\"commentTime\":\"2026-11-06T10:00:00Z\",\"commentType\":\"s-commenttype\",\"comments\":\"s-comments\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RecoveryJobsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", RecoveryJobsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_recovery_jobs_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_45)
}

