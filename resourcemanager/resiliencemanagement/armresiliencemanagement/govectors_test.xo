test "Go's DrillsClient.BeginAddOrUpdateResources" {
  let f = gv_new_fake(os.net)
  let c = new_drills_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL DrillsClient.BeginAddOrUpdateResources")
  match c.begin_add_or_update_resources("id1/ x", "id2/ x", "id3/ x", (json.decode_str[AddOrUpdateResourcesRequest]("{\"faultDurationInMin\":7,\"forceInclusionAndUpdate\":\"s-forceinclusionandupdate\",\"resourceLists\":{\"excludeResources\":[\"s-excluderesources\"],\"includeResources\":[{\"faultProperties\":{\"availableFaults\":[{\"faultName\":\"s-faultname\",\"faultUrn\":\"s-faulturn\",\"targetResourceId\":\"s-targetresourceid\"}],\"customFault\":{\"faultName\":\"s-faultname\",\"scriptResourceId\":\"s-scriptresourceid\"},\"defaultFault\":{\"faultName\":\"s-faultname\",\"faultUrn\":\"s-faulturn\",\"targetResourceId\":\"s-targetresourceid\"},\"overriddenDefaultFault\":{\"faultName\":\"s-faultname\",\"faultUrn\":\"s-faulturn\",\"targetResourceId\":\"s-targetresourceid\"}},\"id\":\"s-id\"}],\"updateResources\":[{\"faultProperties\":{\"availableFaults\":[{\"faultName\":\"s-faultname\",\"faultUrn\":\"s-faulturn\",\"targetResourceId\":\"s-targetresourceid\"}],\"customFault\":{\"faultName\":\"s-faultname\",\"scriptResourceId\":\"s-scriptresourceid\"},\"defaultFault\":{\"faultName\":\"s-faultname\",\"faultUrn\":\"s-faulturn\",\"targetResourceId\":\"s-targetresourceid\"},\"overriddenDefaultFault\":{\"faultName\":\"s-faultname\",\"faultUrn\":\"s-faulturn\",\"targetResourceId\":\"s-targetresourceid\"}},\"id\":\"s-id\"}]}}") ?? e => fault("${e}")), DrillsClientBeginAddOrUpdateResourcesOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_drills_client_add_or_update_resources_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_13)
}

fn show_drills_client_create_response(r: DrillsClientCreateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.drill).to_str_lossy()}")
  parts.join(" ")
}

