test "Go's RecoveryPlansClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_recovery_plans_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"name\":\"s-name\",\"properties\":{\"errorDetails\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"latestFailoverStatus\":{\"errorDetails\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"},\"lastExecutedAt\":\"2026-11-06T10:00:00Z\",\"operationStatus\":\"s-operationstatus\",\"recoveryTimeActual\":\"s-recoverytimeactual\"},\"latestValidationStatus\":{\"errorDetails\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"},\"lastExecutedAt\":\"2026-11-06T10:00:00Z\",\"operationStatus\":\"s-operationstatus\"},\"planDescription\":\"s-plandescription\",\"planState\":\"s-planstate\",\"planType\":\"s-plantype\",\"provisioningState\":\"Succeeded\",\"recoveryGroupsSetting\":{\"additionalGroups\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"}],\"defaultGroup\":{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"groupUniqueId\":\"s-groupuniqueid\",\"orderId\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RecoveryPlansClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", RecoveryPlansClientListOptions{skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_recovery_plans_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_64)
}

fn show_recovery_resources_client_get_response(r: RecoveryResourcesClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.recovery_resource).to_str_lossy()}")
  parts.join(" ")
}

