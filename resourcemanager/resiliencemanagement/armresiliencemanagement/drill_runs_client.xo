  if drill_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter drillName cannot be empty"))
  }
  path = path.replace("{drillName}", url.path_escape(drill_name))
  if drill_run_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter drillRunName cannot be empty"))
  }
  path = path.replace("{drillRunName}", url.path_escape(drill_run_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("operation-id", operation_id))
  var body = b""
  if let Some(v) = options.body {
    headers.push(("Content-Type", "application/json"))
    body = runtime.marshal_json(v)
  }
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: body})
}

/// This initiates a new Reprotect operation on this Drill Run.
pub fn (c: DrillRunsClient[fx]) begin_reprotect(service_group_name: Str, operation_id: Str, drill_name: Str, drill_run_name: Str, options: DrillRunsClientBeginReprotectOptions = DrillRunsClientBeginReprotectOptions{}) -> runtime.Poller[DrillRunsClientReprotectResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "DrillRunsClientReprotectResponse", fn(r: http.Response) -> DrillRunsClientReprotectResponse ! Str { drill_runs_reprotect_handle(r) })
  }
  let req = c.reprotect_create_request(service_group_name, operation_id, drill_name, drill_run_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "", "DrillRunsClientReprotectResponse", fn(r: http.Response) -> DrillRunsClientReprotectResponse ! Str { drill_runs_reprotect_handle(r) })
}

/// DrillRunsClientBeginResumeOptions: the optional parameters of DrillRunsClient.begin_resume.
pub struct DrillRunsClientBeginResumeOptions {
  /// Resumes the operation from a poller's resume_token instead of starting it.
  pub resume_token: Str = ""
}

/// DrillRunsClientResumeResponse: the response of DrillRunsClient.begin_resume.
pub struct DrillRunsClientResumeResponse {
  pub drill_run_action_response: DrillRunActionResponse
}

fn drill_runs_resume_handle(resp: http.Response) -> DrillRunsClientResumeResponse ! Str {
  let v = if resp.body.is_empty() { DrillRunActionResponse{} } else { json.decode[DrillRunActionResponse](resp.body) ?? e => return Err(e.display()) }
  Ok(DrillRunsClientResumeResponse{drill_run_action_response: v})
}

fn (c: DrillRunsClient) resume_create_request(service_group_name: Str, operation_id: Str, drill_name: Str, drill_run_name: Str, options: DrillRunsClientBeginResumeOptions) -> policy.Request ! azcore.CallErr {
  var path = "/providers/Microsoft.Management/serviceGroups/{serviceGroupName}/providers/Microsoft.AzureResilienceManagement/drills/{drillName}/drillRuns/{drillRunName}/resume"
  if service_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter serviceGroupName cannot be empty"))
  }
  path = path.replace("{serviceGroupName}", url.path_escape(service_group_name))
  if drill_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter drillName cannot be empty"))
  }
  path = path.replace("{drillName}", url.path_escape(drill_name))
  if drill_run_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter drillRunName cannot be empty"))
  }
  path = path.replace("{drillRunName}", url.path_escape(drill_run_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("operation-id", operation_id))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: b""})
}

/// This unblocks a Failover workflow that is paused after the Fault stage, to proceed to the Failover stage.
pub fn (c: DrillRunsClient[fx]) begin_resume(service_group_name: Str, operation_id: Str, drill_name: Str, drill_run_name: Str, options: DrillRunsClientBeginResumeOptions = DrillRunsClientBeginResumeOptions{}) -> runtime.Poller[DrillRunsClientResumeResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "DrillRunsClientResumeResponse", fn(r: http.Response) -> DrillRunsClientResumeResponse ! Str { drill_runs_resume_handle(r) })
  }
  let req = c.resume_create_request(service_group_name, operation_id, drill_name, drill_run_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "", "DrillRunsClientResumeResponse", fn(r: http.Response) -> DrillRunsClientResumeResponse ! Str { drill_runs_resume_handle(r) })
}
