test "Go's AccountsClient.NewListModelsPager" {
  let f = gv_new_fake(os.net)
  let c = new_accounts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"baseModel\":{\"callRateLimit\":{\"count\":1.5,\"renewalPeriod\":1.5,\"rules\":[{\"count\":1.5,\"dynamicThrottlingEnabled\":true,\"key\":\"s-key\",\"minCount\":1.5,\"renewalPeriod\":1.5}]},\"format\":\"s-format\",\"name\":\"s-name\",\"publisher\":\"s-publisher\",\"source\":\"s-source\",\"sourceAccount\":\"s-sourceaccount\",\"version\":\"s-version\"},\"callRateLimit\":{\"count\":1.5,\"renewalPeriod\":1.5,\"rules\":[{\"count\":1.5,\"dynamicThrottlingEnabled\":true,\"key\":\"s-key\",\"minCount\":1.5,\"renewalPeriod\":1.5}]},\"capabilities\":{\"k1\":\"s-capabilities\"},\"deprecation\":{\"deprecationStatus\":\"s-deprecationstatus\",\"fineTune\":\"s-finetune\",\"inference\":\"s-inference\"},\"finetuneCapabilities\":{\"k1\":\"s-finetunecapabilities\"},\"format\":\"s-format\",\"isDefaultVersion\":true,\"lifecycleStatus\":\"s-lifecyclestatus\",\"maxCapacity\":7,\"modelCatalogAssetId\":\"s-modelcatalogassetid\",\"name\":\"s-name\",\"publisher\":\"s-publisher\",\"replacementConfig\":{\"autoUpgradeStartDate\":\"2026-11-06T10:00:00Z\",\"targetModelName\":\"s-targetmodelname\",\"targetModelVersion\":\"s-targetmodelversion\",\"upgradeOnExpiryLeadTimeDays\":7},\"skus\":[{\"capacity\":{\"allowedValues\":[7],\"default\":7,\"maximum\":7,\"minimum\":7,\"step\":7},\"cost\":[{\"meterId\":\"s-meterid\",\"name\":\"s-name\",\"unit\":\"s-unit\"}],\"deprecationDate\":\"2026-11-06T10:00:00Z\",\"name\":\"s-name\",\"rateLimits\":[{\"count\":1.5,\"renewalPeriod\":1.5}],\"usageName\":\"s-usagename\"}],\"source\":\"s-source\",\"sourceAccount\":\"s-sourceaccount\",\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"version\":\"s-version\"}]}")
  gv_note(f, "CALL AccountsClient.NewListModelsPager")
  var pg = c.new_list_models_pager("id1/ x", "id2/ x", AccountsClientListModelsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_accounts_client_list_models_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_17)
}

fn show_accounts_client_list_response(r: AccountsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.account_list_result).to_str_lossy()}")
  parts.join(" ")
}

