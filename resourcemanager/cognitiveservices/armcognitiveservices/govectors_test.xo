test "Go's DeletedAccountsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_deleted_accounts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"abusePenalty\":{\"action\":\"s-action\",\"expiration\":\"2026-11-06T10:00:00Z\",\"rateLimitPercentage\":1.5},\"allowProjectManagement\":true,\"allowedFqdnList\":[\"s-allowedfqdnlist\"],\"amlWorkspace\":{\"identityClientId\":\"s-identityclientid\",\"resourceId\":\"s-resourceid\"},\"apiProperties\":{\"aadClientId\":\"s-aadclientid\",\"aadTenantId\":\"s-aadtenantid\",\"eventHubConnectionString\":\"s-eventhubconnectionstring\",\"k1\":{\"k\":\"v\"},\"qnaAzureSearchEndpointId\":\"s-qnaazuresearchendpointid\",\"qnaAzureSearchEndpointKey\":\"s-qnaazuresearchendpointkey\",\"qnaRuntimeEndpoint\":\"s-qnaruntimeendpoint\",\"statisticsEnabled\":true,\"storageAccountConnectionString\":\"s-storageaccountconnectionstring\",\"superUser\":\"s-superuser\",\"websiteName\":\"s-websitename\"},\"associatedProjects\":[\"s-associatedprojects\"],\"callRateLimit\":{\"count\":1.5,\"renewalPeriod\":1.5,\"rules\":[{\"count\":1.5,\"dynamicThrottlingEnabled\":true,\"key\":\"s-key\",\"minCount\":1.5,\"renewalPeriod\":1.5}]},\"capabilities\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"commitmentPlanAssociations\":[{\"commitmentPlanId\":\"s-commitmentplanid\",\"commitmentPlanLocation\":\"s-commitmentplanlocation\"}],\"customSubDomainName\":\"s-customsubdomainname\",\"dateCreated\":\"s-datecreated\",\"defaultProject\":\"s-defaultproject\",\"deletionDate\":\"s-deletiondate\",\"disableLocalAuth\":true,\"dynamicThrottlingEnabled\":true,\"encryption\":{\"keySource\":\"s-keysource\",\"keyVaultProperties\":{\"identityClientId\":\"s-identityclientid\",\"keyName\":\"s-keyname\",\"keyVaultUri\":\"s-keyvaulturi\",\"keyVersion\":\"s-keyversion\"}},\"endpoint\":\"s-endpoint\",\"endpoints\":{\"k1\":\"s-endpoints\"},\"internalId\":\"s-internalid\",\"isMigrated\":true,\"locations\":{\"regions\":[{\"customsubdomain\":\"s-customsubdomain\",\"name\":\"s-name\",\"value\":1.5}],\"routingMethod\":\"s-routingmethod\"},\"migrationToken\":\"s-migrationtoken\",\"networkAcls\":{\"bypass\":\"s-bypass\",\"defaultAction\":\"s-defaultaction\",\"ipRules\":[{\"value\":\"s-value\"}],\"virtualNetworkRules\":[{\"id\":\"s-id\",\"ignoreMissingVnetServiceEndpoint\":true,\"state\":\"s-state\"}]},\"networkInjections\":[{\"scenario\":\"s-scenario\",\"subnetArmId\":\"s-subnetarmid\",\"useMicrosoftManagedNetwork\":true}],\"privateEndpointConnections\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"quotaLimit\":{\"count\":1.5,\"renewalPeriod\":1.5,\"rules\":[{\"count\":1.5,\"dynamicThrottlingEnabled\":true,\"key\":\"s-key\",\"minCount\":1.5,\"renewalPeriod\":1.5}]},\"raiMonitorConfig\":{\"adxStorageResourceId\":\"s-adxstorageresourceid\",\"identityClientId\":\"s-identityclientid\"},\"restore\":true,\"restrictOutboundNetworkAccess\":true,\"scheduledPurgeDate\":\"s-scheduledpurgedate\",\"skuChangeInfo\":{\"countOfDowngrades\":1.5,\"countOfUpgradesAfterDowngrades\":1.5,\"lastChangeDate\":\"s-lastchangedate\"},\"storedCompletionsDisabled\":true,\"userOwnedStorage\":[{\"identityClientId\":\"s-identityclientid\",\"resourceId\":\"s-resourceid\"}]},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DeletedAccountsClient.NewListPager")
  var pg = c.new_list_pager(DeletedAccountsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_deleted_accounts_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_41)
}

fn show_deployments_client_create_or_update_response(r: DeploymentsClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.deployment).to_str_lossy()}")
  parts.join(" ")
}

