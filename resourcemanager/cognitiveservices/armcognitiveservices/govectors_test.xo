fn show_accounts_client_list_models_response(r: AccountsClientListModelsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.account_model_list_result).to_str_lossy()}")
  parts.join(" ")
}

