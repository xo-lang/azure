  let c = new_quota_tiers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"assignmentDate\":\"2026-11-06T10:00:00Z\",\"currentTierName\":\"s-currenttiername\",\"tierUpgradeEligibilityInfo\":{\"nextTierName\":\"s-nexttiername\",\"upgradeApplicableDate\":\"2026-11-06T10:00:00Z\",\"upgradeAvailabilityStatus\":\"s-upgradeavailabilitystatus\",\"upgradeUnavailabilityReason\":\"s-upgradeunavailabilityreason\"},\"tierUpgradePolicy\":\"s-tierupgradepolicy\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL QuotaTiersClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(QuotaTiersClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
