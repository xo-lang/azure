  aad_tenant_id as "aadTenantId,omitempty": Str? = None
  event_hub_connection_string as "eventHubConnectionString,omitempty": Str? = None
  qna_azure_search_endpoint_id as "qnaAzureSearchEndpointId,omitempty": Str? = None
  qna_azure_search_endpoint_key as "qnaAzureSearchEndpointKey,omitempty": Str? = None
  qna_runtime_endpoint as "qnaRuntimeEndpoint,omitempty": Str? = None
