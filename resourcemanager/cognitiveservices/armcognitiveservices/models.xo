fn api_properties_json(x: APIProperties) -> json.Value {
  let known = APIPropertiesKnown{
    aad_client_id: x.aad_client_id,
    aad_tenant_id: x.aad_tenant_id,
    event_hub_connection_string: x.event_hub_connection_string,
    qna_azure_search_endpoint_id: x.qna_azure_search_endpoint_id,
    qna_azure_search_endpoint_key: x.qna_azure_search_endpoint_key,
    qna_runtime_endpoint: x.qna_runtime_endpoint,
    statistics_enabled: x.statistics_enabled,
    storage_account_connection_string: x.storage_account_connection_string,
    super_user: x.super_user,
    website_name: x.website_name,
  }
  with_additional(json.to_value(known), x.additional_properties)
}

fn parse_api_properties(v: json.Value) -> APIProperties ! json.DecodeErr {
  let k = json.from_value[APIPropertiesKnown](v)?
  Ok(APIProperties{
    aad_client_id: k.aad_client_id,
    aad_tenant_id: k.aad_tenant_id,
    event_hub_connection_string: k.event_hub_connection_string,
    qna_azure_search_endpoint_id: k.qna_azure_search_endpoint_id,
    qna_azure_search_endpoint_key: k.qna_azure_search_endpoint_key,
    qna_runtime_endpoint: k.qna_runtime_endpoint,
    statistics_enabled: k.statistics_enabled,
    storage_account_connection_string: k.storage_account_connection_string,
    super_user: k.super_user,
    website_name: k.website_name,
    additional_properties: additional_of(v, ["aadClientId", "aadTenantId", "eventHubConnectionString", "qnaAzureSearchEndpointId", "qnaAzureSearchEndpointKey", "qnaRuntimeEndpoint", "statisticsEnabled", "storageAccountConnectionString", "superUser", "websiteName"]),
  })
}

