/// SKUPatch: SKU in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct SKUPatch {
  /// If the SKU supports scale out/in then the capacity integer should be included. If scale out/in is not possible for the resource this may be omitted.
  pub capacity as "capacity,omitempty": json.Patch[Int] = json.Patch.Absent
  /// If the service has different generations of hardware, for the same SKU, then that can be captured here.
  pub family as "family,omitempty": json.Patch[Str] = json.Patch.Absent
  /// The name of the SKU. Ex - P3. It is typically a letter+number code
  pub name as "name,omitempty": json.Patch[Str] = json.Patch.Absent
  /// The SKU size. When the name field is the combination of tier and some other value, this would be the standalone code.
  pub size as "size,omitempty": json.Patch[Str] = json.Patch.Absent
  /// This field is required to be implemented by the Resource Provider if the service has more than one tier, but is not required on a PUT.
  pub tier as "tier,omitempty": json.Patch[SKUTier] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: SKU) patch() -> SKUPatch {
  SKUPatch{
    name: match m.name {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    tier: match m.tier {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    size: match m.size {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    family: match m.family {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    capacity: match m.capacity {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}

/// `v` with `extra`'s keys added (over a field's of the same name), as
/// Go's MarshalJSON writes AdditionalProperties (its keys sorted).
fn with_additional(v: json.Value, extra: Map[Str, json.Value]?) -> json.Value {
  let m = extra ?? return v
  match v {
    json.Value.Object(fs) => {
      var all = fs.filter(fn(f: (Str, json.Value)) -> Bool { !m.contains(f.0) })
      for (k, x) in m {
        all.push((k, x))
      }
      json.Value.Object(all.sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    }
    other => other
  }
}

/// The keys of `v` no field names (Go's AdditionalProperties); None
/// when there are none.
fn additional_of(v: json.Value, known: List[Str]) -> Map[Str, json.Value]? {
  match v {
    json.Value.Object(fs) => {
      var m: Map[Str, json.Value] = {}
      for (k, x) in fs {
        if !known.contains(k) {
          m[k] = x
        }
      }
      if m.is_empty() { None } else { Some(m) }
    }
    _ => None
  }
}
