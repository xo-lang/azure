/// ConnectionPropertiesV2Classification: a ConnectionPropertiesV2 by its authType, Go's ConnectionPropertiesV2Classification interface.
pub enum ConnectionPropertiesV2Classification {
  /// authType "PAT"
  PATAuthTypeConnectionProperties(from PATAuthTypeConnectionProperties)
  /// authType "ManagedIdentity"
  ManagedIdentityAuthTypeConnectionProperties(from ManagedIdentityAuthTypeConnectionProperties)
  /// authType "UsernamePassword"
  UsernamePasswordAuthTypeConnectionProperties(from UsernamePasswordAuthTypeConnectionProperties)
  /// authType "None"
  NoneAuthTypeConnectionProperties(from NoneAuthTypeConnectionProperties)
  /// authType "SAS"
  SASAuthTypeConnectionProperties(from SASAuthTypeConnectionProperties)
  /// authType "AccountKey"
  AccountKeyAuthTypeConnectionProperties(from AccountKeyAuthTypeConnectionProperties)
  /// authType "ServicePrincipal"
  ServicePrincipalAuthTypeConnectionProperties(from ServicePrincipalAuthTypeConnectionProperties)
  /// authType "AccessKey"
  AccessKeyAuthTypeConnectionProperties(from AccessKeyAuthTypeConnectionProperties)
  /// authType "ApiKey"
  APIKeyAuthConnectionProperties(from APIKeyAuthConnectionProperties)
  /// authType "CustomKeys"
  CustomKeysConnectionProperties(from CustomKeysConnectionProperties)
  /// authType "OAuth2"
  OAuth2AuthTypeConnectionProperties(from OAuth2AuthTypeConnectionProperties)
  /// authType "AAD"
  AADAuthTypeConnectionProperties(from AADAuthTypeConnectionProperties)
  /// Any other authType, as the base type.
  ConnectionPropertiesV2(from ConnectionPropertiesV2)
} derive Json(via: json.Value, to: connection_properties_v2_classification_json, from: parse_connection_properties_v2_classification)

fn connection_properties_v2_classification_json(c: ConnectionPropertiesV2Classification) -> json.Value {
  match c {
    ConnectionPropertiesV2Classification.PATAuthTypeConnectionProperties(x) => json.to_value(x)
    ConnectionPropertiesV2Classification.ManagedIdentityAuthTypeConnectionProperties(x) => json.to_value(x)
    ConnectionPropertiesV2Classification.UsernamePasswordAuthTypeConnectionProperties(x) => json.to_value(x)
    ConnectionPropertiesV2Classification.NoneAuthTypeConnectionProperties(x) => json.to_value(x)
    ConnectionPropertiesV2Classification.SASAuthTypeConnectionProperties(x) => json.to_value(x)
    ConnectionPropertiesV2Classification.AccountKeyAuthTypeConnectionProperties(x) => json.to_value(x)
    ConnectionPropertiesV2Classification.ServicePrincipalAuthTypeConnectionProperties(x) => json.to_value(x)
    ConnectionPropertiesV2Classification.AccessKeyAuthTypeConnectionProperties(x) => json.to_value(x)
    ConnectionPropertiesV2Classification.APIKeyAuthConnectionProperties(x) => json.to_value(x)
    ConnectionPropertiesV2Classification.CustomKeysConnectionProperties(x) => json.to_value(x)
    ConnectionPropertiesV2Classification.OAuth2AuthTypeConnectionProperties(x) => json.to_value(x)
    ConnectionPropertiesV2Classification.AADAuthTypeConnectionProperties(x) => json.to_value(x)
    ConnectionPropertiesV2Classification.ConnectionPropertiesV2(x) => json.to_value(x)
  }
}

fn parse_connection_properties_v2_classification(v: json.Value) -> ConnectionPropertiesV2Classification ! json.DecodeErr {
  match v.get("authType") {
    Some(json.Value.Str("PAT")) => Ok(ConnectionPropertiesV2Classification.PATAuthTypeConnectionProperties(json.from_value[PATAuthTypeConnectionProperties](v)?))
    Some(json.Value.Str("ManagedIdentity")) => Ok(ConnectionPropertiesV2Classification.ManagedIdentityAuthTypeConnectionProperties(json.from_value[ManagedIdentityAuthTypeConnectionProperties](v)?))
    Some(json.Value.Str("UsernamePassword")) => Ok(ConnectionPropertiesV2Classification.UsernamePasswordAuthTypeConnectionProperties(json.from_value[UsernamePasswordAuthTypeConnectionProperties](v)?))
    Some(json.Value.Str("None")) => Ok(ConnectionPropertiesV2Classification.NoneAuthTypeConnectionProperties(json.from_value[NoneAuthTypeConnectionProperties](v)?))
    Some(json.Value.Str("SAS")) => Ok(ConnectionPropertiesV2Classification.SASAuthTypeConnectionProperties(json.from_value[SASAuthTypeConnectionProperties](v)?))
    Some(json.Value.Str("AccountKey")) => Ok(ConnectionPropertiesV2Classification.AccountKeyAuthTypeConnectionProperties(json.from_value[AccountKeyAuthTypeConnectionProperties](v)?))
    Some(json.Value.Str("ServicePrincipal")) => Ok(ConnectionPropertiesV2Classification.ServicePrincipalAuthTypeConnectionProperties(json.from_value[ServicePrincipalAuthTypeConnectionProperties](v)?))
    Some(json.Value.Str("AccessKey")) => Ok(ConnectionPropertiesV2Classification.AccessKeyAuthTypeConnectionProperties(json.from_value[AccessKeyAuthTypeConnectionProperties](v)?))
    Some(json.Value.Str("ApiKey")) => Ok(ConnectionPropertiesV2Classification.APIKeyAuthConnectionProperties(json.from_value[APIKeyAuthConnectionProperties](v)?))
    Some(json.Value.Str("CustomKeys")) => Ok(ConnectionPropertiesV2Classification.CustomKeysConnectionProperties(json.from_value[CustomKeysConnectionProperties](v)?))
    Some(json.Value.Str("OAuth2")) => Ok(ConnectionPropertiesV2Classification.OAuth2AuthTypeConnectionProperties(json.from_value[OAuth2AuthTypeConnectionProperties](v)?))
    Some(json.Value.Str("AAD")) => Ok(ConnectionPropertiesV2Classification.AADAuthTypeConnectionProperties(json.from_value[AADAuthTypeConnectionProperties](v)?))
    _ => Ok(ConnectionPropertiesV2Classification.ConnectionPropertiesV2(json.from_value[ConnectionPropertiesV2](v)?))
  }
}

/// `v` with its discriminator `key` set to `value`, as Go's
/// MarshalJSON writes a subtype's (its keys sorted).
fn with_discriminator(v: json.Value, key: Str, value: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object((fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != key }) + [(key, json.Value.Str(value))]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    other => other
  }
}

