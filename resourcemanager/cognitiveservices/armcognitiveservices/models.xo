/// ClientId and ClientSecret are required. Other properties are optional depending on each OAuth2 provider's implementation.
pub struct ConnectionOAuth2 {
  /// Required by Concur connection category
  pub auth_url as "authUrl,omitempty": Str? = None
  /// Client id in the format of UUID
  pub client_id as "clientId,omitempty": Str? = None
  pub client_secret as "clientSecret,omitempty": Str? = None
  /// Required by GoogleAdWords connection category
  pub developer_token as "developerToken,omitempty": Str? = None
  pub password as "password,omitempty": Str? = None
  /// Required by GoogleBigQuery, GoogleAdWords, Hubspot, QuickBooks, Square, Xero, Zoho where user needs to get RefreshToken offline
  pub refresh_token as "refreshToken,omitempty": Str? = None
  /// Required by QuickBooks and Xero connection categories
  pub tenant_id as "tenantId,omitempty": Str? = None
  /// Concur, ServiceNow auth server AccessToken grant type is 'Password' which requires UsernamePassword
  pub username as "username,omitempty": Str? = None
} derive Json

