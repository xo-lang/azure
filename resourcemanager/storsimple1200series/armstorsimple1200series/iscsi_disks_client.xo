  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  Ok(policy.Request{method: "GET", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: b""})
}

/// Retrieves metric definitions for all metric aggregated at the iSCSI disk.
pub fn (c: IscsiDisksClient[fx]) new_list_metric_definition_pager(device_name: Str, iscsi_server_name: Str, disk_name: Str, resource_group_name: Str, manager_name: Str, options: IscsiDisksClientListMetricDefinitionOptions = IscsiDisksClientListMetricDefinitionOptions{}) -> runtime.Pager[IscsiDisksClientListMetricDefinitionResponse, fx] ! azcore.CallErr {
  let req = c.list_metric_definition_create_request(device_name, iscsi_server_name, disk_name, resource_group_name, manager_name, options)?
  Ok(runtime.new_pager(c.setup.pipeline, req, fn(r: http.Response) -> IscsiDisksClientListMetricDefinitionResponse ! Str { iscsi_disks_list_metric_definition_handle(r) }, fn(r: IscsiDisksClientListMetricDefinitionResponse) -> Str? { None }).traced_as("IscsiDisksClientListMetricDefinitionResponse"))
}
