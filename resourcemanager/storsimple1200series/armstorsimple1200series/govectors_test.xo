test "Go's StorageDomainsClient.NewListByManagerPager" {
  let f = gv_new_fake(os.net)
  let c = new_storage_domains_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"encryptionKey\":{\"encryptionAlgorithm\":\"s-encryptionalgorithm\",\"encryptionCertificateThumbprint\":\"s-encryptioncertificatethumbprint\",\"value\":\"s-value\"},\"encryptionStatus\":\"s-encryptionstatus\",\"storageAccountCredentialIds\":[\"s-storageaccountcredentialids\"]},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL StorageDomainsClient.NewListByManagerPager")
  var pg = c.new_list_by_manager_pager("id1/ x", "id2/ x", StorageDomainsClientListByManagerOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_storage_domains_client_list_by_manager_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_93)
}
