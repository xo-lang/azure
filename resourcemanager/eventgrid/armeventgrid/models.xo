      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    max_delivery_count: match m.max_delivery_count {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    dead_letter_destination_with_resource_identity: match m.dead_letter_destination_with_resource_identity {
      Some(x) => json.Patch.Value(x.patch())
      None => json.Patch.Absent
    },
    event_time_to_live: match m.event_time_to_live {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}

