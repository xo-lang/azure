test "Go's TopicEventSubscriptionsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_topic_event_subscriptions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"deadLetterDestination\":{\"endpointType\":\"StorageBlob\",\"properties\":{\"blobContainerName\":\"s-blobcontainername\",\"resourceId\":\"s-resourceid\"}},\"deadLetterWithResourceIdentity\":{\"deadLetterDestination\":{\"endpointType\":\"StorageBlob\"},\"identity\":{\"type\":\"s-type\",\"userAssignedIdentity\":\"s-userassignedidentity\"}},\"deliveryWithResourceIdentity\":{\"destination\":{\"endpointType\":\"AzureFunction\"},\"identity\":{\"type\":\"s-type\",\"userAssignedIdentity\":\"s-userassignedidentity\"}},\"destination\":{\"endpointType\":\"AzureFunction\",\"properties\":{\"maxEventsPerBatch\":7,\"preferredBatchSizeInKilobytes\":7,\"resourceId\":\"s-resourceid\"}},\"eventDeliverySchema\":\"s-eventdeliveryschema\",\"expirationTimeUtc\":\"2026-11-06T10:00:00Z\",\"filter\":{\"advancedFilters\":[{\"key\":\"s-key\",\"operatorType\":\"BoolEquals\",\"value\":true}],\"enableAdvancedFilteringOnArrays\":true,\"includedEventTypes\":[\"s-includedeventtypes\"],\"isSubjectCaseSensitive\":true,\"subjectBeginsWith\":\"s-subjectbeginswith\",\"subjectEndsWith\":\"s-subjectendswith\"},\"labels\":[\"s-labels\"],\"provisioningState\":\"Succeeded\",\"retryPolicy\":{\"eventTimeToLiveInMinutes\":7,\"maxDeliveryAttempts\":7},\"topic\":\"s-topic\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL TopicEventSubscriptionsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", TopicEventSubscriptionsClientListOptions{filter: Some("s-filter"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
