    return Err(azcore.CallErr.InvalidInput("parameter resourceTypeName cannot be empty"))
  }
  path = path.replace("{resourceTypeName}", url.path_escape(resource_type_name))
  if resource_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceName cannot be empty"))
  }
  path = path.replace("{resourceName}", url.path_escape(resource_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  Ok(policy.Request{method: "GET", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: b""})
}

/// List event types for a topic.
pub fn (c: TopicsClient[fx]) new_list_event_types_pager(resource_group_name: Str, provider_namespace: Str, resource_type_name: Str, resource_name: Str, options: TopicsClientListEventTypesOptions = TopicsClientListEventTypesOptions{}) -> runtime.Pager[TopicsClientListEventTypesResponse, fx] ! azcore.CallErr {
  let req = c.list_event_types_create_request(resource_group_name, provider_namespace, resource_type_name, resource_name, options)?
  Ok(runtime.new_pager(c.setup.pipeline, req, fn(r: http.Response) -> TopicsClientListEventTypesResponse ! Str { topics_list_event_types_handle(r) }, fn(r: TopicsClientListEventTypesResponse) -> Str? { None }))
}
