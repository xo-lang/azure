  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: b""})
}

/// Get all delivery attributes for an event subscription.
pub fn (c: EventSubscriptionsClient) get_delivery_attributes(scope: Str, event_subscription_name: Str, options: EventSubscriptionsClientGetDeliveryAttributesOptions = EventSubscriptionsClientGetDeliveryAttributesOptions{}) -> EventSubscriptionsClientGetDeliveryAttributesResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.get_delivery_attributes_create_request(scope, event_subscription_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  event_subscriptions_get_delivery_attributes_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
