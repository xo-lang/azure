test "Go's DiagnosticsClient.BeginCreate" {
  let f = gv_new_fake(os.net)
  let c = new_diagnostics_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"acceptedAt\":\"s-acceptedat\",\"diagnostics\":[{\"error\":{\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"type\":\"s-type\"}],\"message\":\"s-message\",\"type\":\"s-type\"},\"insights\":[{\"id\":\"s-id\",\"importanceLevel\":\"s-importancelevel\",\"results\":\"s-results\",\"title\":\"s-title\"}],\"solutionId\":\"s-solutionid\",\"status\":\"s-status\"}],\"globalParameters\":{\"k1\":\"s-globalparameters\"},\"insights\":[{\"additionalParameters\":{\"k1\":\"s-additionalparameters\"},\"solutionId\":\"s-solutionid\"}],\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL DiagnosticsClient.BeginCreate")
  match c.begin_create("id1/ x", "id2/ x", (json.decode_str[DiagnosticResource]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"acceptedAt\":\"s-acceptedat\",\"diagnostics\":[{\"error\":{\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"type\":\"s-type\"}],\"message\":\"s-message\",\"type\":\"s-type\"},\"insights\":[{\"id\":\"s-id\",\"importanceLevel\":\"s-importancelevel\",\"results\":\"s-results\",\"title\":\"s-title\"}],\"solutionId\":\"s-solutionid\",\"status\":\"s-status\"}],\"globalParameters\":{\"k1\":\"s-globalparameters\"},\"insights\":[{\"additionalParameters\":{\"k1\":\"s-additionalparameters\"},\"solutionId\":\"s-solutionid\"}],\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), DiagnosticsClientBeginCreateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_diagnostics_client_create_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

