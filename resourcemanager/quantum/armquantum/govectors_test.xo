test "Go's OfferingsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_offerings_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"aad\":{\"applicationId\":\"s-applicationid\",\"tenantId\":\"s-tenantid\"},\"company\":\"s-company\",\"defaultEndpoint\":\"s-defaultendpoint\",\"description\":\"s-description\",\"managedApplication\":{\"offerId\":\"s-offerid\",\"publisherId\":\"s-publisherid\"},\"pricingDimensions\":[{\"id\":\"s-id\",\"name\":\"s-name\"}],\"providerType\":\"s-providertype\",\"quotaDimensions\":[{\"description\":\"s-description\",\"id\":\"s-id\",\"name\":\"s-name\",\"period\":\"s-period\",\"quota\":1.5,\"scope\":\"s-scope\",\"unit\":\"s-unit\",\"unitPlural\":\"s-unitplural\"}],\"skus\":[{\"autoAdd\":true,\"description\":\"s-description\",\"id\":\"s-id\",\"name\":\"s-name\",\"restrictedAccessUri\":\"s-restrictedaccessuri\",\"targets\":[\"s-targets\"],\"version\":\"s-version\"}],\"targets\":[{\"acceptedContentEncodings\":[\"s-acceptedcontentencodings\"],\"acceptedDataFormats\":[\"s-accepteddataformats\"],\"description\":\"s-description\",\"id\":\"s-id\",\"name\":\"s-name\"}]}}]}")
  gv_note(f, "CALL OfferingsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", OfferingsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_offerings_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_0)
}

