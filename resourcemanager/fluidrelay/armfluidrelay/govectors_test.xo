test "Go's ServersClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_servers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"encryption\":{\"customerManagedKeyEncryption\":{\"keyEncryptionKeyIdentity\":{\"identityType\":\"s-identitytype\",\"userAssignedIdentityResourceId\":\"s-userassignedidentityresourceid\"},\"keyEncryptionKeyUrl\":\"s-keyencryptionkeyurl\"}},\"fluidRelayEndpoints\":{\"ordererEndpoints\":[\"s-ordererendpoints\"],\"serviceEndpoints\":[\"s-serviceendpoints\"],\"storageEndpoints\":[\"s-storageendpoints\"]},\"frsTenantId\":\"s-frstenantid\",\"provisioningState\":\"Succeeded\",\"storagesku\":\"s-storagesku\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ServersClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[ServerUpdate]("{\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"properties\":{\"encryption\":{\"customerManagedKeyEncryption\":{\"keyEncryptionKeyIdentity\":{\"identityType\":\"s-identitytype\",\"userAssignedIdentityResourceId\":\"s-userassignedidentityresourceid\"},\"keyEncryptionKeyUrl\":\"s-keyencryptionkeyurl\"}}},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), ServersClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_servers_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_11)
}
