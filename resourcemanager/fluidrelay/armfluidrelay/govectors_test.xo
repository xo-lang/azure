  "OUT: body={\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"encryption\":{\"customerManagedKeyEncryption\":{\"keyEncryptionKeyIdentity\":{\"identityType\":\"s-identitytype\",\"userAssignedIdentityResourceId\":\"s-userassignedidentityresourceid\"},\"keyEncryptionKeyUrl\":\"s-keyencryptionkeyurl\"}},\"fluidRelayEndpoints\":{\"ordererEndpoints\":[\"s-ordererendpoints\"],\"serviceEndpoints\":[\"s-serviceendpoints\"],\"storageEndpoints\":[\"s-storageendpoints\"]},\"frsTenantId\":\"s-frstenantid\",\"provisioningState\":\"Succeeded\",\"storagesku\":\"s-storagesku\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}",
