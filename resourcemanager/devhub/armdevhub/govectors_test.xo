test "Go's VersionedTemplateClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_versioned_template_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"parameters\":[{\"default\":{\"referenceParameter\":\"s-referenceparameter\",\"value\":\"s-value\"},\"description\":\"s-description\",\"name\":\"s-name\",\"parameterKind\":\"s-parameterkind\",\"parameterType\":\"s-parametertype\",\"required\":true}],\"templateType\":\"s-templatetype\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VersionedTemplateClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", VersionedTemplateClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_versioned_template_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_21)
}

