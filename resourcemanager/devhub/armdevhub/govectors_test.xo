test "Go's WorkflowClient.UpdateTags" {
  let f = gv_new_fake(os.net)
  let c = new_workflow_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"artifactGenerationProperties\":{\"appName\":\"s-appname\",\"builderVersion\":\"s-builderversion\",\"dockerfileGenerationMode\":\"s-dockerfilegenerationmode\",\"dockerfileOutputDirectory\":\"s-dockerfileoutputdirectory\",\"generationLanguage\":\"s-generationlanguage\",\"imageName\":\"s-imagename\",\"imageTag\":\"s-imagetag\",\"languageVersion\":\"s-languageversion\",\"manifestGenerationMode\":\"s-manifestgenerationmode\",\"manifestOutputDirectory\":\"s-manifestoutputdirectory\",\"manifestType\":\"s-manifesttype\",\"namespace\":\"s-namespace\",\"port\":\"s-port\"},\"azurePipelineProfile\":{\"acr\":\"s-acr\",\"armServiceConnection\":\"s-armserviceconnection\",\"authStatus\":\"s-authstatus\",\"build\":{\"dockerBuildContext\":\"s-dockerbuildcontext\",\"dockerfile\":\"s-dockerfile\"},\"clusterId\":\"s-clusterid\",\"deployment\":{\"helmChartPath\":\"s-helmchartpath\",\"helmValues\":\"s-helmvalues\",\"kubeManifestLocations\":[\"s-kubemanifestlocations\"],\"manifestType\":\"s-manifesttype\",\"overrides\":{\"k1\":\"s-overrides\"}},\"lastWorkflowRun\":{\"lastRunAt\":\"2026-11-06T10:00:00Z\",\"succeeded\":true,\"workflowRunStatus\":\"s-workflowrunstatus\",\"workflowRunURL\":\"s-workflowrunurl\"},\"namespace\":\"s-namespace\",\"pullRequest\":{\"prStatus\":\"s-prstatus\",\"prURL\":\"s-prurl\",\"pullNumber\":7},\"repository\":{\"adoOrganization\":\"s-adoorganization\",\"branchName\":\"s-branchname\",\"projectName\":\"s-projectname\",\"repositoryName\":\"s-repositoryname\",\"repositoryOwner\":\"s-repositoryowner\"}},\"githubWorkflowProfile\":{\"acr\":{\"acrRegistryName\":\"s-acrregistryname\",\"acrRepositoryName\":\"s-acrrepositoryname\",\"acrResourceGroup\":\"s-acrresourcegroup\",\"acrSubscriptionId\":\"s-acrsubscriptionid\"},\"aksResourceId\":\"s-aksresourceid\",\"authStatus\":\"s-authstatus\",\"branchName\":\"s-branchname\",\"deploymentProperties\":{\"helmChartPath\":\"s-helmchartpath\",\"helmValues\":\"s-helmvalues\",\"kubeManifestLocations\":[\"s-kubemanifestlocations\"],\"manifestType\":\"s-manifesttype\",\"overrides\":{\"k1\":\"s-overrides\"}},\"dockerBuildContext\":\"s-dockerbuildcontext\",\"dockerfile\":\"s-dockerfile\",\"lastWorkflowRun\":{\"lastRunAt\":\"2026-11-06T10:00:00Z\",\"succeeded\":true,\"workflowRunStatus\":\"s-workflowrunstatus\",\"workflowRunURL\":\"s-workflowrunurl\"},\"namespace\":\"s-namespace\",\"oidcCredentials\":{\"azureClientId\":\"s-azureclientid\",\"azureTenantId\":\"s-azuretenantid\"},\"prStatus\":\"s-prstatus\",\"prURL\":\"s-prurl\",\"pullNumber\":7,\"repositoryName\":\"s-repositoryname\",\"repositoryOwner\":\"s-repositoryowner\"},\"templateWorkflowProfile\":{\"adoProviderProfile\":{\"armServiceConnection\":\"s-armserviceconnection\",\"repository\":{\"adoOrganization\":\"s-adoorganization\",\"branchName\":\"s-branchname\",\"projectName\":\"s-projectname\",\"repositoryName\":\"s-repositoryname\",\"repositoryOwner\":\"s-repositoryowner\"}},\"authStatus\":\"s-authstatus\",\"deploymentTemplate\":{\"destination\":\"s-destination\",\"parameters\":{\"k1\":\"s-parameters\"},\"templateId\":\"s-templateid\"},\"dockerfileTemplate\":{\"destination\":\"s-destination\",\"parameters\":{\"k1\":\"s-parameters\"},\"templateId\":\"s-templateid\"},\"gitHubProviderProfile\":{\"oidcCredentials\":{\"azureClientId\":\"s-azureclientid\",\"azureTenantId\":\"s-azuretenantid\"},\"repository\":{\"branchName\":\"s-branchname\",\"repositoryName\":\"s-repositoryname\",\"repositoryOwner\":\"s-repositoryowner\"}},\"lastWorkflowRun\":{\"lastRunAt\":\"2026-11-06T10:00:00Z\",\"succeeded\":true,\"workflowRunStatus\":\"s-workflowrunstatus\",\"workflowRunURL\":\"s-workflowrunurl\"},\"manifestTemplates\":[{\"destination\":\"s-destination\",\"parameters\":{\"k1\":\"s-parameters\"},\"templateId\":\"s-templateid\"}],\"pullRequest\":{\"prStatus\":\"s-prstatus\",\"prURL\":\"s-prurl\",\"pullNumber\":7},\"repositoryProvider\":\"s-repositoryprovider\",\"work