  gv_note(f, "CALL WorkflowClient.UpdateTags")
  match c.update_tags("id1/ x", "id2/ x", (json.decode_str[TagsObject]("{\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), WorkflowClientUpdateTagsOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_workflow_client_update_tags_response(r)}")
