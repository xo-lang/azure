/// IdentityPatch: Identity in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct IdentityPatch {
  /// Gets or sets the principal id.
  pub principal_id as "principalId,omitempty": json.Patch[Str] = json.Patch.Absent
  /// Gets or sets the tenant id.
  pub tenant_id as "tenantId,omitempty": json.Patch[Str] = json.Patch.Absent
  pub type_ as "type,omitempty": json.Patch[ResourceIdentityType] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: Identity) patch() -> IdentityPatch {
  IdentityPatch{
    type_: match m.type_ {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    principal_id: match m.principal_id {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    tenant_id: match m.tenant_id {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
