fn show_products_client_list_by_catalog_response(r: ProductsClientListByCatalogResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.product_list_result).to_str_lossy()}")
  parts.join(" ")
}

