test "Go's DeploymentsClient.NewListByDeviceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_deployments_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"deployedImages\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"componentId\":\"s-componentid\",\"description\":\"s-description\",\"image\":\"s-image\",\"imageId\":\"s-imageid\",\"imageName\":\"s-imagename\",\"imageType\":\"s-imagetype\",\"provisioningState\":\"Succeeded\",\"regionalDataBoundary\":\"s-regionaldataboundary\",\"uri\":\"s-uri\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"deploymentDateUtc\":\"2026-11-06T10:00:00Z\",\"deploymentId\":\"s-deploymentid\",\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DeploymentsClient.NewListByDeviceGroupPager")
  var pg = c.new_list_by_device_group_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", DeploymentsClientListByDeviceGroupOptions{filter: Some("s-filter"), maxpagesize: Some(7), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_deployments_client_list_by_device_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_19)
}

