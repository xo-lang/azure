  let c = new_time_series_database_connections_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"adxDatabaseName\":\"s-adxdatabasename\",\"adxEndpointUri\":\"s-adxendpointuri\",\"adxRelationshipLifecycleEventsTableName\":\"s-adxrelationshiplifecycleeventstablename\",\"adxResourceId\":\"s-adxresourceid\",\"adxTableName\":\"s-adxtablename\",\"adxTwinLifecycleEventsTableName\":\"s-adxtwinlifecycleeventstablename\",\"connectionType\":\"AzureDataExplorer\",\"eventHubConsumerGroup\":\"s-eventhubconsumergroup\",\"eventHubEndpointUri\":\"s-eventhubendpointuri\",\"eventHubEntityPath\":\"s-eventhubentitypath\",\"eventHubNamespaceResourceId\":\"s-eventhubnamespaceresourceid\",\"identity\":{\"type\":\"s-type\",\"userAssignedIdentity\":\"s-userassignedidentity\"},\"provisioningState\":\"Succeeded\",\"recordPropertyAndItemRemovals\":\"s-recordpropertyanditemremovals\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
