  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"createdTime\":\"2026-11-06T10:00:00Z\",\"hostName\":\"s-hostname\",\"lastUpdatedTime\":\"2026-11-06T10:00:00Z\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
