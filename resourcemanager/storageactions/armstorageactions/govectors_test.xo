  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"finishTime\":\"s-finishtime\",\"objectFailedCount\":\"s-objectfailedcount\",\"objectsOperatedOnCount\":\"s-objectsoperatedoncount\",\"objectsSucceededCount\":\"s-objectssucceededcount\",\"objectsTargetedCount\":\"s-objectstargetedcount\",\"runResult\":\"s-runresult\",\"runStatusEnum\":\"s-runstatusenum\",\"runStatusError\":\"s-runstatuserror\",\"startTime\":\"s-starttime\",\"storageAccountId\":\"s-storageaccountid\",\"summaryReportPath\":\"s-summaryreportpath\",\"taskAssignmentId\":\"s-taskassignmentid\",\"taskId\":\"s-taskid\",\"taskVersion\":\"s-taskversion\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}",
