  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"bootstrapConfiguration\":{\"repository\":{\"authorization\":{\"authorizationType\":\"s-authorizationtype\",\"parameters\":{\"k1\":\"s-parameters\"}},\"defaultBranch\":\"s-defaultbranch\",\"id\":\"s-id\",\"properties\":{\"k1\":\"s-properties\"},\"repositoryType\":\"s-repositorytype\"},\"template\":{\"id\":\"s-id\",\"parameters\":{\"k1\":\"s-parameters\"}}},\"organization\":{\"id\":\"s-id\",\"name\":\"s-name\"},\"pipelineId\":7,\"project\":{\"id\":\"s-id\",\"name\":\"s-name\"}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"bootstrapConfiguration\":{\"repository\":{\"authorization\":{\"authorizationType\":\"s-authorizationtype\",\"parameters\":{\"k1\":\"s-parameters\"}},\"defaultBranch\":\"s-defaultbranch\",\"id\":\"s-id\",\"properties\":{\"k1\":\"s-properties\"},\"repositoryType\":\"s-repositorytype\"},\"template\":{\"id\":\"s-id\",\"parameters\":{\"k1\":\"s-parameters\"}}},\"organization\":{\"id\":\"s-id\",\"name\":\"s-name\"},\"pipelineId\":7,\"project\":{\"id\":\"s-id\",\"name\":\"s-name\"}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}",
]

test "Go's PipelinesClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_pipelines_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"bootstrapConfiguration\":{\"repository\":{\"authorization\":{\"authorizationType\":\"s-authorizationtype\",\"parameters\":{\"k1\":\"s-parameters\"}},\"defaultBranch\":\"s-defaultbranch\",\"id\":\"s-id\",\"properties\":{\"k1\":\"s-properties\"},\"repositoryType\":\"s-repositorytype\"},\"template\":{\"id\":\"s-id\",\"parameters\":{\"k1\":\"s-parameters\"}}},\"organization\":{\"id\":\"s-id\",\"name\":\"s-name\"},\"pipelineId\":7,\"project\":{\"id\":\"s-id\",\"name\":\"s-name\"}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PipelinesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(PipelinesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_pipelines_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_6)
}

fn show_pipelines_client_update_response(r: PipelinesClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.pipeline).to_str_lossy()}")
  parts.join(" ")
}

const GO_7: List[Str] = [
  "CALL PipelinesClient.Update",
  "REQ PATCH https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.DevOps/pipelines/id2%2F%20x?api-version=2019-07-01-preview",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"tags\":{\"k1\":\"s-tags\"}}",
  "  SERVED 200 {\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"bootstrapConfiguration\":{\"repository\":{\"authorization\":{\"authorizationType\":\"s-authorizationtype\",\"parameters\":{\"k1\":\"s-parameters\"}},\"defaultBranch\":\"s-defaultbranch\",\"id\":\"s-id\",\"properties\":{\"k1\":\"s-properties\"},\"repositoryType\":\"s-repositorytype\"},\"template\":{\"id\":\"s-id\",\"parameters\":{\"k1\":\"s-parameters\"}}},\"organization\":{\"id\":\"s-id\",\"name\":\"s-name\"},\"pipelineId\":7,\"project\":{\"id\":\"s-id\",\"name\":\"s-name\"}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}",
  "OUT: body={\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"bootstrapConfiguration\":{\"repository\":{\"authorization\":{\"authorizationType\":\"s-authorizationtype\",\"parameters\":{\"k1\":\"s-parameters\"}},\"defaultBranch\":\"s-defaultbranch\",\"id\":\"s-id\",\"properties\":{\"k1\":\"s-properties\"},\"repositoryType\":\"s-repositorytype\"},\"template\":{\"id\":\"s-id\",\"parameters\":{\"k1\":\"s-parameters\"}}},\"organization\":{\"id\":\"s-id\",\"name\":\"s-name\"},\"pipelineId\":7,\"project\":{\"id\":\"s-id\",\"name\":\"s-name\"}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}",
]

test "Go's PipelinesClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_pipelines_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"bootstrapConfiguration\":{\"repository\":{\"authorization\":{\"authorizationType\":\"s-authorizationtype\",\"parameters\":{\"k1\":\"s-parameters\"}},\"defaultBranch\":\"s-defaultbranch\",\"id\":\"s-id\",\"properties\":{\"k1\":\"s-properties\"},\"repositoryType\":\"s-repositorytype\"},\"template\":{\"id\":\"s-id\",\"parameters\":{\"k1\":\"s-parameters\"}}},\"organization\":{\"id\":\"s-id\",\"name\":\"s-name\"},\"pipelineId\":7,\"project\":{\"id\":\"s-id\",\"name\":\"s-name\"}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL PipelinesClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[PipelineUpdateParameters]("{\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), PipelinesClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_pipelines_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_7)
}
