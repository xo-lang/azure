/// RuntimeNetworkProfilePatch: RuntimeNetworkProfile in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct RuntimeNetworkProfilePatch {
  /// Indicates who manages runtime egress.
  pub egress_mode as "egressMode,omitempty": json.Patch[EgressMode] = json.Patch.Absent
  /// The customer-provided subnet used by the runtime.
  pub subnet_resource_id as "subnetResourceId,omitempty": json.Patch[Str] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: RuntimeNetworkProfile) patch() -> RuntimeNetworkProfilePatch {
  RuntimeNetworkProfilePatch{
    subnet_resource_id: match m.subnet_resource_id {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    egress_mode: match m.egress_mode {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
