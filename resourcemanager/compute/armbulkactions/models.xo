pub const OCCURRENCE_STATE_CANCELLING: OccurrenceState = OccurrenceState("Cancelling")
/// The occurrence has been created.
pub const OCCURRENCE_STATE_CREATED: OccurrenceState = OccurrenceState("Created")
/// One or more of the occurrence operations failed.
pub const OCCURRENCE_STATE_FAILED: OccurrenceState = OccurrenceState("Failed")
/// The scheduled time for the occurrence is being updated.
pub const OCCURRENCE_STATE_RESCHEDULING: OccurrenceState = OccurrenceState("Rescheduling")
/// The occurrence has been scheduled.
pub const OCCURRENCE_STATE_SCHEDULED: OccurrenceState = OccurrenceState("Scheduled")
/// The occurrence operations completed successfully.
pub const OCCURRENCE_STATE_SUCCEEDED: OccurrenceState = OccurrenceState("Succeeded")

/// The values of OccurrenceState this version knows; the service may send others.
pub fn possible_occurrence_state_values() -> List[OccurrenceState] {
  [OCCURRENCE_STATE_CANCELED, OCCURRENCE_STATE_CANCELLING, OCCURRENCE_STATE_CREATED, OCCURRENCE_STATE_FAILED, OCCURRENCE_STATE_RESCHEDULING, OCCURRENCE_STATE_SCHEDULED, OCCURRENCE_STATE_SUCCEEDED]
}

