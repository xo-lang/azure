} derive Json(via: json.Value, to: additional_unattend_content_json, from: parse_additional_unattend_content)

/// AdditionalUnattendContent's named fields, for its JSON.
struct AdditionalUnattendContentKnown {
  component_name as "componentName,omitempty": Str? = None
  content as "content,omitempty": Str? = None
  pass_name as "passName,omitempty": Str? = None
  setting_name as "settingName,omitempty": SettingNames? = None
} derive Json

fn additional_unattend_content_json(x: AdditionalUnattendContent) -> json.Value {
  let known = AdditionalUnattendContentKnown{
    component_name: x.component_name.map(fn(_: Str) -> Str { "Microsoft-Windows-Shell-Setup" }),
    content: x.content,
    pass_name: x.pass_name.map(fn(_: Str) -> Str { "OobeSystem" }),
    setting_name: x.setting_name,
  }
  json.to_value(known)
}

fn parse_additional_unattend_content(v: json.Value) -> AdditionalUnattendContent ! json.DecodeErr {
  let k = json.from_value[AdditionalUnattendContentKnown](v)?
  Ok(AdditionalUnattendContent{
    component_name: k.component_name,
    content: k.content,
    pass_name: k.pass_name,
    setting_name: k.setting_name,
  })
}

