// Generated from the output of a local Go program that calls every
// public method of each client of armbulkactions v0.7.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_bulk_create_client_cancel_response(r: BulkCreateClientCancelResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL BulkCreateClient.BeginCancel",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.Compute/locations/id2%2F%20x/bulkCreate/id3%2F%20x/cancel?api-version=2026-10-06-preview",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 202 ",
  "OUT: error: response is missing polling URL",
]

test "Go's BulkCreateClient.BeginCancel" {
  let f = gv_new_fake(os.net)
  let c = new_bulk_create_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL BulkCreateClient.BeginCancel")
  match c.begin_cancel("id1/ x", "id2/ x", "id3/ x", BulkCreateClientBeginCancelOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_bulk_create_client_cancel_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

fn show_bulk_create_client_create_or_update_response(r: BulkCreateClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.location_based_bulk_create).to_str_lossy()}")
  parts.join(" ")
}

