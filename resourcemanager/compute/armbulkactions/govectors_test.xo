test "Go's BulkCreateClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_bulk_create_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"name\":\"s-name\",\"placement\":{\"excludeZones\":[\"s-excludezones\"],\"includeZones\":[\"s-includezones\"],\"zonePlacementPolicy\":\"s-zoneplacementpolicy\"},\"plan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"promotionCode\":\"s-promotioncode\",\"publisher\":\"s-publisher\",\"version\":\"s-version\"},\"properties\":{\"capacity\":7,\"capacityType\":\"s-capacitytype\",\"computeProfile\":{\"computeApiVersion\":\"s-computeapiversion\",\"extensions\":[{\"name\":\"s-name\"}],\"virtualMachineProfile\":{\"additionalCapabilities\":{\"hibernationEnabled\":true,\"ultraSSDEnabled\":true},\"applicationProfile\":{},\"billingProfile\":{\"maxPrice\":1.5},\"capacityReservation\":{},\"diagnosticsProfile\":{},\"evictionPolicy\":\"s-evictionpolicy\",\"extensionsTimeBudget\":\"s-extensionstimebudget\",\"hardwareProfile\":{\"vmSize\":\"s-vmsize\"},\"licenseType\":\"s-licensetype\",\"networkProfile\":{\"networkApiVersion\":\"s-networkapiversion\"},\"osProfile\":{\"adminPassword\":\"s-adminpassword\",\"adminUsername\":\"s-adminusername\",\"allowExtensionOperations\":true,\"computerName\":\"s-computername\",\"customData\":\"s-customdata\",\"requireGuestProvisionSignal\":true},\"priority\":\"s-priority\",\"scheduledEventsPolicy\":{},\"scheduledEventsProfile\":{},\"securityProfile\":{\"encryptionAtHost\":true,\"securityType\":\"s-securitytype\"},\"storageProfile\":{\"diskControllerType\":\"s-diskcontrollertype\"},\"userData\":\"s-userdata\"}},\"createdTime\":\"2026-11-06T10:00:00Z\",\"executionParameters\":{\"additionalCreateParameters\":{\"k1\":{\"k\":\"v\"}},\"capacityRecommendationParameters\":{\"availabilityZones\":true,\"desiredLocations\":[\"s-desiredlocations\"],\"desiredSizes\":[\"s-desiredsizes\"]},\"retryPolicy\":{\"onFailureAction\":\"s-onfailureaction\",\"retryCount\":7,\"retryWindowInMinutes\":7},\"verifyVmAgentHealth\":true},\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
  gv_note(f, "CALL BulkCreateClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", "id2/ x", BulkCreateClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_bulk_create_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_5)
}

fn show_bulk_create_client_list_by_subscription_response(r: BulkCreateClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.bulk_create_list_result).to_str_lossy()}")
  parts.join(" ")
}

