  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"errorCode\":\"s-errorcode\",\"errorDetails\":\"s-errordetails\",\"operation\":{\"capacityRecommendation\":{\"details\":{\"availabilityZones\":true,\"desiredLocations\":[\"s-desiredlocations\"],\"recommendationRequestedAtUtc\":\"2026-11-06T10:00:00Z\"},\"error\":\"s-error\",\"errorDetails\":\"s-errordetails\",\"status\":\"s-status\"},\"completedAt\":\"2026-11-06T10:00:00Z\",\"deadline\":\"2026-11-06T10:00:00Z\",\"deadlineType\":\"s-deadlinetype\",\"fallbackOperationInfo\":{\"error\":{\"errorCode\":\"s-errorcode\",\"errorDetails\":\"s-errordetails\"},\"lastOpType\":\"s-lastoptype\",\"status\":\"s-status\"},\"opType\":\"s-optype\",\"operationId\":\"s-operationid\",\"resourceId\":\"s-resourceid\",\"resourceNotificationDetails\":{\"resourceContext\":\"s-resourcecontext\"},\"resourceOperationError\":{\"errorCode\":\"s-errorcode\",\"errorDetails\":\"s-errordetails\"},\"retryPolicy\":{\"onFailureAction\":\"s-onfailureaction\",\"retryCount\":7,\"retryWindowInMinutes\":7},\"state\":\"s-state\",\"subscriptionId\":\"s-subscriptionid\",\"timezone\":\"s-timezone\"},\"resourceId\":\"s-resourceid\",\"virtualMachineInfo\":{\"name\":\"s-name\",\"vmSize\":\"s-vmsize\",\"zone\":\"s-zone\"}}]}")
  gv_note(f, "CALL VirtualMachineBulkOperationsClient.NewBulkListOperationErrorsPager")
  var pg = c.new_bulk_list_operation_errors_pager("id1/ x", "id2/ x", VirtualMachineBulkOperationsClientBulkListOperationErrorsOptions{lookback_in_minutes: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_machine_bulk_operations_client_bulk_list_operation_errors_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_47)
}
