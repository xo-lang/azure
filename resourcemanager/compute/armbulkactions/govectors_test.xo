test "Go's BulkCreateCustomClient.BeginCancel" {
  let f = gv_new_fake(os.net)
  let c = new_bulk_create_custom_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL BulkCreateCustomClient.BeginCancel")
  match c.begin_cancel("id1/ x", "id2/ x", "id3/ x", BulkCreateCustomClientBeginCancelOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_bulk_create_custom_client_cancel_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_8)
}

