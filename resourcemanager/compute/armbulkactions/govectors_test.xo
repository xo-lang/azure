test "Go's ScheduledActionsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_scheduled_actions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"actionType\":\"s-actiontype\",\"disabled\":true,\"endTime\":\"2026-11-06T10:00:00Z\",\"notificationSettings\":[{\"destination\":\"s-destination\",\"disabled\":true,\"language\":\"s-language\",\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"resourceType\":\"s-resourcetype\",\"schedule\":{\"deadlineType\":\"s-deadlinetype\",\"executionParameters\":{\"retryPolicy\":{\"onFailureAction\":\"s-onfailureaction\",\"retryCount\":7,\"retryWindowInMinutes\":7}},\"requestedDaysOfTheMonth\":[7],\"requestedMonths\":[\"s-requestedmonths\"],\"requestedWeekDays\":[\"s-requestedweekdays\"],\"scheduledTime\":\"10:00:00\",\"timeZone\":\"s-timezone\"},\"startTime\":\"2026-11-06T10:00:00Z\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ScheduledActionsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ScheduledActionsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_scheduled_actions_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_35)
}

