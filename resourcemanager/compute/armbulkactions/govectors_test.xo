nes\":true,\"desiredLocations\":[\"s-desiredlocations\"],\"desiredSizes\":[\"s-desiredsizes\"]},\"retryPolicy\":{\"onFailureAction\":\"s-onfailureaction\",\"retryCount\":7,\"retryWindowInMinutes\":7},\"verifyVmAgentHealth\":true},\"overridesProfile\":{\"overrides\":[{\"tags\":{\"k1\":\"s-tags\"},\"virtualMachineName\":\"s-virtualmachinename\",\"zone\":\"s-zone\"}],\"virtualMachineNamePrefix\":\"s-virtualmachinenameprefix\"},\"provisioningState\":\"Succeeded\",\"resources\":[{\"virtualMachineInfo\":{\"name\":\"s-name\",\"vmSize\":\"s-vmsize\",\"zone\":\"s-zone\"}}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
  gv_note(f, "CALL BulkCreateCustomClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager("id1/ x", BulkCreateCustomClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_bulk_create_custom_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_14)
}

fn show_bulk_create_custom_client_virtual_machines_get_operation_status_response(r: BulkCreateCustomClientVirtualMachinesGetOperationStatusResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.bulk_create_custom_operation_status_list_result).to_str_lossy()}")
  parts.join(" ")
}

