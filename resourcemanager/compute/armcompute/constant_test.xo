// Go's JSON for models with CONSTANT fields (a one-value enum sealed
// to a string), from a Go program over Go's armcompute/v9 v9.0.0: each
// unset, then set to another value. Go writes a required one always, an
// optional one when set, as its constant whatever the field holds.

use github.com/xo-lang/azure/runtime

/// Where ours still differs from Go's: (Go's line, ours).
const CONST_KNOWN: List[(Str, Str)] = []

test "constant fields encode as Go's" {
  let got = [
    "compute.unattend.unset ${runtime.marshal_json(AdditionalUnattendContent{content: Some("c")}).to_str_lossy()}",
    "compute.unattend.other ${runtime.marshal_json(AdditionalUnattendContent{content: Some("c"), component_name: Some("other"), pass_name: Some("other")}).to_str_lossy()}",
    "compute.usage.unset ${runtime.marshal_json(Usage{limit: Some(3)}).to_str_lossy()}",
    "compute.usage.other ${runtime.marshal_json(Usage{limit: Some(3), unit: Some("other")}).to_str_lossy()}",
  ]
  let want = [
    "compute.unattend.unset {\"content\":\"c\"}",
    "compute.unattend.other {\"componentName\":\"Microsoft-Windows-Shell-Setup\",\"content\":\"c\",\"passName\":\"OobeSystem\"}",
    "compute.usage.unset {\"limit\":3,\"unit\":\"Count\"}",
    "compute.usage.other {\"limit\":3,\"unit\":\"Count\"}",
  ]
  expect(got.len()) == want.len()
  var bad: List[Str] = []
  var i = 0
  while i < want.len() {
    let w = want[i]
    let ours = CONST_KNOWN.filter(fn(p: (Str, Str)) -> Bool { p.0 == w }).get(0).map(fn(p: (Str, Str)) -> Str { p.1 }) ?? w
    if got[i] != ours {
      bad.push("want: ${ours}\n  got:  ${got[i]}")
    }
    i += 1
  }
  expect(bad.join("\n")) == ""
}
