/// Extension Properties.
pub struct CloudServiceExtensionProperties {
  /// The name of the extension handler publisher.
  pub publisher as "publisher,omitempty": Str? = None
  /// Specifies the type of the extension.
  pub type_ as "type,omitempty": Str? = None
  /// Specifies the version of the extension. Specifies the version of the extension. If this element is not specified or an asterisk (*) is used as the value, the latest version of the extension is used. If the value is specified with a major version number and an asterisk as the minor version number (X.), the latest minor version of the specified major version is selected. If a major version number and a minor version number are specified (X.Y), the specific extension version is selected. If a version is specified, an auto-upgrade is performed on the role instance.
  pub type_handler_version as "typeHandlerVersion,omitempty": Str? = None
  /// Explicitly specify whether platform can automatically upgrade typeHandlerVersion to higher minor versions when they become available.
  pub auto_upgrade_minor_version as "autoUpgradeMinorVersion,omitempty": Bool? = None
  /// Public settings for the extension. For JSON extensions, this is the JSON settings for the extension. For XML Extension (like RDP), this is the XML setting for the extension.
  pub settings as "settings,omitempty": json.Value? = None
  /// Protected settings for the extension which are encrypted before sent to the role instance.
  pub protected_settings as "protectedSettings,omitempty": json.Value? = None
  pub protected_settings_from_key_vault as "protectedSettingsFromKeyVault,omitempty": CloudServiceVaultAndSecretReference? = None
  /// Tag to force apply the provided public and protected settings. Changing the tag value allows for re-running the extension without changing any of the public or protected settings. If forceUpdateTag is not changed, updates to public or protected settings would still be applied by the handler. If neither forceUpdateTag nor any of public or protected settings change, extension would flow to the role instance with the same sequence-number, and it is up to handler implementation whether to re-run it or not
  pub force_update_tag as "forceUpdateTag,omitempty": Str? = None
  /// The provisioning state, which only appears in the response.
  pub provisioning_state as "provisioningState,omitempty": Str? = None
  /// Optional list of roles to apply this extension. If property is not specified or '*' is specified, extension is applied to all roles in the cloud service.
  pub roles_applied_to as "rolesAppliedTo,omitempty": List[Str]? = None
} derive Json

