  pub auto_upgrade_minor_version as "autoUpgradeMinorVersion,omitempty": json.Patch[Bool] = json.Patch.Absent
  /// Indicates whether the extension should be automatically upgraded by the platform if there is a newer version of the extension available.
  pub enable_automatic_upgrade as "enableAutomaticUpgrade,omitempty": json.Patch[Bool] = json.Patch.Absent
  /// How the extension handler should be forced to update even if the extension configuration has not changed.
  pub force_update_tag as "forceUpdateTag,omitempty": json.Patch[Str] = json.Patch.Absent
  /// The extension can contain either protectedSettings or protectedSettingsFromKeyVault or no protected settings at all.
