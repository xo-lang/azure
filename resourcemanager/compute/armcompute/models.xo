  /// Json formatted public settings for the extension.
  pub settings as "settings,omitempty": json.Patch[json.Value] = json.Patch.Absent
  /// Indicates whether failures stemming from the extension will be suppressed (Operational failures such as not connecting to the VM will not be suppressed regardless of this value). The default is false.
  pub suppress_failures as "suppressFailures,omitempty": json.Patch[Bool] = json.Patch.Absent
  /// Specifies the type of the extension; an example is "CustomScriptExtension".
  pub type_ as "type,omitempty": json.Patch[Str] = json.Patch.Absent
  /// Specifies the Major.Minor version of the script handler. Customer is able to specify only the Major.Minor version of an extension, Azure platform will deliver the latest Patch.Hotfix version in the Major.Minor series.
  pub type_handler_version as "typeHandlerVersion,omitempty": json.Patch[Str] = json.Patch.Absent
} derive Json

