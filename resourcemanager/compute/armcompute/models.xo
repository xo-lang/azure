/// The sku name.
pub type DiskStorageAccountTypes struct(Str)
/// Standard HDD locally redundant storage. Best for backup, non-critical, and infrequent access.
pub const DISK_STORAGE_ACCOUNT_TYPES_STANDARD_LRS: DiskStorageAccountTypes = DiskStorageAccountTypes("Standard_LRS")
/// Premium SSD locally redundant storage. Best for production and performance sensitive workloads.
pub const DISK_STORAGE_ACCOUNT_TYPES_PREMIUM_LRS: DiskStorageAccountTypes = DiskStorageAccountTypes("Premium_LRS")
/// Standard SSD locally redundant storage. Best for web servers, lightly used enterprise applications and dev/test.
pub const DISK_STORAGE_ACCOUNT_TYPES_STANDARD_SSD_LRS: DiskStorageAccountTypes = DiskStorageAccountTypes("StandardSSD_LRS")
/// Ultra SSD locally redundant storage. Best for IO-intensive workloads such as SAP HANA, top tier databases (for example, SQL, Oracle), and other transaction-heavy workloads.
pub const DISK_STORAGE_ACCOUNT_TYPES_ULTRA_SSD_LRS: DiskStorageAccountTypes = DiskStorageAccountTypes("UltraSSD_LRS")
/// Premium SSD zone redundant storage. Best for the production workloads that need storage resiliency against zone failures.
pub const DISK_STORAGE_ACCOUNT_TYPES_PREMIUM_ZRS: DiskStorageAccountTypes = DiskStorageAccountTypes("Premium_ZRS")
/// Standard SSD zone redundant storage. Best for web servers, lightly used enterprise applications and dev/test that need storage resiliency against zone failures.
pub const DISK_STORAGE_ACCOUNT_TYPES_STANDARD_SSD_ZRS: DiskStorageAccountTypes = DiskStorageAccountTypes("StandardSSD_ZRS")
/// Premium SSD v2 locally redundant storage. Best for production and performance-sensitive workloads that consistently require low latency and high IOPS and throughput.
pub const DISK_STORAGE_ACCOUNT_TYPES_PREMIUM_V2_LRS: DiskStorageAccountTypes = DiskStorageAccountTypes("PremiumV2_LRS")

/// The values of DiskStorageAccountTypes this version knows; the service may send others.
pub fn possible_disk_storage_account_types_values() -> List[DiskStorageAccountTypes] {
  [DISK_STORAGE_ACCOUNT_TYPES_STANDARD_LRS, DISK_STORAGE_ACCOUNT_TYPES_PREMIUM_LRS, DISK_STORAGE_ACCOUNT_TYPES_STANDARD_SSD_LRS, DISK_STORAGE_ACCOUNT_TYPES_ULTRA_SSD_LRS, DISK_STORAGE_ACCOUNT_TYPES_PREMIUM_ZRS, DISK_STORAGE_ACCOUNT_TYPES_STANDARD_SSD_ZRS, DISK_STORAGE_ACCOUNT_TYPES_PREMIUM_V2_LRS]
}

