pub type DiskCreateOption struct(Str)
/// Disk will be attached to a VM.
pub const DISK_CREATE_OPTION_ATTACH: DiskCreateOption = DiskCreateOption("Attach")
/// Create a new disk or snapshot by copying from a disk or snapshot specified by the given sourceResourceId.
pub const DISK_CREATE_OPTION_COPY: DiskCreateOption = DiskCreateOption("Copy")
/// Create a new disk by exporting from elastic san volume snapshot
pub const DISK_CREATE_OPTION_COPY_FROM_SAN_SNAPSHOT: DiskCreateOption = DiskCreateOption("CopyFromSanSnapshot")
/// Create a new disk by using a deep copy process, where the resource creation is considered complete only after all data has been copied from the source.
pub const DISK_CREATE_OPTION_COPY_START: DiskCreateOption = DiskCreateOption("CopyStart")
/// Create an empty data disk of a size given by diskSizeGB.
pub const DISK_CREATE_OPTION_EMPTY: DiskCreateOption = DiskCreateOption("Empty")
/// Create a new disk from a platform image specified by the given imageReference or galleryImageReference.
pub const DISK_CREATE_OPTION_FROM_IMAGE: DiskCreateOption = DiskCreateOption("FromImage")
/// Create a disk by importing from a blob specified by a sourceUri in a storage account specified by storageAccountId.
pub const DISK_CREATE_OPTION_IMPORT: DiskCreateOption = DiskCreateOption("Import")
/// Similar to Import create option. Create a new Trusted Launch VM or Confidential VM supported disk by importing additional blobs for VM guest state specified by securityDataUri and VM metadata specified by securityMetadataUri in storage account specified by storageAccountId. The VM metadata is optional and only required for certain Confidential VM configurations and not required for Trusted Launch VM.
pub const DISK_CREATE_OPTION_IMPORT_SECURE: DiskCreateOption = DiskCreateOption("ImportSecure")
/// Create a new disk by copying from a backup recovery point.
pub const DISK_CREATE_OPTION_RESTORE: DiskCreateOption = DiskCreateOption("Restore")
/// Create a new disk by obtaining a write token and using it to directly upload the contents of the disk.
pub const DISK_CREATE_OPTION_UPLOAD: DiskCreateOption = DiskCreateOption("Upload")
/// Similar to Upload create option. Create a new Trusted Launch VM or Confidential VM supported disk and upload using write token in disk, VM guest state and VM metadata. The VM metadata is optional and only required for certain Confidential VM configurations and not required for Trusted Launch VM.
pub const DISK_CREATE_OPTION_UPLOAD_PREPARED_SECURE: DiskCreateOption = DiskCreateOption("UploadPreparedSecure")

