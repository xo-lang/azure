/// Specifies the resilient VM deletion status for the virtual machine.
pub type ResilientVMDeletionStatus struct(Str)
pub const RESILIENT_VM_DELETION_STATUS_ENABLED: ResilientVMDeletionStatus = ResilientVMDeletionStatus("Enabled")
pub const RESILIENT_VM_DELETION_STATUS_DISABLED: ResilientVMDeletionStatus = ResilientVMDeletionStatus("Disabled")
pub const RESILIENT_VM_DELETION_STATUS_IN_PROGRESS: ResilientVMDeletionStatus = ResilientVMDeletionStatus("InProgress")
pub const RESILIENT_VM_DELETION_STATUS_FAILED: ResilientVMDeletionStatus = ResilientVMDeletionStatus("Failed")

/// The values of ResilientVMDeletionStatus this version knows; the service may send others.
pub fn possible_resilient_vm_deletion_status_values() -> List[ResilientVMDeletionStatus] {
  [RESILIENT_VM_DELETION_STATUS_ENABLED, RESILIENT_VM_DELETION_STATUS_DISABLED, RESILIENT_VM_DELETION_STATUS_IN_PROGRESS, RESILIENT_VM_DELETION_STATUS_FAILED]
}

/// Specifies the detach behavior to be used while detaching a disk or which is already in the process of detachment from the virtual machine. Supported values are: **ForceDetach.** detachOption: **ForceDetach** is applicable only for managed data disks. If a previous detachment attempt of the data disk did not complete due to an unexpected failure from the virtual machine and the disk is still not released then use force-detach as a last resort option to detach the disk forcibly from the VM. All writes might not have been flushed when using this detach behavior. To force-detach a data disk update toBeDetached to 'true' along with setting detachOption: 'ForceDetach'.
