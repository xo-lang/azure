  /// Specifies additional base-64 encoded XML formatted information that can be included in the Unattend.xml file, which is used by Windows Setup.
  pub additional_unattend_content as "additionalUnattendContent,omitempty": List[AdditionalUnattendContent]? = None
  /// Indicates whether Automatic Updates is enabled for the Windows virtual machine. Default value is true. For virtual machine scale sets, this property can be updated and updates will take effect on OS reprovisioning.
  pub enable_automatic_updates as "enableAutomaticUpdates,omitempty": Bool? = None
  /// Indicates whether VMAgent Platform Updates are enabled for the Windows Virtual Machine.
  pub enable_vm_agent_platform_updates as "enableVMAgentPlatformUpdates,omitempty": Bool? = None
  /// [Preview Feature] Specifies settings related to VM Guest Patching on Windows.
  pub patch_settings as "patchSettings,omitempty": PatchSettings? = None
  /// Indicates whether virtual machine agent should be provisioned on the virtual machine. When this property is not specified in the request body, it is set to true by default. This will ensure that VM Agent is installed on the VM so that extensions can be added to the VM later.
  pub provision_vm_agent as "provisionVMAgent,omitempty": Bool? = None
  /// Specifies the time zone of the virtual machine. e.g. "Pacific Standard Time". Possible values can be [TimeZoneInfo.Id](https://docs.microsoft.com/dotnet/api/system.timezoneinfo.id?#System_TimeZoneInfo_Id) value from time zones returned by [TimeZoneInfo.GetSystemTimeZones](https://docs.microsoft.com/dotnet/api/system.timezoneinfo.getsystemtimezones).
  pub time_zone as "timeZone,omitempty": Str? = None
  /// Specifies the Windows Remote Management listeners. This enables remote Windows PowerShell.
  pub win_rm as "winRM,omitempty": WinRMConfiguration? = None
} derive Json

