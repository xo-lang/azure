  /// Specifies the storage account type for the managed disk. NOTE: UltraSSD_LRS can only be used with data disks, it cannot be used with OS Disk.
  pub storage_account_type as "storageAccountType,omitempty": StorageAccountTypes? = None
  /// Specifies the customer managed disk encryption set resource id for the managed disk.
  pub disk_encryption_set as "diskEncryptionSet,omitempty": DiskEncryptionSetParameters? = None
  /// Specifies the security profile for the managed disk.
  pub security_profile as "securityProfile,omitempty": VMDiskSecurityProfile? = None
} derive Json

/// Describes a virtual machine scale set operating system disk.
pub struct VirtualMachineScaleSetOSDisk {
  /// The disk name.
  pub name as "name,omitempty": Str? = None
  /// Specifies the caching requirements. Possible values are: **None,** **ReadOnly,** **ReadWrite.** The default values are: **None for Standard storage. ReadOnly for Premium storage.**
  pub caching as "caching,omitempty": CachingTypes? = None
  /// Specifies whether writeAccelerator should be enabled or disabled on the disk.
  pub write_accelerator_enabled as "writeAcceleratorEnabled,omitempty": Bool? = None
  /// Specifies how the virtual machines in the scale set should be created. The only allowed value is: **FromImage.** This value is used when you are using an image to create the virtual machine. If you are using a platform image, you also use the imageReference element described above. If you are using a marketplace image, you  also use the plan element previously described.
  pub create_option as "createOption,omitempty": DiskCreateOptionTypes? = None
  /// Specifies the ephemeral disk Settings for the operating system disk used by the virtual machine scale set.
  pub diff_disk_settings as "diffDiskSettings,omitempty": DiffDiskSettings? = None
  /// Specifies the size of an empty data disk in gigabytes. This element can be used to overwrite the size of the disk in a virtual machine image. The property 'diskSizeGB' is the number of bytes x 1024^3 for the disk and the value cannot be larger than 1023.
  pub disk_size_gb as "diskSizeGB,omitempty": Int? = None
  /// This property allows you to specify the type of the OS that is included in the disk if creating a VM from user-image or a specialized VHD. Possible values are: **Windows,** **Linux.**
  pub os_type as "osType,omitempty": OperatingSystemTypes? = None
  /// Specifies information about the unmanaged user image to base the scale set on.
  pub image as "image,omitempty": VirtualHardDisk? = None
  /// Specifies the container urls that are used to store operating system disks for the scale set.
  pub vhd_containers as "vhdContainers,omitempty": List[Str]? = None
  /// The managed disk parameters.
  pub managed_disk as "managedDisk,omitempty": VirtualMachineScaleSetManagedDiskParameters? = None
  /// Specifies whether OS Disk should be deleted or detached upon VMSS Flex deletion (This feature is available for VMSS with Flexible OrchestrationMode only). <br><br> Possible values: <br><br> **Delete** If this value is used, the OS disk is deleted when VMSS Flex VM is deleted.<br><br> **Detach** If this value is used, the OS disk is retained after VMSS Flex VM is deleted. <br><br> The default value is set to **Delete**. For an Ephemeral OS Disk, the default value is set to **Delete**. User cannot change the delete option for Ephemeral OS Disk.
  pub delete_option as "deleteOption,omitempty": DiskDeleteOptionTypes? = None
} derive Json

/// Describes a virtual machine scale set data disk.
pub struct VirtualMachineScaleSetDataDisk {
  /// The disk name.
  pub name as "name,omitempty": Str? = None
  /// Specifies the logical unit number of the data disk. This value is used to identify data disks within the VM and therefore must be unique for each data disk attached to a VM.
  pub lun as "lun,omitempty": Int? = None
  /// Specifies the caching requirements. Possible values are: **None,** **ReadOnly,** **ReadWrite.** The default values are: **None for Standard storage. ReadOnly for Premium storage.**
  pub caching as "caching,omitempty": CachingTypes? = None
  /// Specifies whether writeAccelerator should be enabled or disabled on the disk.
  pub write_accelerator_enabled as "writeAcceleratorEnabled,omitempty": Bool? = None
  /// The create option.
  pub create_option as "createOption,omitempty": DiskCreateOptionTypes? = None
  /// Specifies the size of an empty data disk in gigabytes. This element can be used to overwrite the size of the disk in a virtual machine image. The property diskSizeGB is the number of bytes x 1024^3 for the disk and the value cannot be larger than 1023.
  pub disk_size_gb as "diskSizeGB,omitempty": Int? = None
  /// The managed disk parameters.
  pub managed_disk as "managedDisk,omitempty": VirtualMachineScaleSetManagedDiskParameters? = None
  /// Specifies the Read-Write IOPS for the managed disk. Should be used only when StorageAccountType is UltraSSD_LRS. If not specified, a default value would be assigned based on diskSizeGB.
  pub disk_iops_read_write as "diskIOPSReadWrite,omitempty": Int? = None
  /// Specifies the bandwidth in MB per second for the managed disk. Should be used only when StorageAccountType is UltraSSD_LRS. If not specified, a default value would be assigned based on diskSizeGB.
  pub disk_m_bps_read_write as "diskMBpsReadWrite,omitempty": Int? = None
  /// Specifies whether data disk should be deleted or detached upon VMSS Flex deletion (This feature is available for VMSS with Flexible OrchestrationMode only).<br><br> Possible values: <br><br> **Delete** If this value is used, the data disk is deleted when the VMSS Flex VM is deleted.<br><br> **Detach** If this value is used, the data disk is retained after VMSS Flex VM is deleted.<br><br> The default value is set to **Delete**.
  pub delete_option as "deleteOption,omitempty": DiskDeleteOptionTypes? = None
} derive Json

