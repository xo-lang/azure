/// This enumerates the possible state of the disk.
pub type DiskState struct(Str)
/// The disk is not being used and can be attached to a VM.
pub const DISK_STATE_UNATTACHED: DiskState = DiskState("Unattached")
/// The disk is currently attached to a running VM.
pub const DISK_STATE_ATTACHED: DiskState = DiskState("Attached")
/// The disk is attached to a stopped-deallocated VM.
pub const DISK_STATE_RESERVED: DiskState = DiskState("Reserved")
/// The disk is attached to a VM which is in hibernated state.
pub const DISK_STATE_FROZEN: DiskState = DiskState("Frozen")
/// The disk currently has an Active SAS Uri associated with it.
pub const DISK_STATE_ACTIVE_SAS: DiskState = DiskState("ActiveSAS")
/// The disk is attached to a VM in hibernated state and has an active SAS URI associated with it.
pub const DISK_STATE_ACTIVE_SAS_FROZEN: DiskState = DiskState("ActiveSASFrozen")
/// A disk is ready to be created by upload by requesting a write token.
pub const DISK_STATE_READY_TO_UPLOAD: DiskState = DiskState("ReadyToUpload")
/// A disk is created for upload and a write token has been issued for uploading to it.
pub const DISK_STATE_ACTIVE_UPLOAD: DiskState = DiskState("ActiveUpload")

/// The values of DiskState this version knows; the service may send others.
pub fn possible_disk_state_values() -> List[DiskState] {
  [DISK_STATE_UNATTACHED, DISK_STATE_ATTACHED, DISK_STATE_RESERVED, DISK_STATE_FROZEN, DISK_STATE_ACTIVE_SAS, DISK_STATE_ACTIVE_SAS_FROZEN, DISK_STATE_READY_TO_UPLOAD, DISK_STATE_ACTIVE_UPLOAD]
}

/// The type of key used to encrypt the data of the disk.
pub type EncryptionType struct(Str)
/// Disk is encrypted at rest with Platform managed key. It is the default encryption type. This is not a valid encryption type for disk encryption sets.
pub const ENCRYPTION_TYPE_ENCRYPTION_AT_REST_WITH_PLATFORM_KEY: EncryptionType = EncryptionType("EncryptionAtRestWithPlatformKey")
