/// Disk resource properties.
pub struct DiskProperties {
  /// The time when the disk was created.
  pub time_created as "timeCreated,omitempty": azcore.DateTime? = None
  /// The Operating System type.
  pub os_type as "osType,omitempty": OperatingSystemTypes? = None
  /// The hypervisor generation of the Virtual Machine. Applicable to OS disks only.
  pub hyper_v_generation as "hyperVGeneration,omitempty": HyperVGeneration? = None
  /// Purchase plan information for the the image from which the OS disk was created. E.g. - {name: 2019-Datacenter, publisher: MicrosoftWindowsServer, product: WindowsServer}
  pub purchase_plan as "purchasePlan,omitempty": DiskPurchasePlan? = None
  /// List of supported capabilities for the image from which the OS disk was created.
  pub supported_capabilities as "supportedCapabilities,omitempty": SupportedCapabilities? = None
  /// Disk source information. CreationData information cannot be changed after the disk has been created.
  pub creation_data as "creationData,omitempty": CreationData? = None
  /// If creationData.createOption is Empty, this field is mandatory and it indicates the size of the disk to create. If this field is present for updates or creation with other options, it indicates a resize. Resizes are only allowed if the disk is not attached to a running VM, and can only increase the disk's size.
  pub disk_size_gb as "diskSizeGB,omitempty": Int? = None
  /// The size of the disk in bytes. This field is read only.
  pub disk_size_bytes as "diskSizeBytes,omitempty": Int? = None
  /// Unique Guid identifying the resource.
  pub unique_id as "uniqueId,omitempty": Str? = None
  /// Encryption settings collection used for Azure Disk Encryption, can contain multiple encryption settings per disk or snapshot.
  pub encryption_settings_collection as "encryptionSettingsCollection,omitempty": EncryptionSettingsCollection? = None
  /// The disk provisioning state.
  pub provisioning_state as "provisioningState,omitempty": Str? = None
  /// The number of IOPS allowed for this disk; only settable for UltraSSD disks. One operation can transfer between 4k and 256k bytes.
  pub disk_iops_read_write as "diskIOPSReadWrite,omitempty": Int? = None
  /// The bandwidth allowed for this disk; only settable for UltraSSD disks. MBps means millions of bytes per second - MB here uses the ISO notation, of powers of 10.
  pub disk_m_bps_read_write as "diskMBpsReadWrite,omitempty": Int? = None
  /// The total number of IOPS that will be allowed across all VMs mounting the shared disk as ReadOnly. One operation can transfer between 4k and 256k bytes.
  pub disk_iops_read_only as "diskIOPSReadOnly,omitempty": Int? = None
  /// The total throughput (MBps) that will be allowed across all VMs mounting the shared disk as ReadOnly. MBps means millions of bytes per second - MB here uses the ISO notation, of powers of 10.
  pub disk_m_bps_read_only as "diskMBpsReadOnly,omitempty": Int? = None
  /// The state of the disk.
  pub disk_state as "diskState,omitempty": DiskState? = None
  /// Encryption property can be used to encrypt data at rest with customer managed keys or platform managed keys.
  pub encryption as "encryption,omitempty": Encryption? = None
  /// The maximum number of VMs that can attach to the disk at the same time. Value greater than one indicates a disk that can be mounted on multiple VMs at the same time.
  pub max_shares as "maxShares,omitempty": Int? = None
  /// Details of the list of all VMs that have the disk attached. maxShares should be set to a value greater than one for disks to allow attaching them to multiple VMs.
  pub share_info as "shareInfo,omitempty": List[ShareInfoElement]? = None
  pub network_access_policy as "networkAccessPolicy,omitempty": NetworkAccessPolicy? = None
  /// ARM id of the DiskAccess resource for using private endpoints on disks.
  pub disk_access_id as "diskAccessId,omitempty": Str? = None
  /// Latest time when bursting was last enabled on a disk.
  pub bursting_enabled_time as "burstingEnabledTime,omitempty": azcore.DateTime? = None
  /// Performance tier of the disk (e.g, P4, S10) as described here: https://azure.microsoft.com/en-us/pricing/details/managed-disks/. Does not apply to Ultra disks.
  pub tier as "tier,omitempty": Str? = None
  /// Set to true to enable bursting beyond the provisioned performance target of the disk. Bursting is disabled by default. Does not apply to Ultra disks.
  pub bursting_enabled as "burstingEnabled,omitempty": Bool? = None
  /// Properties of the disk for which update is pending.
  pub property_updates_in_progress as "propertyUpdatesInProgress,omitempty": PropertyUpdatesInProgress? = None
  /// Indicates the OS on a disk supports hibernation.
  pub supports_hibernation as "supportsHibernation,omitempty": Bool? = None
  /// Contains the security related information for the resource.
  pub security_profile as "securityProfile,omitempty": DiskSecurityProfile? = None
  /// Percentage complete for the background copy when a resource is created via the CopyStart operation.
  pub completion_percent as "completionPercent,omitempty": Float? = None
  pub public_network_access as "publicNetworkAccess,omitempty": PublicNetworkAccess? = None
  pub data_access_auth_mode as "dataAccessAuthMode,omitempty": DataAccessAuthMode? = None
  /// Setting this property to true improves reliability and performance of data disks that are frequently (more than 5 times a day) by detached from one virtual machine and attached to another. This property should not be set for disks that are not detached and attached frequently as it causes the disks to not align with the fault domain of the virtual machine.
  pub optimized_for_frequent_attach as "optimizedForFrequentAttach,omitempty": Bool? = None
  /// The UTC time when the ownership state of the disk was last changed i.e., the time the disk was last attached or detached from a VM or the time when the VM to which the disk was attached was deallocated or started.
  pub last_ownership_update_time as "LastOwnershipUpdateTime,omitempty": azcore.DateTime? = None
} derive Json

