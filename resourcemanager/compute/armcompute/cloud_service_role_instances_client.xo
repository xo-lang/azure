    return Err(azcore.CallErr.InvalidInput("parameter client.subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/x-rdp")]
  q.add("api-version", "2024-11-04")
  let qs = q.encode()
  Ok(policy.Request{method: "GET", url: "${runtime.join_paths(c.setup.endpoint, path)}${if qs == "" { "" } else { "?${qs}" }}", headers: headers, body: b""})
}

