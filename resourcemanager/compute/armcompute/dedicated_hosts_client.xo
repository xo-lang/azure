  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.Compute/hostGroups/{hostGroupName}/hosts/{hostName}/restart"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if host_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter hostGroupName cannot be empty"))
  }
  path = path.replace("{hostGroupName}", url.path_escape(host_group_name))
  if host_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter hostName cannot be empty"))
  }
  path = path.replace("{hostName}", url.path_escape(host_name))
  var q = url.values()
  var headers: List[(Str, Str)] = []
  q.add("api-version", API_VERSION)
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: b""})
}

/// Restart the dedicated host. The operation will complete successfully once the dedicated host has restarted and is running. To determine the health of VMs deployed on the dedicated host after the restart check the Resource Health Center in the Azure Portal. Please refer to https://docs.microsoft.com/azure/service-health/resource-health-overview for more details.
pub fn (c: DedicatedHostsClient[fx]) begin_restart(resource_group_name: Str, host_group_name: Str, host_name: Str, options: DedicatedHostsClientBeginRestartOptions = DedicatedHostsClientBeginRestartOptions{}) -> runtime.Poller[DedicatedHostsClientRestartResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "DedicatedHostsClientRestartResponse", fn(r: http.Response) -> DedicatedHostsClientRestartResponse ! Str { dedicated_hosts_restart_handle(r) }, traced: true)
  }
  let sp = runtime.start_span({}, "DedicatedHostsClient.BeginRestart", c.setup.pipeline.tracer)
  let req = c.restart_create_request(resource_group_name, host_group_name, host_name, options) ?? e => return Err(sp.fail(e))
  let resp = c.setup.pipeline.send(sp.on(req)) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![200].contains(resp.status) {
    return Err(sp.close(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  sp.end()
  runtime.new_poller(c.setup.pipeline, req, resp, "", "DedicatedHostsClientRestartResponse", fn(r: http.Response) -> DedicatedHostsClientRestartResponse ! Str { dedicated_hosts_restart_handle(r) }, traced: true)
}
