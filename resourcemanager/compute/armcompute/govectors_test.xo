  let c = new_virtual_machine_extensions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"autoUpgradeMinorVersion\":true,\"enableAutomaticUpgrade\":true,\"forceUpdateTag\":\"s-forceupdatetag\",\"instanceView\":{\"name\":\"s-name\",\"statuses\":[{\"code\":\"s-code\",\"displayStatus\":\"s-displaystatus\",\"level\":\"s-level\",\"message\":\"s-message\",\"time\":\"2026-11-06T10:00:00Z\"}],\"substatuses\":[{\"code\":\"s-code\",\"displayStatus\":\"s-displaystatus\",\"level\":\"s-level\",\"message\":\"s-message\",\"time\":\"2026-11-06T10:00:00Z\"}],\"type\":\"s-type\",\"typeHandlerVersion\":\"s-typehandlerversion\"},\"protectedSettings\":{\"k\":\"v\"},\"protectedSettingsFromKeyVault\":{\"secretUrl\":\"s-secreturl\",\"sourceVault\":{\"id\":\"s-id\"}},\"provisionAfterExtensions\":[\"s-provisionafterextensions\"],\"provisioningState\":\"Succeeded\",\"publisher\":\"s-publisher\",\"settings\":{\"k\":\"v\"},\"suppressFailures\":true,\"type\":\"s-type\",\"typeHandlerVersion\":\"s-typehandlerversion\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL VirtualMachineExtensionsClient.BeginUpdate")
  match c.begin_update("id1/ x", "id2/ x", "id3/ x", (json.decode_str[VirtualMachineExtensionUpdate]("{\"properties\":{\"autoUpgradeMinorVersion\":true,\"enableAutomaticUpgrade\":true,\"forceUpdateTag\":\"s-forceupdatetag\",\"protectedSettings\":{\"k\":\"v\"},\"protectedSettingsFromKeyVault\":{\"secretUrl\":\"s-secreturl\",\"sourceVault\":{\"id\":\"s-id\"}},\"publisher\":\"s-publisher\",\"settings\":{\"k\":\"v\"},\"suppressFailures\":true,\"type\":\"s-type\",\"typeHandlerVersion\":\"s-typehandlerversion\"},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), VirtualMachineExtensionsClientBeginUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_virtual_machine_extensions_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_188)
}

