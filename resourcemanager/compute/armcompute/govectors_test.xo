test "Go's RestorePointCollectionsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_restore_point_collections_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"instantAccess\":true,\"provisioningState\":\"Succeeded\",\"restorePointCollectionId\":\"s-restorepointcollectionid\",\"restorePoints\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"consistencyMode\":\"s-consistencymode\",\"instantAccessDurationMinutes\":7,\"provisioningState\":\"Succeeded\",\"timeCreated\":\"2026-11-06T10:00:00Z\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"source\":{\"id\":\"s-id\",\"location\":\"s-location\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RestorePointCollectionsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", RestorePointCollectionsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_restore_point_collections_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_144)
}

