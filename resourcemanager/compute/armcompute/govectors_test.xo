  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.Compute/virtualMachineScaleSets/id2%2F%20x/approveRollingUpgrade?api-version=2026-04-01",
  "  H authorization=Bearer tok | content-type=application/json",
  "  B {\"instanceIds\":[\"s-instanceids\"]}",
  "  SERVED 202 ",
  "OUT: error: response is missing polling URL",
]

test "Go's VirtualMachineScaleSetsClient.BeginApproveRollingUpgrade" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_machine_scale_sets_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL VirtualMachineScaleSetsClient.BeginApproveRollingUpgrade")
  match c.begin_approve_rolling_upgrade("id1/ x", "id2/ x", VirtualMachineScaleSetsClientBeginApproveRollingUpgradeOptions{vm_instance_ids: Some((json.decode_str[VirtualMachineScaleSetVMInstanceIDs]("{\"instanceIds\":[\"s-instanceids\"]}") ?? e => fault("${e}")))}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_virtual_machine_scale_sets_client_approve_rolling_upgrade_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_255)
}

fn show_virtual_machine_scale_sets_client_create_or_update_response(r: VirtualMachineScaleSetsClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.virtual_machine_scale_set).to_str_lossy()}")
  parts.join(" ")
}

