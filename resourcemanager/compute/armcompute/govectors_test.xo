fn show_virtual_machines_client_retrieve_boot_diagnostics_data_response(r: VirtualMachinesClientRetrieveBootDiagnosticsDataResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.retrieve_boot_diagnostics_data_result).to_str_lossy()}")
  parts.join(" ")
}

