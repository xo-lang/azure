test "Go's DisksClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_disks_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"managedBy\":\"s-managedby\",\"managedByExtended\":[\"s-managedbyextended\"],\"name\":\"s-name\",\"properties\":{\"LastOwnershipUpdateTime\":\"2026-11-06T10:00:00Z\",\"availabilityPolicy\":{\"actionOnDiskDelay\":\"s-actionondiskdelay\"},\"burstingEnabled\":true,\"burstingEnabledTime\":\"2026-11-06T10:00:00Z\",\"completionPercent\":1.5,\"creationData\":{\"createOption\":\"s-createoption\",\"elasticSanResourceId\":\"s-elasticsanresourceid\",\"galleryImageReference\":{\"communityGalleryImageId\":\"s-communitygalleryimageid\",\"id\":\"s-id\",\"lun\":7,\"sharedGalleryImageId\":\"s-sharedgalleryimageid\"},\"imageReference\":{\"communityGalleryImageId\":\"s-communitygalleryimageid\",\"id\":\"s-id\",\"lun\":7,\"sharedGalleryImageId\":\"s-sharedgalleryimageid\"},\"instantAccessDurationMinutes\":7,\"logicalSectorSize\":7,\"performancePlus\":true,\"provisionedBandwidthCopySpeed\":\"s-provisionedbandwidthcopyspeed\",\"securityDataUri\":\"s-securitydatauri\",\"securityMetadataUri\":\"s-securitymetadatauri\",\"sourceResourceId\":\"s-sourceresourceid\",\"sourceUniqueId\":\"s-sourceuniqueid\",\"sourceUri\":\"s-sourceuri\",\"storageAccountId\":\"s-storageaccountid\",\"uploadSizeBytes\":7},\"dataAccessAuthMode\":\"s-dataaccessauthmode\",\"diskAccessId\":\"s-diskaccessid\",\"diskIOPSReadOnly\":7,\"diskIOPSReadWrite\":7,\"diskMBpsReadOnly\":7,\"diskMBpsReadWrite\":7,\"diskSizeBytes\":7,\"diskSizeGB\":7,\"diskState\":\"s-diskstate\",\"encryption\":{\"diskEncryptionSetId\":\"s-diskencryptionsetid\",\"type\":\"s-type\"},\"encryptionSettingsCollection\":{\"enabled\":true,\"encryptionSettings\":[{}],\"encryptionSettingsVersion\":\"s-encryptionsettingsversion\"},\"hyperVGeneration\":\"s-hypervgeneration\",\"maxShares\":7,\"networkAccessPolicy\":\"s-networkaccesspolicy\",\"optimizedForFrequentAttach\":true,\"osType\":\"s-ostype\",\"propertyUpdatesInProgress\":{\"targetTier\":\"s-targettier\"},\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"purchasePlan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"promotionCode\":\"s-promotioncode\",\"publisher\":\"s-publisher\"},\"securityProfile\":{\"confidentialVMVersion\":\"s-confidentialvmversion\",\"secureVMDiskEncryptionSetId\":\"s-securevmdiskencryptionsetid\",\"securityType\":\"s-securitytype\"},\"shareInfo\":[{\"vmUri\":\"s-vmuri\"}],\"supportedCapabilities\":{\"acceleratedNetwork\":true,\"architecture\":\"s-architecture\",\"diskControllerTypes\":\"s-diskcontrollertypes\",\"supportedSecurityOption\":\"s-supportedsecurityoption\"},\"supportsHibernation\":true,\"tier\":\"s-tier\",\"timeCreated\":\"2026-11-06T10:00:00Z\",\"uniqueId\":\"s-uniqueid\"},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
  gv_note(f, "CALL DisksClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", DisksClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_disks_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_69)
}

fn show_disks_client_list_response(r: DisksClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.disk_list).to_str_lossy()}")
  parts.join(" ")
}

