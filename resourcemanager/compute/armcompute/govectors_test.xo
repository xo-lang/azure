  gv_note(f, "CALL GalleriesClient.NewListPager")
  var pg = c.new_list_pager(GalleriesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
