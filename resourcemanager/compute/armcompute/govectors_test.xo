  let c = new_gallery_images_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"allowUpdateImage\":true,\"architecture\":\"s-architecture\",\"description\":\"s-description\",\"disallowed\":{\"diskTypes\":[\"s-disktypes\"]},\"endOfLifeDate\":\"2026-11-06T10:00:00Z\",\"eula\":\"s-eula\",\"features\":[{\"name\":\"s-name\",\"startsAtVersion\":\"s-startsatversion\",\"value\":\"s-value\"}],\"hyperVGeneration\":\"s-hypervgeneration\",\"identifier\":{\"offer\":\"s-offer\",\"publisher\":\"s-publisher\",\"sku\":\"s-sku\"},\"osState\":\"s-osstate\",\"osType\":\"s-ostype\",\"privacyStatementUri\":\"s-privacystatementuri\",\"provisioningState\":\"Succeeded\",\"purchasePlan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"publisher\":\"s-publisher\"},\"recommended\":{\"memory\":{\"max\":7,\"min\":7},\"vCPUs\":{\"max\":7,\"min\":7}},\"releaseNoteUri\":\"s-releasenoteuri\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL GalleryImagesClient.NewListByGalleryPager")
  var pg = c.new_list_by_gallery_pager("id1/ x", "id2/ x", GalleryImagesClientListByGalleryOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_gallery_images_client_list_by_gallery_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_96)
}

