test "Go's GalleriesClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_galleries_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"securityProfile\":{\"secretsProvisioningSettings\":{\"components\":[{\"name\":\"s-name\",\"version\":\"s-version\"}],\"isSupported\":true,\"osName\":\"s-osname\"},\"uefiSettings\":{\"additionalSignatures\":{\"db\":[{\"type\":\"s-type\",\"value\":[\"s-value\"]}],\"dbx\":[{\"type\":\"s-type\",\"value\":[\"s-value\"]}],\"kek\":[{\"type\":\"s-type\",\"value\":[\"s-value\"]}],\"pk\":{\"type\":\"s-type\",\"value\":[\"s-value\"]}},\"signatureTemplateNames\":[\"s-signaturetemplatenames\"]}},\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"identifier\":{\"uniqueName\":\"s-uniquename\"},\"provisioningState\":\"Succeeded\",\"sharingProfile\":{\"communityGalleryInfo\":{\"communityGalleryEnabled\":true,\"eula\":\"s-eula\",\"publicNamePrefix\":\"s-publicnameprefix\",\"publicNames\":[\"s-publicnames\"],\"publisherContact\":\"s-publishercontact\",\"publisherUri\":\"s-publisheruri\"},\"groups\":[{\"type\":\"s-type\"}],\"permissions\":\"s-permissions\"},\"sharingStatus\":{\"aggregatedState\":\"s-aggregatedstate\",\"summary\":[{\"details\":\"s-details\",\"region\":\"s-region\",\"state\":\"s-state\"}]},\"softDeletePolicy\":{\"gracePeriodInDays\":7,\"isSoftDeleteEnabled\":true,\"retentionPeriodInDays\":7}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL GalleriesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", GalleriesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_galleries_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_75)
}

