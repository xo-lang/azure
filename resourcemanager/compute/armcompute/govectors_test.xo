  gv_note(f, "CALL VirtualMachinesClient.RetrieveBootDiagnosticsData")
  match c.retrieve_boot_diagnostics_data("id1/ x", "id2/ x", VirtualMachinesClientRetrieveBootDiagnosticsDataOptions{sas_uri_expiration_time_in_minutes: Some(7)}) {
