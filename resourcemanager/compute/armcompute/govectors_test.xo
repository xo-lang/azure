  "CALL VirtualMachinesClient.RetrieveBootDiagnosticsData",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.Compute/virtualMachines/id2%2F%20x/retrieveBootDiagnosticsData?api-version=2026-04-01&sasUriExpirationTimeInMinutes=7",
