  let f = gv_new_fake(os.net)
  let c = new_images_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"hyperVGeneration\":\"s-hypervgeneration\",\"provisioningState\":\"Succeeded\",\"sourceVirtualMachine\":{\"id\":\"s-id\"},\"storageProfile\":{\"dataDisks\":[{\"blobUri\":\"s-bloburi\",\"caching\":\"s-caching\",\"diskSizeGB\":7,\"lun\":7,\"storageAccountType\":\"s-storageaccounttype\"}],\"osDisk\":{\"blobUri\":\"s-bloburi\",\"caching\":\"s-caching\",\"diskEncryptionSet\":{\"id\":\"s-id\"},\"diskSizeGB\":7,\"managedDisk\":{\"id\":\"s-id\"},\"osState\":\"s-osstate\",\"osType\":\"s-ostype\",\"snapshot\":{\"id\":\"s-id\"},\"storageAccountType\":\"s-storageaccounttype\"},\"zoneResilient\":true}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
