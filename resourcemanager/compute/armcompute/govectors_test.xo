test "Go's AvailabilitySetsClient.BeginConvertToVirtualMachineScaleSet" {
  let f = gv_new_fake(os.net)
  let c = new_availability_sets_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL AvailabilitySetsClient.BeginConvertToVirtualMachineScaleSet")
  match c.begin_convert_to_virtual_machine_scale_set("id1/ x", "id2/ x", AvailabilitySetsClientBeginConvertToVirtualMachineScaleSetOptions{parameters: Some((json.decode_str[ConvertToVirtualMachineScaleSetInput]("{\"virtualMachineScaleSetName\":\"s-virtualmachinescalesetname\"}") ?? e => fault("${e}")))}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_availability_sets_client_convert_to_virtual_machine_scale_set_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

