test "Go's VirtualMachinesClient.NewListAvailableSizesPager" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_machines_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"maxDataDiskCount\":7,\"memoryInMB\":7,\"name\":\"s-name\",\"numberOfCores\":7,\"osDiskSizeInMB\":7,\"resourceDiskSizeInMB\":7}]}")
  gv_note(f, "CALL VirtualMachinesClient.NewListAvailableSizesPager")
  var pg = c.new_list_available_sizes_pager("id1/ x", "id2/ x", VirtualMachinesClientListAvailableSizesOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_machines_client_list_available_sizes_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_305)
}

