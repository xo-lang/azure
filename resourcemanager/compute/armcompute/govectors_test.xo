fn show_virtual_machines_client_list_response(r: VirtualMachinesClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.virtual_machine_list_result).to_str_lossy()}")
  parts.join(" ")
}

