  let f = gv_new_fake(os.net)
  let c = new_operation_status_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"k1\":\"s-properties\"},\"status\":\"s-status\"}")
  gv_note(f, "CALL OperationStatusClient.Get")
  match c.get("id1/ x", "id2/ x", "id3/ x", "id4/ x", "id5/ x", "id6/ x", OperationStatusClientGetOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_operation_status_client_get_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_5)
}
