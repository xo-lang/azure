test "Go's ExtensionsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_extensions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"SystemAssigned\"},\"name\":\"s-name\",\"plan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"promotionCode\":\"s-promotioncode\",\"publisher\":\"s-publisher\",\"version\":\"s-version\"},\"properties\":{\"aksAssignedIdentity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"autoUpgradeMinorVersion\":true,\"configurationProtectedSettings\":{\"k1\":\"s-configurationprotectedsettings\"},\"configurationSettings\":{\"k1\":\"s-configurationsettings\"},\"currentVersion\":\"s-currentversion\",\"customLocationSettings\":{\"k1\":\"s-customlocationsettings\"},\"errorInfo\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"extensionType\":\"s-extensiontype\",\"isSystemExtension\":true,\"packageUri\":\"s-packageuri\",\"provisioningState\":\"Succeeded\",\"releaseTrain\":\"s-releasetrain\",\"scope\":{\"cluster\":{\"releaseNamespace\":\"s-releasenamespace\"},\"namespace\":{\"targetNamespace\":\"s-targetnamespace\"}},\"statuses\":[{\"code\":\"s-code\",\"displayStatus\":\"s-displaystatus\",\"level\":\"s-level\",\"message\":\"s-message\",\"time\":\"s-time\"}],\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ExtensionsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", ExtensionsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_extensions_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_4)
}

