/// RepositoryRefDefinitionPatch: RepositoryRefDefinition in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct RepositoryRefDefinitionPatch {
  /// The git repository branch name to checkout.
  pub branch as "branch,omitempty": json.Patch[Str] = json.Patch.Absent
  /// The commit SHA to checkout. This value must be combined with the branch name to be valid. This takes precedence over semver.
  pub commit as "commit,omitempty": json.Patch[Str] = json.Patch.Absent
  /// The semver range used to match against git repository tags. This takes precedence over tag.
  pub semver as "semver,omitempty": json.Patch[Str] = json.Patch.Absent
  /// The git repository tag name to checkout. This takes precedence over branch.
  pub tag as "tag,omitempty": json.Patch[Str] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: RepositoryRefDefinition) patch() -> RepositoryRefDefinitionPatch {
  RepositoryRefDefinitionPatch{
    branch: match m.branch {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    tag: match m.tag {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    semver: match m.semver {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    commit: match m.commit {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
