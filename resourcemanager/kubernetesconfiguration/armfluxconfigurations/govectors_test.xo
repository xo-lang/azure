  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"azureBlob\":{\"accountKey\":\"s-accountkey\",\"containerName\":\"s-containername\",\"localAuthRef\":\"s-localauthref\",\"managedIdentity\":{\"clientId\":\"s-clientid\"},\"sasToken\":\"s-sastoken\",\"servicePrincipal\":{\"clientCertificate\":\"s-clientcertificate\",\"clientCertificatePassword\":\"s-clientcertificatepassword\",\"clientCertificateSendChain\":true,\"clientId\":\"s-clientid\",\"clientSecret\":\"s-clientsecret\",\"tenantId\":\"s-tenantid\"},\"syncIntervalInSeconds\":7,\"timeoutInSeconds\":7,\"url\":\"s-url\"},\"bucket\":{\"accessKey\":\"s-accesskey\",\"bucketName\":\"s-bucketname\",\"insecure\":true,\"localAuthRef\":\"s-localauthref\",\"syncIntervalInSeconds\":7,\"timeoutInSeconds\":7,\"url\":\"s-url\"},\"complianceState\":\"s-compliancestate\",\"configurationProtectedSettings\":{\"k1\":\"s-configurationprotectedsettings\"},\"errorMessage\":\"s-errormessage\",\"gitRepository\":{\"httpsCACert\":\"s-httpscacert\",\"httpsUser\":\"s-httpsuser\",\"localAuthRef\":\"s-localauthref\",\"provider\":\"s-provider\",\"repositoryRef\":{\"branch\":\"s-branch\",\"commit\":\"s-commit\",\"semver\":\"s-semver\",\"tag\":\"s-tag\"},\"sshKnownHosts\":\"s-sshknownhosts\",\"syncIntervalInSeconds\":7,\"timeoutInSeconds\":7,\"url\":\"s-url\"},\"kustomizations\":{\"k1\":{\"dependsOn\":[\"s-dependson\"],\"force\":true,\"name\":\"s-name\",\"path\":\"s-path\",\"postBuild\":{\"substitute\":{\"k1\":\"s-substitute\"}},\"prune\":true,\"retryIntervalInSeconds\":7,\"syncIntervalInSeconds\":7,\"timeoutInSeconds\":7,\"wait\":true}},\"namespace\":\"s-namespace\",\"ociRepository\":{\"insecure\":true,\"layerSelector\":{\"mediaType\":\"s-mediatype\",\"operation\":\"s-operation\"},\"localAuthRef\":\"s-localauthref\",\"repositoryRef\":{\"digest\":\"s-digest\",\"semver\":\"s-semver\",\"tag\":\"s-tag\"},\"serviceAccountName\":\"s-serviceaccountname\",\"syncIntervalInSeconds\":7,\"timeoutInSeconds\":7,\"tlsConfig\":{\"caCertificate\":\"s-cacertificate\",\"clientCertificate\":\"s-clientcertificate\",\"privateKey\":\"s-privatekey\"},\"url\":\"s-url\",\"useWorkloadIdentity\":true,\"verify\":{\"provider\":\"s-provider\",\"verificationConfig\":{\"k1\":\"s-verificationconfig\"}}},\"provisioningState\":\"Succeeded\",\"reconciliationWaitDuration\":\"s-reconciliationwaitduration\",\"repositoryPublicKey\":\"s-repositorypublickey\",\"scope\":\"s-scope\",\"sourceKind\":\"s-sourcekind\",\"sourceSyncedCommitId\":\"s-sourcesyncedcommitid\",\"sourceUpdatedAt\":\"2026-11-06T10:00:00Z\",\"statusUpdatedAt\":\"2026-11-06T10:00:00Z\",\"statuses\":[{\"appliedBy\":{\"name\":\"s-name\",\"namespace\":\"s-namespace\"},\"complianceState\":\"s-compliancestate\",\"helmReleaseProperties\":{\"failureCount\":7,\"installFailureCount\":7,\"lastRevisionApplied\":7,\"upgradeFailureCount\":7},\"kind\":\"s-kind\",\"name\":\"s-name\",\"namespace\":\"s-namespace\"}],\"suspend\":true,\"waitForReconciliation\":true},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Client.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", ClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_4)
}

fn show_flux_config_operation_status_client_get_response(r: FluxConfigOperationStatusClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_status_result).to_str_lossy()}")
  parts.join(" ")
}

