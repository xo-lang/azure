test "Go's Client.NewClusterListVersionsPager" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"supportedClusterTypes\":[\"s-supportedclustertypes\"],\"unsupportedKubernetesVersions\":{\"appliances\":[{}],\"connectedCluster\":[{}],\"managedCluster\":[{}],\"provisionedCluster\":[{}]},\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Client.NewClusterListVersionsPager")
  var pg = c.new_cluster_list_versions_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", "id5/ x", ClientClusterListVersionsOptions{major_version: Some("s-majorversion"), release_train: Some("s-releasetrain"), show_latest: Some(true)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_cluster_list_versions_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_4)
}

