pub fn (c: Client) cluster_get_version(resource_group_name: Str, cluster_rp: Str, cluster_resource_name: Str, cluster_name: Str, extension_type_name: Str, version_number: Str, options: ClientClusterGetVersionOptions = ClientClusterGetVersionOptions{}) -> ClientClusterGetVersionResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.cluster_get_version_create_request(resource_group_name, cluster_rp, cluster_resource_name, cluster_name, extension_type_name, version_number, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  extension_types_cluster_get_version_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
