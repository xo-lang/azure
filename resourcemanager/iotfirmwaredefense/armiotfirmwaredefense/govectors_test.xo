  let f = gv_new_fake(os.net)
  let c = new_cves_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"component\":{\"componentId\":\"s-componentid\",\"name\":\"s-name\",\"version\":\"s-version\"},\"componentId\":\"s-componentid\",\"componentName\":\"s-componentname\",\"componentVersion\":\"s-componentversion\",\"cveId\":\"s-cveid\",\"cveName\":\"s-cvename\",\"cvssScore\":\"s-cvssscore\",\"cvssScores\":[{\"score\":1.5,\"version\":7}],\"cvssV2Score\":\"s-cvssv2score\",\"cvssV3Score\":\"s-cvssv3score\",\"cvssVersion\":\"s-cvssversion\",\"description\":\"s-description\",\"effectiveCvssScore\":1.5,\"effectiveCvssVersion\":7,\"links\":[{\"href\":\"s-href\",\"label\":\"s-label\"}],\"provisioningState\":\"Succeeded\",\"severity\":\"s-severity\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL CvesClient.NewListByFirmwarePager")
