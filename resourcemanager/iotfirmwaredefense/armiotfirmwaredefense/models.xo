  }
  with_discriminator(json.to_value(known), "summaryType", "Firmware")
}

fn parse_firmware_summary(v: json.Value) -> FirmwareSummary ! json.DecodeErr {
  let k = json.from_value[FirmwareSummaryKnown](v)?
  Ok(FirmwareSummary{
    analysis_time_seconds: k.analysis_time_seconds,
    binary_count: k.binary_count,
    component_count: k.component_count,
    extracted_file_count: k.extracted_file_count,
    extracted_size: k.extracted_size,
    file_size: k.file_size,
    provisioning_state: k.provisioning_state,
    root_file_systems: k.root_file_systems,
    summary_type: k.summary_type,
  })
}

