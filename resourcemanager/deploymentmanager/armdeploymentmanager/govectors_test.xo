  let c = new_steps_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"attributes\":{\"healthyStateDuration\":\"s-healthystateduration\",\"maxElasticDuration\":\"s-maxelasticduration\",\"properties\":{},\"type\":\"REST\",\"waitDuration\":\"s-waitduration\"},\"stepType\":\"HealthCheck\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL StepsClient.Get")
  match c.get("id1/ x", "id2/ x", StepsClientGetOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_steps_client_get_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_25)
}

fn show_steps_client_list_response(r: StepsClientListResponse) -> Str {
  var parts: List[Str] = []
  if !(r.value.is_empty()) {
    parts.push("StepResourceArray=${runtime.marshal_json(r.value).to_str_lossy()}")
  }
  parts.join(" ")
}

const GO_26: List[Str] = [
  "CALL StepsClient.List",
  "REQ GET https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.DeploymentManager/steps?api-version=2019-11-01-preview",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 [{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"attributes\":{\"healthyStateDuration\":\"s-healthystateduration\",\"maxElasticDuration\":\"s-maxelasticduration\",\"properties\":{},\"type\":\"REST\",\"waitDuration\":\"s-waitduration\"},\"stepType\":\"HealthCheck\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]",
  "OUT: StepResourceArray=[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"attributes\":{\"healthyStateDuration\":\"s-healthystateduration\",\"maxElasticDuration\":\"s-maxelasticduration\",\"properties\":{},\"type\":\"REST\",\"waitDuration\":\"s-waitduration\"},\"stepType\":\"HealthCheck\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]",
]

test "Go's StepsClient.List" {
  let f = gv_new_fake(os.net)
  let c = new_steps_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"attributes\":{\"healthyStateDuration\":\"s-healthystateduration\",\"maxElasticDuration\":\"s-maxelasticduration\",\"properties\":{},\"type\":\"REST\",\"waitDuration\":\"s-waitduration\"},\"stepType\":\"HealthCheck\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]")
  gv_note(f, "CALL StepsClient.List")
  match c.list("id1/ x", StepsClientListOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_steps_client_list_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_26)
}
