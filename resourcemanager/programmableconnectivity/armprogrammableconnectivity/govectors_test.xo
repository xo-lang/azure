  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"camaraApiName\":\"s-camaraapiname\",\"limits\":\"s-limits\",\"marketplaceProperties\":{\"legacyOfferId\":\"s-legacyofferid\",\"offerId\":\"s-offerid\",\"planId\":\"s-planid\",\"publisherId\":\"s-publisherid\",\"termId\":\"s-termid\"},\"markets\":[\"s-markets\"],\"operatorName\":\"s-operatorname\",\"operatorRegions\":[\"s-operatorregions\"],\"provisioningState\":\"Succeeded\",\"supportedLocations\":[\"s-supportedlocations\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL OperatorAPIPlansClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(OperatorAPIPlansClientListBySubscriptionOptions{filter: Some("s-filter"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_operator_api_plans_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_14)
}
