test "Go's OperatorAPIConnectionsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_operator_api_connections_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accountType\":\"s-accounttype\",\"appId\":\"s-appid\",\"appSecret\":\"s-appsecret\",\"camaraApiName\":\"s-camaraapiname\",\"configuredApplication\":{\"applicationDescription\":\"s-applicationdescription\",\"applicationType\":\"s-applicationtype\",\"legalName\":\"s-legalname\",\"name\":\"s-name\",\"organizationDescription\":\"s-organizationdescription\",\"privacyContactEmailAddress\":\"s-privacycontactemailaddress\",\"taxNumber\":\"s-taxnumber\"},\"gatewayId\":\"s-gatewayid\",\"operatorApiPlanId\":\"s-operatorapiplanid\",\"operatorName\":\"s-operatorname\",\"provisioningState\":\"Succeeded\",\"saasProperties\":{\"saasResourceId\":\"s-saasresourceid\",\"saasSubscriptionId\":\"s-saassubscriptionid\"},\"status\":{\"reason\":\"s-reason\",\"state\":\"s-state\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL OperatorAPIConnectionsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", OperatorAPIConnectionsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_operator_api_connections_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_11)
}

