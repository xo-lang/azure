test "Go's NetworkTapsClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_network_taps_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"administrativeState\":\"s-administrativestate\",\"annotation\":\"s-annotation\",\"configurationState\":\"s-configurationstate\",\"destinations\":[{\"destinationId\":\"s-destinationid\",\"destinationTapRuleId\":\"s-destinationtapruleid\",\"destinationType\":\"s-destinationtype\",\"isolationDomainProperties\":{\"encapsulation\":\"s-encapsulation\"},\"name\":\"s-name\"}],\"lastOperation\":{\"details\":\"s-details\"},\"networkFabricIds\":[\"s-networkfabricids\"],\"networkPacketBrokerId\":\"s-networkpacketbrokerid\",\"pollingType\":\"s-pollingtype\",\"provisioningState\":\"Succeeded\",\"sourceTapRuleId\":\"s-sourcetapruleid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL NetworkTapsClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(NetworkTapsClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_network_taps_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_187)
}

