test "Go's NetworkFabricsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_network_fabrics_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"activeCommitBatches\":[\"s-activecommitbatches\"],\"administrativeState\":\"s-administrativestate\",\"annotation\":\"s-annotation\",\"authorizedTransceiver\":{\"key\":\"s-key\",\"vendor\":\"s-vendor\"},\"configurationState\":\"s-configurationstate\",\"controlPlaneAcls\":[\"s-controlplaneacls\"],\"fabricASN\":7,\"fabricLocks\":[{\"lockState\":\"s-lockstate\",\"lockType\":\"s-locktype\"}],\"fabricVersion\":\"s-fabricversion\",\"featureFlags\":[{\"featureFlagName\":\"s-featureflagname\",\"featureFlagValue\":\"s-featureflagvalue\"}],\"hardwareAlertThreshold\":7,\"ipv4Prefix\":\"s-ipv4prefix\",\"ipv6Prefix\":\"s-ipv6prefix\",\"l2IsolationDomains\":[\"s-l2isolationdomains\"],\"l3IsolationDomains\":[\"s-l3isolationdomains\"],\"lastOperation\":{\"details\":\"s-details\"},\"managementNetworkConfiguration\":{\"infrastructureVpnConfiguration\":{\"administrativeState\":\"s-administrativestate\",\"networkToNetworkInterconnectId\":\"s-networktonetworkinterconnectid\",\"optionAProperties\":{\"mtu\":7,\"peerASN\":7,\"primaryIpv4Prefix\":\"s-primaryipv4prefix\",\"primaryIpv6Prefix\":\"s-primaryipv6prefix\",\"secondaryIpv4Prefix\":\"s-secondaryipv4prefix\",\"secondaryIpv6Prefix\":\"s-secondaryipv6prefix\",\"vlanId\":7},\"optionBProperties\":{},\"peeringOption\":\"s-peeringoption\"},\"workloadVpnConfiguration\":{\"administrativeState\":\"s-administrativestate\",\"networkToNetworkInterconnectId\":\"s-networktonetworkinterconnectid\",\"optionAProperties\":{\"mtu\":7,\"peerASN\":7,\"primaryIpv4Prefix\":\"s-primaryipv4prefix\",\"primaryIpv6Prefix\":\"s-primaryipv6prefix\",\"secondaryIpv4Prefix\":\"s-secondaryipv4prefix\",\"secondaryIpv6Prefix\":\"s-secondaryipv6prefix\",\"vlanId\":7},\"optionBProperties\":{},\"peeringOption\":\"s-peeringoption\"}},\"networkFabricControllerId\":\"s-networkfabriccontrollerid\",\"networkFabricSku\":\"s-networkfabricsku\",\"provisioningState\":\"Succeeded\",\"qosConfiguration\":{\"qosConfigurationState\":\"s-qosconfigurationstate\"},\"rackCount\":7,\"racks\":[\"s-racks\"],\"routerIds\":[\"s-routerids\"],\"secretRotationSummary\":{\"activePasswordSetCount\":7},\"serverCountPerRack\":7,\"storageAccountConfiguration\":{\"storageAccountId\":\"s-storageaccountid\",\"storageAccountIdentity\":{\"identityType\":\"s-identitytype\",\"userAssignedIdentityResourceId\":\"s-userassignedidentityresourceid\"}},\"storageArrayCount\":7,\"terminalServerConfiguration\":{\"networkDeviceId\":\"s-networkdeviceid\",\"password\":\"s-password\",\"primaryIpv4Prefix\":\"s-primaryipv4prefix\",\"primaryIpv6Prefix\":\"s-primaryipv6prefix\",\"secondaryIpv4Prefix\":\"s-secondaryipv4prefix\",\"secondaryIpv6Prefix\":\"s-secondaryipv6prefix\",\"secretRotationStatus\":[{\"lastRotationTime\":\"2026-11-06T10:00:00Z\",\"secretType\":\"s-secrettype\",\"synchronizationStatus\":\"s-synchronizationstatus\"}],\"serialNumber\":\"s-serialnumber\",\"username\":\"s-username\"},\"trustedIpPrefixes\":[\"s-trustedipprefixes\"],\"uniqueRdConfiguration\":{\"nniDerivedUniqueRdConfigurationState\":\"s-nnideriveduniquerdconfigurationstate\",\"uniqueRdConfigurationState\":\"s-uniquerdconfigurationstate\",\"uniqueRds\":[\"s-uniquerds\"]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL NetworkFabricsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", NetworkFabricsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_network_fabrics_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_144)
}

fn show_network_fabrics_client_list_by_subscription_response(r: NetworkFabricsClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.network_fabrics_list_result).to_str_lossy()}")
  parts.join(" ")
}

