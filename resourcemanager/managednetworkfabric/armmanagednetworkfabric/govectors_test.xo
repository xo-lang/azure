test "Go's RoutePoliciesClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_route_policies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"addressFamilyType\":\"s-addressfamilytype\",\"administrativeState\":\"s-administrativestate\",\"annotation\":\"s-annotation\",\"configurationState\":\"s-configurationstate\",\"defaultAction\":\"s-defaultaction\",\"lastOperation\":{\"details\":\"s-details\"},\"networkFabricId\":\"s-networkfabricid\",\"provisioningState\":\"Succeeded\",\"statements\":[{\"action\":{\"actionType\":\"s-actiontype\",\"localPreference\":7},\"annotation\":\"s-annotation\",\"condition\":{\"ipPrefixId\":\"s-ipprefixid\",\"type\":\"s-type\"},\"sequenceNumber\":7}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RoutePoliciesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", RoutePoliciesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_route_policies_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_204)
}

