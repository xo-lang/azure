test "Go's NetworkFabricsClient.BeginRotatePasswords" {
  let f = gv_new_fake(os.net)
  let c = new_network_fabrics_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"endTime\":\"2026-11-06T10:00:00Z\",\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"id\":\"s-id\",\"name\":\"s-name\",\"operations\":[{\"endTime\":\"2026-11-06T10:00:00Z\",\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"id\":\"s-id\",\"name\":\"s-name\",\"operations\":[{\"endTime\":\"2026-11-06T10:00:00Z\",\"error\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"},\"id\":\"s-id\",\"name\":\"s-name\",\"operations\":[{\"endTime\":\"2026-11-06T10:00:00Z\",\"id\":\"s-id\",\"name\":\"s-name\",\"percentComplete\":1.5,\"resourceId\":\"s-resourceid\",\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\"}],\"percentComplete\":1.5,\"resourceId\":\"s-resourceid\",\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\"}],\"percentComplete\":1.5,\"resourceId\":\"s-resourceid\",\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\"}],\"percentComplete\":1.5,\"resourceId\":\"s-resourceid\",\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\"}")
  gv_note(f, "CALL NetworkFabricsClient.BeginRotatePasswords")
  match c.begin_rotate_passwords("id1/ x", "id2/ x", NetworkFabricsClientBeginRotatePasswordsOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_network_fabrics_client_rotate_passwords_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_136)
}

fn show_network_fabrics_client_update_response(r: NetworkFabricsClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.network_fabric).to_str_lossy()}")
  parts.join(" ")
}

