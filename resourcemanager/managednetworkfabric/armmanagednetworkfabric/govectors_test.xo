fn show_network_fabrics_client_list_by_resource_group_response(r: NetworkFabricsClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.network_fabrics_list_result).to_str_lossy()}")
  parts.join(" ")
}

