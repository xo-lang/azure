  let f = gv_new_fake(os.net)
  let c = new_network_devices_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"administrativeState\":\"s-administrativestate\",\"annotation\":\"s-annotation\",\"certificateRotationStatus\":[{\"certificateArchiveReference\":{\"certificateName\":\"s-certificatename\",\"certificateVersion\":\"s-certificateversion\",\"keyVaultId\":\"s-keyvaultid\",\"keyVaultUri\":\"s-keyvaulturi\"},\"certificateType\":\"s-certificatetype\",\"expireTime\":\"2026-11-06T10:00:00Z\",\"lastRotationTime\":\"2026-11-06T10:00:00Z\",\"synchronizationStatus\":\"s-synchronizationstatus\"}],\"configurationState\":\"s-configurationstate\",\"hostName\":\"s-hostname\",\"identitySelector\":{\"identityType\":\"s-identitytype\",\"userAssignedIdentityResourceId\":\"s-userassignedidentityresourceid\"},\"lastOperation\":{\"details\":\"s-details\"},\"managementIpv4Address\":\"s-managementipv4address\",\"managementIpv6Address\":\"s-managementipv6address\",\"networkDeviceRole\":\"s-networkdevicerole\",\"networkDeviceSku\":\"s-networkdevicesku\",\"networkFabricId\":\"s-networkfabricid\",\"networkRackId\":\"s-networkrackid\",\"provisioningState\":\"Succeeded\",\"rwDeviceConfig\":\"s-rwdeviceconfig\",\"secretRotationStatus\":[{\"lastRotationTime\":\"2026-11-06T10:00:00Z\",\"secretArchiveReference\":{\"keyVaultId\":\"s-keyvaultid\",\"keyVaultUri\":\"s-keyvaulturi\",\"secretName\":\"s-secretname\",\"secretVersion\":\"s-secretversion\"},\"secretType\":\"s-secrettype\",\"synchronizationStatus\":\"s-synchronizationstatus\"}],\"serialNumber\":\"s-serialnumber\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL NetworkDevicesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(NetworkDevicesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_network_devices_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_113)
}

