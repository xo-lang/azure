fn show_internal_networks_client_list_by_l3_isolation_domain_response(r: InternalNetworksClientListByL3IsolationDomainResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.internal_networks_list).to_str_lossy()}")
  parts.join(" ")
}

