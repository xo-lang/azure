  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"currentValue\":7,\"id\":\"s-id\",\"limit\":7,\"name\":{\"localizedValue\":\"s-localizedvalue\",\"value\":\"s-value\"},\"unit\":\"s-unit\"}]}")
  gv_note(f, "CALL SubscriptionUsagesClient.NewUsagesPager")
  var pg = c.new_usages_pager("id1/ x", SubscriptionUsagesClientUsagesOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_subscription_usages_client_usages_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_10)
}
