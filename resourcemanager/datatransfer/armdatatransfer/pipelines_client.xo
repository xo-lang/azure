pub fn (c: PipelinesClient[fx]) begin_reject_connection(resource_group_name: Str, pipeline_name: Str, connection: ResourceBody, options: PipelinesClientBeginRejectConnectionOptions = PipelinesClientBeginRejectConnectionOptions{}) -> runtime.Poller[PipelinesClientRejectConnectionResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "PipelinesClientRejectConnectionResponse", fn(r: http.Response) -> PipelinesClientRejectConnectionResponse ! Str { pipelines_reject_connection_handle(r) })
  }
  let req = c.reject_connection_create_request(resource_group_name, pipeline_name, connection, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "", "PipelinesClientRejectConnectionResponse", fn(r: http.Response) -> PipelinesClientRejectConnectionResponse ! Str { pipelines_reject_connection_handle(r) })
}
