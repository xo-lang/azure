  let c = new_flows_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL FlowsClient.BeginUpdate")
  match c.begin_update("id1/ x", "id2/ x", "id3/ x", (json.decode_str[FlowsPatch]("{\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"properties\":{\"passphrase\":\"s-passphrase\",\"streamId\":\"s-streamid\",\"streamLatency\":7,\"streamProtocol\":\"s-streamprotocol\"},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), FlowsClientBeginUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_flows_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_28)
}

