agement.example.test/next?\$skiptoken=2\",\"messagingOptions\":{\"billingTier\":\"s-billingtier\",\"performancePriority\":\"s-performancepriority\"},\"passphrase\":\"s-passphrase\",\"policies\":[\"s-policies\"],\"provisioningState\":\"Succeeded\",\"schema\":{\"connectionId\":\"s-connectionid\",\"content\":\"s-content\",\"direction\":\"s-direction\",\"id\":\"s-id\",\"name\":\"s-name\",\"schemaType\":\"s-schematype\",\"schemaUri\":\"s-schemauri\",\"status\":\"s-status\"},\"serviceBusQueueId\":\"s-servicebusqueueid\",\"sourceAddresses\":{\"sourceAddresses\":[\"s-sourceaddresses\"]},\"status\":\"s-status\",\"storageAccountId\":\"s-storageaccountid\",\"storageAccountName\":\"s-storageaccountname\",\"storageContainerName\":\"s-storagecontainername\",\"storageTableName\":\"s-storagetablename\",\"streamId\":\"s-streamid\",\"streamLatency\":7,\"streamProtocol\":\"s-streamprotocol\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL FlowsClient.NewListByConnectionPager")
  var pg = c.new_list_by_connection_pager("id1/ x", "id2/ x", FlowsClientListByConnectionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_flows_client_list_by_connection_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_34)
