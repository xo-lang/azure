test "Go's PipelinesClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_pipelines_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"connections\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"k1\":{\"k\":\"v\"},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"k1\":{\"k\":\"v\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"disabledDataClass\":[\"s-disableddataclass\"],\"disabledFlowTypes\":[\"s-disabledflowtypes\"],\"displayName\":\"s-displayname\",\"flowTypes\":[\"s-flowtypes\"],\"policies\":[\"s-policies\"],\"provisioningState\":\"Succeeded\",\"quarantineDownloadStorageAccount\":\"s-quarantinedownloadstorageaccount\",\"quarantineDownloadStorageContainer\":\"s-quarantinedownloadstoragecontainer\",\"remoteCloud\":\"s-remotecloud\",\"status\":\"s-status\",\"subscribers\":[{\"email\":\"s-email\",\"notifications\":7}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PipelinesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", PipelinesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_pipelines_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_45)
}

fn show_pipelines_client_list_by_subscription_response(r: PipelinesClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.pipeline_list_result).to_str_lossy()}")
  parts.join(" ")
}

