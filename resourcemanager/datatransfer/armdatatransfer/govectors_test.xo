  let f = gv_new_fake(os.net)
  let c = new_connections_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"apiHostname\":\"s-apihostname\",\"approver\":\"s-approver\",\"dateSubmitted\":\"2026-11-06T10:00:00Z\",\"direction\":\"s-direction\",\"flowProfileList\":[{\"description\":\"s-description\",\"flowProfileId\":\"s-flowprofileid\",\"name\":\"s-name\",\"pipeline\":\"s-pipeline\",\"replicationScenario\":\"s-replicationscenario\",\"status\":\"s-status\"}],\"flowTypes\":[\"s-flowtypes\"],\"forceDisabledStatus\":[\"s-forcedisabledstatus\"],\"justification\":\"s-justification\",\"linkStatus\":\"https://management.example.test/next?\$skiptoken=2\",\"linkedConnectionId\":\"https://management.example.test/next?\$skiptoken=2\",\"pin\":\"s-pin\",\"pipeline\":\"s-pipeline\",\"policies\":[\"s-policies\"],\"primaryContact\":\"s-primarycontact\",\"provisioningState\":\"Succeeded\",\"remoteSubscriptionId\":\"s-remotesubscriptionid\",\"requirementId\":\"s-requirementid\",\"schemaUris\":[\"s-schemauris\"],\"schemas\":[{\"connectionId\":\"s-connectionid\",\"content\":\"s-content\",\"direction\":\"s-direction\",\"id\":\"s-id\",\"name\":\"s-name\",\"schemaType\":\"s-schematype\",\"schemaUri\":\"s-schemauri\",\"status\":\"s-status\"}],\"secondaryContacts\":[\"s-secondarycontacts\"],\"status\":\"s-status\",\"statusReason\":\"s-statusreason\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ConnectionsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ConnectionsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_connections_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_9)
}

