test "Go's WorkflowsClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_workflows_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessControl\":{\"actions\":{\"openAuthenticationPolicies\":{}},\"contents\":{\"openAuthenticationPolicies\":{}},\"triggers\":{\"openAuthenticationPolicies\":{}},\"workflowManagement\":{\"openAuthenticationPolicies\":{}}},\"accessEndpoint\":\"s-accessendpoint\",\"changedTime\":\"2026-11-06T10:00:00Z\",\"createdTime\":\"2026-11-06T10:00:00Z\",\"definition\":{\"k\":\"v\"},\"endpointsConfiguration\":{\"connector\":{},\"workflow\":{}},\"integrationAccount\":{\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"},\"integrationServiceEnvironment\":{\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"},\"parameters\":{\"k1\":{\"description\":\"s-description\",\"metadata\":{\"k\":\"v\"},\"type\":\"s-type\",\"value\":{\"k\":\"v\"}}},\"provisioningState\":\"Succeeded\",\"sku\":{\"name\":\"s-name\",\"plan\":{\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"}},\"state\":\"s-state\",\"version\":\"s-version\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkflowsClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(WorkflowsClientListBySubscriptionOptions{filter: Some("s-filter"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workflows_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_101)
}

