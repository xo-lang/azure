  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.Logic/integrationAccounts/{integrationAccountName}/regenerateAccessKey"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter client.subscriptionID cannot be empty"))
