  "  SERVED 200 {\"skipToken\":\"s-skiptoken\",\"subscriptionAccessDecisionList\":[{\"decision\":\"s-decision\",\"denialReason\":\"s-denialreason\",\"subscriptionId\":\"s-subscriptionid\"}],\"value\":[{\"categoryType\":\"s-categorytype\",\"dataType\":\"ItemDetailsData\",\"itemName\":\"s-itemname\",\"latestMonthEmissions\":1.5,\"monthOverMonthEmissionsChangeRatio\":1.5,\"monthlyEmissionsChangeValue\":1.5,\"previousMonthEmissions\":1.5}]}",
  "OUT: body={\"skipToken\":\"s-skiptoken\",\"subscriptionAccessDecisionList\":[{\"decision\":\"s-decision\",\"denialReason\":\"s-denialreason\",\"subscriptionId\":\"s-subscriptionid\"}],\"value\":[{\"categoryType\":\"s-categorytype\",\"dataType\":\"ItemDetailsData\",\"itemName\":\"s-itemname\",\"latestMonthEmissions\":1.5,\"monthOverMonthEmissionsChangeRatio\":1.5,\"monthlyEmissionsChangeValue\":1.5,\"previousMonthEmissions\":1.5}]}",
]

test "Go's CarbonServiceClient.QueryCarbonEmissionReports" {
  let f = gv_new_fake(os.net)
  let c = new_carbon_service_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"skipToken\":\"s-skiptoken\",\"subscriptionAccessDecisionList\":[{\"decision\":\"s-decision\",\"denialReason\":\"s-denialreason\",\"subscriptionId\":\"s-subscriptionid\"}],\"value\":[{\"categoryType\":\"s-categorytype\",\"dataType\":\"ItemDetailsData\",\"itemName\":\"s-itemname\",\"latestMonthEmissions\":1.5,\"monthOverMonthEmissionsChangeRatio\":1.5,\"monthlyEmissionsChangeValue\":1.5,\"previousMonthEmissions\":1.5}]}")
  gv_note(f, "CALL CarbonServiceClient.QueryCarbonEmissionReports")
  match c.query_carbon_emission_reports((json.decode_str[QueryFilterClassification]("{\"carbonScopeList\":[\"s-carbonscopelist\"],\"categoryType\":\"s-categorytype\",\"dateRange\":{\"end\":\"2026-11-06\",\"start\":\"2026-11-06\"},\"locationList\":[\"s-locationlist\"],\"orderBy\":\"s-orderby\",\"pageSize\":7,\"reportType\":\"ItemDetailsReport\",\"resourceGroupUrlList\":[\"s-resourcegroupurllist\"],\"resourceTypeList\":[\"s-resourcetypelist\"],\"skipToken\":\"s-skiptoken\",\"sortDirection\":\"s-sortdirection\",\"subscriptionList\":[\"s-subscriptionlist\"]}") ?? e => fault("${e}")), CarbonServiceClientQueryCarbonEmissionReportsOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_carbon_service_client_query_carbon_emission_reports_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_1)
}

fn show_operations_client_list_response(r: OperationsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_list_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_2: List[Str] = [
  "CALL OperationsClient.NewListPager",
  "REQ GET https://management.example.test/providers/Microsoft.Carbon/operations?api-version=2025-04-01",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "OUT page 1: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "REQ GET https://management.example.test/next?%24skiptoken=2",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
]

test "Go's OperationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_operations_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}")
  gv_note(f, "CALL OperationsClient.NewListPager")
  var pg = c.new_list_pager(OperationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_operations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_2)
}
