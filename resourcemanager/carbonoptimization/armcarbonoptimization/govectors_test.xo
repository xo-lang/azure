// Generated from the output of a local Go program that calls every
// public method of each client of armcarbonoptimization v1.0.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_carbon_service_client_query_carbon_emission_data_available_date_range_response(r: CarbonServiceClientQueryCarbonEmissionDataAvailableDateRangeResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.carbon_emission_data_available_date_range).to_str_lossy()}")
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL CarbonServiceClient.QueryCarbonEmissionDataAvailableDateRange",
  "REQ POST https://management.example.test/providers/Microsoft.Carbon/queryCarbonEmissionDataAvailableDateRange?api-version=2025-04-01",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"endDate\":\"s-enddate\",\"startDate\":\"s-startdate\"}",
  "OUT: body={\"endDate\":\"s-enddate\",\"startDate\":\"s-startdate\"}",
]

test "Go's CarbonServiceClient.QueryCarbonEmissionDataAvailableDateRange" {
  let f = gv_new_fake(os.net)
  let c = new_carbon_service_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"endDate\":\"s-enddate\",\"startDate\":\"s-startdate\"}")
  gv_note(f, "CALL CarbonServiceClient.QueryCarbonEmissionDataAvailableDateRange")
  match c.query_carbon_emission_data_available_date_range(CarbonServiceClientQueryCarbonEmissionDataAvailableDateRangeOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_carbon_service_client_query_carbon_emission_data_available_date_range_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

