test "Go's APIKeysClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_api_keys_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"value\":[{\"apiKey\":\"s-apikey\",\"createdDate\":\"s-createddate\",\"id\":\"s-id\",\"linkedReadProperties\":[\"https://management.example.test/next?\$skiptoken=2\"],\"linkedWriteProperties\":[\"https://management.example.test/next?\$skiptoken=2\"],\"name\":\"s-name\"}]}")
  gv_note(f, "CALL APIKeysClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", APIKeysClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_api_keys_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_3)
}

