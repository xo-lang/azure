// Generated from the output of a local Go program that calls every
// public method of each client of armterraform v0.2.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_client_export_terraform_response(r: ClientExportTerraformResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_status).to_str_lossy()}")
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL Client.BeginExportTerraform",
  "REQ POST https://management.example.test/subscriptions/sub-test/providers/Microsoft.AzureTerraform/exportTerraform?api-version=2026-09-01-preview",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"authorizationScopeFilter\":\"s-authorizationscopefilter\",\"excludeAzureResource\":[\"s-excludeazureresource\"],\"excludeTerraformResource\":[\"s-excludeterraformresource\"],\"fullProperties\":true,\"includeExtensions\":[\"s-includeextensions\"],\"includeManagedResource\":true,\"includeResourceGroup\":true,\"includeRoleAssignment\":true,\"maskSensitive\":true,\"namePattern\":\"s-namepattern\",\"query\":\"s-query\",\"recursive\":true,\"table\":\"s-table\",\"targetProvider\":\"s-targetprovider\",\"type\":\"ExportQuery\"}",
  "  SERVED 200 {\"endTime\":\"2026-11-06T10:00:00Z\",\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"id\":\"s-id\",\"name\":\"s-name\",\"percentComplete\":1.5,\"properties\":{\"configuration\":\"s-configuration\",\"errors\":[{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"}],\"import\":\"s-import\",\"skippedResources\":[\"s-skippedresources\"]},\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\"}",
  "OUT: body={\"endTime\":\"2026-11-06T10:00:00Z\",\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"id\":\"s-id\",\"name\":\"s-name\",\"percentComplete\":1.5,\"properties\":{\"configuration\":\"s-configuration\",\"errors\":[{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"}],\"import\":\"s-import\",\"skippedResources\":[\"s-skippedresources\"]},\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\"}",
]

test "Go's Client.BeginExportTerraform" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"endTime\":\"2026-11-06T10:00:00Z\",\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"id\":\"s-id\",\"name\":\"s-name\",\"percentComplete\":1.5,\"properties\":{\"configuration\":\"s-configuration\",\"errors\":[{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"}],\"import\":\"s-import\",\"skippedResources\":[\"s-skippedresources\"]},\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\"}")
  gv_note(f, "CALL Client.BeginExportTerraform")
  match c.begin_export_terraform((json.decode_str[BaseExportModelClassification]("{\"authorizationScopeFilter\":\"s-authorizationscopefilter\",\"excludeAzureResource\":[\"s-excludeazureresource\"],\"excludeTerraformResource\":[\"s-excludeterraformresource\"],\"fullProperties\":true,\"includeExtensions\":[\"s-includeextensions\"],\"includeManagedResource\":true,\"includeResourceGroup\":true,\"includeRoleAssignment\":true,\"maskSensitive\":true,\"namePattern\":\"s-namepattern\",\"query\":\"s-query\",\"recursive\":true,\"table\":\"s-table\",\"targetProvider\":\"s-targetprovider\",\"type\":\"ExportQuery\"}") ?? e => fault("${e}")), ClientBeginExportTerraformOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_client_export_terraform_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

fn show_operations_client_list_response(r: OperationsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_list_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_1: List[Str] = [
  "CALL OperationsClient.NewListPager",
  "REQ GET https://management.example.test/providers/Microsoft.AzureTerraform/operations?api-version=2026-09-01-preview",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "OUT page 1: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "REQ GET https://management.example.test/next?%24skiptoken=2",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
]

test "Go's OperationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_operations_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}")
  gv_note(f, "CALL OperationsClient.NewListPager")
  var pg = c.new_list_pager(OperationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_operations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_1)
}
