test "Go's MarketplaceAgreementsClient.Cancel" {
  let f = gv_new_fake(os.net)
  let c = new_marketplace_agreements_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
