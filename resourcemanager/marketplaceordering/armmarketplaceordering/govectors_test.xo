  match c.sign("id1/ x", "id2/ x", "id3/ x", MarketplaceAgreementsClientSignOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_marketplace_agreements_client_sign_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_5)
}

fn show_operations_client_list_response(r: OperationsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_list_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_6: List[Str] = [
  "CALL OperationsClient.NewListPager",
  "REQ GET https://management.example.test/providers/Microsoft.MarketplaceOrdering/operations?api-version=2021-01-01",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\"}]}",
  "OUT page 1: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\"}]}",
  "REQ GET https://management.example.test/next?%24skiptoken=2",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\"}]}",
]

test "Go's OperationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_operations_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\"}]}")
  gv_note(f, "CALL OperationsClient.NewListPager")
  var pg = c.new_list_pager(OperationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_operations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_6)
}
