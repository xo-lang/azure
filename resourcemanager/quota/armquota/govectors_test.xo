test "Go's Client.BeginCreateOrUpdate" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"isQuotaApplicable\":true,\"limit\":{\"limitObjectType\":\"LimitValue\",\"limitType\":\"s-limittype\",\"value\":7},\"name\":{\"localizedValue\":\"s-localizedvalue\",\"value\":\"s-value\"},\"properties\":{\"k\":\"v\"},\"quotaPeriod\":\"s-quotaperiod\",\"resourceType\":\"s-resourcetype\",\"unit\":\"s-unit\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL Client.BeginCreateOrUpdate")
  match c.begin_create_or_update("id1/ x", "id2/ x", (json.decode_str[CurrentQuotaLimitBase]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"isQuotaApplicable\":true,\"limit\":{\"limitObjectType\":\"LimitValue\",\"limitType\":\"s-limittype\",\"value\":7},\"name\":{\"localizedValue\":\"s-localizedvalue\",\"value\":\"s-value\"},\"properties\":{\"k\":\"v\"},\"quotaPeriod\":\"s-quotaperiod\",\"resourceType\":\"s-resourcetype\",\"unit\":\"s-unit\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), ClientBeginCreateOrUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_client_create_or_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

