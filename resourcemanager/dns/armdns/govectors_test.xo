test "Go's RecordSetsClient.NewListAllByDNSZonePager" {
  let f = gv_new_fake(os.net)
  let c = new_record_sets_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"AAAARecords\":[{\"ipv6Address\":\"s-ipv6address\"}],\"ARecords\":[{\"ipv4Address\":\"s-ipv4address\"}],\"CNAMERecord\":{\"cname\":\"s-cname\"},\"MXRecords\":[{\"exchange\":\"s-exchange\",\"preference\":7}],\"NSRecords\":[{\"nsdname\":\"s-nsdname\"}],\"PTRRecords\":[{\"ptrdname\":\"s-ptrdname\"}],\"SOARecord\":{\"email\":\"s-email\",\"expireTime\":7,\"host\":\"s-host\",\"minimumTTL\":7,\"refreshTime\":7,\"retryTime\":7,\"serialNumber\":7},\"SRVRecords\":[{\"port\":7,\"priority\":7,\"target\":\"s-target\",\"weight\":7}],\"TTL\":7,\"TXTRecords\":[{\"value\":[\"s-value\"]}],\"caaRecords\":[{\"flags\":7,\"tag\":\"s-tag\",\"value\":\"s-value\"}],\"fqdn\":\"s-fqdn\",\"metadata\":{\"k1\":\"s-metadata\"},\"provisioningState\":\"Succeeded\",\"targetResource\":{\"id\":\"s-id\"}},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RecordSetsClient.NewListAllByDNSZonePager")
  var pg = c.new_list_all_by_dns_zone_pager("id1/ x", "id2/ x", RecordSetsClientListAllByDNSZoneOptions{record_set_name_suffix: Some("s-recordsetnamesuffix"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_record_sets_client_list_all_by_dns_zone_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_3)
}

