test "Go's ServersClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_servers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"administratorLogin\":\"s-administratorlogin\",\"administratorLoginPassword\":\"s-administratorloginpassword\",\"authConfig\":{\"activeDirectoryAuth\":\"s-activedirectoryauth\",\"passwordAuth\":\"s-passwordauth\",\"tenantId\":\"s-tenantid\"},\"availabilityZone\":\"s-availabilityzone\",\"backup\":{\"backupRetentionDays\":7,\"earliestRestoreDate\":\"2026-11-06T10:00:00Z\",\"geoRedundantBackup\":\"s-georedundantbackup\",\"immutableBackup\":\"s-immutablebackup\"},\"cluster\":{\"clusterSize\":7,\"defaultDatabaseName\":\"s-defaultdatabasename\"},\"createMode\":\"s-createmode\",\"dataEncryption\":{\"geoBackupEncryptionKeyStatus\":\"s-geobackupencryptionkeystatus\",\"geoBackupFederatedIdentityClientId\":\"s-geobackupfederatedidentityclientid\",\"geoBackupKeyURI\":\"s-geobackupkeyuri\",\"geoBackupUserAssignedIdentityId\":\"s-geobackupuserassignedidentityid\",\"primaryEncryptionKeyStatus\":\"s-primaryencryptionkeystatus\",\"primaryFederatedIdentityClientId\":\"s-primaryfederatedidentityclientid\",\"primaryKeyURI\":\"s-primarykeyuri\",\"primaryUserAssignedIdentityId\":\"s-primaryuserassignedidentityid\",\"type\":\"s-type\"},\"fipsMode\":\"s-fipsmode\",\"fullyQualifiedDomainName\":\"s-fullyqualifieddomainname\",\"highAvailability\":{\"mode\":\"s-mode\",\"standbyAvailabilityZone\":\"s-standbyavailabilityzone\",\"state\":\"s-state\"},\"maintenanceWindow\":{\"customWindow\":\"s-customwindow\",\"dayOfWeek\":7,\"startHour\":7,\"startMinute\":7},\"minorVersion\":\"s-minorversion\",\"network\":{\"delegatedSubnetResourceId\":\"s-delegatedsubnetresourceid\",\"privateDnsZoneArmResourceId\":\"s-privatednszonearmresourceid\",\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"pointInTimeUTC\":\"2026-11-06T10:00:00Z\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"replica\":{\"capacity\":7,\"promoteMode\":\"s-promotemode\",\"promoteOption\":\"s-promoteoption\",\"replicationState\":\"s-replicationstate\",\"role\":\"s-role\"},\"replicaCapacity\":7,\"replicationRole\":\"s-replicationrole\",\"sourceServerResourceId\":\"s-sourceserverresourceid\",\"state\":\"s-state\",\"storage\":{\"autoGrow\":\"s-autogrow\",\"autoGrowIncrementPercent\":7,\"autoGrowMaxThresholdMb\":7,\"iops\":7,\"storageSizeGB\":7,\"throughput\":7,\"tier\":\"s-tier\",\"type\":\"s-type\"},\"version\":\"s-version\"},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ServersClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(ServersClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_servers_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_64)
}

fn show_tuning_options_client_get_response(r: TuningOptionsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.tuning_options).to_str_lossy()}")
  parts.join(" ")
}

