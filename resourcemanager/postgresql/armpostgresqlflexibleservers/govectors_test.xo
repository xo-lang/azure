test "Go's TuningOptionsClient.Get" {
  let f = gv_new_fake(os.net)
  let c = new_tuning_options_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"state\":\"s-state\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL TuningOptionsClient.Get")
  match c.get("id1/ x", "id2/ x", TuningOptionParameterEnum("sha1"), TuningOptionsClientGetOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_tuning_options_client_get_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_65)
}

