  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"endpointType\":\"s-endpointtype\",\"members\":[\"s-members\"],\"virtualEndpoints\":[\"s-virtualendpoints\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"endpointType\":\"s-endpointtype\",\"members\":[\"s-members\"],\"virtualEndpoints\":[\"s-virtualendpoints\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}",
]

test "Go's VirtualEndpointsClient.NewListByServerPager" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_endpoints_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"endpointType\":\"s-endpointtype\",\"members\":[\"s-members\"],\"virtualEndpoints\":[\"s-virtualendpoints\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualEndpointsClient.NewListByServerPager")
  var pg = c.new_list_by_server_pager("id1/ x", "id2/ x", VirtualEndpointsClientListByServerOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_endpoints_client_list_by_server_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_72)
}

fn show_virtual_network_subnet_usage_client_list_response(r: VirtualNetworkSubnetUsageClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.virtual_network_subnet_usage_model).to_str_lossy()}")
  parts.join(" ")
}

const GO_73: List[Str] = [
  "CALL VirtualNetworkSubnetUsageClient.List",
  "REQ POST https://management.example.test/subscriptions/sub-test/providers/Microsoft.DBforPostgreSQL/locations/id1%2F%20x/checkVirtualNetworkSubnetUsage?api-version=2026-10-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"virtualNetworkArmResourceId\":\"s-virtualnetworkarmresourceid\"}",
  "  SERVED 200 {\"delegatedSubnetsUsage\":[{\"subnetName\":\"s-subnetname\",\"usage\":7}],\"location\":\"s-location\",\"subscriptionId\":\"s-subscriptionid\"}",
  "OUT: body={\"delegatedSubnetsUsage\":[{\"subnetName\":\"s-subnetname\",\"usage\":7}],\"location\":\"s-location\",\"subscriptionId\":\"s-subscriptionid\"}",
]

test "Go's VirtualNetworkSubnetUsageClient.List" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_network_subnet_usage_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"delegatedSubnetsUsage\":[{\"subnetName\":\"s-subnetname\",\"usage\":7}],\"location\":\"s-location\",\"subscriptionId\":\"s-subscriptionid\"}")
  gv_note(f, "CALL VirtualNetworkSubnetUsageClient.List")
  match c.list("id1/ x", (json.decode_str[VirtualNetworkSubnetUsageParameter]("{\"virtualNetworkArmResourceId\":\"s-virtualnetworkarmresourceid\"}") ?? e => fault("${e}")), VirtualNetworkSubnetUsageClientListOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_virtual_network_subnet_usage_client_list_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_73)
}
