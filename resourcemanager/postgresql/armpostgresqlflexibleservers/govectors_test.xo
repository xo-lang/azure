26-11-06T10:00:00Z\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"groupIds\":[\"s-groupids\"],\"privateEndpoint\":{\"id\":\"s-id\"},\"privateLinkServiceConnectionState\":{\"actionsRequired\":\"s-actionsrequired\",\"description\":\"s-description\",\"status\":\"s-status\"},\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"replica\":{\"capacity\":7,\"promoteMode\":\"s-promotemode\",\"promoteOption\":\"s-promoteoption\",\"replicationState\":\"s-replicationstate\",\"role\":\"s-role\"},\"replicaCapacity\":7,\"replicationRole\":\"s-replicationrole\",\"sourceServerResourceId\":\"s-sourceserverresourceid\",\"state\":\"s-state\",\"storage\":{\"autoGrow\":\"s-autogrow\",\"autoGrowIncrementPercent\":7,\"autoGrowMaxThresholdMb\":7,\"iops\":7,\"storageSizeGB\":7,\"throughput\":7,\"tier\":\"s-tier\",\"type\":\"s-type\"},\"version\":\"s-version\"},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ServersClient.BeginUpdate")
  match c.begin_update("id1/ x", "id2/ x", (json.decode_str[ServerForPatch]("{\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"properties\":{\"administratorLogin\":\"s-administratorlogin\",\"administratorLoginPassword\":\"s-administratorloginpassword\",\"authConfig\":{\"activeDirectoryAuth\":\"s-activedirectoryauth\",\"passwordAuth\":\"s-passwordauth\",\"tenantId\":\"s-tenantid\"},\"availabilityZone\":\"s-availabilityzone\",\"backup\":{\"backupRetentionDays\":7,\"earliestRestoreDate\":\"2026-11-06T10:00:00Z\",\"geoRedundantBackup\":\"s-georedundantbackup\",\"immutableBackup\":\"s-immutablebackup\"},\"cluster\":{\"clusterSize\":7,\"defaultDatabaseName\":\"s-defaultdatabasename\"},\"createMode\":\"s-createmode\",\"dataEncryption\":{\"geoBackupEncryptionKeyStatus\":\"s-geobackupencryptionkeystatus\",\"geoBackupFederatedIdentityClientId\":\"s-geobackupfederatedidentityclientid\",\"geoBackupKeyURI\":\"s-geobackupkeyuri\",\"geoBackupUserAssignedIdentityId\":\"s-geobackupuserassignedidentityid\",\"primaryEncryptionKeyStatus\":\"s-primaryencryptionkeystatus\",\"primaryFederatedIdentityClientId\":\"s-primaryfederatedidentityclientid\",\"primaryKeyURI\":\"s-primarykeyuri\",\"primaryUserAssignedIdentityId\":\"s-primaryuserassignedidentityid\",\"type\":\"s-type\"},\"fipsMode\":\"s-fipsmode\",\"highAvailability\":{\"mode\":\"s-mode\",\"standbyAvailabilityZone\":\"s-standbyavailabilityzone\",\"state\":\"s-state\"},\"maintenanceWindow\":{\"customWindow\":\"s-customwindow\",\"dayOfWeek\":7,\"startHour\":7,\"startMinute\":7},\"network\":{\"delegatedSubnetResourceId\":\"s-delegatedsubnetresourceid\",\"privateDnsZoneArmResourceId\":\"s-privatednszonearmresourceid\",\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"replica\":{\"capacity\":7,\"promoteMode\":\"s-promotemode\",\"promoteOption\":\"s-promoteoption\",\"replicationState\":\"s-replicationstate\",\"role\":\"s-role\"},\"replicationRole\":\"s-replicationrole\",\"sourceServerResourceId\":\"s-sourceserverresourceid\",\"storage\":{\"autoGrow\":\"s-autogrow\",\"autoGrowIncrementPercent\":7,\"autoGrowMaxThresholdMb\":7,\"iops\":7,\"storageSizeGB\":7,\"throughput\":7,\"tier\":\"s-tier\",\"type\":\"s-type\"},\"version\":\"s-version\"},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), ServersClientBeginUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_servers_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_61)
}

fn show_servers_client_get_response(r: ServersClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.server).to_str_lossy()}")
  parts.join(" ")
}

