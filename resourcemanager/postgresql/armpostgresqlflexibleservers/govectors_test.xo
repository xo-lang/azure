test "Go's MigrationsClient.NewListByTargetServerPager" {
  let f = gv_new_fake(os.net)
  let c = new_migrations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"cancel\":\"s-cancel\",\"currentStatus\":{\"currentSubStateDetails\":{\"currentSubState\":\"s-currentsubstate\",\"validationDetails\":{\"status\":\"s-status\",\"validationEndTimeInUtc\":\"2026-11-06T10:00:00Z\",\"validationStartTimeInUtc\":\"2026-11-06T10:00:00Z\"}},\"error\":\"s-error\",\"state\":\"s-state\"},\"dbsToCancelMigrationOn\":[\"s-dbstocancelmigrationon\"],\"dbsToMigrate\":[\"s-dbstomigrate\"],\"dbsToTriggerCutoverOn\":[\"s-dbstotriggercutoveron\"],\"migrateRoles\":\"s-migrateroles\",\"migrationId\":\"s-migrationid\",\"migrationInstanceResourceId\":\"s-migrationinstanceresourceid\",\"migrationMode\":\"s-migrationmode\",\"migrationOption\":\"s-migrationoption\",\"migrationWindowEndTimeInUtc\":\"2026-11-06T10:00:00Z\",\"migrationWindowStartTimeInUtc\":\"2026-11-06T10:00:00Z\",\"overwriteDbsInTarget\":\"s-overwritedbsintarget\",\"secretParameters\":{\"adminCredentials\":{\"sourceServerPassword\":\"s-sourceserverpassword\",\"targetServerPassword\":\"s-targetserverpassword\"},\"sourceServerUsername\":\"s-sourceserverusername\",\"targetServerUsername\":\"s-targetserverusername\"},\"setupLogicalReplicationOnSourceDbIfNeeded\":\"s-setuplogicalreplicationonsourcedbifneeded\",\"sourceDbServerFullyQualifiedDomainName\":\"s-sourcedbserverfullyqualifieddomainname\",\"sourceDbServerMetadata\":{\"location\":\"s-location\",\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"storageMb\":7,\"version\":\"s-version\"},\"sourceDbServerResourceId\":\"s-sourcedbserverresourceid\",\"sourceType\":\"s-sourcetype\",\"sslMode\":\"s-sslmode\",\"startDataMigration\":\"s-startdatamigration\",\"targetDbServerFullyQualifiedDomainName\":\"s-targetdbserverfullyqualifieddomainname\",\"targetDbServerMetadata\":{\"location\":\"s-location\",\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"storageMb\":7,\"version\":\"s-version\"},\"targetDbServerResourceId\":\"s-targetdbserverresourceid\",\"triggerCutover\":\"s-triggercutover\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL MigrationsClient.NewListByTargetServerPager")
  var pg = c.new_list_by_target_server_pager("id1/ x", "id2/ x", MigrationsClientListByTargetServerOptions{migration_list_filter: Some(MigrationListFilter("s-migrationlistfilter"))}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_migrations_client_list_by_target_server_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_39)
}

fn show_migrations_client_update_response(r: MigrationsClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.migration).to_str_lossy()}")
  parts.join(" ")
}

