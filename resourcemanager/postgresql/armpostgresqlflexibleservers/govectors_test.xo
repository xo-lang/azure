eid\",\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"pointInTimeUTC\":\"2026-11-06T10:00:00Z\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"replica\":{\"capacity\":7,\"promoteMode\":\"s-promotemode\",\"promoteOption\":\"s-promoteoption\",\"replicationState\":\"s-replicationstate\",\"role\":\"s-role\"},\"replicaCapacity\":7,\"replicationRole\":\"s-replicationrole\",\"sourceServerResourceId\":\"s-sourceserverresourceid\",\"state\":\"s-state\",\"storage\":{\"autoGrow\":\"s-autogrow\",\"autoGrowIncrementPercent\":7,\"autoGrowMaxThresholdMb\":7,\"iops\":7,\"storageSizeGB\":7,\"throughput\":7,\"tier\":\"s-tier\",\"type\":\"s-type\"},\"version\":\"s-version\"},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ServersClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ServersClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_servers_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_63)
}

