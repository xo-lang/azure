/// Failover mode.
pub type FailoverMode struct(Str)
/// Terminate the primary database process first, then triggers the failover. This is more aggressive and used when the primary is unresponsive or in an unhealthy state.
pub const FAILOVER_MODE_FORCED_FAILOVER: FailoverMode = FailoverMode("ForcedFailover")
/// Terminate the primary database process first, and then triggers a switch over with role swapping.
pub const FAILOVER_MODE_FORCED_SWITCHOVER: FailoverMode = FailoverMode("ForcedSwitchover")
/// Trigger a failover from primary to standby without killing the primary database process first. This is a graceful failover that attempts to preserve data consistency.
pub const FAILOVER_MODE_PLANNED_FAILOVER: FailoverMode = FailoverMode("PlannedFailover")
/// Similar to 'PlannedFailover' but prefers a switch over operation where roles are swapped between primary and standby.
pub const FAILOVER_MODE_PLANNED_SWITCHOVER: FailoverMode = FailoverMode("PlannedSwitchover")

/// The values of FailoverMode this version knows; the service may send others.
pub fn possible_failover_mode_values() -> List[FailoverMode] {
  [FAILOVER_MODE_FORCED_FAILOVER, FAILOVER_MODE_FORCED_SWITCHOVER, FAILOVER_MODE_PLANNED_FAILOVER, FAILOVER_MODE_PLANNED_SWITCHOVER]
}

