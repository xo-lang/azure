test "Go's MaintenanceConfigurationsClient.NewListByManagedClusterPager" {
  let f = gv_new_fake(os.net)
  let c = new_maintenance_configurations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"maintenanceWindow\":{\"durationHours\":7,\"notAllowedDates\":[{\"end\":\"2026-11-06\",\"start\":\"2026-11-06\"}],\"schedule\":{\"absoluteMonthly\":{\"dayOfMonth\":7,\"intervalMonths\":7},\"daily\":{\"intervalDays\":7},\"relativeMonthly\":{\"dayOfWeek\":\"s-dayofweek\",\"intervalMonths\":7,\"weekIndex\":\"s-weekindex\"},\"weekly\":{\"dayOfWeek\":\"s-dayofweek\",\"intervalWeeks\":7}},\"startDate\":\"2026-11-06\",\"startTime\":\"s-starttime\",\"utcOffset\":\"s-utcoffset\"},\"notAllowedTime\":[{\"end\":\"2026-11-06T10:00:00Z\",\"start\":\"2026-11-06T10:00:00Z\"}],\"timeInWeek\":[{\"day\":\"s-day\",\"hourSlots\":[7]}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL MaintenanceConfigurationsClient.NewListByManagedClusterPager")
  var pg = c.new_list_by_managed_cluster_pager("id1/ x", "id2/ x", MaintenanceConfigurationsClientListByManagedClusterOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_maintenance_configurations_client_list_by_managed_cluster_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_18)
}

