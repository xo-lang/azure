fn show_managed_namespaces_client_create_or_update_response(r: ManagedNamespacesClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.managed_namespace).to_str_lossy()}")
  parts.join(" ")
}

