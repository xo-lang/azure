// Generated from the output of a local Go program that calls every
// public method of each client of armcontainerservice v9.7.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (mkvec_arm.py). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_agent_pools_client_abort_latest_operation_response(r: AgentPoolsClientAbortLatestOperationResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL AgentPoolsClient.BeginAbortLatestOperation",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.ContainerService/managedClusters/id2%2F%20x/agentPools/id3%2F%20x/abort?api-version=2026-08-01",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 202 ",
  "OUT: error: response is missing polling URL",
]

test "Go's AgentPoolsClient.BeginAbortLatestOperation" {
  let f = gv_new_fake(os.net)
  let c = new_agent_pools_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL AgentPoolsClient.BeginAbortLatestOperation")
  match c.begin_abort_latest_operation("id1/ x", "id2/ x", "id3/ x", AgentPoolsClientBeginAbortLatestOperationOptions{}) {
    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(r) => gv_note(f, "OUT: ${show_agent_pools_client_abort_latest_operation_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

fn show_agent_pools_client_create_or_update_response(r: AgentPoolsClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.agent_pool).to_str_lossy()}")
  parts.join(" ")
}

