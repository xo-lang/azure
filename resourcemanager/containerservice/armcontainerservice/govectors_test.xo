test "Go's ManagedClustersClient.BeginAbortLatestOperation" {
  let f = gv_new_fake(os.net)
  let c = new_managed_clusters_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL ManagedClustersClient.BeginAbortLatestOperation")
  match c.begin_abort_latest_operation("id1/ x", "id2/ x", ManagedClustersClientBeginAbortLatestOperationOptions{}) {
    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(r) => gv_note(f, "OUT: ${show_managed_clusters_client_abort_latest_operation_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_19)
}

fn show_managed_clusters_client_create_or_update_response(r: ManagedClustersClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.managed_cluster).to_str_lossy()}")
  parts.join(" ")
}

