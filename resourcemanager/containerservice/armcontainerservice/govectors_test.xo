  let f = gv_new_fake(os.net)
  let c = new_managed_clusters_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"category\":\"s-category\",\"endpoints\":[{\"domainName\":\"s-domainname\",\"endpointDetails\":[{\"description\":\"s-description\",\"ipAddress\":\"s-ipaddress\",\"port\":7,\"protocol\":\"s-protocol\"}]}]}]}")
  gv_note(f, "CALL ManagedClustersClient.NewListOutboundNetworkDependenciesEndpointsPager")
  var pg = c.new_list_outbound_network_dependencies_endpoints_pager("id1/ x", "id2/ x", ManagedClustersClientListOutboundNetworkDependenciesEndpointsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_managed_clusters_client_list_outbound_network_dependencies_endpoints_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_43)
}

fn show_managed_clusters_client_list_response(r: ManagedClustersClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.managed_cluster_list_result).to_str_lossy()}")
  parts.join(" ")
}

