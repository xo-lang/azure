  /// The OS configuration of Linux agent nodes.
  pub linux_os_config as "linuxOSConfig,omitempty": LinuxOSConfig? = None
  /// Configures the per-node local DNS, with VnetDNS and KubeDNS overrides. LocalDNS helps improve performance and reliability of DNS resolution in an AKS cluster. For more details see aka.ms/aks/localdns.
  pub local_dns_profile as "localDNSProfile,omitempty": LocalDNSProfile? = None
  /// The maximum number of nodes for auto-scaling
  pub max_count as "maxCount,omitempty": Int? = None
  /// The maximum number of pods that can run on a node.
  pub max_pods as "maxPods,omitempty": Int? = None
  /// Message of the day for Linux nodes, base64-encoded. A base64-encoded string which will be written to /etc/motd after decoding. This allows customization of the message of the day for Linux nodes. It must not be specified for Windows nodes. It must be a static string (i.e., will be printed raw and not be executed as a script).
  pub message_of_the_day as "messageOfTheDay,omitempty": Str? = None
  /// The minimum number of nodes for auto-scaling
