test "Go's PeeringsClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_peerings_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"connectivityProbes\":[{\"azureRegion\":\"s-azureregion\",\"endpoint\":\"s-endpoint\",\"prefixesToAccesslist\":[\"s-prefixestoaccesslist\"],\"protocol\":\"s-protocol\"}],\"direct\":{\"connections\":[{\"bandwidthInMbps\":7,\"connectionIdentifier\":\"s-connectionidentifier\",\"connectionState\":\"s-connectionstate\",\"errorMessage\":\"s-errormessage\",\"microsoftTrackingId\":\"s-microsofttrackingid\",\"peeringDBFacilityId\":7,\"provisionedBandwidthInMbps\":7,\"sessionAddressProvider\":\"s-sessionaddressprovider\",\"useForPeeringService\":true}],\"directPeeringType\":\"s-directpeeringtype\",\"peerAsn\":{\"id\":\"s-id\"},\"useForPeeringService\":true},\"exchange\":{\"connections\":[{\"connectionIdentifier\":\"s-connectionidentifier\",\"connectionState\":\"s-connectionstate\",\"errorMessage\":\"s-errormessage\",\"peeringDBFacilityId\":7}],\"peerAsn\":{\"id\":\"s-id\"}},\"peeringLocation\":\"s-peeringlocation\",\"provisioningState\":\"Succeeded\"},\"sku\":{\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PeeringsClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(PeeringsClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_peerings_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_18)
}

