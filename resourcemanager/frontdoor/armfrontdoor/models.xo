  pub action as "action,omitempty": RulesEngineAction? = None
  /// A list of match conditions that must meet in order for the actions of this rule to run. Having no match conditions means the actions will always run.
  pub match_conditions as "matchConditions,omitempty": List[RulesEngineMatchCondition]? = None
  /// If this rule is a match should the rules engine continue running the remaining rules or stop. If not present, defaults to Continue.
  pub match_processing_behavior as "matchProcessingBehavior,omitempty": MatchProcessingBehavior? = None
  /// A name to refer to this specific rule.
  pub name as "name,omitempty": Str? = None
  /// A priority assigned to this rule.
  pub priority as "priority,omitempty": Int? = None
} derive Json

