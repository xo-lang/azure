  var pg = c.new_list_by_profile_pager("id1/ x", "id2/ x", ExperimentsClientListByProfileOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
