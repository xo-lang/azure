  let c = new_front_doors_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"backendPools\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"resourceState\":\"s-resourcestate\"},\"type\":\"s-type\"}],\"backendPoolsSettings\":{\"enforceCertificateNameCheck\":\"s-enforcecertificatenamecheck\",\"sendRecvTimeoutSeconds\":7},\"cname\":\"s-cname\",\"enabledState\":\"s-enabledstate\",\"extendedProperties\":{\"k1\":\"s-extendedproperties\"},\"friendlyName\":\"s-friendlyname\",\"frontdoorId\":\"s-frontdoorid\",\"frontendEndpoints\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"customHttpsProvisioningState\":\"s-customhttpsprovisioningstate\",\"customHttpsProvisioningSubstate\":\"s-customhttpsprovisioningsubstate\",\"hostName\":\"s-hostname\",\"resourceState\":\"s-resourcestate\",\"sessionAffinityEnabledState\":\"s-sessionaffinityenabledstate\",\"sessionAffinityTtlSeconds\":7},\"type\":\"s-type\"}],\"healthProbeSettings\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"enabledState\":\"s-enabledstate\",\"healthProbeMethod\":\"s-healthprobemethod\",\"intervalInSeconds\":7,\"path\":\"s-path\",\"protocol\":\"s-protocol\",\"resourceState\":\"s-resourcestate\"},\"type\":\"s-type\"}],\"loadBalancingSettings\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"additionalLatencyMilliseconds\":7,\"resourceState\":\"s-resourcestate\",\"sampleSize\":7,\"successfulSamplesRequired\":7},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"resourceState\":\"s-resourcestate\",\"routingRules\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"enabledState\":\"s-enabledstate\",\"resourceState\":\"s-resourcestate\",\"routeConfiguration\":{\"@odata.type\":\"#Microsoft.Azure.FrontDoor.Models.FrontdoorForwardingConfiguration\",\"customForwardingPath\":\"s-customforwardingpath\",\"forwardingProtocol\":\"s-forwardingprotocol\"}},\"type\":\"s-type\"}],\"rulesEngines\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"resourceState\":\"s-resourcestate\"},\"type\":\"s-type\"}]},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL FrontDoorsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", FrontDoorsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_front_doors_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_9)
}

