  let c = new_policies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"customRules\":{\"rules\":[{\"action\":\"s-action\",\"enabledState\":\"s-enabledstate\",\"name\":\"s-name\",\"priority\":7,\"rateLimitDurationInMinutes\":7,\"rateLimitThreshold\":7,\"ruleType\":\"s-ruletype\"}]},\"frontendEndpointLinks\":[{\"id\":\"s-id\"}],\"managedRules\":{\"managedRuleSets\":[{\"ruleSetAction\":\"s-rulesetaction\",\"ruleSetType\":\"s-rulesettype\",\"ruleSetVersion\":\"s-rulesetversion\"}]},\"policySettings\":{\"captchaExpirationInMinutes\":7,\"customBlockResponseBody\":\"s-customblockresponsebody\",\"customBlockResponseStatusCode\":7,\"enabledState\":\"s-enabledstate\",\"javascriptChallengeExpirationInMinutes\":7,\"logScrubbing\":{\"state\":\"s-state\"},\"mode\":\"s-mode\",\"redirectUrl\":\"s-redirecturl\",\"requestBodyCheck\":\"s-requestbodycheck\"},\"provisioningState\":\"Succeeded\",\"resourceState\":\"s-resourcestate\",\"routingRuleLinks\":[{\"id\":\"s-id\"}],\"securityPolicyLinks\":[{\"id\":\"s-id\"}]},\"sku\":{\"name\":\"s-name\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PoliciesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(PoliciesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
