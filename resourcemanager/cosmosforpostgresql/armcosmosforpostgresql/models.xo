/// Request from client to check cluster name availability.
pub struct NameAvailabilityRequest {
  /// Cluster name to verify.
  pub name as "name,omitempty": Str? = None
  /// Resource type used for verification.
  pub type_ as "type,omitempty": Str? = None
} derive Json(via: json.Value, to: name_availability_request_json, from: parse_name_availability_request)

/// NameAvailabilityRequest's named fields, for its JSON.
struct NameAvailabilityRequestKnown {
  name as "name,omitempty": Str? = None
  type_ as "type,omitempty": Str? = None
} derive Json

fn name_availability_request_json(x: NameAvailabilityRequest) -> json.Value {
  let known = NameAvailabilityRequestKnown{
    name: x.name,
    type_: Some("Microsoft.DBforPostgreSQL/serverGroupsv2"),
  }
  json.to_value(known)
}

fn parse_name_availability_request(v: json.Value) -> NameAvailabilityRequest ! json.DecodeErr {
  let k = json.from_value[NameAvailabilityRequestKnown](v)?
  Ok(NameAvailabilityRequest{
    name: k.name,
    type_: k.type_,
  })
}

