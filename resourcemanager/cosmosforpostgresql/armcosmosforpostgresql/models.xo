/// MaintenanceWindowPatch: MaintenanceWindow in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct MaintenanceWindowPatch {
  /// Indicates whether custom maintenance window is enabled or not.
  pub custom_window as "customWindow,omitempty": json.Patch[Str] = json.Patch.Absent
  /// Preferred day of the week for maintenance window.
  pub day_of_week as "dayOfWeek,omitempty": json.Patch[Int] = json.Patch.Absent
  /// Start hour within preferred day of the week for maintenance window.
  pub start_hour as "startHour,omitempty": json.Patch[Int] = json.Patch.Absent
  /// Start minute within the start hour for maintenance window.
  pub start_minute as "startMinute,omitempty": json.Patch[Int] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: MaintenanceWindow) patch() -> MaintenanceWindowPatch {
  MaintenanceWindowPatch{
    custom_window: match m.custom_window {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    start_hour: match m.start_hour {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    start_minute: match m.start_minute {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    day_of_week: match m.day_of_week {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
