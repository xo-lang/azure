pub fn (c: EnergyServicesClient) list_partitions(resource_group_name: Str, resource_name: Str, options: EnergyServicesClientListPartitionsOptions = EnergyServicesClientListPartitionsOptions{}) -> EnergyServicesClientListPartitionsResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let sp = runtime.start_span({}, "EnergyServicesClient.ListPartitions", c.setup.pipeline.tracer)
  let req = sp.on(c.list_partitions_create_request(resource_group_name, resource_name, options) ?? e => return Err(sp.fail(e)))
  let resp = c.setup.pipeline.send(req) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![200].contains(resp.status) {
    return Err(sp.fail(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  let out = energy_services_list_partitions_handle(resp) ?? e => return Err(sp.fail(azcore.CallErr.Decode(e)))
  sp.end()
  Ok(out)
}
