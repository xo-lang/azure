test "Go's WorkspaceCollectionsClient.BeginDelete" {
  let f = gv_new_fake(os.net)
  let c = new_workspace_collections_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
