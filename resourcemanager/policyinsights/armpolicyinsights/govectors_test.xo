test "Go's AttestationsClient.NewListForResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_attestations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"assessmentDate\":\"2026-11-06T10:00:00Z\",\"comments\":\"s-comments\",\"complianceState\":\"s-compliancestate\",\"evidence\":[{\"description\":\"s-description\",\"sourceUri\":\"s-sourceuri\"}],\"expiresOn\":\"2026-11-06T10:00:00Z\",\"lastComplianceStateChangeAt\":\"2026-11-06T10:00:00Z\",\"metadata\":{\"k\":\"v\"},\"owner\":\"s-owner\",\"policyAssignmentId\":\"s-policyassignmentid\",\"policyDefinitionReferenceId\":\"s-policydefinitionreferenceid\",\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AttestationsClient.NewListForResourceGroupPager")
  var pg = c.new_list_for_resource_group_pager("id1/ x", AttestationsClientListForResourceGroupOptions{filter: Some("s-filter"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_attestations_client_list_for_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_9)
}

