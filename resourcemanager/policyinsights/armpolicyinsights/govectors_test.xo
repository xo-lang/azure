  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"correlationId\":\"s-correlationid\",\"createdOn\":\"2026-11-06T10:00:00Z\",\"deploymentStatus\":{\"failedDeployments\":7,\"successfulDeployments\":7,\"totalDeployments\":7},\"failureThreshold\":{\"percentage\":1.5},\"filters\":{\"locations\":[\"s-locations\"],\"resourceIds\":[\"s-resourceids\"]},\"lastUpdatedOn\":\"2026-11-06T10:00:00Z\",\"parallelDeployments\":7,\"policyAssignmentId\":\"s-policyassignmentid\",\"policyDefinitionReferenceId\":\"s-policydefinitionreferenceid\",\"provisioningState\":\"Succeeded\",\"resourceCount\":7,\"resourceDiscoveryMode\":\"s-resourcediscoverymode\",\"statusMessage\":\"s-statusmessage\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"correlationId\":\"s-correlationid\",\"createdOn\":\"2026-11-06T10:00:00Z\",\"deploymentStatus\":{\"failedDeployments\":7,\"successfulDeployments\":7,\"totalDeployments\":7},\"failureThreshold\":{\"percentage\":1.5},\"filters\":{\"locations\":[\"s-locations\"],\"resourceIds\":[\"s-resourceids\"]},\"lastUpdatedOn\":\"2026-11-06T10:00:00Z\",\"parallelDeployments\":7,\"policyAssignmentId\":\"s-policyassignmentid\",\"policyDefinitionReferenceId\":\"s-policydefinitionreferenceid\",\"provisioningState\":\"Succeeded\",\"resourceCount\":7,\"resourceDiscoveryMode\":\"s-resourcediscoverymode\",\"statusMessage\":\"s-statusmessage\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}",
