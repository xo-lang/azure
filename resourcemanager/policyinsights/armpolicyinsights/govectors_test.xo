test "Go's RemediationsClient.NewListForSubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_remediations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"correlationId\":\"s-correlationid\",\"createdOn\":\"2026-11-06T10:00:00Z\",\"deploymentStatus\":{\"failedDeployments\":7,\"successfulDeployments\":7,\"totalDeployments\":7},\"failureThreshold\":{\"percentage\":1.5},\"filters\":{\"locations\":[\"s-locations\"],\"resourceIds\":[\"s-resourceids\"]},\"lastUpdatedOn\":\"2026-11-06T10:00:00Z\",\"parallelDeployments\":7,\"policyAssignmentId\":\"s-policyassignmentid\",\"policyDefinitionReferenceId\":\"s-policydefinitionreferenceid\",\"provisioningState\":\"Succeeded\",\"resourceCount\":7,\"resourceDiscoveryMode\":\"s-resourcediscoverymode\",\"statusMessage\":\"s-statusmessage\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RemediationsClient.NewListForSubscriptionPager")
  var pg = c.new_list_for_subscription_pager(RemediationsClientListForSubscriptionOptions{filter: Some("s-filter"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_remediations_client_list_for_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_77)
}
