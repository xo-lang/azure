]

test "Go's VolumesClient.NewListMetricDefinitionPager" {
  let f = gv_new_fake(os.net)
  let c = new_volumes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"value\":[{\"category\":\"s-category\",\"dimensions\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"metricAvailabilities\":[{\"retention\":\"s-retention\",\"timeGrain\":\"s-timegrain\"}],\"name\":{\"localizedValue\":\"s-localizedvalue\",\"value\":\"s-value\"},\"primaryAggregationType\":\"s-primaryaggregationtype\",\"resourceId\":\"s-resourceid\",\"type\":\"s-type\",\"unit\":\"s-unit\"}]}")
  gv_note(f, "CALL VolumesClient.NewListMetricDefinitionPager")
  var pg = c.new_list_metric_definition_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", "id5/ x", VolumesClientListMetricDefinitionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_volumes_client_list_metric_definition_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_90)
}

fn show_volumes_client_list_metrics_response(r: VolumesClientListMetricsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.metric_list).to_str_lossy()}")
  parts.join(" ")
}

