  "OUT page 1: body={\"value\":[{\"category\":\"s-category\",\"dimensions\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"metricAvailabilities\":[{\"retention\":\"s-retention\",\"timeGrain\":\"s-timegrain\"}],\"name\":{\"localizedValue\":\"s-localizedvalue\",\"value\":\"s-value\"},\"primaryAggregationType\":\"s-primaryaggregationtype\",\"resourceId\":\"s-resourceid\",\"type\":\"s-type\",\"unit\":\"s-unit\"}]}",
