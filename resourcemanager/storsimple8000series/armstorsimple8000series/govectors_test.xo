test "Go's JobsClient.NewListByManagerPager" {
  let f = gv_new_fake(os.net)
  let c = new_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"endTime\":\"2026-11-06T10:00:00Z\",\"error\":{\"code\":\"s-code\",\"errorDetails\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"recommendations\":[\"s-recommendations\"]}],\"message\":\"s-message\"},\"id\":\"s-id\",\"kind\":\"Series8000\",\"name\":\"s-name\",\"percentComplete\":7,\"properties\":{\"backupPointInTime\":\"2026-11-06T10:00:00Z\",\"backupType\":\"s-backuptype\",\"dataStats\":{\"cloudData\":7,\"processedData\":7,\"throughput\":7,\"totalData\":7},\"deviceId\":\"s-deviceid\",\"entityLabel\":\"s-entitylabel\",\"entityType\":\"s-entitytype\",\"isCancellable\":true,\"jobStages\":[{\"detail\":\"s-detail\",\"errorCode\":\"s-errorcode\",\"message\":\"s-message\",\"stageStatus\":\"s-stagestatus\"}],\"jobType\":\"s-jobtype\",\"sourceDeviceId\":\"s-sourcedeviceid\"},\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"type\":\"s-type\"}]}")
  gv_note(f, "CALL JobsClient.NewListByManagerPager")
  var pg = c.new_list_by_manager_pager("id1/ x", "id2/ x", JobsClientListByManagerOptions{filter: Some("s-filter")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_jobs_client_list_by_manager_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_55)
}

