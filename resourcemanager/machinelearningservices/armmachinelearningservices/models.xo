  /// computeType "ComputeInstance"
  ComputeInstance(from ComputeInstance)
  /// computeType "VirtualMachine"
  VirtualMachine(from VirtualMachine)
  /// computeType "HDInsight"
  HDInsight(from HDInsight)
  /// computeType "DataFactory"
  DataFactory(from DataFactory)
  /// computeType "Databricks"
  Databricks(from Databricks)
  /// computeType "DataLakeAnalytics"
  DataLakeAnalytics(from DataLakeAnalytics)
  /// computeType "SynapseSpark"
  SynapseSpark(from SynapseSpark)
  /// Any other computeType, as the base type.
  Compute(from Compute)
} derive Json(via: json.Value, to: compute_classification_json, from: parse_compute_classification)

fn compute_classification_json(c: ComputeClassification) -> json.Value {
