/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: ServiceManagedResourcesSettings) patch() -> ServiceManagedResourcesSettingsPatch {
  ServiceManagedResourcesSettingsPatch{
    cosmos_db: match m.cosmos_db {
      Some(x) => json.Patch.Value(x.patch())
      None => json.Patch.Absent
    },
  }
}
