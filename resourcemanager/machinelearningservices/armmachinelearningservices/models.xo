    ComputeClassification.ComputeInstance(x) => json.to_value(x)
    ComputeClassification.VirtualMachine(x) => json.to_value(x)
    ComputeClassification.HDInsight(x) => json.to_value(x)
    ComputeClassification.DataFactory(x) => json.to_value(x)
    ComputeClassification.Databricks(x) => json.to_value(x)
    ComputeClassification.DataLakeAnalytics(x) => json.to_value(x)
    ComputeClassification.SynapseSpark(x) => json.to_value(x)
    ComputeClassification.Compute(x) => json.to_value(x)
  }
}

fn parse_compute_classification(v: json.Value) -> ComputeClassification ! json.DecodeErr {
  match v.get("computeType") {
    Some(json.Value.Str("AKS")) => Ok(ComputeClassification.AKS(json.from_value[AKS](v)?))
    Some(json.Value.Str("Kubernetes")) => Ok(ComputeClassification.Kubernetes(json.from_value[Kubernetes](v)?))
    Some(json.Value.Str("AmlCompute")) => Ok(ComputeClassification.AmlCompute(json.from_value[AmlCompute](v)?))
    Some(json.Value.Str("ComputeInstance")) => Ok(ComputeClassification.ComputeInstance(json.from_value[ComputeInstance](v)?))
    Some(json.Value.Str("VirtualMachine")) => Ok(ComputeClassification.VirtualMachine(json.from_value[VirtualMachine](v)?))
    Some(json.Value.Str("HDInsight")) => Ok(ComputeClassification.HDInsight(json.from_value[HDInsight](v)?))
    Some(json.Value.Str("DataFactory")) => Ok(ComputeClassification.DataFactory(json.from_value[DataFactory](v)?))
    Some(json.Value.Str("Databricks")) => Ok(ComputeClassification.Databricks(json.from_value[Databricks](v)?))
    Some(json.Value.Str("DataLakeAnalytics")) => Ok(ComputeClassification.DataLakeAnalytics(json.from_value[DataLakeAnalytics](v)?))
    Some(json.Value.Str("SynapseSpark")) => Ok(ComputeClassification.SynapseSpark(json.from_value[SynapseSpark](v)?))
    _ => Ok(ComputeClassification.Compute(json.from_value[Compute](v)?))
  }
}

/// ComputeSecretsClassification: a ComputeSecrets by its computeType, Go's ComputeSecretsClassification interface.
pub enum ComputeSecretsClassification {
  /// computeType "AKS"
  AksComputeSecrets(from AksComputeSecrets)
  /// computeType "VirtualMachine"
  VirtualMachineSecrets(from VirtualMachineSecrets)
  /// computeType "Databricks"
  DatabricksComputeSecrets(from DatabricksComputeSecrets)
  /// Any other computeType, as the base type.
  ComputeSecrets(from ComputeSecrets)
} derive Json(via: json.Value, to: compute_secrets_classification_json, from: parse_compute_secrets_classification)

fn compute_secrets_classification_json(c: ComputeSecretsClassification) -> json.Value {
  match c {
    ComputeSecretsClassification.AksComputeSecrets(x) => json.to_value(x)
    ComputeSecretsClassification.VirtualMachineSecrets(x) => json.to_value(x)
    ComputeSecretsClassification.DatabricksComputeSecrets(x) => json.to_value(x)
    ComputeSecretsClassification.ComputeSecrets(x) => json.to_value(x)
  }
}

fn parse_compute_secrets_classification(v: json.Value) -> ComputeSecretsClassification ! json.DecodeErr {
  match v.get("computeType") {
    Some(json.Value.Str("AKS")) => Ok(ComputeSecretsClassification.AksComputeSecrets(json.from_value[AksComputeSecrets](v)?))
    Some(json.Value.Str("VirtualMachine")) => Ok(ComputeSecretsClassification.VirtualMachineSecrets(json.from_value[VirtualMachineSecrets](v)?))
    Some(json.Value.Str("Databricks")) => Ok(ComputeSecretsClassification.DatabricksComputeSecrets(json.from_value[DatabricksComputeSecrets](v)?))
    _ => Ok(ComputeSecretsClassification.ComputeSecrets(json.from_value[ComputeSecrets](v)?))
  }
}

/// `v` with its discriminator `key` set to `value`, as Go's
/// MarshalJSON writes a subtype's (its keys sorted).
fn with_discriminator(v: json.Value, key: Str, value: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object((fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != key }) + [(key, json.Value.Str(value))]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    other => other
  }
}

