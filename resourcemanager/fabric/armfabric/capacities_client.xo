/// Suspend operation of the specified Fabric capacity instance.
pub fn (c: CapacitiesClient[fx]) begin_suspend(resource_group_name: Str, capacity_name: Str, options: CapacitiesClientBeginSuspendOptions = CapacitiesClientBeginSuspendOptions{}) -> runtime.Poller[CapacitiesClientSuspendResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
