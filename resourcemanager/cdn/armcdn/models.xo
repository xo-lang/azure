/// AFDDomainMTLSParametersClassification: a AFDDomainMTLSParameters by its scenario, Go's AFDDomainMTLSParametersClassification interface.
pub enum AFDDomainMTLSParametersClassification {
  /// scenario "ClientCertificateRequiredAndOriginValidates"
  ClientCertificateRequiredAndOriginValidatesAdvancedSettings(from ClientCertificateRequiredAndOriginValidatesAdvancedSettings)
  /// scenario "ClientCertificateRequiredAndValidated"
  ClientCertificateRequiredAndValidatedAdvancedSettings(from ClientCertificateRequiredAndValidatedAdvancedSettings)
  /// scenario "ClientCertificateValidatedIfPresented"
  ClientCertificateValidatedIfPresentedAdvancedSettings(from ClientCertificateValidatedIfPresentedAdvancedSettings)
  /// scenario "CompleteMtlsPassthroughToOrigin"
  CompleteMtlsPassthroughToOriginAdvancedSettings(from CompleteMtlsPassthroughToOriginAdvancedSettings)
  /// Any other scenario, as the base type.
  AFDDomainMTLSParameters(from AFDDomainMTLSParameters)
} derive Json(via: json.Value, to: afd_domain_mtls_parameters_classification_json, from: parse_afd_domain_mtls_parameters_classification)

fn afd_domain_mtls_parameters_classification_json(c: AFDDomainMTLSParametersClassification) -> json.Value {
  match c {
    AFDDomainMTLSParametersClassification.ClientCertificateRequiredAndOriginValidatesAdvancedSettings(x) => json.to_value(x)
    AFDDomainMTLSParametersClassification.ClientCertificateRequiredAndValidatedAdvancedSettings(x) => json.to_value(x)
    AFDDomainMTLSParametersClassification.ClientCertificateValidatedIfPresentedAdvancedSettings(x) => json.to_value(x)
    AFDDomainMTLSParametersClassification.CompleteMtlsPassthroughToOriginAdvancedSettings(x) => json.to_value(x)
    AFDDomainMTLSParametersClassification.AFDDomainMTLSParameters(x) => json.to_value(x)
  }
}

fn parse_afd_domain_mtls_parameters_classification(v: json.Value) -> AFDDomainMTLSParametersClassification ! json.DecodeErr {
  match v.get("scenario") {
    Some(json.Value.Str("ClientCertificateRequiredAndOriginValidates")) => Ok(AFDDomainMTLSParametersClassification.ClientCertificateRequiredAndOriginValidatesAdvancedSettings(json.from_value[ClientCertificateRequiredAndOriginValidatesAdvancedSettings](v)?))
    Some(json.Value.Str("ClientCertificateRequiredAndValidated")) => Ok(AFDDomainMTLSParametersClassification.ClientCertificateRequiredAndValidatedAdvancedSettings(json.from_value[ClientCertificateRequiredAndValidatedAdvancedSettings](v)?))
    Some(json.Value.Str("ClientCertificateValidatedIfPresented")) => Ok(AFDDomainMTLSParametersClassification.ClientCertificateValidatedIfPresentedAdvancedSettings(json.from_value[ClientCertificateValidatedIfPresentedAdvancedSettings](v)?))
    Some(json.Value.Str("CompleteMtlsPassthroughToOrigin")) => Ok(AFDDomainMTLSParametersClassification.CompleteMtlsPassthroughToOriginAdvancedSettings(json.from_value[CompleteMtlsPassthroughToOriginAdvancedSettings](v)?))
    _ => Ok(AFDDomainMTLSParametersClassification.AFDDomainMTLSParameters(json.from_value[AFDDomainMTLSParameters](v)?))
  }
}

