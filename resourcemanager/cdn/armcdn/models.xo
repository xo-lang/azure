/// Properties of the origin created on the CDN endpoint.
pub struct DeepCreatedOriginProperties {
  /// Origin is enabled for load balancing or not. By default, origin is always enabled.
  pub enabled as "enabled,omitempty": Bool? = None
  /// The address of the origin. It can be a domain name, IPv4 address, or IPv6 address. This should be unique across all origins in an endpoint.
  pub host_name as "hostName,omitempty": Str? = None
  /// The value of the HTTP port. Must be between 1 and 65535.
  pub http_port as "httpPort,omitempty": Int? = None
  /// The value of the HTTPS port. Must be between 1 and 65535.
  pub https_port as "httpsPort,omitempty": Int? = None
  /// The host header value sent to the origin with each request. If you leave this blank, the request hostname determines this value. Azure CDN origins, such as Web Apps, Blob Storage, and Cloud Services require this host header value to match the origin hostname by default.
  pub origin_host_header as "originHostHeader,omitempty": Str? = None
  /// Priority of origin in given origin group for load balancing. Higher priorities will not be used for load balancing if any lower priority origin is healthy.Must be between 1 and 5.
  pub priority as "priority,omitempty": Int? = None
  /// The approval status for the connection to the Private Link
  pub private_endpoint_status as "privateEndpointStatus,omitempty": PrivateEndpointStatus? = None
  /// The Alias of the Private Link resource. Populating this optional field indicates that this origin is 'Private'
  pub private_link_alias as "privateLinkAlias,omitempty": Str? = None
  /// A custom message to be included in the approval request to connect to the Private Link.
  pub private_link_approval_message as "privateLinkApprovalMessage,omitempty": Str? = None
  /// The location of the Private Link resource. Required only if 'privateLinkResourceId' is populated
  pub private_link_location as "privateLinkLocation,omitempty": Str? = None
  /// The Resource Id of the Private Link resource. Populating this optional field indicates that this backend is 'Private'
  pub private_link_resource_id as "privateLinkResourceId,omitempty": Str? = None
  /// Weight of the origin in given origin group for load balancing. Must be between 1 and 1000
  pub weight as "weight,omitempty": Int? = None
} derive Json

