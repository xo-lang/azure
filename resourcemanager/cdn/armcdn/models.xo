pub const ORIGIN_AUTHENTICATION_TOKEN_DESTINATION_HEADER_X_AZURE_AUTHORIZATION: OriginAuthenticationTokenDestinationHeader = OriginAuthenticationTokenDestinationHeader("X-Azure-Authorization")

