  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if profile_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter profileName cannot be empty"))
  }
  path = path.replace("{profileName}", url.path_escape(profile_name))
  if endpoint_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter endpointName cannot be empty"))
  }
  path = path.replace("{endpointName}", url.path_escape(endpoint_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: runtime.marshal_json(custom_domain_properties)})
}

/// Validates the custom domain mapping to ensure it maps to the correct Azure Front Door endpoint in DNS.
pub fn (c: AFDEndpointsClient) validate_custom_domain(resource_group_name: Str, profile_name: Str, endpoint_name: Str, custom_domain_properties: ValidateCustomDomainInput, options: AFDEndpointsClientValidateCustomDomainOptions = AFDEndpointsClientValidateCustomDomainOptions{}) -> AFDEndpointsClientValidateCustomDomainResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let sp = runtime.start_span({}, "AFDEndpointsClient.ValidateCustomDomain", c.setup.pipeline.tracer)
  let req = sp.on(c.validate_custom_domain_create_request(resource_group_name, profile_name, endpoint_name, custom_domain_properties, options) ?? e => return Err(sp.fail(e)))
  let resp = c.setup.pipeline.send(req) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![200].contains(resp.status) {
    return Err(sp.close(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  let out = afd_endpoints_validate_custom_domain_handle(resp) ?? e => return Err(sp.close(azcore.CallErr.Decode(e)))
  sp.end()
  Ok(out)
}
