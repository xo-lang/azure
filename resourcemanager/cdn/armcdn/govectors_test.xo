  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"deploymentStatus\":\"s-deploymentstatus\",\"parameters\":{\"associations\":[{\"patternsToMatch\":[\"s-patternstomatch\"]}],\"isProfileLevel\":true,\"type\":\"WebApplicationFirewall\",\"wafPolicy\":{\"id\":\"s-id\"}},\"profileName\":\"s-profilename\",\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL SecurityPoliciesClient.Get")
