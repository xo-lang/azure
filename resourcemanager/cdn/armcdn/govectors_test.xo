}

fn show_security_policies_client_list_by_profile_response(r: SecurityPoliciesClientListByProfileResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.security_policy_list_result).to_str_lossy()}")
  parts.join(" ")
}

