  let c = new_policies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"customRules\":{\"rules\":[{\"action\":\"s-action\",\"enabledState\":\"s-enabledstate\",\"name\":\"s-name\",\"priority\":7}]},\"endpointLinks\":[{\"id\":\"s-id\"}],\"extendedProperties\":{\"k1\":\"s-extendedproperties\"},\"managedRules\":{\"managedRuleSets\":[{\"anomalyScore\":7,\"ruleSetType\":\"s-rulesettype\",\"ruleSetVersion\":\"s-rulesetversion\"}]},\"policySettings\":{\"defaultCustomBlockResponseBody\":\"s-defaultcustomblockresponsebody\",\"defaultCustomBlockResponseStatusCode\":7,\"defaultRedirectUrl\":\"s-defaultredirecturl\",\"enabledState\":\"s-enabledstate\",\"mode\":\"s-mode\"},\"provisioningState\":\"Succeeded\",\"rateLimitRules\":{\"rules\":[{\"action\":\"s-action\",\"enabledState\":\"s-enabledstate\",\"name\":\"s-name\",\"priority\":7,\"rateLimitDurationInMinutes\":7,\"rateLimitThreshold\":7}]},\"resourceState\":\"s-resourcestate\"},\"sku\":{\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PoliciesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", PoliciesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_policies_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_74)
}

