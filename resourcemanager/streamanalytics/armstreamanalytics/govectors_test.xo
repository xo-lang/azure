test "Go's StreamingJobsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_streaming_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"cluster\":{\"id\":\"s-id\"},\"compatibilityLevel\":\"s-compatibilitylevel\",\"contentStoragePolicy\":\"s-contentstoragepolicy\",\"createdDate\":\"2026-11-06T10:00:00Z\",\"dataLocale\":\"s-datalocale\",\"etag\":\"s-etag\",\"eventsLateArrivalMaxDelayInSeconds\":7,\"eventsOutOfOrderMaxDelayInSeconds\":7,\"eventsOutOfOrderPolicy\":\"s-eventsoutoforderpolicy\",\"functions\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"etag\":\"s-etag\",\"type\":\"Aggregate\"},\"type\":\"s-type\"}],\"inputs\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"datasource\":{\"type\":\"Microsoft.Sql/Server/Database\"},\"etag\":\"s-etag\",\"partitionKey\":\"s-partitionkey\",\"serialization\":{\"properties\":{\"k\":\"v\"},\"type\":\"Avro\"},\"type\":\"Reference\"},\"type\":\"s-type\"}],\"jobId\":\"s-jobid\",\"jobState\":\"s-jobstate\",\"jobStorageAccount\":{\"accountKey\":\"s-accountkey\",\"accountName\":\"s-accountname\",\"authenticationMode\":\"s-authenticationmode\"},\"jobType\":\"s-jobtype\",\"lastOutputEventTime\":\"2026-11-06T10:00:00Z\",\"outputErrorPolicy\":\"s-outputerrorpolicy\",\"outputStartMode\":\"s-outputstartmode\",\"outputStartTime\":\"2026-11-06T10:00:00Z\",\"outputs\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"datasource\":{\"type\":\"Microsoft.DataLake/Accounts\"},\"etag\":\"s-etag\",\"serialization\":{\"properties\":{\"k\":\"v\"},\"type\":\"Avro\"},\"sizeWindow\":1.5,\"timeWindow\":\"s-timewindow\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"sku\":{\"name\":\"s-name\"},\"transformation\":{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"etag\":\"s-etag\",\"query\":\"s-query\",\"streamingUnits\":7,\"validStreamingUnits\":[7]},\"type\":\"s-type\"}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL StreamingJobsClient.NewListPager")
  var pg = c.new_list_pager(StreamingJobsClientListOptions{expand: Some("s-expand")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_streaming_jobs_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_38)
}

fn show_streaming_jobs_client_update_response(r: StreamingJobsClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.streaming_job).to_str_lossy()}")
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  parts.join(" ")
}

