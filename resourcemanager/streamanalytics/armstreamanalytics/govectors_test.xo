  let f = gv_new_fake(os.net)
  let c = new_private_endpoints_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"createdDate\":\"s-createddate\",\"manualPrivateLinkServiceConnections\":[{\"properties\":{\"privateLinkServiceId\":\"https://management.example.test/next?\$skiptoken=2\",\"requestMessage\":\"s-requestmessage\"}}]},\"type\":\"s-type\"}]}")
