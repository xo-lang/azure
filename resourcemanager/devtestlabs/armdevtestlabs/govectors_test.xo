test "Go's ServiceFabricSchedulesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_service_fabric_schedules_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"createdDate\":\"2026-11-06T10:00:00Z\",\"dailyRecurrence\":{\"time\":\"s-time\"},\"hourlyRecurrence\":{\"minute\":7},\"notificationSettings\":{\"emailRecipient\":\"s-emailrecipient\",\"notificationLocale\":\"s-notificationlocale\",\"status\":\"s-status\",\"timeInMinutes\":7,\"webhookUrl\":\"s-webhookurl\"},\"provisioningState\":\"Succeeded\",\"status\":\"s-status\",\"targetResourceId\":\"s-targetresourceid\",\"taskType\":\"s-tasktype\",\"timeZoneId\":\"s-timezoneid\",\"uniqueIdentifier\":\"s-uniqueidentifier\",\"weeklyRecurrence\":{\"time\":\"s-time\",\"weekdays\":[\"s-weekdays\"]}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ServiceFabricSchedulesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", ServiceFabricSchedulesClientListOptions{expand: Some("s-expand"), filter: Some("s-filter"), orderby: Some("s-orderby"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_service_fabric_schedules_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_85)
}

