  let c = new_artifacts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"createdDate\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"filePath\":\"s-filepath\",\"icon\":\"s-icon\",\"parameters\":{\"k\":\"v\"},\"publisher\":\"s-publisher\",\"targetOsType\":\"s-targetostype\",\"title\":\"s-title\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ArtifactsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", ArtifactsClientListOptions{expand: Some("s-expand"), filter: Some("s-filter"), orderby: Some("s-orderby"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_artifacts_client_list_response(r)}")
