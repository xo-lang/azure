test "Go's VirtualMachinesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_machines_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"allowClaim\":true,\"applicableSchedule\":{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"labVmsShutdown\":{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"},\"labVmsStartup\":{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"},\"artifactDeploymentStatus\":{\"artifactsApplied\":7,\"deploymentStatus\":\"s-deploymentstatus\",\"totalArtifacts\":7},\"artifacts\":[{\"artifactId\":\"s-artifactid\",\"artifactTitle\":\"s-artifacttitle\",\"deploymentStatusMessage\":\"s-deploymentstatusmessage\",\"installTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"vmExtensionStatusMessage\":\"s-vmextensionstatusmessage\"}],\"computeId\":\"s-computeid\",\"computeVm\":{\"dataDiskIds\":[\"s-datadiskids\"],\"dataDisks\":[{\"diskSizeGiB\":7,\"diskUri\":\"s-diskuri\",\"managedDiskId\":\"s-manageddiskid\",\"name\":\"s-name\"}],\"networkInterfaceId\":\"s-networkinterfaceid\",\"osDiskId\":\"s-osdiskid\",\"osType\":\"s-ostype\",\"statuses\":[{\"code\":\"s-code\",\"displayStatus\":\"s-displaystatus\",\"message\":\"s-message\"}],\"vmSize\":\"s-vmsize\"},\"createdByUser\":\"s-createdbyuser\",\"createdByUserId\":\"s-createdbyuserid\",\"createdDate\":\"2026-11-06T10:00:00Z\",\"customImageId\":\"s-customimageid\",\"dataDiskParameters\":[{\"attachNewDataDiskOptions\":{\"diskName\":\"s-diskname\",\"diskSizeGiB\":7,\"diskType\":\"s-disktype\"},\"existingLabDiskId\":\"s-existinglabdiskid\",\"hostCaching\":\"s-hostcaching\"}],\"disallowPublicIpAddress\":true,\"environmentId\":\"s-environmentid\",\"expirationDate\":\"2026-11-06T10:00:00Z\",\"fqdn\":\"s-fqdn\",\"galleryImageReference\":{\"offer\":\"s-offer\",\"osType\":\"s-ostype\",\"publisher\":\"s-publisher\",\"sku\":\"s-sku\",\"version\":\"s-version\"},\"isAuthenticationWithSshKey\":true,\"labSubnetName\":\"s-labsubnetname\",\"labVirtualNetworkId\":\"s-labvirtualnetworkid\",\"lastKnownPowerState\":\"s-lastknownpowerstate\",\"networkInterface\":{\"dnsName\":\"s-dnsname\",\"privateIpAddress\":\"s-privateipaddress\",\"publicIpAddress\":\"s-publicipaddress\",\"publicIpAddressId\":\"s-publicipaddressid\",\"rdpAuthority\":\"s-rdpauthority\",\"sharedPublicIpAddressConfiguration\":{},\"sshAuthority\":\"s-sshauthority\",\"subnetId\":\"s-subnetid\",\"virtualNetworkId\":\"s-virtualnetworkid\"},\"notes\":\"s-notes\",\"osType\":\"s-ostype\",\"ownerObjectId\":\"s-ownerobjectid\",\"ownerUserPrincipalName\":\"s-owneruserprincipalname\",\"password\":\"s-password\",\"planId\":\"s-planid\",\"provisioningState\":\"Succeeded\",\"scheduleParameters\":[{\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"status\":\"s-status\",\"targetResourceId\":\"s-targetresourceid\",\"taskType\":\"s-tasktype\",\"timeZoneId\":\"s-timezoneid\"},\"tags\":{\"k1\":\"s-tags\"}}],\"size\":\"s-size\",\"sshKey\":\"s-sshkey\",\"storageType\":\"s-storagetype\",\"uniqueIdentifier\":\"s-uniqueidentifier\",\"userName\":\"s-username\",\"virtualMachineCreationSource\":\"s-virtualmachinecreationsource\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualMachinesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", VirtualMachinesClientListOptions{expand: Some("s-expand"), filter: Some("s-filter"), orderby: Some("s-orderby"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_machines_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_125)
}

fn show_virtual_machines_client_update_response(r: VirtualMachinesClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.lab_virtual_machine).to_str_lossy()}")
  parts.join(" ")
}

