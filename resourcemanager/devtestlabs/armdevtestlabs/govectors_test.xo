test "Go's ServiceFabricsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_service_fabrics_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"applicableSchedule\":{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"labVmsShutdown\":{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"},\"labVmsStartup\":{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"},\"environmentId\":\"s-environmentid\",\"externalServiceFabricId\":\"s-externalservicefabricid\",\"provisioningState\":\"Succeeded\",\"uniqueIdentifier\":\"s-uniqueidentifier\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ServiceFabricsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", ServiceFabricsClientListOptions{expand: Some("s-expand"), filter: Some("s-filter"), orderby: Some("s-orderby"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_service_fabrics_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_93)
}

