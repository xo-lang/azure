test "Go's UpdateRunsClient.NewListByFleetPager" {
  let f = gv_new_fake(os.net)
  let c = new_update_runs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"eTag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"autoUpgradeProfileId\":\"s-autoupgradeprofileid\",\"managedClusterUpdate\":{\"nodeImageSelection\":{\"type\":\"s-type\"},\"upgrade\":{\"kubernetesVersion\":\"s-kubernetesversion\",\"type\":\"s-type\"}},\"provisioningState\":\"Succeeded\",\"status\":{\"nodeImageSelection\":{},\"stages\":[{\"maxConcurrency\":7,\"name\":\"s-name\"}],\"status\":{\"completedTime\":\"2026-11-06T10:00:00Z\",\"error\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"},\"startTime\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\"}},\"strategy\":{\"stages\":[{\"afterStageWaitInSeconds\":7,\"maxConcurrency\":\"s-maxconcurrency\",\"name\":\"s-name\"}]},\"updateStrategyId\":\"s-updatestrategyid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL UpdateRunsClient.NewListByFleetPager")
  var pg = c.new_list_by_fleet_pager("id1/ x", "id2/ x", UpdateRunsClientListByFleetOptions{skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_update_runs_client_list_by_fleet_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_36)
}
