fn show_update_runs_client_list_by_fleet_response(r: UpdateRunsClientListByFleetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.update_run_list_result).to_str_lossy()}")
  parts.join(" ")
}

