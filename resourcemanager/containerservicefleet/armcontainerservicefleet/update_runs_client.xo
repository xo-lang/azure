  if ![200, 202].contains(resp.status) {
    return Err(sp.fail(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  sp.end()
  runtime.new_poller(c.setup.pipeline, req, resp, "", "UpdateRunsClientStopResponse", fn(r: http.Response) -> UpdateRunsClientStopResponse ! Str { update_runs_stop_handle(r) }, traced: true)
}
