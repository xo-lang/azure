test "Go's ActivityClient.NewListByModulePager" {
  let f = gv_new_fake(os.net)
  let c = new_activity_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"creationTime\":\"2026-11-06T10:00:00Z\",\"definition\":\"s-definition\",\"description\":\"s-description\",\"lastModifiedTime\":\"2026-11-06T10:00:00Z\",\"outputTypes\":[{\"name\":\"s-name\",\"type\":\"s-type\"}],\"parameterSets\":[{\"name\":\"s-name\"}]}}]}")
  gv_note(f, "CALL ActivityClient.NewListByModulePager")
  var pg = c.new_list_by_module_pager("id1/ x", "id2/ x", "id3/ x", ActivityClientListByModuleOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_activity_client_list_by_module_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_8)
}

