test "Go's CertificateClient.NewListByAutomationAccountPager" {
  let f = gv_new_fake(os.net)
  let c = new_certificate_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"creationTime\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"expiryTime\":\"2026-11-06T10:00:00Z\",\"isExportable\":true,\"lastModifiedTime\":\"2026-11-06T10:00:00Z\",\"thumbprint\":\"s-thumbprint\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL CertificateClient.NewListByAutomationAccountPager")
  var pg = c.new_list_by_automation_account_pager("id1/ x", "id2/ x", CertificateClientListByAutomationAccountOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_certificate_client_list_by_automation_account_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_14)
}

