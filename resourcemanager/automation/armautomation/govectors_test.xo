test "Go's CredentialClient.NewListByAutomationAccountPager" {
  let f = gv_new_fake(os.net)
  let c = new_credential_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"creationTime\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"lastModifiedTime\":\"2026-11-06T10:00:00Z\",\"userName\":\"s-username\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL CredentialClient.NewListByAutomationAccountPager")
  var pg = c.new_list_by_automation_account_pager("id1/ x", "id2/ x", CredentialClientListByAutomationAccountOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
