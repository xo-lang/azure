  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"activityCount\":7,\"contentLink\":{\"contentHash\":{\"algorithm\":\"s-algorithm\",\"value\":\"s-value\"},\"uri\":\"s-uri\",\"version\":\"s-version\"},\"creationTime\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"error\":{\"code\":\"s-code\",\"message\":\"s-message\"},\"isComposite\":true,\"isGlobal\":true,\"lastModifiedTime\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"sizeInBytes\":7,\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Python3PackageClient.NewListByAutomationAccountPager")
  var pg = c.new_list_by_automation_account_pager("id1/ x", "id2/ x", Python3PackageClientListByAutomationAccountOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_python3_package_client_list_by_automation_account_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
