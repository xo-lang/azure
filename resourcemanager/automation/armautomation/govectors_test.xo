test "Go's JobStreamClient.NewListByJobPager" {
  let f = gv_new_fake(os.net)
  let c = new_job_stream_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"properties\":{\"jobStreamId\":\"s-jobstreamid\",\"streamText\":\"s-streamtext\",\"streamType\":\"s-streamtype\",\"summary\":\"s-summary\",\"time\":\"2026-11-06T10:00:00Z\",\"value\":{\"k1\":{\"k\":\"v\"}}}}]}")
  gv_note(f, "CALL JobStreamClient.NewListByJobPager")
  var pg = c.new_list_by_job_pager("id1/ x", "id2/ x", "id3/ x", JobStreamClientListByJobOptions{client_request_id: Some("s-clientrequestid"), filter: Some("s-filter")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_job_stream_client_list_by_job_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_71)
}

