test "Go's RunbookClient.NewListByAutomationAccountPager" {
  let f = gv_new_fake(os.net)
  let c = new_runbook_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"creationTime\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"draft\":{\"creationTime\":\"2026-11-06T10:00:00Z\",\"draftContentLink\":{\"contentHash\":{\"algorithm\":\"s-algorithm\",\"value\":\"s-value\"},\"uri\":\"s-uri\",\"version\":\"s-version\"},\"inEdit\":true,\"lastModifiedTime\":\"2026-11-06T10:00:00Z\",\"outputTypes\":[\"s-outputtypes\"],\"parameters\":{\"k1\":{\"defaultValue\":\"s-defaultvalue\",\"isMandatory\":true,\"position\":7,\"type\":\"s-type\"}}},\"jobCount\":7,\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedTime\":\"2026-11-06T10:00:00Z\",\"logActivityTrace\":7,\"logProgress\":true,\"logVerbose\":true,\"outputTypes\":[\"s-outputtypes\"],\"parameters\":{\"k1\":{\"defaultValue\":\"s-defaultvalue\",\"isMandatory\":true,\"position\":7,\"type\":\"s-type\"}},\"provisioningState\":\"Succeeded\",\"publishContentLink\":{\"contentHash\":{\"algorithm\":\"s-algorithm\",\"value\":\"s-value\"},\"uri\":\"s-uri\",\"version\":\"s-version\"},\"runbookType\":\"s-runbooktype\",\"runtimeEnvironment\":\"s-runtimeenvironment\",\"state\":\"s-state\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RunbookClient.NewListByAutomationAccountPager")
  var pg = c.new_list_by_automation_account_pager("id1/ x", "id2/ x", RunbookClientListByAutomationAccountOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_runbook_client_list_by_automation_account_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_111)
}

