  let f = gv_new_fake(os.net)
  let c = new_edu_enrollments_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"domains\":[{\"domainNames\":[\"s-domainnames\"],\"failureReason\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"},\"state\":\"s-state\",\"tenantId\":\"s-tenantid\"}],\"failureReason\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EduEnrollmentsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", EduEnrollmentsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_edu_enrollments_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_3)
}

