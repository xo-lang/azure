test "Go's ApplicationsClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_applications_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\"}}},\"kind\":\"s-kind\",\"location\":\"s-location\",\"managedBy\":\"s-managedby\",\"name\":\"s-name\",\"plan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"promotionCode\":\"s-promotioncode\",\"publisher\":\"s-publisher\",\"version\":\"s-version\"},\"properties\":{\"applicationDefinitionId\":\"s-applicationdefinitionid\",\"artifacts\":[{\"name\":\"s-name\",\"type\":\"s-type\",\"uri\":\"s-uri\"}],\"authorizations\":[{\"principalId\":\"s-principalid\",\"roleDefinitionId\":\"s-roledefinitionid\"}],\"billingDetails\":{\"resourceUsageId\":\"s-resourceusageid\"},\"createdBy\":{\"applicationId\":\"s-applicationid\",\"oid\":\"s-oid\",\"puid\":\"s-puid\"},\"customerSupport\":{\"contactName\":\"s-contactname\",\"email\":\"s-email\",\"phone\":\"s-phone\"},\"jitAccessPolicy\":{\"jitAccessEnabled\":true,\"jitApprovalMode\":\"s-jitapprovalmode\",\"jitApprovers\":[{\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"type\":\"s-type\"}],\"maximumJitAccessDuration\":\"s-maximumjitaccessduration\"},\"managedResourceGroupId\":\"s-managedresourcegroupid\",\"managementMode\":\"s-managementmode\",\"outputs\":{\"k\":\"v\"},\"parameters\":{\"k\":\"v\"},\"provisioningState\":\"Succeeded\",\"publisherTenantId\":\"s-publishertenantid\",\"supportUrls\":{\"governmentCloud\":\"s-governmentcloud\",\"publicAzure\":\"s-publicazure\"},\"updatedBy\":{\"applicationId\":\"s-applicationid\",\"oid\":\"s-oid\",\"puid\":\"s-puid\"}},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"model\":\"s-model\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ApplicationsClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(ApplicationsClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_applications_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_24)
}

