  let c = new_application_definitions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"managedBy\":\"s-managedby\",\"name\":\"s-name\",\"properties\":{\"artifacts\":[{\"name\":\"s-name\",\"type\":\"s-type\",\"uri\":\"s-uri\"}],\"authorizations\":[{\"principalId\":\"s-principalid\",\"roleDefinitionId\":\"s-roledefinitionid\"}],\"createUiDefinition\":{\"k\":\"v\"},\"deploymentPolicy\":{\"deploymentMode\":\"s-deploymentmode\"},\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isEnabled\":true,\"lockLevel\":\"s-locklevel\",\"lockingPolicy\":{\"allowedActions\":[\"s-allowedactions\"],\"allowedDataActions\":[\"s-alloweddataactions\"]},\"mainTemplate\":{\"k\":\"v\"},\"managementPolicy\":{\"mode\":\"s-mode\"},\"notificationPolicy\":{\"notificationEndpoints\":[{\"uri\":\"s-uri\"}]},\"packageFileUri\":\"s-packagefileuri\",\"policies\":[{\"name\":\"s-name\",\"parameters\":\"s-parameters\",\"policyDefinitionId\":\"s-policydefinitionid\"}],\"storageAccountId\":\"s-storageaccountid\"},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"model\":\"s-model\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ApplicationDefinitionsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ApplicationDefinitionsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_application_definitions_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_7)
}

