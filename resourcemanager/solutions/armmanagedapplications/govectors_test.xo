  gv_note(f, "CALL JitRequestsClient.BeginCreateOrUpdate")
  match c.begin_create_or_update("id1/ x", "id2/ x", (json.decode_str[JitRequestDefinition]("{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"applicationResourceId\":\"s-applicationresourceid\",\"createdBy\":{\"applicationId\":\"s-applicationid\",\"oid\":\"s-oid\",\"puid\":\"s-puid\"},\"jitAuthorizationPolicies\":[{\"principalId\":\"s-principalid\",\"roleDefinitionId\":\"s-roledefinitionid\"}],\"jitRequestState\":\"s-jitrequeststate\",\"jitSchedulingPolicy\":{\"duration\":\"s-duration\",\"startTime\":\"2026-11-06T10:00:00Z\",\"type\":\"s-type\"},\"provisioningState\":\"Succeeded\",\"publisherTenantId\":\"s-publishertenantid\",\"updatedBy\":{\"applicationId\":\"s-applicationid\",\"oid\":\"s-oid\",\"puid\":\"s-puid\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), JitRequestsClientBeginCreateOrUpdateOptions{}) {
