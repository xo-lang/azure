/// AppServiceCertificateOrdersClientRetrieveSiteSealResponse: the response of AppServiceCertificateOrdersClient.retrieve_site_seal.
pub struct AppServiceCertificateOrdersClientRetrieveSiteSealResponse {
  pub site_seal: SiteSeal
}

fn app_service_certificate_orders_retrieve_site_seal_handle(resp: http.Response) -> AppServiceCertificateOrdersClientRetrieveSiteSealResponse ! Str {
  let v = if resp.body.is_empty() { SiteSeal{} } else { json.decode[SiteSeal](resp.body) ?? e => return Err(e.display()) }
  Ok(AppServiceCertificateOrdersClientRetrieveSiteSealResponse{site_seal: v})
}

fn (c: AppServiceCertificateOrdersClient) retrieve_site_seal_create_request(resource_group_name: Str, certificate_order_name: Str, site_seal_request: SiteSealRequest, options: AppServiceCertificateOrdersClientRetrieveSiteSealOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.CertificateRegistration/certificateOrders/{certificateOrderName}/retrieveSiteSeal"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if certificate_order_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter certificateOrderName cannot be empty"))
  }
  path = path.replace("{certificateOrderName}", url.path_escape(certificate_order_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: runtime.marshal_json(site_seal_request)})
}

/// This method is used to obtain the site seal information for an issued certificate. A site seal is a graphic that the certificate purchaser can embed on their web site to show their visitors information about their SSL certificate. If a web site visitor clicks on the site seal image, a pop-up page is displayed that contains detailed information about the SSL certificate. The site seal token is used to link the site seal graphic image to the appropriate certificate details pop-up page display when a user clicks on the site seal. The site seal images are expected to be static images and hosted by the reseller, to minimize delays for customer page load times.
pub fn (c: AppServiceCertificateOrdersClient) retrieve_site_seal(resource_group_name: Str, certificate_order_name: Str, site_seal_request: SiteSealRequest, options: AppServiceCertificateOrdersClientRetrieveSiteSealOptions = AppServiceCertificateOrdersClientRetrieveSiteSealOptions{}) -> AppServiceCertificateOrdersClientRetrieveSiteSealResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.retrieve_site_seal_create_request(resource_group_name, certificate_order_name, site_seal_request, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  app_service_certificate_orders_retrieve_site_seal_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}

