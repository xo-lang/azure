  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\",\"properties\":{\"serviceSpecification\":{\"logSpecifications\":[{\"blobDuration\":\"s-blobduration\",\"displayName\":\"s-displayname\",\"logFilterPattern\":\"s-logfilterpattern\",\"name\":\"s-name\"}],\"metricSpecifications\":[{\"aggregationType\":\"s-aggregationtype\",\"category\":\"s-category\",\"displayDescription\":\"s-displaydescription\",\"displayName\":\"s-displayname\",\"enableRegionalMdmAccount\":true,\"fillGapWithZero\":true,\"isInternal\":true,\"metricFilterPattern\":\"s-metricfilterpattern\",\"name\":\"s-name\",\"sourceMdmAccount\":\"s-sourcemdmaccount\",\"sourceMdmNamespace\":\"s-sourcemdmnamespace\",\"supportsInstanceLevelAggregation\":true,\"unit\":\"s-unit\"}]}}}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\",\"properties\":{\"serviceSpecification\":{\"logSpecifications\":[{\"blobDuration\":\"s-blobduration\",\"displayName\":\"s-displayname\",\"logFilterPattern\":\"s-logfilterpattern\",\"name\":\"s-name\"}],\"metricSpecifications\":[{\"aggregationType\":\"s-aggregationtype\",\"category\":\"s-category\",\"displayDescription\":\"s-displaydescription\",\"displayName\":\"s-displayname\",\"enableRegionalMdmAccount\":true,\"fillGapWithZero\":true,\"isInternal\":true,\"metricFilterPattern\":\"s-metricfilterpattern\",\"name\":\"s-name\",\"sourceMdmAccount\":\"s-sourcemdmaccount\",\"sourceMdmNamespace\":\"s-sourcemdmnamespace\",\"supportsInstanceLevelAggregation\":true,\"unit\":\"s-unit\"}]}}}]}",
]

test "Go's ProviderClient.NewListOperationsPager" {
  let f = gv_new_fake(os.net)
  let c = new_provider_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\",\"properties\":{\"serviceSpecification\":{\"logSpecifications\":[{\"blobDuration\":\"s-blobduration\",\"displayName\":\"s-displayname\",\"logFilterPattern\":\"s-logfilterpattern\",\"name\":\"s-name\"}],\"metricSpecifications\":[{\"aggregationType\":\"s-aggregationtype\",\"category\":\"s-category\",\"displayDescription\":\"s-displaydescription\",\"displayName\":\"s-displayname\",\"enableRegionalMdmAccount\":true,\"fillGapWithZero\":true,\"isInternal\":true,\"metricFilterPattern\":\"s-metricfilterpattern\",\"name\":\"s-name\",\"sourceMdmAccount\":\"s-sourcemdmaccount\",\"sourceMdmNamespace\":\"s-sourcemdmnamespace\",\"supportsInstanceLevelAggregation\":true,\"unit\":\"s-unit\"}]}}}]}")
  gv_note(f, "CALL ProviderClient.NewListOperationsPager")
  var pg = c.new_list_operations_pager(ProviderClientListOperationsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_provider_client_list_operations_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_22)
}
