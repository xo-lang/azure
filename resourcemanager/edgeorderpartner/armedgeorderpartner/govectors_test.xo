// Generated from the output of a local Go program that calls every
// public method of each client of armedgeorderpartner v0.7.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_apis_client_manage_inventory_metadata_response(r: APISClientManageInventoryMetadataResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL APISClient.BeginManageInventoryMetadata",
  "REQ POST https://management.example.test/subscriptions/sub-test/providers/Microsoft.EdgeOrderPartner/locations/id2%2F%20x/productFamilies/id1%2F%20x/inventories/id3%2F%20x/manageInventoryMetadata?api-version=2020-12-01-preview",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"configurationOnDevice\":{\"configurationIdentifier\":\"s-configurationidentifier\"},\"inventoryMetadata\":\"s-inventorymetadata\"}",
  "  SERVED 200 ",
  "OUT: ",
]

test "Go's APISClient.BeginManageInventoryMetadata" {
  let f = gv_new_fake(os.net)
  let c = new_apis_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL APISClient.BeginManageInventoryMetadata")
  match c.begin_manage_inventory_metadata("id1/ x", "id2/ x", "id3/ x", (json.decode_str[ManageInventoryMetadataRequest]("{\"configurationOnDevice\":{\"configurationIdentifier\":\"s-configurationidentifier\"},\"inventoryMetadata\":\"s-inventorymetadata\"}") ?? e => fault("${e}")), APISClientBeginManageInventoryMetadataOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_apis_client_manage_inventory_metadata_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

