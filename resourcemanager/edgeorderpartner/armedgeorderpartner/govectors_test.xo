test "Go's APISClient.NewSearchInventoriesPager" {
  let f = gv_new_fake(os.net)
  let c = new_apis_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"properties\":{\"configuration\":{\"configurationIdentifier\":\"s-configurationidentifier\",\"configurationIdentifierOnDevice\":\"s-configurationidentifierondevice\",\"familyIdentifier\":\"s-familyidentifier\",\"productIdentifier\":\"s-productidentifier\",\"productLineIdentifier\":\"s-productlineidentifier\"},\"details\":{\"billing\":{\"billingType\":\"s-billingtype\",\"status\":\"s-status\"},\"configuration\":{},\"inventory\":{\"additionalData\":{\"k1\":\"s-additionaldata\"}},\"inventoryMetadata\":\"s-inventorymetadata\",\"inventorySecrets\":{\"k1\":\"s-inventorysecrets\"},\"orderItem\":{\"status\":{\"displayName\":\"s-displayname\",\"stageName\":\"s-stagename\",\"stageStatus\":\"s-stagestatus\",\"startTime\":\"2026-11-06T10:00:00Z\"},\"subscription\":{\"id\":\"s-id\",\"quotaId\":\"s-quotaid\",\"state\":\"s-state\"}}},\"inventory\":{\"location\":\"s-location\",\"registrationAllowed\":true,\"status\":\"s-status\"},\"location\":\"s-location\",\"managementResource\":{\"armId\":\"s-armid\",\"tenantId\":\"s-tenantid\"},\"orderItem\":{\"armId\":\"s-armid\",\"orderItemType\":\"s-orderitemtype\"},\"serialNumber\":\"s-serialnumber\"}}]}")
  gv_note(f, "CALL APISClient.NewSearchInventoriesPager")
  var pg = c.new_search_inventories_pager((json.decode_str[SearchInventoriesRequest]("{\"familyIdentifier\":\"s-familyidentifier\",\"serialNumber\":\"s-serialnumber\"}") ?? e => fault("${e}")), APISClientSearchInventoriesOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_apis_client_search_inventories_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_3)
