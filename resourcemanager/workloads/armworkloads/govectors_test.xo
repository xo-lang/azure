  let f = gv_new_fake(os.net)
  let c = new_monitors_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"appLocation\":\"s-applocation\",\"errors\":{\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"innerError\":{\"innerError\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}},\"message\":\"s-message\",\"target\":\"s-target\"},\"logAnalyticsWorkspaceArmId\":\"s-loganalyticsworkspacearmid\",\"managedResourceGroupConfiguration\":{\"name\":\"s-name\"},\"monitorSubnet\":\"s-monitorsubnet\",\"msiArmId\":\"s-msiarmid\",\"provisioningState\":\"Succeeded\",\"routingPreference\":\"s-routingpreference\",\"storageAccountArmId\":\"s-storageaccountarmid\",\"zoneRedundancyPreference\":\"s-zoneredundancypreference\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL MonitorsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", MonitorsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_monitors_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_7)
}

