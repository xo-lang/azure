test "Go's ProviderInstancesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_provider_instances_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"name\":\"s-name\",\"properties\":{\"errors\":{\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"innerError\":{\"innerError\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}},\"message\":\"s-message\",\"target\":\"s-target\"},\"providerSettings\":{\"dbName\":\"s-dbname\",\"dbPassword\":\"s-dbpassword\",\"dbPasswordUri\":\"s-dbpassworduri\",\"dbPort\":\"s-dbport\",\"dbUsername\":\"s-dbusername\",\"hostname\":\"s-hostname\",\"providerType\":\"Db2\",\"sapSid\":\"s-sapsid\",\"sslCertificateUri\":\"s-sslcertificateuri\",\"sslPreference\":\"s-sslpreference\"},\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ProviderInstancesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ProviderInstancesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_provider_instances_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_14)
}

