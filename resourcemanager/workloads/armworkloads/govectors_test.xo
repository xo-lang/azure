  let f = gv_new_fake(os.net)
  let c = new_sap_virtual_instances_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"configuration\":{\"appLocation\":\"s-applocation\",\"configurationType\":\"Deployment\",\"infrastructureConfiguration\":{\"appResourceGroup\":\"s-appresourcegroup\",\"customResourceNames\":{\"namingPatternType\":\"FullResourceName\"},\"databaseType\":\"s-databasetype\",\"deploymentType\":\"SingleServer\",\"subnetId\":\"s-subnetid\"},\"softwareConfiguration\":{\"centralServerVmId\":\"s-centralservervmid\",\"softwareInstallationType\":\"External\"}},\"environment\":\"s-environment\",\"errors\":{\"properties\":{\"code\":\"s-code\",\"message\":\"s-message\"}},\"health\":\"s-health\",\"managedResourceGroupConfiguration\":{\"name\":\"s-name\"},\"provisioningState\":\"Succeeded\",\"sapProduct\":\"s-sapproduct\",\"state\":\"s-state\",\"status\":\"s-status\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SAPVirtualInstancesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(SAPVirtualInstancesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_sap_virtual_instances_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_42)
}

