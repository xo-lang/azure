  var pg = c.new_list_by_hub_pager("id1/ x", "id2/ x", KpiClientListByHubOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
