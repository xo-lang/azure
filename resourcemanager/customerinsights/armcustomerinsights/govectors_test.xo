test "Go's AuthorizationPoliciesClient.NewListByHubPager" {
  let f = gv_new_fake(os.net)
  let c = new_authorization_policies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"permissions\":[\"s-permissions\"],\"policyName\":\"s-policyname\",\"primaryKey\":\"s-primarykey\",\"secondaryKey\":\"s-secondarykey\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AuthorizationPoliciesClient.NewListByHubPager")
  var pg = c.new_list_by_hub_pager("id1/ x", "id2/ x", AuthorizationPoliciesClientListByHubOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_authorization_policies_client_list_by_hub_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_2)
}

