  let c = new_kpi_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"aliases\":[{\"aliasName\":\"s-aliasname\",\"expression\":\"s-expression\"}],\"calculationWindow\":\"s-calculationwindow\",\"calculationWindowFieldName\":\"s-calculationwindowfieldname\",\"description\":{\"k1\":\"s-description\"},\"displayName\":{\"k1\":\"s-displayname\"},\"entityType\":\"s-entitytype\",\"entityTypeName\":\"s-entitytypename\",\"expression\":\"s-expression\",\"extracts\":[{\"expression\":\"s-expression\",\"extractName\":\"s-extractname\"}],\"filter\":\"s-filter\",\"function\":\"s-function\",\"groupBy\":[\"s-groupby\"],\"groupByMetadata\":[{\"displayName\":{\"k1\":\"s-displayname\"},\"fieldName\":\"s-fieldname\",\"fieldType\":\"s-fieldtype\"}],\"kpiName\":\"s-kpiname\",\"participantProfilesMetadata\":[{\"typeName\":\"s-typename\"}],\"provisioningState\":\"Succeeded\",\"tenantId\":\"s-tenantid\",\"thresHolds\":{\"increasingKpi\":true,\"lowerLimit\":1.5,\"upperLimit\":1.5},\"unit\":\"s-unit\"},\"type\":\"s-type\"}]}")
