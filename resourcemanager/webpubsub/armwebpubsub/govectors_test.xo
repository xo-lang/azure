  "CALL Client.CheckNameAvailability",
  "REQ POST https://management.example.test/subscriptions/sub-test/providers/Microsoft.SignalRService/locations/id1%2F%20x/checkNameAvailability?api-version=2024-03-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
