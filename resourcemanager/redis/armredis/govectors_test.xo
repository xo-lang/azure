uthmethod\",\"rdb-backup-enabled\":\"s-rdbbackupenabled\",\"rdb-backup-frequency\":\"s-rdbbackupfrequency\",\"rdb-backup-max-snapshot-count\":\"s-rdbbackupmaxsnapshotcount\",\"rdb-storage-connection-string\":\"s-rdbstorageconnectionstring\",\"storage-subscription-id\":\"s-storagesubscriptionid\",\"zonal-configuration\":\"s-zonalconfiguration\"},\"redisVersion\":\"s-redisversion\",\"replicasPerMaster\":7,\"replicasPerPrimary\":7,\"shardCount\":7,\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\"},\"sslPort\":7,\"staticIP\":\"s-staticip\",\"subnetId\":\"s-subnetid\",\"tenantSettings\":{\"k1\":\"s-tenantsettings\"},\"updateChannel\":\"s-updatechannel\",\"zonalAllocationPolicy\":\"s-zonalallocationpolicy\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
