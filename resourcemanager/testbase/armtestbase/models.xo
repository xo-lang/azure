/// AccountSKUPatch: AccountSKU in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct AccountSKUPatch {
  /// The capabilities of a SKU.
  pub capabilities as "capabilities,omitempty": json.Patch[List[AccountSKUCapability]] = json.Patch.Absent
  /// The locations that the SKU is available.
