  pub resource_type as "resourceType,omitempty": json.Patch[Str] = json.Patch.Absent
  /// The tier of this particular SKU.
  pub tier as "tier,omitempty": json.Patch[Tier] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: AccountSKU) patch() -> AccountSKUPatch {
  AccountSKUPatch{
    resource_type: match m.resource_type {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    name: match m.name {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    tier: match m.tier {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    capabilities: match m.capabilities {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    locations: match m.locations {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
