  }
  path = path.replace("{testBaseAccountName}", url.path_escape(test_base_account_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: runtime.marshal_json(parameters)})
}

/// Checks that the Test Base Package name and version is valid and is not already in use.
pub fn (c: AccountsClient) check_package_name_availability(resource_group_name: Str, test_base_account_name: Str, parameters: PackageCheckNameAvailabilityParameters, options: AccountsClientCheckPackageNameAvailabilityOptions = AccountsClientCheckPackageNameAvailabilityOptions{}) -> AccountsClientCheckPackageNameAvailabilityResponse ! azcore.CallErr uses (net.dial, clock, rand) {
