test "Go's TestResultsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_test_results_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"analysisSummaries\":[{\"analysisStatus\":\"s-analysisstatus\",\"grade\":\"s-grade\",\"name\":\"s-name\"}],\"applicationName\":\"s-applicationname\",\"applicationVersion\":\"s-applicationversion\",\"baselineTestResultId\":\"s-baselinetestresultid\",\"buildRevision\":\"s-buildrevision\",\"buildVersion\":\"s-buildversion\",\"executionStatus\":\"s-executionstatus\",\"flightingRing\":\"s-flightingring\",\"grade\":\"s-grade\",\"isDownloadDataAvailable\":true,\"isVideoAvailable\":true,\"kbNumber\":\"s-kbnumber\",\"osName\":\"s-osname\",\"packageId\":\"s-packageid\",\"packageVersion\":\"s-packageversion\",\"releaseName\":\"s-releasename\",\"releaseVersionDate\":\"2026-11-06T10:00:00Z\",\"testRunTime\":\"s-testruntime\",\"testStatus\":\"s-teststatus\",\"testType\":\"s-testtype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL TestResultsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", OsUpdateType("sha1"), TestResultsClientListOptions{filter: Some("s-filter")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_test_results_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_39)
}

