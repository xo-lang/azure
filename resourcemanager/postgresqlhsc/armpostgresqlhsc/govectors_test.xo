test "Go's ClustersClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_clusters_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"aadAuthEnabled\":\"s-aadauthenabled\",\"administratorLogin\":\"s-administratorlogin\",\"administratorLoginPassword\":\"s-administratorloginpassword\",\"authConfig\":{\"activeDirectoryAuth\":\"s-activedirectoryauth\",\"passwordAuth\":\"s-passwordauth\"},\"citusVersion\":\"s-citusversion\",\"coordinatorEnablePublicIpAccess\":true,\"coordinatorServerEdition\":\"s-coordinatorserveredition\",\"coordinatorStorageQuotaInMb\":7,\"coordinatorVCores\":7,\"dataEncryption\":{\"primaryKeyUri\":\"s-primarykeyuri\",\"primaryUserAssignedIdentityId\":\"s-primaryuserassignedidentityid\",\"type\":\"s-type\"},\"databaseName\":\"s-databasename\",\"earliestRestoreTime\":\"2026-11-06T10:00:00Z\",\"enableGeoBackup\":true,\"enableHa\":true,\"enableShardsOnCoordinator\":true,\"maintenanceWindow\":{\"customWindow\":\"s-customwindow\",\"dayOfWeek\":7,\"startHour\":7,\"startMinute\":7},\"nodeCount\":7,\"nodeEnablePublicIpAccess\":true,\"nodeServerEdition\":\"s-nodeserveredition\",\"nodeStorageQuotaInMb\":7,\"nodeVCores\":7,\"passwordEnabled\":\"s-passwordenabled\",\"pointInTimeUTC\":\"2026-11-06T10:00:00Z\",\"postgresqlVersion\":\"s-postgresqlversion\",\"preferredPrimaryZone\":\"s-preferredprimaryzone\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"readReplicas\":[\"s-readreplicas\"],\"serverNames\":[{\"fullyQualifiedDomainName\":\"s-fullyqualifieddomainname\",\"name\":\"s-name\"}],\"sourceLocation\":\"s-sourcelocation\",\"sourceResourceId\":\"s-sourceresourceid\",\"state\":\"s-state\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ClustersClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ClustersClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_clusters_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_9)
}

fn show_clusters_client_list_response(r: ClustersClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster_list_result).to_str_lossy()}")
  parts.join(" ")
}

