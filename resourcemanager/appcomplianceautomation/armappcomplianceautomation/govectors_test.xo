test "Go's EvidenceClient.CreateOrUpdate" {
  let f = gv_new_fake(os.net)
  let c = new_evidence_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"controlId\":\"s-controlid\",\"evidenceType\":\"s-evidencetype\",\"extraData\":\"s-extradata\",\"filePath\":\"s-filepath\",\"provisioningState\":\"Succeeded\",\"responsibilityId\":\"s-responsibilityid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL EvidenceClient.CreateOrUpdate")
  match c.create_or_update("id1/ x", "id2/ x", (json.decode_str[EvidenceResource]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"controlId\":\"s-controlid\",\"evidenceType\":\"s-evidencetype\",\"extraData\":\"s-extradata\",\"filePath\":\"s-filepath\",\"provisioningState\":\"Succeeded\",\"responsibilityId\":\"s-responsibilityid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), EvidenceClientCreateOrUpdateOptions{offer_guid: Some("s-offerguid"), report_creator_tenant_id: Some("s-reportcreatortenantid")}) {
    Ok(r) => gv_note(f, "OUT: ${show_evidence_client_create_or_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

