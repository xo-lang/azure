test "Go's SnapshotClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_snapshot_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"complianceResults\":[{\"complianceName\":\"s-compliancename\"}],\"createdAt\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"reportProperties\":{\"certRecords\":[{\"certificationStatus\":\"s-certificationstatus\",\"ingestionStatus\":\"s-ingestionstatus\",\"offerGuid\":\"s-offerguid\"}],\"complianceStatus\":{\"m365\":{\"failedCount\":7,\"manualCount\":7,\"notApplicableCount\":7,\"passedCount\":7,\"pendingCount\":7}},\"errors\":[\"s-errors\"],\"lastTriggerTime\":\"2026-11-06T10:00:00Z\",\"nextTriggerTime\":\"2026-11-06T10:00:00Z\",\"offerGuid\":\"s-offerguid\",\"provisioningState\":\"Succeeded\",\"resources\":[{\"accountId\":\"s-accountid\",\"resourceId\":\"s-resourceid\",\"resourceKind\":\"s-resourcekind\",\"resourceOrigin\":\"s-resourceorigin\",\"resourceType\":\"s-resourcetype\"}],\"status\":\"s-status\",\"storageInfo\":{\"accountName\":\"s-accountname\",\"location\":\"s-location\",\"resourceGroup\":\"s-resourcegroup\",\"subscriptionId\":\"s-subscriptionid\"},\"subscriptions\":[\"s-subscriptions\"],\"tenantId\":\"s-tenantid\",\"timeZone\":\"s-timezone\",\"triggerTime\":\"2026-11-06T10:00:00Z\"},\"reportSystemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"snapshotName\":\"s-snapshotname\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SnapshotClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", SnapshotClientListOptions{filter: Some("s-filter"), offer_guid: Some("s-offerguid"), orderby: Some("s-orderby"), report_creator_tenant_id: Some("s-reportcreatortenantid"), select_: Some("s-select"), skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_snapshot_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_28)
}

