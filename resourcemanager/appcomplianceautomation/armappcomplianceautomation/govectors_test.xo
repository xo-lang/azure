test "Go's WebhookClient.Delete" {
  let f = gv_new_fake(os.net)
  let c = new_webhook_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL WebhookClient.Delete")
  match c.delete("id1/ x", "id2/ x", WebhookClientDeleteOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_webhook_client_delete_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_30)
}

