test "Go's WebhookClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_webhook_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"contentType\":\"s-contenttype\",\"deliveryStatus\":\"s-deliverystatus\",\"enableSslVerification\":\"s-enablesslverification\",\"events\":[\"s-events\"],\"payloadUrl\":\"s-payloadurl\",\"provisioningState\":\"Succeeded\",\"sendAllEvents\":\"s-sendallevents\",\"status\":\"s-status\",\"tenantId\":\"s-tenantid\",\"updateWebhookKey\":\"s-updatewebhookkey\",\"webhookId\":\"s-webhookid\",\"webhookKey\":\"s-webhookkey\",\"webhookKeyEnabled\":\"s-webhookkeyenabled\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WebhookClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", WebhookClientListOptions{filter: Some("s-filter"), offer_guid: Some("s-offerguid"), orderby: Some("s-orderby"), report_creator_tenant_id: Some("s-reportcreatortenantid"), select_: Some("s-select"), skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_webhook_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_32)
}

