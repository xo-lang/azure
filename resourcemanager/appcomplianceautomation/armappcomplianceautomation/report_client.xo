    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "ReportClientVerifyResponse", fn(r: http.Response) -> ReportClientVerifyResponse ! Str { report_verify_handle(r) }, traced: true)
  }
  let sp = runtime.start_span({}, "ReportClient.BeginVerify", c.setup.pipeline.tracer)
  let req = c.verify_create_request(report_name, options) ?? e => return Err(sp.fail(e))
  let resp = c.setup.pipeline.send(sp.on(req)) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![200, 202].contains(resp.status) {
    return Err(sp.fail(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  sp.end()
  runtime.new_poller(c.setup.pipeline, req, resp, "location", "ReportClientVerifyResponse", fn(r: http.Response) -> ReportClientVerifyResponse ! Str { report_verify_handle(r) }, traced: true)
}
