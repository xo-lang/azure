fn show_machines_client_list_by_resource_group_response(r: MachinesClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.machine_list_result).to_str_lossy()}")
  parts.join(" ")
}

