test "Go's LicensesClient.BeginUpdate" {
  let f = gv_new_fake(os.net)
  let c = new_licenses_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"licenseDetails\":{\"assignedLicenses\":7,\"edition\":\"s-edition\",\"immutableId\":\"s-immutableid\",\"processors\":7,\"state\":\"s-state\",\"target\":\"s-target\",\"type\":\"s-type\",\"volumeLicenseDetails\":[{\"invoiceId\":\"s-invoiceid\",\"programYear\":\"s-programyear\"}]},\"licenseType\":\"s-licensetype\",\"provisioningState\":\"Succeeded\",\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL LicensesClient.BeginUpdate")
  match c.begin_update("id1/ x", "id2/ x", (json.decode_str[LicenseUpdate]("{\"properties\":{\"licenseDetails\":{\"edition\":\"s-edition\",\"processors\":7,\"state\":\"s-state\",\"target\":\"s-target\",\"type\":\"s-type\"},\"licenseType\":\"s-licensetype\"},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), LicensesClientBeginUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_licenses_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_19)
}

