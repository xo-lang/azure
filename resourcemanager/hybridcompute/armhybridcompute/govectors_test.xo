test "Go's MachinesClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_machines_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"adFqdn\":\"s-adfqdn\",\"agentConfiguration\":{\"configMode\":\"s-configmode\",\"extensionsAllowList\":[{\"publisher\":\"s-publisher\",\"type\":\"s-type\"}],\"extensionsBlockList\":[{\"publisher\":\"s-publisher\",\"type\":\"s-type\"}],\"extensionsEnabled\":\"s-extensionsenabled\",\"guestConfigurationEnabled\":\"s-guestconfigurationenabled\",\"incomingConnectionsPorts\":[\"s-incomingconnectionsports\"],\"proxyBypass\":[\"s-proxybypass\"],\"proxyUrl\":\"s-proxyurl\"},\"agentUpgrade\":{\"correlationId\":\"s-correlationid\",\"desiredVersion\":\"s-desiredversion\",\"enableAutomaticUpgrade\":true,\"lastAttemptDesiredVersion\":\"s-lastattemptdesiredversion\",\"lastAttemptMessage\":\"s-lastattemptmessage\",\"lastAttemptStatus\":\"s-lastattemptstatus\",\"lastAttemptTimestamp\":\"2026-11-06T10:00:00Z\"},\"agentVersion\":\"s-agentversion\",\"clientPublicKey\":\"s-clientpublickey\",\"cloudMetadata\":{\"provider\":\"s-provider\"},\"detectedProperties\":{\"k1\":\"s-detectedproperties\"},\"displayName\":\"s-displayname\",\"dnsFqdn\":\"s-dnsfqdn\",\"domainName\":\"s-domainname\",\"errorDetails\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"extensions\":[{\"name\":\"s-name\",\"status\":{\"code\":\"s-code\",\"displayStatus\":\"s-displaystatus\",\"level\":\"s-level\",\"message\":\"s-message\",\"time\":\"2026-11-06T10:00:00Z\"},\"type\":\"s-type\",\"typeHandlerVersion\":\"s-typehandlerversion\"}],\"firmwareProfile\":{\"serialNumber\":\"s-serialnumber\",\"type\":\"s-type\"},\"hardwareProfile\":{\"numberOfCpuSockets\":7,\"processors\":[{\"name\":\"s-name\",\"numberOfCores\":7}],\"totalPhysicalMemoryInBytes\":7},\"hardwareResourceId\":\"s-hardwareresourceid\",\"identityKeyStore\":\"s-identitykeystore\",\"lastStatusChange\":\"2026-11-06T10:00:00Z\",\"licenseProfile\":{\"esuProfile\":{\"assignedLicense\":{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"},\"assignedLicenseImmutableId\":\"s-assignedlicenseimmutableid\",\"esuEligibility\":\"s-esueligibility\",\"esuKeyState\":\"s-esukeystate\",\"licenseAssignmentState\":\"s-licenseassignmentstate\",\"serverType\":\"s-servertype\"},\"licenseChannel\":\"s-licensechannel\",\"licenseStatus\":\"s-licensestatus\",\"productProfile\":{\"billingEndDate\":\"2026-11-06T10:00:00Z\",\"billingStartDate\":\"2026-11-06T10:00:00Z\",\"disenrollmentDate\":\"2026-11-06T10:00:00Z\",\"enrollmentDate\":\"2026-11-06T10:00:00Z\",\"error\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"},\"productType\":\"s-producttype\",\"subscriptionStatus\":\"s-subscriptionstatus\"},\"softwareAssurance\":{\"softwareAssuranceCustomer\":true}},\"locationData\":{\"city\":\"s-city\",\"countryOrRegion\":\"s-countryorregion\",\"district\":\"s-district\",\"name\":\"s-name\"},\"machineFqdn\":\"s-machinefqdn\",\"mssqlDiscovered\":\"s-mssqldiscovered\",\"networkProfile\":{\"networkInterfaces\":[{\"id\":\"s-id\",\"macAddress\":\"s-macaddress\",\"name\":\"s-name\"}]},\"osEdition\":\"s-osedition\",\"osName\":\"s-osname\",\"osProfile\":{\"computerName\":\"s-computername\",\"linuxConfiguration\":{\"patchSettings\":{\"assessmentMode\":\"s-assessmentmode\",\"enableHotpatching\":true,\"patchMode\":\"s-patchmode\"}},\"windowsConfiguration\":{\"patchSettings\":{\"assessmentMode\":\"s-assessmentmode\",\"enableHotpatching\":true,\"patchMode\":\"s-patchmode\"}}},\"osSku\":\"s-ossku\",\"osType\":\"s-ostype\",\"osVersion\":\"s-osversion\",\"parentClusterResourceId\":\"s-parentclusterresourceid\",\"privateLinkScopeResourceId\":\"https://management.example.test/next?\$skiptoken=2\",\"provisioningState\":\"Succeeded\",\"serviceStatuses\":{\"extensionService\":{\"startupType\":\"s-startuptype\",\"status\":\"s-status\"},\"guestConfigurationService\":{\"startupType\":\"s-startuptype\",\"status\":\"s-status\"}},\"status\":\"s-status\",\"statusReason\":\"s-statusreason\",\"storageProfile\":{\"disks\":[{\"diskType\":\"s-disktype\",\"generatedId\":\"s-generatedid\",\"id\":\"s-id\",\"maxSizeInBytes\":7,\"name\":\"s-name\",\"path\":\"s-path\",\"usedSpaceInBytes\":7}]},\"tpmEkCertificate\":\"s-tpmekcertificate\",\"vmId\":\"s-vmid\",\"vmUuid\":\"s-vmuuid\"},\"resources\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"autoUpgradeMinorVersion\":true,\"enableAutomaticUpgrade\":true,\"forceUpdateTag\":\"s-forceupdatetag\",\"instanceView\":{\"name\":\"s-name\",\"type\":\"s-type\",\"typeHandlerVersion\":\"s-typehandlerversion\"},\"protectedSettings\":{\"k1\":{\"k\":\"v\"}},\"provisioningState\":\"Succeeded\",\"publisher\":\"s-publisher\",\"settings\":{\"k1\":{\"k\":\"v\"}},\"type\":\"s-type\",\"typeHandlerVersion\":\"s-typehandlerversion\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}],\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL MachinesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(MachinesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_machines_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_39)
}

fn show_machines_client_update_response(r: MachinesClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.machine).to_str_lossy()}")
  parts.join(" ")
}

