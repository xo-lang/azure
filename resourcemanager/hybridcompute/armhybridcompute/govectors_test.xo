test "Go's MachineExtensionsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_machine_extensions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"autoUpgradeMinorVersion\":true,\"enableAutomaticUpgrade\":true,\"forceUpdateTag\":\"s-forceupdatetag\",\"instanceView\":{\"name\":\"s-name\",\"status\":{\"code\":\"s-code\",\"displayStatus\":\"s-displaystatus\",\"level\":\"s-level\",\"message\":\"s-message\",\"time\":\"2026-11-06T10:00:00Z\"},\"type\":\"s-type\",\"typeHandlerVersion\":\"s-typehandlerversion\"},\"protectedSettings\":{\"k1\":{\"k\":\"v\"}},\"provisioningState\":\"Succeeded\",\"publisher\":\"s-publisher\",\"settings\":{\"k1\":{\"k\":\"v\"}},\"type\":\"s-type\",\"typeHandlerVersion\":\"s-typehandlerversion\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL MachineExtensionsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", MachineExtensionsClientListOptions{expand: Some("s-expand")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_machine_extensions_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_28)
}

