  let c = new_settings_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"gatewayProperties\":{\"gatewayResourceId\":\"s-gatewayresourceid\"},\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL SettingsClient.Patch")
  match c.patch("id1/ x", "id2/ x", "id3/ x", "id4/ x", "id5/ x", (json.decode_str[Settings]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"gatewayProperties\":{\"gatewayResourceId\":\"s-gatewayresourceid\"},\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), SettingsClientPatchOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_settings_client_patch_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_63)
}

fn show_settings_client_update_response(r: SettingsClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.settings).to_str_lossy()}")
  parts.join(" ")
}

const GO_64: List[Str] = [
  "CALL SettingsClient.Update",
  "REQ PUT https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/id2%2F%20x/id3%2F%20x/id4%2F%20x/providers/Microsoft.HybridCompute/settings/id5%2F%20x?api-version=2026-07-15",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"gatewayProperties\":{\"gatewayResourceId\":\"s-gatewayresourceid\"},\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}",
  "  SERVED 200 {\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"gatewayProperties\":{\"gatewayResourceId\":\"s-gatewayresourceid\"},\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}",
  "OUT: body={\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"gatewayProperties\":{\"gatewayResourceId\":\"s-gatewayresourceid\"},\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}",
]

test "Go's SettingsClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_settings_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"gatewayProperties\":{\"gatewayResourceId\":\"s-gatewayresourceid\"},\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL SettingsClient.Update")
  match c.update("id1/ x", "id2/ x", "id3/ x", "id4/ x", "id5/ x", (json.decode_str[Settings]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"gatewayProperties\":{\"gatewayResourceId\":\"s-gatewayresourceid\"},\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), SettingsClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_settings_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_64)
}
