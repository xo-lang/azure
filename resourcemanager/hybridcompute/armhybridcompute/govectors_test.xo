test "Go's LicensesClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_licenses_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"licenseDetails\":{\"assignedLicenses\":7,\"edition\":\"s-edition\",\"immutableId\":\"s-immutableid\",\"processors\":7,\"state\":\"s-state\",\"target\":\"s-target\",\"type\":\"s-type\",\"volumeLicenseDetails\":[{\"invoiceId\":\"s-invoiceid\",\"programYear\":\"s-programyear\"}]},\"licenseType\":\"s-licensetype\",\"provisioningState\":\"Succeeded\",\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL LicensesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", LicensesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_licenses_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_22)
}

