/// `v` with its discriminator `key` set to `value`, as Go's
/// MarshalJSON writes a subtype's (its keys sorted).
fn with_discriminator(v: json.Value, key: Str, value: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object((fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != key }) + [(key, json.Value.Str(value))]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    other => other
  }
}

/// Metadata pertaining to creation and last modification of the resource.
pub struct SystemData {
  /// The timestamp of resource creation (UTC).
  pub created_at as "createdAt,omitempty": azcore.DateTime? = None
  /// The identity that created the resource.
  pub created_by as "createdBy,omitempty": Str? = None
  /// The type of identity that created the resource.
  pub created_by_type as "createdByType,omitempty": CreatedByType? = None
  /// The timestamp of resource last modification (UTC)
  pub last_modified_at as "lastModifiedAt,omitempty": azcore.DateTime? = None
  /// The identity that last modified the resource.
  pub last_modified_by as "lastModifiedBy,omitempty": Str? = None
  /// The type of identity that last modified the resource.
  pub last_modified_by_type as "lastModifiedByType,omitempty": CreatedByType? = None
} derive Json

/// Common fields that are returned in the response for all Azure Resource Manager resources
pub struct Resource {
  /// Fully qualified resource ID for the resource. E.g. "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/{resourceProviderNamespace}/{resourceType}/{resourceName}"
  pub id as "id,omitempty": Str? = None
  /// The name of the resource
  pub name as "name,omitempty": Str? = None
  /// Azure Resource Manager metadata containing createdBy and modifiedBy information.
  pub system_data as "systemData,omitempty": SystemData? = None
  /// The type of the resource. E.g. "Microsoft.Compute/virtualMachines" or "Microsoft.Storage/storageAccounts"
  pub type_ as "type,omitempty": Str? = None
} derive Json

