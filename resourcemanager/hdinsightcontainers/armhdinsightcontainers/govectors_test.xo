  gv_note(f, "CALL ClusterJobsClient.BeginRunJob")
  match c.begin_run_job("id1/ x", "id2/ x", "id3/ x", (json.decode_str[ClusterJob]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"action\":\"s-action\",\"actionResult\":\"s-actionresult\",\"args\":\"s-args\",\"entryClass\":\"s-entryclass\",\"flinkConfiguration\":{\"k1\":\"https://management.example.test/next?\$skiptoken=2\"},\"jarName\":\"s-jarname\",\"jobId\":\"s-jobid\",\"jobJarDirectory\":\"s-jobjardirectory\",\"jobName\":\"s-jobname\",\"jobOutput\":\"s-joboutput\",\"jobType\":\"FlinkJob\",\"lastSavePoint\":\"s-lastsavepoint\",\"runId\":\"s-runid\",\"savePointName\":\"s-savepointname\",\"status\":\"s-status\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), ClusterJobsClientBeginRunJobOptions{}) {
