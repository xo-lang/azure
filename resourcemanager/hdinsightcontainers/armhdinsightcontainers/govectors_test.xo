  gv_note(f, "CALL ClustersClient.BeginUpgradeManualRollback")
  match c.begin_upgrade_manual_rollback("id1/ x", "id2/ x", "id3/ x", (json.decode_str[ClusterUpgradeRollback]("{\"properties\":{\"upgradeHistory\":\"s-upgradehistory\"}}") ?? e => fault("${e}")), ClustersClientBeginUpgradeManualRollbackOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_clusters_client_upgrade_manual_rollback_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_22)
}

fn show_clusters_client_get_response(r: ClustersClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster).to_str_lossy()}")
  parts.join(" ")
}

