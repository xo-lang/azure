  gv_note(f, "CALL ClustersClient.NewListByClusterPoolNamePager")
  var pg = c.new_list_by_cluster_pool_name_pager("id1/ x", "id2/ x", ClustersClientListByClusterPoolNameOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
