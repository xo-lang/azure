  let f = gv_new_fake(os.net)
  let c = new_cluster_libraries_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL ClusterLibrariesClient.BeginManageLibraries")
  match c.begin_manage_libraries("id1/ x", "id2/ x", "id3/ x", (json.decode_str[ClusterLibraryManagementOperation]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"action\":\"s-action\",\"libraries\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"groupId\":\"s-groupid\",\"message\":\"s-message\",\"name\":\"s-name\",\"remarks\":\"s-remarks\",\"status\":\"s-status\",\"timestamp\":\"2026-11-06T10:00:00Z\",\"type\":\"maven\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), ClusterLibrariesClientBeginManageLibrariesOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_cluster_libraries_client_manage_libraries_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_5)
}

