fn show_clusters_client_upgrade_response(r: ClustersClientUpgradeResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster).to_str_lossy()}")
  parts.join(" ")
}

