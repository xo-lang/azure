test "Go's ClustersClient.BeginUpgrade" {
  let f = gv_new_fake(os.net)
  let c = new_clusters_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"clusterProfile\":{\"authorizationProfile\":{\"groupIds\":[\"s-groupids\"],\"userIds\":[\"s-userids\"]},\"autoscaleProfile\":{\"autoscaleType\":\"s-autoscaletype\",\"enabled\":true,\"gracefulDecommissionTimeout\":7,\"loadBasedConfig\":{\"cooldownPeriod\":7,\"maxNodes\":7,\"minNodes\":7,\"pollInterval\":7,\"scalingRules\":[{\"actionType\":\"s-actiontype\",\"evaluationCount\":7,\"scalingMetric\":\"s-scalingmetric\"}]},\"scheduleBasedConfig\":{\"defaultCount\":7,\"schedules\":[{\"count\":7,\"endTime\":\"s-endtime\",\"startTime\":\"s-starttime\"}],\"timeZone\":\"s-timezone\"}},\"clusterAccessProfile\":{\"enableInternalIngress\":true,\"privateLinkServiceId\":\"https://management.example.test/next?\$skiptoken=2\"},\"clusterVersion\":\"s-clusterversion\",\"components\":[{\"name\":\"s-name\",\"version\":\"s-version\"}],\"connectivityProfile\":{\"ssh\":[{\"endpoint\":\"s-endpoint\",\"privateSshEndpoint\":\"s-privatesshendpoint\"}],\"web\":{\"fqdn\":\"s-fqdn\",\"privateFqdn\":\"s-privatefqdn\"}},\"flinkProfile\":{\"catalogOptions\":{\"hive\":{\"metastoreDbConnectionAuthenticationMode\":\"s-metastoredbconnectionauthenticationmode\",\"metastoreDbConnectionPasswordSecret\":\"s-metastoredbconnectionpasswordsecret\",\"metastoreDbConnectionURL\":\"s-metastoredbconnectionurl\",\"metastoreDbConnectionUserName\":\"s-metastoredbconnectionusername\"}},\"deploymentMode\":\"s-deploymentmode\",\"historyServer\":{\"cpu\":1.5,\"memory\":7},\"jobManager\":{\"cpu\":1.5,\"memory\":7},\"jobSpec\":{\"args\":\"s-args\",\"entryClass\":\"s-entryclass\",\"jarName\":\"s-jarname\",\"jobJarDirectory\":\"s-jobjardirectory\",\"savePointName\":\"s-savepointname\",\"upgradeMode\":\"s-upgrademode\"},\"numReplicas\":7,\"storage\":{\"storageUri\":\"s-storageuri\",\"storagekey\":\"s-storagekey\"},\"taskManager\":{\"cpu\":1.5,\"memory\":7}},\"identityProfile\":{\"msiClientId\":\"s-msiclientid\",\"msiObjectId\":\"s-msiobjectid\",\"msiResourceId\":\"s-msiresourceid\"},\"kafkaProfile\":{\"connectivityEndpoints\":{\"bootstrapServerEndpoint\":\"s-bootstrapserverendpoint\",\"brokerEndpoints\":[\"s-brokerendpoints\"]},\"diskStorage\":{\"dataDiskSize\":7,\"dataDiskType\":\"s-datadisktype\"},\"enableKRaft\":true,\"enablePublicEndpoints\":true,\"remoteStorageUri\":\"s-remotestorageuri\"},\"llapProfile\":{\"k1\":{\"k\":\"v\"}},\"logAnalyticsProfile\":{\"applicationLogs\":{\"stdErrorEnabled\":true,\"stdOutEnabled\":true},\"enabled\":true,\"metricsEnabled\":true},\"managedIdentityProfile\":{\"identityList\":[{\"clientId\":\"s-clientid\",\"objectId\":\"s-objectid\",\"resourceId\":\"s-resourceid\",\"type\":\"s-type\"}]},\"ossVersion\":\"s-ossversion\",\"prometheusProfile\":{\"enabled\":true},\"rangerPluginProfile\":{\"enabled\":true},\"rangerProfile\":{\"rangerAdmin\":{\"admins\":[\"s-admins\"],\"database\":{\"host\":\"s-host\",\"name\":\"s-name\",\"passwordSecretRef\":\"s-passwordsecretref\",\"username\":\"s-username\"}},\"rangerAudit\":{\"storageAccount\":\"s-storageaccount\"},\"rangerUsersync\":{\"enabled\":true,\"groups\":[\"s-groups\"],\"mode\":\"s-mode\",\"userMappingLocation\":\"s-usermappinglocation\",\"users\":[\"s-users\"]}},\"scriptActionProfiles\":[{\"name\":\"s-name\",\"parameters\":\"s-parameters\",\"services\":[\"s-services\"],\"shouldPersist\":true,\"timeoutInMinutes\":7,\"type\":\"s-type\",\"url\":\"s-url\"}],\"secretsProfile\":{\"keyVaultResourceId\":\"s-keyvaultresourceid\",\"secrets\":[{\"keyVaultObjectName\":\"s-keyvaultobjectname\",\"referenceName\":\"s-referencename\",\"type\":\"s-type\",\"version\":\"s-version\"}]},\"serviceConfigsProfiles\":[{\"configs\":[{\"component\":\"s-component\"}],\"serviceName\":\"s-servicename\"}],\"sparkProfile\":{\"defaultStorageUrl\":\"s-defaultstorageurl\",\"metastoreSpec\":{\"dbConnectionAuthenticationMode\":\"s-dbconnectionauthenticationmode\",\"dbName\":\"s-dbname\",\"dbPasswordSecretName\":\"s-dbpasswordsecretname\",\"dbServerHost\":\"s-dbserverhost\",\"dbUserName\":\"s-dbusername\",\"keyVaultId\":\"s-keyvaultid\",\"thriftUrl\":\"s-thrifturl\"},\"userPluginsSpec\":{\"plugins\":[{\"path\":\"s-path\"}]}},\"sshProfile\":{\"count\":7,\"podPrefix\":\"s-podprefix\",\"vmSize\":\"s-vmsize\"},\"stubProfile\":{\"k1\":{\"k\":\"v\"}},\"trinoProfile\":{\"catalogOptions\":{\"hive\":[{\"catalogName\":\"s-catalogname\",\"metastoreDbConnectionAuthenticationMode\":\"s-metastoredbconnectionauthenticationmode\",\"metastoreDbConnectionPasswordSecret\":\"s-metastoredbconnectionpasswordsecret\",\"metastoreDbConnectionURL\":\"s-metastoredbconnectionurl\",\"metastoreDbConnectionUserName\":\"s-metastoredbconnectionusername\",\"metastoreWarehouseDir\":\"s-metastorewarehousedir\"}]},\"coordinator\":{\"debug\":{\"enable\":true,\"port\":7,\"suspend\":true},\"highAvailabilityEnabled\":true},\"userPluginsSpec\":{\"plugins\":[{\"enabled\":true,\"name\":\"s-name\",\"path\":\"s-path\"}]},\"userTelemetrySpec\":{\"storage\":{\"hivecatalogName\":\"s-hivecatalogname\",\"hivecatalogSchema\":\"s-hivecatalogschema\",\"partitionRetentionInDays\":7,\"path\":\"s-path\"}},\"worker\":{\"debug\":{\"enable\":true,\"port\":7,\"suspend\":true}}}},\"clusterType\":\"s-clustertype\",\"computeProfile\":{\"availabilityZones\":[\"s-availabilityzones\"],\"nodes\":[{\"count\":7,\"type\":\"s-type\",\"vmSize\":\"s-vmsize\"}]},\"deploymentId\":\"s-deploymentid\",\"provisioningState\":\"Succeeded\",\"status\":\"s-status\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ClustersClient.BeginUpgrade")
  match c.begin_upgrade("id1/ x", "id2/ x", "id3/ x", (json.decode_str[ClusterUpgrade]("{\"properties\":{\"upgradeType\":\"AKSPatchUpgrade\"}}") ?? e => fault("${e}")), ClustersClientBeginUpgradeOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_clusters_client_upgrade_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_21)
}

fn show_clusters_client_upgrade_manual_rollback_response(r: ClustersClientUpgradeManualRollbackResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster).to_str_lossy()}")
  parts.join(" ")
}

