fn show_clusters_client_list_instance_views_response(r: ClustersClientListInstanceViewsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster_instance_views_result).to_str_lossy()}")
  parts.join(" ")
}

