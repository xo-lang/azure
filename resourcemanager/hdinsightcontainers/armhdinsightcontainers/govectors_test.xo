-msiobjectid\",\"msiResourceId\":\"s-msiresourceid\"},\"kafkaProfile\":{\"connectivityEndpoints\":{\"bootstrapServerEndpoint\":\"s-bootstrapserverendpoint\",\"brokerEndpoints\":[\"s-brokerendpoints\"]},\"diskStorage\":{\"dataDiskSize\":7,\"dataDiskType\":\"s-datadisktype\"},\"enableKRaft\":true,\"enablePublicEndpoints\":true,\"remoteStorageUri\":\"s-remotestorageuri\"},\"llapProfile\":{\"k1\":{\"k\":\"v\"}},\"logAnalyticsProfile\":{\"applicationLogs\":{\"stdErrorEnabled\":true,\"stdOutEnabled\":true},\"enabled\":true,\"metricsEnabled\":true},\"managedIdentityProfile\":{\"identityList\":[{\"clientId\":\"s-clientid\",\"objectId\":\"s-objectid\",\"resourceId\":\"s-resourceid\",\"type\":\"s-type\"}]},\"ossVersion\":\"s-ossversion\",\"prometheusProfile\":{\"enabled\":true},\"rangerPluginProfile\":{\"enabled\":true},\"rangerProfile\":{\"rangerAdmin\":{\"admins\":[\"s-admins\"],\"database\":{\"host\":\"s-host\",\"name\":\"s-name\",\"passwordSecretRef\":\"s-passwordsecretref\",\"username\":\"s-username\"}},\"rangerAudit\":{\"storageAccount\":\"s-storageaccount\"},\"rangerUsersync\":{\"enabled\":true,\"groups\":[\"s-groups\"],\"mode\":\"s-mode\",\"userMappingLocation\":\"s-usermappinglocation\",\"users\":[\"s-users\"]}},\"scriptActionProfiles\":[{\"name\":\"s-name\",\"parameters\":\"s-parameters\",\"services\":[\"s-services\"],\"shouldPersist\":true,\"timeoutInMinutes\":7,\"type\":\"s-type\",\"url\":\"s-url\"}],\"secretsProfile\":{\"keyVaultResourceId\":\"s-keyvaultresourceid\",\"secrets\":[{\"keyVaultObjectName\":\"s-keyvaultobjectname\",\"referenceName\":\"s-referencename\",\"type\":\"s-type\",\"version\":\"s-version\"}]},\"serviceConfigsProfiles\":[{\"configs\":[{\"component\":\"s-component\"}],\"serviceName\":\"s-servicename\"}],\"sparkProfile\":{\"defaultStorageUrl\":\"s-defaultstorageurl\",\"metastoreSpec\":{\"dbConnectionAuthenticationMode\":\"s-dbconnectionauthenticationmode\",\"dbName\":\"s-dbname\",\"dbPasswordSecretName\":\"s-dbpasswordsecretname\",\"dbServerHost\