,\"countryOrRegion\":\"s-countryorregion\",\"phone\":\"s-phone\",\"postalCode\":\"s-postalcode\",\"recipientName\":\"s-recipientname\",\"stateOrProvince\":\"s-stateorprovince\",\"streetAddress1\":\"s-streetaddress1\",\"streetAddress2\":\"s-streetaddress2\"},\"state\":\"s-state\",\"storageAccountId\":\"s-storageaccountid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k\":\"v\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL JobsClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(JobsClientListBySubscriptionOptions{accept_language: Some("s-acceptlanguage"), filter: Some("s-filter"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_jobs_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_5)
}

