// Generated from the output of a local Go program that calls every
// public method of each client of armstorageimportexport v0.7.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_bit_locker_keys_client_list_response(r: BitLockerKeysClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.get_bit_locker_keys_response).to_str_lossy()}")
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL BitLockerKeysClient.NewListPager",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id2%2F%20x/providers/Microsoft.ImportExport/jobs/id1%2F%20x/listBitLockerKeys?api-version=2021-01-01",
  "  H accept-language=s-acceptlanguage | accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"value\":[{\"bitLockerKey\":\"s-bitlockerkey\",\"driveId\":\"s-driveid\"}]}",
  "OUT page 1: body={\"value\":[{\"bitLockerKey\":\"s-bitlockerkey\",\"driveId\":\"s-driveid\"}]}",
  "OUT page 2: no more",
]

test "Go's BitLockerKeysClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_bit_locker_keys_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"value\":[{\"bitLockerKey\":\"s-bitlockerkey\",\"driveId\":\"s-driveid\"}]}")
  gv_note(f, "CALL BitLockerKeysClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", BitLockerKeysClientListOptions{accept_language: Some("s-acceptlanguage")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_bit_locker_keys_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_0)
}

