  "OUT page 1: body={\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"additionalShippingInformation\":\"s-additionalshippinginformation\",\"alternateLocations\":[\"s-alternatelocations\"],\"city\":\"s-city\",\"countryOrRegion\":\"s-countryorregion\",\"phone\":\"s-phone\",\"postalCode\":\"s-postalcode\",\"recipientName\":\"s-recipientname\",\"stateOrProvince\":\"s-stateorprovince\",\"streetAddress1\":\"s-streetaddress1\",\"streetAddress2\":\"s-streetaddress2\",\"supportedCarriers\":[\"s-supportedcarriers\"]},\"type\":\"s-type\"}]}",
  "OUT page 2: no more",
]

test "Go's LocationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_locations_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"additionalShippingInformation\":\"s-additionalshippinginformation\",\"alternateLocations\":[\"s-alternatelocations\"],\"city\":\"s-city\",\"countryOrRegion\":\"s-countryorregion\",\"phone\":\"s-phone\",\"postalCode\":\"s-postalcode\",\"recipientName\":\"s-recipientname\",\"stateOrProvince\":\"s-stateorprovince\",\"streetAddress1\":\"s-streetaddress1\",\"streetAddress2\":\"s-streetaddress2\",\"supportedCarriers\":[\"s-supportedcarriers\"]},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL LocationsClient.NewListPager")
  var pg = c.new_list_pager(LocationsClientListOptions{accept_language: Some("s-acceptlanguage")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_locations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_8)
}

fn show_operations_client_list_response(r: OperationsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.list_operations_response).to_str_lossy()}")
  parts.join(" ")
}

const GO_9: List[Str] = [
  "CALL OperationsClient.NewListPager",
  "REQ GET https://management.example.test/providers/Microsoft.ImportExport/operations?api-version=2021-01-01",
  "  H accept-language=s-acceptlanguage | accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\"}]}",
  "OUT page 1: body={\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\"}]}",
  "OUT page 2: no more",
]

