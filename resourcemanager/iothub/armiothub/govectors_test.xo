{\"endpoints\":{},\"enrichments\":[{\"key\":\"s-key\",\"value\":\"s-value\"}],\"fallbackRoute\":{\"condition\":\"s-condition\",\"endpointNames\":[\"s-endpointnames\"],\"isEnabled\":true,\"name\":\"s-name\",\"source\":\"s-source\"},\"routes\":[{\"condition\":\"s-condition\",\"isEnabled\":true,\"name\":\"s-name\",\"source\":\"s-source\"}]},\"state\":\"s-state\",\"storageEndpoints\":{\"k1\":{\"authenticationType\":\"s-authenticationtype\",\"connectionString\":\"s-connectionstring\",\"containerName\":\"s-containername\",\"identity\":{\"userAssignedIdentity\":\"s-userassignedidentity\"},\"sasTtlAsIso8601\":\"s-sasttlasiso8601\"}}},\"sku\":{\"capacity\":7,\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ResourceClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ResourceClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_resource_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_30)
}

fn show_resource_client_list_by_subscription_response(r: ResourceClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.description_list_result).to_str_lossy()}")
  parts.join(" ")
}

