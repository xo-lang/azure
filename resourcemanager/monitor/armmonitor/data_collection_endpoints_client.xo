    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "", "DataCollectionEndpointsClientReconcileNSPResponse", fn(r: http.Response) -> DataCollectionEndpointsClientReconcileNSPResponse ! Str { data_collection_endpoints_reconcile_nsp_handle(r) })
}
