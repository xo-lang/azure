  let c = new_baselines_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"baselines\":[{\"aggregation\":\"s-aggregation\",\"timestamps\":[\"2026-11-06T10:00:00Z\"]}],\"interval\":\"s-interval\",\"namespace\":\"s-namespace\",\"timespan\":\"s-timespan\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BaselinesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", BaselinesClientListOptions{aggregation: Some("s-aggregation"), filter: Some("s-filter"), interval: Some("s-interval"), metricnames: Some("s-metricnames"), metricnamespace: Some("s-metricnamespace"), result_type: Some(ResultType("s-resulttype")), sensitivities: Some("s-sensitivities"), timespan: Some("s-timespan")}) ?? e => fault("${e}")
