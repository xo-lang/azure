  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"data\":[{\"workspace\":{\"id\":\"s-id\",\"location\":\"s-location\",\"properties\":{\"customerId\":\"s-customerid\"}}}],\"dataStatus\":\"s-datastatus\",\"onboardingStatus\":\"s-onboardingstatus\",\"resourceId\":\"s-resourceid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL VMInsightsClient.GetOnboardingStatus")
  match c.get_onboarding_status("id1/ x", VMInsightsClientGetOnboardingStatusOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_vm_insights_client_get_onboarding_status_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_113)
}
