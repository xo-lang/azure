fn show_data_collection_rules_client_list_by_subscription_response(r: DataCollectionRulesClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.data_collection_rule_resource_list_result).to_str_lossy()}")
