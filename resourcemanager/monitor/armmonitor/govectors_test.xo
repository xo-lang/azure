test "Go's ScheduledQueryRuleClient.NewListNSPPager" {
  let f = gv_new_fake(os.net)
  let c = new_scheduled_query_rule_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"networkSecurityPerimeter\":{\"id\":\"s-id\",\"location\":\"s-location\",\"perimeterGuid\":\"s-perimeterguid\"},\"profile\":{\"accessRules\":[{\"name\":\"s-name\"}],\"accessRulesVersion\":7,\"diagnosticSettingsVersion\":7,\"enabledLogCategories\":[\"s-enabledlogcategories\"],\"name\":\"s-name\"},\"provisioningIssues\":[{\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"issueType\":\"s-issuetype\",\"severity\":\"s-severity\"}}],\"provisioningState\":\"Succeeded\",\"resourceAssociation\":{\"accessMode\":\"s-accessmode\",\"name\":\"s-name\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ScheduledQueryRuleClient.NewListNSPPager")
  var pg = c.new_list_nsp_pager("id1/ x", "id2/ x", ScheduledQueryRuleClientListNSPOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_scheduled_query_rule_client_list_nsp_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_97)
}

