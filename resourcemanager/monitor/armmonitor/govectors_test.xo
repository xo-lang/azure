test "Go's ActionGroupsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_action_groups_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"armRoleReceivers\":[{\"name\":\"s-name\",\"roleId\":\"s-roleid\",\"useCommonAlertSchema\":true}],\"automationRunbookReceivers\":[{\"automationAccountId\":\"s-automationaccountid\",\"isGlobalRunbook\":true,\"managedIdentity\":\"s-managedidentity\",\"name\":\"s-name\",\"runbookName\":\"s-runbookname\",\"serviceUri\":\"s-serviceuri\",\"useCommonAlertSchema\":true,\"webhookResourceId\":\"s-webhookresourceid\"}],\"azureAppPushReceivers\":[{\"emailAddress\":\"s-emailaddress\",\"name\":\"s-name\"}],\"azureFunctionReceivers\":[{\"functionAppResourceId\":\"s-functionappresourceid\",\"functionName\":\"s-functionname\",\"httpTriggerUrl\":\"s-httptriggerurl\",\"managedIdentity\":\"s-managedidentity\",\"name\":\"s-name\",\"useCommonAlertSchema\":true}],\"emailReceivers\":[{\"emailAddress\":\"s-emailaddress\",\"name\":\"s-name\",\"status\":\"s-status\",\"useCommonAlertSchema\":true}],\"enabled\":true,\"eventHubReceivers\":[{\"eventHubName\":\"s-eventhubname\",\"eventHubNameSpace\":\"s-eventhubnamespace\",\"managedIdentity\":\"s-managedidentity\",\"name\":\"s-name\",\"subscriptionId\":\"s-subscriptionid\",\"tenantId\":\"s-tenantid\",\"useCommonAlertSchema\":true}],\"groupShortName\":\"s-groupshortname\",\"incidentReceivers\":[{\"connection\":{\"id\":\"s-id\",\"name\":\"s-name\"},\"incidentManagementService\":\"s-incidentmanagementservice\",\"mappings\":{\"k1\":\"s-mappings\"},\"name\":\"s-name\"}],\"itsmReceivers\":[{\"connectionId\":\"s-connectionid\",\"name\":\"s-name\",\"region\":\"s-region\",\"ticketConfiguration\":\"s-ticketconfiguration\",\"workspaceId\":\"s-workspaceid\"}],\"logicAppReceivers\":[{\"callbackUrl\":\"s-callbackurl\",\"managedIdentity\":\"s-managedidentity\",\"name\":\"s-name\",\"resourceId\":\"s-resourceid\",\"useCommonAlertSchema\":true}],\"smsReceivers\":[{\"countryCode\":\"s-countrycode\",\"name\":\"s-name\",\"phoneNumber\":\"s-phonenumber\",\"status\":\"s-status\"}],\"voiceReceivers\":[{\"countryCode\":\"s-countrycode\",\"name\":\"s-name\",\"phoneNumber\":\"s-phonenumber\"}],\"webhookReceivers\":[{\"identifierUri\":\"s-identifieruri\",\"managedIdentity\":\"s-managedidentity\",\"name\":\"s-name\",\"objectId\":\"s-objectid\",\"serviceUri\":\"s-serviceuri\",\"tenantId\":\"s-tenantid\",\"useAadAuth\":true,\"useCommonAlertSchema\":true}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ActionGroupsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ActionGroupsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_action_groups_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_8)
}

fn show_action_groups_client_list_by_subscription_id_response(r: ActionGroupsClientListBySubscriptionIDResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.action_group_list).to_str_lossy()}")
  parts.join(" ")
}

