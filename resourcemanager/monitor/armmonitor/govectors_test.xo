test "Go's PrivateLinkScopedResourcesClient.NewListByPrivateLinkScopePager" {
  let f = gv_new_fake(os.net)
  let c = new_private_link_scoped_resources_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"kind\":\"s-kind\",\"linkedResourceId\":\"https://management.example.test/next?\$skiptoken=2\",\"provisioningState\":\"Succeeded\",\"subscriptionLocation\":\"s-subscriptionlocation\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PrivateLinkScopedResourcesClient.NewListByPrivateLinkScopePager")
  var pg = c.new_list_by_private_link_scope_pager("id1/ x", "id2/ x", PrivateLinkScopedResourcesClientListByPrivateLinkScopeOptions{kind: Some("s-kind")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_private_link_scoped_resources_client_list_by_private_link_scope_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_88)
}

