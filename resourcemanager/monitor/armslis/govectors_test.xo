test "Go's Client.NewListByParentPager" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"name\":\"s-name\",\"properties\":{\"baselineProperties\":{\"baseline\":{\"evaluationCalculationType\":\"s-evaluationcalculationtype\",\"evaluationPeriodDays\":7,\"value\":1.5}},\"category\":\"s-category\",\"description\":\"s-description\",\"destinationAmwAccounts\":[{\"identity\":\"s-identity\",\"resourceId\":\"s-resourceid\"}],\"destinationMetrics\":[{\"metricName\":\"s-metricname\",\"metricNamespace\":\"s-metricnamespace\"}],\"enableAlert\":true,\"evaluationType\":\"s-evaluationtype\",\"executionState\":{\"message\":\"s-message\",\"state\":\"s-state\"},\"provisioningState\":\"Succeeded\",\"sliProperties\":{\"goodSignals\":{\"signalFormula\":\"s-signalformula\"},\"signals\":{\"signalFormula\":\"s-signalformula\"},\"totalSignals\":{\"signalFormula\":\"s-signalformula\"},\"windowUptimeCriteria\":{\"comparator\":\"s-comparator\",\"target\":1.5}},\"streamingRuleId\":\"s-streamingruleid\",\"streamingRuleLastUpdatedTimestamp\":\"2026-11-06T10:00:00Z\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Client.NewListByParentPager")
  var pg = c.new_list_by_parent_pager("id1/ x", ClientListByParentOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_list_by_parent_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_3)
}
