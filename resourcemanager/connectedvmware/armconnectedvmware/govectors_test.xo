test "Go's HostsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_hosts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"cpuMhz\":7,\"customResourceName\":\"s-customresourcename\",\"datastoreIds\":[\"s-datastoreids\"],\"inventoryItemId\":\"s-inventoryitemid\",\"memorySizeGB\":7,\"moName\":\"s-moname\",\"moRefId\":\"s-morefid\",\"networkIds\":[\"s-networkids\"],\"overallCpuUsageMHz\":7,\"overallMemoryUsageGB\":7,\"provisioningState\":\"Succeeded\",\"statuses\":[{\"lastUpdatedAt\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"reason\":\"s-reason\",\"severity\":\"s-severity\",\"status\":\"s-status\",\"type\":\"s-type\"}],\"uuid\":\"s-uuid\",\"vCenterId\":\"s-vcenterid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL HostsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", HostsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_hosts_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_15)
}

