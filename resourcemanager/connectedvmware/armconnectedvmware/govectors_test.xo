test "Go's VirtualMachineTemplatesClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_machine_templates_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"customResourceName\":\"s-customresourcename\",\"disks\":[{\"controllerKey\":7,\"deviceKey\":7,\"deviceName\":\"s-devicename\",\"diskMode\":\"s-diskmode\",\"diskObjectId\":\"s-diskobjectid\",\"diskSizeGB\":7,\"diskType\":\"s-disktype\",\"label\":\"s-label\",\"name\":\"s-name\",\"unitNumber\":7}],\"firmwareType\":\"s-firmwaretype\",\"folderPath\":\"s-folderpath\",\"inventoryItemId\":\"s-inventoryitemid\",\"memorySizeMB\":7,\"moName\":\"s-moname\",\"moRefId\":\"s-morefid\",\"networkInterfaces\":[{\"deviceKey\":7,\"ipAddresses\":[\"s-ipaddresses\"],\"ipSettings\":{\"allocationMethod\":\"s-allocationmethod\",\"ipAddress\":\"s-ipaddress\",\"primaryWinsServer\":\"s-primarywinsserver\",\"secondaryWinsServer\":\"s-secondarywinsserver\",\"subnetMask\":\"s-subnetmask\"},\"label\":\"s-label\",\"macAddress\":\"s-macaddress\",\"name\":\"s-name\",\"networkId\":\"s-networkid\",\"networkMoName\":\"s-networkmoname\",\"networkMoRefId\":\"s-networkmorefid\",\"nicType\":\"s-nictype\",\"powerOnBoot\":\"s-poweronboot\"}],\"numCPUs\":7,\"numCoresPerSocket\":7,\"osName\":\"s-osname\",\"osType\":\"s-ostype\",\"provisioningState\":\"Succeeded\",\"statuses\":[{\"lastUpdatedAt\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"reason\":\"s-reason\",\"severity\":\"s-severity\",\"status\":\"s-status\",\"type\":\"s-type\"}],\"toolsVersion\":\"s-toolsversion\",\"toolsVersionStatus\":\"s-toolsversionstatus\",\"uuid\":\"s-uuid\",\"vCenterId\":\"s-vcenterid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualMachineTemplatesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", VirtualMachineTemplatesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_machine_templates_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_52)
}

fn show_virtual_machine_templates_client_list_response(r: VirtualMachineTemplatesClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.virtual_machine_templates_list).to_str_lossy()}")
  parts.join(" ")
}

