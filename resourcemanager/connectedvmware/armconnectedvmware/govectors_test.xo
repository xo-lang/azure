fn show_virtual_machine_instances_client_list_response(r: VirtualMachineInstancesClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.virtual_machine_instances_list).to_str_lossy()}")
  parts.join(" ")
}

