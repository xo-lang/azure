  let f = gv_new_fake(os.net)
  let c = new_virtual_machine_instances_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"hardwareProfile\":{\"cpuHotAddEnabled\":true,\"cpuHotRemoveEnabled\":true,\"memoryHotAddEnabled\":true,\"memorySizeMB\":7,\"numCPUs\":7,\"numCoresPerSocket\":7},\"infrastructureProfile\":{\"customResourceName\":\"s-customresourcename\",\"firmwareType\":\"s-firmwaretype\",\"folderPath\":\"s-folderpath\",\"instanceUuid\":\"s-instanceuuid\",\"inventoryItemId\":\"s-inventoryitemid\",\"moName\":\"s-moname\",\"moRefId\":\"s-morefid\",\"smbiosUuid\":\"s-smbiosuuid\",\"templateId\":\"s-templateid\",\"vCenterId\":\"s-vcenterid\"},\"networkProfile\":{\"networkInterfaces\":[{\"deviceKey\":7,\"label\":\"s-label\",\"macAddress\":\"s-macaddress\",\"name\":\"s-name\",\"networkId\":\"s-networkid\",\"networkMoName\":\"s-networkmoname\",\"networkMoRefId\":\"s-networkmorefid\",\"nicType\":\"s-nictype\",\"powerOnBoot\":\"s-poweronboot\"}]},\"osProfile\":{\"adminPassword\":\"s-adminpassword\",\"adminUsername\":\"s-adminusername\",\"computerName\":\"s-computername\",\"guestId\":\"s-guestid\",\"osSku\":\"s-ossku\",\"osType\":\"s-ostype\",\"toolsRunningStatus\":\"s-toolsrunningstatus\",\"toolsVersion\":\"s-toolsversion\",\"toolsVersionStatus\":\"s-toolsversionstatus\"},\"placementProfile\":{\"clusterId\":\"s-clusterid\",\"datastoreId\":\"s-datastoreid\",\"hostId\":\"s-hostid\",\"resourcePoolId\":\"s-resourcepoolid\"},\"powerState\":\"s-powerstate\",\"provisioningState\":\"Succeeded\",\"resourceUid\":\"s-resourceuid\",\"securityProfile\":{\"uefiSettings\":{\"secureBootEnabled\":true}},\"statuses\":[{\"lastUpdatedAt\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"reason\":\"s-reason\",\"severity\":\"s-severity\",\"status\":\"s-status\",\"type\":\"s-type\"}],\"storageProfile\":{\"disks\":[{\"controllerKey\":7,\"deviceKey\":7,\"deviceName\":\"s-devicename\",\"diskMode\":\"s-diskmode\",\"diskObjectId\":\"s-diskobjectid\",\"diskSizeGB\":7,\"diskType\":\"s-disktype\",\"label\":\"s-label\",\"name\":\"s-name\",\"unitNumber\":7}],\"scsiControllers\":[{\"busNumber\":7,\"controllerKey\":7,\"scsiCtlrUnitNumber\":7,\"sharing\":\"s-sharing\",\"type\":\"s-type\"}]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualMachineInstancesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", VirtualMachineInstancesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_machine_instances_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
