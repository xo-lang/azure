/// HardwareProfilePatch: HardwareProfile in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct HardwareProfilePatch {
  /// Gets or sets a value indicating whether virtual processors can be added while this virtual machine is running.
  pub cpu_hot_add_enabled as "cpuHotAddEnabled,omitempty": json.Patch[Bool] = json.Patch.Absent
  /// Gets or sets a value indicating whether virtual processors can be removed while this virtual machine is running.
  pub cpu_hot_remove_enabled as "cpuHotRemoveEnabled,omitempty": json.Patch[Bool] = json.Patch.Absent
  /// Gets or sets a value indicating whether memory can be added while this virtual machine is running.
  pub memory_hot_add_enabled as "memoryHotAddEnabled,omitempty": json.Patch[Bool] = json.Patch.Absent
  /// Gets or sets memory size in MBs for the vm.
  pub memory_size_mb as "memorySizeMB,omitempty": json.Patch[Int] = json.Patch.Absent
  /// Gets or sets the number of vCPUs for the vm.
  pub num_cpus as "numCPUs,omitempty": json.Patch[Int] = json.Patch.Absent
  /// Gets or sets the number of cores per socket for the vm. Defaults to 1 if unspecified.
  pub num_cores_per_socket as "numCoresPerSocket,omitempty": json.Patch[Int] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: HardwareProfile) patch() -> HardwareProfilePatch {
  HardwareProfilePatch{
    memory_size_mb: match m.memory_size_mb {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    num_cpus: match m.num_cpus {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    num_cores_per_socket: match m.num_cores_per_socket {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    cpu_hot_add_enabled: match m.cpu_hot_add_enabled {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    cpu_hot_remove_enabled: match m.cpu_hot_remove_enabled {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    memory_hot_add_enabled: match m.memory_hot_add_enabled {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
