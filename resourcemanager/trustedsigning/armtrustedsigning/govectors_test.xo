  let c = new_certificate_profiles_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"certificates\":[{\"createdDate\":\"s-createddate\",\"enhancedKeyUsage\":\"s-enhancedkeyusage\",\"expiryDate\":\"s-expirydate\",\"revocation\":{\"effectiveAt\":\"2026-11-06T10:00:00Z\",\"failureReason\":\"s-failurereason\",\"reason\":\"s-reason\",\"remarks\":\"s-remarks\",\"requestedAt\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\"},\"serialNumber\":\"s-serialnumber\",\"status\":\"s-status\",\"subjectName\":\"s-subjectname\",\"thumbprint\":\"s-thumbprint\"}],\"identityValidationId\":\"s-identityvalidationid\",\"includeCity\":true,\"includeCountry\":true,\"includePostalCode\":true,\"includeState\":true,\"includeStreetAddress\":true,\"profileType\":\"s-profiletype\",\"provisioningState\":\"Succeeded\",\"status\":\"s-status\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
