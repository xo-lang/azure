test "Go's GrafanaClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_grafana_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"apiKey\":\"s-apikey\",\"autoGeneratedDomainNameLabelScope\":\"s-autogenerateddomainnamelabelscope\",\"creatorCanAdmin\":\"s-creatorcanadmin\",\"deterministicOutboundIP\":\"s-deterministicoutboundip\",\"endpoint\":\"s-endpoint\",\"enterpriseConfigurations\":{\"marketplaceAutoRenew\":\"s-marketplaceautorenew\",\"marketplacePlanId\":\"s-marketplaceplanid\"},\"grafanaConfigurations\":{\"security\":{\"csrfAlwaysCheck\":true},\"smtp\":{\"enabled\":true,\"fromAddress\":\"s-fromaddress\",\"fromName\":\"s-fromname\",\"host\":\"s-host\",\"password\":\"s-password\",\"skipVerify\":true,\"startTLSPolicy\":\"s-starttlspolicy\",\"user\":\"s-user\"},\"snapshots\":{\"externalEnabled\":true},\"unifiedAlertingScreenshots\":{\"captureEnabled\":true},\"users\":{\"editorsCanAdmin\":true,\"viewersCanEdit\":true}},\"grafanaIntegrations\":{\"azureMonitorWorkspaceIntegrations\":[{\"azureMonitorWorkspaceResourceId\":\"s-azuremonitorworkspaceresourceid\"}]},\"grafanaMajorVersion\":\"s-grafanamajorversion\",\"grafanaPlugins\":{\"k1\":{\"pluginId\":\"s-pluginid\"}},\"grafanaVersion\":\"s-grafanaversion\",\"outboundIPs\":[\"s-outboundips\"],\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"zoneRedundancy\":\"s-zoneredundancy\"},\"sku\":{\"name\":\"s-name\",\"size\":\"s-size\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL GrafanaClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", GrafanaClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_grafana_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_6)
}

fn show_grafana_client_list_response(r: GrafanaClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.managed_grafana_list_response).to_str_lossy()}")
  parts.join(" ")
}

