test "Go's JobsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"configuration\":{\"eventTriggerConfig\":{\"parallelism\":7,\"replicaCompletionCount\":7,\"scale\":{\"maxExecutions\":7,\"minExecutions\":7,\"pollingInterval\":7}},\"identitySettings\":[{\"identity\":\"s-identity\",\"lifecycle\":\"s-lifecycle\"}],\"manualTriggerConfig\":{\"parallelism\":7,\"replicaCompletionCount\":7},\"registries\":[{\"identity\":\"s-identity\",\"passwordSecretRef\":\"s-passwordsecretref\",\"server\":\"s-server\",\"username\":\"s-username\"}],\"replicaRetryLimit\":7,\"replicaTimeout\":7,\"scheduleTriggerConfig\":{\"cronExpression\":\"s-cronexpression\",\"parallelism\":7,\"replicaCompletionCount\":7},\"secrets\":[{\"identity\":\"s-identity\",\"keyVaultUrl\":\"s-keyvaulturl\",\"name\":\"s-name\",\"value\":\"s-value\"}],\"triggerType\":\"s-triggertype\"},\"environmentId\":\"s-environmentid\",\"eventStreamEndpoint\":\"s-eventstreamendpoint\",\"outboundIpAddresses\":[\"s-outboundipaddresses\"],\"provisioningState\":\"Succeeded\",\"runningState\":\"s-runningstate\",\"template\":{\"containers\":[{\"image\":\"s-image\",\"name\":\"s-name\"}],\"initContainers\":[{\"image\":\"s-image\",\"name\":\"s-name\"}],\"volumes\":[{\"mountOptions\":\"s-mountoptions\",\"name\":\"s-name\",\"storageName\":\"s-storagename\",\"storageType\":\"s-storagetype\"}]},\"workloadProfileName\":\"s-workloadprofilename\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL JobsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", JobsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_jobs_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_117)
}

fn show_jobs_client_list_by_subscription_response(r: JobsClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.jobs_collection).to_str_lossy()}")
  parts.join(" ")
}

