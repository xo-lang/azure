fn show_container_apps_auth_configs_client_list_by_container_app_response(r: ContainerAppsAuthConfigsClientListByContainerAppResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.auth_config_collection).to_str_lossy()}")
  parts.join(" ")
}

