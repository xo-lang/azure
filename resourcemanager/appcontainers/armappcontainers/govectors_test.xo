test "Go's CertificatesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_certificates_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"certificateKeyVaultProperties\":{\"identity\":\"s-identity\",\"keyVaultUrl\":\"s-keyvaulturl\"},\"deploymentErrors\":\"s-deploymenterrors\",\"expirationDate\":\"2026-11-06T10:00:00Z\",\"issueDate\":\"2026-11-06T10:00:00Z\",\"issuer\":\"s-issuer\",\"password\":\"s-password\",\"provisioningState\":\"Succeeded\",\"publicKeyHash\":\"s-publickeyhash\",\"subjectAlternativeNames\":[\"s-subjectalternativenames\"],\"subjectName\":\"s-subjectname\",\"thumbprint\":\"s-thumbprint\",\"valid\":true,\"value\":\"YWI=\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL CertificatesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", CertificatesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_certificates_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_6)
}

