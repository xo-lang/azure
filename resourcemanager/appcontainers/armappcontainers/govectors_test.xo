  let c = new_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"dataProviderMetadata\":{\"propertyBag\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"providerName\":\"s-providername\"},\"dataset\":[{\"renderingProperties\":{\"description\":\"s-description\",\"isVisible\":true,\"title\":\"s-title\",\"type\":7},\"table\":{\"tableName\":\"s-tablename\"}}],\"metadata\":{\"analysisTypes\":[\"s-analysistypes\"],\"author\":\"s-author\",\"category\":\"s-category\",\"description\":\"s-description\",\"id\":\"s-id\",\"name\":\"s-name\",\"score\":1.5,\"supportTopicList\":[{\"id\":\"s-id\",\"pesId\":\"s-pesid\"}],\"type\":\"s-type\"},\"status\":{\"message\":\"s-message\",\"statusId\":7}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL JobsClient.NewListDetectorsPager")
  var pg = c.new_list_detectors_pager("id1/ x", "id2/ x", JobsClientListDetectorsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_jobs_client_list_detectors_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_119)
}

