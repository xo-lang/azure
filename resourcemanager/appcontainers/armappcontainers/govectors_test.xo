  let f = gv_new_fake(os.net)
  let c = new_container_apps_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL ContainerAppsClient.BeginDelete")
  match c.begin_delete("id1/ x", "id2/ x", ContainerAppsClientBeginDeleteOptions{}) {
    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(r) => gv_note(f, "OUT: ${show_container_apps_client_delete_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_42)
}

