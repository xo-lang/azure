  gv_note(f, "CALL ContainerAppsRevisionsClient.NewListRevisionsPager")
  var pg = c.new_list_revisions_pager("id1/ x", "id2/ x", ContainerAppsRevisionsClientListRevisionsOptions{filter: Some("s-filter")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_container_apps_revisions_client_list_revisions_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_69)
}

