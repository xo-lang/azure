test "Go's ContainerAppsClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_container_apps_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"s-kind\",\"location\":\"s-location\",\"managedBy\":\"s-managedby\",\"name\":\"s-name\",\"properties\":{\"configuration\":{\"activeRevisionsMode\":\"s-activerevisionsmode\",\"dapr\":{\"appHealth\":{\"enabled\":true,\"path\":\"s-path\",\"probeIntervalSeconds\":7,\"probeTimeoutMilliseconds\":7,\"threshold\":7},\"appId\":\"s-appid\",\"appPort\":7,\"appProtocol\":\"s-appprotocol\",\"enableApiLogging\":true,\"enabled\":true,\"httpMaxRequestSize\":7,\"httpReadBufferSize\":7,\"logLevel\":\"s-loglevel\",\"maxConcurrency\":7},\"identitySettings\":[{\"identity\":\"s-identity\",\"lifecycle\":\"s-lifecycle\"}],\"ingress\":{\"allowInsecure\":true,\"clientCertificateMode\":\"s-clientcertificatemode\",\"corsPolicy\":{\"allowCredentials\":true,\"maxAge\":7},\"exposedPort\":7,\"external\":true,\"fqdn\":\"s-fqdn\",\"stickySessions\":{\"affinity\":\"s-affinity\"},\"targetPort\":7,\"transport\":\"s-transport\"},\"maxInactiveRevisions\":7,\"registries\":[{\"identity\":\"s-identity\",\"passwordSecretRef\":\"s-passwordsecretref\",\"server\":\"s-server\",\"username\":\"s-username\"}],\"runtime\":{\"java\":{\"enableMetrics\":true}},\"secrets\":[{\"identity\":\"s-identity\",\"keyVaultUrl\":\"s-keyvaulturl\",\"name\":\"s-name\",\"value\":\"s-value\"}],\"service\":{\"type\":\"s-type\"}},\"customDomainVerificationId\":\"s-customdomainverificationid\",\"environmentId\":\"s-environmentid\",\"eventStreamEndpoint\":\"s-eventstreamendpoint\",\"latestReadyRevisionName\":\"s-latestreadyrevisionname\",\"latestRevisionFqdn\":\"s-latestrevisionfqdn\",\"latestRevisionName\":\"s-latestrevisionname\",\"managedEnvironmentId\":\"s-managedenvironmentid\",\"networking\":{\"outboundVnetSubnetId\":\"s-outboundvnetsubnetid\"},\"outboundIpAddresses\":[\"s-outboundipaddresses\"],\"provisioningState\":\"Succeeded\",\"runningStatus\":\"s-runningstatus\",\"template\":{\"containers\":[{\"image\":\"s-image\",\"name\":\"s-name\"}],\"initContainers\":[{\"image\":\"s-image\",\"name\":\"s-name\"}],\"revisionSuffix\":\"s-revisionsuffix\",\"scale\":{\"allowScalingRuleOverride\":true,\"cooldownPeriod\":7,\"maxReplicas\":7,\"minReplicas\":7,\"pollingInterval\":7},\"serviceBinds\":[{\"name\":\"s-name\",\"serviceId\":\"s-serviceid\"}],\"terminationGracePeriodSeconds\":7,\"volumes\":[{\"mountOptions\":\"s-mountoptions\",\"name\":\"s-name\",\"storageName\":\"s-storagename\",\"storageType\":\"s-storagetype\"}]},\"workloadProfileName\":\"s-workloadprofilename\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ContainerAppsClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(ContainerAppsClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_container_apps_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_51)
}

fn show_container_apps_diagnostics_client_get_detector_response(r: ContainerAppsDiagnosticsClientGetDetectorResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.diagnostics).to_str_lossy()}")
  parts.join(" ")
}

