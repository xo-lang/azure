test "Go's ManagedEnvironmentsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_managed_environments_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"appInsightsConfiguration\":{\"connectionString\":\"s-connectionstring\"},\"appLogsConfiguration\":{\"destination\":\"s-destination\",\"logAnalyticsConfiguration\":{\"customerId\":\"s-customerid\",\"sharedKey\":\"s-sharedkey\"}},\"customDomainConfiguration\":{\"certificateKeyVaultProperties\":{\"identity\":\"s-identity\",\"keyVaultUrl\":\"s-keyvaulturl\"},\"certificatePassword\":\"s-certificatepassword\",\"certificateValue\":\"YWI=\",\"customDomainVerificationId\":\"s-customdomainverificationid\",\"dnsSuffix\":\"s-dnssuffix\",\"expirationDate\":\"2026-11-06T10:00:00Z\",\"subjectName\":\"s-subjectname\",\"thumbprint\":\"s-thumbprint\"},\"daprAIConnectionString\":\"s-dapraiconnectionstring\",\"daprAIInstrumentationKey\":\"s-dapraiinstrumentationkey\",\"daprConfiguration\":{\"version\":\"s-version\"},\"defaultDomain\":\"s-defaultdomain\",\"deploymentErrors\":\"s-deploymenterrors\",\"environmentMode\":\"s-environmentmode\",\"eventStreamEndpoint\":\"s-eventstreamendpoint\",\"infrastructureResourceGroup\":\"s-infrastructureresourcegroup\",\"ingressConfiguration\":{\"headerCountLimit\":7,\"requestIdleTimeout\":7,\"terminationGracePeriodSeconds\":7,\"workloadProfileName\":\"s-workloadprofilename\"},\"kedaConfiguration\":{\"version\":\"s-version\"},\"openTelemetryConfiguration\":{\"destinationsConfiguration\":{\"dataDogConfiguration\":{\"key\":\"s-key\",\"site\":\"s-site\"}},\"logsConfiguration\":{\"destinations\":[\"s-destinations\"]},\"metricsConfiguration\":{\"destinations\":[\"s-destinations\"],\"includeKeda\":true},\"tracesConfiguration\":{\"destinations\":[\"s-destinations\"],\"includeDapr\":true}},\"peerAuthentication\":{\"mtls\":{\"enabled\":true}},\"peerTrafficConfiguration\":{\"encryption\":{\"enabled\":true}},\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"staticIp\":\"s-staticip\",\"vnetConfiguration\":{\"dockerBridgeCidr\":\"s-dockerbridgecidr\",\"infrastructureSubnetId\":\"s-infrastructuresubnetid\",\"internal\":true,\"platformReservedCidr\":\"s-platformreservedcidr\",\"platformReservedDnsIP\":\"s-platformreserveddnsip\"},\"workloadProfiles\":[{\"maximumCount\":7,\"minimumCount\":7,\"name\":\"s-name\",\"workloadProfileType\":\"s-workloadprofiletype\"}],\"zoneRedundant\":true},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ManagedEnvironmentsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ManagedEnvironmentsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_managed_environments_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_152)
}

fn show_managed_environments_client_list_by_subscription_response(r: ManagedEnvironmentsClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.managed_environments_collection).to_str_lossy()}")
  parts.join(" ")
}

