ncludeDapr\":true}},\"peerAuthentication\":{\"mtls\":{\"enabled\":true}},\"peerTrafficConfiguration\":{\"encryption\":{\"enabled\":true}},\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"staticIp\":\"s-staticip\",\"vnetConfiguration\":{\"dockerBridgeCidr\":\"s-dockerbridgecidr\",\"infrastructureSubnetId\":\"s-infrastructuresubnetid\",\"internal\":true,\"platformReservedCidr\":\"s-platformreservedcidr\",\"platformReservedDnsIP\":\"s-platformreserveddnsip\"},\"workloadProfiles\":[{\"maximumCount\":7,\"minimumCount\":7,\"name\":\"s-name\",\"workloadProfileType\":\"s-workloadprofiletype\"}],\"zoneRedundant\":true},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
