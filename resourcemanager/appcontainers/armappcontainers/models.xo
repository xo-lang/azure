/// OpenIDConnectClientCredential's named fields, for its JSON.
struct OpenIDConnectClientCredentialKnown {
  client_secret_setting_name as "clientSecretSettingName,omitempty": Str? = None
  method as "method,omitempty": Str? = None
} derive Json

fn open_id_connect_client_credential_json(x: OpenIDConnectClientCredential) -> json.Value {
  let known = OpenIDConnectClientCredentialKnown{
    client_secret_setting_name: x.client_secret_setting_name,
    method: x.method.map(fn(_: Str) -> Str { "ClientSecretPost" }),
  }
  json.to_value(known)
}

fn parse_open_id_connect_client_credential(v: json.Value) -> OpenIDConnectClientCredential ! json.DecodeErr {
  let k = json.from_value[OpenIDConnectClientCredentialKnown](v)?
  Ok(OpenIDConnectClientCredential{
    client_secret_setting_name: k.client_secret_setting_name,
    method: k.method,
  })
}

