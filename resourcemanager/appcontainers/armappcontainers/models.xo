/// JavaComponentPropertiesClassification: a JavaComponentProperties by its componentType, Go's JavaComponentPropertiesClassification interface.
pub enum JavaComponentPropertiesClassification {
  /// componentType "SpringBootAdmin"
  SpringBootAdminComponent(from SpringBootAdminComponent)
  /// componentType "SpringCloudConfig"
  SpringCloudConfigComponent(from SpringCloudConfigComponent)
  /// componentType "SpringCloudEureka"
  SpringCloudEurekaComponent(from SpringCloudEurekaComponent)
  /// Any other componentType, as the base type.
  JavaComponentProperties(from JavaComponentProperties)
} derive Json(via: json.Value, to: java_component_properties_classification_json, from: parse_java_component_properties_classification)

fn java_component_properties_classification_json(c: JavaComponentPropertiesClassification) -> json.Value {
  match c {
    JavaComponentPropertiesClassification.SpringBootAdminComponent(x) => json.to_value(x)
    JavaComponentPropertiesClassification.SpringCloudConfigComponent(x) => json.to_value(x)
    JavaComponentPropertiesClassification.SpringCloudEurekaComponent(x) => json.to_value(x)
    JavaComponentPropertiesClassification.JavaComponentProperties(x) => json.to_value(x)
  }
}

fn parse_java_component_properties_classification(v: json.Value) -> JavaComponentPropertiesClassification ! json.DecodeErr {
  match v.get("componentType") {
    Some(json.Value.Str("SpringBootAdmin")) => Ok(JavaComponentPropertiesClassification.SpringBootAdminComponent(json.from_value[SpringBootAdminComponent](v)?))
    Some(json.Value.Str("SpringCloudConfig")) => Ok(JavaComponentPropertiesClassification.SpringCloudConfigComponent(json.from_value[SpringCloudConfigComponent](v)?))
    Some(json.Value.Str("SpringCloudEureka")) => Ok(JavaComponentPropertiesClassification.SpringCloudEurekaComponent(json.from_value[SpringCloudEurekaComponent](v)?))
    _ => Ok(JavaComponentPropertiesClassification.JavaComponentProperties(json.from_value[JavaComponentProperties](v)?))
  }
}

/// `v` with its discriminator `key` set to `value`, as Go's
/// MarshalJSON writes a subtype's (its keys sorted).
fn with_discriminator(v: json.Value, key: Str, value: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object((fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != key }) + [(key, json.Value.Str(value))]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    other => other
  }
}

