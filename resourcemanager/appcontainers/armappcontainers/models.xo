/// Describes Compute Resource Usage.
pub struct Usage {
  /// The current usage of the resource.
  pub current_value as "currentValue,omitempty": Float32? = None
  /// The maximum permitted usage of the resource.
  pub limit as "limit,omitempty": Float32? = None
  /// The name of the type of usage.
  pub name as "name,omitempty": UsageName? = None
  /// An enum describing the unit of usage measurement.
  pub unit as "unit,omitempty": Str? = None
} derive Json(via: json.Value, to: usage_json, from: parse_usage)

/// Usage's named fields, for its JSON.
struct UsageKnown {
  current_value as "currentValue,omitempty": Float32? = None
  limit as "limit,omitempty": Float32? = None
  name as "name,omitempty": UsageName? = None
  unit as "unit,omitempty": Str? = None
} derive Json

fn usage_json(x: Usage) -> json.Value {
  let known = UsageKnown{
    current_value: x.current_value,
    limit: x.limit,
    name: x.name,
    unit: Some("Count"),
  }
  json.to_value(known)
}

fn parse_usage(v: json.Value) -> Usage ! json.DecodeErr {
  let k = json.from_value[UsageKnown](v)?
  Ok(Usage{
    current_value: k.current_value,
    limit: k.limit,
    name: k.name,
    unit: k.unit,
  })
}

