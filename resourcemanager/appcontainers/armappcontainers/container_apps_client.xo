  /// Resumes the operation from a poller's resume_token instead of starting it.
  pub resume_token: Str = ""
}

/// ContainerAppsClientStartResponse: the response of ContainerAppsClient.begin_start.
pub struct ContainerAppsClientStartResponse {
  pub container_app: ContainerApp
}

fn container_apps_start_handle(resp: http.Response) -> ContainerAppsClientStartResponse ! Str {
  let v = if resp.body.is_empty() { ContainerApp{} } else { json.decode[ContainerApp](resp.body) ?? e => return Err(e.display()) }
  Ok(ContainerAppsClientStartResponse{container_app: v})
}

fn (c: ContainerAppsClient) start_create_request(resource_group_name: Str, container_app_name: Str, options: ContainerAppsClientBeginStartOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.App/containerApps/{containerAppName}/start"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if container_app_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter containerAppName cannot be empty"))
  }
  path = path.replace("{containerAppName}", url.path_escape(container_app_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: b""})
}

/// Start a container app
pub fn (c: ContainerAppsClient[fx]) begin_start(resource_group_name: Str, container_app_name: Str, options: ContainerAppsClientBeginStartOptions = ContainerAppsClientBeginStartOptions{}) -> runtime.Poller[ContainerAppsClientStartResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "ContainerAppsClientStartResponse", fn(r: http.Response) -> ContainerAppsClientStartResponse ! Str { container_apps_start_handle(r) })
  }
  let req = c.start_create_request(resource_group_name, container_app_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "", "ContainerAppsClientStartResponse", fn(r: http.Response) -> ContainerAppsClientStartResponse ! Str { container_apps_start_handle(r) })
}

