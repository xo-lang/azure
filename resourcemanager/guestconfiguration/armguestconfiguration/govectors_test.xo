test "Go's AssignmentReportsVMSSClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_assignment_reports_vmss_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"assignment\":{\"configuration\":{\"name\":\"s-name\",\"version\":\"s-version\"},\"name\":\"s-name\"},\"complianceStatus\":\"s-compliancestatus\",\"details\":{\"complianceStatus\":\"s-compliancestatus\",\"endTime\":\"2026-11-06T10:00:00Z\",\"jobId\":\"s-jobid\",\"operationType\":\"s-operationtype\",\"resources\":[{\"complianceStatus\":\"s-compliancestatus\",\"properties\":{\"k\":\"v\"},\"resourceId\":\"s-resourceid\"}],\"startTime\":\"2026-11-06T10:00:00Z\"},\"endTime\":\"2026-11-06T10:00:00Z\",\"reportId\":\"s-reportid\",\"startTime\":\"2026-11-06T10:00:00Z\",\"vm\":{\"id\":\"s-id\",\"uuid\":\"s-uuid\"},\"vmssResourceId\":\"s-vmssresourceid\"}}]}")
  gv_note(f, "CALL AssignmentReportsVMSSClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", AssignmentReportsVMSSClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_assignment_reports_vmss_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_3)
}

