test "Go's AssignmentsClient.NewSubscriptionListPager" {
  let f = gv_new_fake(os.net)
  let c = new_assignments_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"assignmentHash\":\"s-assignmenthash\",\"complianceStatus\":\"s-compliancestatus\",\"context\":\"s-context\",\"guestConfiguration\":{\"assignmentSource\":\"s-assignmentsource\",\"assignmentType\":\"s-assignmenttype\",\"configurationParameter\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"configurationProtectedParameter\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"configurationSetting\":{\"actionAfterReboot\":\"s-actionafterreboot\",\"allowModuleOverwrite\":true,\"configurationMode\":\"s-configurationmode\",\"configurationModeFrequencyMins\":1.5,\"rebootIfNeeded\":true,\"refreshFrequencyMins\":1.5},\"contentHash\":\"s-contenthash\",\"contentManagedIdentity\":\"s-contentmanagedidentity\",\"contentType\":\"s-contenttype\",\"contentUri\":\"s-contenturi\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"version\":\"s-version\"},\"lastComplianceStatusChecked\":\"2026-11-06T10:00:00Z\",\"latestAssignmentReport\":{\"assignment\":{\"configuration\":{\"name\":\"s-name\",\"version\":\"s-version\"},\"name\":\"s-name\"},\"complianceStatus\":\"s-compliancestatus\",\"endTime\":\"2026-11-06T10:00:00Z\",\"id\":\"s-id\",\"operationType\":\"s-operationtype\",\"reportId\":\"s-reportid\",\"resources\":[{\"complianceStatus\":\"s-compliancestatus\",\"properties\":{\"k\":\"v\"},\"resourceId\":\"s-resourceid\"}],\"startTime\":\"2026-11-06T10:00:00Z\",\"vm\":{\"id\":\"s-id\",\"uuid\":\"s-uuid\"}},\"latestReportId\":\"s-latestreportid\",\"parameterHash\":\"s-parameterhash\",\"provisioningState\":\"Succeeded\",\"resourceType\":\"s-resourcetype\",\"targetResourceId\":\"s-targetresourceid\",\"vmssVMList\":[{\"complianceStatus\":\"s-compliancestatus\",\"lastComplianceChecked\":\"2026-11-06T10:00:00Z\",\"latestReportId\":\"s-latestreportid\",\"vmId\":\"s-vmid\",\"vmResourceId\":\"s-vmresourceid\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AssignmentsClient.NewSubscriptionListPager")
  var pg = c.new_subscription_list_pager(AssignmentsClientSubscriptionListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_assignments_client_subscription_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_9)
}

fn show_assignments_vmss_client_create_or_update_response(r: AssignmentsVMSSClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.assignment).to_str_lossy()}")
  parts.join(" ")
}

