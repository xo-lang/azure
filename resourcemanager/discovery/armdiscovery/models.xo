/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: SystemData) patch() -> SystemDataPatch {
  SystemDataPatch{
    created_by: match m.created_by {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    created_by_type: match m.created_by_type {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    created_at: match m.created_at {
