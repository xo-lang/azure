  let f = gv_new_fake(os.net)
  let c = new_supercomputers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"customerManagedKeys\":\"s-customermanagedkeys\",\"diskEncryptionSetId\":\"s-diskencryptionsetid\",\"identities\":{\"clusterIdentity\":{\"clientId\":\"s-clientid\",\"id\":\"s-id\",\"principalId\":\"s-principalid\"},\"kubeletIdentity\":{\"clientId\":\"s-clientid\",\"id\":\"s-id\",\"principalId\":\"s-principalid\"},\"workloadIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"logAnalyticsClusterId\":\"s-loganalyticsclusterid\",\"managedOnBehalfOfConfiguration\":{\"moboBrokerResources\":[{\"id\":\"s-id\"}]},\"managedResourceGroup\":\"s-managedresourcegroup\",\"managementSubnetId\":\"s-managementsubnetid\",\"outboundType\":\"s-outboundtype\",\"provisioningState\":\"Succeeded\",\"subnetId\":\"s-subnetid\",\"systemSku\":\"s-systemsku\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SupercomputersClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", SupercomputersClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_supercomputers_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
