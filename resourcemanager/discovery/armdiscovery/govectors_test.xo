test "Go's BookshelvesClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_bookshelves_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"bookshelfUri\":\"s-bookshelfuri\",\"customerManagedKeys\":\"s-customermanagedkeys\",\"keyVaultProperties\":{\"identityClientId\":\"s-identityclientid\",\"keyName\":\"s-keyname\",\"keyVaultUri\":\"s-keyvaulturi\",\"keyVersion\":\"s-keyversion\"},\"logAnalyticsClusterId\":\"s-loganalyticsclusterid\",\"managedOnBehalfOfConfiguration\":{\"moboBrokerResources\":[{\"id\":\"s-id\"}]},\"managedResourceGroup\":\"s-managedresourcegroup\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"privateEndpointSubnetId\":\"s-privateendpointsubnetid\",\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"searchSubnetId\":\"s-searchsubnetid\",\"workloadIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BookshelvesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", BookshelvesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_bookshelves_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_10)
}

