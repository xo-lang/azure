    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_load_tests_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
