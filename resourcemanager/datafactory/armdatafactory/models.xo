  pub end_time as "endTime,omitempty": azcore.DateTime? = None
  /// The frequency of the time windows.
  pub frequency as "frequency,omitempty": TumblingWindowFrequency? = None
  /// The interval of the time windows. The minimum interval allowed is 15 Minutes.
