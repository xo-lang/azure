  /// The authentication type to connect to Dynamics CRM server. 'Office365' for online scenario, 'Ifd' for on-premises with Ifd scenario, 'AADServicePrincipal' for Server-To-Server authentication in online scenario, 'Active Directory' for Dynamics on-premises with IFD. Type: string (or Expression with resultType string).
  pub authentication_type as "authenticationType,omitempty": json.Value? = None
  /// The credential reference containing authentication information.
  pub credential as "credential,omitempty": CredentialReference? = None
  /// The deployment type of the Dynamics CRM instance. 'Online' for Dynamics CRM Online and 'OnPremisesWithIfd' for Dynamics CRM on-premises with Ifd. Type: string (or Expression with resultType string).
  pub deployment_type as "deploymentType,omitempty": json.Value? = None
  /// The Active Directory domain that will verify user credentials. Type: string (or Expression with resultType string).
  pub domain as "domain,omitempty": json.Value? = None
  /// The encrypted credential used for authentication. Credentials are encrypted using the integration runtime credential manager. Type: string.
  pub encrypted_credential as "encryptedCredential,omitempty": Str? = None
  /// The host name of the on-premises Dynamics CRM server. The property is required for on-prem and not allowed for online. Type: string (or Expression with resultType string).
  pub host_name as "hostName,omitempty": json.Value? = None
  /// The organization name of the Dynamics CRM instance. The property is required for on-prem and required for online when there are more than one Dynamics CRM instances associated with the user. Type: string (or Expression with resultType string).
  pub organization_name as "organizationName,omitempty": json.Value? = None
  /// Password to access the Dynamics CRM instance.
  pub password as "password,omitempty": SecretBaseClassification? = None
  /// The port of on-premises Dynamics CRM server. The property is required for on-prem and not allowed for online. Default is 443. Type: integer (or Expression with resultType integer), minimum: 0.
  pub port as "port,omitempty": json.Value? = None
  /// The credential of the service principal object in Azure Active Directory. If servicePrincipalCredentialType is 'ServicePrincipalKey', servicePrincipalCredential can be SecureString or AzureKeyVaultSecretReference. If servicePrincipalCredentialType is 'ServicePrincipalCert', servicePrincipalCredential can only be AzureKeyVaultSecretReference.
  pub service_principal_credential as "servicePrincipalCredential,omitempty": SecretBaseClassification? = None
  /// The service principal credential type to use in Server-To-Server authentication. 'ServicePrincipalKey' for key/secret, 'ServicePrincipalCert' for certificate. Type: string (or Expression with resultType string).
  pub service_principal_credential_type as "servicePrincipalCredentialType,omitempty": json.Value? = None
  /// The client ID of the application in Azure Active Directory used for Server-To-Server authentication. Type: string (or Expression with resultType string).
  pub service_principal_id as "servicePrincipalId,omitempty": json.Value? = None
  /// The URL to the Microsoft Dynamics CRM server. The property is required for on-line and not allowed for on-prem. Type: string (or Expression with resultType string).
  pub service_uri as "serviceUri,omitempty": json.Value? = None
  /// User name to access the Dynamics CRM instance. Type: string (or Expression with resultType string).
  pub username as "username,omitempty": json.Value? = None
} derive Json

