/// SecretBaseClassification: a SecretBase by its type, Go's SecretBaseClassification interface.
pub enum SecretBaseClassification {
  /// type "AzureKeyVaultSecret"
  AzureKeyVaultSecretReference(from AzureKeyVaultSecretReference)
  /// type "SecureString"
  SecureString(from SecureString)
  /// Any other type, as the base type.
  SecretBase(from SecretBase)
} derive Json(via: json.Value, to: secret_base_classification_json, from: parse_secret_base_classification)

fn secret_base_classification_json(c: SecretBaseClassification) -> json.Value {
  match c {
    SecretBaseClassification.AzureKeyVaultSecretReference(x) => json.to_value(x)
    SecretBaseClassification.SecureString(x) => json.to_value(x)
    SecretBaseClassification.SecretBase(x) => json.to_value(x)
  }
}

fn parse_secret_base_classification(v: json.Value) -> SecretBaseClassification ! json.DecodeErr {
  match v.get("type") {
    Some(json.Value.Str("AzureKeyVaultSecret")) => Ok(SecretBaseClassification.AzureKeyVaultSecretReference(json.from_value[AzureKeyVaultSecretReference](v)?))
    Some(json.Value.Str("SecureString")) => Ok(SecretBaseClassification.SecureString(json.from_value[SecureString](v)?))
    _ => Ok(SecretBaseClassification.SecretBase(json.from_value[SecretBase](v)?))
  }
}

/// WebLinkedServiceTypePropertiesClassification: a WebLinkedServiceTypeProperties by its authenticationType, Go's WebLinkedServiceTypePropertiesClassification interface.
pub enum WebLinkedServiceTypePropertiesClassification {
  /// authenticationType "Anonymous"
  WebAnonymousAuthentication(from WebAnonymousAuthentication)
  /// authenticationType "Basic"
  WebBasicAuthentication(from WebBasicAuthentication)
  /// authenticationType "ClientCertificate"
  WebClientCertificateAuthentication(from WebClientCertificateAuthentication)
  /// Any other authenticationType, as the base type.
  WebLinkedServiceTypeProperties(from WebLinkedServiceTypeProperties)
} derive Json(via: json.Value, to: web_linked_service_type_properties_classification_json, from: parse_web_linked_service_type_properties_classification)

fn web_linked_service_type_properties_classification_json(c: WebLinkedServiceTypePropertiesClassification) -> json.Value {
  match c {
    WebLinkedServiceTypePropertiesClassification.WebAnonymousAuthentication(x) => json.to_value(x)
    WebLinkedServiceTypePropertiesClassification.WebBasicAuthentication(x) => json.to_value(x)
    WebLinkedServiceTypePropertiesClassification.WebClientCertificateAuthentication(x) => json.to_value(x)
    WebLinkedServiceTypePropertiesClassification.WebLinkedServiceTypeProperties(x) => json.to_value(x)
  }
}

fn parse_web_linked_service_type_properties_classification(v: json.Value) -> WebLinkedServiceTypePropertiesClassification ! json.DecodeErr {
  match v.get("authenticationType") {
    Some(json.Value.Str("Anonymous")) => Ok(WebLinkedServiceTypePropertiesClassification.WebAnonymousAuthentication(json.from_value[WebAnonymousAuthentication](v)?))
    Some(json.Value.Str("Basic")) => Ok(WebLinkedServiceTypePropertiesClassification.WebBasicAuthentication(json.from_value[WebBasicAuthentication](v)?))
    Some(json.Value.Str("ClientCertificate")) => Ok(WebLinkedServiceTypePropertiesClassification.WebClientCertificateAuthentication(json.from_value[WebClientCertificateAuthentication](v)?))
    _ => Ok(WebLinkedServiceTypePropertiesClassification.WebLinkedServiceTypeProperties(json.from_value[WebLinkedServiceTypeProperties](v)?))
  }
}

