  }
  path = path.replace("{integrationRuntimeName}", url.path_escape(integration_runtime_name))
  var q = url.values()
  var headers: List[(Str, Str)] = []
  q.add("api-version", API_VERSION)
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: b""})
}

/// Upgrade self-hosted integration runtime to latest version if availability.
pub fn (c: IntegrationRuntimesClient) upgrade(resource_group_name: Str, factory_name: Str, integration_runtime_name: Str, options: IntegrationRuntimesClientUpgradeOptions = IntegrationRuntimesClientUpgradeOptions{}) -> IntegrationRuntimesClientUpgradeResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.upgrade_create_request(resource_group_name, factory_name, integration_runtime_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  integration_runtimes_upgrade_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
