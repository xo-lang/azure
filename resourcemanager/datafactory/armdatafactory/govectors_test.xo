  let c = new_change_data_capture_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"k1\":{\"k\":\"v\"},\"name\":\"s-name\",\"properties\":{\"allowVNetOverride\":true,\"description\":\"s-description\",\"folder\":{\"name\":\"s-name\"},\"policy\":{\"mode\":\"s-mode\",\"recurrence\":{\"frequency\":\"s-frequency\",\"interval\":7}},\"sourceConnectionsInfo\":[{\"connection\":{\"isInlineDataset\":true,\"linkedServiceType\":\"https://management.example.test/next?\$skiptoken=2\",\"type\":\"s-type\"}}],\"status\":\"s-status\",\"targetConnectionsInfo\":[{\"connection\":{\"isInlineDataset\":true,\"linkedServiceType\":\"https://management.example.test/next?\$skiptoken=2\",\"type\":\"s-type\"},\"relationships\":[{\"k\":\"v\"}]}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ChangeDataCaptureClient.NewListByFactoryPager")
  var pg = c.new_list_by_factory_pager("id1/ x", "id2/ x", ChangeDataCaptureClientListByFactoryOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_change_data_capture_client_list_by_factory_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_4)
}

