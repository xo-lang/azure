test "Go's FactoriesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_factories_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"eTag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"k\":\"v\"}}},\"k1\":{\"k\":\"v\"},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"createTime\":\"2026-11-06T10:00:00Z\",\"encryption\":{\"identity\":{\"userAssignedIdentity\":\"s-userassignedidentity\"},\"keyName\":\"s-keyname\",\"keyVersion\":\"s-keyversion\",\"vaultBaseUrl\":\"s-vaultbaseurl\"},\"globalParameters\":{\"k1\":{\"type\":\"s-type\",\"value\":{\"k\":\"v\"}}},\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"purviewConfiguration\":{\"purviewResourceId\":\"s-purviewresourceid\"},\"repoConfiguration\":{\"accountName\":\"s-accountname\",\"clientId\":\"s-clientid\",\"clientSecret\":{\"byoaSecretAkvUrl\":\"s-byoasecretakvurl\",\"byoaSecretName\":\"s-byoasecretname\"},\"collaborationBranch\":\"s-collaborationbranch\",\"disablePublish\":true,\"hostName\":\"s-hostname\",\"lastCommitId\":\"s-lastcommitid\",\"repositoryName\":\"s-repositoryname\",\"rootFolder\":\"s-rootfolder\",\"type\":\"FactoryGitHubConfiguration\"},\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL FactoriesClient.NewListPager")
  var pg = c.new_list_pager(FactoriesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_factories_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_35)
}

