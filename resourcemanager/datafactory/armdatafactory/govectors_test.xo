test "Go's TriggersClient.NewListByFactoryPager" {
  let f = gv_new_fake(os.net)
  let c = new_triggers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"annotations\":[{\"k\":\"v\"}],\"description\":\"s-description\",\"k1\":{\"k\":\"v\"},\"pipelines\":[{\"parameters\":{\"k1\":{\"k\":\"v\"}}}],\"runtimeState\":\"s-runtimestate\",\"type\":\"BlobEventsTrigger\",\"typeProperties\":{\"blobPathBeginsWith\":\"s-blobpathbeginswith\",\"blobPathEndsWith\":\"s-blobpathendswith\",\"events\":[\"s-events\"],\"ignoreEmptyBlobs\":true,\"scope\":\"s-scope\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL TriggersClient.NewListByFactoryPager")
  var pg = c.new_list_by_factory_pager("id1/ x", "id2/ x", TriggersClientListByFactoryOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_triggers_client_list_by_factory_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_102)
}

