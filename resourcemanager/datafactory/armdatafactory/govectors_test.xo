  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\",\"origin\":\"s-origin\",\"properties\":{\"serviceSpecification\":{\"logSpecifications\":[{\"blobDuration\":\"s-blobduration\",\"displayName\":\"s-displayname\",\"name\":\"s-name\"}],\"metricSpecifications\":[{\"aggregationType\":\"s-aggregationtype\",\"displayDescription\":\"s-displaydescription\",\"displayName\":\"s-displayname\",\"enableRegionalMdmAccount\":\"s-enableregionalmdmaccount\",\"name\":\"s-name\",\"sourceMdmAccount\":\"s-sourcemdmaccount\",\"sourceMdmNamespace\":\"s-sourcemdmnamespace\",\"unit\":\"s-unit\"}]}}}]}")
  gv_note(f, "CALL OperationsClient.NewListPager")
  var pg = c.new_list_pager(OperationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
