/// The billing plan properties for the upgrade plan call.
pub struct UpgradePlanRequest {
  /// The new Billing plan information.
  pub plan_data as "planData,omitempty": PlanData? = None
} derive Json

/// PlanDataPatch: PlanData in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct PlanDataPatch {
  /// different billing cycles like MONTHLY/WEEKLY. this could be enum
  pub billing_cycle as "billingCycle,omitempty": json.Patch[Str] = json.Patch.Absent
  /// date when plan was applied
  pub effective_date as "effectiveDate,omitempty": json.Patch[azcore.DateTime] = json.Patch.Absent
  /// plan id as published by Dynatrace
  pub plan_details as "planDetails,omitempty": json.Patch[Str] = json.Patch.Absent
  /// different usage type like PAYG/COMMITTED. this could be enum
  pub usage_type as "usageType,omitempty": json.Patch[Str] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: PlanData) patch() -> PlanDataPatch {
  PlanDataPatch{
    usage_type: match m.usage_type {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    billing_cycle: match m.billing_cycle {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    plan_details: match m.plan_details {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    effective_date: match m.effective_date {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
