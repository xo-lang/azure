fn show_creation_supported_client_get_response(r: CreationSupportedClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.create_resource_supported_response).to_str_lossy()}")
  parts.join(" ")
}

