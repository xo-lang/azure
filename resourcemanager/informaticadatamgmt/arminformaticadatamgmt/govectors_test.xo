test "Go's ServerlessRuntimesClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_serverless_runtimes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"advancedCustomProperties\":[{\"key\":\"s-key\",\"value\":\"s-value\"}],\"applicationType\":\"s-applicationtype\",\"computeUnits\":\"s-computeunits\",\"description\":\"s-description\",\"executionTimeout\":\"s-executiontimeout\",\"platform\":\"s-platform\",\"provisioningState\":\"Succeeded\",\"serverlessAccountLocation\":\"s-serverlessaccountlocation\",\"serverlessRuntimeConfig\":{\"cdiConfigProps\":[{\"applicationConfigs\":[{\"customized\":\"s-customized\",\"defaultValue\":\"s-defaultvalue\",\"name\":\"s-name\",\"platform\":\"s-platform\",\"type\":\"s-type\",\"value\":\"s-value\"}],\"engineName\":\"s-enginename\",\"engineVersion\":\"s-engineversion\"}],\"cdieConfigProps\":[{\"applicationConfigs\":[{\"customized\":\"s-customized\",\"defaultValue\":\"s-defaultvalue\",\"name\":\"s-name\",\"platform\":\"s-platform\",\"type\":\"s-type\",\"value\":\"s-value\"}],\"engineName\":\"s-enginename\",\"engineVersion\":\"s-engineversion\"}]},\"serverlessRuntimeNetworkProfile\":{\"networkInterfaceConfiguration\":{\"subnetId\":\"s-subnetid\",\"vnetId\":\"s-vnetid\",\"vnetResourceGuid\":\"s-vnetresourceguid\"}},\"serverlessRuntimeTags\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"serverlessRuntimeUserContextProperties\":{\"userContextToken\":\"s-usercontexttoken\"},\"supplementaryFileLocation\":\"s-supplementaryfilelocation\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ServerlessRuntimesClient.Update")
  match c.update("id1/ x", "id2/ x", "id3/ x", (json.decode_str[InformaticaServerlessRuntimeResourceUpdate]("{\"properties\":{\"advancedCustomProperties\":[{\"key\":\"s-key\",\"value\":\"s-value\"}],\"applicationType\":\"s-applicationtype\",\"computeUnits\":\"s-computeunits\",\"description\":\"s-description\",\"executionTimeout\":\"s-executiontimeout\",\"platform\":\"s-platform\",\"serverlessAccountLocation\":\"s-serverlessaccountlocation\",\"serverlessRuntimeConfig\":{\"cdiConfigProps\":[{\"applicationConfigs\":[{\"customized\":\"s-customized\",\"defaultValue\":\"s-defaultvalue\",\"name\":\"s-name\",\"platform\":\"s-platform\",\"type\":\"s-type\",\"value\":\"s-value\"}],\"engineName\":\"s-enginename\",\"engineVersion\":\"s-engineversion\"}],\"cdieConfigProps\":[{\"applicationConfigs\":[{\"customized\":\"s-customized\",\"defaultValue\":\"s-defaultvalue\",\"name\":\"s-name\",\"platform\":\"s-platform\",\"type\":\"s-type\",\"value\":\"s-value\"}],\"engineName\":\"s-enginename\",\"engineVersion\":\"s-engineversion\"}]},\"serverlessRuntimeNetworkProfile\":{\"networkInterfaceConfiguration\":{\"subnetId\":\"s-subnetid\",\"vnetId\":\"s-vnetid\",\"vnetResourceGuid\":\"s-vnetresourceguid\"}},\"serverlessRuntimeTags\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"serverlessRuntimeUserContextProperties\":{\"userContextToken\":\"s-usercontexttoken\"},\"supplementaryFileLocation\":\"s-supplementaryfilelocation\"}}") ?? e => fault("${e}")), ServerlessRuntimesClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_serverless_runtimes_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_16)
}
