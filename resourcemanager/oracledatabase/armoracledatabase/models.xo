    compartment_id: k.compartment_id,
    connection_string: k.connection_string,
    connection_type: k.connection_type,
    database_id: k.database_id,
    display_name: k.display_name,
    does_use_secret_ids: k.does_use_secret_ids,
    key_id: k.key_id,
    lifecycle_details: k.lifecycle_details,
    lifecycle_state: k.lifecycle_state,
    network_anchor_id: k.network_anchor_id,
    ocid: k.ocid,
    password_secret_id: k.password_secret_id,
    private_ip: k.private_ip,
    provisioning_state: k.provisioning_state,
    resource_anchor_id: k.resource_anchor_id,
    routing_method: k.routing_method,
    session_mode: k.session_mode,
    technology_type: k.technology_type,
    time_created: k.time_created,
    time_updated: k.time_updated,
    username: k.username,
    vault_id: k.vault_id,
    wallet_secret_id: k.wallet_secret_id,
  })
}

