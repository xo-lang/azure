/// Autonomous Database Cross Region Disaster Recovery resource model.
pub struct AutonomousDatabaseCrossRegionDisasterRecoveryProperties {
  /// The current amount of storage in use for user and system data, in terabytes (TB).
  pub actual_used_data_storage_size_in_tbs as "actualUsedDataStorageSizeInTbs,omitempty": Float? = None
  /// Admin password.
  pub admin_password as "adminPassword,omitempty": Str? = None
  /// The amount of storage currently allocated for the database tables and billed for, rounded up.
  pub allocated_storage_size_in_tbs as "allocatedStorageSizeInTbs,omitempty": Float? = None
  /// Information about Oracle APEX Application Development.
  pub apex_details as "apexDetails,omitempty": ApexDetailsType? = None
  /// Autonomous Database ID
  pub autonomous_database_id as "autonomousDatabaseId,omitempty": Str? = None
  /// The maintenance schedule type of the Autonomous Database Serverless.
  pub autonomous_maintenance_schedule_type as "autonomousMaintenanceScheduleType,omitempty": AutonomousMaintenanceScheduleType? = None
  /// List of Oracle Database versions available for a database upgrade. If there are no version upgrades available, this list is empty.
  pub available_upgrade_versions as "availableUpgradeVersions,omitempty": List[Str]? = None
  /// Backup destination for auto and long-term backups. Existing backups stay in their original destination when this value changes.
  pub backup_destination as "backupDestination,omitempty": BackupDestinationType? = None
  /// Retention period, in days, for long-term backups
  pub backup_retention_period_in_days as "backupRetentionPeriodInDays,omitempty": Int? = None
  /// The character set for the autonomous database.
  pub character_set as "characterSet,omitempty": Str? = None
  /// The compute amount (CPUs) available to the database.
  pub compute_count as "computeCount,omitempty": Float32? = None
  /// The compute model of the Autonomous Database.
  pub compute_model as "computeModel,omitempty": ComputeModel? = None
  /// The connection string used to connect to the Autonomous Database.
  pub connection_strings as "connectionStrings,omitempty": ConnectionStringType? = None
  /// The URLs for accessing Oracle Application Express (APEX) and SQL Developer Web with a browser from a Compute instance within your VCN or that has a direct connection to your VCN.
  pub connection_urls as "connectionUrls,omitempty": ConnectionURLType? = None
  /// The number of CPU cores to be made available to the database.
  pub cpu_core_count as "cpuCoreCount,omitempty": Int? = None
  /// Customer Contacts.
  pub customer_contacts as "customerContacts,omitempty": List[CustomerContact]? = None
  /// Database type to be created.
  pub data_base_type as "dataBaseType,omitempty": DataBaseType? = None
  /// Status of the Data Safe registration for this Autonomous Database.
  pub data_safe_status as "dataSafeStatus,omitempty": DataSafeStatusType? = None
  /// The size, in gigabytes, of the data volume that will be created and attached to the database.
  pub data_storage_size_in_gbs as "dataStorageSizeInGbs,omitempty": Int? = None
  /// The quantity of data in the database, in terabytes.
  pub data_storage_size_in_tbs as "dataStorageSizeInTbs,omitempty": Int? = None
  /// The Oracle Database Edition that applies to the Autonomous databases.
  pub database_edition as "databaseEdition,omitempty": DatabaseEditionType? = None
  /// A valid Oracle Database version for Autonomous Database.
  pub db_version as "dbVersion,omitempty": Str? = None
  /// The Autonomous Database workload type
  pub db_workload as "dbWorkload,omitempty": WorkloadType? = None
  /// The user-friendly name for the Autonomous Database.
