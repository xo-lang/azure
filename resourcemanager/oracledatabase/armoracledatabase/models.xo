/// MaintenanceWindow resource properties
pub struct MaintenanceWindow {
  /// Determines the amount of time the system will wait before the start of each database server patching operation. Custom action timeout is in minutes and valid value is between 15 to 120 (inclusive).
  pub custom_action_timeout_in_mins as "customActionTimeoutInMins,omitempty": Int? = None
  /// Days during the week when maintenance should be performed.
  pub days_of_week as "daysOfWeek,omitempty": List[DayOfWeek]? = None
  /// The window of hours during the day when maintenance should be performed. The window is a 4 hour slot. Valid values are - 0 - represents time slot 0:00 - 3:59 UTC - 4 - represents time slot 4:00 - 7:59 UTC - 8 - represents time slot 8:00 - 11:59 UTC - 12 - represents time slot 12:00 - 15:59 UTC - 16 - represents time slot 16:00 - 19:59 UTC - 20 - represents time slot 20:00 - 23:59 UTC
  pub hours_of_day as "hoursOfDay,omitempty": List[Int]? = None
  /// If true, enables the configuration of a custom action timeout (waiting period) between database server patching operations.
  pub is_custom_action_timeout_enabled as "isCustomActionTimeoutEnabled,omitempty": Bool? = None
  /// is Monthly Patching Enabled
  pub is_monthly_patching_enabled as "isMonthlyPatchingEnabled,omitempty": Bool? = None
  /// Lead time window allows user to set a lead time to prepare for a down time. The lead time is in weeks and valid value is between 1 to 4.
  pub lead_time_in_weeks as "leadTimeInWeeks,omitempty": Int? = None
  /// Months during the year when maintenance should be performed.
  pub months as "months,omitempty": List[Month]? = None
  /// Cloud Exadata infrastructure node patching method.
  pub patching_mode as "patchingMode,omitempty": PatchingMode? = None
  /// The maintenance window scheduling preference.
  pub preference as "preference,omitempty": Preference? = None
  /// Weeks during the month when maintenance should be performed. Weeks start on the 1st, 8th, 15th, and 22nd days of the month, and have a duration of 7 days. Weeks start and end based on calendar dates, not days of the week. For example, to allow maintenance during the 2nd week of the month (from the 8th day to the 14th day of the month), use the value 2. Maintenance cannot be scheduled for the fifth week of months that contain more than 28 days. Note that this parameter works in conjunction with the  daysOfWeek and hoursOfDay parameters to allow you to specify specific days of the week and hours that maintenance will be performed.
  pub weeks_of_month as "weeksOfMonth,omitempty": List[Int]? = None
} derive Json

