  gv_note(f, "CALL CloudVMClustersClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", CloudVMClustersClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_cloud_vm_clusters_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_39)
}

fn show_cloud_vm_clusters_client_list_by_subscription_response(r: CloudVMClustersClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cloud_vm_cluster_list_result).to_str_lossy()}")
  parts.join(" ")
}

