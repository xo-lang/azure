  let f = gv_new_fake(os.net)
  let c = new_golden_gate_deployments_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"backupSchedule\":{\"bucketName\":\"s-bucketname\",\"compartmentId\":\"s-compartmentid\",\"frequencyBackupScheduled\":\"s-frequencybackupscheduled\",\"isMetadataOnly\":true,\"namespaceName\":\"s-namespacename\",\"timeBackupScheduled\":\"s-timebackupscheduled\"},\"category\":\"s-category\",\"compartment\":\"s-compartment\",\"cpuCoreCount\":7,\"deploymentType\":\"s-deploymenttype\",\"deploymentUrl\":\"s-deploymenturl\",\"displayName\":\"s-displayname\",\"environmentType\":\"s-environmenttype\",\"ingressIps\":[\"s-ingressips\"],\"isAutoScalingEnabled\":true,\"isPublic\":true,\"licenseModel\":\"s-licensemodel\",\"lifecycleDetails\":\"s-lifecycledetails\",\"lifecycleState\":\"s-lifecyclestate\",\"maintenanceConfiguration\":{\"bundleReleaseUpgradePeriodInDays\":7,\"interimReleaseUpgradePeriodInDays\":7,\"isInterimReleaseAutoUpgradeEnabled\":true,\"majorReleaseUpgradePeriodInDays\":7,\"securityPatchUpgradePeriodInDays\":7},\"maintenanceWindow\":{\"day\":\"s-day\",\"startHour\":7},\"networkAnchorId\":\"s-networkanchorid\",\"ocid\":\"s-ocid\",\"oggData\":{\"adminPassword\":\"s-adminpassword\",\"adminUsername\":\"s-adminusername\",\"certificate\":\"s-certificate\",\"credentialStore\":\"s-credentialstore\",\"deploymentName\":\"s-deploymentname\",\"groupToRolesMapping\":{\"administratorGroupId\":\"s-administratorgroupid\",\"identityDomainId\":\"s-identitydomainid\",\"key\":\"s-key\",\"operatorGroupId\":\"s-operatorgroupid\",\"securityGroupId\":\"s-securitygroupid\",\"userGroupId\":\"s-usergroupid\"},\"oggVersion\":\"s-oggversion\",\"passwordSecretId\":\"s-passwordsecretid\"},\"privateIpAddress\":\"s-privateipaddress\",\"provisioningState\":\"Succeeded\",\"resourceAnchorId\":\"s-resourceanchorid\",\"storageUtilizationInBytes\":7,\"timeCreated\":\"s-timecreated\",\"timeUpdated\":\"s-timeupdated\",\"timeZone\":\"s-timezone\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
  gv_note(f, "CALL GoldenGateDeploymentsClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(GoldenGateDeploymentsClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_golden_gate_deployments_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_105)
}

