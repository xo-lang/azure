fn show_autonomous_databases_client_create_or_update_response(r: AutonomousDatabasesClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.autonomous_database).to_str_lossy()}")
  parts.join(" ")
}

