fn show_autonomous_databases_client_list_by_resource_group_response(r: AutonomousDatabasesClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.autonomous_database_list_result).to_str_lossy()}")
  parts.join(" ")
}

