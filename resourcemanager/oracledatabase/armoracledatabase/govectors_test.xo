  gv_note(f, "CALL AutonomousDatabasesClient.BeginSwitchover")
  match c.begin_switchover("id1/ x", "id2/ x", (json.decode_str[PeerDbDetails]("{\"peerDbId\":\"s-peerdbid\",\"peerDbLocation\":\"s-peerdblocation\",\"peerDbOcid\":\"s-peerdbocid\"}") ?? e => fault("${e}")), AutonomousDatabasesClientBeginSwitchoverOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_autonomous_databases_client_switchover_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_18)
}

fn show_autonomous_databases_client_update_response(r: AutonomousDatabasesClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.autonomous_database).to_str_lossy()}")
  parts.join(" ")
}

