test "Go's AutonomousDatabasesClient.BeginDelete" {
  let f = gv_new_fake(os.net)
  let c = new_autonomous_databases_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL AutonomousDatabasesClient.BeginDelete")
  match c.begin_delete("id1/ x", "id2/ x", AutonomousDatabasesClientBeginDeleteOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_autonomous_databases_client_delete_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_14)
}

fn show_autonomous_databases_client_failover_response(r: AutonomousDatabasesClientFailoverResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.autonomous_database).to_str_lossy()}")
  parts.join(" ")
}

