  "CALL AutonomousDatabasesClient.BeginDelete",
  "REQ DELETE https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Oracle.Database/autonomousDatabases/id2%2F%20x?api-version=2026-06-01",
