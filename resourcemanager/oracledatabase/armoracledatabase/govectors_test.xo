  gv_note(f, "CALL AutonomousDatabasesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", AutonomousDatabasesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_autonomous_databases_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_22)
}

fn show_autonomous_databases_client_list_by_subscription_response(r: AutonomousDatabasesClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.autonomous_database_list_result).to_str_lossy()}")
  parts.join(" ")
}

