test "Go's BackupVaultsClient.NewGetInResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_backup_vaults_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"eTag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"bcdrSecurityLevel\":\"s-bcdrsecuritylevel\",\"costManagementSettings\":{\"granularityLevel\":\"s-granularitylevel\"},\"featureSettings\":{\"crossRegionRestoreSettings\":{\"state\":\"s-state\"},\"crossSubscriptionRestoreSettings\":{\"state\":\"s-state\"}},\"isVaultProtectedByResourceGuard\":true,\"monitoringSettings\":{\"azureMonitorAlertSettings\":{\"alertsForAllJobFailures\":\"s-alertsforalljobfailures\"}},\"provisioningState\":\"Succeeded\",\"replicatedRegions\":[\"s-replicatedregions\"],\"resourceGuardOperationRequests\":[\"s-resourceguardoperationrequests\"],\"resourceMoveDetails\":{\"completionTimeUtc\":\"s-completiontimeutc\",\"operationId\":\"s-operationid\",\"sourceResourcePath\":\"s-sourceresourcepath\",\"startTimeUtc\":\"s-starttimeutc\",\"targetResourcePath\":\"s-targetresourcepath\"},\"resourceMoveState\":\"s-resourcemovestate\",\"secureScore\":\"s-securescore\",\"securitySettings\":{\"encryptionSettings\":{\"infrastructureEncryption\":\"s-infrastructureencryption\",\"kekIdentity\":{\"identityId\":\"s-identityid\",\"identityType\":\"s-identitytype\"},\"keyVaultProperties\":{\"keyUri\":\"s-keyuri\"},\"state\":\"s-state\"},\"immutabilitySettings\":{\"state\":\"s-state\"},\"softDeleteSettings\":{\"retentionDurationInDays\":1.5,\"state\":\"s-state\"}},\"storageSettings\":[{\"datastoreType\":\"s-datastoretype\",\"type\":\"s-type\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BackupVaultsClient.NewGetInResourceGroupPager")
  var pg = c.new_get_in_resource_group_pager("id1/ x", BackupVaultsClientGetInResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_backup_vaults_client_get_in_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_29)
}

