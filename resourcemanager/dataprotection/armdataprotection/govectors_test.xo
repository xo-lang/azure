fn show_jobs_client_list_response(r: JobsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.azure_backup_job_resource_list).to_str_lossy()}")
  parts.join(" ")
}

