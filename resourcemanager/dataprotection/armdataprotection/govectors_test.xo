test "Go's BackupPoliciesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_backup_policies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"datasourceTypes\":[\"s-datasourcetypes\"],\"objectType\":\"BackupPolicy\",\"policyRules\":[{\"backupParameters\":{\"backupType\":\"s-backuptype\",\"objectType\":\"AzureBackupParams\"},\"name\":\"s-name\",\"objectType\":\"AzureBackupRule\",\"trigger\":{\"objectType\":\"AdhocBasedTriggerContext\"}}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BackupPoliciesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", BackupPoliciesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_backup_policies_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_22)
}

fn show_backup_vault_operation_results_client_get_response(r: BackupVaultOperationResultsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.backup_vault_resource).to_str_lossy()}")
  if let Some(v) = r.azure_async_operation {
    parts.push("AzureAsyncOperation=${v}")
  }
  if let Some(v) = r.location {
    parts.push("Location=${v}")
  }
  if let Some(v) = r.retry_after {
    parts.push("RetryAfter=${"${v}"}")
  }
  parts.join(" ")
}

