fn show_backup_instances_client_list_response(r: BackupInstancesClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.backup_instance_resource_list).to_str_lossy()}")
  parts.join(" ")
}

