test "Go's RecoveryPointsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_recovery_points_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"expiryTime\":\"2026-11-06T10:00:00Z\",\"friendlyName\":\"s-friendlyname\",\"objectType\":\"AzureBackupDiscreteRecoveryPoint\",\"policyName\":\"s-policyname\",\"policyVersion\":\"s-policyversion\",\"recoveryPointDataStoresDetails\":[{\"creationTime\":\"2026-11-06T10:00:00Z\",\"expiryTime\":\"2026-11-06T10:00:00Z\",\"id\":\"s-id\",\"metaData\":\"s-metadata\",\"rehydrationExpiryTime\":\"2026-11-06T10:00:00Z\",\"rehydrationStatus\":\"s-rehydrationstatus\",\"state\":\"s-state\",\"type\":\"s-type\",\"visible\":true}],\"recoveryPointId\":\"s-recoverypointid\",\"recoveryPointState\":\"s-recoverypointstate\",\"recoveryPointTime\":\"2026-11-06T10:00:00Z\",\"recoveryPointType\":\"s-recoverypointtype\",\"retentionTagName\":\"s-retentiontagname\",\"retentionTagVersion\":\"s-retentiontagversion\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RecoveryPointsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", RecoveryPointsClientListOptions{filter: Some("s-filter"), skip_token: Some("s-skiptoken")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_recovery_points_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_55)
}

