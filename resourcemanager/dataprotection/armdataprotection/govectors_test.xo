  let f = gv_new_fake(os.net)
  let c = new_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"activityID\":\"s-activityid\",\"backupInstanceFriendlyName\":\"s-backupinstancefriendlyname\",\"backupInstanceId\":\"s-backupinstanceid\",\"dataSourceId\":\"s-datasourceid\",\"dataSourceLocation\":\"s-datasourcelocation\",\"dataSourceName\":\"s-datasourcename\",\"dataSourceSetName\":\"s-datasourcesetname\",\"dataSourceType\":\"s-datasourcetype\",\"destinationDataStoreName\":\"s-destinationdatastorename\",\"duration\":\"s-duration\",\"endTime\":\"2026-11-06T10:00:00Z\",\"errorDetails\":[{\"code\":\"s-code\",\"innerError\":{\"additionalInfo\":{\"k1\":\"s-additionalinfo\"},\"code\":\"s-code\"},\"isRetryable\":true,\"isUserError\":true,\"message\":\"s-message\",\"properties\":{\"k1\":\"s-properties\"},\"recommendedAction\":[\"s-recommendedaction\"],\"target\":\"s-target\"}],\"etag\":\"s-etag\",\"extendedInfo\":{\"additionalDetails\":{\"k1\":\"s-additionaldetails\"},\"backupInstanceState\":\"s-backupinstancestate\",\"dataTransferredInBytes\":1.5,\"recoveryDestination\":\"s-recoverydestination\",\"sourceRecoverPoint\":{\"recoveryPointID\":\"s-recoverypointid\",\"recoveryPointTime\":\"2026-11-06T10:00:00Z\"},\"subTasks\":[{\"additionalDetails\":{\"k1\":\"s-additionaldetails\"},\"taskId\":7,\"taskName\":\"s-taskname\",\"taskProgress\":\"s-taskprogress\",\"taskStatus\":\"s-taskstatus\"}],\"targetRecoverPoint\":{\"recoveryPointID\":\"s-recoverypointid\",\"recoveryPointTime\":\"2026-11-06T10:00:00Z\"},\"warningDetails\":[{\"resourceName\":\"s-resourcename\"}]},\"isUserTriggered\":true,\"operation\":\"s-operation\",\"operationCategory\":\"s-operationcategory\",\"policyId\":\"s-policyid\",\"policyName\":\"s-policyname\",\"progressEnabled\":true,\"progressUrl\":\"s-progressurl\",\"rehydrationPriority\":\"s-rehydrationpriority\",\"restoreType\":\"s-restoretype\",\"sourceDataStoreName\":\"s-sourcedatastorename\",\"sourceResourceGroup\":\"s-sourceresourcegroup\",\"sourceSubscriptionID\":\"s-sourcesubscriptionid\",\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"subscriptionId\":\"s-subscriptionid\",\"supportedActions\":[\"s-supportedactions\"],\"vaultName\":\"s-vaultname\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL JobsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", JobsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
