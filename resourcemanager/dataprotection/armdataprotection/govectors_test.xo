// Generated from the output of a local Go program that calls every
// public method of each client of armdataprotection v4.2.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_backup_instances_client_adhoc_backup_response(r: BackupInstancesClientAdhocBackupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_job_extended_info).to_str_lossy()}")
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL BackupInstancesClient.BeginAdhocBackup",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.DataProtection/backupVaults/id2%2F%20x/backupInstances/id3%2F%20x/backup?api-version=2026-06-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"backupRuleOptions\":{\"ruleName\":\"s-rulename\",\"triggerOption\":{\"retentionTagOverride\":\"s-retentiontagoverride\"}}}",
  "  SERVED 200 {\"jobId\":\"s-jobid\",\"objectType\":\"OperationJobExtendedInfo\"}",
  "OUT: body={\"jobId\":\"s-jobid\",\"objectType\":\"OperationJobExtendedInfo\"}",
]

test "Go's BackupInstancesClient.BeginAdhocBackup" {
  let f = gv_new_fake(os.net)
  let c = new_backup_instances_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"jobId\":\"s-jobid\",\"objectType\":\"OperationJobExtendedInfo\"}")
  gv_note(f, "CALL BackupInstancesClient.BeginAdhocBackup")
  match c.begin_adhoc_backup("id1/ x", "id2/ x", "id3/ x", (json.decode_str[TriggerBackupRequest]("{\"backupRuleOptions\":{\"ruleName\":\"s-rulename\",\"triggerOption\":{\"retentionTagOverride\":\"s-retentiontagoverride\"}}}") ?? e => fault("${e}")), BackupInstancesClientBeginAdhocBackupOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_backup_instances_client_adhoc_backup_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

fn show_backup_instances_client_create_or_update_response(r: BackupInstancesClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.backup_instance_resource).to_str_lossy()}")
  parts.join(" ")
}

