":\"s-properties\"},\"target\":\"s-target\"}],\"innerError\":{\"additionalInfo\":{\"k1\":\"s-additionalinfo\"},\"code\":\"s-code\",\"embeddedInnerError\":{\"additionalInfo\":{\"k1\":\"s-additionalinfo\"},\"code\":\"s-code\"}},\"isRetryable\":true,\"isUserError\":true,\"message\":\"s-message\",\"properties\":{\"k1\":\"s-properties\"},\"recommendedAction\":[\"s-recommendedaction\"],\"target\":\"s-target\"},\"protectionStatus\":{\"errorDetails\":{\"code\":\"s-code\",\"innerError\":{\"additionalInfo\":{\"k1\":\"s-additionalinfo\"},\"code\":\"s-code\"},\"isRetryable\":true,\"isUserError\":true,\"message\":\"s-message\",\"properties\":{\"k1\":\"s-properties\"},\"recommendedAction\":[\"s-recommendedaction\"],\"target\":\"s-target\"},\"status\":\"s-status\"},\"provisioningState\":\"Succeeded\",\"resourceGuardOperationRequests\":[\"s-resourceguardoperationrequests\"],\"validationType\":\"s-validationtype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DeletedBackupInstancesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", DeletedBackupInstancesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_deleted_backup_instances_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_34)
}

