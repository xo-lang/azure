test "Go's DeletedBackupVaultsClient.NewListByLocationPager" {
  let f = gv_new_fake(os.net)
  let c = new_deleted_backup_vaults_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"bcdrSecurityLevel\":\"s-bcdrsecuritylevel\",\"costManagementSettings\":{\"granularityLevel\":\"s-granularitylevel\"},\"featureSettings\":{\"crossRegionRestoreSettings\":{\"state\":\"s-state\"},\"crossSubscriptionRestoreSettings\":{\"state\":\"s-state\"}},\"isVaultProtectedByResourceGuard\":true,\"monitoringSettings\":{\"azureMonitorAlertSettings\":{\"alertsForAllJobFailures\":\"s-alertsforalljobfailures\"}},\"originalBackupVaultId\":\"s-originalbackupvaultid\",\"originalBackupVaultName\":\"s-originalbackupvaultname\",\"originalBackupVaultResourcePath\":\"s-originalbackupvaultresourcepath\",\"provisioningState\":\"Succeeded\",\"replicatedRegions\":[\"s-replicatedregions\"],\"resourceDeletionInfo\":{\"deleteActivityId\":\"s-deleteactivityid\",\"deletionTime\":\"2026-11-06T10:00:00Z\",\"scheduledPurgeTime\":\"2026-11-06T10:00:00Z\"},\"resourceGuardOperationRequests\":[\"s-resourceguardoperationrequests\"],\"resourceMoveDetails\":{\"completionTimeUtc\":\"s-completiontimeutc\",\"operationId\":\"s-operationid\",\"sourceResourcePath\":\"s-sourceresourcepath\",\"startTimeUtc\":\"s-starttimeutc\",\"targetResourcePath\":\"s-targetresourcepath\"},\"resourceMoveState\":\"s-resourcemovestate\",\"secureScore\":\"s-securescore\",\"securitySettings\":{\"encryptionSettings\":{\"infrastructureEncryption\":\"s-infrastructureencryption\",\"kekIdentity\":{\"identityId\":\"s-identityid\",\"identityType\":\"s-identitytype\"},\"keyVaultProperties\":{\"keyUri\":\"s-keyuri\"},\"state\":\"s-state\"},\"immutabilitySettings\":{\"state\":\"s-state\"},\"softDeleteSettings\":{\"retentionDurationInDays\":1.5,\"state\":\"s-state\"}},\"storageSettings\":[{\"datastoreType\":\"s-datastoretype\",\"type\":\"s-type\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DeletedBackupVaultsClient.NewListByLocationPager")
  var pg = c.new_list_by_location_pager("id1/ x", DeletedBackupVaultsClientListByLocationOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_deleted_backup_vaults_client_list_by_location_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_36)
}

