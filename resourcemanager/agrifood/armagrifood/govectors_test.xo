fn show_private_link_resources_client_list_by_resource_response(r: PrivateLinkResourcesClientListByResourceResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.private_link_resource_list_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_21: List[Str] = [
  "CALL PrivateLinkResourcesClient.NewListByResourcePager",
  "REQ GET https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.AgFoodPlatform/farmBeats/id2%2F%20x/privateLinkResources?api-version=2021-09-01-preview",
