test "Go's TriggersClient.NewListByShareSubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_triggers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"kind\":\"ScheduleBased\",\"name\":\"s-name\",\"properties\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"recurrenceInterval\":\"s-recurrenceinterval\",\"synchronizationMode\":\"s-synchronizationmode\",\"synchronizationTime\":\"2026-11-06T10:00:00Z\",\"triggerStatus\":\"s-triggerstatus\",\"userName\":\"s-username\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL TriggersClient.NewListByShareSubscriptionPager")
  var pg = c.new_list_by_share_subscription_pager("id1/ x", "id2/ x", "id3/ x", TriggersClientListByShareSubscriptionOptions{skip_token: Some("s-skiptoken")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_triggers_client_list_by_share_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_52)
}
