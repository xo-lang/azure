test "Go's ConsumerInvitationsClient.NewListInvitationsPager" {
  let f = gv_new_fake(os.net)
  let c = new_consumer_invitations_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"dataSetCount\":7,\"description\":\"s-description\",\"expirationDate\":\"2026-11-06T10:00:00Z\",\"invitationId\":\"s-invitationid\",\"invitationStatus\":\"s-invitationstatus\",\"location\":\"s-location\",\"providerEmail\":\"s-provideremail\",\"providerName\":\"s-providername\",\"providerTenantName\":\"s-providertenantname\",\"respondedAt\":\"2026-11-06T10:00:00Z\",\"sentAt\":\"2026-11-06T10:00:00Z\",\"shareName\":\"s-sharename\",\"termsOfUse\":\"s-termsofuse\",\"userEmail\":\"s-useremail\",\"userName\":\"s-username\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ConsumerInvitationsClient.NewListInvitationsPager")
  var pg = c.new_list_invitations_pager(ConsumerInvitationsClientListInvitationsOptions{skip_token: Some("s-skiptoken")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_consumer_invitations_client_list_invitations_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_7)
}

