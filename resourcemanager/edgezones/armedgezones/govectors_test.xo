test "Go's ExtendedZonesClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_extended_zones_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"displayName\":\"s-displayname\",\"geography\":\"s-geography\",\"geographyGroup\":\"s-geographygroup\",\"homeLocation\":\"s-homelocation\",\"latitude\":\"s-latitude\",\"longitude\":\"s-longitude\",\"provisioningState\":\"Succeeded\",\"regionCategory\":\"s-regioncategory\",\"regionType\":\"s-regiontype\",\"regionalDisplayName\":\"s-regionaldisplayname\",\"registrationState\":\"s-registrationstate\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ExtendedZonesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(ExtendedZonesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_extended_zones_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_1)
}

