test "Go's ExtendedZonesClient.Get" {
  let f = gv_new_fake(os.net)
  let c = new_extended_zones_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"displayName\":\"s-displayname\",\"geography\":\"s-geography\",\"geographyGroup\":\"s-geographygroup\",\"homeLocation\":\"s-homelocation\",\"latitude\":\"s-latitude\",\"longitude\":\"s-longitude\",\"provisioningState\":\"Succeeded\",\"regionCategory\":\"s-regioncategory\",\"regionType\":\"s-regiontype\",\"regionalDisplayName\":\"s-regionaldisplayname\",\"registrationState\":\"s-registrationstate\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ExtendedZonesClient.Get")
