test "Go's ContainerGroupsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_container_groups_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"confidentialComputeProperties\":{\"ccePolicy\":\"s-ccepolicy\"},\"containers\":[{\"name\":\"s-name\",\"properties\":{\"image\":\"s-image\"}}],\"diagnostics\":{\"logAnalytics\":{\"logType\":\"s-logtype\",\"metadata\":{\"k1\":\"s-metadata\"},\"workspaceId\":\"s-workspaceid\",\"workspaceKey\":\"s-workspacekey\",\"workspaceResourceId\":\"s-workspaceresourceid\"}},\"dnsConfig\":{\"nameServers\":[\"s-nameservers\"],\"options\":\"s-options\",\"searchDomains\":\"s-searchdomains\"},\"encryptionProperties\":{\"identity\":\"s-identity\",\"keyName\":\"s-keyname\",\"keyVersion\":\"s-keyversion\",\"vaultBaseUrl\":\"s-vaultbaseurl\"},\"extensions\":[{\"name\":\"s-name\",\"properties\":{\"extensionType\":\"s-extensiontype\",\"protectedSettings\":{\"k\":\"v\"},\"settings\":{\"k\":\"v\"},\"version\":\"s-version\"}}],\"imageRegistryCredentials\":[{\"identity\":\"s-identity\",\"identityUrl\":\"s-identityurl\",\"password\":\"s-password\",\"server\":\"s-server\",\"username\":\"s-username\"}],\"initContainers\":[{\"name\":\"s-name\",\"properties\":{\"image\":\"s-image\"}}],\"instanceView\":{\"events\":[{\"count\":7,\"firstTimestamp\":\"2026-11-06T10:00:00Z\",\"lastTimestamp\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"name\":\"s-name\",\"type\":\"s-type\"}],\"state\":\"s-state\"},\"ipAddress\":{\"autoGeneratedDomainNameLabelScope\":\"s-autogenerateddomainnamelabelscope\",\"dnsNameLabel\":\"s-dnsnamelabel\",\"fqdn\":\"s-fqdn\",\"ip\":\"s-ip\",\"ports\":[{\"port\":7,\"protocol\":\"s-protocol\"}],\"type\":\"s-type\"},\"osType\":\"s-ostype\",\"priority\":\"s-priority\",\"provisioningState\":\"Succeeded\",\"restartPolicy\":\"s-restartpolicy\",\"sku\":\"s-sku\",\"subnetIds\":[{\"id\":\"s-id\",\"name\":\"s-name\"}],\"volumes\":[{\"azureFile\":{\"readOnly\":true,\"shareName\":\"s-sharename\",\"storageAccountKey\":\"s-storageaccountkey\",\"storageAccountName\":\"s-storageaccountname\"},\"emptyDir\":{\"k\":\"v\"},\"gitRepo\":{\"directory\":\"s-directory\",\"repository\":\"s-repository\",\"revision\":\"s-revision\"},\"name\":\"s-name\",\"secret\":{\"k1\":\"s-secret\"}}]},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
  gv_note(f, "CALL ContainerGroupsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ContainerGroupsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_container_groups_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_6)
}

fn show_container_groups_client_list_response(r: ContainerGroupsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.container_group_list_result).to_str_lossy()}")
  parts.join(" ")
}

