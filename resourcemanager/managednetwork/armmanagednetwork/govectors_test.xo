  var pg = c.new_list_by_managed_network_pager("id1/ x", "id2/ x", GroupsClientListByManagedNetworkOptions{skiptoken: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
