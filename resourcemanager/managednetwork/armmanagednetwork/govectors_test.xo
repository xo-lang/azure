  let f = gv_new_fake(os.net)
  let c = new_groups_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"etag\":\"s-etag\",\"managementGroups\":[{\"id\":\"s-id\"}],\"provisioningState\":\"Succeeded\",\"subnets\":[{\"id\":\"s-id\"}],\"subscriptions\":[{\"id\":\"s-id\"}],\"virtualNetworks\":[{\"id\":\"s-id\"}]},\"type\":\"s-type\"}]}")
