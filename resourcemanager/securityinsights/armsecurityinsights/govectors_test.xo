  gv_note(f, "CALL ThreatIntelligenceIndicatorsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ThreatIntelligenceIndicatorsClientListOptions{filter: Some("s-filter"), orderby: Some("s-orderby"), skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_threat_intelligence_indicators_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_50)
}

