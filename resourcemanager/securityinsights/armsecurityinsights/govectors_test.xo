test "Go's ThreatIntelligenceIndicatorClient.NewQueryIndicatorsPager" {
  let f = gv_new_fake(os.net)
  let c = new_threat_intelligence_indicator_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"indicator\",\"name\":\"s-name\",\"properties\":{\"additionalData\":{\"k1\":{\"k\":\"v\"}},\"confidence\":7,\"created\":\"s-created\",\"createdByRef\":\"s-createdbyref\",\"defanged\":true,\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"extensions\":{\"k1\":{\"k\":\"v\"}},\"externalId\":\"s-externalid\",\"externalLastUpdatedTimeUtc\":\"s-externallastupdatedtimeutc\",\"externalReferences\":[{\"description\":\"s-description\",\"externalId\":\"s-externalid\",\"hashes\":{\"k1\":\"s-hashes\"},\"sourceName\":\"s-sourcename\",\"url\":\"s-url\"}],\"friendlyName\":\"s-friendlyname\",\"granularMarkings\":[{\"language\":\"s-language\",\"markingRef\":7}],\"indicatorTypes\":[\"s-indicatortypes\"],\"killChainPhases\":[{\"killChainName\":\"s-killchainname\",\"phaseName\":\"s-phasename\"}],\"labels\":[\"s-labels\"],\"language\":\"s-language\",\"lastUpdatedTimeUtc\":\"s-lastupdatedtimeutc\",\"modified\":\"s-modified\",\"objectMarkingRefs\":[\"s-objectmarkingrefs\"],\"parsedPattern\":[{\"patternTypeKey\":\"s-patterntypekey\"}],\"pattern\":\"s-pattern\",\"patternType\":\"s-patterntype\",\"patternVersion\":\"s-patternversion\",\"revoked\":true,\"source\":\"s-source\",\"threatIntelligenceTags\":[\"s-threatintelligencetags\"],\"threatTypes\":[\"s-threattypes\"],\"validFrom\":\"s-validfrom\",\"validUntil\":\"s-validuntil\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ThreatIntelligenceIndicatorClient.NewQueryIndicatorsPager")
  var pg = c.new_query_indicators_pager("id1/ x", "id2/ x", (json.decode_str[ThreatIntelligenceFilteringCriteria]("{\"ids\":[\"s-ids\"],\"includeDisabled\":true,\"keywords\":[\"s-keywords\"],\"maxConfidence\":7,\"maxValidUntil\":\"s-maxvaliduntil\",\"minConfidence\":7,\"minValidUntil\":\"s-minvaliduntil\",\"pageSize\":7,\"patternTypes\":[\"s-patterntypes\"],\"skipToken\":\"s-skiptoken\",\"sortBy\":[{\"itemKey\":\"s-itemkey\",\"sortOrder\":\"s-sortorder\"}],\"sources\":[\"s-sources\"],\"threatTypes\":[\"s-threattypes\"]}") ?? e => fault("${e}")), ThreatIntelligenceIndicatorClientQueryIndicatorsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_threat_intelligence_indicator_client_query_indicators_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_47)
}

