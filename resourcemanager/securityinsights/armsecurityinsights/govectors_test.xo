test "Go's BookmarksClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_bookmarks_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"created\":\"2026-11-06T10:00:00Z\",\"createdBy\":{\"email\":\"s-email\",\"name\":\"s-name\",\"objectId\":\"s-objectid\"},\"displayName\":\"s-displayname\",\"eventTime\":\"2026-11-06T10:00:00Z\",\"incidentInfo\":{\"incidentId\":\"s-incidentid\",\"relationName\":\"s-relationname\",\"severity\":\"s-severity\",\"title\":\"s-title\"},\"labels\":[\"s-labels\"],\"notes\":\"s-notes\",\"query\":\"s-query\",\"queryEndTime\":\"2026-11-06T10:00:00Z\",\"queryResult\":\"s-queryresult\",\"queryStartTime\":\"2026-11-06T10:00:00Z\",\"updated\":\"2026-11-06T10:00:00Z\",\"updatedBy\":{\"email\":\"s-email\",\"name\":\"s-name\",\"objectId\":\"s-objectid\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BookmarksClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", BookmarksClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_bookmarks_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_17)
}

