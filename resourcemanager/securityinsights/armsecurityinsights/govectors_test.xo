test "Go's AutomationRulesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_automation_rules_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"actions\":[{\"actionType\":\"ModifyProperties\",\"order\":7}],\"createdBy\":{\"email\":\"s-email\",\"name\":\"s-name\",\"objectId\":\"s-objectid\",\"userPrincipalName\":\"s-userprincipalname\"},\"createdTimeUtc\":\"2026-11-06T10:00:00Z\",\"displayName\":\"s-displayname\",\"lastModifiedBy\":{\"email\":\"s-email\",\"name\":\"s-name\",\"objectId\":\"s-objectid\",\"userPrincipalName\":\"s-userprincipalname\"},\"lastModifiedTimeUtc\":\"2026-11-06T10:00:00Z\",\"order\":7,\"triggeringLogic\":{\"conditions\":[{\"conditionType\":\"Property\"}],\"expirationTimeUtc\":\"2026-11-06T10:00:00Z\",\"isEnabled\":true,\"triggersOn\":\"s-triggerson\",\"triggersWhen\":\"s-triggerswhen\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AutomationRulesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", AutomationRulesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_automation_rules_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_13)
}

