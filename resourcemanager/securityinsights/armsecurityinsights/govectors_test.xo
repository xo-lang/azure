test "Go's WatchlistsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_watchlists_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"contentType\":\"s-contenttype\",\"created\":\"2026-11-06T10:00:00Z\",\"createdBy\":{\"email\":\"s-email\",\"name\":\"s-name\",\"objectId\":\"s-objectid\"},\"defaultDuration\":\"s-defaultduration\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isDeleted\":true,\"itemsSearchKey\":\"s-itemssearchkey\",\"labels\":[\"s-labels\"],\"numberOfLinesToSkip\":7,\"provider\":\"s-provider\",\"rawContent\":\"s-rawcontent\",\"source\":\"s-source\",\"tenantId\":\"s-tenantid\",\"updated\":\"2026-11-06T10:00:00Z\",\"updatedBy\":{\"email\":\"s-email\",\"name\":\"s-name\",\"objectId\":\"s-objectid\"},\"uploadStatus\":\"s-uploadstatus\",\"watchlistAlias\":\"s-watchlistalias\",\"watchlistId\":\"s-watchlistid\",\"watchlistType\":\"s-watchlisttype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WatchlistsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", WatchlistsClientListOptions{skip_token: Some("s-skiptoken")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_watchlists_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_58)
}
