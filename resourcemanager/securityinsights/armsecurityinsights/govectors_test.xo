  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"contentType\":\"s-contenttype\",\"created\":\"2026-11-06T10:00:00Z\",\"createdBy\":{\"email\":\"s-email\",\"name\":\"s-name\",\"objectId\":\"s-objectid\"},\"defaultDuration\":\"s-defaultduration\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isDeleted\":true,\"itemsSearchKey\":\"s-itemssearchkey\",\"labels\":[\"s-labels\"],\"numberOfLinesToSkip\":7,\"provider\":\"s-provider\",\"rawContent\":\"s-rawcontent\",\"source\":\"s-source\",\"tenantId\":\"s-tenantid\",\"updated\":\"2026-11-06T10:00:00Z\",\"updatedBy\":{\"email\":\"s-email\",\"name\":\"s-name\",\"objectId\":\"s-objectid\"},\"uploadStatus\":\"s-uploadstatus\",\"watchlistAlias\":\"s-watchlistalias\",\"watchlistId\":\"s-watchlistid\",\"watchlistType\":\"s-watchlisttype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"contentType\":\"s-contenttype\",\"created\":\"2026-11-06T10:00:00Z\",\"createdBy\":{\"email\":\"s-email\",\"name\":\"s-name\",\"objectId\":\"s-objectid\"},\"defaultDuration\":\"s-defaultduration\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isDeleted\":true,\"itemsSearchKey\":\"s-itemssearchkey\",\"labels\":[\"s-labels\"],\"numberOfLinesToSkip\":7,\"provider\":\"s-provider\",\"rawContent\":\"s-rawcontent\",\"source\":\"s-source\",\"tenantId\":\"s-tenantid\",\"updated\":\"2026-11-06T10:00:00Z\",\"updatedBy\":{\"email\":\"s-email\",\"name\":\"s-name\",\"objectId\":\"s-objectid\"},\"uploadStatus\":\"s-uploadstatus\",\"watchlistAlias\":\"s-watchlistalias\",\"watchlistId\":\"s-watchlistid\",\"watchlistType\":\"s-watchlisttype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}",
