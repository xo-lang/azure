  let c = new_incidents_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"additionalData\":{\"alertProductNames\":[\"s-alertproductnames\"],\"alertsCount\":7,\"bookmarksCount\":7,\"commentsCount\":7,\"tactics\":[\"s-tactics\"]},\"classification\":\"s-classification\",\"classificationComment\":\"s-classificationcomment\",\"classificationReason\":\"s-classificationreason\",\"createdTimeUtc\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"firstActivityTimeUtc\":\"2026-11-06T10:00:00Z\",\"incidentNumber\":7,\"incidentUrl\":\"s-incidenturl\",\"labels\":[{\"labelName\":\"s-labelname\",\"labelType\":\"s-labeltype\"}],\"lastActivityTimeUtc\":\"2026-11-06T10:00:00Z\",\"lastModifiedTimeUtc\":\"2026-11-06T10:00:00Z\",\"owner\":{\"assignedTo\":\"s-assignedto\",\"email\":\"s-email\",\"objectId\":\"s-objectid\",\"userPrincipalName\":\"s-userprincipalname\"},\"relatedAnalyticRuleIds\":[\"s-relatedanalyticruleids\"],\"severity\":\"s-severity\",\"status\":\"s-status\",\"title\":\"s-title\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL IncidentsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", IncidentsClientListOptions{filter: Some("s-filter"), orderby: Some("s-orderby"), skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_incidents_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_36)
}

