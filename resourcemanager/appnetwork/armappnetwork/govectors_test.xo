test "Go's AppLinkMembersClient.NewListByAppLinkPager" {
  let f = gv_new_fake(os.net)
  let c = new_app_link_members_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"clusterType\":\"s-clustertype\",\"connectivityProfile\":{\"eastWestGateway\":{\"visibility\":\"s-visibility\"},\"network\":\"s-network\",\"privateConnect\":{\"subnetResourceId\":\"s-subnetresourceid\"}},\"metadata\":{\"resourceId\":\"s-resourceid\"},\"observabilityProfile\":{\"metrics\":{\"metricsEndpoint\":\"s-metricsendpoint\"}},\"provisioningState\":\"Succeeded\",\"upgradeProfile\":{\"fullyManagedUpgradeProfile\":{\"releaseChannel\":\"s-releasechannel\"},\"mode\":\"s-mode\",\"selfManagedUpgradeProfile\":{\"version\":\"s-version\"}}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AppLinkMembersClient.NewListByAppLinkPager")
  var pg = c.new_list_by_app_link_pager("id1/ x", "id2/ x", AppLinkMembersClientListByAppLinkOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
