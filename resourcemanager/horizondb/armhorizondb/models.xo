  /// Description of the parameter group. The maximum length is 1024 characters.
  pub description as "description,omitempty": json.Patch[Str] = json.Patch.Absent
  /// Parameters in the parameter group.
  pub parameters as "parameters,omitempty": json.Patch[List[ParameterProperties]] = json.Patch.Absent
} derive Json

/// HorizonDB parameter group for update operations.
pub struct ParameterGroupForPatchUpdate {
  /// The properties that can be updated for a HorizonDB parameter group.
  pub properties as "properties,omitempty": json.Patch[ParameterGroupPropertiesForPatchUpdate] = json.Patch.Absent
  /// Resource tags.
  pub tags as "tags,omitempty": json.Patch[Map[Str, Str]] = json.Patch.Absent
} derive Json

/// Connection information for HorizonDB parameter group.
pub struct ParameterGroupConnectionProperties {
  /// The Azure resource ID of the connected HorizonDB pool.
  pub pool_resource_id as "poolResourceId,omitempty": Str? = None
} derive Json

/// A page of HorizonDB parameter group connections.
pub struct PagedParameterGroupConnectionProperties {
  /// The link to the next page of items.
  pub next_link as "nextLink,omitempty": Str? = None
  /// The parameter group connection items on this page.
  pub value as "value,omitempty": List[ParameterGroupConnectionProperties]? = None
} derive Json

/// ClusterManagedServiceIdentityPatch: ClusterManagedServiceIdentity in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct ClusterManagedServiceIdentityPatch {
  /// The managed identity type assigned to the cluster. Setting this property to None clears all managed identity assignments.
  pub type_ as "type,omitempty": json.Patch[HorizonDbClusterIdentityType] = json.Patch.Absent
  /// The user-assigned managed identities associated with the cluster. When supplied on PUT, this dictionary replaces the complete set of assignments. When supplied on PATCH, entries are merged with the existing set and a null value removes the corresponding identity. Each dictionary key must be the full Azure resource ID of a Microsoft.ManagedIdentity/userAssignedIdentities resource. Non-null request values can be empty objects; response values contain the service-populated clientId and principalId. Assigning an identity does not grant it access to destination resources; required role assignments must be configured separately.
  pub user_assigned_identities as "userAssignedIdentities,omitempty": json.Patch[Map[Str, UserAssignedIdentity]] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: ClusterManagedServiceIdentity) patch() -> ClusterManagedServiceIdentityPatch {
  ClusterManagedServiceIdentityPatch{
    type_: match m.type_ {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    user_assigned_identities: match m.user_assigned_identities {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
