  let f = gv_new_fake(os.net)
  let c = new_clusters_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"aiModelManagement\":\"s-aimodelmanagement\",\"backup\":{\"earliestRestorePointUtc\":\"2026-11-06T10:00:00Z\",\"geoRedundancy\":\"s-georedundancy\",\"retentionDays\":7},\"creationMode\":\"s-creationmode\",\"creationSourceClusterLocation\":\"s-creationsourceclusterlocation\",\"creationSourceClusterResourceId\":\"s-creationsourceclusterresourceid\",\"dataEncryption\":{\"primaryEncryptionKeyCurrentVersion\":\"s-primaryencryptionkeycurrentversion\",\"primaryEncryptionKeyStatus\":\"s-primaryencryptionkeystatus\",\"primaryKeyUri\":\"s-primarykeyuri\",\"primaryUserAssignedIdentityId\":\"s-primaryuserassignedidentityid\",\"type\":\"s-type\"},\"network\":{\"publicAccess\":\"s-publicaccess\"},\"pointInTimeUtc\":\"2026-11-06T10:00:00Z\",\"postgreSqlVersion\":\"s-postgresqlversion\",\"provisioningState\":\"Succeeded\",\"readWritePool\":{\"designatedPoolResourceId\":\"s-designatedpoolresourceid\"},\"state\":\"s-state\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ClustersClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ClustersClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_clusters_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_24)
}

