pub struct PoolsClientStopResponse {
  pub pool: Pool
}

fn pools_stop_handle(resp: http.Response) -> PoolsClientStopResponse ! Str {
  let v = if resp.body.is_empty() { Pool{} } else { json.decode[Pool](resp.body) ?? e => return Err(e.display()) }
  Ok(PoolsClientStopResponse{pool: v})
}

fn (c: PoolsClient) stop_create_request(resource_group_name: Str, cluster_name: Str, pool_name: Str, options: PoolsClientBeginStopOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.HorizonDb/clusters/{clusterName}/pools/{poolName}/stop"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if cluster_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter clusterName cannot be empty"))
  }
  path = path.replace("{clusterName}", url.path_escape(cluster_name))
  if pool_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter poolName cannot be empty"))
  }
  path = path.replace("{poolName}", url.path_escape(pool_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: b""})
}

/// Stops a running HorizonDB pool and deallocates compute. Power operations are supported only at pool scope in this API version; there is no cluster-level stop action. Stop does not apply pending dynamic or static parameter changes; parameterGroup.syncStatus remains PendingReboot. A subsequent Start also preserves those pending changes. The operation succeeds as an idempotent no-op when the pool is already Stopped. It is allowed when the pool has no allocated nodes. The Pool-scoped ReadOnly Endpoint remains discoverable but has no routing destination while the Pool is Stopped. The request fails with 409 Conflict when another operation is in progress or the pool is in any other incompatible state.
pub fn (c: PoolsClient[fx]) begin_stop(resource_group_name: Str, cluster_name: Str, pool_name: Str, options: PoolsClientBeginStopOptions = PoolsClientBeginStopOptions{}) -> runtime.Poller[PoolsClientStopResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
