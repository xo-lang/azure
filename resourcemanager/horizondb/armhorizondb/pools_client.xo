  }
  let sp = runtime.start_span({}, "PoolsClient.BeginStart", c.setup.pipeline.tracer)
  let req = c.start_create_request(resource_group_name, cluster_name, pool_name, options) ?? e => return Err(sp.fail(e))
  let resp = c.setup.pipeline.send(sp.on(req)) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![200, 202].contains(resp.status) {
    return Err(sp.close(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  sp.end()
  runtime.new_poller(c.setup.pipeline, req, resp, "", "PoolsClientStartResponse", fn(r: http.Response) -> PoolsClientStartResponse ! Str { pools_start_handle(r) }, traced: true)
}

/// PoolsClientBeginStopOptions: the optional parameters of PoolsClient.begin_stop.
pub struct PoolsClientBeginStopOptions {
