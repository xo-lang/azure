  gv_note(f, "CALL ServicesClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[DeviceService]("{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"adminDomainName\":\"s-admindomainname\",\"billingDomainName\":\"s-billingdomainname\",\"notes\":\"s-notes\",\"quantity\":7,\"startDate\":\"2026-11-06T10:00:00Z\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), ServicesClientUpdateOptions{if_match: Some("s-ifmatch")}) {
    Ok(r) => gv_note(f, "OUT: ${show_services_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_7)
}
