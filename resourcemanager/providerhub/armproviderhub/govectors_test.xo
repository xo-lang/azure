fn show_custom_rollouts_client_list_by_provider_registration_response(r: CustomRolloutsClientListByProviderRegistrationResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.custom_rollout_array_response_with_continuation).to_str_lossy()}")
  parts.join(" ")
}

