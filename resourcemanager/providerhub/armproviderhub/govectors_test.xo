}

fn show_resource_actions_client_delete_resources_response(r: ResourceActionsClientDeleteResourcesResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_37: List[Str] = [
  "CALL ResourceActionsClient.BeginDeleteResources",
  "REQ POST https://management.example.test/subscriptions/sub-test/providers/Microsoft.ProviderHub/providerRegistrations/id1%2F%20x/resourceActions/id2%2F%20x/deleteResources?api-version=2025-10-01",
  "  H authorization=Bearer tok | content-type=application/json",
  "  B {\"resources\":[{\"homeTenantId\":\"s-hometenantid\",\"location\":\"s-location\",\"resourceId\":\"s-resourceid\",\"status\":\"s-status\"}]}",
  "  SERVED 202 ",
  "OUT: error: response is missing polling URL",
]

test "Go's ResourceActionsClient.BeginDeleteResources" {
  let f = gv_new_fake(os.net)
  let c = new_resource_actions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL ResourceActionsClient.BeginDeleteResources")
  match c.begin_delete_resources("id1/ x", "id2/ x", (json.decode_str[ResourceManagementAction]("{\"resources\":[{\"homeTenantId\":\"s-hometenantid\",\"location\":\"s-location\",\"resourceId\":\"s-resourceid\",\"status\":\"s-status\"}]}") ?? e => fault("${e}")), ResourceActionsClientBeginDeleteResourcesOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_resource_actions_client_delete_resources_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_37)
}

fn show_resource_type_registrations_client_create_or_update_response(r: ResourceTypeRegistrationsClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.resource_type_registration).to_str_lossy()}")
  parts.join(" ")
}

