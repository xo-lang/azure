test "Go's CustomRolloutsClient.Stop" {
  let f = gv_new_fake(os.net)
  let c = new_custom_rollouts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL CustomRolloutsClient.Stop")
  match c.stop("id1/ x", "id2/ x", CustomRolloutsClientStopOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_custom_rollouts_client_stop_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_10)
}

fn show_default_rollouts_client_create_or_update_response(r: DefaultRolloutsClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.default_rollout).to_str_lossy()}")
  parts.join(" ")
}

