test "Go's OperationsClient.Delete" {
  let f = gv_new_fake(os.net)
  let c = new_operations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 204, "")
  gv_note(f, "CALL OperationsClient.Delete")
  match c.delete("id1/ x", OperationsClientDeleteOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_operations_client_delete_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_23)
}

