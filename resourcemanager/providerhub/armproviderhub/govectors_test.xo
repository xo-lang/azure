fn show_custom_rollouts_client_create_or_update_response(r: CustomRolloutsClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.custom_rollout).to_str_lossy()}")
  parts.join(" ")
}

