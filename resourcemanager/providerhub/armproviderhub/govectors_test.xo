fn show_provider_registrations_client_list_response(r: ProviderRegistrationsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.provider_registration_array_response_with_continuation).to_str_lossy()}")
  parts.join(" ")
}

