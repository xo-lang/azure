  let c = new_default_rollouts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\",\"specification\":{\"autoProvisionConfig\":{\"resourceGraph\":true,\"storage\":true},\"canary\":{\"regions\":[\"s-regions\"],\"skipRegions\":[\"s-skipregions\"]},\"expeditedRollout\":{\"enabled\":true},\"highTraffic\":{\"regions\":[\"s-regions\"],\"waitDuration\":\"s-waitduration\"},\"lowTraffic\":{\"regions\":[\"s-regions\"],\"waitDuration\":\"s-waitduration\"},\"manifestCheckinSpecification\":{\"manifestCheckinOption\":\"s-manifestcheckinoption\",\"manifestCheckinParams\":{\"baselineArmManifestLocation\":\"s-baselinearmmanifestlocation\",\"environment\":\"s-environment\"}},\"mediumTraffic\":{\"regions\":[\"s-regions\"],\"waitDuration\":\"s-waitduration\"},\"providerRegistration\":{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"properties\":{\"crossTenantTokenValidation\":\"s-crosstenanttokenvalidation\",\"customManifestVersion\":\"s-custommanifestversion\",\"enablePresetResourceTypes\":true,\"enableTenantLinkedNotification\":true,\"legacyNamespace\":\"s-legacynamespace\",\"metadata\":{\"k\":\"v\"},\"namespace\":\"s-namespace\",\"notificationOptions\":\"s-notificationoptions\",\"oboSubscriptionId\":\"s-obosubscriptionid\",\"providerType\":\"s-providertype\",\"providerVersion\":\"s-providerversion\",\"provisioningState\":\"Succeeded\",\"serviceName\":\"s-servicename\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"},\"resourceTypeRegistrations\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"type\":\"s-type\"}],\"restOfTheWorldGroupOne\":{\"regions\":[\"s-regions\"],\"waitDuration\":\"s-waitduration\"},\"restOfTheWorldGroupTwo\":{\"regions\":[\"s-regions\"],\"waitDuration\":\"s-waitduration\"}},\"status\":{\"completedRegions\":[\"s-completedregions\"],\"failedOrSkippedRegions\":{\"k1\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}},\"manifestCheckinStatus\":{\"commitId\":\"s-commitid\",\"isCheckedIn\":true,\"pullRequest\":\"s-pullrequest\",\"statusMessage\":\"s-statusmessage\"},\"nextTrafficRegion\":\"s-nexttrafficregion\",\"nextTrafficRegionScheduledTime\":\"2026-11-06T10:00:00Z\",\"subscriptionReregistrationResult\":\"s-subscriptionreregistrationresult\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DefaultRolloutsClient.NewListByProviderRegistrationPager")
  var pg = c.new_list_by_provider_registration_pager("id1/ x", DefaultRolloutsClientListByProviderRegistrationOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_default_rollouts_client_list_by_provider_registration_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_14)
}

