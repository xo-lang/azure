  "CALL ResourceTypeRegistrationsClient.BeginDelete",
  "REQ DELETE https://management.example.test/subscriptions/sub-test/providers/Microsoft.ProviderHub/providerRegistrations/id1%2F%20x/resourcetypeRegistrations/id2%2F%20x?api-version=2025-10-01",
