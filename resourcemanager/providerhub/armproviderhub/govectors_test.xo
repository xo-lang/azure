test "Go's CustomRolloutsClient.NewListByProviderRegistrationPager" {
  let f = gv_new_fake(os.net)
  let c = new_custom_rollouts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\",\"specification\":{\"autoProvisionConfig\":{\"resourceGraph\":true,\"storage\":true},\"canary\":{\"regions\":[\"s-regions\"]},\"manifestCheckinSpecification\":{\"manifestCheckinOption\":\"s-manifestcheckinoption\",\"manifestCheckinParams\":{\"baselineArmManifestLocation\":\"s-baselinearmmanifestlocation\",\"environment\":\"s-environment\"}},\"providerRegistration\":{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"properties\":{\"crossTenantTokenValidation\":\"s-crosstenanttokenvalidation\",\"customManifestVersion\":\"s-custommanifestversion\",\"enablePresetResourceTypes\":true,\"enableTenantLinkedNotification\":true,\"legacyNamespace\":\"s-legacynamespace\",\"metadata\":{\"k\":\"v\"},\"namespace\":\"s-namespace\",\"notificationOptions\":\"s-notificationoptions\",\"oboSubscriptionId\":\"s-obosubscriptionid\",\"providerType\":\"s-providertype\",\"providerVersion\":\"s-providerversion\",\"provisioningState\":\"Succeeded\",\"serviceName\":\"s-servicename\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"},\"refreshSubscriptionRegistration\":true,\"releaseScopes\":[\"s-releasescopes\"],\"resourceTypeRegistrations\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"type\":\"s-type\"}],\"rolloutId\":\"s-rolloutid\",\"skipReleaseScopeValidation\":true},\"status\":{\"completedRegions\":[\"s-completedregions\"],\"completedRegionsInfo\":[{\"appliedCommitId\":\"s-appliedcommitid\",\"manifestAppliedAt\":\"2026-11-06T10:00:00Z\",\"previousCommitId\":\"s-previouscommitid\",\"region\":\"s-region\"}],\"failedOrSkippedRegions\":{\"k1\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}},\"manifestCheckinStatus\":{\"commitId\":\"s-commitid\",\"isCheckedIn\":true,\"pullRequest\":\"s-pullrequest\",\"statusMessage\":\"s-statusmessage\"}}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL CustomRolloutsClient.NewListByProviderRegistrationPager")
  var pg = c.new_list_by_provider_registration_pager("id1/ x", CustomRolloutsClientListByProviderRegistrationOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_custom_rollouts_client_list_by_provider_registration_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_9)
}

fn show_custom_rollouts_client_stop_response(r: CustomRolloutsClientStopResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

