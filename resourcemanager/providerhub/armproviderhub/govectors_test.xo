test "Go's NotificationRegistrationsClient.NewListByProviderRegistrationPager" {
  let f = gv_new_fake(os.net)
  let c = new_notification_registrations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"includedEvents\":[\"s-includedevents\"],\"messageScope\":\"s-messagescope\",\"notificationEndpoints\":[{\"locations\":[\"s-locations\"],\"notificationDestination\":\"s-notificationdestination\"}],\"notificationMode\":\"s-notificationmode\",\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL NotificationRegistrationsClient.NewListByProviderRegistrationPager")
  var pg = c.new_list_by_provider_registration_pager("id1/ x", NotificationRegistrationsClientListByProviderRegistrationOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_notification_registrations_client_list_by_provider_registration_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_21)
}

