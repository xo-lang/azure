  gv_note(f, "CALL ProviderRegistrationsClient.NewListPager")
  var pg = c.new_list_pager(ProviderRegistrationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_provider_registrations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
