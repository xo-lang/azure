test "Go's DataTypesClient.NewListByDataProductPager" {
  let f = gv_new_fake(os.net)
  let c = new_data_types_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"databaseCacheRetention\":7,\"databaseRetention\":7,\"provisioningState\":\"Succeeded\",\"state\":\"s-state\",\"stateReason\":\"s-statereason\",\"storageOutputRetention\":7,\"visualizationUrl\":\"s-visualizationurl\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DataTypesClient.NewListByDataProductPager")
  var pg = c.new_list_by_data_product_pager("id1/ x", "id2/ x", DataTypesClientListByDataProductOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_data_types_client_list_by_data_product_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_20)
}

fn show_operations_client_list_response(r: OperationsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_list_result).to_str_lossy()}")
  parts.join(" ")
}

