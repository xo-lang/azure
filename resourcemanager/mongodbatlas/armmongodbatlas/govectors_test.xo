// Generated from the output of a local Go program that calls every
// public method of each client of armmongodbatlas v1.0.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_operations_client_list_response(r: OperationsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_list_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL OperationsClient.NewListPager",
  "REQ GET https://management.example.test/providers/MongoDB.Atlas/operations?api-version=2025-06-01",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "OUT page 1: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "REQ GET https://management.example.test/next?%24skiptoken=2",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
]

test "Go's OperationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_operations_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}")
  gv_note(f, "CALL OperationsClient.NewListPager")
  var pg = c.new_list_pager(OperationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_operations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_0)
}

