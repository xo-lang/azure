test "Go's OperationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_operations_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"count\":7,\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\",\"properties\":{\"serviceSpecification\":{\"logSpecifications\":[{\"blobDuration\":\"s-blobduration\",\"displayName\":\"s-displayname\",\"name\":\"s-name\"}],\"metricSpecifications\":[{\"aggregationType\":\"s-aggregationtype\",\"displayDescription\":\"s-displaydescription\",\"displayName\":\"s-displayname\",\"enableRegionalMdmAccount\":\"s-enableregionalmdmaccount\",\"internalMetricName\":\"s-internalmetricname\",\"name\":\"s-name\",\"resourceIdDimensionNameOverride\":\"s-resourceiddimensionnameoverride\",\"sourceMdmNamespace\":\"s-sourcemdmnamespace\",\"unit\":\"s-unit\"}]}}}]}")
  gv_note(f, "CALL OperationsClient.NewListPager")
  var pg = c.new_list_pager(OperationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_operations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_20)
}

