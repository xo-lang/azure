test "Go's BudgetsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_budgets_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"eTag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"amount\":1.5,\"category\":\"s-category\",\"currentSpend\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"filter\":{\"and\":[{}],\"dimensions\":{\"name\":\"s-name\",\"operator\":\"s-operator\",\"values\":[\"s-values\"]},\"tags\":{\"name\":\"s-name\",\"operator\":\"s-operator\",\"values\":[\"s-values\"]}},\"forecastSpend\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"notifications\":{\"k1\":{\"contactEmails\":[\"s-contactemails\"],\"contactGroups\":[\"s-contactgroups\"],\"contactRoles\":[\"s-contactroles\"],\"enabled\":true,\"frequency\":\"s-frequency\",\"locale\":\"s-locale\",\"operator\":\"s-operator\",\"threshold\":1.5,\"thresholdType\":\"s-thresholdtype\"}},\"timeGrain\":\"s-timegrain\",\"timePeriod\":{\"endDate\":\"2026-11-06T10:00:00Z\",\"startDate\":\"2026-11-06T10:00:00Z\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BudgetsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", BudgetsClientListOptions{filter: Some("s-filter")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_budgets_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_12)
}

