test "Go's ViewsClient.NewListByScopePager" {
  let f = gv_new_fake(os.net)
  let c = new_views_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"eTag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"accumulated\":\"s-accumulated\",\"chart\":\"s-chart\",\"createdOn\":\"2026-11-06T10:00:00Z\",\"currency\":\"s-currency\",\"dateRange\":\"s-daterange\",\"displayName\":\"s-displayname\",\"kpis\":[{\"enabled\":true,\"id\":\"s-id\",\"type\":\"s-type\"}],\"metric\":\"s-metric\",\"modifiedOn\":\"2026-11-06T10:00:00Z\",\"pivots\":[{\"name\":\"s-name\",\"type\":\"s-type\"}],\"query\":{\"dataSet\":{\"configuration\":{},\"filter\":{},\"granularity\":\"s-granularity\"},\"includeMonetaryCommitment\":true,\"timePeriod\":{\"from\":\"2026-11-06T10:00:00Z\",\"to\":\"2026-11-06T10:00:00Z\"},\"timeframe\":\"s-timeframe\",\"type\":\"s-type\"},\"scope\":\"s-scope\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ViewsClient.NewListByScopePager")
  var pg = c.new_list_by_scope_pager("id1/ x", ViewsClientListByScopeOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_views_client_list_by_scope_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_69)
}

fn show_views_client_list_response(r: ViewsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.view_list_result).to_str_lossy()}")
  parts.join(" ")
}

