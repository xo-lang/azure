test "Go's AlertsClient.Dismiss" {
  let f = gv_new_fake(os.net)
  let c = new_alerts_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"eTag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"closeTime\":\"s-closetime\",\"costEntityId\":\"s-costentityid\",\"creationTime\":\"s-creationtime\",\"definition\":{\"category\":\"s-category\",\"criteria\":\"s-criteria\",\"type\":\"s-type\"},\"description\":\"s-description\",\"details\":{\"amount\":1.5,\"companyName\":\"s-companyname\",\"contactEmails\":[\"s-contactemails\"],\"contactGroups\":[\"s-contactgroups\"],\"contactRoles\":[\"s-contactroles\"],\"currentSpend\":1.5,\"departmentName\":\"s-departmentname\",\"enrollmentEndDate\":\"s-enrollmentenddate\",\"enrollmentNumber\":\"s-enrollmentnumber\",\"enrollmentStartDate\":\"s-enrollmentstartdate\",\"invoicingThreshold\":1.5,\"meterFilter\":[{\"k\":\"v\"}],\"operator\":\"s-operator\",\"overridingAlert\":\"s-overridingalert\",\"periodStartDate\":\"s-periodstartdate\",\"resourceFilter\":[{\"k\":\"v\"}],\"resourceGroupFilter\":[{\"k\":\"v\"}],\"tagFilter\":{\"k\":\"v\"},\"threshold\":1.5,\"timeGrainType\":\"s-timegraintype\",\"triggeredBy\":\"s-triggeredby\",\"unit\":\"s-unit\"},\"modificationTime\":\"s-modificationtime\",\"source\":\"s-source\",\"status\":\"s-status\",\"statusModificationTime\":\"s-statusmodificationtime\",\"statusModificationUserName\":\"s-statusmodificationusername\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL AlertsClient.Dismiss")
  match c.dismiss("id1/ x", "id2/ x", (json.decode_str[DismissAlertPayload]("{\"properties\":{\"closeTime\":\"s-closetime\",\"costEntityId\":\"s-costentityid\",\"creationTime\":\"s-creationtime\",\"definition\":{\"category\":\"s-category\",\"criteria\":\"s-criteria\",\"type\":\"s-type\"},\"description\":\"s-description\",\"details\":{\"amount\":1.5,\"companyName\":\"s-companyname\",\"contactEmails\":[\"s-contactemails\"],\"contactGroups\":[\"s-contactgroups\"],\"contactRoles\":[\"s-contactroles\"],\"currentSpend\":1.5,\"departmentName\":\"s-departmentname\",\"enrollmentEndDate\":\"s-enrollmentenddate\",\"enrollmentNumber\":\"s-enrollmentnumber\",\"enrollmentStartDate\":\"s-enrollmentstartdate\",\"invoicingThreshold\":1.5,\"meterFilter\":[{\"k\":\"v\"}],\"operator\":\"s-operator\",\"overridingAlert\":\"s-overridingalert\",\"periodStartDate\":\"s-periodstartdate\",\"resourceFilter\":[{\"k\":\"v\"}],\"resourceGroupFilter\":[{\"k\":\"v\"}],\"tagFilter\":{\"k\":\"v\"},\"threshold\":1.5,\"timeGrainType\":\"s-timegraintype\",\"triggeredBy\":\"s-triggeredby\",\"unit\":\"s-unit\"},\"modificationTime\":\"s-modificationtime\",\"source\":\"s-source\",\"status\":\"s-status\",\"statusModificationTime\":\"s-statusmodificationtime\",\"statusModificationUserName\":\"s-statusmodificationusername\"}}") ?? e => fault("${e}")), AlertsClientDismissOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_alerts_client_dismiss_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

