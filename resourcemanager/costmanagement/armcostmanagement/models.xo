/// The definition of an export.
pub struct ExportDefinition {
  /// The definition for data in the export.
  pub data_set as "dataSet,omitempty": ExportDataset? = None
  /// Has time period for pulling data for the export.
  pub time_period as "timePeriod,omitempty": ExportTimePeriod? = None
  /// The time frame for pulling data for the export. If custom, then a specific time period must be provided.
  pub timeframe as "timeframe,omitempty": TimeframeType? = None
  /// The type of the export. Note that 'Usage' is equivalent to 'ActualCost' and is applicable to exports that do not yet provide data for charges or amortization for service reservations.
  pub type_ as "type,omitempty": ExportType? = None
} derive Json

/// The properties of the export run. This is not populated currently.
pub struct ExportSuspensionContext {
  /// The code for export suspension.
  pub suspension_code as "suspensionCode,omitempty": Str? = None
  /// The detailed reason for export suspension.
  pub suspension_reason as "suspensionReason,omitempty": Str? = None
  /// The time when the export was suspended.
  pub suspension_time as "suspensionTime,omitempty": azcore.DateTime? = None
} derive Json

/// The common properties of the export.
pub struct CommonExportProperties {
  /// Allow customers to select compress data for exports. This setting will enable destination file compression scheme at runtime. By default set to None. Gzip is for csv and snappy for parquet.
  pub compression_mode as "compressionMode,omitempty": CompressionModeType? = None
  /// Allow customers to select overwrite data(OverwritePreviousReport) for exports. This setting will enable overwrite data for the same month in customer storage account. By default set to CreateNewReport.
  pub data_overwrite_behavior as "dataOverwriteBehavior,omitempty": DataOverwriteBehaviorType? = None
  /// Has the definition for the export.
  pub definition as "definition,omitempty": ExportDefinition? = None
  /// Has delivery information for the export.
  pub delivery_info as "deliveryInfo,omitempty": ExportDeliveryInfo? = None
  /// The export description set by customer at time of export creation/update.
  pub export_description as "exportDescription,omitempty": Str? = None
  /// The format of the export being delivered.
  pub format as "format,omitempty": FormatType? = None
  /// If the export has an active schedule, provides an estimate of the next run time.
  pub next_run_time_estimate as "nextRunTimeEstimate,omitempty": azcore.DateTime? = None
  /// If set to true, exported data will be partitioned by size and placed in a blob directory together with a manifest file.
  pub partition_data as "partitionData,omitempty": Bool? = None
  /// If requested, has the most recent run history for the export.
  pub run_history as "runHistory,omitempty": ExportExecutionListResult? = None
  /// The export suspension reason if export is in SystemSuspended state. This is not populated currently.
  pub system_suspension_context as "systemSuspensionContext,omitempty": ExportSuspensionContext? = None
} derive Json

/// The properties of the export run.
pub struct ExportRunProperties {
  /// The end datetime for the export.
  pub end_date as "endDate,omitempty": azcore.DateTime? = None
  /// The details of any error.
  pub error as "error,omitempty": ErrorDetails? = None
  /// The type of the export run.
  pub execution_type as "executionType,omitempty": ExecutionType? = None
  /// The name of the exported file.
  pub file_name as "fileName,omitempty": Str? = None
  /// The manifest file location(URI location) for the exported files.
  pub manifest_file as "manifestFile,omitempty": Str? = None
  /// The time when the export run finished.
  pub processing_end_time as "processingEndTime,omitempty": azcore.DateTime? = None
  /// The time when export was picked up to be run.
  pub processing_start_time as "processingStartTime,omitempty": azcore.DateTime? = None
  /// The export settings that were in effect for this run.
  pub run_settings as "runSettings,omitempty": CommonExportProperties? = None
  /// The start datetime for the export.
  pub start_date as "startDate,omitempty": azcore.DateTime? = None
  /// The last known status of the export run.
  pub status as "status,omitempty": ExecutionStatus? = None
  /// The identifier for the entity that triggered the export. For on-demand runs it is the user email. For scheduled runs it is 'System'.
  pub submitted_by as "submittedBy,omitempty": Str? = None
  /// The time when export was queued to be run.
  pub submitted_time as "submittedTime,omitempty": azcore.DateTime? = None
} derive Json

