pub struct MCAPriceSheetProperties {
  /// The unit price at the time the customer signs on or the unit price at the time of service meter GA launch if it is after sign-on.  This is applicable for Enterprise Agreement users
  pub base_price as "basePrice,omitempty": Str? = None
  /// Unique identifier for the billing account.
  pub billing_account_id as "billingAccountID,omitempty": Str? = None
  /// Name of the billing profile that is set up to receive invoices. The prices in the price sheet are associated with this billing profile.
  pub billing_account_name as "billingAccountName,omitempty": Str? = None
  /// Currency in which charges are posted.
  pub billing_currency as "billingCurrency,omitempty": Str? = None
  /// Unique identifier for the billing profile.
  pub billing_profile_id as "billingProfileId,omitempty": Str? = None
  /// Name of the billing profile that is set up to receive invoices. The prices in the price sheet are associated with this billing profile.
  pub billing_profile_name as "billingProfileName,omitempty": Str? = None
  /// Currency in which all the prices are reflected.
  pub currency as "currency,omitempty": Str? = None
  /// Effective end date of the Price Sheet billing period
  pub effective_end_date as "effectiveEndDate,omitempty": azcore.DateTime? = None
  /// Effective start date of the Price Sheet billing period
  pub effective_start_date as "effectiveStartDate,omitempty": azcore.DateTime? = None
  /// The current list price for a given product or service. This price is without any negotiations and is based on your Microsoft Agreement type.  For PriceType Consumption, market price is reflected as the pay-as-you-go price.  For PriceType Savings Plan, market price reflects the Savings plan benefit on top of pay-as-you-go price for the corresponding commitment term.  For PriceType ReservedInstance, market price reflects the total price of the 1 or 3-year commitment.
  pub market_price as "marketPrice,omitempty": Str? = None
  /// Name of the classification category for the meter. For example, Cloud services, Networking, etc.
  pub meter_category as "meterCategory,omitempty": Str? = None
  /// Unique identifier of the meter
  pub meter_id as "meterId,omitempty": Str? = None
  /// Name of the meter. The meter represents the deployable resource of an Azure service.
  pub meter_name as "meterName,omitempty": Str? = None
  /// Name of the Azure region where the meter for the service is available.
  pub meter_region as "meterRegion,omitempty": Str? = None
  /// Name of the meter subclassification category.
  pub meter_sub_category as "meterSubCategory,omitempty": Str? = None
  /// Name of the meter type
  pub meter_type as "meterType,omitempty": Str? = None
  /// Price type for a product. For example, an Azure resource with a pay-as-you-go rate with priceType as Consumption. Other price types include ReservedInstance and Savings Plan.
  pub price_type as "priceType,omitempty": Str? = None
  /// Name of the product accruing the charges.
  pub product as "product,omitempty": Str? = None
  /// Unique identifier for the product whose meter is consumed.
  pub product_id as "productId,omitempty": Str? = None
  /// Name of the purchased product plan. Indicates if this pricing is standard Azure Plan pricing, Dev/Test pricing etc.  Currently unavailable for Azure 3rd party and ReservedInstance meters.
  pub product_order_name as "productOrderName,omitempty": Str? = None
  /// Type of Azure service. For example, Compute, Analytics, and Security.
  pub service_family as "serviceFamily,omitempty": Float32? = None
  /// Unique identifier of the SKU
  pub sku_id as "skuId,omitempty": Str? = None
  /// Term length for Azure Savings Plan or Reservation term – one year or three years (P1Y or P3Y)
  pub term as "term,omitempty": Str? = None
  /// Defines the lower bound of the tier range for which prices are defined. For example, if the range is 0 to 100, tierMinimumUnits would be 0.
  pub tier_minimum_units as "tierMinimumUnits,omitempty": Str? = None
  /// How usage is measured for the service
  pub unit_of_measure as "unitOfMeasure,omitempty": Str? = None
  /// The per-unit price at the time of billing for a given product or service, inclusive of any negotiated discounts on top of the market price.  For PriceType ReservedInstance, unit price reflects the total cost of the 1 or 3-year commitment including discounts.  Note: The unit price isn't the same as the effective price in usage details downloads when services have differential prices across tiers.  If services have multi-tiered pricing, the effective price is a blended rate across the tiers and doesn't show a tier-specific unit price. The blended price or effective price is the net price for the consumed quantity spanning across the multiple tiers (where each tier has a specific unit price).
  pub unit_price as "unitPrice,omitempty": Str? = None
} derive Json

/// The URL to download the generated report.
pub struct PricesheetDownloadProperties {
  /// The properties in downloaded file
  pub download_file_properties as "downloadFileProperties,omitempty": MCAPriceSheetProperties? = None
  /// The URL to download the generated report.
  pub download_url as "downloadUrl,omitempty": Str? = None
  /// The time at which report URL becomes invalid/expires in UTC e.g. 2020-12-08T05:55:59.4394737Z.
  pub expiry_time as "expiryTime,omitempty": azcore.DateTime? = None
} derive Json

/// Source resources for cost allocation
pub struct SourceCostAllocationResource {
  /// If resource type is dimension, this must be either ResourceGroupName or SubscriptionId. If resource type is tag, this must be a valid Azure tag
  pub name as "name,omitempty": Str? = None
  /// Type of resources contained in this cost allocation rule
  pub resource_type as "resourceType,omitempty": CostAllocationResourceType? = None
  /// Source Resources for cost allocation. This list cannot contain more than 25 values.
  pub values as "values,omitempty": List[Str]? = None
} derive Json

/// Target resources and allocation
pub struct CostAllocationProportion {
  /// Target resource for cost allocation
  pub name as "name,omitempty": Str? = None
  /// Percentage of source cost to allocate to this resource. This value can be specified to two decimal places and the total percentage of all resources in this rule must sum to 100.00.
  pub percentage as "percentage,omitempty": Float32? = None
} derive Json

/// Target resources for cost allocation.
pub struct TargetCostAllocationResource {
  /// If resource type is dimension, this must be either ResourceGroupName or SubscriptionId. If resource type is tag, this must be a valid Azure tag
  pub name as "name,omitempty": Str? = None
  /// Method of cost allocation for the rule
  pub policy_type as "policyType,omitempty": CostAllocationPolicyType? = None
  /// Type of resources contained in this cost allocation rule
  pub resource_type as "resourceType,omitempty": CostAllocationResourceType? = None
  /// Target resources for cost allocation. This list cannot contain more than 25 values.
  pub values as "values,omitempty": List[CostAllocationProportion]? = None
} derive Json

/// Resource details of the cost allocation rule
pub struct CostAllocationRuleDetails {
  /// Source resources for cost allocation. At this time, this list can contain no more than one element.
  pub source_resources as "sourceResources,omitempty": List[SourceCostAllocationResource]? = None
  /// Target resources for cost allocation. At this time, this list can contain no more than one element.
  pub target_resources as "targetResources,omitempty": List[TargetCostAllocationResource]? = None
} derive Json

/// The properties of a cost allocation rule
pub struct CostAllocationRuleProperties {
  /// Time at which the rule was created. Rules that change cost for the same resource are applied in order of creation.
  pub created_date as "createdDate,omitempty": azcore.DateTime? = None
  /// Description of a cost allocation rule.
  pub description as "description,omitempty": Str? = None
  /// Resource information for the cost allocation rule
  pub details as "details,omitempty": CostAllocationRuleDetails? = None
  /// Status of the rule
  pub status as "status,omitempty": RuleStatus? = None
  /// Time at which the rule was last updated.
  pub updated_date as "updatedDate,omitempty": azcore.DateTime? = None
} derive Json

/// The cost allocation rule model definition
pub struct CostAllocationRuleDefinition {
  /// Fully qualified resource ID for the resource. E.g. "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/{resourceProviderNamespace}/{resourceType}/{resourceName}"
  pub id as "id,omitempty": Str? = None
  /// The name of the resource
  pub name as "name,omitempty": Str? = None
  /// Cost allocation rule properties
  pub properties as "properties,omitempty": CostAllocationRuleProperties? = None
  /// Azure Resource Manager metadata containing createdBy and modifiedBy information.
  pub system_data as "systemData,omitempty": SystemData? = None
  /// The type of the resource. E.g. "Microsoft.Compute/virtualMachines" or "Microsoft.Storage/storageAccounts"
  pub type_ as "type,omitempty": Str? = None
} derive Json

/// Result of listing cost allocation rules. It contains a list of available rules in the billing account or enterprise enrollment provided.
pub struct CostAllocationRuleList {
  /// URL to get the next set of rule list results if there are any.
  pub next_link as "nextLink,omitempty": Str? = None
  /// The list of cost allocation rules.
  pub value as "value,omitempty": List[CostAllocationRuleDefinition]? = None
} derive Json

/// The cost allocation rule check name availability request
pub struct CostAllocationRuleCheckNameAvailabilityRequest {
  /// Rule name
  pub name as "name,omitempty": Str? = None
  /// Resource type. This is expected to be Microsoft.CostManagement/costAllocationRules
  pub type_ as "type,omitempty": Str? = None
} derive Json

/// The cost allocation rule check name availability response
pub struct CostAllocationRuleCheckNameAvailabilityResponse {
  /// Error message if the name is not available
  pub message as "message,omitempty": Str? = None
  /// Whether this rule name is available
  pub name_available as "nameAvailable,omitempty": Bool? = None
  /// The reason this name is not available
  pub reason as "reason,omitempty": Reason? = None
} derive Json

/// AlertPropertiesPatch: AlertProperties in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct AlertPropertiesPatch {
