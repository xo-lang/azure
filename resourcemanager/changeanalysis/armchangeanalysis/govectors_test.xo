test "Go's ChangesClient.NewListChangesByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_changes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"changeType\":\"s-changetype\",\"initiatedByList\":[\"s-initiatedbylist\"],\"propertyChanges\":[{\"changeCategory\":\"s-changecategory\",\"changeType\":\"s-changetype\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isDataMasked\":true,\"jsonPath\":\"s-jsonpath\",\"level\":\"s-level\",\"newValue\":\"s-newvalue\",\"oldValue\":\"s-oldvalue\"}],\"resourceId\":\"s-resourceid\",\"timeStamp\":\"2026-11-06T10:00:00Z\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ChangesClient.NewListChangesByResourceGroupPager")
  var pg = c.new_list_changes_by_resource_group_pager("id1/ x", (azcore.parse_date_time("2026-11-06T10:00:00Z") ?? e => fault(e)), (azcore.parse_date_time("2026-11-06T10:00:00Z") ?? e => fault(e)), ChangesClientListChangesByResourceGroupOptions{skip_token: Some("s-skiptoken")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_changes_client_list_changes_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_0)
}

