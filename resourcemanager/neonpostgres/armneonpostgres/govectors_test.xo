test "Go's ProjectsClient.GetConnectionURI" {
  let f = gv_new_fake(os.net)
  let c = new_projects_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"branchId\":\"s-branchid\",\"connectionStringUri\":\"s-connectionstringuri\",\"databaseName\":\"s-databasename\",\"endpointId\":\"s-endpointid\",\"isPooled\":true,\"projectId\":\"s-projectid\",\"roleName\":\"s-rolename\"}")
  gv_note(f, "CALL ProjectsClient.GetConnectionURI")
  match c.get_connection_uri("id1/ x", "id2/ x", "id3/ x", (json.decode_str[ConnectionURIProperties]("{\"branchId\":\"s-branchid\",\"connectionStringUri\":\"s-connectionstringuri\",\"databaseName\":\"s-databasename\",\"endpointId\":\"s-endpointid\",\"isPooled\":true,\"projectId\":\"s-projectid\",\"roleName\":\"s-rolename\"}") ?? e => fault("${e}")), ProjectsClientGetConnectionURIOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_projects_client_get_connection_uri_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_19)
}

