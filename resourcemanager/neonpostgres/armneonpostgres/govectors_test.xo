fn show_organizations_client_get_postgres_versions_response(r: OrganizationsClientGetPostgresVersionsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.pg_versions_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_13: List[Str] = [
  "CALL OrganizationsClient.GetPostgresVersions",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Neon.Postgres/getPostgresVersions?api-version=2025-03-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"version\":7}",
  "  SERVED 200 {\"versions\":[{\"version\":7}]}",
  "OUT: body={\"versions\":[{\"version\":7}]}",
]

test "Go's OrganizationsClient.GetPostgresVersions" {
  let f = gv_new_fake(os.net)
  let c = new_organizations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"versions\":[{\"version\":7}]}")
  gv_note(f, "CALL OrganizationsClient.GetPostgresVersions")
  match c.get_postgres_versions("id1/ x", OrganizationsClientGetPostgresVersionsOptions{parameters: Some((json.decode_str[PgVersion]("{\"version\":7}") ?? e => fault("${e}")))}) {
    Ok(r) => gv_note(f, "OUT: ${show_organizations_client_get_postgres_versions_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_13)
}

