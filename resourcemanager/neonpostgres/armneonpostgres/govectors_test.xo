test "Go's ProjectsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_projects_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"attributes\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"branch\":{\"attributes\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"createdAt\":\"s-createdat\",\"databaseName\":\"s-databasename\",\"databases\":[{\"branchId\":\"s-branchid\",\"createdAt\":\"s-createdat\",\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"ownerName\":\"s-ownername\",\"provisioningState\":\"Succeeded\"}],\"endpoints\":[{\"branchId\":\"s-branchid\",\"createdAt\":\"s-createdat\",\"endpointType\":\"s-endpointtype\",\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"projectId\":\"s-projectid\",\"provisioningState\":\"Succeeded\"}],\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"parentId\":\"s-parentid\",\"projectId\":\"s-projectid\",\"provisioningState\":\"Succeeded\",\"roleName\":\"s-rolename\",\"roles\":[{\"branchId\":\"s-branchid\",\"createdAt\":\"s-createdat\",\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"isSuperUser\":true,\"provisioningState\":\"Succeeded\"}]},\"createdAt\":\"s-createdat\",\"databases\":[{\"branchId\":\"s-branchid\",\"createdAt\":\"s-createdat\",\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"ownerName\":\"s-ownername\",\"provisioningState\":\"Succeeded\"}],\"defaultEndpointSettings\":{\"autoscalingLimitMaxCu\":1.5,\"autoscalingLimitMinCu\":1.5},\"endpoints\":[{\"branchId\":\"s-branchid\",\"createdAt\":\"s-createdat\",\"endpointType\":\"s-endpointtype\",\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"projectId\":\"s-projectid\",\"provisioningState\":\"Succeeded\"}],\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"historyRetention\":7,\"pgVersion\":7,\"provisioningState\":\"Succeeded\",\"regionId\":\"s-regionid\",\"roles\":[{\"branchId\":\"s-branchid\",\"createdAt\":\"s-createdat\",\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"isSuperUser\":true,\"permissions\":[\"s-permissions\"],\"provisioningState\":\"Succeeded\"}],\"storage\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ProjectsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ProjectsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_projects_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_20)
}
