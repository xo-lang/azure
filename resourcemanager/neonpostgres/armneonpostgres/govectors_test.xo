  let f = gv_new_fake(os.net)
  let c = new_branches_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"attributes\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"createdAt\":\"s-createdat\",\"databaseName\":\"s-databasename\",\"databases\":[{\"attributes\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"branchId\":\"s-branchid\",\"createdAt\":\"s-createdat\",\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"ownerName\":\"s-ownername\",\"provisioningState\":\"Succeeded\"}],\"endpoints\":[{\"attributes\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"branchId\":\"s-branchid\",\"createdAt\":\"s-createdat\",\"endpointType\":\"s-endpointtype\",\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"projectId\":\"s-projectid\",\"provisioningState\":\"Succeeded\"}],\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"parentId\":\"s-parentid\",\"projectId\":\"s-projectid\",\"provisioningState\":\"Succeeded\",\"roleName\":\"s-rolename\",\"roles\":[{\"attributes\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"branchId\":\"s-branchid\",\"createdAt\":\"s-createdat\",\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"isSuperUser\":true,\"permissions\":[\"s-permissions\"],\"provisioningState\":\"Succeeded\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL BranchesClient.BeginCreateOrUpdate")
  match c.begin_create_or_update("id1/ x", "id2/ x", "id3/ x", "id4/ x", (json.decode_str[Branch]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"attributes\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"createdAt\":\"s-createdat\",\"databaseName\":\"s-databasename\",\"databases\":[{\"attributes\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"branchId\":\"s-branchid\",\"createdAt\":\"s-createdat\",\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"ownerName\":\"s-ownername\",\"provisioningState\":\"Succeeded\"}],\"endpoints\":[{\"attributes\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"branchId\":\"s-branchid\",\"createdAt\":\"s-createdat\",\"endpointType\":\"s-endpointtype\",\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"projectId\":\"s-projectid\",\"provisioningState\":\"Succeeded\"}],\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"parentId\":\"s-parentid\",\"projectId\":\"s-projectid\",\"provisioningState\":\"Succeeded\",\"roleName\":\"s-rolename\",\"roles\":[{\"attributes\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"branchId\":\"s-branchid\",\"createdAt\":\"s-createdat\",\"entityId\":\"s-entityid\",\"entityName\":\"s-entityname\",\"isSuperUser\":true,\"permissions\":[\"s-permissions\"],\"provisioningState\":\"Succeeded\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), BranchesClientBeginCreateOrUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_branches_client_create_or_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

