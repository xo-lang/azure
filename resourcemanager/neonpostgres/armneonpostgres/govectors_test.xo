test "Go's ProjectsClient.Delete" {
  let f = gv_new_fake(os.net)
  let c = new_projects_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL ProjectsClient.Delete")
  match c.delete("id1/ x", "id2/ x", "id3/ x", ProjectsClientDeleteOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_projects_client_delete_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_17)
}

fn show_projects_client_get_response(r: ProjectsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.project).to_str_lossy()}")
  parts.join(" ")
}

