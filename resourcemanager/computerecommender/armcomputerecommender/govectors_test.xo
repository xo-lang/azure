test "Go's SpotPlacementScoresClient.Post" {
  let f = gv_new_fake(os.net)
  let c = new_spot_placement_scores_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"availabilityZones\":true,\"desiredCount\":7,\"desiredLocations\":[\"s-desiredlocations\"],\"desiredSizes\":[{\"sku\":\"s-sku\"}],\"placementScores\":[{\"availabilityZone\":\"s-availabilityzone\",\"isQuotaAvailable\":true,\"region\":\"s-region\",\"score\":\"s-score\",\"sku\":\"s-sku\"}]}")
  gv_note(f, "CALL SpotPlacementScoresClient.Post")
  match c.post("id1/ x", (json.decode_str[SpotPlacementScoresInput]("{\"availabilityZones\":true,\"desiredCount\":7,\"desiredLocations\":[\"s-desiredlocations\"],\"desiredSizes\":[{\"sku\":\"s-sku\"}]}") ?? e => fault("${e}")), SpotPlacementScoresClientPostOptions{}) {
