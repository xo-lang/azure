fn (c: ServicesClient) regenerate_key_create_request(resource_group_name: Str, communication_service_name: Str, parameters: RegenerateKeyParameters, options: ServicesClientRegenerateKeyOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.Communication/communicationServices/{communicationServiceName}/regenerateKey"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if communication_service_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter communicationServiceName cannot be empty"))
  }
  path = path.replace("{communicationServiceName}", url.path_escape(communication_service_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: runtime.marshal_json(parameters)})
}

/// Regenerate CommunicationService access key. PrimaryKey and SecondaryKey cannot be regenerated at the same time.
pub fn (c: ServicesClient) regenerate_key(resource_group_name: Str, communication_service_name: Str, parameters: RegenerateKeyParameters, options: ServicesClientRegenerateKeyOptions = ServicesClientRegenerateKeyOptions{}) -> ServicesClientRegenerateKeyResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let sp = runtime.start_span({}, "ServicesClient.RegenerateKey", c.setup.pipeline.tracer)
  let req = sp.on(c.regenerate_key_create_request(resource_group_name, communication_service_name, parameters, options) ?? e => return Err(sp.fail(e)))
  let resp = c.setup.pipeline.send(req) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![200].contains(resp.status) {
    return Err(sp.fail(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  let out = services_regenerate_key_handle(resp) ?? e => return Err(sp.fail(azcore.CallErr.Decode(e)))
  sp.end()
  Ok(out)
}
