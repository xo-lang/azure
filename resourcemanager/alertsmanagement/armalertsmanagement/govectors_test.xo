  gv_note(f, "CALL AlertsClient.NewGetAllPager")
  var pg = c.new_get_all_pager(AlertsClientGetAllOptions{alert_rule: Some("s-alertrule"), alert_state: Some(AlertState("s-alertstate")), custom_time_range: Some("s-customtimerange"), include_context: Some(true), include_egress_config: Some(true), monitor_condition: Some(MonitorCondition("s-monitorcondition")), monitor_service: Some(MonitorService("s-monitorservice")), page_count: Some(7), select_: Some("s-select"), severity: Some(Severity("s-severity")), smart_group_id: Some("s-smartgroupid"), sort_by: Some(AlertsSortByFields("s-sortby")), sort_order: Some(SortOrder("s-sortorder")), target_resource: Some("s-targetresource"), target_resource_group: Some("s-targetresourcegroup"), target_resource_type: Some("s-targetresourcetype"), time_range: Some(TimeRange("s-timerange"))}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
