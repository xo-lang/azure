fn show_web_apps_client_get_container_logs_zip_response(r: WebAppsClientGetContainerLogsZipResponse) -> Str {
  var parts: List[Str] = []
  parts.push("Body=${gv_go_q(r.body)}")
  if let Some(v) = r.content_type {
    parts.push("ContentType=${v}")
  }
  parts.join(" ")
}

