  gv_note(f, "CALL WebAppsClient.NewListConfigurationsPager")
  var pg = c.new_list_configurations_pager("id1/ x", "id2/ x", WebAppsClientListConfigurationsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_web_apps_client_list_configurations_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_518)
}

fn show_web_apps_client_list_configurations_slot_response(r: WebAppsClientListConfigurationsSlotResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.site_config_resource_collection).to_str_lossy()}")
  parts.join(" ")
}

