test "Go's StaticSitesClient.NewGetStaticSiteBuildsPager" {
  let f = gv_new_fake(os.net)
  let c = new_static_sites_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"properties\":{\"buildId\":\"s-buildid\",\"createdTimeUtc\":\"2026-11-06T10:00:00Z\",\"databaseConnections\":[{\"connectionIdentity\":\"s-connectionidentity\",\"name\":\"s-name\",\"region\":\"s-region\",\"resourceId\":\"s-resourceid\"}],\"hostname\":\"s-hostname\",\"lastUpdatedOn\":\"2026-11-06T10:00:00Z\",\"linkedBackends\":[{\"backendResourceId\":\"s-backendresourceid\",\"createdOn\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"region\":\"s-region\"}],\"pullRequestTitle\":\"s-pullrequesttitle\",\"sourceBranch\":\"s-sourcebranch\",\"status\":\"s-status\",\"userProvidedFunctionApps\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"properties\":{\"createdOn\":\"2026-11-06T10:00:00Z\",\"functionAppRegion\":\"s-functionappregion\",\"functionAppResourceId\":\"s-functionappresourceid\"},\"type\":\"s-type\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL StaticSitesClient.NewGetStaticSiteBuildsPager")
  var pg = c.new_get_static_site_builds_pager("id1/ x", "id2/ x", StaticSitesClientGetStaticSiteBuildsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_static_sites_client_get_static_site_builds_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_214)
}

fn show_static_sites_client_get_static_sites_by_resource_group_response(r: StaticSitesClientGetStaticSitesByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.static_site_collection).to_str_lossy()}")
  parts.join(" ")
}

