  let f = gv_new_fake(os.net)
  let c = new_certificates_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"canonicalName\":\"s-canonicalname\",\"cerBlob\":\"YWI=\",\"domainValidationMethod\":\"s-domainvalidationmethod\",\"expirationDate\":\"2026-11-06T10:00:00Z\",\"friendlyName\":\"s-friendlyname\",\"hostNames\":[\"s-hostnames\"],\"hostingEnvironmentProfile\":{\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"},\"issueDate\":\"2026-11-06T10:00:00Z\",\"issuer\":\"s-issuer\",\"keyVaultId\":\"s-keyvaultid\",\"keyVaultSecretName\":\"s-keyvaultsecretname\",\"keyVaultSecretStatus\":\"s-keyvaultsecretstatus\",\"password\":\"s-password\",\"pfxBlob\":\"YWI=\",\"publicKeyHash\":\"s-publickeyhash\",\"selfLink\":\"https://management.example.test/next?\$skiptoken=2\",\"serverFarmId\":\"s-serverfarmid\",\"siteName\":\"s-sitename\",\"subjectName\":\"s-subjectname\",\"thumbprint\":\"s-thumbprint\",\"valid\":true},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL CertificatesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", CertificatesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_certificates_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_3)
}

