  gv_note(f, "CALL WebAppsClient.GetAuthSettingsV2Slot")
  match c.get_auth_settings_v2_slot("id1/ x", "id2/ x", "id3/ x", WebAppsClientGetAuthSettingsV2SlotOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_web_apps_client_get_auth_settings_v2_slot_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_359)
}

fn show_web_apps_client_get_auth_settings_v2_without_secrets_response(r: WebAppsClientGetAuthSettingsV2WithoutSecretsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.site_auth_settings_v2).to_str_lossy()}")
  parts.join(" ")
}

