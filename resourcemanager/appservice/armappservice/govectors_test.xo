test "Go's WorkflowVersionsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_workflow_versions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessControl\":{\"actions\":{\"openAuthenticationPolicies\":{}},\"contents\":{\"openAuthenticationPolicies\":{}},\"triggers\":{\"openAuthenticationPolicies\":{}},\"workflowManagement\":{\"openAuthenticationPolicies\":{}}},\"accessEndpoint\":\"s-accessendpoint\",\"changedTime\":\"2026-11-06T10:00:00Z\",\"createdTime\":\"2026-11-06T10:00:00Z\",\"definition\":{\"k\":\"v\"},\"endpointsConfiguration\":{\"connector\":{},\"workflow\":{}},\"integrationAccount\":{\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"},\"parameters\":{\"k1\":{\"description\":\"s-description\",\"metadata\":{\"k\":\"v\"},\"type\":\"s-type\",\"value\":{\"k\":\"v\"}}},\"provisioningState\":\"Succeeded\",\"sku\":{\"name\":\"s-name\",\"plan\":{\"id\":\"s-id\",\"name\":\"s-name\",\"type\":\"s-type\"}},\"state\":\"s-state\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkflowVersionsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", WorkflowVersionsClientListOptions{top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workflow_versions_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_689)
}

