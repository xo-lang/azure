  let c = new_workflow_run_action_repetitions_request_histories_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"endTime\":\"2026-11-06T10:00:00Z\",\"request\":{\"headers\":{\"k\":\"v\"},\"method\":\"s-method\",\"uri\":\"s-uri\"},\"response\":{\"bodyLink\":{\"contentHash\":{\"algorithm\":\"s-algorithm\",\"value\":\"s-value\"},\"contentSize\":7,\"contentVersion\":\"s-contentversion\",\"metadata\":{\"k\":\"v\"},\"uri\":\"s-uri\"},\"headers\":{\"k\":\"v\"},\"statusCode\":7},\"startTime\":\"2026-11-06T10:00:00Z\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkflowRunActionRepetitionsRequestHistoriesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", "id5/ x", "id6/ x", WorkflowRunActionRepetitionsRequestHistoriesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workflow_run_action_repetitions_request_histories_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_671)
}

