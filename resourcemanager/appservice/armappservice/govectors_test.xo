tname\",\"timestampUtc\":\"2026-11-06T10:00:00Z\"},\"sshEnabled\":true,\"state\":\"s-state\",\"storageAccountRequired\":true,\"suspendedTill\":\"2026-11-06T10:00:00Z\",\"targetSwapSlot\":\"s-targetswapslot\",\"trafficManagerHostNames\":[\"s-trafficmanagerhostnames\"],\"usageState\":\"s-usagestate\",\"virtualNetworkSubnetId\":\"s-virtualnetworksubnetid\",\"workloadProfileName\":\"s-workloadprofilename\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EnvironmentsClient.BeginSuspend")
  match c.begin_suspend("id1/ x", "id2/ x", EnvironmentsClientBeginSuspendOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(pg0) => {
          var pg = pg0
          for page in [1, 2] {
            if !pg.more() {
              gv_note(f, "OUT page ${page}: no more")
              break
            }
            match pg.next_page() {
              Ok(r) => gv_note(f, "OUT page ${page}: ${show_environments_client_suspend_response(r)}")
              Err(e) => {
                gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
                break
              }
            }
          }
        }
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  // Go panics at line 5 (its pager has no handler); ours reads page one
  let got = gv_log_of(f)
  gv_compare(got[0..5], GO_39[0..5])
  expect(got[5].starts_with("OUT page 1: ")) == true
}

