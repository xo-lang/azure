  let c = new_workflow_run_actions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"code\":\"s-code\",\"correlation\":{\"actionTrackingId\":\"s-actiontrackingid\",\"clientKeywords\":[\"s-clientkeywords\"],\"clientTrackingId\":\"s-clienttrackingid\"},\"endTime\":\"2026-11-06T10:00:00Z\",\"error\":{\"k\":\"v\"},\"inputsLink\":{\"contentHash\":{\"algorithm\":\"s-algorithm\",\"value\":\"s-value\"},\"contentSize\":7,\"contentVersion\":\"s-contentversion\",\"metadata\":{\"k\":\"v\"},\"uri\":\"s-uri\"},\"outputsLink\":{\"contentHash\":{\"algorithm\":\"s-algorithm\",\"value\":\"s-value\"},\"contentSize\":7,\"contentVersion\":\"s-contentversion\",\"metadata\":{\"k\":\"v\"},\"uri\":\"s-uri\"},\"retryHistory\":[{\"clientRequestId\":\"s-clientrequestid\",\"code\":\"s-code\",\"endTime\":\"2026-11-06T10:00:00Z\",\"error\":{},\"serviceRequestId\":\"s-servicerequestid\",\"startTime\":\"2026-11-06T10:00:00Z\"}],\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"trackedProperties\":{\"k\":\"v\"},\"trackingId\":\"s-trackingid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkflowRunActionsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", WorkflowRunActionsClientListOptions{filter: Some("s-filter"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workflow_run_actions_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_676)
}

