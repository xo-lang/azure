  "CALL WorkflowTriggerHistoriesClient.BeginResubmit",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.Web/sites/id2%2F%20x/hostruntime/runtime/webhooks/workflow/api/management/workflows/id3%2F%20x/triggers/id4%2F%20x/histories/id5%2F%20x/resubmit?api-version=2025-05-01",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 202 ",
  "OUT: error: response is missing polling URL",
]

test "Go's WorkflowTriggerHistoriesClient.BeginResubmit" {
  let f = gv_new_fake(os.net)
  let c = new_workflow_trigger_histories_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL WorkflowTriggerHistoriesClient.BeginResubmit")
  match c.begin_resubmit("id1/ x", "id2/ x", "id3/ x", "id4/ x", "id5/ x", WorkflowTriggerHistoriesClientBeginResubmitOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_workflow_trigger_histories_client_resubmit_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_680)
}

