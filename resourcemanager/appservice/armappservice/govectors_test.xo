fn show_environments_client_list_by_resource_group_response(r: EnvironmentsClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.environment_collection).to_str_lossy()}")
  parts.join(" ")
}

