fn show_web_apps_client_create_or_update_source_control_response(r: WebAppsClientCreateOrUpdateSourceControlResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.site_source_control).to_str_lossy()}")
  parts.join(" ")
}

