fn show_web_apps_client_get_configuration_slot_response(r: WebAppsClientGetConfigurationSlotResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.site_config_resource).to_str_lossy()}")
  parts.join(" ")
}

