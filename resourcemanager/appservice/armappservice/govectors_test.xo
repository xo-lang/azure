fn show_web_apps_client_update_auth_settings_v2_slot_response(r: WebAppsClientUpdateAuthSettingsV2SlotResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.site_auth_settings_v2).to_str_lossy()}")
  parts.join(" ")
}

