rue,\"upgradeAvailability\":\"s-upgradeavailability\",\"upgradePreference\":\"s-upgradepreference\",\"userWhitelistedIpRanges\":[\"s-userwhitelistedipranges\"],\"virtualNetwork\":{\"id\":\"s-id\",\"name\":\"s-name\",\"subnet\":\"s-subnet\",\"type\":\"s-type\"},\"zoneRedundant\":true},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), EnvironmentsClientBeginCreateOrUpdateOptions{}) {
