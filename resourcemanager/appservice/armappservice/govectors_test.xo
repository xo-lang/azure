test "Go's WebAppsClient.GetBackupStatus" {
  let f = gv_new_fake(os.net)
  let c = new_web_apps_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"properties\":{\"blobName\":\"s-blobname\",\"correlationId\":\"s-correlationid\",\"created\":\"2026-11-06T10:00:00Z\",\"databases\":[{\"connectionString\":\"s-connectionstring\",\"connectionStringName\":\"s-connectionstringname\",\"databaseType\":\"s-databasetype\",\"name\":\"s-name\"}],\"finishedTimeStamp\":\"2026-11-06T10:00:00Z\",\"id\":7,\"lastRestoreTimeStamp\":\"2026-11-06T10:00:00Z\",\"log\":\"s-log\",\"name\":\"s-name\",\"scheduled\":true,\"sizeInBytes\":7,\"status\":\"s-status\",\"storageAccountUrl\":\"s-storageaccounturl\",\"websiteSizeInBytes\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL WebAppsClient.GetBackupStatus")
  match c.get_backup_status("id1/ x", "id2/ x", "id3/ x", WebAppsClientGetBackupStatusOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_web_apps_client_get_backup_status_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_364)
}

fn show_web_apps_client_get_backup_status_slot_response(r: WebAppsClientGetBackupStatusSlotResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.backup_item).to_str_lossy()}")
  parts.join(" ")
}

