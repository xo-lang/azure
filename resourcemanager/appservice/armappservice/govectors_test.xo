  let c = new_web_apps_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"properties\":{\"blob\":\"YWI=\",\"publicCertificateLocation\":\"s-publiccertificatelocation\",\"thumbprint\":\"s-thumbprint\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WebAppsClient.NewListPublicCertificatesSlotPager")
  var pg = c.new_list_public_certificates_slot_pager("id1/ x", "id2/ x", "id3/ x", WebAppsClientListPublicCertificatesSlotOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_web_apps_client_list_public_certificates_slot_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_550)
}

