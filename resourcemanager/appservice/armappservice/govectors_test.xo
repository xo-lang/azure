"type\":\"s-type\"},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"status\":\"s-status\",\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}],\"provider\":\"s-provider\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"repositoryToken\":\"s-repositorytoken\",\"repositoryUrl\":\"s-repositoryurl\",\"stagingEnvironmentPolicy\":\"s-stagingenvironmentpolicy\",\"templateProperties\":{\"description\":\"s-description\",\"isPrivate\":true,\"owner\":\"s-owner\",\"repositoryName\":\"s-repositoryname\",\"templateRepositoryUrl\":\"s-templaterepositoryurl\"},\"userProvidedFunctionApps\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"properties\":{\"createdOn\":\"2026-11-06T10:00:00Z\",\"functionAppRegion\":\"s-functionappregion\",\"functionAppResourceId\":\"s-functionappresourceid\"},\"type\":\"s-type\"}]},\"sku\":{\"capabilities\":[{\"name\":\"s-name\",\"reason\":\"s-reason\",\"value\":\"s-value\"}],\"capacity\":7,\"family\":\"s-family\",\"locations\":[\"s-locations\"],\"name\":\"s-name\",\"size\":\"s-size\",\"skuCapacity\":{\"default\":7,\"elasticMaximum\":7,\"maximum\":7,\"minimum\":7,\"scaleType\":\"s-scaletype\"},\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL StaticSitesClient.NewListPager")
  var pg = c.new_list_pager(StaticSitesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_static_sites_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_219)
}

fn show_static_sites_client_list_static_site_build_functions_response(r: StaticSitesClientListStaticSiteBuildFunctionsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.static_site_function_overview_collection).to_str_lossy()}")
  parts.join(" ")
}

