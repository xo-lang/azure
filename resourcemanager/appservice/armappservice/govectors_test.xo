  let f = gv_new_fake(os.net)
  let c = new_web_apps_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"properties\":{\"acrUseManagedIdentityCreds\":true,\"acrUserManagedIdentityID\":\"s-acrusermanagedidentityid\",\"alwaysOn\":true,\"apiDefinition\":{\"url\":\"s-url\"},\"apiManagementConfig\":{\"id\":\"s-id\"},\"appCommandLine\":\"s-appcommandline\",\"appSettings\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"autoHealEnabled\":true,\"autoHealRules\":{\"actions\":{\"actionType\":\"s-actiontype\",\"customAction\":{\"exe\":\"s-exe\",\"parameters\":\"s-parameters\"},\"minProcessExecutionTime\":\"s-minprocessexecutiontime\"},\"triggers\":{\"privateBytesInKB\":7,\"requests\":{\"count\":7,\"timeInterval\":\"s-timeinterval\"},\"slowRequests\":{\"count\":7,\"path\":\"s-path\",\"timeInterval\":\"s-timeinterval\",\"timeTaken\":\"s-timetaken\"}}},\"autoSwapSlotName\":\"s-autoswapslotname\",\"azureStorageAccounts\":{\"k1\":{\"accessKey\":\"s-accesskey\",\"accountName\":\"s-accountname\",\"mountPath\":\"s-mountpath\",\"protocol\":\"s-protocol\",\"shareName\":\"s-sharename\",\"state\":\"s-state\",\"type\":\"s-type\"}},\"connectionStrings\":[{\"connectionString\":\"s-connectionstring\",\"name\":\"s-name\",\"type\":\"s-type\"}],\"cors\":{\"allowedOrigins\":[\"s-allowedorigins\"],\"supportCredentials\":true},\"defaultDocuments\":[\"s-defaultdocuments\"],\"detailedErrorLoggingEnabled\":true,\"documentRoot\":\"s-documentroot\",\"elasticWebAppScaleLimit\":7,\"experiments\":{\"rampUpRules\":[{\"actionHostName\":\"s-actionhostname\",\"changeDecisionCallbackUrl\":\"s-changedecisioncallbackurl\",\"changeIntervalInMinutes\":7,\"changeStep\":1.5,\"maxReroutePercentage\":1.5,\"minReroutePercentage\":1.5,\"name\":\"s-name\",\"reroutePercentage\":1.5}]},\"ftpsState\":\"s-ftpsstate\",\"functionAppScaleLimit\":7,\"functionsRuntimeScaleMonitoringEnabled\":true,\"handlerMappings\":[{\"arguments\":\"s-arguments\",\"extension\":\"s-extension\",\"