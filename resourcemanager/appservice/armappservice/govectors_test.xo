  let f = gv_new_fake(os.net)
  let c = new_environments_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"properties\":{\"ipAddresses\":[\"s-ipaddresses\"],\"privateEndpoint\":{\"id\":\"s-id\"},\"privateLinkServiceConnectionState\":{\"actionsRequired\":\"s-actionsrequired\",\"description\":\"s-description\",\"status\":\"s-status\"},\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL EnvironmentsClient.BeginApproveOrRejectPrivateEndpointConnection")
  match c.begin_approve_or_reject_private_endpoint_connection("id1/ x", "id2/ x", "id3/ x", (json.decode_str[RemotePrivateEndpointConnectionARMResource]("{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"properties\":{\"ipAddresses\":[\"s-ipaddresses\"],\"privateEndpoint\":{\"id\":\"s-id\"},\"privateLinkServiceConnectionState\":{\"actionsRequired\":\"s-actionsrequired\",\"description\":\"s-description\",\"status\":\"s-status\"},\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), EnvironmentsClientBeginApproveOrRejectPrivateEndpointConnectionOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_environments_client_approve_or_reject_private_endpoint_connection_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_31)
}

