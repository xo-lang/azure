a\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"minTlsCipherSuite\":\"s-mintlsciphersuite\",\"minTlsVersion\":\"s-mintlsversion\",\"minimumElasticInstanceCount\":7,\"netFrameworkVersion\":\"s-netframeworkversion\",\"nodeVersion\":\"s-nodeversion\",\"numberOfWorkers\":7,\"phpVersion\":\"s-phpversion\",\"powerShellVersion\":\"s-powershellversion\",\"preWarmedInstanceCount\":7,\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"publishingUsername\":\"s-publishingusername\",\"push\":{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"properties\":{\"dynamicTagsJson\":\"s-dynamictagsjson\",\"isPushEnabled\":true,\"tagWhitelistJson\":\"s-tagwhitelistjson\",\"tagsRequiringAuth\":\"s-tagsrequiringauth\"},\"type\":\"s-type\"},\"pythonVersion\":\"s-pythonversion\",\"remoteDebuggingEnabled\":true,\"remoteDebuggingVersion\":\"s-remotedebuggingversion\",\"requestTracingEnabled\":true,\"requestTracingExpirationTime\":\"2026-11-06T10:00:00Z\",\"scmIpSecurityRestrictions\":[{\"action\":\"s-action\",\"description\":\"s-description\",\"ipAddress\":\"s-ipaddress\",\"name\":\"s-name\",\"priority\":7,\"subnetMask\":\"s-subnetmask\",\"subnetTrafficTag\":7,\"tag\":\"s-tag\",\"vnetSubnetResourceId\":\"s-vnetsubnetresourceid\",\"vnetTrafficTag\":7}],\"scmIpSecurityRestrictionsDefaultAction\":\"s-scmipsecurityrestrictionsdefaultaction\",\"scmIpSecurityRestrictionsUseMain\":true,\"scmMinTlsVersion\":\"s-scmmintlsversion\",\"scmType\":\"s-scmtype\",\"tracingOptions\":\"s-tracingoptions\",\"use32BitWorkerProcess\":true,\"virtualApplications\":[{\"physicalPath\":\"s-physicalpath\",\"preloadEnabled\":true,\"virtualPath\":\"s-virtualpath\"}],\"vnetName\":\"s-vnetname\",\"vnetPrivatePortsCount\":7,\"vnetRouteAllEnabled\":true,\"webSocketsEnabled\":true,\"websiteTimeZone\":\"s-websitetimezone\",\"windowsFxVersion\":\"s-windowsfxversion\",\"xManagedServiceIdentityId\":7},\"sku\":\"s-sku\",\"slotSwapStatus\":{\"destinationSlotName\":\"s-destinationslotname\",\"sourceSlotName\":\"s-sourceslotname\",\"timestampUtc\":\"2026-11-06T10:00:00Z\"},\"sshEnabled\":true,\"state\":\"s-state\",\"storageAccountRequired\":true,\"suspendedTill\":\"2026-11-06T10:00:00Z\",\"targetSwapSlot\":\"s-targetswapslot\",\"trafficManagerHostNames\":[\"s-trafficmanagerhostnames\"],\"usageState\":\"s-usagestate\",\"virtualNetworkSubnetId\":\"s-virtualnetworksubnetid\",\"workloadProfileName\":\"s-workloadprofilename\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EnvironmentsClient.BeginResume")
  match c.begin_resume("id1/ x", "id2/ x", EnvironmentsClientBeginResumeOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(pg0) => {
          var pg = pg0
          for page in [1, 2] {
            if !pg.more() {
              gv_note(f, "OUT page ${page}: no more")
              break
            }
            match pg.next_page() {
              Ok(r) => gv_note(f, "OUT page ${page}: ${show_environments_client_resume_response(r)}")
              Err(e) => {
                gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
                break
              }
            }
          }
        }
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  // Go panics at line 5 (its pager has no handler); ours reads page one
  let got = gv_log_of(f)
  gv_compare(got[0..5], GO_38[0..5])
  expect(got[5].starts_with("OUT page 1: ")) == true
}

fn show_environments_client_suspend_response(r: EnvironmentsClientSuspendResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.web_app_collection).to_str_lossy()}")
  parts.join(" ")
}

