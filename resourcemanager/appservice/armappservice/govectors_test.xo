  let c = new_web_apps_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"properties\":{\"azureResourceName\":\"s-azureresourcename\",\"azureResourceType\":\"s-azureresourcetype\",\"customHostNameDnsRecordType\":\"s-customhostnamednsrecordtype\",\"domainId\":\"s-domainid\",\"hostNameType\":\"s-hostnametype\",\"siteName\":\"s-sitename\",\"sslState\":\"s-sslstate\",\"thumbprint\":\"s-thumbprint\",\"virtualIP\":\"s-virtualip\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WebAppsClient.NewListHostNameBindingsSlotPager")
  var pg = c.new_list_host_name_bindings_slot_pager("id1/ x", "id2/ x", "id3/ x", WebAppsClientListHostNameBindingsSlotOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
