ame\",\"zoneRedundant\":true},\"sku\":{\"capabilities\":[{\"name\":\"s-name\",\"reason\":\"s-reason\",\"value\":\"s-value\"}],\"capacity\":7,\"family\":\"s-family\",\"locations\":[\"s-locations\"],\"name\":\"s-name\",\"size\":\"s-size\",\"skuCapacity\":{\"default\":7,\"elasticMaximum\":7,\"maximum\":7,\"minimum\":7,\"scaleType\":\"s-scaletype\"},\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
