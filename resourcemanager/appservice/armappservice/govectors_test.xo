  gv_note(f, "CALL WebAppsClient.NewListConfigurationsSlotPager")
  var pg = c.new_list_configurations_slot_pager("id1/ x", "id2/ x", "id3/ x", WebAppsClientListConfigurationsSlotOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_web_apps_client_list_configurations_slot_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_519)
}

fn show_web_apps_client_list_continuous_web_jobs_response(r: WebAppsClientListContinuousWebJobsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.continuous_web_job_collection).to_str_lossy()}")
  parts.join(" ")
}

