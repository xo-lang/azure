":\"s-state\",\"total_processor_time\":\"s-totalprocessortime\",\"user_processor_time\":\"s-userprocessortime\",\"wait_reason\":\"s-waitreason\"},\"type\":\"s-type\"}],\"time_stamp\":\"2026-11-06T10:00:00Z\",\"total_cpu_time\":\"s-totalcputime\",\"user_cpu_time\":\"s-usercputime\",\"user_name\":\"s-username\",\"virtual_memory\":7,\"working_set\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WebAppsClient.NewListInstanceProcessesPager")
  var pg = c.new_list_instance_processes_pager("id1/ x", "id2/ x", "id3/ x", WebAppsClientListInstanceProcessesOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_web_apps_client_list_instance_processes_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_536)
}

