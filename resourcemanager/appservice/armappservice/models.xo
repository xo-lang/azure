/// SiteDNSConfigPatch: SiteDNSConfig in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct SiteDNSConfigPatch {
  /// Alternate DNS server to be used by apps. This property replicates the WEBSITE_DNS_ALT_SERVER app setting.
  pub dns_alt_server as "dnsAltServer,omitempty": json.Patch[Str] = json.Patch.Absent
  /// Indicates that sites using Virtual network custom DNS servers are still sorting the list of DNS servers. Read-Only.
  pub dns_legacy_sort_order as "dnsLegacySortOrder,omitempty": json.Patch[Bool] = json.Patch.Absent
  /// Custom time for DNS to be cached in seconds. Allowed range: 0-60. Default is 30 seconds. 0 means caching disabled.
  pub dns_max_cache_timeout as "dnsMaxCacheTimeout,omitempty": json.Patch[Int] = json.Patch.Absent
  /// Total number of retries for dns lookup. Allowed range: 1-5. Default is 3.
  pub dns_retry_attempt_count as "dnsRetryAttemptCount,omitempty": json.Patch[Int] = json.Patch.Absent
  /// Timeout for a single dns lookup in seconds. Allowed range: 1-30. Default is 3.
  pub dns_retry_attempt_timeout as "dnsRetryAttemptTimeout,omitempty": json.Patch[Int] = json.Patch.Absent
  /// List of custom DNS servers to be used by an app for lookups. Maximum 5 dns servers can be set.
  pub dns_servers as "dnsServers,omitempty": json.Patch[List[Str]] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: SiteDNSConfig) patch() -> SiteDNSConfigPatch {
  SiteDNSConfigPatch{
    dns_servers: match m.dns_servers {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    dns_alt_server: match m.dns_alt_server {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    dns_retry_attempt_timeout: match m.dns_retry_attempt_timeout {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    dns_retry_attempt_count: match m.dns_retry_attempt_count {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    dns_max_cache_timeout: match m.dns_max_cache_timeout {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    dns_legacy_sort_order: match m.dns_legacy_sort_order {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}

