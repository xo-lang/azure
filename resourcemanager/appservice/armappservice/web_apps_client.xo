/// WebAppsClientBeginStartNetworkTraceOptions: the optional parameters of WebAppsClient.begin_start_network_trace.
pub struct WebAppsClientBeginStartNetworkTraceOptions {
  /// The duration to keep capturing in seconds.
  pub duration_in_seconds: Int? = None
  /// The maximum frame length in bytes (Optional).
  pub max_frame_length: Int? = None
  /// The Blob URL to store capture file.
  pub sas_url: Str? = None
  /// Resumes the operation from a poller's resume_token instead of starting it.
  pub resume_token: Str = ""
}

/// WebAppsClientStartNetworkTraceResponse: the response of WebAppsClient.begin_start_network_trace.
pub struct WebAppsClientStartNetworkTraceResponse {
  pub value: List[NetworkTrace]
}

fn web_apps_start_network_trace_handle(resp: http.Response) -> WebAppsClientStartNetworkTraceResponse ! Str {
  let v = if resp.body.is_empty() { [] } else { json.decode[List[NetworkTrace]](resp.body) ?? e => return Err(e.display()) }
  Ok(WebAppsClientStartNetworkTraceResponse{value: v})
}

fn (c: WebAppsClient) start_network_trace_create_request(resource_group_name: Str, name: Str, options: WebAppsClientBeginStartNetworkTraceOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.Web/sites/{name}/startNetworkTrace"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter name cannot be empty"))
  }
  path = path.replace("{name}", url.path_escape(name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  if let Some(v) = options.duration_in_seconds {
    q.add("durationInSeconds", "${v}")
  }
  if let Some(v) = options.max_frame_length {
    q.add("maxFrameLength", "${v}")
  }
  if let Some(v) = options.sas_url {
    q.add("sasUrl", v)
  }
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: b""})
}

/// Description for Start capturing network packets for the site.
pub fn (c: WebAppsClient[fx]) begin_start_network_trace(resource_group_name: Str, name: Str, options: WebAppsClientBeginStartNetworkTraceOptions = WebAppsClientBeginStartNetworkTraceOptions{}) -> runtime.Poller[WebAppsClientStartNetworkTraceResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "WebAppsClientStartNetworkTraceResponse", fn(r: http.Response) -> WebAppsClientStartNetworkTraceResponse ! Str { web_apps_start_network_trace_handle(r) })
  }
  let req = c.start_network_trace_create_request(resource_group_name, name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "", "WebAppsClientStartNetworkTraceResponse", fn(r: http.Response) -> WebAppsClientStartNetworkTraceResponse ! Str { web_apps_start_network_trace_handle(r) })
}

