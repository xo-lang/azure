test "Go's ExternalAuthsClient.NewListByParentPager" {
  let f = gv_new_fake(os.net)
  let c = new_external_auths_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"claim\":{\"mappings\":{\"groups\":{\"claim\":\"s-claim\",\"prefix\":\"s-prefix\"},\"username\":{\"claim\":\"s-claim\",\"prefix\":\"s-prefix\",\"prefixPolicy\":\"s-prefixpolicy\"}},\"validationRules\":[{\"type\":\"s-type\"}]},\"clients\":[{\"clientId\":\"s-clientid\",\"component\":{\"authClientNamespace\":\"s-authclientnamespace\",\"name\":\"s-name\"},\"extraScopes\":[\"s-extrascopes\"],\"type\":\"s-type\"}],\"issuer\":{\"audiences\":[\"s-audiences\"],\"ca\":\"s-ca\",\"url\":\"s-url\"},\"provisioningState\":\"Succeeded\",\"status\":{\"conditions\":[{\"lastTransitionTime\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"reason\":\"s-reason\",\"status\":\"s-status\",\"type\":\"s-type\"}]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ExternalAuthsClient.NewListByParentPager")
  var pg = c.new_list_by_parent_pager("id1/ x", "id2/ x", ExternalAuthsClientListByParentOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_external_auths_client_list_by_parent_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_4)
}

