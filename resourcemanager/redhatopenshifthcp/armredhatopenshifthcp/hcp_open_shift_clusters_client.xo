pub fn (c: HcpOpenShiftClustersClient[fx]) begin_revoke_credentials(resource_group_name: Str, hcp_open_shift_cluster_name: Str, options: HcpOpenShiftClustersClientBeginRevokeCredentialsOptions = HcpOpenShiftClustersClientBeginRevokeCredentialsOptions{}) -> runtime.Poller[HcpOpenShiftClustersClientRevokeCredentialsResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "HcpOpenShiftClustersClientRevokeCredentialsResponse", fn(r: http.Response) -> HcpOpenShiftClustersClientRevokeCredentialsResponse ! Str { hcp_open_shift_clusters_revoke_credentials_handle(r) })
  }
  let req = c.revoke_credentials_create_request(resource_group_name, hcp_open_shift_cluster_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "", "HcpOpenShiftClustersClientRevokeCredentialsResponse", fn(r: http.Response) -> HcpOpenShiftClustersClientRevokeCredentialsResponse ! Str { hcp_open_shift_clusters_revoke_credentials_handle(r) })
}
