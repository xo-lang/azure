test "Go's RegisteredServersClient.Get" {
  let f = gv_new_fake(os.net)
  let c = new_registered_servers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"activeAuthType\":\"s-activeauthtype\",\"agentVersion\":\"s-agentversion\",\"agentVersionExpirationDate\":\"2026-11-06T10:00:00Z\",\"agentVersionStatus\":\"s-agentversionstatus\",\"applicationId\":\"s-applicationid\",\"clusterId\":\"s-clusterid\",\"clusterName\":\"s-clustername\",\"discoveryEndpointUri\":\"s-discoveryendpointuri\",\"friendlyName\":\"s-friendlyname\",\"identity\":true,\"lastHeartBeat\":\"s-lastheartbeat\",\"lastOperationName\":\"s-lastoperationname\",\"lastWorkflowId\":\"s-lastworkflowid\",\"latestApplicationId\":\"s-latestapplicationid\",\"managementEndpointUri\":\"s-managementendpointuri\",\"monitoringConfiguration\":\"s-monitoringconfiguration\",\"monitoringEndpointUri\":\"s-monitoringendpointuri\",\"provisioningState\":\"Succeeded\",\"resourceLocation\":\"s-resourcelocation\",\"serverCertificate\":\"s-servercertificate\",\"serverId\":\"s-serverid\",\"serverManagementErrorCode\":7,\"serverName\":\"s-servername\",\"serverOSVersion\":\"s-serverosversion\",\"serverRole\":\"s-serverrole\",\"serviceLocation\":\"s-servicelocation\",\"storageSyncServiceUid\":\"s-storagesyncserviceuid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL RegisteredServersClient.Get")
  match c.get("id1/ x", "id2/ x", "id3/ x", RegisteredServersClientGetOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_registered_servers_client_get_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_24)
}

fn show_registered_servers_client_list_by_storage_sync_service_response(r: RegisteredServersClientListByStorageSyncServiceResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.registered_server_array).to_str_lossy()}")
  if let Some(v) = r.xms_correlation_request_id {
    parts.push("XMSCorrelationRequestID=${v}")
  }
  if let Some(v) = r.xms_request_id {
    parts.push("XMSRequestID=${v}")
  }
  parts.join(" ")
}

