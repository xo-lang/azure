fn show_server_endpoints_client_list_by_sync_group_response(r: ServerEndpointsClientListBySyncGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.server_endpoint_array).to_str_lossy()}")
  if let Some(v) = r.location {
    parts.push("Location=${v}")
  }
  if let Some(v) = r.xms_correlation_request_id {
    parts.push("XMSCorrelationRequestID=${v}")
  }
  if let Some(v) = r.xms_request_id {
    parts.push("XMSRequestID=${v}")
  }
  parts.join(" ")
}

