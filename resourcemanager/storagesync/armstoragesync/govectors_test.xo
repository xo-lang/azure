test "Go's RegisteredServersClient.NewListByStorageSyncServicePager" {
  let f = gv_new_fake(os.net)
  let c = new_registered_servers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"activeAuthType\":\"s-activeauthtype\",\"agentVersion\":\"s-agentversion\",\"agentVersionExpirationDate\":\"2026-11-06T10:00:00Z\",\"agentVersionStatus\":\"s-agentversionstatus\",\"applicationId\":\"s-applicationid\",\"clusterId\":\"s-clusterid\",\"clusterName\":\"s-clustername\",\"discoveryEndpointUri\":\"s-discoveryendpointuri\",\"friendlyName\":\"s-friendlyname\",\"identity\":true,\"lastHeartBeat\":\"s-lastheartbeat\",\"lastOperationName\":\"s-lastoperationname\",\"lastWorkflowId\":\"s-lastworkflowid\",\"latestApplicationId\":\"s-latestapplicationid\",\"managementEndpointUri\":\"s-managementendpointuri\",\"monitoringConfiguration\":\"s-monitoringconfiguration\",\"monitoringEndpointUri\":\"s-monitoringendpointuri\",\"provisioningState\":\"Succeeded\",\"resourceLocation\":\"s-resourcelocation\",\"serverCertificate\":\"s-servercertificate\",\"serverId\":\"s-serverid\",\"serverManagementErrorCode\":7,\"serverName\":\"s-servername\",\"serverOSVersion\":\"s-serverosversion\",\"serverRole\":\"s-serverrole\",\"serviceLocation\":\"s-servicelocation\",\"storageSyncServiceUid\":\"s-storagesyncserviceuid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RegisteredServersClient.NewListByStorageSyncServicePager")
  var pg = c.new_list_by_storage_sync_service_pager("id1/ x", "id2/ x", RegisteredServersClientListByStorageSyncServiceOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_registered_servers_client_list_by_storage_sync_service_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_25)
}

