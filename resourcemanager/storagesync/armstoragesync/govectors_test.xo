  gv_note(f, "CALL ServerEndpointsClient.BeginUpdate")
  match c.begin_update("id1/ x", "id2/ x", "id3/ x", "id4/ x", (json.decode_str[ServerEndpointUpdateParameters]("{\"properties\":{\"cloudTiering\":\"s-cloudtiering\",\"localCacheMode\":\"s-localcachemode\",\"offlineDataTransfer\":\"s-offlinedatatransfer\",\"offlineDataTransferShareName\":\"s-offlinedatatransfersharename\",\"tierFilesOlderThanDays\":7,\"volumeFreeSpacePercent\":7}}") ?? e => fault("${e}")), ServerEndpointsClientBeginUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_server_endpoints_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_29)
}

fn show_server_endpoints_client_get_response(r: ServerEndpointsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.server_endpoint).to_str_lossy()}")
  if let Some(v) = r.xms_correlation_request_id {
    parts.push("XMSCorrelationRequestID=${v}")
  }
  if let Some(v) = r.xms_request_id {
    parts.push("XMSRequestID=${v}")
  }
  parts.join(" ")
}

