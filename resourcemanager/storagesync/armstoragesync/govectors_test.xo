  gv_note(f, "CALL CloudEndpointsClient.BeginUpdate")
  match c.begin_update("id1/ x", "id2/ x", "id3/ x", "id4/ x", (json.decode_str[CloudEndpointUpdateParameters]("{\"properties\":{\"changeEnumerationIntervalDays\":7}}") ?? e => fault("${e}")), CloudEndpointsClientBeginUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_cloud_endpoints_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_8)
}

