test "Go's ApplicationsClient.NewListByClusterPager" {
  let f = gv_new_fake(os.net)
  let c = new_applications_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"applicationState\":\"s-applicationstate\",\"applicationType\":\"s-applicationtype\",\"computeProfile\":{\"roles\":[{\"VMGroupName\":\"s-vmgroupname\",\"encryptDataDisks\":true,\"minInstanceCount\":7,\"name\":\"s-name\",\"targetInstanceCount\":7}]},\"createdDate\":\"s-createddate\",\"errors\":[{\"code\":\"s-code\",\"message\":\"s-message\"}],\"httpsEndpoints\":[{\"accessModes\":[\"s-accessmodes\"],\"destinationPort\":7,\"disableGatewayAuth\":true,\"location\":\"s-location\",\"privateIPAddress\":\"s-privateipaddress\",\"publicPort\":7,\"subDomainSuffix\":\"s-subdomainsuffix\"}],\"installScriptActions\":[{\"applicationName\":\"s-applicationname\",\"name\":\"s-name\",\"parameters\":\"s-parameters\",\"roles\":[\"s-roles\"],\"uri\":\"s-uri\"}],\"marketplaceIdentifier\":\"s-marketplaceidentifier\",\"privateLinkConfigurations\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"groupId\":\"s-groupid\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"sshEndpoints\":[{\"destinationPort\":7,\"location\":\"s-location\",\"privateIPAddress\":\"s-privateipaddress\",\"publicPort\":7}],\"uninstallScriptActions\":[{\"applicationName\":\"s-applicationname\",\"name\":\"s-name\",\"parameters\":\"s-parameters\",\"roles\":[\"s-roles\"],\"uri\":\"s-uri\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ApplicationsClient.NewListByClusterPager")
  var pg = c.new_list_by_cluster_pager("id1/ x", "id2/ x", ApplicationsClientListByClusterOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_applications_client_list_by_cluster_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_4)
}

