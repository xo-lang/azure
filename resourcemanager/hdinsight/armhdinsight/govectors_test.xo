test "Go's ClustersClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_clusters_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"clusterDefinition\":{\"blueprint\":\"s-blueprint\",\"componentVersion\":{\"k1\":\"s-componentversion\"},\"configurations\":{\"k\":\"v\"},\"kind\":\"s-kind\"},\"clusterHdpVersion\":\"s-clusterhdpversion\",\"clusterId\":\"s-clusterid\",\"clusterState\":\"s-clusterstate\",\"clusterVersion\":\"s-clusterversion\",\"computeIsolationProperties\":{\"enableComputeIsolation\":true,\"hostSku\":\"s-hostsku\"},\"computeProfile\":{\"roles\":[{\"VMGroupName\":\"s-vmgroupname\",\"encryptDataDisks\":true,\"minInstanceCount\":7,\"name\":\"s-name\",\"targetInstanceCount\":7}]},\"connectivityEndpoints\":[{\"location\":\"s-location\",\"name\":\"s-name\",\"port\":7,\"privateIPAddress\":\"s-privateipaddress\",\"protocol\":\"s-protocol\"}],\"createdDate\":\"s-createddate\",\"diskEncryptionProperties\":{\"encryptionAlgorithm\":\"s-encryptionalgorithm\",\"encryptionAtHost\":true,\"keyName\":\"s-keyname\",\"keyVersion\":\"s-keyversion\",\"msiResourceId\":\"s-msiresourceid\",\"vaultUri\":\"s-vaulturi\"},\"encryptionInTransitProperties\":{\"isEncryptionInTransitEnabled\":true},\"errors\":[{\"code\":\"s-code\",\"message\":\"s-message\"}],\"excludedServicesConfig\":{\"excludedServicesConfigId\":\"s-excludedservicesconfigid\",\"excludedServicesList\":\"s-excludedserviceslist\"},\"kafkaRestProperties\":{\"clientGroupInfo\":{\"groupId\":\"s-groupid\",\"groupName\":\"s-groupname\"},\"configurationOverride\":{\"k1\":\"s-configurationoverride\"}},\"minSupportedTlsVersion\":\"s-minsupportedtlsversion\",\"networkProperties\":{\"privateLink\":\"https://management.example.test/next?\$skiptoken=2\",\"resourceProviderConnection\":\"s-resourceproviderconnection\"},\"osType\":\"s-ostype\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"linkIdentifier\":\"https://management.example.test/next?\$skiptoken=2\",\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"privateLinkConfigurations\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"groupId\":\"s-groupid\",\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"quotaInfo\":{\"coresUsed\":7},\"securityProfile\":{\"aaddsResourceId\":\"s-aaddsresourceid\",\"clusterUsersGroupDNs\":[\"s-clusterusersgroupdns\"],\"directoryType\":\"s-directorytype\",\"domain\":\"s-domain\",\"domainUserPassword\":\"s-domainuserpassword\",\"domainUsername\":\"s-domainusername\",\"ldapsUrls\":[\"s-ldapsurls\"],\"msiResourceId\":\"s-msiresourceid\",\"organizationalUnitDN\":\"s-organizationalunitdn\"},\"storageProfile\":{\"storageaccounts\":[{\"container\":\"s-container\",\"fileSystem\":\"s-filesystem\",\"fileshare\":\"s-fileshare\",\"isDefault\":true,\"key\":\"s-key\",\"msiResourceId\":\"s-msiresourceid\",\"name\":\"s-name\",\"resourceId\":\"s-resourceid\",\"saskey\":\"s-saskey\"}]},\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
  gv_note(f, "CALL ClustersClient.NewListPager")
  var pg = c.new_list_pager(ClustersClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_clusters_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_17)
}

fn show_clusters_client_update_response(r: ClustersClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster).to_str_lossy()}")
  parts.join(" ")
}

