test "Go's ScriptExecutionHistoryClient.NewListByClusterPager" {
  let f = gv_new_fake(os.net)
  let c = new_script_execution_history_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"applicationName\":\"s-applicationname\",\"debugInformation\":\"s-debuginformation\",\"endTime\":\"s-endtime\",\"executionSummary\":[{\"instanceCount\":7,\"status\":\"s-status\"}],\"name\":\"s-name\",\"operation\":\"s-operation\",\"parameters\":\"s-parameters\",\"roles\":[\"s-roles\"],\"scriptExecutionId\":7,\"startTime\":\"s-starttime\",\"status\":\"s-status\",\"uri\":\"s-uri\"}]}")
  gv_note(f, "CALL ScriptExecutionHistoryClient.NewListByClusterPager")
  var pg = c.new_list_by_cluster_pager("id1/ x", "id2/ x", ScriptExecutionHistoryClientListByClusterOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_script_execution_history_client_list_by_cluster_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_49)
}

