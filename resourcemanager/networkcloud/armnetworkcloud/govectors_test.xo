test "Go's VolumesClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_volumes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"allocatedSizeMiB\":7,\"assignedStorageApplianceId\":\"s-assignedstorageapplianceid\",\"attachedTo\":[\"s-attachedto\"],\"detailedStatus\":\"s-detailedstatus\",\"detailedStatusMessage\":\"s-detailedstatusmessage\",\"provisioningState\":\"Succeeded\",\"serialNumber\":\"s-serialnumber\",\"sizeMiB\":7,\"storageApplianceId\":\"s-storageapplianceid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VolumesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(VolumesClientListBySubscriptionOptions{skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_volumes_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_142)
}

fn show_volumes_client_update_response(r: VolumesClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.volume).to_str_lossy()}")
  parts.join(" ")
}

const GO_143: List[Str] = [
  "CALL VolumesClient.Update",
  "REQ PATCH https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.NetworkCloud/volumes/id2%2F%20x?api-version=2026-07-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json | if-match=s-ifmatch | if-none-match=s-ifnonematch",
  "  B {\"tags\":{\"k1\":\"s-tags\"}}",
  "  SERVED 200 {\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"allocatedSizeMiB\":7,\"assignedStorageApplianceId\":\"s-assignedstorageapplianceid\",\"attachedTo\":[\"s-attachedto\"],\"detailedStatus\":\"s-detailedstatus\",\"detailedStatusMessage\":\"s-detailedstatusmessage\",\"provisioningState\":\"Succeeded\",\"serialNumber\":\"s-serialnumber\",\"sizeMiB\":7,\"storageApplianceId\":\"s-storageapplianceid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}",
  "OUT: body={\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"allocatedSizeMiB\":7,\"assignedStorageApplianceId\":\"s-assignedstorageapplianceid\",\"attachedTo\":[\"s-attachedto\"],\"detailedStatus\":\"s-detailedstatus\",\"detailedStatusMessage\":\"s-detailedstatusmessage\",\"provisioningState\":\"Succeeded\",\"serialNumber\":\"s-serialnumber\",\"sizeMiB\":7,\"storageApplianceId\":\"s-storageapplianceid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}",
]

test "Go's VolumesClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_volumes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"allocatedSizeMiB\":7,\"assignedStorageApplianceId\":\"s-assignedstorageapplianceid\",\"attachedTo\":[\"s-attachedto\"],\"detailedStatus\":\"s-detailedstatus\",\"detailedStatusMessage\":\"s-detailedstatusmessage\",\"provisioningState\":\"Succeeded\",\"serialNumber\":\"s-serialnumber\",\"sizeMiB\":7,\"storageApplianceId\":\"s-storageapplianceid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL VolumesClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[VolumePatchParameters]("{\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), VolumesClientUpdateOptions{if_match: Some("s-ifmatch"), if_none_match: Some("s-ifnonematch")}) {
    Ok(r) => gv_note(f, "OUT: ${show_volumes_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_143)
}
