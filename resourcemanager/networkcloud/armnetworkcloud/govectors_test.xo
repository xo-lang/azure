fn show_clusters_client_delete_response(r: ClustersClientDeleteResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_status_result).to_str_lossy()}")
  parts.join(" ")
}

