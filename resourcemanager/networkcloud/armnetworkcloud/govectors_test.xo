  let c = new_l3_networks_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"associatedResourceIds\":[\"s-associatedresourceids\"],\"clusterId\":\"s-clusterid\",\"detailedStatus\":\"s-detailedstatus\",\"detailedStatusMessage\":\"s-detailedstatusmessage\",\"hybridAksClustersAssociatedIds\":[\"s-hybridaksclustersassociatedids\"],\"hybridAksIpamEnabled\":\"s-hybridaksipamenabled\",\"hybridAksPluginType\":\"s-hybridaksplugintype\",\"interfaceName\":\"s-interfacename\",\"ipAllocationType\":\"s-ipallocationtype\",\"ipv4ConnectedPrefix\":\"s-ipv4connectedprefix\",\"ipv6ConnectedPrefix\":\"s-ipv6connectedprefix\",\"l3IsolationDomainId\":\"s-l3isolationdomainid\",\"provisioningState\":\"Succeeded\",\"virtualMachinesAssociatedIds\":[\"s-virtualmachinesassociatedids\"],\"vlan\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL L3NetworksClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", L3NetworksClientListByResourceGroupOptions{skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
