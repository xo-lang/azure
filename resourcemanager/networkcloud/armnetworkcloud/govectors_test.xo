test "Go's BareMetalMachinesClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_bare_metal_machines_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"actionStates\":[{\"actionType\":\"s-actiontype\",\"correlationId\":\"s-correlationid\",\"endTime\":\"s-endtime\",\"message\":\"s-message\",\"startTime\":\"s-starttime\",\"status\":\"s-status\"}],\"associatedResourceIds\":[\"s-associatedresourceids\"],\"bmcConnectionString\":\"s-bmcconnectionstring\",\"bmcCredentials\":{\"password\":\"s-password\",\"username\":\"s-username\"},\"bmcIpv4Address\":\"s-bmcipv4address\",\"bmcIpv6Address\":\"s-bmcipv6address\",\"bmcMacAddress\":\"s-bmcmacaddress\",\"bootMacAddress\":\"s-bootmacaddress\",\"caCertificate\":{\"hash\":\"s-hash\",\"value\":\"s-value\"},\"clusterId\":\"s-clusterid\",\"cordonStatus\":\"s-cordonstatus\",\"detailedStatus\":\"s-detailedstatus\",\"detailedStatusMessage\":\"s-detailedstatusmessage\",\"hardwareInventory\":{\"additionalHostInformation\":\"s-additionalhostinformation\",\"interfaces\":[{\"linkStatus\":\"https://management.example.test/next?\$skiptoken=2\",\"macAddress\":\"s-macaddress\",\"name\":\"s-name\",\"networkInterfaceId\":\"s-networkinterfaceid\"}],\"nics\":[{\"macAddress\":\"s-macaddress\",\"name\":\"s-name\"}]},\"hardwareValidationStatus\":{\"lastValidationTime\":\"2026-11-06T10:00:00Z\",\"result\":\"s-result\"},\"hybridAksClustersAssociatedIds\":[\"s-hybridaksclustersassociatedids\"],\"kubernetesNodeName\":\"s-kubernetesnodename\",\"kubernetesVersion\":\"s-kubernetesversion\",\"machineClusterVersion\":\"s-machineclusterversion\",\"machineDetails\":\"s-machinedetails\",\"machineName\":\"s-machinename\",\"machineRoles\":[\"s-machineroles\"],\"machineSkuId\":\"s-machineskuid\",\"monitoringConfigurationStatus\":{\"logLevel\":\"s-loglevel\",\"metricsLevel\":\"s-metricslevel\"},\"oamIpv4Address\":\"s-oamipv4address\",\"oamIpv6Address\":\"s-oamipv6address\",\"osImage\":\"s-osimage\",\"powerState\":\"s-powerstate\",\"provisioningState\":\"Succeeded\",\"rackId\":\"s-rackid\",\"rackSlot\":7,\"readyState\":\"s-readystate\",\"runtimeProtectionStatus\":{\"agentHealthStatus\":\"s-agenthealthstatus\",\"agentHealthStatusIssues\":[\"s-agenthealthstatusissues\"],\"agentLicenseStatus\":\"s-agentlicensestatus\",\"definitionUpdateMode\":\"s-definitionupdatemode\",\"definitionsLastUpdated\":\"2026-11-06T10:00:00Z\",\"definitionsVersion\":\"s-definitionsversion\",\"enforcementLevel\":\"s-enforcementlevel\",\"scanCompletedTime\":\"2026-11-06T10:00:00Z\",\"scanScheduledTime\":\"2026-11-06T10:00:00Z\",\"scanStartedTime\":\"2026-11-06T10:00:00Z\"},\"secretRotationStatus\":[{\"expirePeriodDays\":7,\"lastRotationTime\":\"2026-11-06T10:00:00Z\",\"rotationPeriodDays\":7,\"secretArchiveReference\":{\"keyVaultId\":\"s-keyvaultid\",\"keyVaultUri\":\"s-keyvaulturi\",\"secretName\":\"s-secretname\",\"secretVersion\":\"s-secretversion\"},\"secretType\":\"s-secrettype\"}],\"serialNumber\":\"s-serialnumber\",\"serviceTag\":\"s-servicetag\",\"virtualMachinesAssociatedIds\":[\"s-virtualmachinesassociatedids\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BareMetalMachinesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(BareMetalMachinesClientListBySubscriptionOptions{skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_bare_metal_machines_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_32)
}

fn show_bmc_key_sets_client_create_or_update_response(r: BmcKeySetsClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.bmc_key_set).to_str_lossy()}")
  parts.join(" ")
}

