dentity\":{\"identityType\":\"s-identitytype\",\"userAssignedIdentityResourceId\":\"s-userassignedidentityresourceid\"},\"vaultUri\":\"s-vaulturi\"},\"supportExpiryDate\":\"s-supportexpirydate\",\"updateStrategy\":{\"maxUnavailable\":7,\"strategyType\":\"s-strategytype\",\"thresholdType\":\"s-thresholdtype\",\"thresholdValue\":7,\"waitTimeMinutes\":7},\"vulnerabilityScanningSettings\":{\"containerScan\":\"s-containerscan\"},\"workloadResourceIds\":[\"s-workloadresourceids\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ClustersClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ClustersClientListByResourceGroupOptions{skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_clusters_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_61)
}

fn show_clusters_client_list_by_subscription_response(r: ClustersClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster_list).to_str_lossy()}")
  parts.join(" ")
}

