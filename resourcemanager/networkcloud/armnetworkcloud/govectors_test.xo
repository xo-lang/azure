fn show_kubernetes_clusters_client_list_by_resource_group_response(r: KubernetesClustersClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.kubernetes_cluster_list).to_str_lossy()}")
  parts.join(" ")
}

