      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_racks_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_108)
}

