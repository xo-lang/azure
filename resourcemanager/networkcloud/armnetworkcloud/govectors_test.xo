fn show_clusters_client_list_by_resource_group_response(r: ClustersClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster_list).to_str_lossy()}")
  parts.join(" ")
}

