  gv_note(f, "CALL ClustersClient.BeginScanRuntime")
  match c.begin_scan_runtime("id1/ x", "id2/ x", ClustersClientBeginScanRuntimeOptions{cluster_scan_runtime_parameters: Some((json.decode_str[ClusterScanRuntimeParameters]("{\"scanActivity\":\"s-scanactivity\"}") ?? e => fault("${e}")))}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_clusters_client_scan_runtime_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_57)
}

fn show_clusters_client_update_response(r: ClustersClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster).to_str_lossy()}")
  parts.join(" ")
}

