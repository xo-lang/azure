  let f = gv_new_fake(os.net)
  let c = new_rack_skus_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"computeMachines\":[{\"properties\":{\"bootstrapProtocol\":\"s-bootstrapprotocol\",\"cpuCores\":7,\"cpuSockets\":7,\"generation\":\"s-generation\",\"hardwareVersion\":\"s-hardwareversion\",\"memoryCapacityGB\":7,\"model\":\"s-model\",\"totalThreads\":7,\"vendor\":\"s-vendor\"},\"rackSlot\":7}],\"controllerMachines\":[{\"properties\":{\"bootstrapProtocol\":\"s-bootstrapprotocol\",\"cpuCores\":7,\"cpuSockets\":7,\"generation\":\"s-generation\",\"hardwareVersion\":\"s-hardwareversion\",\"memoryCapacityGB\":7,\"model\":\"s-model\",\"totalThreads\":7,\"vendor\":\"s-vendor\"},\"rackSlot\":7}],\"deploymentType\":\"s-deploymenttype\",\"description\":\"s-description\",\"maxClusterSlots\":7,\"provisioningState\":\"Succeeded\",\"rackType\":\"s-racktype\",\"storageAppliances\":[{\"properties\":{\"capacityGB\":7,\"model\":\"s-model\"},\"rackSlot\":7}],\"supportedRackSkuIds\":[\"s-supportedrackskuids\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RackSKUsClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(RackSKUsClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_rack_sk_us_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_105)
}

