  /// The settings for the log analytics workspace used for output of logs from this cluster.
  pub analytics_output_settings as "analyticsOutputSettings,omitempty": AnalyticsOutputSettings? = None
  /// Field Deprecated. The resource ID of the Log Analytics Workspace that will be used for storing relevant logs.
  pub analytics_workspace_id as "analyticsWorkspaceId,omitempty": Str? = None
  /// The list of cluster runtime version upgrades available for this cluster.
  pub available_upgrade_versions as "availableUpgradeVersions,omitempty": List[ClusterAvailableUpgradeVersion]? = None
  /// The capacity supported by this cluster.
  pub cluster_capacity as "clusterCapacity,omitempty": ClusterCapacity? = None
  /// The latest heartbeat status between the cluster manager and the cluster.
  pub cluster_connection_status as "clusterConnectionStatus,omitempty": ClusterConnectionStatus? = None
  /// The extended location (custom location) that represents the cluster's control plane location. This extended location is used to route the requests of child objects of the cluster that are handled by the platform operator.
  pub cluster_extended_location as "clusterExtendedLocation,omitempty": ExtendedLocation? = None
  /// The customer-provided location information to identify where the cluster resides.
  pub cluster_location as "clusterLocation,omitempty": Str? = None
  /// The latest connectivity status between cluster manager and the cluster.
  pub cluster_manager_connection_status as "clusterManagerConnectionStatus,omitempty": ClusterManagerConnectionStatus? = None
  /// The resource ID of the cluster manager that manages this cluster. This is set by the Cluster Manager when the cluster is created.
  pub cluster_manager_id as "clusterManagerId,omitempty": Str? = None
  /// Field Deprecated: Use managed identity to provide cluster privileges. The service principal to be used by the cluster during Arc Appliance installation.
  pub cluster_service_principal as "clusterServicePrincipal,omitempty": ServicePrincipalInformation? = None
  /// The type of rack configuration for the cluster.
  pub cluster_type as "clusterType,omitempty": ClusterType? = None
  /// The current runtime version of the cluster.
  pub cluster_version as "clusterVersion,omitempty": Str? = None
  /// The settings for commands run in this cluster, such as bare metal machine run read only commands and data extracts.
  pub command_output_settings as "commandOutputSettings,omitempty": CommandOutputSettings? = None
  /// The validation threshold indicating the allowable failures of compute machines during environment validation and deployment.
  pub compute_deployment_threshold as "computeDeploymentThreshold,omitempty": ValidationThreshold? = None
  /// The list of rack definitions for the compute racks in a multi-rack cluster, or an empty list in a single-rack cluster.
  pub compute_rack_definitions as "computeRackDefinitions,omitempty": List[RackDefinition]? = None
  /// The current detailed status of the cluster.
  pub detailed_status as "detailedStatus,omitempty": ClusterDetailedStatus? = None
  /// The descriptive message about the detailed status.
  pub detailed_status_message as "detailedStatusMessage,omitempty": Str? = None
  /// Field Deprecated. This field will not be populated in an upcoming version. The extended location (custom location) that represents the Hybrid AKS control plane location. This extended location is used when creating provisioned clusters (Hybrid AKS clusters).
  pub hybrid_aks_extended_location as "hybridAksExtendedLocation,omitempty": ExtendedLocation? = None
  /// The date and time of the end of the last successful version update for the cluster.
  pub last_successful_version_update_time as "lastSuccessfulVersionUpdateTime,omitempty": azcore.DateTimeUTC? = None
  /// The list of credentials that are managed for the cluster and can be rotated on-demand.
  pub managed_credentials as "managedCredentials,omitempty": List[Str]? = None
  /// The configuration of the managed resource group associated with the resource.
  pub managed_resource_group_configuration as "managedResourceGroupConfiguration,omitempty": ManagedResourceGroupConfiguration? = None
  /// The count of Manual Action Taken (MAT) events that have not been validated.
  pub manual_action_count as "manualActionCount,omitempty": Int? = None
  /// The resource ID of the Network Fabric associated with the cluster.
  pub network_fabric_id as "networkFabricId,omitempty": Str? = None
  /// The provisioning state of the cluster.
  pub provisioning_state as "provisioningState,omitempty": ClusterProvisioningState? = None
  /// The settings for cluster runtime protection.
  pub runtime_protection_configuration as "runtimeProtectionConfiguration,omitempty": RuntimeProtectionConfiguration? = None
  /// The configuration for use of a key vault to store secrets for later retrieval by the operator.
  pub secret_archive as "secretArchive,omitempty": ClusterSecretArchive? = None
  /// The settings for the secret archive used to hold credentials for the cluster.
  pub secret_archive_settings as "secretArchiveSettings,omitempty": SecretArchiveSettings? = None
  /// The support end date of the runtime version of the cluster.
  pub support_expiry_date as "supportExpiryDate,omitempty": Str? = None
  /// The strategy for updating the cluster.
  pub update_strategy as "updateStrategy,omitempty": ClusterUpdateStrategy? = None
  /// The settings for how security vulnerability scanning is applied to the cluster.
  pub vulnerability_scanning_settings as "vulnerabilityScanningSettings,omitempty": VulnerabilityScanningSettings? = None
  /// The list of workload resource IDs that are hosted within this cluster.
  pub workload_resource_ids as "workloadResourceIds,omitempty": List[Str]? = None
} derive Json

