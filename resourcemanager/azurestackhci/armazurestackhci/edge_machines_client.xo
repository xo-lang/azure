/// A long-running resource action to validate the edge machine.
pub fn (c: EdgeMachinesClient[fx]) begin_validate(resource_group_name: Str, edge_machine_name: Str, body: EdgeMachineValidateRequest, options: EdgeMachinesClientBeginValidateOptions = EdgeMachinesClientBeginValidateOptions{}) -> runtime.Poller[EdgeMachinesClientValidateResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "EdgeMachinesClientValidateResponse", fn(r: http.Response) -> EdgeMachinesClientValidateResponse ! Str { edge_machines_validate_handle(r) })
  }
  let req = c.validate_create_request(resource_group_name, edge_machine_name, body, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "", "EdgeMachinesClientValidateResponse", fn(r: http.Response) -> EdgeMachinesClientValidateResponse ! Str { edge_machines_validate_handle(r) })
}
