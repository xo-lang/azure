    Some(json.Value.Str("ApplyConfiguration")) => Ok(EdgeMachineNetworkAdapterJobPropertiesClassification.ApplyConfigurationNetworkAdapterJobProperties(json.from_value[ApplyConfigurationNetworkAdapterJobProperties](v)?))
    Some(json.Value.Str("ForcePush")) => Ok(EdgeMachineNetworkAdapterJobPropertiesClassification.ForcePushNetworkAdapterJobProperties(json.from_value[ForcePushNetworkAdapterJobProperties](v)?))
    Some(json.Value.Str("SyncConfiguration")) => Ok(EdgeMachineNetworkAdapterJobPropertiesClassification.SyncConfigurationNetworkAdapterJobProperties(json.from_value[SyncConfigurationNetworkAdapterJobProperties](v)?))
    _ => Ok(EdgeMachineNetworkAdapterJobPropertiesClassification.EdgeMachineNetworkAdapterJobProperties(json.from_value[EdgeMachineNetworkAdapterJobProperties](v)?))
  }
}

/// `v` with its discriminator `key` set to `value`, as Go's
/// MarshalJSON writes a subtype's (its keys sorted).
fn with_discriminator(v: json.Value, key: Str, value: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object((fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != key }) + [(key, json.Value.Str(value))]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    other => other
  }
}

