test "Go's ValidatedSolutionRecipesClient.NewListBySubscriptionLocationResourcePager" {
  let f = gv_new_fake(os.net)
  let c = new_validated_solution_recipes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"recipeContent\":{\"capabilities\":{},\"components\":[{\"installOrder\":7,\"name\":\"s-name\",\"requiredVersion\":\"s-requiredversion\",\"type\":\"s-type\"}],\"info\":{\"solutionType\":\"s-solutiontype\",\"version\":\"s-version\"}},\"signature\":\"s-signature\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ValidatedSolutionRecipesClient.NewListBySubscriptionLocationResourcePager")
  var pg = c.new_list_by_subscription_location_resource_pager("id1/ x", ValidatedSolutionRecipesClientListBySubscriptionLocationResourceOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
