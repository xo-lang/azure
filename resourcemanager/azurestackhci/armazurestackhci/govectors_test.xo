test "Go's ClusterJobsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_cluster_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"addServerJobServerDetails\":[{\"hostIpv4Address\":\"s-hostipv4address\",\"localAvailabilityZoneName\":\"s-localavailabilityzonename\",\"serverName\":\"s-servername\",\"serverResourceId\":\"s-serverresourceid\"}],\"deploymentMode\":\"s-deploymentmode\",\"endTimeUtc\":\"2026-11-06T10:00:00Z\",\"jobId\":\"s-jobid\",\"jobType\":\"AddServer\",\"provisioningState\":\"Succeeded\",\"reportedProperties\":{\"deploymentStatus\":{\"status\":\"s-status\"},\"percentComplete\":7,\"validationStatus\":{\"status\":\"s-status\"}},\"secrets\":[{\"eceSecretName\":\"s-ecesecretname\",\"secretLocation\":\"s-secretlocation\",\"secretName\":\"s-secretname\"}],\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ClusterJobsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ClusterJobsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_cluster_jobs_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_13)
}

