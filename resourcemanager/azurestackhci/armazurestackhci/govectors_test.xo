s-workloadtype\"}],\"workloadInventoryLastUpdated\":\"2026-11-06T10:00:00Z\"},\"siteDetails\":{\"deviceConfiguration\":{\"hostName\":\"s-hostname\",\"network\":{},\"storage\":{\"partitionSize\":\"s-partitionsize\"},\"time\":{\"primaryTimeServer\":\"s-primarytimeserver\",\"secondaryTimeServer\":\"s-secondarytimeserver\",\"timeZone\":\"s-timezone\"},\"webProxy\":{\"connectionUri\":\"s-connectionuri\",\"port\":\"s-port\"}},\"siteResourceId\":\"s-siteresourceid\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EdgeMachinesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(EdgeMachinesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_edge_machines_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_81)
}

fn show_extensions_client_create_response(r: ExtensionsClientCreateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.extension).to_str_lossy()}")
  parts.join(" ")
}

