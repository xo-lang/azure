  let f = gv_new_fake(os.net)
  let c = new_edge_devices_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"kind\":\"HCI\",\"name\":\"s-name\",\"properties\":{\"deviceConfiguration\":{\"deviceMetadata\":\"s-devicemetadata\"},\"provisioningState\":\"Succeeded\",\"reportedProperties\":{\"deviceState\":\"s-devicestate\",\"extensionProfile\":{},\"hardwareProfile\":{\"processorType\":\"s-processortype\"},\"lastSyncTimestamp\":\"2026-11-06T10:00:00Z\",\"networkProfile\":{},\"osProfile\":{\"assemblyVersion\":\"s-assemblyversion\",\"bootType\":\"s-boottype\"},\"sbeDeploymentPackageInfo\":{\"code\":\"s-code\",\"message\":\"s-message\",\"sbeManifest\":\"s-sbemanifest\"},\"storageProfile\":{\"poolableDisksCount\":7}}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EdgeDevicesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", EdgeDevicesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_edge_devices_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_38)
}

