test "Go's EdgeMachineDisksClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_edge_machine_disks_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"diskConfiguration\":{\"volumes\":[{\"fileSystem\":\"s-filesystem\",\"path\":\"s-path\",\"sizeInBytes\":\"s-sizeinbytes\"}]},\"provisioningState\":\"Succeeded\",\"reportedProperties\":{\"busLocation\":\"s-buslocation\",\"diskName\":\"s-diskname\",\"diskType\":\"s-disktype\",\"firmwareVersion\":\"s-firmwareversion\",\"isSupported\":true,\"manufacturer\":\"s-manufacturer\",\"model\":\"s-model\",\"serialNumber\":\"s-serialnumber\",\"sizeInBytes\":\"s-sizeinbytes\",\"state\":\"s-state\",\"storageType\":\"s-storagetype\",\"unallocatedSizeInBytes\":\"s-unallocatedsizeinbytes\",\"volumes\":[{\"fileSystem\":\"s-filesystem\",\"isBoot\":true,\"name\":\"s-name\",\"offsetInBytes\":7,\"partitionId\":\"s-partitionid\",\"partitionNumber\":7,\"path\":\"s-path\",\"resourceName\":\"s-resourcename\",\"sizeInBytes\":\"s-sizeinbytes\",\"sizeRemainingInBytes\":\"s-sizeremaininginbytes\"}]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EdgeMachineDisksClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", EdgeMachineDisksClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_edge_machine_disks_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_54)
}

