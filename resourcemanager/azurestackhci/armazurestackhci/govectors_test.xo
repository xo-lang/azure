test "Go's EdgeMachineVolumesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_edge_machine_volumes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\",\"reportedProperties\":{\"fileSystem\":\"s-filesystem\",\"isBoot\":true,\"name\":\"s-name\",\"offsetInBytes\":7,\"parentDiskId\":\"s-parentdiskid\",\"partitionId\":\"s-partitionid\",\"path\":\"s-path\",\"sizeInBytes\":\"s-sizeinbytes\",\"sizeRemainingInBytes\":\"s-sizeremaininginbytes\"},\"volumeConfiguration\":{\"reserved\":\"s-reserved\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EdgeMachineVolumesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", EdgeMachineVolumesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_edge_machine_volumes_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_72)
}

