fn show_deployment_settings_client_create_or_update_response(r: DeploymentSettingsClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.deployment_setting).to_str_lossy()}")
  parts.join(" ")
}

