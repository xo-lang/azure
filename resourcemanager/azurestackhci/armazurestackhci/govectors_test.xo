fn show_clusters_client_list_by_subscription_response(r: ClustersClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster_list).to_str_lossy()}")
  parts.join(" ")
}

