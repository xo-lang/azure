fn show_edge_machines_client_list_by_resource_group_response(r: EdgeMachinesClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.edge_machine_list_result).to_str_lossy()}")
  parts.join(" ")
}

