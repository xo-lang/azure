  match c.begin_extend_software_assurance_benefit("id1/ x", "id2/ x", (json.decode_str[SoftwareAssuranceChangeRequest]("{\"properties\":{\"softwareAssuranceIntent\":\"s-softwareassuranceintent\"}}") ?? e => fault("${e}")), ClustersClientBeginExtendSoftwareAssuranceBenefitOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_clusters_client_extend_software_assurance_benefit_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_17)
}

fn show_clusters_client_trigger_log_collection_response(r: ClustersClientTriggerLogCollectionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster).to_str_lossy()}")
  parts.join(" ")
}

