ies\"]},\"resourceProviderObjectId\":\"s-resourceproviderobjectid\",\"sdnProperties\":{\"sdnApiAddress\":\"s-sdnapiaddress\",\"sdnDomainName\":\"s-sdndomainname\",\"sdnIntegrationIntent\":\"s-sdnintegrationintent\",\"sdnStatus\":\"s-sdnstatus\"},\"secretsLocations\":[{\"secretsLocation\":\"s-secretslocation\",\"secretsType\":\"s-secretstype\"}],\"serviceEndpoint\":\"s-serviceendpoint\",\"softwareAssuranceProperties\":{\"lastUpdated\":\"2026-11-06T10:00:00Z\",\"softwareAssuranceIntent\":\"s-softwareassuranceintent\",\"softwareAssuranceStatus\":\"s-softwareassurancestatus\"},\"status\":\"s-status\",\"storageType\":\"s-storagetype\",\"trialDaysRemaining\":1.5},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ClustersClient.BeginTriggerLogCollection")
  match c.begin_trigger_log_collection("id1/ x", "id2/ x", (json.decode_str[LogCollectionRequest]("{\"properties\":{\"fromDate\":\"2026-11-06T10:00:00Z\",\"toDate\":\"2026-11-06T10:00:00Z\"}}") ?? e => fault("${e}")), ClustersClientBeginTriggerLogCollectionOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_clusters_client_trigger_log_collection_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_18)
}

fn show_clusters_client_update_secrets_locations_response(r: ClustersClientUpdateSecretsLocationsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster).to_str_lossy()}")
  parts.join(" ")
}

