esourceProviderObjectId\":\"s-resourceproviderobjectid\",\"sdnProperties\":{\"sdnApiAddress\":\"s-sdnapiaddress\",\"sdnDomainName\":\"s-sdndomainname\",\"sdnIntegrationIntent\":\"s-sdnintegrationintent\",\"sdnStatus\":\"s-sdnstatus\"},\"secretsLocations\":[{\"secretsLocation\":\"s-secretslocation\",\"secretsType\":\"s-secretstype\"}],\"serviceEndpoint\":\"s-serviceendpoint\",\"softwareAssuranceProperties\":{\"lastUpdated\":\"2026-11-06T10:00:00Z\",\"softwareAssuranceIntent\":\"s-softwareassuranceintent\",\"softwareAssuranceStatus\":\"s-softwareassurancestatus\"},\"status\":\"s-status\",\"storageType\":\"s-storagetype\",\"trialDaysRemaining\":1.5},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ClustersClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(ClustersClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_clusters_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_24)
}

fn show_clusters_client_update_response(r: ClustersClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster).to_str_lossy()}")
  parts.join(" ")
}

