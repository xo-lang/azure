test "Go's ArcSettingsClient.NewListByClusterPager" {
  let f = gv_new_fake(os.net)
  let c = new_arc_settings_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"aggregateState\":\"s-aggregatestate\",\"arcApplicationClientId\":\"s-arcapplicationclientid\",\"arcApplicationObjectId\":\"s-arcapplicationobjectid\",\"arcApplicationTenantId\":\"s-arcapplicationtenantid\",\"arcInstanceResourceGroup\":\"s-arcinstanceresourcegroup\",\"arcServicePrincipalObjectId\":\"s-arcserviceprincipalobjectid\",\"connectivityProperties\":{\"enabled\":true,\"serviceConfigurations\":[{\"port\":7,\"serviceName\":\"s-servicename\"}]},\"defaultExtensions\":[{\"category\":\"s-category\",\"consentTime\":\"2026-11-06T10:00:00Z\"}],\"perNodeDetails\":[{\"arcInstance\":\"s-arcinstance\",\"arcNodeServicePrincipalObjectId\":\"s-arcnodeserviceprincipalobjectid\",\"name\":\"s-name\",\"state\":\"s-state\"}],\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ArcSettingsClient.NewListByClusterPager")
  var pg = c.new_list_by_cluster_pager("id1/ x", "id2/ x", ArcSettingsClientListByClusterOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_arc_settings_client_list_by_cluster_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_8)
}

