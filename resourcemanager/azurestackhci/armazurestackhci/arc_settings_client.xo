fn (c: ArcSettingsClient) reconcile_create_request(resource_group_name: Str, cluster_name: Str, arc_setting_name: Str, reconcile_arc_settings_request: ReconcileArcSettingsRequest, options: ArcSettingsClientBeginReconcileOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.AzureStackHCI/clusters/{clusterName}/arcSettings/{arcSettingName}/reconcile"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if cluster_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter clusterName cannot be empty"))
  }
  path = path.replace("{clusterName}", url.path_escape(cluster_name))
  if arc_setting_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter arcSettingName cannot be empty"))
  }
  path = path.replace("{arcSettingName}", url.path_escape(arc_setting_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: runtime.marshal_json(reconcile_arc_settings_request)})
}

