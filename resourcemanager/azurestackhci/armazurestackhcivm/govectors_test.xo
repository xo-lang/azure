-securitytype\",\"uefiSettings\":{\"secureBootEnabled\":true}},\"status\":{\"errorCode\":\"s-errorcode\",\"errorMessage\":\"s-errormessage\",\"powerState\":\"s-powerstate\",\"provisioningStatus\":{\"operationId\":\"s-operationid\",\"status\":\"s-status\"}},\"storageProfile\":{\"dataDisks\":[{\"id\":\"s-id\"}],\"imageReference\":{\"id\":\"s-id\"},\"osDisk\":{\"id\":\"s-id\",\"managedDisk\":{},\"osType\":\"s-ostype\"},\"vmConfigStoragePathId\":\"s-vmconfigstoragepathid\"},\"vmId\":\"s-vmid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualMachineInstancesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", VirtualMachineInstancesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
