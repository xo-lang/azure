    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_machine_instances_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
