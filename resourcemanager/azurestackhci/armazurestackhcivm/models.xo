/// Identity for the resource.
pub struct Identity {
  /// The principal ID of resource identity. The value must be an UUID.
  pub principal_id as "principalId,omitempty": Str? = None
  /// The tenant ID of resource. The value must be an UUID.
  pub tenant_id as "tenantId,omitempty": Str? = None
  /// The identity type.
  pub type_ as "type,omitempty": Str? = None
} derive Json(via: json.Value, to: identity_json, from: parse_identity)

/// Identity's named fields, for its JSON.
struct IdentityKnown {
  principal_id as "principalId,omitempty": Str? = None
  tenant_id as "tenantId,omitempty": Str? = None
  type_ as "type,omitempty": Str? = None
} derive Json

fn identity_json(x: Identity) -> json.Value {
  let known = IdentityKnown{
    principal_id: x.principal_id,
    tenant_id: x.tenant_id,
    type_: x.type_.map(fn(_: Str) -> Str { "SystemAssigned" }),
  }
  json.to_value(known)
}

fn parse_identity(v: json.Value) -> Identity ! json.DecodeErr {
  let k = json.from_value[IdentityKnown](v)?
  Ok(Identity{
    principal_id: k.principal_id,
    tenant_id: k.tenant_id,
    type_: k.type_,
  })
}

