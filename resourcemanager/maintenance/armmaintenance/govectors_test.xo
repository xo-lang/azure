  "OUT page 1: body={\"value\":[{\"impactDurationInSec\":7,\"impactType\":\"s-impacttype\",\"maintenanceScope\":\"s-maintenancescope\",\"notBefore\":\"2026-11-06T10:00:00Z\",\"properties\":{\"resourceId\":\"s-resourceid\"},\"status\":\"s-status\"}]}",
  "OUT page 2: no more",
]

test "Go's UpdatesClient.NewListParentPager" {
  let f = gv_new_fake(os.net)
  let c = new_updates_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"value\":[{\"impactDurationInSec\":7,\"impactType\":\"s-impacttype\",\"maintenanceScope\":\"s-maintenancescope\",\"notBefore\":\"2026-11-06T10:00:00Z\",\"properties\":{\"resourceId\":\"s-resourceid\"},\"status\":\"s-status\"}]}")
  gv_note(f, "CALL UpdatesClient.NewListParentPager")
  var pg = c.new_list_parent_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", "id5/ x", "id6/ x", UpdatesClientListParentOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_updates_client_list_parent_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_33)
}
