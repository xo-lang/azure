test "Go's ConfigurationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_configurations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"extensionProperties\":{\"k1\":\"s-extensionproperties\"},\"installPatches\":{\"linuxParameters\":{\"classificationsToInclude\":[\"s-classificationstoinclude\"],\"packageNameMasksToExclude\":[\"s-packagenamemaskstoexclude\"],\"packageNameMasksToInclude\":[\"s-packagenamemaskstoinclude\"]},\"rebootSetting\":\"s-rebootsetting\",\"windowsParameters\":{\"classificationsToInclude\":[\"s-classificationstoinclude\"],\"excludeKbsRequiringReboot\":true,\"kbNumbersToExclude\":[\"s-kbnumberstoexclude\"],\"kbNumbersToInclude\":[\"s-kbnumberstoinclude\"]}},\"maintenanceScope\":\"s-maintenancescope\",\"maintenanceWindow\":{\"duration\":\"s-duration\",\"expirationDateTime\":\"s-expirationdatetime\",\"recurEvery\":\"s-recurevery\",\"startDateTime\":\"s-startdatetime\",\"timeZone\":\"s-timezone\"},\"namespace\":\"s-namespace\",\"visibility\":\"s-visibility\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ConfigurationsClient.NewListPager")
  var pg = c.new_list_pager(ConfigurationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_configurations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_26)
}

