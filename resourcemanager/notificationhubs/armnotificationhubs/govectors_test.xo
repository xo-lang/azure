  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"admCredential\":{\"properties\":{\"authTokenUrl\":\"s-authtokenurl\",\"clientId\":\"s-clientid\",\"clientSecret\":\"s-clientsecret\"}},\"apnsCredential\":{\"properties\":{\"apnsCertificate\":\"s-apnscertificate\",\"appId\":\"s-appid\",\"appName\":\"s-appname\",\"certificateKey\":\"s-certificatekey\",\"endpoint\":\"s-endpoint\",\"keyId\":\"s-keyid\",\"thumbprint\":\"s-thumbprint\",\"token\":\"s-token\"}},\"authorizationRules\":[{\"claimType\":\"s-claimtype\",\"claimValue\":\"s-claimvalue\",\"createdTime\":\"s-createdtime\",\"keyName\":\"s-keyname\",\"modifiedTime\":\"s-modifiedtime\",\"primaryKey\":\"s-primarykey\",\"revision\":7,\"rights\":[\"s-rights\"],\"secondaryKey\":\"s-secondarykey\"}],\"baiduCredential\":{\"properties\":{\"baiduApiKey\":\"s-baiduapikey\",\"baiduEndPoint\":\"s-baiduendpoint\",\"baiduSecretKey\":\"s-baidusecretkey\"}},\"gcmCredential\":{\"properties\":{\"gcmEndpoint\":\"s-gcmendpoint\",\"googleApiKey\":\"s-googleapikey\"}},\"mpnsCredential\":{\"properties\":{\"certificateKey\":\"s-certificatekey\",\"mpnsCertificate\":\"s-mpnscertificate\",\"thumbprint\":\"s-thumbprint\"}},\"name\":\"s-name\",\"registrationTtl\":\"s-registrationttl\",\"wnsCredential\":{\"properties\":{\"packageSid\":\"s-packagesid\",\"secretKey\":\"s-secretkey\",\"windowsLiveEndpoint\":\"s-windowsliveendpoint\"}}},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Client.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_11)
}

