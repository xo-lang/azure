  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"claimType\":\"s-claimtype\",\"claimValue\":\"s-claimvalue\",\"createdTime\":\"s-createdtime\",\"keyName\":\"s-keyname\",\"modifiedTime\":\"s-modifiedtime\",\"primaryKey\":\"s-primarykey\",\"revision\":7,\"rights\":[\"s-rights\"],\"secondaryKey\":\"s-secondarykey\"},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
