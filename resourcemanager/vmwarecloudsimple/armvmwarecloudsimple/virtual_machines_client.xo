  if ![200, 202].contains(resp.status) {
    return Err(sp.fail(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  sp.end()
  runtime.new_poller(c.setup.pipeline, req, resp, "", "VirtualMachinesClientStopResponse", fn(r: http.Response) -> VirtualMachinesClientStopResponse ! Str { virtual_machines_stop_handle(r) }, traced: true)
}
