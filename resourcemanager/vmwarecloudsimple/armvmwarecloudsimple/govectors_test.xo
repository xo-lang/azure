  let f = gv_new_fake(os.net)
  let c = new_virtual_machines_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"amountOfRam\":7,\"controllers\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"subType\":\"s-subtype\",\"type\":\"s-type\"}],\"customization\":{\"dnsServers\":[\"s-dnsservers\"],\"hostName\":\"s-hostname\",\"password\":\"s-password\",\"policyId\":\"s-policyid\",\"username\":\"s-username\"},\"disks\":[{\"controllerId\":\"s-controllerid\",\"independenceMode\":\"s-independencemode\",\"totalSize\":7,\"virtualDiskId\":\"s-virtualdiskid\",\"virtualDiskName\":\"s-virtualdiskname\"}],\"dnsname\":\"s-dnsname\",\"exposeToGuestVM\":true,\"folder\":\"s-folder\",\"guestOS\":\"s-guestos\",\"guestOSType\":\"s-guestostype\",\"nics\":[{\"customization\":{\"allocation\":\"s-allocation\",\"ipAddress\":\"s-ipaddress\",\"mask\":\"s-mask\",\"primaryWinsServer\":\"s-primarywinsserver\",\"secondaryWinsServer\":\"s-secondarywinsserver\"},\"ipAddresses\":[\"s-ipaddresses\"],\"macAddress\":\"s-macaddress\",\"network\":{\"assignable\":true,\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"type\":\"s-type\"},\"nicType\":\"s-nictype\",\"powerOnBoot\":true,\"virtualNicId\":\"s-virtualnicid\",\"virtualNicName\":\"s-virtualnicname\"}],\"numberOfCores\":7,\"password\":\"s-password\",\"privateCloudId\":\"s-privatecloudid\",\"provisioningState\":\"Succeeded\",\"publicIP\":\"s-publicip\",\"resourcePool\":{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"privateCloudId\":\"s-privatecloudid\",\"properties\":{\"fullName\":\"s-fullname\"},\"type\":\"s-type\"},\"status\":\"s-status\",\"templateId\":\"s-templateid\",\"username\":\"s-username\",\"vSphereNetworks\":[\"s-vspherenetworks\"],\"vmId\":\"s-vmid\",\"vmwaretools\":\"s-vmwaretools\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualMachinesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", VirtualMachinesClientListByResourceGroupOptions{filter: Some("s-filter"), skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_machines_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_30)
}

