test "Go's VirtualMachineTemplatesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_virtual_machine_templates_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"amountOfRam\":7,\"controllers\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"subType\":\"s-subtype\",\"type\":\"s-type\"}],\"description\":\"s-description\",\"disks\":[{\"controllerId\":\"s-controllerid\",\"independenceMode\":\"s-independencemode\",\"totalSize\":7,\"virtualDiskId\":\"s-virtualdiskid\",\"virtualDiskName\":\"s-virtualdiskname\"}],\"exposeToGuestVM\":true,\"guestOS\":\"s-guestos\",\"guestOSType\":\"s-guestostype\",\"nics\":[{\"customization\":{\"allocation\":\"s-allocation\",\"ipAddress\":\"s-ipaddress\",\"mask\":\"s-mask\",\"primaryWinsServer\":\"s-primarywinsserver\",\"secondaryWinsServer\":\"s-secondarywinsserver\"},\"ipAddresses\":[\"s-ipaddresses\"],\"macAddress\":\"s-macaddress\",\"network\":{\"assignable\":true,\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"type\":\"s-type\"},\"nicType\":\"s-nictype\",\"powerOnBoot\":true,\"virtualNicId\":\"s-virtualnicid\",\"virtualNicName\":\"s-virtualnicname\"}],\"numberOfCores\":7,\"path\":\"s-path\",\"privateCloudId\":\"s-privatecloudid\",\"vSphereNetworks\":[\"s-vspherenetworks\"],\"vSphereTags\":[\"s-vspheretags\"],\"vmwaretools\":\"s-vmwaretools\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VirtualMachineTemplatesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", VirtualMachineTemplatesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_virtual_machine_templates_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_23)
}

