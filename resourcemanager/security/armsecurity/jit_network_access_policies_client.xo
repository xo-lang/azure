  let req = sp.on(c.initiate_create_request(resource_group_name, asc_location, jit_network_access_policy_name, body, options) ?? e => return Err(sp.fail(e)))
  let resp = c.setup.pipeline.send(req) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![202].contains(resp.status) {
    return Err(sp.fail(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  let out = jit_network_access_policies_initiate_handle(resp) ?? e => return Err(sp.fail(azcore.CallErr.Decode(e)))
  sp.end()
  Ok(out)
}
