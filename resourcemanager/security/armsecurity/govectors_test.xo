  var pg = c.new_list_pager("id1/ x", "id2/ x", SQLVulnerabilityAssessmentScanResultsClientListOptions{database_name: Some("s-databasename")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_sql_vulnerability_assessment_scan_results_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_208)
}

