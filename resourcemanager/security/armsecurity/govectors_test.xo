test "Go's GovernanceRulesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_governance_rules_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"conditionSets\":[{\"k\":\"v\"}],\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"excludedScopes\":[\"s-excludedscopes\"],\"governanceEmailNotification\":{\"disableManagerEmailNotification\":true,\"disableOwnerEmailNotification\":true},\"includeMemberScopes\":true,\"isDisabled\":true,\"isGracePeriod\":true,\"metadata\":{\"createdBy\":\"s-createdby\",\"createdOn\":\"2026-11-06T10:00:00Z\",\"updatedBy\":\"s-updatedby\",\"updatedOn\":\"2026-11-06T10:00:00Z\"},\"ownerSource\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"remediationTimeframe\":\"s-remediationtimeframe\",\"rulePriority\":7,\"ruleType\":\"s-ruletype\",\"sourceResourceType\":\"s-sourceresourcetype\",\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL GovernanceRulesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", GovernanceRulesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_governance_rules_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_140)
}

