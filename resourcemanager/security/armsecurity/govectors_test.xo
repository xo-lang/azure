test "Go's HealthReportsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_health_reports_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"affectedDefendersPlans\":[\"s-affecteddefendersplans\"],\"affectedDefendersSubPlans\":[\"s-affecteddefenderssubplans\"],\"environmentDetails\":{\"environmentHierarchyId\":\"s-environmenthierarchyid\",\"nativeResourceId\":\"s-nativeresourceid\",\"organizationalHierarchyId\":\"s-organizationalhierarchyid\",\"subscriptionId\":\"s-subscriptionid\",\"tenantId\":\"s-tenantid\"},\"healthDataClassification\":{\"component\":\"s-component\",\"scenario\":\"s-scenario\",\"scope\":\"s-scope\"},\"issues\":[{\"issueAdditionalData\":{\"k1\":\"s-issueadditionaldata\"},\"issueDescription\":\"s-issuedescription\",\"issueKey\":\"s-issuekey\",\"issueName\":\"s-issuename\",\"remediationScript\":\"s-remediationscript\",\"remediationSteps\":\"s-remediationsteps\",\"securityValues\":[\"s-securityvalues\"]}],\"reportAdditionalData\":{\"k1\":\"s-reportadditionaldata\"},\"resourceDetails\":{\"connectorId\":\"s-connectorid\",\"id\":\"s-id\",\"source\":\"s-source\"},\"status\":{\"code\":\"s-code\",\"firstEvaluationDate\":\"2026-11-06T10:00:00Z\",\"lastScannedDate\":\"2026-11-06T10:00:00Z\",\"reason\":\"s-reason\",\"statusChangeDate\":\"2026-11-06T10:00:00Z\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL HealthReportsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", HealthReportsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_health_reports_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_143)
}

