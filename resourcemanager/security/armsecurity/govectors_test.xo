  let c = new_assessments_metadata_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"assessmentType\":\"s-assessmenttype\",\"categories\":[\"s-categories\"],\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"implementationEffort\":\"s-implementationeffort\",\"partnerData\":{\"partnerName\":\"s-partnername\",\"productName\":\"s-productname\",\"secret\":\"s-secret\"},\"plannedDeprecationDate\":\"s-planneddeprecationdate\",\"policyDefinitionId\":\"s-policydefinitionid\",\"preview\":true,\"publishDates\":{\"GA\":\"s-ga\",\"public\":\"s-public\"},\"remediationDescription\":\"s-remediationdescription\",\"severity\":\"s-severity\",\"tactics\":[\"s-tactics\"],\"techniques\":[\"s-techniques\"],\"threats\":[\"s-threats\"],\"userImpact\":\"s-userimpact\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
