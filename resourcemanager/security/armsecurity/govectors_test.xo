  "  SERVED 200 {\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"scope\":\"s-scope\",\"workspaceId\":\"s-workspaceid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}",
  "OUT: body={\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"scope\":\"s-scope\",\"workspaceId\":\"s-workspaceid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}",
]

test "Go's WorkspaceSettingsClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_workspace_settings_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"scope\":\"s-scope\",\"workspaceId\":\"s-workspaceid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL WorkspaceSettingsClient.Update")
  match c.update("id1/ x", (json.decode_str[WorkspaceSetting]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"scope\":\"s-scope\",\"workspaceId\":\"s-workspaceid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), WorkspaceSettingsClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_workspace_settings_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_266)
}
