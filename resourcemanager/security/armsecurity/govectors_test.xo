  let c = new_api_collections_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"baseUrl\":\"s-baseurl\",\"discoveredVia\":\"s-discoveredvia\",\"displayName\":\"s-displayname\",\"numberOfApiEndpoints\":7,\"numberOfApiEndpointsWithSensitiveDataExposed\":7,\"numberOfExternalApiEndpoints\":7,\"numberOfInactiveApiEndpoints\":7,\"numberOfUnauthenticatedApiEndpoints\":7,\"provisioningState\":\"Succeeded\",\"sensitivityLabel\":\"s-sensitivitylabel\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL APICollectionsClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(APICollectionsClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_api_collections_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_4)
}

