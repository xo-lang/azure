  let c = new_defender_for_storage_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"isEnabled\":true,\"malwareScanning\":{\"automatedResponse\":\"s-automatedresponse\",\"blobScanResultsOptions\":\"s-blobscanresultsoptions\",\"onUpload\":{\"capGBPerMonth\":7,\"filters\":{\"excludeBlobsLargerThan\":{\"k\":\"v\"}},\"isEnabled\":true},\"operationStatus\":{\"code\":\"s-code\",\"message\":\"s-message\"},\"scanResultsEventGridTopicResourceId\":\"s-scanresultseventgridtopicresourceid\"},\"overrideSubscriptionLevelSettings\":true,\"sensitiveDataDiscovery\":{\"isEnabled\":true,\"operationStatus\":{\"code\":\"s-code\",\"message\":\"s-message\"}}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DefenderForStorageClient.NewListPager")
