test "Go's DevOpsConfigurationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_dev_ops_configurations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"agentlessConfiguration\":{\"agentlessAutoDiscovery\":\"s-agentlessautodiscovery\",\"agentlessEnabled\":\"s-agentlessenabled\",\"inventoryList\":[{\"inventoryKind\":\"s-inventorykind\",\"value\":\"s-value\"}],\"inventoryListType\":\"s-inventorylisttype\",\"scanners\":[\"s-scanners\"]},\"authorization\":{\"code\":\"s-code\"},\"autoDiscovery\":\"s-autodiscovery\",\"capabilities\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"provisioningState\":\"Succeeded\",\"provisioningStatusMessage\":\"s-provisioningstatusmessage\",\"provisioningStatusUpdateTimeUtc\":\"2026-11-06T10:00:00Z\",\"topLevelInventoryList\":[\"s-toplevelinventorylist\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DevOpsConfigurationsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", DevOpsConfigurationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_dev_ops_configurations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_108)
}

