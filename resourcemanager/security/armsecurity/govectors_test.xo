test "Go's CustomRecommendationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_custom_recommendations_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"assessmentKey\":\"s-assessmentkey\",\"cloudProviders\":[\"s-cloudproviders\"],\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"query\":\"s-query\",\"remediationDescription\":\"s-remediationdescription\",\"securityIssue\":\"s-securityissue\",\"severity\":\"s-severity\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL CustomRecommendationsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", CustomRecommendationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_custom_recommendations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_97)
}

