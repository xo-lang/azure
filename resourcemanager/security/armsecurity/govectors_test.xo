test "Go's DeviceSecurityGroupsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_device_security_groups_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"allowlistRules\":[{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isEnabled\":true,\"ruleType\":\"ConnectionFromIpNotAllowed\",\"valueType\":\"s-valuetype\"}],\"denylistRules\":[{\"denylistValues\":[\"s-denylistvalues\"],\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isEnabled\":true,\"ruleType\":\"DenylistCustomAlertRule\",\"valueType\":\"s-valuetype\"}],\"thresholdRules\":[{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isEnabled\":true,\"maxThreshold\":7,\"minThreshold\":7,\"ruleType\":\"ActiveConnectionsNotInAllowedRange\",\"timeWindowSize\":\"s-timewindowsize\"}],\"timeWindowRules\":[{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isEnabled\":true,\"maxThreshold\":7,\"minThreshold\":7,\"ruleType\":\"ActiveConnectionsNotInAllowedRange\",\"timeWindowSize\":\"s-timewindowsize\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DeviceSecurityGroupsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", DeviceSecurityGroupsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_device_security_groups_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_113)
}

