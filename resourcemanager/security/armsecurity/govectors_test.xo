  let f = gv_new_fake(os.net)
  let c = new_standard_assignments_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"assignedStandard\":{\"id\":\"s-id\"},\"attestationData\":{\"assignedAssessment\":{\"assessmentKey\":\"s-assessmentkey\"},\"complianceDate\":\"2026-11-06T10:00:00Z\",\"complianceState\":\"s-compliancestate\",\"evidence\":[{\"description\":\"s-description\",\"sourceUrl\":\"s-sourceurl\"}]},\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"effect\":\"s-effect\",\"excludedScopes\":[\"s-excludedscopes\"],\"exemptionData\":{\"assignedAssessment\":{\"assessmentKey\":\"s-assessmentkey\"},\"exemptionCategory\":\"s-exemptioncategory\"},\"expiresOn\":\"2026-11-06T10:00:00Z\",\"metadata\":{\"createdBy\":\"s-createdby\",\"createdOn\":\"2026-11-06T10:00:00Z\",\"lastUpdatedBy\":\"s-lastupdatedby\",\"lastUpdatedOn\":\"2026-11-06T10:00:00Z\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL StandardAssignmentsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", StandardAssignmentsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
