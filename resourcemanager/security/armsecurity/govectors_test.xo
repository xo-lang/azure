test "Go's WorkspaceSettingsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_workspace_settings_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"scope\":\"s-scope\",\"workspaceId\":\"s-workspaceid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkspaceSettingsClient.NewListPager")
  var pg = c.new_list_pager(WorkspaceSettingsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workspace_settings_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_265)
}

fn show_workspace_settings_client_update_response(r: WorkspaceSettingsClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.workspace_setting).to_str_lossy()}")
  parts.join(" ")
}

const GO_266: List[Str] = [
  "CALL WorkspaceSettingsClient.Update",
  "REQ PATCH https://management.example.test/subscriptions/sub-test/providers/Microsoft.Security/workspaceSettings/id1%2F%20x?api-version=2017-08-01-preview",
