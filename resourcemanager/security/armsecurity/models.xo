/// Changing set of properties, depending on the task type that is derived from the name field
pub struct TaskParameters {
  /// Name of the task type
  pub name as "name,omitempty": Str? = None
  /// The keys no field names, as they came (Go's AdditionalProperties).
  pub additional_properties: Map[Str, json.Value]? = None
} derive Json(via: json.Value, to: task_parameters_json, from: parse_task_parameters)

/// TaskParameters's named fields, for its JSON.
struct TaskParametersKnown {
  name as "name,omitempty": Str? = None
} derive Json

fn task_parameters_json(x: TaskParameters) -> json.Value {
  let known = TaskParametersKnown{
    name: x.name,
  }
  with_additional(json.to_value(known), x.additional_properties)
}

fn parse_task_parameters(v: json.Value) -> TaskParameters ! json.DecodeErr {
  let k = json.from_value[TaskParametersKnown](v)?
  Ok(TaskParameters{
    name: k.name,
    additional_properties: additional_of(v, ["name"]),
  })
}

