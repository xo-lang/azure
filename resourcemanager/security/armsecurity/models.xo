/// The type of IoT Security recommendation.
pub type RecommendationType struct(Str)
/// Authentication schema used for pull an edge module from an ACR repository does not use Service Principal Authentication.
pub const RECOMMENDATION_TYPE_IO_T_ACR_AUTHENTICATION: RecommendationType = RecommendationType("IoT_ACRAuthentication")
/// IoT agent message size capacity is currently underutilized, causing an increase in the number of sent messages. Adjust message intervals for better utilization.
pub const RECOMMENDATION_TYPE_IO_T_AGENT_SENDS_UNUTILIZED_MESSAGES: RecommendationType = RecommendationType("IoT_AgentSendsUnutilizedMessages")
/// Identified security related system configuration issues.
pub const RECOMMENDATION_TYPE_IO_T_BASELINE: RecommendationType = RecommendationType("IoT_Baseline")
/// You can optimize Edge Hub memory usage by turning off protocol heads for any protocols not used by Edge modules in your solution.
pub const RECOMMENDATION_TYPE_IO_T_EDGE_HUB_MEM_OPTIMIZE: RecommendationType = RecommendationType("IoT_EdgeHubMemOptimize")
/// Logging is disabled for this edge module.
pub const RECOMMENDATION_TYPE_IO_T_EDGE_LOGGING_OPTIONS: RecommendationType = RecommendationType("IoT_EdgeLoggingOptions")
/// IP Filter Configuration should have rules defined for allowed traffic and should deny all other traffic by default.
pub const RECOMMENDATION_TYPE_IO_T_IP_FILTER_DENY_ALL: RecommendationType = RecommendationType("IoT_IPFilter_DenyAll")
/// An Allow IP Filter rules source IP range is too large. Overly permissive rules might expose your IoT hub to malicious intenders.
pub const RECOMMENDATION_TYPE_IO_T_IP_FILTER_PERMISSIVE_RULE: RecommendationType = RecommendationType("IoT_IPFilter_PermissiveRule")
/// A minority within a device security group has inconsistent Edge Module settings with the rest of their group.
pub const RECOMMENDATION_TYPE_IO_T_INCONSISTENT_MODULE_SETTINGS: RecommendationType = RecommendationType("IoT_InconsistentModuleSettings")
/// Install the Azure Security of Things Agent.
pub const RECOMMENDATION_TYPE_IO_T_INSTALL_AGENT: RecommendationType = RecommendationType("IoT_InstallAgent")
/// A listening endpoint was found on the device.
pub const RECOMMENDATION_TYPE_IO_T_OPEN_PORTS: RecommendationType = RecommendationType("IoT_OpenPorts")
/// An Allowed firewall policy was found (INPUT/OUTPUT). The policy should Deny all traffic by default and define rules to allow necessary communication to/from the device.
pub const RECOMMENDATION_TYPE_IO_T_PERMISSIVE_FIREWALL_POLICY: RecommendationType = RecommendationType("IoT_PermissiveFirewallPolicy")
/// A rule in the firewall has been found that contains a permissive pattern for a wide range of IP addresses or Ports.
pub const RECOMMENDATION_TYPE_IO_T_PERMISSIVE_INPUT_FIREWALL_RULES: RecommendationType = RecommendationType("IoT_PermissiveInputFirewallRules")
/// A rule in the firewall has been found that contains a permissive pattern for a wide range of IP addresses or Ports.
pub const RECOMMENDATION_TYPE_IO_T_PERMISSIVE_OUTPUT_FIREWALL_RULES: RecommendationType = RecommendationType("IoT_PermissiveOutputFirewallRules")
/// Edge module is configured to run in privileged mode, with extensive Linux capabilities or with host-level network access (send/receive data to host machine).
pub const RECOMMENDATION_TYPE_IO_T_PRIVILEGED_DOCKER_OPTIONS: RecommendationType = RecommendationType("IoT_PrivilegedDockerOptions")
/// Same authentication credentials to the IoT Hub used by multiple devices. This could indicate an illegitimate device impersonating a legitimate device. It also exposes the risk of device impersonation by an attacker.
pub const RECOMMENDATION_TYPE_IO_T_SHARED_CREDENTIALS: RecommendationType = RecommendationType("IoT_SharedCredentials")
/// Insecure TLS configurations detected. Immediate upgrade recommended.
pub const RECOMMENDATION_TYPE_IO_T_VULNERABLE_TLS_CIPHER_SUITE: RecommendationType = RecommendationType("IoT_VulnerableTLSCipherSuite")

/// The values of RecommendationType this version knows; the service may send others.
pub fn possible_recommendation_type_values() -> List[RecommendationType] {
  [RECOMMENDATION_TYPE_IO_T_ACR_AUTHENTICATION, RECOMMENDATION_TYPE_IO_T_AGENT_SENDS_UNUTILIZED_MESSAGES, RECOMMENDATION_TYPE_IO_T_BASELINE, RECOMMENDATION_TYPE_IO_T_EDGE_HUB_MEM_OPTIMIZE, RECOMMENDATION_TYPE_IO_T_EDGE_LOGGING_OPTIONS, RECOMMENDATION_TYPE_IO_T_IP_FILTER_DENY_ALL, RECOMMENDATION_TYPE_IO_T_IP_FILTER_PERMISSIVE_RULE, RECOMMENDATION_TYPE_IO_T_INCONSISTENT_MODULE_SETTINGS, RECOMMENDATION_TYPE_IO_T_INSTALL_AGENT, RECOMMENDATION_TYPE_IO_T_OPEN_PORTS, RECOMMENDATION_TYPE_IO_T_PERMISSIVE_FIREWALL_POLICY, RECOMMENDATION_TYPE_IO_T_PERMISSIVE_INPUT_FIREWALL_RULES, RECOMMENDATION_TYPE_IO_T_PERMISSIVE_OUTPUT_FIREWALL_RULES, RECOMMENDATION_TYPE_IO_T_PRIVILEGED_DOCKER_OPTIONS, RECOMMENDATION_TYPE_IO_T_SHARED_CREDENTIALS, RECOMMENDATION_TYPE_IO_T_VULNERABLE_TLS_CIPHER_SUITE]
