/// ResourceDetailsClassification: a ResourceDetails by its source, Go's ResourceDetailsClassification interface.
pub enum ResourceDetailsClassification {
  /// source "Azure"
  AzureResourceDetails(from AzureResourceDetails)
  /// source "OnPremiseResourceDetails"
  OnPremiseResourceDetails(from OnPremiseResourceDetails)
  /// source "OnPremiseSql"
  OnPremiseSQLResourceDetails(from OnPremiseSQLResourceDetails)
  /// Any other source, as the base type.
  ResourceDetails(from ResourceDetails)
} derive Json(via: json.Value, to: resource_details_classification_json, from: parse_resource_details_classification)

fn resource_details_classification_json(c: ResourceDetailsClassification) -> json.Value {
  match c {
    ResourceDetailsClassification.AzureResourceDetails(x) => json.to_value(x)
    ResourceDetailsClassification.OnPremiseResourceDetails(x) => json.to_value(x)
    ResourceDetailsClassification.OnPremiseSQLResourceDetails(x) => json.to_value(x)
    ResourceDetailsClassification.ResourceDetails(x) => json.to_value(x)
  }
}

fn parse_resource_details_classification(v: json.Value) -> ResourceDetailsClassification ! json.DecodeErr {
  match v.get("source") {
    Some(json.Value.Str("Azure")) => Ok(ResourceDetailsClassification.AzureResourceDetails(json.from_value[AzureResourceDetails](v)?))
    Some(json.Value.Str("OnPremiseResourceDetails")) => Ok(ResourceDetailsClassification.OnPremiseResourceDetails(json.from_value[OnPremiseResourceDetails](v)?))
    Some(json.Value.Str("OnPremiseSql")) => Ok(ResourceDetailsClassification.OnPremiseSQLResourceDetails(json.from_value[OnPremiseSQLResourceDetails](v)?))
    _ => Ok(ResourceDetailsClassification.ResourceDetails(json.from_value[ResourceDetails](v)?))
  }
}

