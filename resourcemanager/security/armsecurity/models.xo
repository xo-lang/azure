/// Applies for decimal and non-decimal operands
pub const OPERATOR_EQUALS: Operator = Operator("Equals")
/// Applies only for decimal operands
pub const OPERATOR_GREATER_THAN: Operator = Operator("GreaterThan")
/// Applies only for decimal operands
pub const OPERATOR_GREATER_THAN_OR_EQUAL_TO: Operator = Operator("GreaterThanOrEqualTo")
/// Applies only for decimal operands
pub const OPERATOR_LESSER_THAN: Operator = Operator("LesserThan")
/// Applies only for decimal operands
pub const OPERATOR_LESSER_THAN_OR_EQUAL_TO: Operator = Operator("LesserThanOrEqualTo")
/// Applies  for decimal and non-decimal operands
pub const OPERATOR_NOT_EQUALS: Operator = Operator("NotEquals")
/// Applies only for non-decimal operands
pub const OPERATOR_STARTS_WITH: Operator = Operator("StartsWith")

/// The values of Operator this version knows; the service may send others.
pub fn possible_operator_values() -> List[Operator] {
  [OPERATOR_CONTAINS, OPERATOR_ENDS_WITH, OPERATOR_EQUALS, OPERATOR_GREATER_THAN, OPERATOR_GREATER_THAN_OR_EQUAL_TO, OPERATOR_LESSER_THAN, OPERATOR_LESSER_THAN_OR_EQUAL_TO, OPERATOR_NOT_EQUALS, OPERATOR_STARTS_WITH]
