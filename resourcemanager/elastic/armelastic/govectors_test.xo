  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"elasticProperties\":{\"elasticCloudDeployment\":{\"azureSubscriptionId\":\"s-azuresubscriptionid\",\"deploymentId\":\"s-deploymentid\",\"elasticsearchRegion\":\"s-elasticsearchregion\",\"elasticsearchServiceUrl\":\"s-elasticsearchserviceurl\",\"kibanaServiceUrl\":\"s-kibanaserviceurl\",\"kibanaSsoUrl\":\"s-kibanassourl\",\"name\":\"s-name\"},\"elasticCloudUser\":{\"elasticCloudSsoDefaultUrl\":\"s-elasticcloudssodefaulturl\",\"emailAddress\":\"s-emailaddress\",\"id\":\"s-id\"}},\"generateApiKey\":true,\"hostingType\":\"s-hostingtype\",\"liftrResourceCategory\":\"s-liftrresourcecategory\",\"liftrResourcePreference\":7,\"monitoringStatus\":\"s-monitoringstatus\",\"planDetails\":{\"offerID\":\"s-offerid\",\"planID\":\"s-planid\",\"planName\":\"s-planname\",\"publisherID\":\"s-publisherid\",\"termID\":\"s-termid\"},\"projectDetails\":{\"configurationType\":\"s-configurationtype\",\"projectType\":\"s-projecttype\"},\"provisioningState\":\"Succeeded\",\"saaSAzureSubscriptionStatus\":\"s-saasazuresubscriptionstatus\",\"sourceCampaignId\":\"s-sourcecampaignid\",\"sourceCampaignName\":\"s-sourcecampaignname\",\"subscriptionState\":\"s-subscriptionstate\",\"userInfo\":{\"companyInfo\":{\"business\":\"s-business\",\"country\":\"s-country\",\"domain\":\"s-domain\",\"employeesNumber\":\"s-employeesnumber\",\"state\":\"s-state\"},\"companyName\":\"s-companyname\",\"emailAddress\":\"s-emailaddress\",\"firstName\":\"s-firstname\",\"lastName\":\"s-lastname\"},\"version\":\"s-version\"},\"sku\":{\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL MonitorsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", MonitorsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_monitors_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_22)
}

