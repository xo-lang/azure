fn show_client_list_at_management_group_response(r: ClientListAtManagementGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.deployment_stack_list_result).to_str_lossy()}")
  parts.join(" ")
}

