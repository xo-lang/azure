test "Go's Client.NewListAtManagementGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"actionOnUnmanage\":{\"managementGroups\":\"s-managementgroups\",\"resourceGroups\":\"s-resourcegroups\",\"resources\":\"s-resources\",\"resourcesWithoutDeleteSupport\":\"s-resourceswithoutdeletesupport\"},\"bypassStackOutOfSyncError\":true,\"correlationId\":\"s-correlationid\",\"debugSetting\":{\"detailLevel\":\"s-detaillevel\"},\"deletedResources\":[{\"apiVersion\":\"s-apiversion\",\"extension\":{\"configId\":\"s-configid\",\"name\":\"s-name\",\"version\":\"s-version\"},\"id\":\"s-id\",\"identifiers\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"denySettings\":{\"applyToChildScopes\":true,\"excludedActions\":[\"s-excludedactions\"],\"excludedPrincipals\":[\"s-excludedprincipals\"],\"mode\":\"s-mode\"},\"deploymentExtensions\":[{\"config\":{},\"configId\":\"s-configid\",\"name\":\"s-name\",\"version\":\"s-version\"}],\"deploymentId\":\"s-deploymentid\",\"deploymentScope\":\"s-deploymentscope\",\"description\":\"s-description\",\"detachedResources\":[{\"apiVersion\":\"s-apiversion\",\"extension\":{\"configId\":\"s-configid\",\"name\":\"s-name\",\"version\":\"s-version\"},\"id\":\"s-id\",\"identifiers\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"duration\":\"s-duration\",\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"extensionConfigs\":{\"k1\":{}},\"externalInputDefinitions\":{\"k1\":{\"config\":{\"k\":\"v\"},\"kind\":\"s-kind\"}},\"externalInputs\":{\"k1\":{\"value\":{\"k\":\"v\"}}},\"failedResources\":[{\"apiVersion\":\"s-apiversion\",\"error\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"},\"extension\":{\"configId\":\"s-configid\",\"name\":\"s-name\",\"version\":\"s-version\"},\"id\":\"s-id\",\"identifiers\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"outputs\":{\"k\":\"v\"},\"parameters\":{\"k1\":{\"expression\":\"s-expression\",\"reference\":{\"secretName\":\"s-secretname\",\"secretVersion\":\"s-secretversion\"},\"type\":\"s-type\",\"value\":{\"k\":\"v\"}}},\"parametersLink\":{\"contentVersion\":\"s-contentversion\",\"uri\":\"s-uri\"},\"provisioningState\":\"Succeeded\",\"resources\":[{\"apiVersion\":\"s-apiversion\",\"denyStatus\":\"s-denystatus\",\"extension\":{\"configId\":\"s-configid\",\"name\":\"s-name\",\"version\":\"s-version\"},\"id\":\"s-id\",\"identifiers\":{\"k\":\"v\"},\"status\":\"s-status\",\"type\":\"s-type\"}],\"template\":{\"k\":\"v\"},\"templateLink\":{\"contentVersion\":\"s-contentversion\",\"id\":\"s-id\",\"queryString\":\"s-querystring\",\"relativePath\":\"s-relativepath\",\"uri\":\"s-uri\"},\"validationLevel\":\"s-validationlevel\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Client.NewListAtManagementGroupPager")
  var pg = c.new_list_at_management_group_pager("id1/ x", ClientListAtManagementGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_list_at_management_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_15)
}

fn show_client_list_at_resource_group_response(r: ClientListAtResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.deployment_stack_list_result).to_str_lossy()}")
  parts.join(" ")
}

