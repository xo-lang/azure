",\"secretVersion\":\"s-secretversion\"},\"type\":\"s-type\",\"value\":{\"k\":\"v\"}}},\"parametersLink\":{\"contentVersion\":\"s-contentversion\",\"uri\":\"s-uri\"},\"provisioningState\":\"Succeeded\",\"retentionInterval\":\"s-retentioninterval\",\"template\":{\"k1\":{\"k\":\"v\"}},\"templateLink\":{\"contentVersion\":\"s-contentversion\",\"id\":\"s-id\",\"queryString\":\"s-querystring\",\"relativePath\":\"s-relativepath\",\"uri\":\"s-uri\"},\"validationLevel\":\"s-validationlevel\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WhatIfResultsAtSubscriptionClient.NewListPager")
  var pg = c.new_list_pager(WhatIfResultsAtSubscriptionClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
