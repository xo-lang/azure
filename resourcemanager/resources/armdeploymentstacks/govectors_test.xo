fn show_client_create_or_update_at_subscription_response(r: ClientCreateOrUpdateAtSubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.deployment_stack).to_str_lossy()}")
  parts.join(" ")
}

