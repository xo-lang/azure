fn show_client_validate_stack_at_subscription_response(r: ClientValidateStackAtSubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.deployment_stack_validate_result).to_str_lossy()}")
  parts.join(" ")
}

