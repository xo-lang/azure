test "Go's Client.Update" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"identity\":{\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"AzureCLI\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"arguments\":\"s-arguments\",\"azCliVersion\":\"s-azcliversion\",\"cleanupPreference\":\"s-cleanuppreference\",\"containerSettings\":{\"containerGroupName\":\"s-containergroupname\"},\"environmentVariables\":[{\"name\":\"s-name\",\"secureValue\":\"s-securevalue\",\"value\":\"s-value\"}],\"forceUpdateTag\":\"s-forceupdatetag\",\"outputs\":{\"k1\":{\"k\":\"v\"}},\"primaryScriptUri\":\"s-primaryscripturi\",\"provisioningState\":\"Succeeded\",\"retentionInterval\":\"s-retentioninterval\",\"scriptContent\":\"s-scriptcontent\",\"status\":{\"containerInstanceId\":\"s-containerinstanceid\",\"endTime\":\"2026-11-06T10:00:00Z\",\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"expirationTime\":\"2026-11-06T10:00:00Z\",\"startTime\":\"2026-11-06T10:00:00Z\",\"storageAccountId\":\"s-storageaccountid\"},\"storageAccountSettings\":{\"storageAccountKey\":\"s-storageaccountkey\",\"storageAccountName\":\"s-storageaccountname\"},\"supportingScriptUris\":[\"s-supportingscripturis\"],\"timeout\":\"s-timeout\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL Client.Update")
  match c.update("id1/ x", "id2/ x", ClientUpdateOptions{deployment_script: Some((json.decode_str[DeploymentScriptUpdateParameter]("{\"id\":\"s-id\",\"name\":\"s-name\",\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}") ?? e => fault("${e}")))}) {
    Ok(r) => gv_note(f, "OUT: ${show_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_7)
}
