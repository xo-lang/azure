  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"AzureCLI\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"arguments\":\"s-arguments\",\"azCliVersion\":\"s-azcliversion\",\"cleanupPreference\":\"s-cleanuppreference\",\"containerSettings\":{\"containerGroupName\":\"s-containergroupname\"},\"environmentVariables\":[{\"name\":\"s-name\",\"secureValue\":\"s-securevalue\",\"value\":\"s-value\"}],\"forceUpdateTag\":\"s-forceupdatetag\",\"outputs\":{\"k1\":{\"k\":\"v\"}},\"primaryScriptUri\":\"s-primaryscripturi\",\"provisioningState\":\"Succeeded\",\"retentionInterval\":\"s-retentioninterval\",\"scriptContent\":\"s-scriptcontent\",\"status\":{\"containerInstanceId\":\"s-containerinstanceid\",\"endTime\":\"2026-11-06T10:00:00Z\",\"error\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"},\"expirationTime\":\"2026-11-06T10:00:00Z\",\"startTime\":\"2026-11-06T10:00:00Z\",\"storageAccountId\":\"s-storageaccountid\"},\"storageAccountSettings\":{\"storageAccountKey\":\"s-storageaccountkey\",\"storageAccountName\":\"s-storageaccountname\"},\"supportingScriptUris\":[\"s-supportingscripturis\"],\"timeout\":\"s-timeout\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Client.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_5)
}

fn show_client_list_by_subscription_response(r: ClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.deployment_script_list_result).to_str_lossy()}")
  parts.join(" ")
}

