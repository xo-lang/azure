// Generated from the output of a local Go program that calls every
// public method of each client of armchanges v1.2.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use github.com/xo-lang/azure/runtime

fn show_client_get_response(r: ClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.change_resource_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL Client.Get",
  "REQ GET https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/id2%2F%20x/id3%2F%20x/id4%2F%20x/providers/Microsoft.Resources/changes/id5%2F%20x?api-version=2022-05-01",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"changeAttributes\":{\"changesCount\":7,\"correlationId\":\"s-correlationid\",\"newResourceSnapshotId\":\"s-newresourcesnapshotid\",\"previousResourceSnapshotId\":\"s-previousresourcesnapshotid\",\"timestamp\":\"s-timestamp\"},\"changeType\":\"s-changetype\",\"changes\":{\"k1\":{\"changeCategory\":\"s-changecategory\",\"newValue\":\"s-newvalue\",\"previousValue\":\"s-previousvalue\",\"propertyChangeType\":\"s-propertychangetype\"}},\"targetResourceId\":\"s-targetresourceid\",\"targetResourceType\":\"s-targetresourcetype\"},\"type\":\"s-type\"}",
  "OUT: body={\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"changeAttributes\":{\"changesCount\":7,\"correlationId\":\"s-correlationid\",\"newResourceSnapshotId\":\"s-newresourcesnapshotid\",\"previousResourceSnapshotId\":\"s-previousresourcesnapshotid\",\"timestamp\":\"s-timestamp\"},\"changeType\":\"s-changetype\",\"changes\":{\"k1\":{\"changeCategory\":\"s-changecategory\",\"newValue\":\"s-newvalue\",\"previousValue\":\"s-previousvalue\",\"propertyChangeType\":\"s-propertychangetype\"}},\"targetResourceId\":\"s-targetresourceid\",\"targetResourceType\":\"s-targetresourcetype\"},\"type\":\"s-type\"}",
]

test "Go's Client.Get" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"changeAttributes\":{\"changesCount\":7,\"correlationId\":\"s-correlationid\",\"newResourceSnapshotId\":\"s-newresourcesnapshotid\",\"previousResourceSnapshotId\":\"s-previousresourcesnapshotid\",\"timestamp\":\"s-timestamp\"},\"changeType\":\"s-changetype\",\"changes\":{\"k1\":{\"changeCategory\":\"s-changecategory\",\"newValue\":\"s-newvalue\",\"previousValue\":\"s-previousvalue\",\"propertyChangeType\":\"s-propertychangetype\"}},\"targetResourceId\":\"s-targetresourceid\",\"targetResourceType\":\"s-targetresourcetype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL Client.Get")
  match c.get("id1/ x", "id2/ x", "id3/ x", "id4/ x", "id5/ x", ClientGetOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_client_get_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

fn show_client_list_response(r: ClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.change_resource_list_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_1: List[Str] = [
  "CALL Client.NewListPager",
  "REQ GET https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/id2%2F%20x/id3%2F%20x/id4%2F%20x/providers/Microsoft.Resources/changes?%24skipToken=s-skiptoken&%24top=7&api-version=2022-05-01",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"changeAttributes\":{\"changesCount\":7,\"correlationId\":\"s-correlationid\",\"newResourceSnapshotId\":\"s-newresourcesnapshotid\",\"previousResourceSnapshotId\":\"s-previousresourcesnapshotid\",\"timestamp\":\"s-timestamp\"},\"changeType\":\"s-changetype\",\"changes\":{\"k1\":{\"changeCategory\":\"s-changecategory\",\"newValue\":\"s-newvalue\",\"previousValue\":\"s-previousvalue\",\"propertyChangeType\":\"s-propertychangetype\"}},\"targetResourceId\":\"s-targetresourceid\",\"targetResourceType\":\"s-targetresourcetype\"},\"type\":\"s-type\"}]}",
  "OUT page 1: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"changeAttributes\":{\"changesCount\":7,\"correlationId\":\"s-correlationid\",\"newResourceSnapshotId\":\"s-newresourcesnapshotid\",\"previousResourceSnapshotId\":\"s-previousresourcesnapshotid\",\"timestamp\":\"s-timestamp\"},\"changeType\":\"s-changetype\",\"changes\":{\"k1\":{\"changeCategory\":\"s-changecategory\",\"newValue\":\"s-newvalue\",\"previousValue\":\"s-previousvalue\",\"propertyChangeType\":\"s-propertychangetype\"}},\"targetResourceId\":\"s-targetresourceid\",\"targetResourceType\":\"s-targetresourcetype\"},\"type\":\"s-type\"}]}",
  "REQ GET https://management.example.test/next?%24skiptoken=2",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"changeAttributes\":{\"changesCount\":7,\"correlationId\":\"s-correlationid\",\"newResourceSnapshotId\":\"s-newresourcesnapshotid\",\"previousResourceSnapshotId\":\"s-previousresourcesnapshotid\",\"timestamp\":\"s-timestamp\"},\"changeType\":\"s-changetype\",\"changes\":{\"k1\":{\"changeCategory\":\"s-changecategory\",\"newValue\":\"s-newvalue\",\"previousValue\":\"s-previousvalue\",\"propertyChangeType\":\"s-propertychangetype\"}},\"targetResourceId\":\"s-targetresourceid\",\"targetResourceType\":\"s-targetresourcetype\"},\"type\":\"s-type\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"changeAttributes\":{\"changesCount\":7,\"correlationId\":\"s-correlationid\",\"newResourceSnapshotId\":\"s-newresourcesnapshotid\",\"previousResourceSnapshotId\":\"s-previousresourcesnapshotid\",\"timestamp\":\"s-timestamp\"},\"changeType\":\"s-changetype\",\"changes\":{\"k1\":{\"changeCategory\":\"s-changecategory\",\"newValue\":\"s-newvalue\",\"previousValue\":\"s-previousvalue\",\"propertyChangeType\":\"s-propertychangetype\"}},\"targetResourceId\":\"s-targetresourceid\",\"targetResourceType\":\"s-targetresourcetype\"},\"type\":\"s-type\"}]}",
]

test "Go's Client.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"changeAttributes\":{\"changesCount\":7,\"correlationId\":\"s-correlationid\",\"newResourceSnapshotId\":\"s-newresourcesnapshotid\",\"previousResourceSnapshotId\":\"s-previousresourcesnapshotid\",\"timestamp\":\"s-timestamp\"},\"changeType\":\"s-changetype\",\"changes\":{\"k1\":{\"changeCategory\":\"s-changecategory\",\"newValue\":\"s-newvalue\",\"previousValue\":\"s-previousvalue\",\"propertyChangeType\":\"s-propertychangetype\"}},\"targetResourceId\":\"s-targetresourceid\",\"targetResourceType\":\"s-targetresourcetype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Client.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", ClientListOptions{skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_1)
}
