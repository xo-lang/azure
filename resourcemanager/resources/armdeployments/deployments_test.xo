// Behaviors beyond the Go vectors, against the fake of client_test.xo
// (written by scripts/refresh.sh; these tests are hand-written).

test "check_existence: 404 is success false with no error, 200 is an error (Go's 204 or 404 only)" {
  let f = gv_new_fake(os.net)
  let c = new_deployments_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 404, "")
  expect(c.check_existence("rg", "d")?.success) == false
  gv_set(f, 204, "")
  expect(c.check_existence("rg", "d")?.success) == true
  gv_set(f, 200, "")
  expect(c.check_existence("rg", "d").is_err()) == true
}
