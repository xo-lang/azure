  let c = new_deployment_operations_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"id\":\"s-id\",\"operationId\":\"s-operationid\",\"properties\":{\"duration\":\"s-duration\",\"provisioningOperation\":\"s-provisioningoperation\",\"provisioningState\":\"Succeeded\",\"request\":{\"content\":{\"k\":\"v\"}},\"response\":{\"content\":{\"k\":\"v\"}},\"serviceRequestId\":\"s-servicerequestid\",\"statusCode\":\"s-statuscode\",\"statusMessage\":{\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"status\":\"s-status\"},\"targetResource\":{\"apiVersion\":\"s-apiversion\",\"extension\":{\"alias\":\"s-alias\",\"config\":{\"k1\":{\"keyVaultReference\":{\"secretName\":\"s-secretname\",\"secretVersion\":\"s-secretversion\"},\"value\":{\"k\":\"v\"}}},\"configHash\":\"s-confighash\",\"configId\":\"s-configid\",\"name\":\"s-name\",\"version\":\"s-version\"},\"id\":\"s-id\",\"identifiers\":{\"k\":\"v\"},\"resourceName\":\"s-resourcename\",\"resourceType\":\"s-resourcetype\",\"symbolicName\":\"s-symbolicname\",\"symbolicNamePath\":[\"s-symbolicnamepath\"]},\"timestamp\":\"2026-11-06T10:00:00Z\"}}")
  note(f, "CALL DeploymentOperationsClient.GetAtTenantScope")
  match c.get_at_tenant_scope("id1/ x", "id2/ x", DeploymentOperationsClientGetAtTenantScopeOptions{}) {
    Ok(r) => note(f, "OUT: ${show_deployment_operations_client_get_at_tenant_scope_response(r)}")
