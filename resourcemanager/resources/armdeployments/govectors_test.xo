      Ok(r) => note(f, "OUT page ${page}: ${show_deployment_operations_client_list_at_management_group_scope_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_5)
}

