00:00Z\",\"validatedResources\":[{\"apiVersion\":\"s-apiversion\",\"extension\":{\"alias\":\"s-alias\",\"configHash\":\"s-confighash\",\"configId\":\"s-configid\",\"name\":\"s-name\",\"version\":\"s-version\"},\"id\":\"s-id\",\"identifiers\":{\"k\":\"v\"},\"resourceType\":\"s-resourcetype\",\"symbolicNamePath\":[\"s-symbolicnamepath\"]}],\"validationLevel\":\"s-validationlevel\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
