test "Go's DeploymentsClient.NewListAtSubscriptionScopePager" {
  let f = new_fake(os.net)
  let c = new_deployments_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"correlationId\":\"s-correlationid\",\"debugSetting\":{\"detailLevel\":\"s-detaillevel\"},\"dependencies\":[{\"id\":\"s-id\",\"resourceName\":\"s-resourcename\",\"resourceType\":\"s-resourcetype\"}],\"diagnostics\":[{\"code\":\"s-code\",\"level\":\"s-level\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"duration\":\"s-duration\",\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"extensions\":[{\"alias\":\"s-alias\",\"configHash\":\"s-confighash\",\"configId\":\"s-configid\",\"name\":\"s-name\",\"version\":\"s-version\"}],\"mode\":\"s-mode\",\"onErrorDeployment\":{\"deploymentName\":\"s-deploymentname\",\"provisioningState\":\"Succeeded\",\"type\":\"s-type\"},\"outputResources\":[{\"apiVersion\":\"s-apiversion\",\"extension\":{\"alias\":\"s-alias\",\"configHash\":\"s-confighash\",\"configId\":\"s-configid\",\"name\":\"s-name\",\"version\":\"s-version\"},\"id\":\"s-id\",\"identifiers\":{\"k\":\"v\"},\"resourceType\":\"s-resourcetype\",\"symbolicNamePath\":[\"s-symbolicnamepath\"]}],\"outputs\":{\"k\":\"v\"},\"parameters\":{\"k\":\"v\"},\"parametersLink\":{\"contentVersion\":\"s-contentversion\",\"uri\":\"s-uri\"},\"providers\":[{\"id\":\"s-id\",\"namespace\":\"s-namespace\",\"providerAuthorizationConsentState\":\"s-providerauthorizationconsentstate\",\"registrationPolicy\":\"s-registrationpolicy\",\"registrationState\":\"s-registrationstate\"}],\"provisioningState\":\"Succeeded\",\"templateHash\":\"s-templatehash\",\"templateLink\":{\"contentVersion\":\"s-contentversion\",\"id\":\"s-id\",\"queryString\":\"s-querystring\",\"relativePath\":\"s-relativepath\",\"uri\":\"s-uri\"},\"timestamp\":\"2026-11-06T10:00:00Z\",\"validatedResources\":[{\"apiVersion\":\"s-apiversion\",\"extension\":{\"alias\":\"s-alias\",\"configHash\":\"s-confighash\",\"configId\":\"s-configid\",\"name\":\"s-name\",\"version\":\"s-version\"},\"id\":\"s-id\",\"identifiers\":{\"k\":\"v\"},\"resourceType\":\"s-resourcetype\",\"symbolicNamePath\":[\"s-symbolicnamepath\"]}],\"validationLevel\":\"s-validationlevel\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  note(f, "CALL DeploymentsClient.NewListAtSubscriptionScopePager")
  var pg = c.new_list_at_subscription_scope_pager(DeploymentsClientListAtSubscriptionScopeOptions{filter: Some("s-filter"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_deployments_client_list_at_subscription_scope_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_52)
}

fn show_deployments_client_list_at_tenant_scope_response(r: DeploymentsClientListAtTenantScopeResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.deployment_list_result).to_str_lossy()}")
  parts.join(" ")
}

