test "Go's DeploymentOperationsClient.NewListAtTenantScopePager" {
  let f = new_fake(os.net)
  let c = new_deployment_operations_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"operationId\":\"s-operationid\",\"properties\":{\"duration\":\"s-duration\",\"provisioningOperation\":\"s-provisioningoperation\",\"provisioningState\":\"Succeeded\",\"request\":{\"content\":{\"k\":\"v\"}},\"response\":{\"content\":{\"k\":\"v\"}},\"serviceRequestId\":\"s-servicerequestid\",\"statusCode\":\"s-statuscode\",\"statusMessage\":{\"error\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"},\"status\":\"s-status\"},\"targetResource\":{\"apiVersion\":\"s-apiversion\",\"extension\":{\"alias\":\"s-alias\",\"configHash\":\"s-confighash\",\"configId\":\"s-configid\",\"name\":\"s-name\",\"version\":\"s-version\"},\"id\":\"s-id\",\"identifiers\":{\"k\":\"v\"},\"resourceName\":\"s-resourcename\",\"resourceType\":\"s-resourcetype\",\"symbolicName\":\"s-symbolicname\",\"symbolicNamePath\":[\"s-symbolicnamepath\"]},\"timestamp\":\"2026-11-06T10:00:00Z\"}}]}")
  note(f, "CALL DeploymentOperationsClient.NewListAtTenantScopePager")
  var pg = c.new_list_at_tenant_scope_pager("id1/ x", DeploymentOperationsClientListAtTenantScopeOptions{top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_deployment_operations_client_list_at_tenant_scope_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_8)
}

