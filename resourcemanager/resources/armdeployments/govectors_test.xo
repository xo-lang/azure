fn show_deployments_client_validate_at_scope_response(r: DeploymentsClientValidateAtScopeResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.deployment_validate_result).to_str_lossy()}")
  parts.join(" ")
}

