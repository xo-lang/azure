    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(r) => note(f, "OUT: ${show_deployments_client_validate_at_tenant_scope_response(r)}")
        Err(e) => note_lines(f, "OUT: error: ${err_text(e)}")
      }
    }
    Err(e) => note_lines(f, "OUT: error: ${err_text(e)}")
  }
  compare(log_of(f), GO_24)
}

fn show_deployments_client_what_if_response(r: DeploymentsClientWhatIfResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.what_if_operation_result).to_str_lossy()}")
  parts.join(" ")
}

