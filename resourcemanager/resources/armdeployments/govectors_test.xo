fn show_deployments_client_list_by_resource_group_response(r: DeploymentsClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.deployment_list_result).to_str_lossy()}")
  parts.join(" ")
}

