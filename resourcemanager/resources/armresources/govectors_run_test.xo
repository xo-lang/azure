// The ResourceGroups client against the Go program's fake Resource
// Manager: each request, decoded result, page and resume token must be
// Go's (govectors_test.xo).

use std/json
use github.com/xo-lang/azure/arm

const GV_G1: Str = "{\"id\":\"/subscriptions/sub-test/resourceGroups/rg1\",\"name\":\"rg1\",\"type\":\"Microsoft.Resources/resourceGroups\",\"location\":\"westus\",\"managedBy\":null,\"tags\":{\"env\":\"a&b\",\"empty\":\"\"},\"properties\":{\"provisioningState\":\"Succeeded\"},\"extra\":{\"x\":1}}"
const GV_RGS: Str = "/subscriptions/sub-test/resourcegroups"
const GV_OP: Str = "/subscriptions/sub-test/operationresults/op1"

test "get, the list pages and the delete poller match Go's" {
  let f = gv_serve(os.net)
  let c = new_resource_groups_client(os.net, os.clock, os.rand, SUB, Fixed{}, arm.ClientOptions{endpoint: EP})?
  gv_add(f, "GET", "${GV_RGS}/rg1", GvReply{status: 200, body: GV_G1})
  gv_show(f, "get", c.get("rg1"), fn(r: ResourceGroupsClientGetResponse) -> Str { gv_json(json.to_value(r.resource_group)) })
  gv_add(f, "GET", GV_RGS, GvReply{status: 200, body: "{\"value\":[${GV_G1}],\"nextLink\":\"${EP}${GV_RGS}?api-version=2021-04-01&%24skiptoken=a%2Bb%3D\"}"})
  gv_add(f, "GET", GV_RGS, GvReply{status: 200, body: "{\"value\":[{\"name\":\"rg2\",\"location\":\"eastus\"}],\"nextLink\":\"\"}"})
  var p = c.new_list_pager(ResourceGroupsClientListOptions{filter: Some("tagName eq 'env'"), top: Some(1)})?
  while p.more() {
    let pg = p.next_page()
    gv_show(f, "list_page", pg, fn(r: ResourceGroupsClientListResponse) -> Str { gv_json(json.to_value(r.resource_group_list_result)) })
    if pg.is_err() {
      break
    }
  }
  gv_add(f, "DELETE", "${GV_RGS}/rg1", GvReply{status: 202, body: "", headers: [("Location", "${EP}${GV_OP}?api-version=2021-04-01")]})
  gv_add(f, "GET", GV_OP, GvReply{status: 202, body: ""})
  gv_add(f, "GET", GV_OP, GvReply{status: 200, body: ""})
  match c.begin_delete("rg1", ResourceGroupsClientBeginDeleteOptions{force_deletion_types: Some("Microsoft.Compute/virtualMachines")}) {
    Ok(p0) => {
      var pd = p0
      gv_token(f, "delete", pd)
      gv_show(f, "delete", pd.poll_until_done(os.clock, frequency: 1ms), fn(r: ResourceGroupsClientDeleteResponse) -> Str { "{}" })
    }
    Err(e) => gv_note(f, "ERR begin_delete: ${gv_err(e)}")
  }
  gv_check(f)
}
