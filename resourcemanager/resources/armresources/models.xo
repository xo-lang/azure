/// ResourceGroupPropertiesPatch: ResourceGroupProperties in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct ResourceGroupPropertiesPatch {
  /// The provisioning state.
  pub provisioning_state as "provisioningState,omitempty": json.Patch[Str] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: ResourceGroupProperties) patch() -> ResourceGroupPropertiesPatch {
  ResourceGroupPropertiesPatch{
    provisioning_state: match m.provisioning_state {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}

/// TagsPatch: Tags in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct TagsPatch {
  /// Dictionary of <string>
  pub tags as "tags,omitempty": json.Patch[Map[Str, Str]] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: Tags) patch() -> TagsPatch {
  TagsPatch{
    tags: match m.tags {
