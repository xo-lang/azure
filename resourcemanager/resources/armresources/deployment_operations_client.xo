  let v = json.decode[DeploymentOperationsListResult](resp.body) ?? e => return Err(e.display())
  Ok(DeploymentOperationsClientListResponse{deployment_operations_list_result: v})
}

fn (c: DeploymentOperationsClient) list_create_request(resource_group_name: Str, deployment_name: Str, options: DeploymentOperationsClientListOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourcegroups/{resourceGroupName}/deployments/{deploymentName}/operations"
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if deployment_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter deploymentName cannot be empty"))
  }
  path = path.replace("{deploymentName}", url.path_escape(deployment_name))
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionId cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  if let Some(v) = options.top {
    q.add("$top", "${v}")
  }
  q.add("api-version", API_VERSION)
  let qs = q.encode()
  Ok(policy.Request{method: "GET", url: "${c.setup.endpoint}${path}${if qs == "" { "" } else { "?${qs}" }}", headers: headers, body: b""})
}

/// Gets all deployments operations for a deployment.
pub fn (c: DeploymentOperationsClient) new_list_pager(resource_group_name: Str, deployment_name: Str, options: DeploymentOperationsClientListOptions = DeploymentOperationsClientListOptions{}) -> runtime.Pager[DeploymentOperationsClientListResponse] ! azcore.CallErr {
  let req = c.list_create_request(resource_group_name, deployment_name, options)?
  Ok(runtime.new_pager(c.setup.pipeline, req, fn(r: http.Response) -> DeploymentOperationsClientListResponse ! Str { deployment_operations_list_handle(r) }, fn(r: DeploymentOperationsClientListResponse) -> Str? { r.deployment_operations_list_result.next_link }))
}
