  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"count\":{\"type\":\"s-type\",\"value\":7},\"id\":\"s-id\",\"tagName\":\"s-tagname\",\"values\":[{\"count\":{\"type\":\"s-type\",\"value\":7},\"id\":\"s-id\",\"tagValue\":\"s-tagvalue\"}]}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"count\":{\"type\":\"s-type\",\"value\":7},\"id\":\"s-id\",\"tagName\":\"s-tagname\",\"values\":[{\"count\":{\"type\":\"s-type\",\"value\":7},\"id\":\"s-id\",\"tagValue\":\"s-tagvalue\"}]}]}",
]

test "Go's TagsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_tags_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"count\":{\"type\":\"s-type\",\"value\":7},\"id\":\"s-id\",\"tagName\":\"s-tagname\",\"values\":[{\"count\":{\"type\":\"s-type\",\"value\":7},\"id\":\"s-id\",\"tagValue\":\"s-tagvalue\"}]}]}")
  gv_note(f, "CALL TagsClient.NewListPager")
  var pg = c.new_list_pager(TagsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_tags_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_39)
}
