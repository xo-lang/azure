// Generated from the output of a local Go program that calls every
// public method of each client of armsubscriptions v2.0.0 (azcore v1.23.0) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (mkvec_arm.py). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_client_check_zone_peers_response(r: ClientCheckZonePeersResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.check_zone_peers_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL Client.CheckZonePeers",
  "REQ POST https://management.example.test/subscriptions/id1%2F%20x/providers/Microsoft.Resources/checkZonePeers/?api-version=2022-12-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"location\":\"s-location\",\"subscriptionIds\":[\"s-subscriptionids\"]}",
  "  SERVED 200 {\"availabilityZonePeers\":[{\"availabilityZone\":\"s-availabilityzone\",\"peers\":[{\"availabilityZone\":\"s-availabilityzone\",\"subscriptionId\":\"s-subscriptionid\"}]}],\"location\":\"s-location\",\"subscriptionId\":\"s-subscriptionid\"}",
  "OUT: body={\"availabilityZonePeers\":[{\"availabilityZone\":\"s-availabilityzone\",\"peers\":[{\"availabilityZone\":\"s-availabilityzone\",\"subscriptionId\":\"s-subscriptionid\"}]}],\"location\":\"s-location\",\"subscriptionId\":\"s-subscriptionid\"}",
]

test "Go's Client.CheckZonePeers" {
  let f = new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"availabilityZonePeers\":[{\"availabilityZone\":\"s-availabilityzone\",\"peers\":[{\"availabilityZone\":\"s-availabilityzone\",\"subscriptionId\":\"s-subscriptionid\"}]}],\"location\":\"s-location\",\"subscriptionId\":\"s-subscriptionid\"}")
  note(f, "CALL Client.CheckZonePeers")
  match c.check_zone_peers("id1/ x", (json.decode_str[CheckZonePeersRequest]("{\"location\":\"s-location\",\"subscriptionIds\":[\"s-subscriptionids\"]}") ?? e => fault("${e}")), ClientCheckZonePeersOptions{}) {
    Ok(r) => note(f, "OUT: ${show_client_check_zone_peers_response(r)}")
    Err(e) => note_lines(f, "OUT: error: ${err_text(e)}")
  }
  compare(log_of(f), GO_0)
}

