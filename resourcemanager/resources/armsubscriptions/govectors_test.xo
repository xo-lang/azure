  let c = new_client(os.net, os.clock, os.rand, Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"availabilityZoneMappings\":[{\"logicalZone\":\"s-logicalzone\",\"physicalZone\":\"s-physicalzone\"}],\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"metadata\":{\"geography\":\"s-geography\",\"geographyGroup\":\"s-geographygroup\",\"homeLocation\":\"s-homelocation\",\"latitude\":\"s-latitude\",\"longitude\":\"s-longitude\",\"pairedRegion\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"subscriptionId\":\"s-subscriptionid\"}],\"physicalLocation\":\"s-physicallocation\",\"regionCategory\":\"s-regioncategory\",\"regionType\":\"s-regiontype\"},\"name\":\"s-name\",\"regionalDisplayName\":\"s-regionaldisplayname\",\"subscriptionId\":\"s-subscriptionid\",\"type\":\"s-type\"}]}")
