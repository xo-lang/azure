test "Go's Client.Get" {
  let f = new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"authorizationSource\":\"s-authorizationsource\",\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"managedByTenants\":[{\"tenantId\":\"s-tenantid\"}],\"state\":\"s-state\",\"subscriptionId\":\"s-subscriptionid\",\"subscriptionPolicies\":{\"locationPlacementId\":\"s-locationplacementid\",\"quotaId\":\"s-quotaid\",\"spendingLimit\":\"s-spendinglimit\"},\"tags\":{\"k1\":\"s-tags\"},\"tenantId\":\"s-tenantid\"}")
  note(f, "CALL Client.Get")
  match c.get("id1/ x", ClientGetOptions{}) {
