// Behaviors beyond the Go vectors, against the fake of client_test.xo
// (written by scripts/refresh.sh; these tests are hand-written).

// Go's []*PairedRegion keeps a JSON null element as a nil pointer; here
// a list of models has no null element, so such a body fails to decode
// (the root CHANGELOG's armsubscriptions entry).
test "a null element in a list of models is refused (Go keeps a nil)" {
  let f = gv_new_fake(os.net)
  gv_set(f, 200, "{\"value\":[{\"metadata\":{\"pairedRegion\":[null]}}]}")
  let c = new_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  var pg = c.new_list_locations_pager("sub1") ?? e => fault("${e}")
  match pg.next_page() {
    Ok(_) => fault("a null model element decoded")
    Err(e) => expect(gv_err_text(e)) == "at $.value[0].metadata.pairedRegion[0]: expected object"
  }
}

// The default options: the public cloud's Resource Manager, which
// FakeNet does not answer (no request leaves the test).
test "the clients take no subscription; the methods that need one take it" {
  let c = new_client(os.net, os.clock, os.rand, GvCred{}) ?? e => fault(e)
  match c.get("sub1") {
    Ok(_) => fault("FakeNet answered the public cloud")
    Err(e) => expect("${e}".contains("GET https://management.azure.com/subscriptions/sub1?api-version=2022-12-01")) == true
  }
}
