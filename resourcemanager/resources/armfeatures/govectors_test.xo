// Generated from the output of a local Go program that calls every
// public method of each client of armfeatures v1.2.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_client_get_response(r: ClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.feature_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL Client.Get",
  "REQ GET https://management.example.test/subscriptions/sub-test/providers/Microsoft.Features/providers/id1%2F%20x/features/id2%2F%20x?api-version=2021-07-01",
  "  H accept=application/json, text/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"state\":\"s-state\"},\"type\":\"s-type\"}",
  "OUT: body={\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"state\":\"s-state\"},\"type\":\"s-type\"}",
]

test "Go's Client.Get" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"state\":\"s-state\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL Client.Get")
  match c.get("id1/ x", "id2/ x", ClientGetOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_client_get_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

