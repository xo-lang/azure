    return Err(sp.fail(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  let out = applications_update_by_id_handle(resp) ?? e => return Err(sp.fail(azcore.CallErr.Decode(e)))
  sp.end()
  Ok(out)
}
