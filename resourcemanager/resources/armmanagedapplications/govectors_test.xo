  "CALL ApplicationClient.NewListOperationsPager",
  "REQ GET https://management.example.test/providers/Microsoft.Solutions/operations?api-version=2018-06-01",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\"}]}",
  "OUT page 1: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\"}]}",
  "REQ GET https://management.example.test/next?%24skiptoken=2",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\"}]}",
]

test "Go's ApplicationClient.NewListOperationsPager" {
  let f = gv_new_fake(os.net)
  let c = new_application_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"display\":{\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"name\":\"s-name\"}]}")
  gv_note(f, "CALL ApplicationClient.NewListOperationsPager")
  var pg = c.new_list_operations_pager(ApplicationClientListOperationsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_application_client_list_operations_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_0)
}

