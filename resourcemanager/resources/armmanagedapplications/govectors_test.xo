fn show_applications_client_update_by_id_response(r: ApplicationsClientUpdateByIDResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.application).to_str_lossy()}")
  parts.join(" ")
}

