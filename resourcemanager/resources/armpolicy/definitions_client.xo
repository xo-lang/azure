/// This operation deletes the policy definition in the given subscription with the given name.
pub fn (c: DefinitionsClient) delete(policy_definition_name: Str, options: DefinitionsClientDeleteOptions = DefinitionsClientDeleteOptions{}) -> DefinitionsClientDeleteResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.delete_create_request(policy_definition_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 204].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  definitions_delete_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
