}

fn show_tokens_client_acquire_at_management_group_response(r: TokensClientAcquireAtManagementGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.token_response).to_str_lossy()}")
  parts.join(" ")
}

