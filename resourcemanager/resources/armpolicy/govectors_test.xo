test "Go's SetDefinitionVersionsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_set_definition_versions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"metadata\":{\"k\":\"v\"},\"parameters\":{\"k1\":{\"allowedValues\":[{\"k\":\"v\"}],\"defaultValue\":{\"k\":\"v\"},\"metadata\":{\"assignPermissions\":true,\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"k1\":{\"k\":\"v\"},\"strongType\":\"s-strongtype\"},\"schema\":{\"k\":\"v\"},\"type\":\"s-type\"}},\"policyDefinitionGroups\":[{\"additionalMetadataId\":\"s-additionalmetadataid\",\"category\":\"s-category\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"name\":\"s-name\"}],\"policyDefinitions\":[{\"definitionVersion\":\"s-definitionversion\",\"effectiveDefinitionVersion\":\"s-effectivedefinitionversion\",\"groupNames\":[\"s-groupnames\"],\"latestDefinitionVersion\":\"s-latestdefinitionversion\",\"policyDefinitionId\":\"s-policydefinitionid\",\"policyDefinitionReferenceId\":\"s-policydefinitionreferenceid\"}],\"policyType\":\"s-policytype\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SetDefinitionVersionsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", SetDefinitionVersionsClientListOptions{expand: Some("s-expand"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_set_definition_versions_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_49)
}

