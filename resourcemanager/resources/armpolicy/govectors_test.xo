test "Go's TokensClient.Acquire" {
  let f = gv_new_fake(os.net)
  let c = new_tokens_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"changeReference\":\"s-changereference\",\"expiration\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"requestDetails\":{\"apiVersion\":\"s-apiversion\",\"authorizationAction\":\"s-authorizationaction\",\"contentHash\":\"s-contenthash\",\"httpMethod\":\"s-httpmethod\",\"resourceId\":\"s-resourceid\",\"uri\":\"s-uri\"},\"result\":\"s-result\",\"results\":[{\"additionalInfo\":{\"k\":\"v\"},\"claims\":{\"k\":\"v\"},\"endpointKind\":\"s-endpointkind\",\"expiration\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"policyAction\":\"s-policyaction\",\"policyEvaluationDetails\":{\"k\":\"v\"},\"policyInfo\":{\"policyAssignmentId\":\"s-policyassignmentid\",\"policyAssignmentName\":\"s-policyassignmentname\",\"policyAssignmentScope\":\"s-policyassignmentscope\",\"policyAssignmentVersion\":\"s-policyassignmentversion\",\"policyDefinitionEffect\":\"s-policydefinitioneffect\",\"policyDefinitionId\":\"s-policydefinitionid\",\"policyDefinitionName\":\"s-policydefinitionname\",\"policyDefinitionReferenceId\":\"s-policydefinitionreferenceid\",\"policyDefinitionVersion\":\"s-policydefinitionversion\",\"policySetDefinitionId\":\"s-policysetdefinitionid\",\"policySetDefinitionName\":\"s-policysetdefinitionname\",\"policySetDefinitionVersion\":\"s-policysetdefinitionversion\"},\"result\":\"s-result\",\"retryAfter\":\"2026-11-06T10:00:00Z\"}],\"retryAfter\":\"2026-11-06T10:00:00Z\",\"token\":\"s-token\",\"tokenId\":\"s-tokenid\"}")
  gv_note(f, "CALL TokensClient.Acquire")
  match c.acquire((json.decode_str[TokenRequest]("{\"changeReference\":\"s-changereference\",\"operation\":{\"content\":{\"k\":\"v\"},\"httpMethod\":\"s-httpmethod\",\"uri\":\"s-uri\"}}") ?? e => fault("${e}")), TokensClientAcquireOptions{}) {
