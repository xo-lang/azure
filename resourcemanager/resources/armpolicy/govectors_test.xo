test "Go's AssignmentsClient.NewListForManagementGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_assignments_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"assignmentType\":\"s-assignmenttype\",\"definitionVersion\":\"s-definitionversion\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"effectiveDefinitionVersion\":\"s-effectivedefinitionversion\",\"enforcementMode\":\"s-enforcementmode\",\"instanceId\":\"s-instanceid\",\"latestDefinitionVersion\":\"s-latestdefinitionversion\",\"metadata\":{\"k\":\"v\"},\"nonComplianceMessages\":[{\"message\":\"s-message\",\"policyDefinitionReferenceId\":\"s-policydefinitionreferenceid\"}],\"notScopes\":[\"s-notscopes\"],\"overrides\":[{\"kind\":\"s-kind\",\"value\":\"s-value\"}],\"parameters\":{\"k1\":{\"value\":{\"k\":\"v\"}}},\"policyDefinitionId\":\"s-policydefinitionid\",\"resourceSelectors\":[{\"name\":\"s-name\"}],\"scope\":\"s-scope\",\"selfServeExemptionSettings\":{\"enabled\":true,\"policyDefinitionReferenceIds\":[\"s-policydefinitionreferenceids\"]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AssignmentsClient.NewListForManagementGroupPager")
  var pg = c.new_list_for_management_group_pager("id1/ x", AssignmentsClientListForManagementGroupOptions{expand: Some("s-expand"), filter: Some("s-filter"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_assignments_client_list_for_management_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_6)
}

