test "Go's DataPolicyManifestsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_data_policy_manifests_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"effects\":[{\"detailsSchema\":{\"k\":\"v\"},\"name\":\"s-name\"}],\"fieldValues\":[\"s-fieldvalues\"],\"isBuiltInOnly\":true,\"namespaces\":[\"s-namespaces\"],\"policyMode\":\"s-policymode\",\"resourceFunctions\":{\"custom\":[{\"allowCustomProperties\":true,\"fullyQualifiedResourceType\":\"s-fullyqualifiedresourcetype\",\"name\":\"s-name\"}],\"standard\":[\"s-standard\"]},\"resourceTypeAliases\":[{\"resourceType\":\"s-resourcetype\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DataPolicyManifestsClient.NewListPager")
  var pg = c.new_list_pager(DataPolicyManifestsClientListOptions{filter: Some("s-filter")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_data_policy_manifests_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_13)
}

