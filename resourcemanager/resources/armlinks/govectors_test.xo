test "Go's ResourceLinksClient.CreateOrUpdate" {
  let f = gv_new_fake(os.net)
  let c = new_resource_links_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"notes\":\"s-notes\",\"sourceId\":\"s-sourceid\",\"targetId\":\"s-targetid\"},\"type\":{\"k\":\"v\"}}")
  gv_note(f, "CALL ResourceLinksClient.CreateOrUpdate")
  match c.create_or_update("id1/ x", (json.decode_str[ResourceLink]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"notes\":\"s-notes\",\"sourceId\":\"s-sourceid\",\"targetId\":\"s-targetid\"},\"type\":{\"k\":\"v\"}}") ?? e => fault("${e}")), ResourceLinksClientCreateOrUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_resource_links_client_create_or_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_1)
}

