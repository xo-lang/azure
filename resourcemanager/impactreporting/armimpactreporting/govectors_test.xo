test "Go's ConnectorsClient.BeginCreateOrUpdate" {
  let f = gv_new_fake(os.net)
  let c = new_connectors_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"connectorId\":\"s-connectorid\",\"connectorType\":\"s-connectortype\",\"lastRunTimeStamp\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ConnectorsClient.BeginCreateOrUpdate")
  match c.begin_create_or_update("id1/ x", (json.decode_str[Connector]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"connectorId\":\"s-connectorid\",\"connectorType\":\"s-connectortype\",\"lastRunTimeStamp\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), ConnectorsClientBeginCreateOrUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_connectors_client_create_or_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

