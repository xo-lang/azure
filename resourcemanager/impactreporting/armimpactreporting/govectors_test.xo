  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"additionalProperties\":{\"k1\":{\"k\":\"v\"}},\"armCorrelationIds\":[\"s-armcorrelationids\"],\"clientIncidentDetails\":{\"clientIncidentId\":\"s-clientincidentid\",\"clientIncidentSource\":\"s-clientincidentsource\"},\"confidenceLevel\":\"s-confidencelevel\",\"connectivity\":{\"port\":7,\"protocol\":\"s-protocol\",\"source\":{\"azureResourceId\":\"s-azureresourceid\"},\"target\":{\"azureResourceId\":\"s-azureresourceid\"}},\"endDateTime\":\"2026-11-06T10:00:00Z\",\"errorDetails\":{\"errorCode\":\"s-errorcode\",\"errorMessage\":\"s-errormessage\"},\"impactCategory\":\"s-impactcategory\",\"impactDescription\":\"s-impactdescription\",\"impactGroupId\":\"s-impactgroupid\",\"impactUniqueId\":\"s-impactuniqueid\",\"impactedResourceId\":\"s-impactedresourceid\",\"performance\":[{\"actual\":1.5,\"expected\":1.5,\"expectedValueRange\":{\"max\":1.5,\"min\":1.5},\"metricName\":\"s-metricname\",\"unit\":\"s-unit\"}],\"provisioningState\":\"Succeeded\",\"reportedTimeUtc\":\"2026-11-06T10:00:00Z\",\"startDateTime\":\"2026-11-06T10:00:00Z\",\"workload\":{\"context\":\"s-context\",\"toolset\":\"s-toolset\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkloadImpactsClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(WorkloadImpactsClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workload_impacts_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_15)
}
