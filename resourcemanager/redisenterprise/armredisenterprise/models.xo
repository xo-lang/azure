/// MigrationPropertiesClassification: a MigrationProperties by its sourceType, Go's MigrationPropertiesClassification interface.
pub enum MigrationPropertiesClassification {
  /// sourceType "AzureCacheForRedis"
  AzureCacheForRedisMigrationProperties(from AzureCacheForRedisMigrationProperties)
  /// Any other sourceType, as the base type.
  MigrationProperties(from MigrationProperties)
} derive Json(via: json.Value, to: migration_properties_classification_json, from: parse_migration_properties_classification)

fn migration_properties_classification_json(c: MigrationPropertiesClassification) -> json.Value {
  match c {
    MigrationPropertiesClassification.AzureCacheForRedisMigrationProperties(x) => json.to_value(x)
    MigrationPropertiesClassification.MigrationProperties(x) => json.to_value(x)
  }
}

fn parse_migration_properties_classification(v: json.Value) -> MigrationPropertiesClassification ! json.DecodeErr {
  match v.get("sourceType") {
    Some(json.Value.Str("AzureCacheForRedis")) => Ok(MigrationPropertiesClassification.AzureCacheForRedisMigrationProperties(json.from_value[AzureCacheForRedisMigrationProperties](v)?))
    _ => Ok(MigrationPropertiesClassification.MigrationProperties(json.from_value[MigrationProperties](v)?))
  }
}

/// `v` with its discriminator `key` set to `value`, as Go's
/// MarshalJSON writes a subtype's (its keys sorted).
fn with_discriminator(v: json.Value, key: Str, value: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object((fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != key }) + [(key, json.Value.Str(value))]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    other => other
  }
}

