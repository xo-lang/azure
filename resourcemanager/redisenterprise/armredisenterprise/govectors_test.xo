test "Go's Client.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"encryption\":{\"customerManagedKeyEncryption\":{\"keyEncryptionKeyIdentity\":{\"identityType\":\"s-identitytype\",\"userAssignedIdentityResourceId\":\"s-userassignedidentityresourceid\"},\"keyEncryptionKeyUrl\":\"s-keyencryptionkeyurl\"}},\"highAvailability\":\"s-highavailability\",\"hostName\":\"s-hostname\",\"maintenanceConfiguration\":{\"maintenanceWindows\":[{\"duration\":\"s-duration\",\"startHourUtc\":7,\"type\":\"s-type\"}]},\"migratedEndpoint\":\"s-migratedendpoint\",\"minimumTlsVersion\":\"s-minimumtlsversion\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"redisVersion\":\"s-redisversion\",\"redundancyMode\":\"s-redundancymode\",\"resourceState\":\"s-resourcestate\"},\"sku\":{\"capacity\":7,\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
  gv_note(f, "CALL Client.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_9)
}

