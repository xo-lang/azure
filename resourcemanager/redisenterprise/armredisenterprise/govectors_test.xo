  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"skus\":[{\"name\":\"s-name\",\"sizeInGB\":1.5}]}")
  gv_note(f, "CALL Client.ListSKUsForScaling")
  match c.list_skus_for_scaling("id1/ x", "id2/ x", ClientListSKUsForScalingOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_client_list_sk_us_for_scaling_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_8)
}

fn show_client_list_by_resource_group_response(r: ClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cluster_list).to_str_lossy()}")
  parts.join(" ")
}

