  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"contacts\":[{\"email\":\"s-email\",\"name\":\"s-name\",\"url\":\"s-url\"}],\"customProperties\":{\"k\":\"v\"},\"description\":\"s-description\",\"externalDocumentation\":[{\"description\":\"s-description\",\"title\":\"s-title\",\"url\":\"s-url\"}],\"kind\":\"s-kind\",\"license\":{\"identifier\":\"s-identifier\",\"name\":\"s-name\",\"url\":\"s-url\"},\"lifecycleStage\":\"s-lifecyclestage\",\"summary\":\"s-summary\",\"termsOfService\":{\"url\":\"s-url\"},\"title\":\"s-title\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
