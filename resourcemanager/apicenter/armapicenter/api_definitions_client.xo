pub fn (c: APIDefinitionsClient[fx]) begin_import_specification(resource_group_name: Str, service_name: Str, workspace_name: Str, api_name: Str, version_name: Str, definition_name: Str, body: APISpecImportRequest, options: APIDefinitionsClientBeginImportSpecificationOptions = APIDefinitionsClientBeginImportSpecificationOptions{}) -> runtime.Poller[APIDefinitionsClientImportSpecificationResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "APIDefinitionsClientImportSpecificationResponse", fn(r: http.Response) -> APIDefinitionsClientImportSpecificationResponse ! Str { api_definitions_import_specification_handle(r) })
  }
  let req = c.import_specification_create_request(resource_group_name, service_name, workspace_name, api_name, version_name, definition_name, body, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "location", "APIDefinitionsClientImportSpecificationResponse", fn(r: http.Response) -> APIDefinitionsClientImportSpecificationResponse ! Str { api_definitions_import_specification_handle(r) })
}
