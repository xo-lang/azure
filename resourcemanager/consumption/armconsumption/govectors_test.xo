test "Go's ReservationRecommendationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_reservation_recommendations_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"previousLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"legacy\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"costWithNoReservedInstances\":1.5,\"firstUsageDate\":\"2026-11-06T10:00:00Z\",\"instanceFlexibilityGroup\":\"s-instanceflexibilitygroup\",\"instanceFlexibilityRatio\":1.5,\"lastUsageDate\":\"2026-11-06T10:00:00Z\",\"lookBackPeriod\":\"s-lookbackperiod\",\"managementGroupId\":\"s-managementgroupid\",\"meterId\":\"s-meterid\",\"netSavings\":1.5,\"normalizedSize\":\"s-normalizedsize\",\"recommendedQuantity\":1.5,\"recommendedQuantityNormalized\":1.5,\"resourceType\":\"s-resourcetype\",\"scope\":\"ManagementGroup\",\"tenantId\":\"s-tenantid\",\"term\":\"s-term\",\"totalCostWithReservedInstances\":1.5,\"totalHours\":7},\"sku\":\"s-sku\",\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ReservationRecommendationsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", ReservationRecommendationsClientListOptions{filter: Some("s-filter")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_reservation_recommendations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_21)
}

