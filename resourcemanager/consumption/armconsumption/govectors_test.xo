test "Go's UsageDetailsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_usage_details_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"legacy\",\"name\":\"s-name\",\"properties\":{\"accountName\":\"s-accountname\",\"accountOwnerId\":\"s-accountownerid\",\"additionalInfo\":\"s-additionalinfo\",\"benefitId\":\"s-benefitid\",\"benefitName\":\"s-benefitname\",\"billingAccountId\":\"s-billingaccountid\",\"billingAccountName\":\"s-billingaccountname\",\"billingCurrency\":\"s-billingcurrency\",\"billingPeriodEndDate\":\"2026-11-06T10:00:00Z\",\"billingPeriodStartDate\":\"2026-11-06T10:00:00Z\",\"billingProfileId\":\"s-billingprofileid\",\"billingProfileName\":\"s-billingprofilename\",\"chargeType\":\"s-chargetype\",\"consumedService\":\"s-consumedservice\",\"cost\":1.5,\"costCenter\":\"s-costcenter\",\"date\":\"2026-11-06T10:00:00Z\",\"effectivePrice\":1.5,\"frequency\":\"s-frequency\",\"invoiceSection\":\"s-invoicesection\",\"isAzureCreditEligible\":true,\"meterDetails\":{\"meterCategory\":\"s-metercategory\",\"meterName\":\"s-metername\",\"meterSubCategory\":\"s-metersubcategory\",\"serviceFamily\":\"s-servicefamily\",\"unitOfMeasure\":\"s-unitofmeasure\"},\"meterId\":\"s-meterid\",\"offerId\":\"s-offerid\",\"partNumber\":\"s-partnumber\",\"payGPrice\":1.5,\"planName\":\"s-planname\",\"pricingModel\":\"s-pricingmodel\",\"product\":\"s-product\",\"productOrderId\":\"s-productorderid\",\"productOrderName\":\"s-productordername\",\"publisherName\":\"s-publishername\",\"publisherType\":\"s-publishertype\",\"quantity\":1.5,\"reservationId\":\"s-reservationid\",\"reservationName\":\"s-reservationname\",\"resourceGroup\":\"s-resourcegroup\",\"resourceId\":\"s-resourceid\",\"resourceLocation\":\"s-resourcelocation\",\"resourceName\":\"s-resourcename\",\"serviceInfo1\":\"s-serviceinfo1\",\"serviceInfo2\":\"s-serviceinfo2\",\"subscriptionId\":\"s-subscriptionid\",\"subscriptionName\":\"s-subscriptionname\",\"term\":\"s-term\",\"unitPrice\":1.5},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL UsageDetailsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", UsageDetailsClientListOptions{expand: Some("s-expand"), filter: Some("s-filter"), metric: Some(Metrictype("s-metric")), skiptoken: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_usage_details_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_31)
}
