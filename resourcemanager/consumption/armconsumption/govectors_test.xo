test "Go's EventsClient.NewListByBillingProfilePager" {
  let f = gv_new_fake(os.net)
  let c = new_events_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"eTag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"adjustments\":{\"currency\":\"s-currency\",\"value\":1.5},\"adjustmentsInBillingCurrency\":{\"currency\":\"s-currency\",\"exchangeRate\":1.5,\"exchangeRateMonth\":7,\"value\":1.5},\"billingAccountDisplayName\":\"s-billingaccountdisplayname\",\"billingAccountId\":\"s-billingaccountid\",\"billingCurrency\":\"s-billingcurrency\",\"billingProfileDisplayName\":\"s-billingprofiledisplayname\",\"billingProfileId\":\"s-billingprofileid\",\"canceledCredit\":{\"currency\":\"s-currency\",\"value\":1.5},\"charges\":{\"currency\":\"s-currency\",\"value\":1.5},\"chargesInBillingCurrency\":{\"currency\":\"s-currency\",\"exchangeRate\":1.5,\"exchangeRateMonth\":7,\"value\":1.5},\"closedBalance\":{\"currency\":\"s-currency\",\"value\":1.5},\"closedBalanceInBillingCurrency\":{\"currency\":\"s-currency\",\"exchangeRate\":1.5,\"exchangeRateMonth\":7,\"value\":1.5},\"creditCurrency\":\"s-creditcurrency\",\"creditExpired\":{\"currency\":\"s-currency\",\"value\":1.5},\"creditExpiredInBillingCurrency\":{\"currency\":\"s-currency\",\"exchangeRate\":1.5,\"exchangeRateMonth\":7,\"value\":1.5},\"description\":\"s-description\",\"eTag\":\"s-etag\",\"eventType\":\"s-eventtype\",\"invoiceNumber\":\"s-invoicenumber\",\"isEstimatedBalance\":true,\"lotId\":\"s-lotid\",\"lotSource\":\"s-lotsource\",\"newCredit\":{\"currency\":\"s-currency\",\"value\":1.5},\"newCreditInBillingCurrency\":{\"currency\":\"s-currency\",\"exchangeRate\":1.5,\"exchangeRateMonth\":7,\"value\":1.5},\"reseller\":{\"resellerDescription\":\"s-resellerdescription\",\"resellerId\":\"s-resellerid\"},\"transactionDate\":\"2026-11-06T10:00:00Z\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EventsClient.NewListByBillingProfilePager")
  var pg = c.new_list_by_billing_profile_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", EventsClientListByBillingProfileOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_events_client_list_by_billing_profile_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_11)
}

fn show_lots_client_list_by_billing_account_response(r: LotsClientListByBillingAccountResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.lots).to_str_lossy()}")
  parts.join(" ")
}

