test "Go's ProvidersClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_providers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"attestUri\":\"s-attesturi\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"privateEndpoint\":{\"id\":\"s-id\"},\"privateLinkServiceConnectionState\":{\"actionsRequired\":\"s-actionsrequired\",\"description\":\"s-description\",\"status\":\"s-status\"},\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"status\":\"s-status\",\"tpmAttestationAuthentication\":\"s-tpmattestationauthentication\",\"trustModel\":\"s-trustmodel\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ProvidersClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[ServicePatchParams]("{\"properties\":{\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"tpmAttestationAuthentication\":\"s-tpmattestationauthentication\"},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), ProvidersClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_providers_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_13)
}
