test "Go's RequestsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_requests_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"accessLevel\":\"s-accesslevel\",\"createdDateTime\":\"2026-11-06T10:00:00Z\",\"duration\":\"s-duration\",\"expirationDateTime\":\"2026-11-06T10:00:00Z\",\"justification\":\"s-justification\",\"requestId\":\"s-requestid\",\"resourceIds\":\"s-resourceids\",\"resourceType\":\"s-resourcetype\",\"status\":\"s-status\",\"subscriptionId\":\"s-subscriptionid\",\"supportCaseUrl\":\"s-supportcaseurl\",\"supportRequest\":\"s-supportrequest\",\"workitemsource\":\"s-workitemsource\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RequestsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", RequestsClientListOptions{filter: Some("s-filter")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_requests_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_5)
}

