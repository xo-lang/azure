const GO_6: List[Str] = [
  "CALL RequestsClient.UpdateStatus",
  "REQ POST https://management.example.test/subscriptions/id1%2F%20x/providers/Microsoft.CustomerLockbox/requests/id2%2F%20x/updateApproval?api-version=2018-02-28-preview",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"reason\":\"s-reason\",\"status\":\"s-status\"}",
  "  SERVED 200 {\"reason\":\"s-reason\",\"status\":\"s-status\"}",
  "OUT: body={\"reason\":\"s-reason\",\"status\":\"s-status\"}",
]

test "Go's RequestsClient.UpdateStatus" {
  let f = gv_new_fake(os.net)
  let c = new_requests_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"reason\":\"s-reason\",\"status\":\"s-status\"}")
  gv_note(f, "CALL RequestsClient.UpdateStatus")
  match c.update_status("id1/ x", "id2/ x", (json.decode_str[Approval]("{\"reason\":\"s-reason\",\"status\":\"s-status\"}") ?? e => fault("${e}")), RequestsClientUpdateStatusOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_requests_client_update_status_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_6)
}
