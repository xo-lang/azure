// Generated from the output of a local Go program that calls every
// public method of each client of armcustomerlockbox v0.7.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_get_client_tenant_opted_in_response(r: GetClientTenantOptedInResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.tenant_opt_in_response).to_str_lossy()}")
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL GetClient.TenantOptedIn",
  "REQ GET https://management.example.test/providers/Microsoft.CustomerLockbox/tenantOptedIn/id1%2F%20x?api-version=2018-02-28-preview",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"isOptedIn\":true}",
  "OUT: body={\"isOptedIn\":true}",
]

test "Go's GetClient.TenantOptedIn" {
  let f = gv_new_fake(os.net)
  let c = new_get_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"isOptedIn\":true}")
  gv_note(f, "CALL GetClient.TenantOptedIn")
  match c.tenant_opted_in("id1/ x", GetClientTenantOptedInOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_get_client_tenant_opted_in_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

