fn show_service_principals_client_list_by_subscription_response(r: ServicePrincipalsClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.service_principal_list_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_36: List[Str] = [
  "CALL ServicePrincipalsClient.NewListBySubscriptionPager",
  "REQ GET https://management.example.test/subscriptions/sub-test/providers/Microsoft.Automanage/servicePrincipals?api-version=2022-05-04",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
