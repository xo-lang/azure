  let c = new_metadata_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"applicableScenarios\":[\"s-applicablescenarios\"],\"dependsOn\":[\"s-dependson\"],\"displayName\":\"s-displayname\",\"supportedValues\":[{\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"previousId\":\"s-previousid\",\"priority\":7,\"resourceTypes\":[\"s-resourcetypes\"],\"serviceGuid\":\"s-serviceguid\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL MetadataClient.NewListPager")
  var pg = c.new_list_pager(MetadataClientListOptions{}) ?? e => fault("${e}")
