test "Go's AvailabilityStatusesClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_availability_statuses_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"articleId\":\"s-articleid\",\"availabilityState\":\"s-availabilitystate\",\"category\":\"s-category\",\"context\":\"s-context\",\"detailedStatus\":\"s-detailedstatus\",\"healthEventCategory\":\"s-healtheventcategory\",\"healthEventCause\":\"s-healtheventcause\",\"healthEventId\":\"s-healtheventid\",\"healthEventType\":\"s-healtheventtype\",\"occuredTime\":\"2026-11-06T10:00:00Z\",\"reasonChronicity\":\"s-reasonchronicity\",\"reasonType\":\"s-reasontype\",\"recentlyResolved\":{\"resolvedTime\":\"2026-11-06T10:00:00Z\",\"unavailableOccuredTime\":\"2026-11-06T10:00:00Z\",\"unavailableSummary\":\"s-unavailabilitysummary\"},\"recommendedActions\":[{\"_ActionUrl.Comment\":\"s-actionurlcomment\",\"action\":\"s-action\",\"actionUrl\":\"s-actionurl\",\"actionUrlText\":\"s-actionurltext\"}],\"reportedTime\":\"2026-11-06T10:00:00Z\",\"resolutionETA\":\"2026-11-06T10:00:00Z\",\"rootCauseAttributionTime\":\"2026-11-06T10:00:00Z\",\"serviceImpactingEvents\":[{\"correlationId\":\"s-correlationid\",\"eventStartTime\":\"2026-11-06T10:00:00Z\",\"eventStatusLastModifiedTime\":\"2026-11-06T10:00:00Z\",\"incidentProperties\":{\"incidentType\":\"s-incidenttype\",\"region\":\"s-region\",\"service\":\"s-service\",\"title\":\"s-title\"},\"status\":{\"value\":\"s-value\"}}],\"summary\":\"s-summary\",\"title\":\"s-title\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AvailabilityStatusesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", AvailabilityStatusesClientListByResourceGroupOptions{expand: Some("s-expand"), filter: Some("s-filter")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_availability_statuses_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_1)
}

