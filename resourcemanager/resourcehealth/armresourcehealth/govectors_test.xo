  let c = new_emerging_issues_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"refreshTimestamp\":\"2026-11-06T10:00:00Z\",\"statusActiveEvents\":[{\"cloud\":\"s-cloud\",\"description\":\"s-description\",\"lastModifiedTime\":\"2026-11-06T10:00:00Z\",\"published\":true,\"severity\":\"s-severity\",\"stage\":\"s-stage\",\"startTime\":\"2026-11-06T10:00:00Z\",\"title\":\"s-title\",\"trackingId\":\"s-trackingid\"}],\"statusBanners\":[{\"cloud\":\"s-cloud\",\"lastModifiedTime\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"title\":\"s-title\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EmergingIssuesClient.NewListPager")
  var pg = c.new_list_pager(EmergingIssuesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_emerging_issues_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_8)
}

