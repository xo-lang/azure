  gv_note(f, "CALL AvailabilityStatusesClient.GetByResource")
  match c.get_by_resource("id1/ x", AvailabilityStatusesClientGetByResourceOptions{expand: Some("s-expand"), filter: Some("s-filter")}) {
    Ok(r) => gv_note(f, "OUT: ${show_availability_statuses_client_get_by_resource_response(r)}")
