test "Go's ServerInstancesClient.NewListBySapInstancePager" {
  let f = gv_new_fake(os.net)
  let c = new_server_instances_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"configurationData\":{\"cpu\":7,\"cpuInMhz\":7,\"cpuType\":\"s-cputype\",\"databaseType\":\"s-databasetype\",\"hardwareManufacturer\":\"s-hardwaremanufacturer\",\"model\":\"s-model\",\"ram\":7,\"saps\":7,\"targetHanaRamSizeGB\":7,\"totalDiskIops\":7,\"totalDiskSizeGB\":7},\"errors\":{\"properties\":{\"code\":\"s-code\",\"message\":\"s-message\",\"recommendation\":\"s-recommendation\"}},\"instanceSid\":\"s-instancesid\",\"operatingSystem\":\"s-operatingsystem\",\"performanceData\":{\"dataSource\":\"Excel\",\"maxCpuLoad\":7,\"totalSourceDbSizeGB\":7},\"provisioningState\":\"Succeeded\",\"sapInstanceType\":\"s-sapinstancetype\",\"sapProduct\":\"s-sapproduct\",\"sapProductVersion\":\"s-sapproductversion\",\"serverName\":\"s-servername\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ServerInstancesClient.NewListBySapInstancePager")
  var pg = c.new_list_by_sap_instance_pager("id1/ x", "id2/ x", "id3/ x", ServerInstancesClientListBySapInstanceOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_server_instances_client_list_by_sap_instance_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_16)
}

