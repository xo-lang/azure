test "Go's SitesClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_sites_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"labels\":{\"k1\":\"s-labels\"},\"provisioningState\":\"Succeeded\",\"siteAddress\":{\"city\":\"s-city\",\"country\":\"s-country\",\"postalCode\":\"s-postalcode\",\"stateOrProvince\":\"s-stateorprovince\",\"streetAddress1\":\"s-streetaddress1\",\"streetAddress2\":\"s-streetaddress2\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL SitesClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[SiteUpdate]("{\"properties\":{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"labels\":{\"k1\":\"s-labels\"},\"siteAddress\":{\"city\":\"s-city\",\"country\":\"s-country\",\"postalCode\":\"s-postalcode\",\"stateOrProvince\":\"s-stateorprovince\",\"streetAddress1\":\"s-streetaddress1\",\"streetAddress2\":\"s-streetaddress2\"}}}") ?? e => fault("${e}")), SitesClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_sites_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_14)
}
