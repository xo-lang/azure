    },
    size: match m.size {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    family: match m.family {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    capacity: match m.capacity {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
