test "Go's MaintenancesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_maintenances_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"activities\":[{\"component\":\"s-component\",\"impact\":\"s-impact\",\"infoLink\":\"https://management.example.test/next?\$skiptoken=2\",\"kind\":\"s-kind\",\"version\":\"s-version\"}],\"clusterId\":7,\"component\":\"s-component\",\"displayName\":\"s-displayname\",\"estimatedDurationInMinutes\":7,\"group\":{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\"},\"impact\":\"s-impact\",\"infoLink\":\"https://management.example.test/next?\$skiptoken=2\",\"maintenanceReadiness\":{\"failedChecks\":[{\"name\":\"s-name\"}],\"lastUpdated\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"status\":\"s-status\",\"type\":\"s-type\"},\"operations\":[{\"disabledReason\":\"s-disabledreason\",\"isDisabled\":true,\"kind\":\"MaintenanceReadinessRefresh\",\"message\":\"s-message\",\"refreshedByMicrosoft\":true,\"status\":\"s-status\"}],\"provisioningState\":\"Succeeded\",\"relationships\":{\"dependencies\":[\"s-dependencies\"],\"prerequisites\":[\"s-prerequisites\"]},\"scheduledByMicrosoft\":true,\"scheduledStartTime\":\"2026-11-06T10:00:00Z\",\"state\":{\"endedAt\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"name\":\"s-name\",\"startedAt\":\"2026-11-06T10:00:00Z\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL MaintenancesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", MaintenancesClientListOptions{from: Some((json.decode_str[azcore.DateTimeUTC]("\"2026-11-06T10:00:00Z\"") ?? e => fault("${e}"))), state_name: Some(MaintenanceStateName("s-statename")), status: Some(MaintenanceStatusFilter("s-status")), to: Some((json.decode_str[azcore.DateTimeUTC]("\"2026-11-06T10:00:00Z\"") ?? e => fault("${e}")))}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_maintenances_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_46)
}

