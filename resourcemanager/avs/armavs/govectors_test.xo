test "Go's PlacementPoliciesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_placement_policies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"affinityStrength\":\"s-affinitystrength\",\"affinityType\":\"s-affinitytype\",\"azureHybridBenefitType\":\"s-azurehybridbenefittype\",\"displayName\":\"s-displayname\",\"hostMembers\":[\"s-hostmembers\"],\"provisioningState\":\"Succeeded\",\"state\":\"s-state\",\"type\":\"VmHost\",\"vmMembers\":[\"s-vmmembers\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PlacementPoliciesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", PlacementPoliciesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_placement_policies_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_54)
}

fn show_private_clouds_client_create_or_update_response(r: PrivateCloudsClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.private_cloud).to_str_lossy()}")
  parts.join(" ")
}

