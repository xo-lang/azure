test "Go's ServicesClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_services_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"correlationScheme\":[{\"scheme\":\"s-scheme\",\"serviceName\":\"s-servicename\"}],\"defaultMoveCost\":\"s-defaultmovecost\",\"hasPersistedState\":true,\"minReplicaSetSize\":7,\"partitionDescription\":{\"names\":[\"s-names\"],\"partitionScheme\":\"Named\"},\"placementConstraints\":\"s-placementconstraints\",\"provisioningState\":\"Succeeded\",\"quorumLossWaitDuration\":\"s-quorumlosswaitduration\",\"replicaRestartWaitDuration\":\"s-replicarestartwaitduration\",\"scalingPolicies\":[{\"scalingMechanism\":{\"kind\":\"AddRemoveIncrementalNamedPartition\",\"maxPartitionCount\":7,\"minPartitionCount\":7,\"scaleIncrement\":7},\"scalingTrigger\":{\"kind\":\"AveragePartitionLoadTrigger\",\"lowerLoadThreshold\":1.5,\"metricName\":\"s-metricname\",\"scaleInterval\":\"s-scaleinterval\",\"upperLoadThreshold\":1.5}}],\"serviceDnsName\":\"s-servicednsname\",\"serviceKind\":\"Stateful\",\"serviceLoadMetrics\":[{\"defaultLoad\":7,\"name\":\"s-name\",\"primaryDefaultLoad\":7,\"secondaryDefaultLoad\":7,\"weight\":\"s-weight\"}],\"servicePackageActivationMode\":\"s-servicepackageactivationmode\",\"servicePlacementPolicies\":[{\"domainName\":\"s-domainname\",\"type\":\"InvalidDomain\"}],\"servicePlacementTimeLimit\":\"s-serviceplacementtimelimit\",\"serviceTypeName\":\"s-servicetypename\",\"standByReplicaKeepDuration\":\"s-standbyreplicakeepduration\",\"targetReplicaSetSize\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ServicesClient.Update")
  match c.update("id1/ x", "id2/ x", "id3/ x", "id4/ x", (json.decode_str[ServiceUpdateParameters]("{\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), ServicesClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_services_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_56)
}
