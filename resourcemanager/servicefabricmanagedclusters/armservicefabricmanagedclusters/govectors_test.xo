test "Go's ServicesClient.NewListByApplicationsPager" {
  let f = gv_new_fake(os.net)
  let c = new_services_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"correlationScheme\":[{\"scheme\":\"s-scheme\",\"serviceName\":\"s-servicename\"}],\"defaultMoveCost\":\"s-defaultmovecost\",\"hasPersistedState\":true,\"minReplicaSetSize\":7,\"partitionDescription\":{\"partitionScheme\":\"Named\"},\"placementConstraints\":\"s-placementconstraints\",\"provisioningState\":\"Succeeded\",\"quorumLossWaitDuration\":\"s-quorumlosswaitduration\",\"replicaRestartWaitDuration\":\"s-replicarestartwaitduration\",\"scalingPolicies\":[{\"scalingMechanism\":{\"kind\":\"AddRemoveIncrementalNamedPartition\",\"maxPartitionCount\":7,\"minPartitionCount\":7,\"scaleIncrement\":7},\"scalingTrigger\":{\"kind\":\"AveragePartitionLoadTrigger\",\"lowerLoadThreshold\":1.5,\"metricName\":\"s-metricname\",\"scaleInterval\":\"s-scaleinterval\",\"upperLoadThreshold\":1.5}}],\"serviceDnsName\":\"s-servicednsname\",\"serviceKind\":\"Stateful\",\"serviceLoadMetrics\":[{\"defaultLoad\":7,\"name\":\"s-name\",\"primaryDefaultLoad\":7,\"secondaryDefaultLoad\":7,\"weight\":\"s-weight\"}],\"servicePackageActivationMode\":\"s-servicepackageactivationmode\",\"servicePlacementPolicies\":[{\"domainName\":\"s-domainname\",\"type\":\"InvalidDomain\"}],\"servicePlacementTimeLimit\":\"s-serviceplacementtimelimit\",\"serviceTypeName\":\"s-servicetypename\",\"standByReplicaKeepDuration\":\"s-standbyreplicakeepduration\",\"targetReplicaSetSize\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ServicesClient.NewListByApplicationsPager")
  var pg = c.new_list_by_applications_pager("id1/ x", "id2/ x", "id3/ x", ServicesClientListByApplicationsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_services_client_list_by_applications_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_55)
}

fn show_services_client_update_response(r: ServicesClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.service_resource).to_str_lossy()}")
  parts.join(" ")
}

