fn show_managed_clusters_client_get_response(r: ManagedClustersClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.managed_cluster).to_str_lossy()}")
  parts.join(" ")
}

