test "Go's ApplicationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_applications_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"managedIdentities\":[{\"name\":\"s-name\",\"principalId\":\"s-principalid\"}],\"parameters\":{\"k1\":\"s-parameters\"},\"provisioningState\":\"Succeeded\",\"upgradePolicy\":{\"applicationHealthPolicy\":{\"considerWarningAsError\":true,\"defaultServiceTypeHealthPolicy\":{\"maxPercentUnhealthyPartitionsPerService\":7,\"maxPercentUnhealthyReplicasPerPartition\":7,\"maxPercentUnhealthyServices\":7},\"maxPercentUnhealthyDeployedApplications\":7},\"forceRestart\":true,\"instanceCloseDelayDuration\":7,\"recreateApplication\":true,\"rollingUpgradeMonitoringPolicy\":{\"failureAction\":\"s-failureaction\",\"healthCheckRetryTimeout\":\"s-healthcheckretrytimeout\",\"healthCheckStableDuration\":\"s-healthcheckstableduration\",\"healthCheckWaitDuration\":\"s-healthcheckwaitduration\",\"upgradeDomainTimeout\":\"s-upgradedomaintimeout\",\"upgradeTimeout\":\"s-upgradetimeout\"},\"upgradeMode\":\"s-upgrademode\",\"upgradeReplicaSetCheckTimeout\":7},\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ApplicationsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ApplicationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_applications_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_20)
}

