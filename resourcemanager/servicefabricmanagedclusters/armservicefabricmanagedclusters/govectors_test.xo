fn show_node_types_client_list_by_managed_clusters_response(r: NodeTypesClientListByManagedClustersResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.node_type_list_result).to_str_lossy()}")
  parts.join(" ")
}

