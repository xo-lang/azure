  /// Indicates whether warnings are treated with the same severity as errors.
  pub consider_warning_as_error as "considerWarningAsError,omitempty": Bool? = None
  /// The health policy used by default to evaluate the health of a service type.
  pub default_service_type_health_policy as "defaultServiceTypeHealthPolicy,omitempty": RuntimeServiceTypeHealthPolicy? = None
  /// The maximum allowed percentage of unhealthy deployed applications. Allowed values are Byte values from zero to 100. The percentage represents the maximum tolerated percentage of deployed applications that can be unhealthy before the application is considered in error. This is calculated by dividing the number of unhealthy deployed applications over the number of nodes where the application is currently deployed on in the cluster. The computation rounds up to tolerate one failure on small numbers of nodes. Default percentage is zero.
  pub max_percent_unhealthy_deployed_applications as "maxPercentUnhealthyDeployedApplications,omitempty": Int? = None
  /// The map with service type health policy per service type name. The map is empty by default.
  pub service_type_health_policy_map as "serviceTypeHealthPolicyMap,omitempty": Map[Str, RuntimeServiceTypeHealthPolicy]? = None
} derive Json

/// Describes the parameters for updating a rolling upgrade of application or cluster.
pub struct RuntimeRollingUpgradeUpdateMonitoringPolicy {
  /// The compensating action to perform when a Monitored upgrade encounters monitoring policy or health policy violations. Invalid indicates the failure action is invalid. Rollback specifies that the upgrade will start rolling back automatically. Manual indicates that the upgrade will switch to UnmonitoredManual upgrade mode
  pub failure_action as "failureAction,omitempty": RuntimeFailureAction? = None
  /// If true, then processes are forcefully restarted during upgrade even when the code version has not changed (the upgrade only changes configuration or data).
  pub force_restart as "forceRestart,omitempty": Bool? = None
  /// The amount of time to retry health evaluation when the application or cluster is unhealthy before FailureAction is executed. It is first interpreted as a string representing an ISO 8601 duration. If that fails, then it is interpreted as a number representing the total number of milliseconds.
  pub health_check_retry_timeout_in_milliseconds as "healthCheckRetryTimeoutInMilliseconds,omitempty": Str? = None
  /// The amount of time that the application or cluster must remain healthy before the upgrade proceeds to the next upgrade domain. It is first interpreted as a string representing an ISO 8601 duration. If that fails, then it is interpreted as a number representing the total number of milliseconds.
  pub health_check_stable_duration_in_milliseconds as "healthCheckStableDurationInMilliseconds,omitempty": Str? = None
  /// The amount of time to wait after completing an upgrade domain before applying health policies. It is first interpreted as a string representing an ISO 8601 duration. If that fails, then it is interpreted as a number representing the total number of milliseconds.
  pub health_check_wait_duration_in_milliseconds as "healthCheckWaitDurationInMilliseconds,omitempty": Str? = None
  /// Duration in seconds, to wait before a stateless instance is closed, to allow the active requests to drain gracefully. This would be effective when the instance is closing during the application/cluster upgrade, only for those instances which have a non-zero delay duration configured in the service description.
  pub instance_close_delay_duration_in_seconds as "instanceCloseDelayDurationInSeconds,omitempty": Int? = None
  /// The maximum amount of time to block processing of an upgrade domain and prevent loss of availability when there are unexpected issues. When this timeout expires, processing of the upgrade domain will proceed regardless of availability loss issues. The timeout is reset at the start of each upgrade domain. Valid values are between 0 and 42949672925 inclusive. (unsigned 32-bit integer).
  pub replica_set_check_timeout_in_milliseconds as "replicaSetCheckTimeoutInMilliseconds,omitempty": Int? = None
  /// The mode used to monitor health during a rolling upgrade.
  pub rolling_upgrade_mode as "rollingUpgradeMode,omitempty": RuntimeRollingUpgradeMode? = None
  /// The amount of time each upgrade domain has to complete before FailureAction is executed. It is first interpreted as a string representing an ISO 8601 duration. If that fails, then it is interpreted as a number representing the total number of milliseconds.
  pub upgrade_domain_timeout_in_milliseconds as "upgradeDomainTimeoutInMilliseconds,omitempty": Str? = None
  /// The amount of time the overall upgrade has to complete before FailureAction is executed. It is first interpreted as a string representing an ISO 8601 duration. If that fails, then it is interpreted as a number representing the total number of milliseconds.
  pub upgrade_timeout_in_milliseconds as "upgradeTimeoutInMilliseconds,omitempty": Str? = None
} derive Json

