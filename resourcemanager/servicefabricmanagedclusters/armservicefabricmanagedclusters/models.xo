  /// The capacity tags applied to the nodes in the node type, the cluster resource manager uses these tags to understand how much resource a node has.
  pub capacities as "capacities,omitempty": Map[Str, Str]? = None
  /// Specifies the computer name prefix. Limited to 9 characters. If specified, allows for a longer name to be specified for the node type name.
  pub computer_name_prefix as "computerNamePrefix,omitempty": Str? = None
  /// Managed data disk letter. It can not use the reserved letter C or D and it can not change after created.
  pub data_disk_letter as "dataDiskLetter,omitempty": Str? = None
  /// Disk size for the managed disk attached to the vms on the node type in GBs.
  pub data_disk_size_gb as "dataDiskSizeGB,omitempty": Int? = None
  /// Managed data disk type. Specifies the storage account type for the managed disk
  pub data_disk_type as "dataDiskType,omitempty": DiskType? = None
  /// Specifies the resource id of the DSCP configuration to apply to the node type network interface.
  pub dscp_configuration_id as "dscpConfigurationId,omitempty": Str? = None
  /// Specifies whether the network interface is accelerated networking-enabled.
  pub enable_accelerated_networking as "enableAcceleratedNetworking,omitempty": Bool? = None
  /// Enable or disable the Host Encryption for the virtual machines on the node type. This will enable the encryption for all the disks including Resource/Temp disk at host itself. Default: The Encryption at host will be disabled unless this property is set to true for the resource.
  pub enable_encryption_at_host as "enableEncryptionAtHost,omitempty": Bool? = None
  /// Specifies whether each node is allocated its own public IPv4 address. This is only supported on secondary node types with custom Load Balancers.
  pub enable_node_public_ip as "enableNodePublicIP,omitempty": Bool? = None
  /// Specifies whether each node is allocated its own public IPv6 address. This is only supported on secondary node types with custom Load Balancers.
  pub enable_node_public_i_pv6 as "enableNodePublicIPv6,omitempty": Bool? = None
  /// Specifies whether the node type should be overprovisioned. It is only allowed for stateless node types.
  pub enable_over_provisioning as "enableOverProvisioning,omitempty": Bool? = None
  /// Specifies whether the node type should use a resilient ephemeral OS disk when using a supported SKU size. A resilient ephemeral OS disk provides improved reliability for ephemeral OS disks by enabling full caching.
  pub enable_resilient_ephemeral_os_disk as "enableResilientEphemeralOsDisk,omitempty": Bool? = None
  /// The range of ephemeral ports that nodes in this node type should be configured with.
  pub ephemeral_ports as "ephemeralPorts,omitempty": EndpointRangeDescription? = None
  /// Specifies the eviction policy for virtual machines in a SPOT node type. Default is Delete.
  pub eviction_policy as "evictionPolicy,omitempty": EvictionPolicyType? = None
  /// Indicates the node type uses its own frontend configurations instead of the default one for the cluster. This setting can only be specified for non-primary node types and can not be added or removed after the node type is created.
  pub frontend_configurations as "frontendConfigurations,omitempty": List[FrontendConfiguration]? = None
  /// Specifies the full host group resource Id. This property is used for deploying on azure dedicated hosts.
  pub host_group_id as "hostGroupId,omitempty": Str? = None
  /// Specifies the node type should be configured for only outbound traffic and not inbound traffic.
  pub is_outbound_only as "isOutboundOnly,omitempty": Bool? = None
  /// Indicates the Service Fabric system services for the cluster will run on this node type. This setting cannot be changed once the node type is created.
  pub is_primary as "isPrimary,omitempty": Bool? = None
  /// Indicates whether the node type will be Spot Virtual Machines. Azure will allocate the VMs if there is capacity available and the VMs can be evicted at any time.
  pub is_spot_vm as "isSpotVM,omitempty": Bool? = None
  /// Indicates if the node type can only host Stateless workloads.
  pub is_stateless as "isStateless,omitempty": Bool? = None
  /// Indicates if scale set associated with the node type can be composed of multiple placement groups.
  pub multiple_placement_groups as "multiplePlacementGroups,omitempty": Bool? = None
  /// Specifies the NAT configuration on default public Load Balancer for the node type. This is only supported for node types use the default public Load Balancer.
  pub nat_configurations as "natConfigurations,omitempty": List[NodeTypeNatConfig]? = None
  /// Specifies the resource id of a NAT Gateway to attach to the subnet of this node type. Node type must use custom load balancer.
  pub nat_gateway_id as "natGatewayId,omitempty": Str? = None
  /// The Network Security Rules for this node type. This setting can only be specified for node types that are configured with frontend configurations.
  pub network_security_rules as "networkSecurityRules,omitempty": List[NetworkSecurityRule]? = None
  /// The placement tags applied to nodes in the node type, which can be used to indicate where certain services (workload) should run.
  pub placement_properties as "placementProperties,omitempty": Map[Str, Str]? = None
  /// The provisioning state of the node type resource.
  pub provisioning_state as "provisioningState,omitempty": ManagedResourceProvisioningState? = None
  /// Specifies whether secure boot should be enabled on the nodeType. Can only be used with TrustedLaunch and ConfidentialVM SecurityType.
  pub secure_boot_enabled as "secureBootEnabled,omitempty": Bool? = None
  /// Specifies the EncryptionType of the managed disk. It is set to DiskWithVMGuestState for encryption of the managed disk along with VMGuestState blob and VMGuestStateOnly for encryption of just the VMGuestState blob. Note: It can be set for only Confidential VMs.
  pub security_encryption_type as "securityEncryptionType,omitempty": SecurityEncryptionType? = None
  /// Specifies the security type of the nodeType. Supported values include Standard, TrustedLaunch and ConfidentialVM.
  pub security_type as "securityType,omitempty": SecurityType? = None
  /// Specifies the service artifact reference id used to set same image version for all virtual machines in the scale set when using 'latest' image version.
  pub service_artifact_reference_id as "serviceArtifactReferenceId,omitempty": Str? = None
  /// Indicates the time duration after which the platform will not try to restore the VMSS SPOT instances specified as ISO 8601.
  pub spot_restore_timeout as "spotRestoreTimeout,omitempty": Str? = None
  /// Indicates the resource id of the subnet for the node type.
  pub subnet_id as "subnetId,omitempty": Str? = None
  /// Specifies whether the use public load balancer. If not specified and the node type doesn't have its own frontend configuration, it will be attached to the default load balancer. If the node type uses its own Load balancer and useDefaultPublicLoadBalancer is true, then the frontend has to be an Internal Load Balancer. If the node type uses its own Load balancer and useDefaultPublicLoadBalancer is false or not set, then the custom load balancer must include a public load balancer to provide outbound connectivity.
  pub use_default_public_load_balancer as "useDefaultPublicLoadBalancer,omitempty": Bool? = None
  /// Indicates whether to use ephemeral os disk. The sku selected on the vmSize property needs to support this feature.
  pub use_ephemeral_os_disk as "useEphemeralOSDisk,omitempty": Bool? = None
  /// Specifies whether to use the temporary disk for the service fabric data root, in which case no managed data disk will be attached and the temporary disk will be used. It is only allowed for stateless node types.
  pub use_temp_data_disk as "useTempDataDisk,omitempty": Bool? = None
  /// Specifies the gallery applications that should be made available to the underlying VMSS.
  pub vm_applications as "vmApplications,omitempty": List[VMApplication]? = None
  /// Set of extensions that should be installed onto the virtual machines.
  pub vm_extensions as "vmExtensions,omitempty": List[VMSSExtension]? = None
  /// The offer type of the Azure Virtual Machines Marketplace image. For example, UbuntuServer or WindowsServer.
  pub vm_image_offer as "vmImageOffer,omitempty": Str? = None
  /// Specifies information about the marketplace image used to create the virtual machine. This element is only used for marketplace images. Before you can use a marketplace image from an API, you must enable the image for programmatic use. In the Azure portal, find the marketplace image that you want to use and then click Want to deploy programmatically, Get Started ->. Enter any required information and then click Save.
  pub vm_image_plan as "vmImagePlan,omitempty": VMImagePlan? = None
  /// The publisher of the Azure Virtual Machines Marketplace image. For example, Canonical or MicrosoftWindowsServer.
