    ServicePlacementPolicyClassification.ServicePlacementRequireDomainDistributionPolicy(x) => json.to_value(x)
    ServicePlacementPolicyClassification.ServicePlacementRequiredDomainPolicy(x) => json.to_value(x)
    ServicePlacementPolicyClassification.ServicePlacementPolicy(x) => json.to_value(x)
