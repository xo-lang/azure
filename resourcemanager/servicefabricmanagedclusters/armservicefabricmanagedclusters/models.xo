    Some(json.Value.Str("PreferredPrimaryDomain")) => Ok(ServicePlacementPolicyClassification.ServicePlacementPreferPrimaryDomainPolicy(json.from_value[ServicePlacementPreferPrimaryDomainPolicy](v)?))
    Some(json.Value.Str("RequiredDomainDistribution")) => Ok(ServicePlacementPolicyClassification.ServicePlacementRequireDomainDistributionPolicy(json.from_value[ServicePlacementRequireDomainDistributionPolicy](v)?))
    Some(json.Value.Str("RequiredDomain")) => Ok(ServicePlacementPolicyClassification.ServicePlacementRequiredDomainPolicy(json.from_value[ServicePlacementRequiredDomainPolicy](v)?))
    _ => Ok(ServicePlacementPolicyClassification.ServicePlacementPolicy(json.from_value[ServicePlacementPolicy](v)?))
