/// `v` with its discriminator `key` set to `value`, as Go's
/// MarshalJSON writes a subtype's (its keys sorted).
fn with_discriminator(v: json.Value, key: Str, value: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object((fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != key }) + [(key, json.Value.Str(value))]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    other => other
  }
}

/// Operation supported by the Service Fabric resource provider
pub struct AvailableOperationDisplay {
  /// Operation description
  pub description as "description,omitempty": Str? = None
  /// The operation that can be performed.
  pub operation as "operation,omitempty": Str? = None
  /// The name of the provider.
  pub provider as "provider,omitempty": Str? = None
  /// The resource on which the operation is performed
  pub resource as "resource,omitempty": Str? = None
} derive Json

