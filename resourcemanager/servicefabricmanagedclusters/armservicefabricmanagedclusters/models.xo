  /// The SKU of the Azure Virtual Machines Marketplace image. For example, 14.04.0-LTS or 2012-R2-Datacenter.
  pub vm_image_sku as "vmImageSku,omitempty": Str? = None
  /// The version of the Azure Virtual Machines Marketplace image. A value of 'latest' can be specified to select the latest version of an image. If omitted, the default is 'latest'.
  pub vm_image_version as "vmImageVersion,omitempty": Str? = None
  /// The number of nodes in the node type. **Values:** -1 - Use when auto scale rules are configured or sku.capacity is defined 0 - Not supported >0 - Use for manual scale.
  pub vm_instance_count as "vmInstanceCount,omitempty": Int? = None
  /// Identities to assign to the virtual machine scale set under the node type.
  pub vm_managed_identity as "vmManagedIdentity,omitempty": VMManagedIdentity? = None
  /// The secrets to install in the virtual machines.
  pub vm_secrets as "vmSecrets,omitempty": List[VaultSecretGroup]? = None
  /// Specifies the actions to be performed on the vms before bootstrapping the service fabric runtime.
  pub vm_setup_actions as "vmSetupActions,omitempty": List[VMSetupAction]? = None
  /// Indicates the resource id of the vm shared galleries image. This parameter is used for custom vm image.
  pub vm_shared_gallery_image_id as "vmSharedGalleryImageId,omitempty": Str? = None
  /// The size of virtual machines in the pool. All virtual machines in a pool are the same size. For example, Standard_D3.
  pub vm_size as "vmSize,omitempty": Str? = None
  /// Setting this to true allows stateless node types to scale out without equal distribution across zones.
  pub zone_balance as "zoneBalance,omitempty": Bool? = None
  /// Specifies the availability zones where the node type would span across. If the cluster is not spanning across availability zones, initiates az migration for the cluster.
