pub struct OperationResult {
  /// The object that represents the operation.
  pub display as "display,omitempty": AvailableOperationDisplay? = None
  /// Indicates whether the operation is a data action
  pub is_data_action as "isDataAction,omitempty": Bool? = None
  /// The name of the operation.
  pub name as "name,omitempty": Str? = None
  /// The URL to use for getting the next set of results.
  pub next_link as "nextLink,omitempty": Str? = None
  /// Origin result
  pub origin as "origin,omitempty": Str? = None
} derive Json

