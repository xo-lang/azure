/// Premium SSD zone redundant storage. Best for production workloads that need storage resiliency against zone failures.
pub const DISK_TYPE_PREMIUM_ZRS: DiskType = DiskType("Premium_ZRS")
/// Standard HDD locally redundant storage. Best for backup, non-critical, and infrequent access.
pub const DISK_TYPE_STANDARD_LRS: DiskType = DiskType("Standard_LRS")
