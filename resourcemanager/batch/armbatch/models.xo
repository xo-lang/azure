/// The configuration parameters used for performing automatic OS upgrade.
pub struct AutomaticOSUpgradePolicy {
  /// Whether OS image rollback feature should be disabled.
  pub disable_automatic_rollback as "disableAutomaticRollback,omitempty": Bool? = None
  /// Indicates whether OS upgrades should automatically be applied to scale set instances in a rolling fashion when a newer version of the OS image becomes available. <br /><br /> If this is set to true for Windows based pools, [WindowsConfiguration.enableAutomaticUpdates](https://learn.microsoft.com/rest/api/batchmanagement/pool/create?tabs=HTTP#windowsconfiguration) cannot be set to true.
  pub enable_automatic_os_upgrade as "enableAutomaticOSUpgrade,omitempty": Bool? = None
  /// Defer OS upgrades on the TVMs if they are running tasks.
  pub os_rolling_upgrade_deferral as "osRollingUpgradeDeferral,omitempty": Bool? = None
  /// Indicates whether rolling upgrade policy should be used during Auto OS Upgrade. Auto OS Upgrade will fallback to the default policy if no policy is defined on the VMSS.
  pub use_rolling_upgrade_policy as "useRollingUpgradePolicy,omitempty": Bool? = None
} derive Json

/// The configuration parameters used while performing a rolling upgrade.
pub struct RollingUpgradePolicy {
  /// Allow VMSS to ignore AZ boundaries when constructing upgrade batches. Take into consideration the Update Domain and maxBatchInstancePercent to determine the batch size. If this field is not set, Azure Azure Batch will not set its default value. The value of enableCrossZoneUpgrade on the created VirtualMachineScaleSet will be decided by the default configurations on VirtualMachineScaleSet. This field is able to be set to true or false only when using NodePlacementConfiguration as Zonal.
  pub enable_cross_zone_upgrade as "enableCrossZoneUpgrade,omitempty": Bool? = None
  /// The maximum percent of total virtual machine instances that will be upgraded simultaneously by the rolling upgrade in one batch. As this is a maximum, unhealthy instances in previous or future batches can cause the percentage of instances in a batch to decrease to ensure higher reliability. The value of this field should be between 5 and 100, inclusive. If both maxBatchInstancePercent and maxUnhealthyInstancePercent are assigned with value, the value of maxBatchInstancePercent should not be more than maxUnhealthyInstancePercent.
  pub max_batch_instance_percent as "maxBatchInstancePercent,omitempty": Int? = None
  /// The maximum percentage of the total virtual machine instances in the scale set that can be simultaneously unhealthy, either as a result of being upgraded, or by being found in an unhealthy state by the virtual machine health checks before the rolling upgrade aborts. This constraint will be checked prior to starting any batch. The value of this field should be between 5 and 100, inclusive. If both maxBatchInstancePercent and maxUnhealthyInstancePercent are assigned with value, the value of maxBatchInstancePercent should not be more than maxUnhealthyInstancePercent.
  pub max_unhealthy_instance_percent as "maxUnhealthyInstancePercent,omitempty": Int? = None
  /// The maximum percentage of upgraded virtual machine instances that can be found to be in an unhealthy state. This check will happen after each batch is upgraded. If this percentage is ever exceeded, the rolling update aborts. The value of this field should be between 0 and 100, inclusive.
  pub max_unhealthy_upgraded_instance_percent as "maxUnhealthyUpgradedInstancePercent,omitempty": Int? = None
  /// The wait time between completing the update for all virtual machines in one batch and starting the next batch. The time duration should be specified in ISO 8601 format.
  pub pause_time_between_batches as "pauseTimeBetweenBatches,omitempty": Str? = None
  /// Upgrade all unhealthy instances in a scale set before any healthy instances.
  pub prioritize_unhealthy_instances as "prioritizeUnhealthyInstances,omitempty": Bool? = None
  /// Rollback failed instances to previous model if the Rolling Upgrade policy is violated.
  pub rollback_failed_instances_on_policy_breach as "rollbackFailedInstancesOnPolicyBreach,omitempty": Bool? = None
} derive Json

/// Describes an upgrade policy - automatic, manual, or rolling.
pub struct UpgradePolicy {
  /// The configuration parameters used for performing automatic OS upgrade.
  pub automatic_os_upgrade_policy as "automaticOSUpgradePolicy,omitempty": AutomaticOSUpgradePolicy? = None
  /// Specifies the mode of an upgrade to virtual machines in the scale set.<br /><br /> Possible values are:<br /><br /> **Manual** - You  control the application of updates to virtual machines in the scale set. You do this by using the manualUpgrade action.<br /><br /> **Automatic** - All virtual machines in the scale set are automatically updated at the same time.<br /><br /> **Rolling** - Scale set performs updates in batches with an optional pause time in between.
  pub mode as "mode,omitempty": UpgradeMode? = None
  /// The configuration parameters used while performing a rolling upgrade.
  pub rolling_upgrade_policy as "rollingUpgradePolicy,omitempty": RollingUpgradePolicy? = None
} derive Json

/// Pool properties.
pub struct PoolProperties {
  /// Whether the pool is resizing.
  pub allocation_state as "allocationState,omitempty": AllocationState? = None
  /// The time at which the pool entered its current allocation state.
  pub allocation_state_transition_time as "allocationStateTransitionTime,omitempty": azcore.DateTime? = None
  /// Changes to application package references affect all new compute nodes joining the pool, but do not affect compute nodes that are already in the pool until they are rebooted or reimaged. There is a maximum of 10 application package references on any given pool.
  pub application_packages as "applicationPackages,omitempty": List[ApplicationPackageReference]? = None
  /// This property is set only if the pool automatically scales, i.e. autoScaleSettings are used.
  pub auto_scale_run as "autoScaleRun,omitempty": AutoScaleRun? = None
  /// The creation time of the pool.
  pub creation_time as "creationTime,omitempty": azcore.DateTime? = None
  /// The number of dedicated compute nodes currently in the pool.
  pub current_dedicated_nodes as "currentDedicatedNodes,omitempty": Int? = None
  /// The number of Spot/low-priority compute nodes currently in the pool.
  pub current_low_priority_nodes as "currentLowPriorityNodes,omitempty": Int? = None
  /// Deployment configuration properties.
  pub deployment_configuration as "deploymentConfiguration,omitempty": DeploymentConfiguration? = None
  /// The display name need not be unique and can contain any Unicode characters up to a maximum length of 1024.
  pub display_name as "displayName,omitempty": Str? = None
  /// This imposes restrictions on which nodes can be assigned to the pool. Enabling this value can reduce the chance of the requested number of nodes to be allocated in the pool. If not specified, this value defaults to 'Disabled'.
  pub inter_node_communication as "interNodeCommunication,omitempty": InterNodeCommunicationState? = None
  /// This is the last time at which the pool level data, such as the targetDedicatedNodes or autoScaleSettings, changed. It does not factor in node-level changes such as a compute node changing state.
  pub last_modified as "lastModified,omitempty": azcore.DateTime? = None
  /// The Batch service does not assign any meaning to metadata; it is solely for the use of user code.
  pub metadata as "metadata,omitempty": List[MetadataItem]? = None
  /// This supports Azure Files, NFS, CIFS/SMB, and Blobfuse.
  pub mount_configuration as "mountConfiguration,omitempty": List[MountConfiguration]? = None
  /// The network configuration for a pool.
  pub network_configuration as "networkConfiguration,omitempty": NetworkConfiguration? = None
  /// The current state of the pool.
  pub provisioning_state as "provisioningState,omitempty": PoolProvisioningState? = None
  /// The time at which the pool entered its current state.
  pub provisioning_state_transition_time as "provisioningStateTransitionTime,omitempty": azcore.DateTime? = None
  /// Describes either the current operation (if the pool AllocationState is Resizing) or the previously completed operation (if the AllocationState is Steady).
  pub resize_operation_status as "resizeOperationStatus,omitempty": ResizeOperationStatus? = None
  /// Defines the desired size of the pool. This can either be 'fixedScale' where the requested targetDedicatedNodes is specified, or 'autoScale' which defines a formula which is periodically reevaluated. If this property is not specified, the pool will have a fixed scale with 0 targetDedicatedNodes.
  pub scale_settings as "scaleSettings,omitempty": ScaleSettings? = None
  /// In an PATCH (update) operation, this property can be set to an empty object to remove the start task from the pool.
  pub start_task as "startTask,omitempty": StartTask? = None
  /// If not specified, the default is spread.
  pub task_scheduling_policy as "taskSchedulingPolicy,omitempty": TaskSchedulingPolicy? = None
  /// The default value is 1. The maximum value is the smaller of 4 times the number of cores of the vmSize of the pool or 256.
  pub task_slots_per_node as "taskSlotsPerNode,omitempty": Int? = None
  /// Describes an upgrade policy - automatic, manual, or rolling.
  pub upgrade_policy as "upgradePolicy,omitempty": UpgradePolicy? = None
  /// The list of user accounts to be created on each node in the pool.
  pub user_accounts as "userAccounts,omitempty": List[UserAccount]? = None
  /// For information about available VM sizes, see Sizes for Virtual Machines in Azure (https://learn.microsoft.com/azure/virtual-machines/sizes/overview). Batch supports all Azure VM sizes except STANDARD_A0 and those with premium storage (STANDARD_GS, STANDARD_DS, and STANDARD_DSV2 series).
  pub vm_size as "vmSize,omitempty": Str? = None
} derive Json

