/// Rule to filter client IP address.
pub struct IPRule {
  /// Action when client IP address is matched.
  pub action as "action,omitempty": Str? = None
  /// IPv4 address, or IPv4 address range in CIDR format.
  pub value as "value,omitempty": Str? = None
} derive Json(via: json.Value, to: ip_rule_json, from: parse_ip_rule)

/// IPRule's named fields, for its JSON.
struct IPRuleKnown {
  action as "action,omitempty": Str? = None
  value as "value,omitempty": Str? = None
} derive Json

fn ip_rule_json(x: IPRule) -> json.Value {
  let known = IPRuleKnown{
    action: Some("Allow"),
    value: x.value,
  }
  json.to_value(known)
}

fn parse_ip_rule(v: json.Value) -> IPRule ! json.DecodeErr {
  let k = json.from_value[IPRuleKnown](v)?
  Ok(IPRule{
    action: k.action,
    value: k.value,
  })
}

