} derive Json(via: json.Value, to: diff_disk_settings_json, from: parse_diff_disk_settings)

/// DiffDiskSettings's named fields, for its JSON.
struct DiffDiskSettingsKnown {
  placement as "placement,omitempty": Str? = None
} derive Json

fn diff_disk_settings_json(x: DiffDiskSettings) -> json.Value {
  let known = DiffDiskSettingsKnown{
    placement: x.placement.map(fn(_: Str) -> Str { "CacheDisk" }),
  }
  json.to_value(known)
}

fn parse_diff_disk_settings(v: json.Value) -> DiffDiskSettings ! json.DecodeErr {
  let k = json.from_value[DiffDiskSettingsKnown](v)?
  Ok(DiffDiskSettings{
    placement: k.placement,
  })
}

