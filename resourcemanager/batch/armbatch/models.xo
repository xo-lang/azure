/// Describes either the current operation (if the pool AllocationState is Resizing) or the previously completed operation (if the AllocationState is Steady).
pub struct ResizeOperationStatus {
  /// This property is set only if an error occurred during the last pool resize, and only when the pool allocationState is Steady.
  pub errors as "errors,omitempty": List[ResizeError]? = None
  /// The default value is requeue.
  pub node_deallocation_option as "nodeDeallocationOption,omitempty": ComputeNodeDeallocationOption? = None
  /// The default value is 15 minutes. The minimum value is 5 minutes. If you specify a value less than 5 minutes, the Batch service returns an error; if you are calling the REST API directly, the HTTP status code is 400 (Bad Request).
  pub resize_timeout as "resizeTimeout,omitempty": Str? = None
  /// The time when this resize operation was started.
  pub start_time as "startTime,omitempty": azcore.DateTime? = None
  /// The desired number of dedicated compute nodes in the pool.
  pub target_dedicated_nodes as "targetDedicatedNodes,omitempty": Int? = None
  /// The desired number of Spot/low-priority compute nodes in the pool.
  pub target_low_priority_nodes as "targetLowPriorityNodes,omitempty": Int? = None
} derive Json

/// Information used to connect to an Azure Storage Container using Blobfuse.
pub struct AzureBlobFileSystemConfiguration {
  /// This property is mutually exclusive with both sasKey and identity; exactly one must be specified.
  pub account_key as "accountKey,omitempty": Str? = None
  /// The Azure Storage Account name.
  pub account_name as "accountName,omitempty": Str? = None
  /// These are 'net use' options in Windows and 'mount' options in Linux.
  pub blobfuse_options as "blobfuseOptions,omitempty": Str? = None
  /// The Azure Blob Storage Container name.
  pub container_name as "containerName,omitempty": Str? = None
  /// This property is mutually exclusive with both accountKey and sasKey; exactly one must be specified.
  pub identity_reference as "identityReference,omitempty": ComputeNodeIdentityReference? = None
  /// All file systems are mounted relative to the Batch mounts directory, accessible via the AZ_BATCH_NODE_MOUNTS_DIR environment variable.
  pub relative_mount_path as "relativeMountPath,omitempty": Str? = None
  /// This property is mutually exclusive with both accountKey and identity; exactly one must be specified.
  pub sas_key as "sasKey,omitempty": Str? = None
} derive Json

