  gv_note(f, "CALL PoolClient.DisableAutoScale")
  match c.disable_auto_scale("id1/ x", "id2/ x", "id3/ x", PoolClientDisableAutoScaleOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_pool_client_disable_auto_scale_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_31)
}

fn show_pool_client_get_response(r: PoolClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.pool).to_str_lossy()}")
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  parts.join(" ")
}

