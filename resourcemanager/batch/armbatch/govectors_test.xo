fn show_pool_client_disable_auto_scale_response(r: PoolClientDisableAutoScaleResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.pool).to_str_lossy()}")
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  parts.join(" ")
}

