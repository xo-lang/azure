fn show_pool_client_stop_resize_response(r: PoolClientStopResizeResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.pool).to_str_lossy()}")
  if let Some(v) = r.etag {
    parts.push("ETag=${v}")
  }
  parts.join(" ")
}

