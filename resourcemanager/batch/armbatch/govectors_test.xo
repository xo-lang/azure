test "Go's AccountClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_account_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accountEndpoint\":\"s-accountendpoint\",\"activeJobAndJobScheduleQuota\":7,\"allowedAuthenticationModes\":[\"s-allowedauthenticationmodes\"],\"autoStorage\":{\"authenticationMode\":\"s-authenticationmode\",\"lastKeySync\":\"2026-11-06T10:00:00Z\",\"nodeIdentityReference\":{\"resourceId\":\"s-resourceid\"},\"storageAccountId\":\"s-storageaccountid\"},\"dedicatedCoreQuota\":7,\"dedicatedCoreQuotaPerVMFamily\":[{\"coreQuota\":7,\"name\":\"s-name\"}],\"dedicatedCoreQuotaPerVMFamilyEnforced\":true,\"encryption\":{\"keySource\":\"s-keysource\",\"keyVaultProperties\":{\"keyIdentifier\":\"s-keyidentifier\"}},\"keyVaultReference\":{\"id\":\"s-id\",\"url\":\"s-url\"},\"lowPriorityCoreQuota\":7,\"networkProfile\":{\"accountAccess\":{\"defaultAction\":\"s-defaultaction\"},\"nodeManagementAccess\":{\"defaultAction\":\"s-defaultaction\"}},\"nodeManagementEndpoint\":\"s-nodemanagementendpoint\",\"poolAllocationMode\":\"s-poolallocationmode\",\"poolQuota\":7,\"privateEndpointConnections\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AccountClient.NewListPager")
  var pg = c.new_list_pager(AccountClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_account_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_8)
}

fn show_account_client_regenerate_key_response(r: AccountClientRegenerateKeyResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.account_keys).to_str_lossy()}")
  parts.join(" ")
}

const GO_9: List[Str] = [
  "CALL AccountClient.RegenerateKey",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.Batch/batchAccounts/id2%2F%20x/regenerateKeys?api-version=2025-06-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"keyName\":\"s-keyname\"}",
  "  SERVED 200 {\"accountName\":\"s-accountname\",\"primary\":\"s-primary\",\"secondary\":\"s-secondary\"}",
  "OUT: body={\"accountName\":\"s-accountname\",\"primary\":\"s-primary\",\"secondary\":\"s-secondary\"}",
]

test "Go's AccountClient.RegenerateKey" {
  let f = gv_new_fake(os.net)
  let c = new_account_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"accountName\":\"s-accountname\",\"primary\":\"s-primary\",\"secondary\":\"s-secondary\"}")
  gv_note(f, "CALL AccountClient.RegenerateKey")
  match c.regenerate_key("id1/ x", "id2/ x", (json.decode_str[AccountRegenerateKeyParameters]("{\"keyName\":\"s-keyname\"}") ?? e => fault("${e}")), AccountClientRegenerateKeyOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_account_client_regenerate_key_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_9)
}

