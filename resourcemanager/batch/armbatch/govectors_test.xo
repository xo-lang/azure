fn show_pool_client_list_by_batch_account_response(r: PoolClientListByBatchAccountResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.list_pools_result).to_str_lossy()}")
  parts.join(" ")
}

