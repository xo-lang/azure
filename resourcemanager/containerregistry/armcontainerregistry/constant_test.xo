// Go's JSON for models with CONSTANT fields (a one-value enum sealed
// to a string), from a Go program over Go's armcontainerregistry/v3 v3.0.0: each
// unset, then set to another value. Go writes a required one always, an
// optional one when set, as its constant whatever the field holds.

use github.com/xo-lang/azure/runtime

/// Where ours still differs from Go's: (Go's line, ours).
const CONST_KNOWN: List[(Str, Str)] = []

test "constant fields encode as Go's" {
  let got = [
    "acr.check.unset ${runtime.marshal_json(RegistryNameCheckRequest{name: Some("n")}).to_str_lossy()}",
    "acr.check.other ${runtime.marshal_json(RegistryNameCheckRequest{name: Some("n"), type_: Some("other")}).to_str_lossy()}",
  ]
  let want = [
    "acr.check.unset {\"name\":\"n\",\"type\":\"Microsoft.ContainerRegistry/registries\"}",
    "acr.check.other {\"name\":\"n\",\"type\":\"Microsoft.ContainerRegistry/registries\"}",
  ]
  expect(got.len()) == want.len()
  var bad: List[Str] = []
  var i = 0
  while i < want.len() {
    let w = want[i]
    let ours = CONST_KNOWN.filter(fn(p: (Str, Str)) -> Bool { p.0 == w }).get(0).map(fn(p: (Str, Str)) -> Str { p.1 }) ?? w
    if got[i] != ours {
      bad.push("want: ${ours}\n  got:  ${got[i]}")
    }
    i += 1
  }
  expect(bad.join("\n")) == ""
}
