}

fn show_webhooks_client_ping_response(r: WebhooksClientPingResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.event_info).to_str_lossy()}")
  parts.join(" ")
}

