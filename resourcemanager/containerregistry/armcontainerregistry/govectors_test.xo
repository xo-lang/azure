test "Go's WebhooksClient.Ping" {
  let f = new_fake(os.net)
  let c = new_webhooks_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"id\":\"s-id\"}")
  note(f, "CALL WebhooksClient.Ping")
  match c.ping("id1/ x", "id2/ x", "id3/ x", WebhooksClientPingOptions{}) {
    Ok(r) => note(f, "OUT: ${show_webhooks_client_ping_response(r)}")
    Err(e) => note_lines(f, "OUT: error: ${err_text(e)}")
  }
  compare(log_of(f), GO_57)
}
