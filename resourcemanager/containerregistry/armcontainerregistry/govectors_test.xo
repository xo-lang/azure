test "Go's WebhooksClient.NewListEventsPager" {
  let f = new_fake(os.net)
  let c = new_webhooks_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"eventRequestMessage\":{\"content\":{\"action\":\"s-action\",\"actor\":{\"name\":\"s-name\"},\"id\":\"s-id\",\"request\":{\"addr\":\"s-addr\",\"host\":\"s-host\",\"id\":\"s-id\",\"method\":\"s-method\",\"useragent\":\"s-useragent\"},\"source\":{\"addr\":\"s-addr\",\"instanceID\":\"s-instanceid\"},\"target\":{\"digest\":\"s-digest\",\"length\":7,\"mediaType\":\"s-mediatype\",\"name\":\"s-name\",\"repository\":\"s-repository\",\"size\":7,\"tag\":\"s-tag\",\"url\":\"s-url\",\"version\":\"s-version\"},\"timestamp\":\"2026-11-06T10:00:00Z\"},\"headers\":{\"k1\":\"s-headers\"},\"method\":\"s-method\",\"requestUri\":\"s-requesturi\",\"version\":\"s-version\"},\"eventResponseMessage\":{\"content\":\"s-content\",\"headers\":{\"k1\":\"s-headers\"},\"reasonPhrase\":\"s-reasonphrase\",\"statusCode\":\"s-statuscode\",\"version\":\"s-version\"},\"id\":\"s-id\"}]}")
  note(f, "CALL WebhooksClient.NewListEventsPager")
  var pg = c.new_list_events_pager("id1/ x", "id2/ x", "id3/ x", WebhooksClientListEventsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_webhooks_client_list_events_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_55)
}

fn show_webhooks_client_list_response(r: WebhooksClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.webhook_list_result).to_str_lossy()}")
  parts.join(" ")
}

