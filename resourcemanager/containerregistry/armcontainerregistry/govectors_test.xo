test "Go's CacheRulesClient.NewListPager" {
  let f = new_fake(os.net)
  let c = new_cache_rules_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"creationDate\":\"2026-11-06T10:00:00Z\",\"credentialSetResourceId\":\"s-credentialsetresourceid\",\"provisioningState\":\"Succeeded\",\"sourceRepository\":\"s-sourcerepository\",\"targetRepository\":\"s-targetrepository\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  note(f, "CALL CacheRulesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", CacheRulesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_cache_rules_client_list_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_4)
}

