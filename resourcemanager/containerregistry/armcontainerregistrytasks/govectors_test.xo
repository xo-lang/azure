test "Go's RunsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_runs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"agentConfiguration\":{\"cpu\":7},\"agentPoolName\":\"s-agentpoolname\",\"createTime\":\"2026-11-06T10:00:00Z\",\"customRegistries\":[\"s-customregistries\"],\"finishTime\":\"2026-11-06T10:00:00Z\",\"imageUpdateTrigger\":{\"id\":\"s-id\",\"images\":[{\"digest\":\"s-digest\",\"registry\":\"s-registry\",\"repository\":\"s-repository\",\"tag\":\"s-tag\"}],\"timestamp\":\"2026-11-06T10:00:00Z\"},\"isArchiveEnabled\":true,\"lastUpdatedTime\":\"2026-11-06T10:00:00Z\",\"logArtifact\":{\"digest\":\"s-digest\",\"registry\":\"s-registry\",\"repository\":\"s-repository\",\"tag\":\"s-tag\"},\"outputImages\":[{\"digest\":\"s-digest\",\"registry\":\"s-registry\",\"repository\":\"s-repository\",\"tag\":\"s-tag\"}],\"platform\":{\"architecture\":\"s-architecture\",\"os\":\"s-os\",\"variant\":\"s-variant\"},\"provisioningState\":\"Succeeded\",\"runErrorMessage\":\"s-runerrormessage\",\"runId\":\"s-runid\",\"runType\":\"s-runtype\",\"sourceRegistryAuth\":\"s-sourceregistryauth\",\"sourceTrigger\":{\"branchName\":\"s-branchname\",\"commitId\":\"s-commitid\",\"eventType\":\"s-eventtype\",\"id\":\"s-id\",\"providerType\":\"s-providertype\",\"pullRequestId\":\"s-pullrequestid\",\"repositoryUrl\":\"s-repositoryurl\"},\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"task\":\"s-task\",\"timerTrigger\":{\"scheduleOccurrence\":\"s-scheduleoccurrence\",\"timerTriggerName\":\"s-timertriggername\"},\"updateTriggerToken\":\"s-updatetriggertoken\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RunsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", RunsClientListOptions{filter: Some("s-filter"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_runs_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_11)
}

fn show_runs_client_update_response(r: RunsClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.run).to_str_lossy()}")
  parts.join(" ")
}

