fn show_task_runs_client_update_response(r: TaskRunsClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.task_run).to_str_lossy()}")
  parts.join(" ")
}

