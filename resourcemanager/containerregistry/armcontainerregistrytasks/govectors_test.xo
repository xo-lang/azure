test "Go's TasksClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_tasks_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"agentConfiguration\":{\"cpu\":7},\"agentPoolName\":\"s-agentpoolname\",\"creationDate\":\"2026-11-06T10:00:00Z\",\"credentials\":{\"customRegistries\":{\"k1\":{\"identity\":\"s-identity\",\"password\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"userName\":{\"type\":\"s-type\",\"value\":\"s-value\"}}},\"sourceRegistry\":{\"identity\":\"s-identity\",\"loginMode\":\"s-loginmode\"}},\"isSystemTask\":true,\"logTemplate\":\"s-logtemplate\",\"platform\":{\"architecture\":\"s-architecture\",\"os\":\"s-os\",\"variant\":\"s-variant\"},\"provisioningState\":\"Succeeded\",\"status\":\"s-status\",\"step\":{\"arguments\":[{\"isSecret\":true,\"name\":\"s-name\",\"value\":\"s-value\"}],\"baseImageDependencies\":[{\"digest\":\"s-digest\",\"registry\":\"s-registry\",\"repository\":\"s-repository\",\"tag\":\"s-tag\",\"type\":\"s-type\"}],\"contextAccessToken\":\"s-contextaccesstoken\",\"contextPath\":\"s-contextpath\",\"dockerFilePath\":\"s-dockerfilepath\",\"imageNames\":[\"s-imagenames\"],\"isPushEnabled\":true,\"noCache\":true,\"target\":\"s-target\",\"type\":\"Docker\"},\"timeout\":7,\"trigger\":{\"baseImageTrigger\":{\"baseImageTriggerType\":\"s-baseimagetriggertype\",\"name\":\"s-name\",\"status\":\"s-status\",\"updateTriggerEndpoint\":\"s-updatetriggerendpoint\",\"updateTriggerPayloadType\":\"s-updatetriggerpayloadtype\"},\"sourceTriggers\":[{\"name\":\"s-name\",\"sourceRepository\":{\"branch\":\"s-branch\",\"repositoryUrl\":\"s-repositoryurl\",\"sourceControlAuthProperties\":{\"expiresIn\":7,\"refreshToken\":\"s-refreshtoken\",\"scope\":\"s-scope\",\"token\":\"s-token\",\"tokenType\":\"s-tokentype\"},\"sourceControlType\":\"s-sourcecontroltype\"},\"sourceTriggerEvents\":[\"s-sourcetriggerevents\"],\"status\":\"s-status\"}],\"timerTriggers\":[{\"name\":\"s-name\",\"schedule\":\"s-schedule\",\"status\":\"s-status\"}]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL TasksClient.Update")
  match c.update("id1/ x", "id2/ x", "id3/ x", (json.decode_str[TaskUpdateParameters]("{\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"properties\":{\"agentConfiguration\":{\"cpu\":7},\"agentPoolName\":\"s-agentpoolname\",\"credentials\":{\"customRegistries\":{\"k1\":{\"identity\":\"s-identity\",\"password\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"userName\":{\"type\":\"s-type\",\"value\":\"s-value\"}}},\"sourceRegistry\":{\"identity\":\"s-identity\",\"loginMode\":\"s-loginmode\"}},\"logTemplate\":\"s-logtemplate\",\"platform\":{\"architecture\":\"s-architecture\",\"os\":\"s-os\",\"variant\":\"s-variant\"},\"status\":\"s-status\",\"step\":{\"arguments\":[{\"isSecret\":true,\"name\":\"s-name\",\"value\":\"s-value\"}],\"contextAccessToken\":\"s-contextaccesstoken\",\"contextPath\":\"s-contextpath\",\"dockerFilePath\":\"s-dockerfilepath\",\"imageNames\":[\"s-imagenames\"],\"isPushEnabled\":true,\"noCache\":true,\"target\":\"s-target\",\"type\":\"Docker\"},\"timeout\":7,\"trigger\":{\"baseImageTrigger\":{\"baseImageTriggerType\":\"s-baseimagetriggertype\",\"name\":\"s-name\",\"status\":\"s-status\",\"updateTriggerEndpoint\":\"s-updatetriggerendpoint\",\"updateTriggerPayloadType\":\"s-updatetriggerpayloadtype\"},\"sourceTriggers\":[{\"name\":\"s-name\",\"sourceRepository\":{\"branch\":\"s-branch\",\"repositoryUrl\":\"s-repositoryurl\",\"sourceControlAuthProperties\":{\"expiresIn\":7,\"refreshToken\":\"s-refreshtoken\",\"scope\":\"s-scope\",\"token\":\"s-token\",\"tokenType\":\"s-tokentype\"},\"sourceControlType\":\"s-sourcecontroltype\"},\"sourceTriggerEvents\":[\"s-sourcetriggerevents\"],\"status\":\"s-status\"}],\"timerTriggers\":[{\"name\":\"s-name\",\"schedule\":\"s-schedule\",\"status\":\"s-status\"}]}},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), TasksClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_tasks_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_24)
}
