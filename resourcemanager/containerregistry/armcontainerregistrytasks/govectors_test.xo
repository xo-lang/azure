test "Go's TasksClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_tasks_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"agentConfiguration\":{\"cpu\":7},\"agentPoolName\":\"s-agentpoolname\",\"creationDate\":\"2026-11-06T10:00:00Z\",\"credentials\":{\"customRegistries\":{\"k1\":{\"identity\":\"s-identity\"}},\"sourceRegistry\":{\"identity\":\"s-identity\",\"loginMode\":\"s-loginmode\"}},\"isSystemTask\":true,\"logTemplate\":\"s-logtemplate\",\"platform\":{\"architecture\":\"s-architecture\",\"os\":\"s-os\",\"variant\":\"s-variant\"},\"provisioningState\":\"Succeeded\",\"status\":\"s-status\",\"step\":{\"contextAccessToken\":\"s-contextaccesstoken\",\"contextPath\":\"s-contextpath\",\"dockerFilePath\":\"s-dockerfilepath\",\"imageNames\":[\"s-imagenames\"],\"isPushEnabled\":true,\"noCache\":true,\"target\":\"s-target\",\"type\":\"Docker\"},\"timeout\":7,\"trigger\":{\"baseImageTrigger\":{\"baseImageTriggerType\":\"s-baseimagetriggertype\",\"name\":\"s-name\",\"status\":\"s-status\",\"updateTriggerEndpoint\":\"s-updatetriggerendpoint\",\"updateTriggerPayloadType\":\"s-updatetriggerpayloadtype\"},\"sourceTriggers\":[{\"name\":\"s-name\",\"status\":\"s-status\"}],\"timerTriggers\":[{\"name\":\"s-name\",\"schedule\":\"s-schedule\",\"status\":\"s-status\"}]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL TasksClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", TasksClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_tasks_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_23)
}

