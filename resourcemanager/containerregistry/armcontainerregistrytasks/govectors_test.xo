-11-06T10:00:00Z\",\"status\":\"s-status\",\"task\":\"s-task\",\"timerTrigger\":{\"scheduleOccurrence\":\"s-scheduleoccurrence\",\"timerTriggerName\":\"s-timertriggername\"},\"updateTriggerToken\":\"s-updatetriggertoken\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL TaskRunsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", TaskRunsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
