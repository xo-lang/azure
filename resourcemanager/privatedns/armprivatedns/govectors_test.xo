  let c = new_record_sets_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"aRecords\":[{\"ipv4Address\":\"s-ipv4address\"}],\"aaaaRecords\":[{\"ipv6Address\":\"s-ipv6address\"}],\"cnameRecord\":{\"cname\":\"s-cname\"},\"fqdn\":\"s-fqdn\",\"isAutoRegistered\":true,\"metadata\":{\"k1\":\"s-metadata\"},\"mxRecords\":[{\"exchange\":\"s-exchange\",\"preference\":7}],\"ptrRecords\":[{\"ptrdname\":\"s-ptrdname\"}],\"soaRecord\":{\"email\":\"s-email\",\"expireTime\":7,\"host\":\"s-host\",\"minimumTtl\":7,\"refreshTime\":7,\"retryTime\":7,\"serialNumber\":7},\"srvRecords\":[{\"port\":7,\"priority\":7,\"target\":\"s-target\",\"weight\":7}],\"ttl\":7,\"txtRecords\":[{\"value\":[\"s-value\"]}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RecordSetsClient.NewListByTypePager")
  var pg = c.new_list_by_type_pager("id1/ x", "id2/ x", RecordType("sha1"), RecordSetsClientListByTypeOptions{recordsetnamesuffix: Some("s-recordsetnamesuffix"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_record_sets_client_list_by_type_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_9)
}

