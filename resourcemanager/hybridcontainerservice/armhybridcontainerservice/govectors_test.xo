  let f = gv_new_fake(os.net)
  let c = new_agent_pool_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"count\":7,\"enableAutoScaling\":true,\"kubernetesVersion\":\"s-kubernetesversion\",\"maxCount\":7,\"maxPods\":7,\"minCount\":7,\"nodeLabels\":{\"k1\":\"s-nodelabels\"},\"nodeTaints\":[\"s-nodetaints\"],\"osSKU\":\"s-ossku\",\"osType\":\"s-ostype\",\"provisioningState\":\"Succeeded\",\"status\":{\"currentState\":\"s-currentstate\",\"errorMessage\":\"s-errormessage\",\"readyReplicas\":[{\"count\":7,\"kubernetesVersion\":\"s-kubernetesversion\",\"vmSize\":\"s-vmsize\"}]},\"vmSize\":\"s-vmsize\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
