      Ok(r) => gv_note(f, "OUT page ${page}: ${show_agent_pool_client_list_by_provisioned_cluster_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_3)
}

