  gv_set(f, 200, "{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"dnsServers\":[\"s-dnsservers\"],\"gateway\":\"s-gateway\",\"infraVnetProfile\":{\"hci\":{\"mocGroup\":\"s-mocgroup\",\"mocLocation\":\"s-moclocation\",\"mocVnetName\":\"s-mocvnetname\"}},\"ipAddressPrefix\":\"s-ipaddressprefix\",\"provisioningState\":\"Succeeded\",\"status\":{\"operationStatus\":{\"error\":{\"code\":\"s-code\",\"message\":\"s-message\"},\"operationId\":\"s-operationid\",\"status\":\"s-status\"}},\"vipPool\":[{\"endIP\":\"s-endip\",\"startIP\":\"s-startip\"}],\"vlanID\":7,\"vmipPool\":[{\"endIP\":\"s-endip\",\"startIP\":\"s-startip\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL VirtualNetworksClient.Retrieve")
  match c.retrieve("id1/ x", "id2/ x", VirtualNetworksClientRetrieveOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_virtual_networks_client_retrieve_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_29)
}
