  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"contactProfile\":{\"id\":\"s-id\"},\"endTime\":\"2026-11-06T10:00:00Z\",\"groundStationName\":\"s-groundstationname\",\"startTime\":\"2026-11-06T10:00:00Z\"}",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"groundStationName\":\"s-groundstationname\",\"properties\":{\"endAzimuthDegrees\":1.5,\"endElevationDegrees\":1.5,\"maximumElevationDegrees\":1.5,\"rxEndTime\":\"2026-11-06T10:00:00Z\",\"rxStartTime\":\"2026-11-06T10:00:00Z\",\"startAzimuthDegrees\":1.5,\"startElevationDegrees\":1.5,\"txEndTime\":\"2026-11-06T10:00:00Z\",\"txStartTime\":\"2026-11-06T10:00:00Z\"},\"spacecraft\":{\"id\":\"s-id\"}}]}",
  "OUT page 1: panic: runtime error: invalid memory address or nil pointer dereference",
]

test "Go's SpacecraftsClient.BeginListAvailableContacts" {
  let f = gv_new_fake(os.net)
  let c = new_spacecrafts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"groundStationName\":\"s-groundstationname\",\"properties\":{\"endAzimuthDegrees\":1.5,\"endElevationDegrees\":1.5,\"maximumElevationDegrees\":1.5,\"rxEndTime\":\"2026-11-06T10:00:00Z\",\"rxStartTime\":\"2026-11-06T10:00:00Z\",\"startAzimuthDegrees\":1.5,\"startElevationDegrees\":1.5,\"txEndTime\":\"2026-11-06T10:00:00Z\",\"txStartTime\":\"2026-11-06T10:00:00Z\"},\"spacecraft\":{\"id\":\"s-id\"}}]}")
  gv_note(f, "CALL SpacecraftsClient.BeginListAvailableContacts")
  match c.begin_list_available_contacts("id1/ x", "id2/ x", (json.decode_str[ContactParameters]("{\"contactProfile\":{\"id\":\"s-id\"},\"endTime\":\"2026-11-06T10:00:00Z\",\"groundStationName\":\"s-groundstationname\",\"startTime\":\"2026-11-06T10:00:00Z\"}") ?? e => fault("${e}")), SpacecraftsClientBeginListAvailableContactsOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(pg0) => {
          var pg = pg0
          for page in [1, 2] {
            if !pg.more() {
              gv_note(f, "OUT page ${page}: no more")
              break
            }
            match pg.next_page() {
              Ok(r) => gv_note(f, "OUT page ${page}: ${show_spacecrafts_client_list_available_contacts_response(r)}")
              Err(e) => {
                gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
                break
              }
            }
          }
        }
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  // Go panics at line 5 (its pager has no handler); ours reads page one
  let got = gv_log_of(f)
  gv_compare(got[0..5], GO_15[0..5])
  expect(got[5].starts_with("OUT page 1: ")) == true
}

