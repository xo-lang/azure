test "Go's AvailableGroundStationsClient.NewListByCapabilityPager" {
  let f = gv_new_fake(os.net)
  let c = new_available_ground_stations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"altitudeMeters\":1.5,\"city\":\"s-city\",\"latitudeDegrees\":1.5,\"longitudeDegrees\":1.5,\"providerName\":\"s-providername\",\"releaseMode\":\"s-releasemode\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AvailableGroundStationsClient.NewListByCapabilityPager")
  var pg = c.new_list_by_capability_pager(CapabilityParameter("sha1"), AvailableGroundStationsClientListByCapabilityOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_available_ground_stations_client_list_by_capability_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_0)
}

