test "Go's SpacecraftsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_spacecrafts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"links\":[{\"bandwidthMHz\":1.5,\"centerFrequencyMHz\":1.5,\"direction\":\"s-direction\",\"name\":\"s-name\",\"polarization\":\"s-polarization\"}],\"noradId\":\"s-noradid\",\"provisioningState\":\"Succeeded\",\"titleLine\":\"s-titleline\",\"tleLine1\":\"s-tleline1\",\"tleLine2\":\"s-tleline2\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SpacecraftsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", SpacecraftsClientListOptions{skiptoken: Some("s-skiptoken")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_spacecrafts_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_19)
}
