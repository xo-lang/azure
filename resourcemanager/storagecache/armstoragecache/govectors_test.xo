  let c = new_caches_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL CachesClient.BeginStopPrimingJob")
  match c.begin_stop_priming_job("id1/ x", "id2/ x", CachesClientBeginStopPrimingJobOptions{priming_job_id: Some((json.decode_str[PrimingJobIDParameter]("{\"primingJobId\":\"s-primingjobid\"}") ?? e => fault("${e}")))}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_caches_client_stop_priming_job_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_30)
}

fn show_caches_client_update_response(r: CachesClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.cache).to_str_lossy()}")
  parts.join(" ")
}

