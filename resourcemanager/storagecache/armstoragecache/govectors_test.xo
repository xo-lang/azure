test "Go's AutoExportJobsClient.NewListByAmlFilesystemPager" {
  let f = gv_new_fake(os.net)
  let c = new_auto_export_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"adminStatus\":\"s-adminstatus\",\"autoExportPrefixes\":[\"s-autoexportprefixes\"],\"provisioningState\":\"Succeeded\",\"status\":{\"currentIterationFilesDiscovered\":7,\"currentIterationFilesExported\":7,\"currentIterationFilesFailed\":7,\"currentIterationMiBDiscovered\":7,\"currentIterationMiBExported\":7,\"exportIterationCount\":7,\"lastCompletionTimeUTC\":\"2026-11-06T10:00:00Z\",\"lastStartedTimeUTC\":\"2026-11-06T10:00:00Z\",\"lastSuccessfulIterationCompletionTimeUTC\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\",\"statusCode\":\"s-statuscode\",\"statusMessage\":\"s-statusmessage\",\"totalFilesExported\":7,\"totalFilesFailed\":7,\"totalMiBExported\":7}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AutoExportJobsClient.NewListByAmlFilesystemPager")
  var pg = c.new_list_by_aml_filesystem_pager("id1/ x", "id2/ x", AutoExportJobsClientListByAmlFilesystemOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_auto_export_jobs_client_list_by_aml_filesystem_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_14)
}

