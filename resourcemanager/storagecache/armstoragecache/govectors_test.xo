// Generated from the output of a local Go program that calls every
// public method of each client of armstoragecache v4.3.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_aml_filesystems_client_archive_response(r: AmlFilesystemsClientArchiveResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL AmlFilesystemsClient.Archive",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.StorageCache/amlFilesystems/id2%2F%20x/archive?api-version=2026-08-01",
  "  H authorization=Bearer tok | content-type=application/json",
  "  B {\"filesystemPath\":\"s-filesystempath\"}",
  "  SERVED 200 ",
  "OUT: ",
]

test "Go's AmlFilesystemsClient.Archive" {
  let f = gv_new_fake(os.net)
  let c = new_aml_filesystems_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL AmlFilesystemsClient.Archive")
  match c.archive("id1/ x", "id2/ x", AmlFilesystemsClientArchiveOptions{archive_info: Some((json.decode_str[AmlFilesystemArchiveInfo]("{\"filesystemPath\":\"s-filesystempath\"}") ?? e => fault("${e}")))}) {
    Ok(r) => gv_note(f, "OUT: ${show_aml_filesystems_client_archive_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

fn show_aml_filesystems_client_create_or_update_response(r: AmlFilesystemsClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.aml_filesystem).to_str_lossy()}")
  parts.join(" ")
}

