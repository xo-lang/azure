fn show_caches_client_list_by_resource_group_response(r: CachesClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.caches_list_result).to_str_lossy()}")
  parts.join(" ")
}

