test "Go's AutoImportJobsClient.NewListByAmlFilesystemPager" {
  let f = gv_new_fake(os.net)
  let c = new_auto_import_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"adminStatus\":\"s-adminstatus\",\"autoImportPrefixes\":[\"s-autoimportprefixes\"],\"conflictResolutionMode\":\"s-conflictresolutionmode\",\"enableDeletions\":true,\"maximumErrors\":7,\"provisioningState\":\"Succeeded\",\"status\":{\"blobSyncEvents\":{\"deletions\":7,\"importedDirectories\":7,\"importedFiles\":7,\"importedSymlinks\":7,\"lastChangeFeedEventConsumedTime\":\"2026-11-06T10:00:00Z\",\"lastTimeFullySynchronized\":\"2026-11-06T10:00:00Z\",\"preexistingDirectories\":7,\"preexistingFiles\":7,\"preexistingSymlinks\":7,\"rateOfBlobImport\":7,\"totalBlobsImported\":7,\"totalConflicts\":7,\"totalErrors\":7},\"importedDirectories\":7,\"importedFiles\":7,\"importedSymlinks\":7,\"lastCompletionTimeUTC\":\"2026-11-06T10:00:00Z\",\"lastStartedTimeUTC\":\"2026-11-06T10:00:00Z\",\"preexistingDirectories\":7,\"preexistingFiles\":7,\"preexistingSymlinks\":7,\"rateOfBlobImport\":7,\"rateOfBlobWalk\":7,\"scanEndTime\":\"2026-11-06T10:00:00Z\",\"scanStartTime\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\",\"statusCode\":\"s-statuscode\",\"statusMessage\":\"s-statusmessage\",\"totalBlobsImported\":7,\"totalBlobsWalked\":7,\"totalConflicts\":7,\"totalErrors\":7}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AutoImportJobsClient.NewListByAmlFilesystemPager")
  var pg = c.new_list_by_aml_filesystem_pager("id1/ x", "id2/ x", AutoImportJobsClientListByAmlFilesystemOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_auto_import_jobs_client_list_by_aml_filesystem_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_19)
}

