/// How the auto import job will handle conflicts. For example, if the auto import job is trying to bring in a directory, but a file is at that path, how it handles it. Fail indicates that the auto import job should stop immediately and not do anything with the conflict. Skip indicates that it should pass over the conflict. OverwriteIfDirty causes the auto import job to delete and re-import the file or directory if it is a conflicting type, is dirty, or is currently released. OverwriteAlways extends OverwriteIfDirty to include releasing files that had been restored but were not dirty. Please reference https://learn.microsoft.com/en-us/azure/azure-managed-lustre/blob-integration#conflict-resolution-mode for a thorough explanation of these resolution modes.
pub type ConflictResolutionMode struct(Str)
/// Fail
pub const CONFLICT_RESOLUTION_MODE_FAIL: ConflictResolutionMode = ConflictResolutionMode("Fail")
/// OverwriteAlways
pub const CONFLICT_RESOLUTION_MODE_OVERWRITE_ALWAYS: ConflictResolutionMode = ConflictResolutionMode("OverwriteAlways")
/// OverwriteIfDirty
pub const CONFLICT_RESOLUTION_MODE_OVERWRITE_IF_DIRTY: ConflictResolutionMode = ConflictResolutionMode("OverwriteIfDirty")
/// Skip
pub const CONFLICT_RESOLUTION_MODE_SKIP: ConflictResolutionMode = ConflictResolutionMode("Skip")

/// The values of ConflictResolutionMode this version knows; the service may send others.
pub fn possible_conflict_resolution_mode_values() -> List[ConflictResolutionMode] {
  [CONFLICT_RESOLUTION_MODE_FAIL, CONFLICT_RESOLUTION_MODE_OVERWRITE_ALWAYS, CONFLICT_RESOLUTION_MODE_OVERWRITE_IF_DIRTY, CONFLICT_RESOLUTION_MODE_SKIP]
