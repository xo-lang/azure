  let f = gv_new_fake(os.net)
  let c = new_discovery_rules_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"addRecommendedSignals\":\"s-addrecommendedsignals\",\"addResourceHealthSignal\":\"s-addresourcehealthsignal\",\"authenticationSetting\":\"s-authenticationsetting\",\"discoverRelationships\":\"s-discoverrelationships\",\"displayName\":\"s-displayname\",\"entityName\":\"s-entityname\",\"error\":{\"context\":[\"s-context\"],\"message\":\"s-message\"},\"provisioningState\":\"Succeeded\",\"specification\":{\"applicationInsightsResourceId\":\"s-applicationinsightsresourceid\",\"kind\":\"ApplicationInsightsTopology\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DiscoveryRulesClient.NewListByHealthModelPager")
