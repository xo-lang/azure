  let c = new_sim_policies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"defaultSlice\":{\"id\":\"s-id\"},\"provisioningState\":\"Succeeded\",\"registrationTimer\":7,\"rfspIndex\":7,\"siteProvisioningState\":{\"k1\":\"s-siteprovisioningstate\"},\"sliceConfigurations\":[{\"defaultDataNetwork\":{\"id\":\"s-id\"},\"slice\":{\"id\":\"s-id\"}}],\"ueAmbr\":{\"downlink\":\"https://management.example.test/next?\$skiptoken=2\",\"uplink\":\"https://management.example.test/next?\$skiptoken=2\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SimPoliciesClient.NewListByMobileNetworkPager")
