test "Go's SimsClient.NewListByGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_sims_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"authenticationKey\":\"s-authenticationkey\",\"deviceType\":\"s-devicetype\",\"integratedCircuitCardIdentifier\":\"s-integratedcircuitcardidentifier\",\"internationalMobileSubscriberIdentity\":\"s-internationalmobilesubscriberidentity\",\"operatorKeyCode\":\"s-operatorkeycode\",\"provisioningState\":\"Succeeded\",\"simPolicy\":{\"id\":\"s-id\"},\"simState\":\"s-simstate\",\"siteProvisioningState\":{\"k1\":\"s-siteprovisioningstate\"},\"staticIpConfiguration\":[{\"attachedDataNetwork\":{\"id\":\"s-id\"},\"slice\":{\"id\":\"s-id\"},\"staticIp\":{\"ipv4Address\":\"s-ipv4address\"}}],\"vendorKeyFingerprint\":\"s-vendorkeyfingerprint\",\"vendorName\":\"s-vendorname\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SimsClient.NewListByGroupPager")
  var pg = c.new_list_by_group_pager("id1/ x", "id2/ x", SimsClientListByGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_sims_client_list_by_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
