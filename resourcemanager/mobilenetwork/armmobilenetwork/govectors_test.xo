test "Go's ServicesClient.NewListByMobileNetworkPager" {
  let f = gv_new_fake(os.net)
  let c = new_services_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"pccRules\":[{\"ruleName\":\"s-rulename\",\"rulePrecedence\":7,\"ruleQosPolicy\":{\"5qi\":7,\"allocationAndRetentionPriorityLevel\":7,\"preemptionCapability\":\"s-preemptioncapability\",\"preemptionVulnerability\":\"s-preemptionvulnerability\"},\"trafficControl\":\"s-trafficcontrol\"}],\"provisioningState\":\"Succeeded\",\"servicePrecedence\":7,\"serviceQosPolicy\":{\"5qi\":7,\"allocationAndRetentionPriorityLevel\":7,\"maximumBitRate\":{\"downlink\":\"https://management.example.test/next?\$skiptoken=2\",\"uplink\":\"https://management.example.test/next?\$skiptoken=2\"},\"preemptionCapability\":\"s-preemptioncapability\",\"preemptionVulnerability\":\"s-preemptionvulnerability\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ServicesClient.NewListByMobileNetworkPager")
  var pg = c.new_list_by_mobile_network_pager("id1/ x", "id2/ x", ServicesClientListByMobileNetworkOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_services_client_list_by_mobile_network_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_51)
}

