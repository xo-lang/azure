/// Settings controlling data network use
pub struct DataNetworkConfiguration {
  /// Default 5G QoS Flow Indicator value. The 5QI identifies a specific QoS forwarding treatment to be provided to a flow. See 3GPP TS23.501 section 192.0.2.1 for a full description of the 5QI parameter, and table 5.7.4-1 for the definition the 5QI values.
  pub n5qi as "5qi,omitempty": Int? = None
  /// Allowed session types in addition to the default session type. Must not duplicate the default session type.
  pub additional_allowed_session_types as "additionalAllowedSessionTypes,omitempty": List[PduSessionType]? = None
  /// Default QoS Flow allocation and retention priority (ARP) level. Flows with higher priority preempt flows with lower priority, if the settings of `preemptionCapability` and `preemptionVulnerability` allow it. 1 is the highest level of priority. If this field is not specified then `5qi` is used to derive the ARP value. See 3GPP TS23.501 section 192.0.2.2 for a full description of the ARP parameters.
  pub allocation_and_retention_priority_level as "allocationAndRetentionPriorityLevel,omitempty": Int? = None
  /// List of services that can be used as part of this SIM policy. The list must not contain duplicate items and must contain at least one item. The services must be in the same location as the SIM policy.
  pub allowed_services as "allowedServices,omitempty": List[ServiceResourceID]? = None
  /// A reference to the data network that these settings apply to. The data network must be in the same location as the SIM policy.
  pub data_network as "dataNetwork,omitempty": DataNetworkResourceID? = None
  /// The default PDU session type, which is used if the UE does not request a specific session type.
  pub default_session_type as "defaultSessionType,omitempty": PduSessionType? = None
  /// The maximum number of downlink packets to buffer at the user plane for High Latency Communication - Extended Buffering. See 3GPP TS29.272 v15.10.0 section 7.3.188 for a full description. This maximum is not guaranteed because there is a internal limit on buffered packets across all PDU sessions.
  pub maximum_number_of_buffered_packets as "maximumNumberOfBufferedPackets,omitempty": Int? = None
  /// Default QoS Flow preemption capability. The preemption capability of a QoS Flow controls whether it can preempt another QoS Flow with a lower priority level. See 3GPP TS23.501 section 192.0.2.2 for a full description of the ARP parameters.
  pub preemption_capability as "preemptionCapability,omitempty": PreemptionCapability? = None
  /// Default QoS Flow preemption vulnerability. The preemption vulnerability of a QoS Flow controls whether it can be preempted by a QoS Flow with a higher priority level. See 3GPP TS23.501 section 192.0.2.2 for a full description of the ARP parameters.
  pub preemption_vulnerability as "preemptionVulnerability,omitempty": PreemptionVulnerability? = None
  /// Aggregate maximum bit rate across all non-GBR QoS flows of a given PDU session. See 3GPP TS23.501 section 192.0.2.6 for a full description of the Session-AMBR.
  pub session_ambr as "sessionAmbr,omitempty": Ambr? = None
} derive Json

