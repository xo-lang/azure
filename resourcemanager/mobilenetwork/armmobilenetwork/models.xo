/// ExtendedUeInfoPropertiesClassification: a ExtendedUeInfoProperties by its ratType, Go's ExtendedUeInfoPropertiesClassification interface.
pub enum ExtendedUeInfoPropertiesClassification {
  /// ratType "5G"
  UeInfo5G(from UeInfo5G)
  /// ratType "4G"
  UeInfo4G(from UeInfo4G)
  /// Any other ratType, as the base type.
  ExtendedUeInfoProperties(from ExtendedUeInfoProperties)
} derive Json(via: json.Value, to: extended_ue_info_properties_classification_json, from: parse_extended_ue_info_properties_classification)

fn extended_ue_info_properties_classification_json(c: ExtendedUeInfoPropertiesClassification) -> json.Value {
  match c {
    ExtendedUeInfoPropertiesClassification.UeInfo5G(x) => json.to_value(x)
    ExtendedUeInfoPropertiesClassification.UeInfo4G(x) => json.to_value(x)
    ExtendedUeInfoPropertiesClassification.ExtendedUeInfoProperties(x) => json.to_value(x)
  }
}

fn parse_extended_ue_info_properties_classification(v: json.Value) -> ExtendedUeInfoPropertiesClassification ! json.DecodeErr {
  match v.get("ratType") {
    Some(json.Value.Str("5G")) => Ok(ExtendedUeInfoPropertiesClassification.UeInfo5G(json.from_value[UeInfo5G](v)?))
    Some(json.Value.Str("4G")) => Ok(ExtendedUeInfoPropertiesClassification.UeInfo4G(json.from_value[UeInfo4G](v)?))
    _ => Ok(ExtendedUeInfoPropertiesClassification.ExtendedUeInfoProperties(json.from_value[ExtendedUeInfoProperties](v)?))
  }
}

/// `v` with its discriminator `key` set to `value`, as Go's
/// MarshalJSON writes a subtype's (its keys sorted).
fn with_discriminator(v: json.Value, key: Str, value: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object((fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != key }) + [(key, json.Value.Str(value))]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    other => other
  }
}

