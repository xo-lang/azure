  /// QoS Flow allocation and retention priority (ARP) level. Flows with higher priority preempt flows with lower priority, if the settings of `preemptionCapability` and `preemptionVulnerability` allow it. 1 is the highest level of priority. If this field is not specified then `5qi` is used to derive the ARP value. See 3GPP TS23.501 section 192.0.2.2 for a full description of the ARP parameters.
  pub allocation_and_retention_priority_level as "allocationAndRetentionPriorityLevel,omitempty": Int? = None
  /// The maximum bit rate (MBR) for all service data flows that use this data flow policy rule or service.
  pub maximum_bit_rate as "maximumBitRate,omitempty": Ambr? = None
  /// QoS Flow preemption capability. The preemption capability of a QoS Flow controls whether it can preempt another QoS Flow with a lower priority level. See 3GPP TS23.501 section 192.0.2.2 for a full description of the ARP parameters.
  pub preemption_capability as "preemptionCapability,omitempty": PreemptionCapability? = None
  /// QoS Flow preemption vulnerability. The preemption vulnerability of a QoS Flow controls whether it can be preempted by a QoS Flow with a higher priority level. See 3GPP TS23.501 section 192.0.2.2 for a full description of the ARP parameters.
  pub preemption_vulnerability as "preemptionVulnerability,omitempty": PreemptionVulnerability? = None
} derive Json

