/// SimsClientBeginCloneOptions: the optional parameters of SimsClient.begin_clone.
pub struct SimsClientBeginCloneOptions {
  /// Resumes the operation from a poller's resume_token instead of starting it.
  pub resume_token: Str = ""
}

/// SimsClientCloneResponse: the response of SimsClient.begin_clone.
pub struct SimsClientCloneResponse {
  pub async_operation_status: AsyncOperationStatus
