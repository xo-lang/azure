fn sims_clone_handle(resp: http.Response) -> SimsClientCloneResponse ! Str {
  let v = if resp.body.is_empty() { AsyncOperationStatus{} } else { json.decode[AsyncOperationStatus](resp.body) ?? e => return Err(e.display()) }
  Ok(SimsClientCloneResponse{async_operation_status: v})
}

fn (c: SimsClient) clone_create_request(resource_group_name: Str, sim_group_name: Str, parameters: SimClone, options: SimsClientBeginCloneOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.MobileNetwork/simGroups/{simGroupName}/cloneSims"
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter client.subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if sim_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter simGroupName cannot be empty"))
  }
  path = path.replace("{simGroupName}", url.path_escape(sim_group_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: runtime.marshal_json(parameters)})
}

