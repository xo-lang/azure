test "Go's StorageClassClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_storage_class_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"accessModes\":[\"s-accessmodes\"],\"allowVolumeExpansion\":\"s-allowvolumeexpansion\",\"dataResilience\":\"s-dataresilience\",\"failoverSpeed\":\"s-failoverspeed\",\"limitations\":[\"s-limitations\"],\"mountOptions\":[\"s-mountoptions\"],\"performance\":\"s-performance\",\"priority\":7,\"provisioner\":\"s-provisioner\",\"provisioningState\":\"Succeeded\",\"typeProperties\":{\"azureStorageAccountKey\":\"s-azurestorageaccountkey\",\"azureStorageAccountName\":\"s-azurestorageaccountname\",\"type\":\"Blob\"},\"volumeBindingMode\":\"s-volumebindingmode\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL StorageClassClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", StorageClassClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_storage_class_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_17)
}
