/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: BusinessProcessIdentifier) patch() -> BusinessProcessIdentifierPatch {
  BusinessProcessIdentifierPatch{
    property_name: match m.property_name {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    property_type: match m.property_type {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
