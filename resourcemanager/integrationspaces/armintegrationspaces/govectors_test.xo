test "Go's ApplicationResourcesClient.NewListByApplicationPager" {
  let f = gv_new_fake(os.net)
  let c = new_application_resources_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\",\"resourceId\":\"s-resourceid\",\"resourceKind\":\"s-resourcekind\",\"resourceType\":\"s-resourcetype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ApplicationResourcesClient.NewListByApplicationPager")
  var pg = c.new_list_by_application_pager("id1/ x", "id2/ x", "id3/ x", ApplicationResourcesClientListByApplicationOptions{expand: Some(["s-expand"]), filter: Some("s-filter"), maxpagesize: Some(7), orderby: Some(["s-orderby"]), select_: Some(["s-select"]), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
