test "Go's ApplicationsClient.NewListBySpacePager" {
  let f = gv_new_fake(os.net)
  let c = new_applications_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"provisioningState\":\"Succeeded\",\"trackingDataStores\":{\"k1\":{\"dataStoreIngestionUri\":\"s-datastoreingestionuri\",\"dataStoreResourceId\":\"s-datastoreresourceid\",\"dataStoreUri\":\"s-datastoreuri\",\"databaseName\":\"s-databasename\"}}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ApplicationsClient.NewListBySpacePager")
  var pg = c.new_list_by_space_pager("id1/ x", "id2/ x", ApplicationsClientListBySpaceOptions{expand: Some(["s-expand"]), filter: Some("s-filter"), maxpagesize: Some(7), orderby: Some(["s-orderby"]), select_: Some(["s-select"]), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_applications_client_list_by_space_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_11)
}

