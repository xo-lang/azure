test "Go's BusinessProcessVersionsClient.NewListByBusinessProcessPager" {
  let f = gv_new_fake(os.net)
  let c = new_business_process_versions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"businessProcessMapping\":{\"k1\":{\"logicAppResourceId\":\"s-logicappresourceid\",\"operationName\":\"s-operationname\",\"operationType\":\"s-operationtype\",\"workflowName\":\"s-workflowname\"}},\"businessProcessStages\":{\"k1\":{\"description\":\"s-description\",\"properties\":{\"k1\":\"s-properties\"},\"stagesBefore\":[\"s-stagesbefore\"]}},\"description\":\"s-description\",\"identifier\":{\"propertyName\":\"s-propertyname\",\"propertyType\":\"s-propertytype\"},\"provisioningState\":\"Succeeded\",\"tableName\":\"s-tablename\",\"trackingDataStoreReferenceName\":\"s-trackingdatastorereferencename\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BusinessProcessVersionsClient.NewListByBusinessProcessPager")
  var pg = c.new_list_by_business_process_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", BusinessProcessVersionsClientListByBusinessProcessOptions{expand: Some(["s-expand"]), filter: Some("s-filter"), maxpagesize: Some(7), orderby: Some(["s-orderby"]), select_: Some(["s-select"]), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_business_process_versions_client_list_by_business_process_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_16)
}

