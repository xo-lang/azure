test "Go's JobsClient.NewListByDataManagerPager" {
  let f = gv_new_fake(os.net)
  let c = new_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"endTime\":\"2026-11-06T10:00:00Z\",\"error\":{\"code\":\"s-code\",\"message\":\"s-message\"},\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"bytesProcessed\":7,\"dataSinkName\":\"s-datasinkname\",\"dataSourceName\":\"s-datasourcename\",\"details\":{\"errorDetails\":[{\"errorCode\":7,\"errorMessage\":\"s-errormessage\",\"exceptionMessage\":\"s-exceptionmessage\",\"recommendedAction\":\"s-recommendedaction\"}],\"itemDetailsLink\":\"https://management.example.test/next?\$skiptoken=2\",\"jobDefinition\":{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"dataServiceInput\":{\"k\":\"v\"},\"dataSinkId\":\"s-datasinkid\",\"dataSourceId\":\"s-datasourceid\",\"lastModifiedTime\":\"2026-11-06T10:00:00Z\",\"runLocation\":\"s-runlocation\",\"state\":\"s-state\",\"userConfirmation\":\"s-userconfirmation\"},\"type\":\"s-type\"},\"jobStages\":[{\"jobStageDetails\":{\"k\":\"v\"},\"stageName\":\"s-stagename\",\"stageStatus\":\"s-stagestatus\"}]},\"isCancellable\":\"s-iscancellable\",\"itemsProcessed\":7,\"totalBytesToProcess\":7,\"totalItemsToProcess\":7},\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"type\":\"s-type\"}]}")
  gv_note(f, "CALL JobsClient.NewListByDataManagerPager")
  var pg = c.new_list_by_data_manager_pager("id1/ x", "id2/ x", JobsClientListByDataManagerOptions{filter: Some("s-filter")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_jobs_client_list_by_data_manager_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_23)
}

