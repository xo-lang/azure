fn show_services_client_list_by_subscription_response(r: ServicesClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.service_list_result).to_str_lossy()}")
  parts.join(" ")
}

