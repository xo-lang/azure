  let c = new_shared_private_link_resources_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"groupId\":\"s-groupid\",\"privateLinkResourceId\":\"https://management.example.test/next?\$skiptoken=2\",\"provisioningState\":\"Succeeded\",\"requestMessage\":\"s-requestmessage\",\"resourceRegion\":\"s-resourceregion\",\"status\":\"s-status\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL SharedPrivateLinkResourcesClient.Get")
  match c.get("id1/ x", "id2/ x", "id3/ x", SearchManagementRequestOptions{client_request_id: Some("s-clientrequestid")}, SharedPrivateLinkResourcesClientGetOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_shared_private_link_resources_client_get_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_25)
}

fn show_shared_private_link_resources_client_list_by_service_response(r: SharedPrivateLinkResourcesClientListByServiceResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.shared_private_link_resource_list_result).to_str_lossy()}")
  parts.join(" ")
}

