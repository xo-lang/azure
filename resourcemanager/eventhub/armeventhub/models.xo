/// ThrottlingPolicy's named fields, for its JSON.
struct ThrottlingPolicyKnown {
  metric_id as "metricId,omitempty": MetricID? = None
  name as "name,omitempty": Str? = None
  rate_limit_threshold as "rateLimitThreshold,omitempty": Int? = None
  type_ as "type,omitempty": ApplicationGroupPolicyType? = None
} derive Json

fn throttling_policy_json(x: ThrottlingPolicy) -> json.Value {
  let known = ThrottlingPolicyKnown{
    metric_id: x.metric_id,
    name: x.name,
    rate_limit_threshold: x.rate_limit_threshold,
    type_: x.type_,
  }
  with_discriminator(json.to_value(known), "type", "ThrottlingPolicy")
}

fn parse_throttling_policy(v: json.Value) -> ThrottlingPolicy ! json.DecodeErr {
  let k = json.from_value[ThrottlingPolicyKnown](v)?
  Ok(ThrottlingPolicy{
    metric_id: k.metric_id,
    name: k.name,
    rate_limit_threshold: k.rate_limit_threshold,
    type_: k.type_,
  })
}

