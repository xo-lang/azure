} derive Json(via: json.Value, to: encryption_json, from: parse_encryption)

/// Encryption's named fields, for its JSON.
struct EncryptionKnown {
  key_source as "keySource,omitempty": Str? = None
  key_vault_properties as "keyVaultProperties,omitempty": List[KeyVaultProperties]? = None
  require_infrastructure_encryption as "requireInfrastructureEncryption,omitempty": Bool? = None
} derive Json

fn encryption_json(x: Encryption) -> json.Value {
  let known = EncryptionKnown{
    key_source: x.key_source.map(fn(_: Str) -> Str { "Microsoft.KeyVault" }),
    key_vault_properties: x.key_vault_properties,
    require_infrastructure_encryption: x.require_infrastructure_encryption,
  }
  json.to_value(known)
}

fn parse_encryption(v: json.Value) -> Encryption ! json.DecodeErr {
  let k = json.from_value[EncryptionKnown](v)?
  Ok(Encryption{
    key_source: k.key_source,
    key_vault_properties: k.key_vault_properties,
    require_infrastructure_encryption: k.require_infrastructure_encryption,
  })
}

