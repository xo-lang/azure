test "Go's NamespacesClient.NewListPager" {
  let f = new_fake(os.net)
  let c = new_namespaces_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"alternateName\":\"s-alternatename\",\"clusterArmId\":\"s-clusterarmid\",\"createdAt\":\"2026-11-06T10:00:00Z\",\"disableLocalAuth\":true,\"encryption\":{\"keySource\":\"Microsoft.KeyVault\",\"keyVaultProperties\":[{\"keyName\":\"s-keyname\",\"keyVaultUri\":\"s-keyvaulturi\",\"keyVersion\":\"s-keyversion\"}],\"requireInfrastructureEncryption\":true},\"isAutoInflateEnabled\":true,\"kafkaEnabled\":true,\"maximumThroughputUnits\":7,\"metricId\":\"s-metricid\",\"minimumTlsVersion\":\"s-minimumtlsversion\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"serviceBusEndpoint\":\"s-servicebusendpoint\",\"status\":\"s-status\",\"updatedAt\":\"2026-11-06T10:00:00Z\",\"zoneRedundant\":true},\"sku\":{\"capacity\":7,\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  note(f, "CALL NamespacesClient.NewListPager")
  var pg = c.new_list_pager(NamespacesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_namespaces_client_list_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_51)
}

fn show_namespaces_client_regenerate_keys_response(r: NamespacesClientRegenerateKeysResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.access_keys).to_str_lossy()}")
  parts.join(" ")
}

