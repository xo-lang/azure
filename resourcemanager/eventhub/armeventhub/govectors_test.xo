    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_application_group_client_list_by_namespace_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_3)
}

