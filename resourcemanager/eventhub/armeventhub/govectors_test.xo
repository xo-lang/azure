test "Go's NamespacesClient.RegenerateKeys" {
  let f = new_fake(os.net)
  let c = new_namespaces_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"aliasPrimaryConnectionString\":\"s-aliasprimaryconnectionstring\",\"aliasSecondaryConnectionString\":\"s-aliassecondaryconnectionstring\",\"keyName\":\"s-keyname\",\"primaryConnectionString\":\"s-primaryconnectionstring\",\"primaryKey\":\"s-primarykey\",\"secondaryConnectionString\":\"s-secondaryconnectionstring\",\"secondaryKey\":\"s-secondarykey\"}")
  note(f, "CALL NamespacesClient.RegenerateKeys")
  match c.regenerate_keys("id1/ x", "id2/ x", "id3/ x", (json.decode_str[RegenerateAccessKeyParameters]("{\"key\":\"s-key\",\"keyType\":\"s-keytype\"}") ?? e => fault("${e}")), NamespacesClientRegenerateKeysOptions{}) {
    Ok(r) => note(f, "OUT: ${show_namespaces_client_regenerate_keys_response(r)}")
    Err(e) => note_lines(f, "OUT: error: ${err_text(e)}")
  }
  compare(log_of(f), GO_52)
}

