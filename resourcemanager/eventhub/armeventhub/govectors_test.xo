test "Go's EventHubsClient.NewListByNamespacePager" {
  let f = new_fake(os.net)
  let c = new_event_hubs_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"captureDescription\":{\"destination\":{\"identity\":{\"type\":\"s-type\",\"userAssignedIdentity\":\"s-userassignedidentity\"},\"name\":\"s-name\",\"properties\":{\"archiveNameFormat\":\"s-archivenameformat\",\"blobContainer\":\"s-blobcontainer\",\"dataLakeAccountName\":\"s-datalakeaccountname\",\"dataLakeFolderPath\":\"s-datalakefolderpath\",\"dataLakeSubscriptionId\":\"s-datalakesubscriptionid\",\"storageAccountResourceId\":\"s-storageaccountresourceid\"}},\"enabled\":true,\"encoding\":\"s-encoding\",\"intervalInSeconds\":7,\"sizeLimitInBytes\":7,\"skipEmptyArchives\":true},\"createdAt\":\"2026-11-06T10:00:00Z\",\"messageRetentionInDays\":7,\"partitionCount\":7,\"partitionIds\":[\"s-partitionids\"],\"retentionDescription\":{\"cleanupPolicy\":\"s-cleanuppolicy\",\"retentionTimeInHours\":7,\"tombstoneRetentionTimeInHours\":7},\"status\":\"s-status\",\"updatedAt\":\"2026-11-06T10:00:00Z\",\"userMetadata\":\"s-usermetadata\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  note(f, "CALL EventHubsClient.NewListByNamespacePager")
  var pg = c.new_list_by_namespace_pager("id1/ x", "id2/ x", EventHubsClientListByNamespaceOptions{skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_event_hubs_client_list_by_namespace_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_36)
}

