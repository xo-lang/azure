  "CALL NamespacesClient.RegenerateKeys",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.EventHub/namespaces/id2%2F%20x/authorizationRules/id3%2F%20x/regenerateKeys?api-version=2024-01-01",
