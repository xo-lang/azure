  let f = new_fake(os.net)
  let c = new_application_group_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"clientAppGroupIdentifier\":\"s-clientappgroupidentifier\",\"isEnabled\":true,\"policies\":[{\"metricId\":\"s-metricid\",\"name\":\"s-name\",\"rateLimitThreshold\":7,\"type\":\"ThrottlingPolicy\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  note(f, "CALL ApplicationGroupClient.NewListByNamespacePager")
  var pg = c.new_list_by_namespace_pager("id1/ x", "id2/ x", ApplicationGroupClientListByNamespaceOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
