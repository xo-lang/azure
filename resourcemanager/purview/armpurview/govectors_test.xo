    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_private_endpoint_connections_client_list_by_account_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_16)
}

fn show_private_link_resources_client_get_by_group_id_response(r: PrivateLinkResourcesClientGetByGroupIDResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.private_link_resource).to_str_lossy()}")
  parts.join(" ")
}

