// Generated from the output of a local Go program that calls every
// public method of each client of armdatacatalog v1.2.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_adc_catalogs_client_delete_response(r: ADCCatalogsClientDeleteResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL ADCCatalogsClient.BeginDelete",
  "REQ DELETE https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.DataCatalog/catalogs/id2%2F%20x?api-version=2016-03-30",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 ",
  "OUT: ",
]

test "Go's ADCCatalogsClient.BeginDelete" {
  let f = gv_new_fake(os.net)
  let c = new_adc_catalogs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL ADCCatalogsClient.BeginDelete")
  match c.begin_delete("id1/ x", "id2/ x", ADCCatalogsClientBeginDeleteOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_adc_catalogs_client_delete_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

