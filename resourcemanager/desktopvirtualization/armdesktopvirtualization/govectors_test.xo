  "CALL WorkspacesClient.Update",
  "REQ PATCH https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.DesktopVirtualization/workspaces/id2%2F%20x?api-version=2024-04-03",
