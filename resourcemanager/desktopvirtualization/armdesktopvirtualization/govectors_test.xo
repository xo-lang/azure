test "Go's MSIXPackagesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_msix_packages_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"displayName\":\"s-displayname\",\"imagePath\":\"s-imagepath\",\"isActive\":true,\"isRegularRegistration\":true,\"lastUpdated\":\"2026-11-06T10:00:00Z\",\"packageApplications\":[{\"appId\":\"s-appid\",\"appUserModelID\":\"s-appusermodelid\",\"description\":\"s-description\",\"friendlyName\":\"s-friendlyname\",\"iconImageName\":\"s-iconimagename\",\"rawIcon\":\"YWI=\",\"rawPng\":\"YWI=\"}],\"packageDependencies\":[{\"dependencyName\":\"s-dependencyname\",\"minVersion\":\"s-minversion\",\"publisher\":\"s-publisher\"}],\"packageFamilyName\":\"s-packagefamilyname\",\"packageName\":\"s-packagename\",\"packageRelativePath\":\"s-packagerelativepath\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL MSIXPackagesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", MSIXPackagesClientListOptions{initial_skip: Some(7), is_descending: Some(true), page_size: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_msix_packages_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_32)
}

