test "Go's WorkspacesClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_workspaces_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"SystemAssigned\"},\"kind\":\"s-kind\",\"location\":\"s-location\",\"managedBy\":\"s-managedby\",\"name\":\"s-name\",\"plan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"promotionCode\":\"s-promotioncode\",\"publisher\":\"s-publisher\",\"version\":\"s-version\"},\"properties\":{\"applicationGroupReferences\":[\"s-applicationgroupreferences\"],\"cloudPcResource\":true,\"description\":\"s-description\",\"friendlyName\":\"s-friendlyname\",\"objectId\":\"s-objectid\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"groupIds\":[\"s-groupids\"],\"privateEndpoint\":{\"id\":\"s-id\"},\"privateLinkServiceConnectionState\":{\"actionsRequired\":\"s-actionsrequired\",\"description\":\"s-description\",\"status\":\"s-status\"},\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL WorkspacesClient.Update")
  match c.update("id1/ x", "id2/ x", WorkspacesClientUpdateOptions{workspace: Some((json.decode_str[WorkspacePatch]("{\"properties\":{\"applicationGroupReferences\":[\"s-applicationgroupreferences\"],\"description\":\"s-description\",\"friendlyName\":\"s-friendlyname\",\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")))}) {
    Ok(r) => gv_note(f, "OUT: ${show_workspaces_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_79)
}
