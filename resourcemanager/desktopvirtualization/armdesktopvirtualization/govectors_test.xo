test "Go's ScalingPlanPooledSchedulesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_scaling_plan_pooled_schedules_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"daysOfWeek\":[\"s-daysofweek\"],\"offPeakLoadBalancingAlgorithm\":\"s-offpeakloadbalancingalgorithm\",\"offPeakStartTime\":{\"hour\":7,\"minute\":7},\"peakLoadBalancingAlgorithm\":\"s-peakloadbalancingalgorithm\",\"peakStartTime\":{\"hour\":7,\"minute\":7},\"rampDownCapacityThresholdPct\":7,\"rampDownForceLogoffUsers\":true,\"rampDownLoadBalancingAlgorithm\":\"s-rampdownloadbalancingalgorithm\",\"rampDownMinimumHostsPct\":7,\"rampDownNotificationMessage\":\"s-rampdownnotificationmessage\",\"rampDownStartTime\":{\"hour\":7,\"minute\":7},\"rampDownStopHostsWhen\":\"s-rampdownstophostswhen\",\"rampDownWaitTimeMinutes\":7,\"rampUpCapacityThresholdPct\":7,\"rampUpLoadBalancingAlgorithm\":\"s-rampuploadbalancingalgorithm\",\"rampUpMinimumHostsPct\":7,\"rampUpStartTime\":{\"hour\":7,\"minute\":7}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ScalingPlanPooledSchedulesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ScalingPlanPooledSchedulesClientListOptions{initial_skip: Some(7), is_descending: Some(true), page_size: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_scaling_plan_pooled_schedules_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_54)
}

