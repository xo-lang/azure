test "Go's MSIXPackagesClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_msix_packages_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"displayName\":\"s-displayname\",\"imagePath\":\"s-imagepath\",\"isActive\":true,\"isRegularRegistration\":true,\"lastUpdated\":\"2026-11-06T10:00:00Z\",\"packageApplications\":[{\"appId\":\"s-appid\",\"appUserModelID\":\"s-appusermodelid\",\"description\":\"s-description\",\"friendlyName\":\"s-friendlyname\",\"iconImageName\":\"s-iconimagename\",\"rawIcon\":\"YWI=\",\"rawPng\":\"YWI=\"}],\"packageDependencies\":[{\"dependencyName\":\"s-dependencyname\",\"minVersion\":\"s-minversion\",\"publisher\":\"s-publisher\"}],\"packageFamilyName\":\"s-packagefamilyname\",\"packageName\":\"s-packagename\",\"packageRelativePath\":\"s-packagerelativepath\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL MSIXPackagesClient.Update")
  match c.update("id1/ x", "id2/ x", "id3/ x", MSIXPackagesClientUpdateOptions{msix_package: Some((json.decode_str[MSIXPackagePatch]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"displayName\":\"s-displayname\",\"isActive\":true,\"isRegularRegistration\":true},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")))}) {
    Ok(r) => gv_note(f, "OUT: ${show_msix_packages_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_33)
}

