  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"failHealthCheckOnStagingFailure\":\"s-failhealthcheckonstagingfailure\",\"hostPoolReferences\":[\"s-hostpoolreferences\"],\"image\":{\"certificateExpiry\":\"2026-11-06T10:00:00Z\",\"certificateName\":\"s-certificatename\",\"displayName\":\"s-displayname\",\"imagePath\":\"s-imagepath\",\"isActive\":true,\"isPackageTimestamped\":\"s-ispackagetimestamped\",\"isRegularRegistration\":true,\"lastUpdated\":\"2026-11-06T10:00:00Z\",\"packageAlias\":\"s-packagealias\",\"packageApplications\":[{\"appId\":\"s-appid\",\"appUserModelID\":\"s-appusermodelid\",\"description\":\"s-description\",\"friendlyName\":\"s-friendlyname\",\"iconImageName\":\"s-iconimagename\",\"rawIcon\":\"YWI=\",\"rawPng\":\"YWI=\"}],\"packageDependencies\":[{\"dependencyName\":\"s-dependencyname\",\"minVersion\":\"s-minversion\",\"publisher\":\"s-publisher\"}],\"packageFamilyName\":\"s-packagefamilyname\",\"packageFullName\":\"s-packagefullname\",\"packageName\":\"s-packagename\",\"packageRelativePath\":\"s-packagerelativepath\",\"version\":\"s-version\"},\"keyVaultURL\":\"s-keyvaulturl\",\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AppAttachPackageInfoClient.NewImportPager")
  var pg = c.new_import_pager("id1/ x", "id2/ x", (json.decode_str[ImportPackageInfoRequest]("{\"packageArchitecture\":\"s-packagearchitecture\",\"path\":\"s-path\"}") ?? e => fault("${e}")), AppAttachPackageInfoClientImportOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_app_attach_package_info_client_import_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_6)
}

