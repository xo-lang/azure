  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"applicationType\":\"s-applicationtype\",\"commandLineArguments\":\"s-commandlinearguments\",\"commandLineSetting\":\"s-commandlinesetting\",\"description\":\"s-description\",\"filePath\":\"s-filepath\",\"friendlyName\":\"s-friendlyname\",\"iconContent\":\"YWI=\",\"iconHash\":\"s-iconhash\",\"iconIndex\":7,\"iconPath\":\"s-iconpath\",\"msixPackageApplicationId\":\"s-msixpackageapplicationid\",\"msixPackageFamilyName\":\"s-msixpackagefamilyname\",\"objectId\":\"s-objectid\",\"showInPortal\":true},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ApplicationsClient.NewListPager")
