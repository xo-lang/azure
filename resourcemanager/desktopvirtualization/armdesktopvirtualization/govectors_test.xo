test "Go's WorkspacesClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_workspaces_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"SystemAssigned\"},\"kind\":\"s-kind\",\"location\":\"s-location\",\"managedBy\":\"s-managedby\",\"name\":\"s-name\",\"plan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"promotionCode\":\"s-promotioncode\",\"publisher\":\"s-publisher\",\"version\":\"s-version\"},\"properties\":{\"applicationGroupReferences\":[\"s-applicationgroupreferences\"],\"cloudPcResource\":true,\"description\":\"s-description\",\"friendlyName\":\"s-friendlyname\",\"objectId\":\"s-objectid\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkspacesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(WorkspacesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workspaces_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_78)
}

fn show_workspaces_client_update_response(r: WorkspacesClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.workspace).to_str_lossy()}")
  parts.join(" ")
}

