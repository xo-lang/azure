  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"provisioningState\":\"Succeeded\",\"scopes\":[{\"displayName\":\"s-displayname\",\"resourceTypes\":[\"s-resourcetypes\"],\"tagKeysOnly\":[\"s-tagkeysonly\"],\"tags\":{\"k1\":\"s-tags\"}}],\"sku\":\"s-sku\",\"workspaceRoots\":[\"s-workspaceroots\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkspacesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(WorkspacesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workspaces_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_5)
}

fn show_workspaces_client_update_response(r: WorkspacesClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.workspace).to_str_lossy()}")
  parts.join(" ")
}

const GO_6: List[Str] = [
  "CALL WorkspacesClient.Update",
  "REQ PATCH https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.StorageDiscovery/storageDiscoveryWorkspaces/id2%2F%20x?api-version=2025-09-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"properties\":{\"description\":\"s-description\",\"scopes\":[{\"displayName\":\"s-displayname\",\"resourceTypes\":[\"s-resourcetypes\"],\"tagKeysOnly\":[\"s-tagkeysonly\"],\"tags\":{\"k1\":\"s-tags\"}}],\"sku\":\"s-sku\",\"workspaceRoots\":[\"s-workspaceroots\"]},\"tags\":{\"k1\":\"s-tags\"}}",
  "  SERVED 200 {\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"provisioningState\":\"Succeeded\",\"scopes\":[{\"displayName\":\"s-displayname\",\"resourceTypes\":[\"s-resourcetypes\"],\"tagKeysOnly\":[\"s-tagkeysonly\"],\"tags\":{\"k1\":\"s-tags\"}}],\"sku\":\"s-sku\",\"workspaceRoots\":[\"s-workspaceroots\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}",
  "OUT: body={\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"provisioningState\":\"Succeeded\",\"scopes\":[{\"displayName\":\"s-displayname\",\"resourceTypes\":[\"s-resourcetypes\"],\"tagKeysOnly\":[\"s-tagkeysonly\"],\"tags\":{\"k1\":\"s-tags\"}}],\"sku\":\"s-sku\",\"workspaceRoots\":[\"s-workspaceroots\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}",
]

test "Go's WorkspacesClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_workspaces_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"provisioningState\":\"Succeeded\",\"scopes\":[{\"displayName\":\"s-displayname\",\"resourceTypes\":[\"s-resourcetypes\"],\"tagKeysOnly\":[\"s-tagkeysonly\"],\"tags\":{\"k1\":\"s-tags\"}}],\"sku\":\"s-sku\",\"workspaceRoots\":[\"s-workspaceroots\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL WorkspacesClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[WorkspaceUpdate]("{\"properties\":{\"description\":\"s-description\",\"scopes\":[{\"displayName\":\"s-displayname\",\"resourceTypes\":[\"s-resourcetypes\"],\"tagKeysOnly\":[\"s-tagkeysonly\"],\"tags\":{\"k1\":\"s-tags\"}}],\"sku\":\"s-sku\",\"workspaceRoots\":[\"s-workspaceroots\"]},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), WorkspacesClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_workspaces_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_6)
}
