  let c = new_avs_assessment_options_operations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"avsExternalStorageTypes\":[{\"storageType\":\"s-storagetype\",\"targetLocations\":[\"s-targetlocations\"]}],\"avsNodes\":[{\"nodeType\":\"s-nodetype\",\"targetLocations\":[\"s-targetlocations\"]}],\"failuresToTolerateAndRaidLevelValues\":[\"s-failurestotolerateandraidlevelvalues\"],\"reservedInstanceAvsNodes\":[\"s-reservedinstanceavsnodes\"],\"reservedInstanceSupportedCurrencies\":[\"s-reservedinstancesupportedcurrencies\"],\"reservedInstanceSupportedLocations\":[\"s-reservedinstancesupportedlocations\"],\"reservedInstanceSupportedOffers\":[\"s-reservedinstancesupportedoffers\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AvsAssessmentOptionsOperationsClient.NewListByAssessmentProjectPager")
  var pg = c.new_list_by_assessment_project_pager("id1/ x", "id2/ x", AvsAssessmentOptionsOperationsClientListByAssessmentProjectOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_avs_assessment_options_operations_client_list_by_assessment_project_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_44)
}

