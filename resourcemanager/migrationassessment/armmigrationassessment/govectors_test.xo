  gv_note(f, "CALL AssessedSQLMachinesOperationsClient.NewListBySQLAssessmentV2Pager")
  var pg = c.new_list_by_sql_assessment_v2_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", AssessedSQLMachinesOperationsClientListBySQLAssessmentV2Options{continuation_token: Some("s-continuationtoken"), filter: Some("s-filter"), page_size: Some(7), total_record_count: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_assessed_sql_machines_operations_client_list_by_sql_assessment_v2_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_19)
}

fn show_assessed_sql_recommended_entity_operations_client_get_response(r: AssessedSQLRecommendedEntityOperationsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.assessed_sql_recommended_entity).to_str_lossy()}")
  parts.join(" ")
}

