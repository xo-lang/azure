  gv_note(f, "CALL BusinessCaseIaasSummaryOperationsClient.NewListByBusinessCasePager")
  var pg = c.new_list_by_business_case_pager("id1/ x", "id2/ x", "id3/ x", BusinessCaseIaasSummaryOperationsClientListByBusinessCaseOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_business_case_iaas_summary_operations_client_list_by_business_case_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_53)
}

fn show_business_case_operations_client_compare_summary_response(r: BusinessCaseOperationsClientCompareSummaryResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.compare_summary).to_str_lossy()}")
  parts.join(" ")
}

