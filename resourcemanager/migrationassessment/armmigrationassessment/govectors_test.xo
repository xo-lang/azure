  gv_note(f, "CALL BusinessCaseOperationsClient.BeginCompareSummary")
  match c.begin_compare_summary("id1/ x", "id2/ x", "id3/ x", (json.decode_str[json.Value]("{\"\$schema\":\"s-schema\",\"resources\":[]}") ?? e => fault("${e}")), BusinessCaseOperationsClientBeginCompareSummaryOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_business_case_operations_client_compare_summary_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_54)
}

fn show_business_case_operations_client_create_response(r: BusinessCaseOperationsClientCreateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.business_case).to_str_lossy()}")
  parts.join(" ")
}

