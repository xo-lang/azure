fn show_assessed_machines_operations_client_list_by_assessment_response(r: AssessedMachinesOperationsClientListByAssessmentResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.assessed_machine_list_result).to_str_lossy()}")
  parts.join(" ")
}

