fn show_assessed_sql_machines_operations_client_get_response(r: AssessedSQLMachinesOperationsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.assessed_sql_machine).to_str_lossy()}")
  parts.join(" ")
}

