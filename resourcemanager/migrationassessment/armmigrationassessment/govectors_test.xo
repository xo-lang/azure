test "Go's WebAppServicePlanV2OperationsClient.NewListByWebAppAssessmentV2Pager" {
  let f = gv_new_fake(os.net)
  let c = new_web_app_service_plan_v2_operations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"cores\":7,\"costComponents\":[{\"description\":\"s-description\",\"name\":\"s-name\",\"value\":1.5}],\"createdTimestamp\":\"2026-11-06T10:00:00Z\",\"monthlyCost\":1.5,\"numberOfWebApps\":7,\"ram\":1.5,\"scaleOutInstances\":7,\"storage\":1.5,\"updatedTimestamp\":\"2026-11-06T10:00:00Z\",\"webAppServicePlanName\":\"s-webappserviceplanname\",\"webAppSkuName\":\"s-webappskuname\",\"webAppSkuSize\":\"s-webappskusize\",\"webAppTargetType\":\"s-webapptargettype\",\"webAppType\":\"s-webapptype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WebAppServicePlanV2OperationsClient.NewListByWebAppAssessmentV2Pager")
  var pg = c.new_list_by_web_app_assessment_v2_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", WebAppServicePlanV2OperationsClientListByWebAppAssessmentV2Options{continuation_token: Some("s-continuationtoken"), filter: Some("s-filter"), page_size: Some(7), total_record_count: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_web_app_service_plan_v2_operations_client_list_by_web_app_assessment_v2_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_129)
}
