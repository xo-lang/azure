  let f = gv_new_fake(os.net)
  let c = new_business_case_operations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\",\"reportStatusDetails\":[{\"reportStatus\":\"s-reportstatus\",\"reportType\":\"s-reporttype\"}],\"settings\":{\"azureArcSettings\":{\"azureArcState\":\"s-azurearcstate\",\"laborCostPercentage\":1.5,\"managementSettings\":{}},\"azureSettings\":{\"avsLaborCostPercentage\":1.5,\"businessCaseType\":\"s-businesscasetype\",\"comfortFactor\":1.5,\"currency\":\"s-currency\",\"discountPercentage\":1.5,\"iaasLaborCostPercentage\":1.5,\"infrastructureGrowthRate\":1.5,\"networkCostPercentage\":1.5,\"paasLaborCostPercentage\":1.5,\"perYearMigrationCompletionPercentage\":{\"k1\":1.5},\"performanceDataEndTime\":\"2026-11-06T10:00:00Z\",\"performanceDataStartTime\":\"2026-11-06T10:00:00Z\",\"performanceUtilizationPercentile\":1.5,\"savingsOption\":\"s-savingsoption\",\"targetLocation\":\"s-targetlocation\",\"wacc\":1.5,\"workloadDiscoverySource\":\"s-workloaddiscoverysource\"},\"onPremiseSettings\":{\"computeSettings\":{\"hyperthreadCoreToMemoryRatio\":1.5,\"price\":1.5},\"facilitySettings\":{\"facilitiesCostPerKwh\":1.5},\"laborSettings\":{\"hourlyAdminCost\":1.5,\"physicalServersPerAdmin\":7,\"virtualMachinesPerAdmin\":7},\"managementSettings\":{},\"networkSettings\":{\"hardwareSoftwareCostPercentage\":1.5,\"maintenanceCostPercentage\":1.5},\"securitySettings\":{\"serverSecurityCostPerServerPerYear\":1.5,\"sqlServerSecurityCostPerServerPerYear\":1.5},\"storageSettings\":{\"costPerGbPerMonth\":1.5,\"maintainanceCostPercentageToAcquisitionCost\":1.5}}},\"state\":\"s-state\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BusinessCaseOperationsClient.NewListByAssessmentProjectPager")
  var pg = c.new_list_by_assessment_project_pager("id1/ x", "id2/ x", BusinessCaseOperationsClientListByAssessmentProjectOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_business_case_operations_client_list_by_assessment_project_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_59)
}

