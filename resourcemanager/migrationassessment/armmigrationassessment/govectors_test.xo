test "Go's AvsAssessmentsOperationsClient.NewListByGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_avs_assessments_operations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"assessmentErrorSummary\":{\"k1\":7},\"assessmentType\":\"s-assessmenttype\",\"avsAssessmentScenario\":\"s-avsassessmentscenario\",\"avsEstimatedExternalStorages\":[{\"monthlyPrice\":1.5,\"storageType\":\"s-storagetype\",\"storageUtilization\":1.5,\"totalStorageInGB\":1.5}],\"avsEstimatedNetworks\":[{\"monthlyPrice\":1.5,\"networkType\":\"s-networktype\"}],\"avsEstimatedNodes\":[{\"cpuUtilization\":1.5,\"fttRaidLevel\":\"s-fttraidlevel\",\"monthlyPrice\":1.5,\"nodeNumber\":7,\"nodeType\":\"s-nodetype\",\"pricingModel\":\"s-pricingmodel\",\"ramUtilization\":1.5,\"storageUtilization\":1.5,\"totalCpu\":1.5,\"totalRam\":1.5,\"totalStorage\":1.5}],\"azureLocation\":\"s-azurelocation\",\"azureOfferCode\":\"s-azureoffercode\",\"confidenceRatingInPercentage\":1.5,\"costComponents\":[{\"description\":\"s-description\",\"name\":\"s-name\",\"value\":1.5}],\"cpuHeadroom\":1.5,\"cpuUtilization\":1.5,\"createdTimestamp\":\"2026-11-06T10:00:00Z\",\"currency\":\"s-currency\",\"dedupeCompression\":1.5,\"discountPercentage\":1.5,\"externalStorageTypes\":[\"s-externalstoragetypes\"],\"failuresToTolerateAndRaidLevel\":\"s-failurestotolerateandraidlevel\",\"failuresToTolerateAndRaidLevelList\":[\"s-failurestotolerateandraidlevellist\"],\"groupType\":\"s-grouptype\",\"isStretchClusterEnabled\":true,\"isVcfByolEnabled\":true,\"limitingFactor\":\"s-limitingfactor\",\"memOvercommit\":1.5,\"nodeType\":\"s-nodetype\",\"nodeTypes\":[\"s-nodetypes\"],\"numberOfMachines\":7,\"numberOfNodes\":7,\"percentile\":\"s-percentile\",\"perfDataEndTime\":\"2026-11-06T10:00:00Z\",\"perfDataStartTime\":\"2026-11-06T10:00:00Z\",\"pricesTimestamp\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"ramUtilization\":1.5,\"reservedInstance\":\"s-reservedinstance\",\"scalingFactor\":1.5,\"schemaVersion\":\"s-schemaversion\",\"sizingCriterion\":\"s-sizingcriterion\",\"stage\":\"s-stage\",\"status\":\"s-status\",\"storageUtilization\":1.5,\"suitability\":\"s-suitability\",\"suitabilityExplanation\":\"s-suitabilityexplanation\",\"suitabilitySummary\":{\"k1\":7},\"timeRange\":\"s-timerange\",\"totalCpuCores\":1.5,\"totalMonthlyCost\":1.5,\"totalRamInGB\":1.5,\"totalStorageInGB\":1.5,\"updatedTimestamp\":\"2026-11-06T10:00:00Z\",\"vcpuOversubscription\":1.5},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AvsAssessmentsOperationsClient.NewListByGroupPager")
  var pg = c.new_list_by_group_pager("id1/ x", "id2/ x", "id3/ x", AvsAssessmentsOperationsClientListByGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_avs_assessments_operations_client_list_by_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_49)
}

fn show_business_case_avs_summary_operations_client_get_response(r: BusinessCaseAvsSummaryOperationsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.avs_summary).to_str_lossy()}")
  parts.join(" ")
}

