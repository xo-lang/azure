  gv_note(f, "CALL AssessedMachinesOperationsClient.NewListByAssessmentPager")
  var pg = c.new_list_by_assessment_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", AssessedMachinesOperationsClientListByAssessmentOptions{continuation_token: Some("s-continuationtoken"), filter: Some("s-filter"), page_size: Some(7), total_record_count: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_assessed_machines_operations_client_list_by_assessment_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_13)
}

fn show_assessed_sql_database_v2_operations_client_get_response(r: AssessedSQLDatabaseV2OperationsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.assessed_sql_database_v2).to_str_lossy()}")
  parts.join(" ")
}

