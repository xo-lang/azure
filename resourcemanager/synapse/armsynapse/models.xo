    DatabaseClassification.ReadOnlyFollowingDatabase(x) => json.to_value(x)
    DatabaseClassification.Database(x) => json.to_value(x)
  }
}

fn parse_database_classification(v: json.Value) -> DatabaseClassification ! json.DecodeErr {
  match v.get("kind") {
    Some(json.Value.Str("ReadWrite")) => Ok(DatabaseClassification.ReadWriteDatabase(json.from_value[ReadWriteDatabase](v)?))
    Some(json.Value.Str("ReadOnlyFollowing")) => Ok(DatabaseClassification.ReadOnlyFollowingDatabase(json.from_value[ReadOnlyFollowingDatabase](v)?))
    _ => Ok(DatabaseClassification.Database(json.from_value[Database](v)?))
  }
}

/// DataConnectionClassification: a DataConnection by its kind, Go's DataConnectionClassification interface.
pub enum DataConnectionClassification {
  /// kind "EventHub"
  EventHubDataConnection(from EventHubDataConnection)
  /// kind "IotHub"
  IotHubDataConnection(from IotHubDataConnection)
  /// kind "EventGrid"
  EventGridDataConnection(from EventGridDataConnection)
  /// Any other kind, as the base type.
  DataConnection(from DataConnection)
} derive Json(via: json.Value, to: data_connection_classification_json, from: parse_data_connection_classification)

fn data_connection_classification_json(c: DataConnectionClassification) -> json.Value {
  match c {
