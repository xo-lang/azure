    DataConnectionClassification.IotHubDataConnection(x) => json.to_value(x)
    DataConnectionClassification.EventGridDataConnection(x) => json.to_value(x)
    DataConnectionClassification.DataConnection(x) => json.to_value(x)
  }
}

fn parse_data_connection_classification(v: json.Value) -> DataConnectionClassification ! json.DecodeErr {
  match v.get("kind") {
    Some(json.Value.Str("EventHub")) => Ok(DataConnectionClassification.EventHubDataConnection(json.from_value[EventHubDataConnection](v)?))
    Some(json.Value.Str("IotHub")) => Ok(DataConnectionClassification.IotHubDataConnection(json.from_value[IotHubDataConnection](v)?))
    Some(json.Value.Str("EventGrid")) => Ok(DataConnectionClassification.EventGridDataConnection(json.from_value[EventGridDataConnection](v)?))
    _ => Ok(DataConnectionClassification.DataConnection(json.from_value[DataConnection](v)?))
