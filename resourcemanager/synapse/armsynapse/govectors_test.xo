fn show_workspaces_client_list_response(r: WorkspacesClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.workspace_info_list_result).to_str_lossy()}")
  parts.join(" ")
}

