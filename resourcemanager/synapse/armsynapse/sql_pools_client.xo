  path = path.replace("{workspaceName}", url.path_escape(workspace_name))
  if sql_pool_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter sqlPoolName cannot be empty"))
  }
  path = path.replace("{sqlPoolName}", url.path_escape(sql_pool_name))
  var q = url.values()
  var headers: List[(Str, Str)] = []
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: runtime.marshal_json(parameters)})
}

/// Rename a SQL pool.
pub fn (c: SQLPoolsClient) rename(resource_group_name: Str, workspace_name: Str, sql_pool_name: Str, parameters: ResourceMoveDefinition, options: SQLPoolsClientRenameOptions = SQLPoolsClientRenameOptions{}) -> SQLPoolsClientRenameResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let sp = runtime.start_span({}, "SQLPoolsClient.Rename", c.setup.pipeline.tracer)
  let req = sp.on(c.rename_create_request(resource_group_name, workspace_name, sql_pool_name, parameters, options) ?? e => return Err(sp.fail(e)))
  let resp = c.setup.pipeline.send(req) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![200].contains(resp.status) {
    return Err(sp.fail(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  let out = sql_pools_rename_handle(resp) ?? e => return Err(sp.fail(azcore.CallErr.Decode(e)))
  sp.end()
  Ok(out)
}
