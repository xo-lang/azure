  Ok(policy.Request{method: "POST", url: "${c.setup.endpoint}${path}${if qs == "" { "" } else { "?${qs}" }}", headers: headers, body: b""})
}

/// Revoke user delegation keys.
pub fn (c: AccountsClient) revoke_user_delegation_keys(resource_group_name: Str, account_name: Str, options: AccountsClientRevokeUserDelegationKeysOptions = AccountsClientRevokeUserDelegationKeysOptions{}) -> AccountsClientRevokeUserDelegationKeysResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.revoke_user_delegation_keys_create_request(resource_group_name, account_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  accounts_revoke_user_delegation_keys_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
