// Go's JSON for polymorphic models, from a Go program over Go's
// armstorage/v4 v4.3.0: a subtype alone (its discriminator unset, or set to
// another value), the base alone, and each through a field of the
// base's interface type. Go's subtype writes its own value always.

use github.com/xo-lang/azure/runtime

/// Where ours still differs from Go's: (Go's line, ours).
const DISC_KNOWN: List[(Str, Str)] = []

test "polymorphic models encode as Go's, alone and through the base" {
  let got = [
    "storage.derived ${runtime.marshal_json(BlobAccessPointAccessKeyAuthProperties{access_key_id: Some("ak")}).to_str_lossy()}",
    "storage.base ${runtime.marshal_json(BlobAccessPointRemoteAuthProperties{}).to_str_lossy()}",
    "storage.through ${runtime.marshal_json(BlobAccessPointAzureNetAppFilesSourceProperties{auth: Some(BlobAccessPointRemoteAuthPropertiesClassification.BlobAccessPointAccessKeyAuthProperties(BlobAccessPointAccessKeyAuthProperties{}))}).to_str_lossy()}",
    "storage.through_base ${runtime.marshal_json(BlobAccessPointAzureNetAppFilesSourceProperties{auth: Some(BlobAccessPointRemoteAuthPropertiesClassification.BlobAccessPointRemoteAuthProperties(BlobAccessPointRemoteAuthProperties{}))}).to_str_lossy()}",
  ]
  let want = [
    "storage.derived {\"accessKeyId\":\"ak\",\"authType\":\"AccessKey\"}",
    "storage.base {}",
    "storage.through {\"auth\":{\"authType\":\"AccessKey\"},\"sourceType\":\"AzureNetAppFiles\"}",
    "storage.through_base {\"auth\":{},\"sourceType\":\"AzureNetAppFiles\"}",
  ]
  expect(got.len()) == want.len()
  var bad: List[Str] = []
  var i = 0
  while i < want.len() {
    let w = want[i]
    let ours = DISC_KNOWN.filter(fn(p: (Str, Str)) -> Bool { p.0 == w }).get(0).map(fn(p: (Str, Str)) -> Str { p.1 }) ?? w
    if got[i] != ours {
      bad.push("want: ${ours}\n  got:  ${got[i]}")
    }
    i += 1
  }
  expect(bad.join("\n")) == ""
}
