  }
  runtime.new_poller(c.setup.pipeline, req, resp, "", "BlobContainersClientObjectLevelWormResponse", fn(r: http.Response) -> BlobContainersClientObjectLevelWormResponse ! Str { blob_containers_object_level_worm_handle(r) })
