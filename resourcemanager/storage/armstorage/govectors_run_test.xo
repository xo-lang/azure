// The Accounts client against the Go program's fake Resource Manager:
// each request, decoded result, page and resume token must be Go's
// (govectors_test.xo).

use std/json
use github.com/xo-lang/azure/arm

const GV_ST: Str = "{\"id\":\"/subscriptions/sub-test/resourceGroups/rg1/providers/Microsoft.Storage/storageAccounts/st1\",\"name\":\"st1\",\"type\":\"Microsoft.Storage/storageAccounts\",\"kind\":\"StorageV2\",\"location\":\"westus\",\"sku\":{\"name\":\"Standard_LRS\",\"tier\":\"Standard\"},\"properties\":{\"provisioningState\":\"Succeeded\",\"minimumTlsVersion\":\"TLS1_2\",\"allowBlobPublicAccess\":false,\"creationTime\":\"2026-01-02T03:04:05.1234567Z\",\"primaryEndpoints\":{\"blob\":\"https://st1.blob.example.test/\"},\"keyCreationTime\":{\"key1\":\"2026-01-02T03:04:05Z\",\"key2\":null},\"statusOfPrimary\":\"available\",\"newFutureProp\":true}}"
const GV_RG: Str = "/subscriptions/sub-test/resourceGroups/rg1"
const GV_OP: Str = "/subscriptions/sub-test/providers/Microsoft.Storage/locations/westus/asyncoperations/op2"

test "the create poller, its decoded account and the list pages match Go's" {
  let f = gv_serve(os.net)
  let c = new_accounts_client(os.net, os.clock, os.rand, SUB, Fixed{}, arm.ClientOptions{endpoint: EP})?
  gv_add(f, "PUT", "${GV_RG}/providers/Microsoft.Storage/storageAccounts/st1", GvReply{status: 202, body: "", headers: [("Location", "${EP}${GV_OP}?monitor=true&api-version=2024-01-01"), ("Retry-After", "1")]})
  gv_add(f, "GET", GV_OP, GvReply{status: 202, body: ""})
  gv_add(f, "GET", GV_OP, GvReply{status: 200, body: GV_ST})
  match c.begin_create("rg1", "st1", AccountCreateParameters{kind: Some(KIND_STORAGE_V2), location: Some("westus"), sku: Some(SKU{name: Some(SKU_NAME_STANDARD_LRS)})}) {
    Ok(p0) => {
      var p = p0
      gv_token(f, "create", p)
      gv_show(f, "create", p.poll_until_done(os.clock, frequency: 1ms), fn(r: AccountsClientCreateResponse) -> Str { gv_json(json.to_value(r.account)) })
    }
    Err(e) => gv_note(f, "ERR begin_create: ${gv_err(e)}")
  }
  let list = "${GV_RG}/providers/Microsoft.Storage/storageAccounts"
  gv_add(f, "GET", list, GvReply{status: 200, body: "{\"value\":[${GV_ST}],\"nextLink\":\"${EP}${list}?api-version=2024-01-01&\$skipToken=x y\"}"})
  gv_add(f, "GET", list, GvReply{status: 200, body: "{\"value\":[]}"})
  var pl = c.new_list_by_resource_group_pager("rg1")?
  while pl.more() {
    let pg = pl.next_page()
    gv_show(f, "list_page", pg, fn(r: AccountsClientListByResourceGroupResponse) -> Str { gv_json(json.to_value(r.account_list_result)) })
    if pg.is_err() {
      break
    }
  }
  gv_check(f)
}
