test "Go's SKUsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_skus_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"capabilities\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"kind\":\"s-kind\",\"locationInfo\":[{\"location\":\"s-location\",\"zones\":[\"s-zones\"]}],\"locations\":[\"s-locations\"],\"name\":\"s-name\",\"resourceType\":\"s-resourcetype\",\"restrictions\":[{\"reasonCode\":\"s-reasoncode\",\"type\":\"s-type\",\"values\":[\"s-values\"]}],\"tier\":\"s-tier\"}]}")
  gv_note(f, "CALL SKUsClient.NewListPager")
  var pg = c.new_list_pager(SKUsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_sk_us_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_121)
}

