test "Go's AccountsClient.GetCustomerInitiatedMigration" {
  let f = gv_new_fake(os.net)
  let c = new_accounts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"migrationFailedDetailedReason\":\"s-migrationfaileddetailedreason\",\"migrationFailedReason\":\"s-migrationfailedreason\",\"migrationStatus\":\"s-migrationstatus\",\"targetSkuName\":\"s-targetskuname\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL AccountsClient.GetCustomerInitiatedMigration")
  match c.get_customer_initiated_migration("id1/ x", "id2/ x", MigrationName("sha1"), AccountsClientGetCustomerInitiatedMigrationOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_accounts_client_get_customer_initiated_migration_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_8)
}

