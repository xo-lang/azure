  let c = new_accounts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL AccountsClient.Delete")
  match c.delete("id1/ x", "id2/ x", AccountsClientDeleteOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_accounts_client_delete_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_7)
}

fn show_accounts_client_get_customer_initiated_migration_response(r: AccountsClientGetCustomerInitiatedMigrationResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.account_migration).to_str_lossy()}")
  parts.join(" ")
}

