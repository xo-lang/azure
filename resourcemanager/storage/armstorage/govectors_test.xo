  let c = new_advanced_platform_metrics_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"enabled\":true,\"lastModifiedTime\":\"2026-11-06T10:00:00Z\",\"metricsEmitted\":[\"s-metricsemitted\"],\"ruleConfig\":{\"filterType\":\"s-filtertype\",\"filterValues\":[\"s-filtervalues\"]},\"ruleType\":\"s-ruletype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AdvancedPlatformMetricsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", AdvancedPlatformMetricsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
