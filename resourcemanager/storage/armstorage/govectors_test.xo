test "Go's AccountsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_accounts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"placement\":{\"zonePlacementPolicy\":\"s-zoneplacementpolicy\"},\"properties\":{\"accessTier\":\"s-accesstier\",\"accountMigrationInProgress\":true,\"allowBlobPublicAccess\":true,\"allowCrossTenantDelegationSas\":true,\"allowCrossTenantReplication\":true,\"allowSharedKeyAccess\":true,\"allowSharedKeyAccessForServices\":{\"blob\":{\"enabled\":true},\"file\":{\"enabled\":true},\"queue\":{\"enabled\":true},\"table\":{\"enabled\":true}},\"allowedCopyScope\":\"s-allowedcopyscope\",\"azureFilesIdentityBasedAuthentication\":{\"activeDirectoryProperties\":{\"accountType\":\"s-accounttype\",\"azureStorageSid\":\"s-azurestoragesid\",\"domainGuid\":\"s-domainguid\",\"domainName\":\"s-domainname\",\"domainSid\":\"s-domainsid\",\"forestName\":\"s-forestname\",\"netBiosDomainName\":\"s-netbiosdomainname\",\"samAccountName\":\"s-samaccountname\"},\"defaultSharePermission\":\"s-defaultsharepermission\",\"directoryServiceOptions\":\"s-directoryserviceoptions\",\"smbOAuthSettings\":{\"isSmbOAuthEnabled\":true}},\"blobRestoreStatus\":{\"failureReason\":\"s-failurereason\",\"parameters\":{\"timeToRestore\":\"2026-11-06T10:00:00Z\"},\"restoreId\":\"s-restoreid\",\"status\":\"s-status\"},\"creationTime\":\"2026-11-06T10:00:00Z\",\"customDomain\":{\"name\":\"s-name\",\"useSubDomainName\":true},\"dataCollaborationPolicyProperties\":{\"allowBlobAccessPoints\":true,\"allowCrossTenantDataSharing\":true,\"allowStorageConnectors\":true,\"allowStorageDataShares\":true},\"defaultToOAuthAuthentication\":true,\"dnsEndpointType\":\"s-dnsendpointtype\",\"dualStackEndpointPreference\":{\"publishIpv6Endpoint\":true},\"enableExtendedGroups\":true,\"encryption\":{\"identity\":{\"federatedIdentityClientId\":\"s-encryptionfederatedidentityclientid\",\"userAssignedIdentity\":\"s-encryptionuserassignedidentity\"},\"keySource\":\"s-keysource\",\"keyvaultproperties\":{\"currentVersionedKeyExpirationTimestamp\":\"2026-11-06T10:00:00Z\",\"currentVersionedKeyIdentifier\":\"s-currentversionedkeyidentifier\",\"keyname\":\"s-keyname\",\"keyvaulturi\":\"s-keyvaulturi\",\"keyversion\":\"s-keyversion\",\"lastKeyRotationTimestamp\":\"2026-11-06T10:00:00Z\"},\"requireInfrastructureEncryption\":true,\"services\":{\"blob\":{\"enabled\":true,\"keyType\":\"s-keytype\",\"lastEnabledTime\":\"2026-11-06T10:00:00Z\"},\"file\":{\"enabled\":true,\"keyType\":\"s-keytype\",\"lastEnabledTime\":\"2026-11-06T10:00:00Z\"},\"queue\":{\"enabled\":true,\"keyType\":\"s-keytype\",\"lastEnabledTime\":\"2026-11-06T10:00:00Z\"},\"table\":{\"enabled\":true,\"keyType\":\"s-keytype\",\"lastEnabledTime\":\"2026-11-06T10:00:00Z\"}}},\"failoverInProgress\":true,\"geoPriorityReplicationStatus\":{\"isBlobEnabled\":true},\"geoReplicationStats\":{\"canFailover\":true,\"canPlannedFailover\":true,\"lastSyncTime\":\"2026-11-06T10:00:00Z\",\"postFailoverRedundancy\":\"s-postfailoverredundancy\",\"postPlannedFailoverRedundancy\":\"s-postplannedfailoverredundancy\",\"status\":\"s-status\"},\"immutableStorageWithVersioning\":{\"enabled\":true,\"immutabilityPolicy\":{\"allowProtectedAppendWrites\":true,\"immutabilityPeriodSinceCreationInDays\":7,\"state\":\"s-state\"}},\"isHnsEnabled\":true,\"isLocalUserEnabled\":true,\"isNfsV3Enabled\":true,\"isSftpEnabled\":true,\"isSkuConversionBlocked\":true,\"keyCreationTime\":{\"key1\":\"2026-11-06T10:00:00Z\",\"key2\":\"2026-11-06T10:00:00Z\"},\"keyPolicy\":{\"keyExpirationPeriodInDays\":7},\"largeFileSharesState\":\"s-largefilesharesstate\",\"lastGeoFailoverTime\":\"2026-11-06T10:00:00Z\",\"minimumTlsVersion\":\"s-minimumtlsversion\",\"networkAc