test "Go's FileSharesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_file_shares_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"accessTier\":\"s-accesstier\",\"accessTierChangeTime\":\"2026-11-06T10:00:00Z\",\"accessTierStatus\":\"s-accesstierstatus\",\"deleted\":true,\"deletedTime\":\"2026-11-06T10:00:00Z\",\"enabledProtocols\":\"s-enabledprotocols\",\"fileSharePaidBursting\":{\"paidBurstingEnabled\":true,\"paidBurstingMaxBandwidthMibps\":7,\"paidBurstingMaxIops\":7},\"includedBurstIops\":7,\"lastModifiedTime\":\"2026-11-06T10:00:00Z\",\"leaseDuration\":\"s-leaseduration\",\"leaseState\":\"s-leasestate\",\"leaseStatus\":\"s-leasestatus\",\"maxBurstCreditsForIops\":7,\"metadata\":{\"k1\":\"s-metadata\"},\"nextAllowedProvisionedBandwidthDowngradeTime\":\"Fri, 06 Nov 2026 10:00:00 GMT\",\"nextAllowedProvisionedIopsDowngradeTime\":\"Fri, 06 Nov 2026 10:00:00 GMT\",\"nextAllowedQuotaDowngradeTime\":\"Fri, 06 Nov 2026 10:00:00 GMT\",\"provisionedBandwidthMibps\":7,\"provisionedIops\":7,\"remainingRetentionDays\":7,\"rootSquash\":\"s-rootsquash\",\"shareQuota\":7,\"shareUsageBytes\":7,\"signedIdentifiers\":[{\"accessPolicy\":{\"expiryTime\":\"2026-11-06T10:00:00Z\",\"permission\":\"s-permission\",\"startTime\":\"2026-11-06T10:00:00Z\"},\"id\":\"s-id\"}],\"snapshotTime\":\"2026-11-06T10:00:00Z\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL FileSharesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", FileSharesClientListOptions{expand: Some("s-expand"), filter: Some("s-filter"), maxpagesize: Some("s-maxpagesize")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_file_shares_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_88)
}

