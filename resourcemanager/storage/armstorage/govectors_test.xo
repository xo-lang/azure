test "Go's AccountsClient.RevokeUserDelegationKeys" {
  let f = gv_new_fake(os.net)
  let c = new_accounts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL AccountsClient.RevokeUserDelegationKeys")
  match c.revoke_user_delegation_keys("id1/ x", "id2/ x", AccountsClientRevokeUserDelegationKeysOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_accounts_client_revoke_user_delegation_keys_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_16)
