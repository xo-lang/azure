  gv_note(f, "CALL AccountsClient.NewListPager")
  var pg = c.new_list_pager(AccountsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_accounts_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_14)
}

fn show_accounts_client_regenerate_key_response(r: AccountsClientRegenerateKeyResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.account_list_keys_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_15: List[Str] = [
  "CALL AccountsClient.RegenerateKey",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.Storage/storageAccounts/id2%2F%20x/regenerateKey?api-version=2026-09-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"keyName\":\"s-keyname\"}",
  "  SERVED 200 {\"keys\":[{\"creationTime\":\"2026-11-06T10:00:00Z\",\"keyName\":\"s-keyname\",\"permissions\":\"s-permissions\",\"value\":\"s-value\"}]}",
  "OUT: body={\"keys\":[{\"creationTime\":\"2026-11-06T10:00:00Z\",\"keyName\":\"s-keyname\",\"permissions\":\"s-permissions\",\"value\":\"s-value\"}]}",
]

test "Go's AccountsClient.RegenerateKey" {
  let f = gv_new_fake(os.net)
  let c = new_accounts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"keys\":[{\"creationTime\":\"2026-11-06T10:00:00Z\",\"keyName\":\"s-keyname\",\"permissions\":\"s-permissions\",\"value\":\"s-value\"}]}")
  gv_note(f, "CALL AccountsClient.RegenerateKey")
  match c.regenerate_key("id1/ x", "id2/ x", (json.decode_str[AccountRegenerateKeyParameters]("{\"keyName\":\"s-keyname\"}") ?? e => fault("${e}")), AccountsClientRegenerateKeyOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_accounts_client_regenerate_key_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_15)
}

fn show_accounts_client_revoke_user_delegation_keys_response(r: AccountsClientRevokeUserDelegationKeysResponse) -> Str {
  var parts: List[Str] = []
