// Generated from the output of a local Go program that calls every
// public method of each client of armstorage v4.3.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_accounts_client_abort_hierarchical_namespace_migration_response(r: AccountsClientAbortHierarchicalNamespaceMigrationResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL AccountsClient.BeginAbortHierarchicalNamespaceMigration",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.Storage/storageAccounts/id2%2F%20x/aborthnsonmigration?api-version=2026-09-01",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 ",
  "OUT: ",
]

test "Go's AccountsClient.BeginAbortHierarchicalNamespaceMigration" {
  let f = gv_new_fake(os.net)
  let c = new_accounts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL AccountsClient.BeginAbortHierarchicalNamespaceMigration")
  match c.begin_abort_hierarchical_namespace_migration("id1/ x", "id2/ x", AccountsClientBeginAbortHierarchicalNamespaceMigrationOptions{}) {
    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(r) => gv_note(f, "OUT: ${show_accounts_client_abort_hierarchical_namespace_migration_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

fn show_accounts_client_create_response(r: AccountsClientCreateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.account).to_str_lossy()}")
  parts.join(" ")
}

