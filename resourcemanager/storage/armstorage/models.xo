  [RUN_STATUS_ENUM_IN_PROGRESS, RUN_STATUS_ENUM_FINISHED]
}

/// Represents the overall result of the execution for the run instance
pub type RunResult struct(Str)
pub const RUN_RESULT_SUCCEEDED: RunResult = RunResult("Succeeded")
pub const RUN_RESULT_FAILED: RunResult = RunResult("Failed")

/// The values of RunResult this version knows; the service may send others.
pub fn possible_run_result_values() -> List[RunResult] {
  [RUN_RESULT_SUCCEEDED, RUN_RESULT_FAILED]
}

