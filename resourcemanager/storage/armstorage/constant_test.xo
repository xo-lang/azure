// Go's JSON for models with CONSTANT fields (a one-value enum sealed
// to a string), from a Go program over Go's armstorage/v4 v4.3.0: each
// unset, then set to another value. Go writes a required one always, an
// optional one when set, as its constant whatever the field holds.

use github.com/xo-lang/azure/runtime

/// Where ours still differs from Go's: (Go's line, ours).
const CONST_KNOWN: List[(Str, Str)] = []

test "constant fields encode as Go's" {
  let got = [
    "storage.check.unset ${runtime.marshal_json(AccountCheckNameAvailabilityParameters{name: Some("n")}).to_str_lossy()}",
    "storage.check.other ${runtime.marshal_json(AccountCheckNameAvailabilityParameters{name: Some("n"), type_: Some("other")}).to_str_lossy()}",
    "storage.cache_check.unset ${runtime.marshal_json(ContextCacheCheckNameAvailabilityParameters{name: Some("n")}).to_str_lossy()}",
    "storage.cache_check.other ${runtime.marshal_json(ContextCacheCheckNameAvailabilityParameters{name: Some("n"), type_: Some("other")}).to_str_lossy()}",
    "storage.ip_rule.unset ${runtime.marshal_json(IPRule{ip_address_or_range: Some("r")}).to_str_lossy()}",
    "storage.ip_rule.other ${runtime.marshal_json(IPRule{ip_address_or_range: Some("r"), action: Some("other")}).to_str_lossy()}",
    "storage.vnet_rule.unset ${runtime.marshal_json(VirtualNetworkRule{virtual_network_resource_id: Some("v")}).to_str_lossy()}",
    "storage.vnet_rule.other ${runtime.marshal_json(VirtualNetworkRule{virtual_network_resource_id: Some("v"), action: Some("other")}).to_str_lossy()}",
  ]
  let want = [
    "storage.check.unset {\"name\":\"n\",\"type\":\"Microsoft.Storage/storageAccounts\"}",
    "storage.check.other {\"name\":\"n\",\"type\":\"Microsoft.Storage/storageAccounts\"}",
    "storage.cache_check.unset {\"name\":\"n\",\"type\":\"Microsoft.Storage/contextCaches\"}",
    "storage.cache_check.other {\"name\":\"n\",\"type\":\"Microsoft.Storage/contextCaches\"}",
    "storage.ip_rule.unset {\"value\":\"r\"}",
    "storage.ip_rule.other {\"action\":\"Allow\",\"value\":\"r\"}",
    "storage.vnet_rule.unset {\"id\":\"v\"}",
    "storage.vnet_rule.other {\"action\":\"Allow\",\"id\":\"v\"}",
  ]
  expect(got.len()) == want.len()
  var bad: List[Str] = []
  var i = 0
  while i < want.len() {
    let w = want[i]
    let ours = CONST_KNOWN.filter(fn(p: (Str, Str)) -> Bool { p.0 == w }).get(0).map(fn(p: (Str, Str)) -> Str { p.1 }) ?? w
    if got[i] != ours {
      bad.push("want: ${ours}\n  got:  ${got[i]}")
    }
    i += 1
  }
  expect(bad.join("\n")) == ""
}
