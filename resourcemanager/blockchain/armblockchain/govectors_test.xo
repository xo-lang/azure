test "Go's TransactionNodesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_transaction_nodes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"dns\":\"s-dns\",\"firewallRules\":[{\"endIpAddress\":\"s-endipaddress\",\"ruleName\":\"s-rulename\",\"startIpAddress\":\"s-startipaddress\"}],\"password\":\"s-password\",\"provisioningState\":\"Succeeded\",\"publicKey\":\"s-publickey\",\"userName\":\"s-username\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL TransactionNodesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", TransactionNodesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_transaction_nodes_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_19)
}

