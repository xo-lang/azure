  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"importance\":\"s-importance\",\"maxResourcePercent\":7,\"maxResourcePercentPerRequest\":1.5,\"minResourcePercent\":7,\"minResourcePercentPerRequest\":1.5,\"queryExecutionTimeout\":7},\"type\":\"s-type\"}]}",
  "OUT page 1: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"importance\":\"s-importance\",\"maxResourcePercent\":7,\"maxResourcePercentPerRequest\":1.5,\"minResourcePercent\":7,\"minResourcePercentPerRequest\":1.5,\"queryExecutionTimeout\":7},\"type\":\"s-type\"}]}",
  "REQ GET https://management.example.test/next?%24skiptoken=2",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"importance\":\"s-importance\",\"maxResourcePercent\":7,\"maxResourcePercentPerRequest\":1.5,\"minResourcePercent\":7,\"minResourcePercentPerRequest\":1.5,\"queryExecutionTimeout\":7},\"type\":\"s-type\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"importance\":\"s-importance\",\"maxResourcePercent\":7,\"maxResourcePercentPerRequest\":1.5,\"minResourcePercent\":7,\"minResourcePercentPerRequest\":1.5,\"queryExecutionTimeout\":7},\"type\":\"s-type\"}]}",
]

test "Go's WorkloadGroupsClient.NewListByDatabasePager" {
  let f = gv_new_fake(os.net)
  let c = new_workload_groups_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"importance\":\"s-importance\",\"maxResourcePercent\":7,\"maxResourcePercentPerRequest\":1.5,\"minResourcePercent\":7,\"minResourcePercentPerRequest\":1.5,\"queryExecutionTimeout\":7},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkloadGroupsClient.NewListByDatabasePager")
  var pg = c.new_list_by_database_pager("id1/ x", "id2/ x", "id3/ x", WorkloadGroupsClientListByDatabaseOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workload_groups_client_list_by_database_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_455)
}
