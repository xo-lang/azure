  let c = new_long_term_retention_backups_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"backupExpirationTime\":\"2026-11-06T10:00:00Z\",\"backupStorageRedundancy\":\"s-backupstorageredundancy\",\"backupTime\":\"2026-11-06T10:00:00Z\",\"databaseDeletionTime\":\"2026-11-06T10:00:00Z\",\"databaseName\":\"s-databasename\",\"requestedBackupStorageRedundancy\":\"s-requestedbackupstorageredundancy\",\"serverCreateTime\":\"2026-11-06T10:00:00Z\",\"serverName\":\"s-servername\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL LongTermRetentionBackupsClient.NewListByDatabasePager")
  var pg = c.new_list_by_database_pager("id1/ x", "id2/ x", "id3/ x", LongTermRetentionBackupsClientListByDatabaseOptions{database_state: Some(DatabaseState("s-databasestate")), only_latest_per_database: Some(true)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_long_term_retention_backups_client_list_by_database_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_182)
}

