test "Go's DatabaseOperationsClient.NewListByDatabasePager" {
  let f = gv_new_fake(os.net)
  let c = new_database_operations_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"databaseName\":\"s-databasename\",\"description\":\"s-description\",\"errorCode\":7,\"errorDescription\":\"s-errordescription\",\"errorSeverity\":7,\"estimatedCompletionTime\":\"2026-11-06T10:00:00Z\",\"isCancellable\":true,\"isUserError\":true,\"operation\":\"s-operation\",\"operationFriendlyName\":\"s-operationfriendlyname\",\"percentComplete\":7,\"serverName\":\"s-servername\",\"startTime\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DatabaseOperationsClient.NewListByDatabasePager")
  var pg = c.new_list_by_database_pager("id1/ x", "id2/ x", "id3/ x", DatabaseOperationsClientListByDatabaseOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_database_operations_client_list_by_database_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_31)
}

