test "Go's DatabasesClient.NewListByServerPager" {
  let f = gv_new_fake(os.net)
  let c = new_databases_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"s-kind\",\"location\":\"s-location\",\"managedBy\":\"s-managedby\",\"name\":\"s-name\",\"properties\":{\"autoPauseDelay\":7,\"catalogCollation\":\"s-catalogcollation\",\"collation\":\"s-collation\",\"createMode\":\"s-createmode\",\"creationDate\":\"2026-11-06T10:00:00Z\",\"currentBackupStorageRedundancy\":\"s-currentbackupstorageredundancy\",\"currentServiceObjectiveName\":\"s-currentserviceobjectivename\",\"currentSku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"databaseId\":\"s-databaseid\",\"defaultSecondaryLocation\":\"s-defaultsecondarylocation\",\"earliestRestoreDate\":\"2026-11-06T10:00:00Z\",\"elasticPoolId\":\"s-elasticpoolid\",\"failoverGroupId\":\"s-failovergroupid\",\"federatedClientId\":\"s-federatedclientid\",\"highAvailabilityReplicaCount\":7,\"isInfraEncryptionEnabled\":true,\"isLedgerOn\":true,\"licenseType\":\"s-licensetype\",\"longTermRetentionBackupResourceId\":\"s-longtermretentionbackupresourceid\",\"maintenanceConfigurationId\":\"s-maintenanceconfigurationid\",\"maxLogSizeBytes\":7,\"maxSizeBytes\":7,\"minCapacity\":1.5,\"pausedDate\":\"2026-11-06T10:00:00Z\",\"readScale\":\"s-readscale\",\"recoverableDatabaseId\":\"s-recoverabledatabaseid\",\"recoveryServicesRecoveryPointId\":\"s-recoveryservicesrecoverypointid\",\"requestedBackupStorageRedundancy\":\"s-requestedbackupstorageredundancy\",\"requestedServiceObjectiveName\":\"s-requestedserviceobjectivename\",\"restorableDroppedDatabaseId\":\"s-restorabledroppeddatabaseid\",\"restorePointInTime\":\"2026-11-06T10:00:00Z\",\"resumedDate\":\"2026-11-06T10:00:00Z\",\"sampleName\":\"s-samplename\",\"secondaryType\":\"s-secondarytype\",\"sourceDatabaseDeletionDate\":\"2026-11-06T10:00:00Z\",\"sourceDatabaseId\":\"s-sourcedatabaseid\",\"sourceResourceId\":\"s-sourceresourceid\",\"status\":\"s-status\",\"zoneRedundant\":true},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DatabasesClient.NewListByServerPager")
  var pg = c.new_list_by_server_pager("id1/ x", "id2/ x", DatabasesClientListByServerOptions{skip_token: Some("s-skiptoken")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_databases_client_list_by_server_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_65)
}

fn show_databases_client_list_inaccessible_by_server_response(r: DatabasesClientListInaccessibleByServerResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.database_list_result).to_str_lossy()}")
  parts.join(" ")
}

