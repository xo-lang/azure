nDate\":\"2026-11-06T10:00:00Z\",\"sourceDatabaseId\":\"s-sourcedatabaseid\",\"sourceResourceId\":\"s-sourceresourceid\",\"status\":\"s-status\",\"zoneRedundant\":true},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DatabasesClient.NewListByElasticPoolPager")
  var pg = c.new_list_by_elastic_pool_pager("id1/ x", "id2/ x", "id3/ x", DatabasesClientListByElasticPoolOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_databases_client_list_by_elastic_pool_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_64)
}

