fn (c: ManagedInstancesClient) failover_create_request(resource_group_name: Str, managed_instance_name: Str, options: ManagedInstancesClientBeginFailoverOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.Sql/managedInstances/{managedInstanceName}/failover"
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if managed_instance_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter managedInstanceName cannot be empty"))
  }
  path = path.replace("{managedInstanceName}", url.path_escape(managed_instance_name))
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter client.subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  var q = url.values()
  var headers: List[(Str, Str)] = []
  if let Some(v) = options.replica_type {
    q.add("replicaType", v.0)
  }
  q.add("api-version", "2021-05-01-preview")
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: b""})
}

