pub const CREATE_MODE_RESTORE_EXTERNAL_BACKUP_SECONDARY: CreateMode = CreateMode("RestoreExternalBackupSecondary")
pub const CREATE_MODE_RESTORE_LONG_TERM_RETENTION_BACKUP: CreateMode = CreateMode("RestoreLongTermRetentionBackup")
