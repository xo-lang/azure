pub struct ServerBlobAuditingPolicy {
  /// Resource ID.
  pub id as "id,omitempty": Str? = None
  /// Resource name.
  pub name as "name,omitempty": Str? = None
  /// Resource properties.
  pub properties as "properties,omitempty": ServerBlobAuditingPolicyProperties? = None
  /// Resource type.
  pub type_ as "type,omitempty": Str? = None
