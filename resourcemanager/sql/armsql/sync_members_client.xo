  runtime.new_poller(c.setup.pipeline, req, resp, "", "SyncMembersClientRefreshMemberSchemaResponse", fn(r: http.Response) -> SyncMembersClientRefreshMemberSchemaResponse ! Str { sync_members_refresh_member_schema_handle(r) }, traced: true)
}
