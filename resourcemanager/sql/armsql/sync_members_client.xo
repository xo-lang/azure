  let sp = runtime.start_span({}, "SyncMembersClient.BeginRefreshMemberSchema", c.setup.pipeline.tracer)
  let req = c.refresh_member_schema_create_request(resource_group_name, server_name, database_name, sync_group_name, sync_member_name, options) ?? e => return Err(sp.fail(e))
  let resp = c.setup.pipeline.send(sp.on(req)) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
