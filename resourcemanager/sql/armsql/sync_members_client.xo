    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "SyncMembersClientRefreshMemberSchemaResponse", fn(r: http.Response) -> SyncMembersClientRefreshMemberSchemaResponse ! Str { sync_members_refresh_member_schema_handle(r) }, traced: true)
