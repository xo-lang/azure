test "Go's ServiceReplicaClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_service_replica_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"codePackages\":[{\"commands\":[\"s-commands\"],\"diagnostics\":{\"enabled\":true,\"sinkRefs\":[\"s-sinkrefs\"]},\"endpoints\":[{\"name\":\"s-name\",\"port\":7}],\"entrypoint\":\"s-entrypoint\",\"environmentVariables\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"image\":\"s-image\",\"imageRegistryCredential\":{\"password\":\"s-password\",\"server\":\"s-server\",\"username\":\"s-username\"},\"instanceView\":{\"currentState\":{\"detailStatus\":\"s-detailstatus\",\"exitCode\":\"s-exitcode\",\"finishTime\":\"2026-11-06T10:00:00Z\",\"startTime\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\"},\"previousState\":{\"detailStatus\":\"s-detailstatus\",\"exitCode\":\"s-exitcode\",\"finishTime\":\"2026-11-06T10:00:00Z\",\"startTime\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\"},\"restartCount\":7},\"labels\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"name\":\"s-name\",\"reliableCollectionsRefs\":[{\"doNotPersistState\":true,\"name\":\"s-name\"}],\"resources\":{\"limits\":{\"cpu\":1.5,\"memoryInGB\":1.5},\"requests\":{\"cpu\":1.5,\"memoryInGB\":1.5}},\"settings\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"volumeRefs\":[{\"destinationPath\":\"s-destinationpath\",\"name\":\"s-name\",\"readOnly\":true}],\"volumes\":[{\"creationParameters\":{\"description\":\"s-description\",\"kind\":\"ServiceFabricVolumeDisk\",\"sizeDisk\":\"s-sizedisk\"},\"destinationPath\":\"s-destinationpath\",\"name\":\"s-name\",\"readOnly\":true}]}],\"diagnostics\":{\"enabled\":true,\"sinkRefs\":[\"s-sinkrefs\"]},\"networkRefs\":[{\"endpointRefs\":[{\"name\":\"s-name\"}],\"name\":\"s-name\"}],\"osType\":\"s-ostype\",\"replicaName\":\"s-replicaname\"}]}")
  gv_note(f, "CALL ServiceReplicaClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", ServiceReplicaClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_service_replica_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_30)
}

