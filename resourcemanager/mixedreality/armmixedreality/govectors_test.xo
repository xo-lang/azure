  var pg = c.new_list_by_resource_group_pager("id1/ x", RemoteRenderingAccountsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
