  let f = gv_new_fake(os.net)
  let c = new_object_anchors_accounts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"SystemAssigned\"},\"kind\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"location\":\"s-location\",\"name\":\"s-name\",\"plan\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"SystemAssigned\"},\"properties\":{\"accountDomain\":\"s-accountdomain\",\"accountId\":\"s-accountid\",\"storageAccountName\":\"s-storageaccountname\"},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
