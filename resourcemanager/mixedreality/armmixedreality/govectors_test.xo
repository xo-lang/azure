  let c = new_spatial_anchors_accounts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"SystemAssigned\"},\"kind\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"location\":\"s-location\",\"name\":\"s-name\",\"plan\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"SystemAssigned\"},\"properties\":{\"accountDomain\":\"s-accountdomain\",\"accountId\":\"s-accountid\",\"storageAccountName\":\"s-storageaccountname\"},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL SpatialAnchorsAccountsClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[SpatialAnchorsAccount]("{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"SystemAssigned\"},\"kind\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"location\":\"s-location\",\"name\":\"s-name\",\"plan\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"SystemAssigned\"},\"properties\":{\"accountDomain\":\"s-accountdomain\",\"accountId\":\"s-accountid\",\"storageAccountName\":\"s-storageaccountname\"},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), SpatialAnchorsAccountsClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_spatial_anchors_accounts_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_25)
}
