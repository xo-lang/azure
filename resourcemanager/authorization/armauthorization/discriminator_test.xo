// Go's JSON for polymorphic models, from a Go program over Go's
// armauthorization/v2 v2.2.0: a subtype alone (its discriminator unset, or set to
// another value), the base alone, and each through a field of the
// base's interface type. Go's subtype writes its own value always.

use github.com/xo-lang/azure/runtime

/// Where ours still differs from Go's: (Go's line, ours).
const DISC_KNOWN: List[(Str, Str)] = [
  ("authorization.derived {\"id\":\"a\",\"ruleType\":\"RoleManagementPolicyApprovalRule\"}", "authorization.derived {\"id\":\"a\"}"),
  ("authorization.derived_other {\"id\":\"a\",\"ruleType\":\"RoleManagementPolicyApprovalRule\"}", "authorization.derived_other {\"id\":\"a\",\"ruleType\":\"RoleManagementPolicyEnablementRule\"}"),
  ("authorization.base {\"id\":\"a\",\"ruleType\":null}", "authorization.base {\"id\":\"a\"}"),
]

test "polymorphic models encode as Go's, alone and through the base" {
  let got = [
    "authorization.derived ${runtime.marshal_json(RoleManagementPolicyApprovalRule{id: Some("a")}).to_str_lossy()}",
    "authorization.derived_other ${runtime.marshal_json(RoleManagementPolicyApprovalRule{id: Some("a"), rule_type: Some(ROLE_MANAGEMENT_POLICY_RULE_TYPE_ROLE_MANAGEMENT_POLICY_ENABLEMENT_RULE)}).to_str_lossy()}",
    "authorization.base ${runtime.marshal_json(RoleManagementPolicyRule{id: Some("a")}).to_str_lossy()}",
    "authorization.base_set ${runtime.marshal_json(RoleManagementPolicyRule{id: Some("a"), rule_type: Some(ROLE_MANAGEMENT_POLICY_RULE_TYPE_ROLE_MANAGEMENT_POLICY_ENABLEMENT_RULE)}).to_str_lossy()}",
    "authorization.through ${runtime.marshal_json(RoleManagementPolicyProperties{rules: Some([RoleManagementPolicyRuleClassification.RoleManagementPolicyApprovalRule(RoleManagementPolicyApprovalRule{id: Some("a")}), RoleManagementPolicyRuleClassification.RoleManagementPolicyRule(RoleManagementPolicyRule{id: Some("b")})])}).to_str_lossy()}",
  ]
  let want = [
    "authorization.derived {\"id\":\"a\",\"ruleType\":\"RoleManagementPolicyApprovalRule\"}",
    "authorization.derived_other {\"id\":\"a\",\"ruleType\":\"RoleManagementPolicyApprovalRule\"}",
    "authorization.base {\"id\":\"a\",\"ruleType\":null}",
    "authorization.base_set {\"id\":\"a\",\"ruleType\":\"RoleManagementPolicyEnablementRule\"}",
    "authorization.through {\"rules\":[{\"id\":\"a\",\"ruleType\":\"RoleManagementPolicyApprovalRule\"},{\"id\":\"b\",\"ruleType\":null}]}",
  ]
  expect(got.len()) == want.len()
  var bad: List[Str] = []
  var i = 0
  while i < want.len() {
    let w = want[i]
    let ours = DISC_KNOWN.filter(fn(p: (Str, Str)) -> Bool { p.0 == w }).get(0).map(fn(p: (Str, Str)) -> Str { p.1 }) ?? w
    if got[i] != ours {
      bad.push("want: ${ours}\n  got:  ${got[i]}")
    }
    i += 1
  }
  expect(bad.join("\n")) == ""
}
