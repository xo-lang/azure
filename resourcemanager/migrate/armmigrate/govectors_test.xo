// Generated from the output of a local Go program that calls every
// public method of each client of armmigrate v1.2.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_assessed_machines_client_get_response(r: AssessedMachinesClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.assessed_machine).to_str_lossy()}")
  if let Some(v) = r.xms_request_id {
    parts.push("XMSRequestID=${v}")
  }
  parts.join(" ")
}

