test "Go's ProjectsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_projects_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"eTag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"assessmentSolutionId\":\"s-assessmentsolutionid\",\"createdTimestamp\":\"2026-11-06T10:00:00Z\",\"customerStorageAccountArmId\":\"s-customerstorageaccountarmid\",\"customerWorkspaceId\":\"s-customerworkspaceid\",\"customerWorkspaceLocation\":\"s-customerworkspacelocation\",\"lastAssessmentTimestamp\":\"2026-11-06T10:00:00Z\",\"numberOfAssessments\":7,\"numberOfGroups\":7,\"numberOfMachines\":7,\"privateEndpointConnections\":[{\"eTag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"projectStatus\":\"s-projectstatus\",\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"serviceEndpoint\":\"s-serviceendpoint\",\"updatedTimestamp\":\"2026-11-06T10:00:00Z\"},\"tags\":{\"k\":\"v\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ProjectsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", ProjectsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_projects_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_36)
}

