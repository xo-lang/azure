  let f = gv_new_fake(os.net)
  let c = new_assessed_machines_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"eTag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"bootType\":\"s-boottype\",\"confidenceRatingInPercentage\":1.5,\"createdTimestamp\":\"2026-11-06T10:00:00Z\",\"datacenterMachineArmId\":\"s-datacentermachinearmid\",\"datacenterManagementServerArmId\":\"s-datacentermanagementserverarmid\",\"datacenterManagementServerName\":\"s-datacentermanagementservername\",\"description\":\"s-description\",\"disks\":{\"k1\":{\"displayName\":\"s-displayname\",\"gigabytesForRecommendedDiskSize\":7,\"gigabytesProvisioned\":1.5,\"megabytesPerSecondOfRead\":1.5,\"megabytesPerSecondOfWrite\":1.5,\"monthlyStorageCost\":1.5,\"name\":\"s-name\",\"numberOfReadOperationsPerSecond\":1.5,\"numberOfWriteOperationsPerSecond\":1.5,\"recommendedDiskSize\":\"s-recommendeddisksize\",\"recommendedDiskType\":\"s-recommendeddisktype\",\"suitability\":\"s-suitability\",\"suitabilityDetail\":\"s-suitabilitydetail\",\"suitabilityExplanation\":\"s-suitabilityexplanation\"}},\"displayName\":\"s-displayname\",\"megabytesOfMemory\":1.5,\"megabytesOfMemoryForRecommendedSize\":1.5,\"monthlyBandwidthCost\":1.5,\"monthlyComputeCostForRecommendedSize\":1.5,\"monthlyPremiumStorageCost\":1.5,\"monthlyStandardSSDStorageCost\":1.5,\"monthlyStorageCost\":1.5,\"networkAdapters\":{\"k1\":{\"displayName\":\"s-displayname\",\"ipAddresses\":[\"s-ipaddresses\"],\"macAddress\":\"s-macaddress\",\"megabytesPerSecondReceived\":1.5,\"megabytesPerSecondTransmitted\":1.5,\"monthlyBandwidthCosts\":1.5,\"netGigabytesTransmittedPerMonth\":1.5,\"suitability\":\"s-suitability\",\"suitabilityDetail\":\"s-suitabilitydetail\",\"suitabilityExplanation\":\"s-suitabilityexplanation\"}},\"numberOfCores\":7,\"numberOfCoresForRecommendedSize\":7,\"operatingSystemName\":\"s-operatingsystemname\",\"operatingSystemType\":\"s-operatingsystemtype\",\"operatingSystemVersion\":\"s-operatingsystemversion\",\"percentageCoresUtilization\":1.5,\"percentageMemoryUtilization\":1.5,\"recommendedSize\":\"s-recommendedsize\",\"suitability\":\"s-suitability\",\"suitabilityDetail\":\"s-suitabilitydetail\",\"suitabilityExplanation\":\"s-suitabilityexplanation\",\"updatedTimestamp\":\"2026-11-06T10:00:00Z\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AssessedMachinesClient.NewListByAssessmentPager")
  var pg = c.new_list_by_assessment_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", AssessedMachinesClientListByAssessmentOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_assessed_machines_client_list_by_assessment_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_1)
}

fn show_assessments_client_create_response(r: AssessmentsClientCreateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.assessment).to_str_lossy()}")
  if let Some(v) = r.xms_request_id {
    parts.push("XMSRequestID=${v}")
  }
  parts.join(" ")
}

