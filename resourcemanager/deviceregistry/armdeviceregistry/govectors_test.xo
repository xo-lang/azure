fn show_namespace_assets_client_get_response(r: NamespaceAssetsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.namespace_asset).to_str_lossy()}")
  parts.join(" ")
}

