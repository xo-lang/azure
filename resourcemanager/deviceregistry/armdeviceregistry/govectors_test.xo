test "Go's AssetsClient.BeginUpdate" {
  let f = gv_new_fake(os.net)
  let c = new_assets_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"assetEndpointProfileRef\":\"s-assetendpointprofileref\",\"attributes\":{\"k1\":{\"k\":\"v\"}},\"datasets\":[{\"dataPoints\":[{\"dataPointConfiguration\":\"s-datapointconfiguration\",\"dataSource\":\"s-datasource\",\"name\":\"s-name\",\"observabilityMode\":\"s-observabilitymode\"}],\"datasetConfiguration\":\"s-datasetconfiguration\",\"name\":\"s-name\",\"topic\":{\"path\":\"s-path\",\"retain\":\"s-retain\"}}],\"defaultDatasetsConfiguration\":\"s-defaultdatasetsconfiguration\",\"defaultEventsConfiguration\":\"s-defaulteventsconfiguration\",\"defaultTopic\":{\"path\":\"s-path\",\"retain\":\"s-retain\"},\"description\":\"s-description\",\"discoveredAssetRefs\":[\"s-discoveredassetrefs\"],\"displayName\":\"s-displayname\",\"documentationUri\":\"s-documentationuri\",\"enabled\":true,\"events\":[{\"eventConfiguration\":\"s-eventconfiguration\",\"eventNotifier\":\"s-eventnotifier\",\"name\":\"s-name\",\"observabilityMode\":\"s-observabilitymode\",\"topic\":{\"path\":\"s-path\",\"retain\":\"s-retain\"}}],\"externalAssetId\":\"s-externalassetid\",\"hardwareRevision\":\"s-hardwarerevision\",\"manufacturer\":\"s-manufacturer\",\"manufacturerUri\":\"s-manufactureruri\",\"model\":\"s-model\",\"productCode\":\"s-productcode\",\"provisioningState\":\"Succeeded\",\"serialNumber\":\"s-serialnumber\",\"softwareRevision\":\"s-softwarerevision\",\"status\":{\"datasets\":[{\"messageSchemaReference\":{\"schemaName\":\"s-schemaname\",\"schemaRegistryNamespace\":\"s-schemaregistrynamespace\",\"schemaVersion\":\"s-schemaversion\"},\"name\":\"s-name\"}],\"errors\":[{\"code\":7,\"message\":\"s-message\"}],\"events\":[{\"messageSchemaReference\":{\"schemaName\":\"s-schemaname\",\"schemaRegistryNamespace\":\"s-schemaregistrynamespace\",\"schemaVersion\":\"s-schemaversion\"},\"name\":\"s-name\"}],\"version\":7},\"uuid\":\"s-uuid\",\"version\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL AssetsClient.BeginUpdate")
  match c.begin_update("id1/ x", "id2/ x", (json.decode_str[AssetUpdate]("{\"properties\":{\"attributes\":{\"k1\":{\"k\":\"v\"}},\"datasets\":[{\"dataPoints\":[{\"dataPointConfiguration\":\"s-datapointconfiguration\",\"dataSource\":\"s-datasource\",\"name\":\"s-name\",\"observabilityMode\":\"s-observabilitymode\"}],\"datasetConfiguration\":\"s-datasetconfiguration\",\"name\":\"s-name\",\"topic\":{\"path\":\"s-path\",\"retain\":\"s-retain\"}}],\"defaultDatasetsConfiguration\":\"s-defaultdatasetsconfiguration\",\"defaultEventsConfiguration\":\"s-defaulteventsconfiguration\",\"defaultTopic\":{\"path\":\"s-path\",\"retain\":\"s-retain\"},\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"documentationUri\":\"s-documentationuri\",\"enabled\":true,\"events\":[{\"eventConfiguration\":\"s-eventconfiguration\",\"eventNotifier\":\"s-eventnotifier\",\"name\":\"s-name\",\"observabilityMode\":\"s-observabilitymode\",\"topic\":{\"path\":\"s-path\",\"retain\":\"s-retain\"}}],\"hardwareRevision\":\"s-hardwarerevision\",\"manufacturer\":\"s-manufacturer\",\"manufacturerUri\":\"s-manufactureruri\",\"model\":\"s-model\",\"productCode\":\"s-productcode\",\"serialNumber\":\"s-serialnumber\",\"softwareRevision\":\"s-softwarerevision\"},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), AssetsClientBeginUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_assets_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_8)
}

