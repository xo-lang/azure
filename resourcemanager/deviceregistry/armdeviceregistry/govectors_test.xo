  let c = new_asset_endpoint_profiles_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"additionalConfiguration\":\"s-additionalconfiguration\",\"authentication\":{\"method\":\"s-method\",\"usernamePasswordCredentials\":{\"passwordSecretName\":\"s-passwordsecretname\",\"usernameSecretName\":\"s-usernamesecretname\"},\"x509Credentials\":{\"certificateSecretName\":\"s-certificatesecretname\"}},\"discoveredAssetEndpointProfileRef\":\"s-discoveredassetendpointprofileref\",\"endpointProfileType\":\"s-endpointprofiletype\",\"provisioningState\":\"Succeeded\",\"status\":{\"errors\":[{\"code\":7,\"message\":\"s-message\"}]},\"targetAddress\":\"s-targetaddress\",\"uuid\":\"s-uuid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AssetEndpointProfilesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", AssetEndpointProfilesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_asset_endpoint_profiles_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_4)
}

