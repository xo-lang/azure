      Ok(r) => gv_note(f, "OUT page ${page}: ${show_billing_containers_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_13)
}

fn show_namespace_assets_client_create_or_replace_response(r: NamespaceAssetsClientCreateOrReplaceResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.namespace_asset).to_str_lossy()}")
  parts.join(" ")
}

