ourceForestSettings\":{\"resourceForest\":\"s-resourceforest\",\"settings\":[{\"friendlyName\":\"s-friendlyname\",\"remoteDnsIps\":\"s-remotednsips\",\"trustDirection\":\"s-trustdirection\",\"trustPassword\":\"s-trustpassword\",\"trustedDomainFqdn\":\"s-trusteddomainfqdn\"}]},\"sku\":\"s-sku\",\"syncOwner\":\"s-syncowner\",\"tenantId\":\"s-tenantid\",\"version\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
