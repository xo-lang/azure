test "Go's OuContainerClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_ou_container_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accounts\":[{\"accountName\":\"s-accountname\",\"password\":\"s-password\",\"spn\":\"s-spn\"}],\"containerId\":\"s-containerid\",\"deploymentId\":\"s-deploymentid\",\"distinguishedName\":\"s-distinguishedname\",\"domainName\":\"s-domainname\",\"provisioningState\":\"Succeeded\",\"serviceStatus\":\"s-servicestatus\",\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL OuContainerClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", OuContainerClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_ou_container_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_11)
}

