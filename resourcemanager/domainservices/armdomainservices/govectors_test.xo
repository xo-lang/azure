  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"configDiagnostics\":{\"lastExecuted\":\"Fri, 06 Nov 2026 10:00:00 UTC\",\"validatorResults\":[{\"replicaSetSubnetDisplayName\":\"s-replicasetsubnetdisplayname\",\"status\":\"s-status\",\"validatorId\":\"s-validatorid\"}]},\"deploymentId\":\"s-deploymentid\",\"domainConfigurationType\":\"s-domainconfigurationtype\",\"domainName\":\"s-domainname\",\"domainSecuritySettings\":{\"kerberosArmoring\":\"s-kerberosarmoring\",\"kerberosRc4Encryption\":\"s-kerberosrc4encryption\",\"ntlmV1\":\"s-ntlmv1\",\"syncKerberosPasswords\":\"s-synckerberospasswords\",\"syncNtlmPasswords\":\"s-syncntlmpasswords\",\"syncOnPremPasswords\":\"s-synconprempasswords\",\"tlsV1\":\"s-tlsv1\"},\"filteredSync\":\"s-filteredsync\",\"ldapsSettings\":{\"certificateNotAfter\":\"2026-11-06T10:00:00Z\",\"certificateThumbprint\":\"s-certificatethumbprint\",\"externalAccess\":\"s-externalaccess\",\"ldaps\":\"s-ldaps\",\"pfxCertificate\":\"s-pfxcertificate\",\"pfxCertificatePassword\":\"s-pfxcertificatepassword\",\"publicCertificate\":\"s-publiccertificate\"},\"migrationProperties\":{\"migrationProgress\":{\"completionPercentage\":1.5,\"progressMessage\":\"s-progressmessage\"},\"oldSubnetId\":\"s-oldsubnetid\",\"oldVnetSiteId\":\"s-oldvnetsiteid\"},\"notificationSettings\":{\"additionalRecipients\":[\"s-additionalrecipients\"],\"notifyDcAdmins\":\"s-notifydcadmins\",\"notifyGlobalAdmins\":\"s-notifyglobaladmins\"},\"provisioningState\":\"Succeeded\",\"replicaSets\":[{\"domainControllerIpAddress\":[\"s-domaincontrolleripaddress\"],\"externalAccessIpAddress\":\"s-externalaccessipaddress\",\"healthLastEvaluated\":\"Fri, 06 Nov 2026 10:00:00 UTC\",\"location\":\"s-location\",\"replicaSetId\":\"s-replicasetid\",\"serviceStatus\":\"s-servicestatus\",\"subnetId\":\"s-subnetid\",\"vnetSiteId\":\"s-vnetsiteid\"}],\"resourceForestSettings\":{\"resourceForest\":\"s-resourceforest\",\"settings\":[{\"friendlyName\":\"s-friendlyname\",\"remoteDnsIps\":\"s-remotednsips\",\"trustDirection\":\"s-trustdirection\",\"trustPassword\":\"s-trustpassword\",\"trustedDomainFqdn\":\"s-trusteddomainfqdn\"}]},\"sku\":\"s-sku\",\"syncOwner\":\"s-syncowner\",\"tenantId\":\"s-tenantid\",\"version\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Client.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_4)
}

