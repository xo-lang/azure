  let c = new_ou_container_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accounts\":[{\"accountName\":\"s-accountname\",\"password\":\"s-password\",\"spn\":\"s-spn\"}],\"containerId\":\"s-containerid\",\"deploymentId\":\"s-deploymentid\",\"distinguishedName\":\"s-distinguishedname\",\"domainName\":\"s-domainname\",\"provisioningState\":\"Succeeded\",\"serviceStatus\":\"s-servicestatus\",\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL OuContainerClient.BeginUpdate")
  match c.begin_update("id1/ x", "id2/ x", "id3/ x", (json.decode_str[ContainerAccount]("{\"accountName\":\"s-accountname\",\"password\":\"s-password\",\"spn\":\"s-spn\"}") ?? e => fault("${e}")), OuContainerClientBeginUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_ou_container_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_9)
}

fn show_ou_container_client_get_response(r: OuContainerClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.ou_container).to_str_lossy()}")
  parts.join(" ")
}

