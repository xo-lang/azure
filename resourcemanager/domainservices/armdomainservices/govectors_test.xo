\"}],\"healthLastEvaluated\":\"Fri, 06 Nov 2026 10:00:00 UTC\",\"healthMonitors\":[{\"details\":\"s-details\",\"id\":\"s-id\",\"name\":\"s-name\"}],\"location\":\"s-location\",\"replicaSetId\":\"s-replicasetid\",\"serviceStatus\":\"s-servicestatus\",\"subnetId\":\"s-subnetid\",\"vnetSiteId\":\"s-vnetsiteid\"}],\"resourceForestSettings\":{\"resourceForest\":\"s-resourceforest\",\"settings\":[{\"friendlyName\":\"s-friendlyname\",\"remoteDnsIps\":\"s-remotednsips\",\"trustDirection\":\"s-trustdirection\",\"trustPassword\":\"s-trustpassword\",\"trustedDomainFqdn\":\"s-trusteddomainfqdn\"}]},\"sku\":\"s-sku\",\"syncOwner\":\"s-syncowner\",\"tenantId\":\"s-tenantid\",\"version\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), ClientBeginUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_2)
}

fn show_client_get_response(r: ClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.domain_service).to_str_lossy()}")
  parts.join(" ")
}

