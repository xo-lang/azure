ies\":{\"k1\":\"s-custommessageproperties\"},\"message\":\"s-message\",\"namespace\":\"s-namespace\",\"topicPath\":\"s-topicpath\",\"transportType\":\"s-transporttype\"},\"type\":\"s-type\"},\"queueMessage\":{\"message\":\"s-message\",\"queueName\":\"s-queuename\",\"sasToken\":\"s-sastoken\",\"storageAccount\":\"s-storageaccount\"},\"request\":{\"authentication\":{\"password\":\"s-password\",\"type\":\"Basic\",\"username\":\"s-username\"},\"body\":\"s-body\",\"headers\":{\"k1\":\"s-headers\"},\"method\":\"s-method\",\"uri\":\"s-uri\"},\"retryPolicy\":{\"retryCount\":7,\"retryInterval\":\"s-retryinterval\",\"retryType\":\"s-retrytype\"},\"serviceBusQueueMessage\":{\"authentication\":{\"sasKey\":\"s-saskey\",\"sasKeyName\":\"s-saskeyname\",\"type\":\"s-type\"},\"brokeredMessageProperties\":{\"contentType\":\"s-contenttype\",\"correlationId\":\"s-correlationid\",\"forcePersistence\":true,\"label\":\"s-label\",\"messageId\":\"s-messageid\",\"partitionKey\":\"s-partitionkey\",\"replyTo\":\"s-replyto\",\"replyToSessionId\":\"s-replytosessionid\",\"scheduledEnqueueTimeUtc\":\"2026-11-06T10:00:00Z\",\"sessionId\":\"s-sessionid\",\"timeToLive\":\"s-timetolive\",\"to\":\"s-to\",\"viaPartitionKey\":\"s-viapartitionkey\"},\"customMessageProperties\":{\"k1\":\"s-custommessageproperties\"},\"message\":\"s-message\",\"namespace\":\"s-namespace\",\"queueName\":\"s-queuename\",\"transportType\":\"s-transporttype\"},\"serviceBusTopicMessage\":{\"authentication\":{\"sasKey\":\"s-saskey\",\"sasKeyName\":\"s-saskeyname\",\"type\":\"s-type\"},\"brokeredMessageProperties\":{\"contentType\":\"s-contenttype\",\"correlationId\":\"s-correlationid\",\"forcePersistence\":true,\"label\":\"s-label\",\"messageId\":\"s-messageid\",\"partitionKey\":\"s-partitionkey\",\"replyTo\":\"s-replyto\",\"replyToSessionId\":\"s-replytosessionid\",\"scheduledEnqueueTimeUtc\":\"2026-11-06T10:00:00Z\",\"sessionId\":\"s-sessionid\",\"timeToLive\":\"s-timetolive\",\"to\":\"s-to\",\"viaPartitionKey\":\"s-viapartitionkey\"},\"customMessageProperties\":{\"k1\":\"s-custommessageproperties\"},\"message\":\"s-message\",\"namespace\":\"s-namespace\",\"topicPath\":\"s-topicpath\",\"transportType\":\"s-transporttype\"},\"type\":\"s-type\"},\"recurrence\":{\"count\":7,\"endTime\":\"2026-11-06T10:00:00Z\",\"frequency\":\"s-frequency\",\"interval\":7,\"schedule\":{\"hours\":[7],\"minutes\":[7],\"monthDays\":[7],\"monthlyOccurrences\":[{\"Occurrence\":7,\"day\":\"s-day\"}],\"weekDays\":[\"s-weekdays\"]}},\"startTime\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\",\"status\":{\"executionCount\":7,\"failureCount\":7,\"faultedCount\":7,\"lastExecutionTime\":\"2026-11-06T10:00:00Z\",\"nextExecutionTime\":\"2026-11-06T10:00:00Z\"}},\"type\":\"s-type\"}") ?? e => fault("${e}")), JobsClientPatchOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_jobs_client_patch_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_13)
}

fn show_jobs_client_run_response(r: JobsClientRunResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_14: List[Str] = [
  "CALL JobsClient.Run",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.Scheduler/jobCollections/id2%2F%20x/jobs/id3%2F%20x/run?api-version=2016-03-01",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 ",
  "OUT: ",
]

test "Go's JobsClient.Run" {
  let f = gv_new_fake(os.net)
  let c = new_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL JobsClient.Run")
  match c.run("id1/ x", "id2/ x", "id3/ x", JobsClientRunOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_jobs_client_run_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_14)
}
