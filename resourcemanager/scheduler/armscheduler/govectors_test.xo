test "Go's JobsClient.NewListJobHistoryPager" {
  let f = gv_new_fake(os.net)
  let c = new_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"actionName\":\"s-actionname\",\"endTime\":\"2026-11-06T10:00:00Z\",\"expectedExecutionTime\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"repeatCount\":7,\"retryCount\":7,\"startTime\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL JobsClient.NewListJobHistoryPager")
  var pg = c.new_list_job_history_pager("id1/ x", "id2/ x", "id3/ x", JobsClientListJobHistoryOptions{filter: Some("s-filter"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_jobs_client_list_job_history_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_11)
}

fn show_jobs_client_list_response(r: JobsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.job_list_result).to_str_lossy()}")
  parts.join(" ")
}

