test "Go's TicketsNoSubscriptionClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_tickets_no_subscription_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"advancedDiagnosticConsent\":\"s-advanceddiagnosticconsent\",\"contactDetails\":{\"additionalEmailAddresses\":[\"s-additionalemailaddresses\"],\"country\":\"s-country\",\"firstName\":\"s-firstname\",\"lastName\":\"s-lastname\",\"phoneNumber\":\"s-phonenumber\",\"preferredContactMethod\":\"s-preferredcontactmethod\",\"preferredSupportLanguage\":\"s-preferredsupportlanguage\",\"preferredTimeZone\":\"s-preferredtimezone\",\"primaryEmailAddress\":\"s-primaryemailaddress\"},\"createdDate\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"enrollmentId\":\"s-enrollmentid\",\"fileWorkspaceName\":\"s-fileworkspacename\",\"isTemporaryTicket\":\"s-istemporaryticket\",\"modifiedDate\":\"2026-11-06T10:00:00Z\",\"problemClassificationDisplayName\":\"s-problemclassificationdisplayname\",\"problemClassificationId\":\"s-problemclassificationid\",\"problemScopingQuestions\":\"s-problemscopingquestions\",\"problemStartTime\":\"2026-11-06T10:00:00Z\",\"quotaTicketDetails\":{\"quotaChangeRequestSubType\":\"s-quotachangerequestsubtype\",\"quotaChangeRequestVersion\":\"s-quotachangerequestversion\",\"quotaChangeRequests\":[{\"payload\":\"s-payload\",\"region\":\"s-region\"}]},\"require24X7Response\":true,\"secondaryConsent\":[{\"type\":\"s-type\",\"userConsent\":\"s-userconsent\"}],\"serviceDisplayName\":\"s-servicedisplayname\",\"serviceId\":\"s-serviceid\",\"serviceLevelAgreement\":{\"expirationTime\":\"2026-11-06T10:00:00Z\",\"slaMinutes\":7,\"startTime\":\"2026-11-06T10:00:00Z\"},\"severity\":\"s-severity\",\"status\":\"s-status\",\"supportEngineer\":{\"emailAddress\":\"s-emailaddress\"},\"supportPlanDisplayName\":\"s-supportplandisplayname\",\"supportPlanId\":\"s-supportplanid\",\"supportPlanType\":\"s-supportplantype\",\"supportTicketId\":\"s-supportticketid\",\"technicalTicketDetails\":{\"resourceId\":\"s-resourceid\"},\"title\":\"s-title\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL TicketsNoSubscriptionClient.Update")
  match c.update("id1/ x", (json.decode_str[UpdateSupportTicket]("{\"advancedDiagnosticConsent\":\"s-advanceddiagnosticconsent\",\"contactDetails\":{\"additionalEmailAddresses\":[\"s-additionalemailaddresses\"],\"country\":\"s-country\",\"firstName\":\"s-firstname\",\"lastName\":\"s-lastname\",\"phoneNumber\":\"s-phonenumber\",\"preferredContactMethod\":\"s-preferredcontactmethod\",\"preferredSupportLanguage\":\"s-preferredsupportlanguage\",\"preferredTimeZone\":\"s-preferredtimezone\",\"primaryEmailAddress\":\"s-primaryemailaddress\"},\"secondaryConsent\":[{\"type\":\"s-type\",\"userConsent\":\"s-userconsent\"}],\"severity\":\"s-severity\",\"status\":\"s-status\"}") ?? e => fault("${e}")), TicketsNoSubscriptionClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_tickets_no_subscription_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_38)
}
