test "Go's TicketsNoSubscriptionClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_tickets_no_subscription_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"advancedDiagnosticConsent\":\"s-advanceddiagnosticconsent\",\"contactDetails\":{\"additionalEmailAddresses\":[\"s-additionalemailaddresses\"],\"country\":\"s-country\",\"firstName\":\"s-firstname\",\"lastName\":\"s-lastname\",\"phoneNumber\":\"s-phonenumber\",\"preferredContactMethod\":\"s-preferredcontactmethod\",\"preferredSupportLanguage\":\"s-preferredsupportlanguage\",\"preferredTimeZone\":\"s-preferredtimezone\",\"primaryEmailAddress\":\"s-primaryemailaddress\"},\"createdDate\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"enrollmentId\":\"s-enrollmentid\",\"fileWorkspaceName\":\"s-fileworkspacename\",\"isTemporaryTicket\":\"s-istemporaryticket\",\"modifiedDate\":\"2026-11-06T10:00:00Z\",\"problemClassificationDisplayName\":\"s-problemclassificationdisplayname\",\"problemClassificationId\":\"s-problemclassificationid\",\"problemScopingQuestions\":\"s-problemscopingquestions\",\"problemStartTime\":\"2026-11-06T10:00:00Z\",\"quotaTicketDetails\":{\"quotaChangeRequestSubType\":\"s-quotachangerequestsubtype\",\"quotaChangeRequestVersion\":\"s-quotachangerequestversion\",\"quotaChangeRequests\":[{\"payload\":\"s-payload\",\"region\":\"s-region\"}]},\"require24X7Response\":true,\"secondaryConsent\":[{\"type\":\"s-type\",\"userConsent\":\"s-userconsent\"}],\"serviceDisplayName\":\"s-servicedisplayname\",\"serviceId\":\"s-serviceid\",\"serviceLevelAgreement\":{\"expirationTime\":\"2026-11-06T10:00:00Z\",\"slaMinutes\":7,\"startTime\":\"2026-11-06T10:00:00Z\"},\"severity\":\"s-severity\",\"status\":\"s-status\",\"supportEngineer\":{\"emailAddress\":\"s-emailaddress\"},\"supportPlanDisplayName\":\"s-supportplandisplayname\",\"supportPlanId\":\"s-supportplanid\",\"supportPlanType\":\"s-supportplantype\",\"supportTicketId\":\"s-supportticketid\",\"technicalTicketDetails\":{\"resourceId\":\"s-resourceid\"},\"title\":\"s-title\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL TicketsNoSubscriptionClient.NewListPager")
  var pg = c.new_list_pager(TicketsNoSubscriptionClientListOptions{filter: Some("s-filter"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_tickets_no_subscription_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_37)
}

fn show_tickets_no_subscription_client_update_response(r: TicketsNoSubscriptionClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.ticket_details).to_str_lossy()}")
  parts.join(" ")
}

