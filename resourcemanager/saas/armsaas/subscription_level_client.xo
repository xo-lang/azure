fn (c: SubscriptionLevelClient) move_resources_create_request(resource_group_name: Str, move_resource_parameter: MoveResource, options: SubscriptionLevelClientBeginMoveResourcesOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/moveResources"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter client.subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: runtime.marshal_json(move_resource_parameter)})
}

/// Move a specified Subscription Level SaaS.
pub fn (c: SubscriptionLevelClient[fx]) begin_move_resources(resource_group_name: Str, move_resource_parameter: MoveResource, options: SubscriptionLevelClientBeginMoveResourcesOptions = SubscriptionLevelClientBeginMoveResourcesOptions{}) -> runtime.Poller[SubscriptionLevelClientMoveResourcesResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "SubscriptionLevelClientMoveResourcesResponse", fn(r: http.Response) -> SubscriptionLevelClientMoveResourcesResponse ! Str { subscription_level_move_resources_handle(r) })
  }
  let req = c.move_resources_create_request(resource_group_name, move_resource_parameter, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "location", "SubscriptionLevelClientMoveResourcesResponse", fn(r: http.Response) -> SubscriptionLevelClientMoveResourcesResponse ! Str { subscription_level_move_resources_handle(r) })
}
