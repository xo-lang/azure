fn show_applications_client_list_response(r: ApplicationsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.app_response_with_continuation).to_str_lossy()}")
  parts.join(" ")
}

