  "CALL ApplicationsClient.NewListPager",
  "REQ GET https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.SaaS/applications?api-version=2018-03-01-beta",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"saasAppPlan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"publisher\":\"s-publisher\"},\"status\":\"s-status\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}",
  "OUT page 1: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"saasAppPlan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"publisher\":\"s-publisher\"},\"status\":\"s-status\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}",
  "REQ GET https://management.example.test/next?%24skiptoken=2",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"saasAppPlan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"publisher\":\"s-publisher\"},\"status\":\"s-status\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"saasAppPlan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"publisher\":\"s-publisher\"},\"status\":\"s-status\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}",
]

test "Go's ApplicationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_applications_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"saasAppPlan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"publisher\":\"s-publisher\"},\"status\":\"s-status\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ApplicationsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", ApplicationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_applications_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_0)
}

