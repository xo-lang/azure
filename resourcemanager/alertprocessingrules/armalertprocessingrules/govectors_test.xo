  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"actions\":[{\"actionType\":\"AddActionGroups\"}],\"conditions\":[{\"field\":\"s-field\",\"operator\":\"s-operator\",\"values\":[\"s-values\"]}],\"description\":\"s-description\",\"enabled\":true,\"schedule\":{\"effectiveFrom\":\"s-effectivefrom\",\"effectiveUntil\":\"s-effectiveuntil\",\"recurrences\":[{\"endTime\":\"s-endtime\",\"recurrenceType\":\"Daily\",\"startTime\":\"s-starttime\"}],\"timeZone\":\"s-timezone\"},\"scopes\":[\"s-scopes\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Client.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(ClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_4)
}

fn show_client_update_response(r: ClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.alert_processing_rule).to_str_lossy()}")
  if let Some(v) = r.request_id {
    parts.push("RequestID=${v}")
  }
  parts.join(" ")
}

const GO_5: List[Str] = [
  "CALL Client.Update",
  "REQ PATCH https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.AlertsManagement/actionRules/id2%2F%20x?api-version=2021-08-08",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"properties\":{\"enabled\":true},\"tags\":{\"k1\":\"s-tags\"}}",
  "  SERVED 200 {\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"actions\":[{\"actionGroupIds\":[\"s-actiongroupids\"],\"actionType\":\"AddActionGroups\"}],\"conditions\":[{\"field\":\"s-field\",\"operator\":\"s-operator\",\"values\":[\"s-values\"]}],\"description\":\"s-description\",\"enabled\":true,\"schedule\":{\"effectiveFrom\":\"s-effectivefrom\",\"effectiveUntil\":\"s-effectiveuntil\",\"recurrences\":[{\"endTime\":\"s-endtime\",\"recurrenceType\":\"Daily\",\"startTime\":\"s-starttime\"}],\"timeZone\":\"s-timezone\"},\"scopes\":[\"s-scopes\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}",
  "OUT: body={\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"actions\":[{\"actionGroupIds\":[\"s-actiongroupids\"],\"actionType\":\"AddActionGroups\"}],\"conditions\":[{\"field\":\"s-field\",\"operator\":\"s-operator\",\"values\":[\"s-values\"]}],\"description\":\"s-description\",\"enabled\":true,\"schedule\":{\"effectiveFrom\":\"s-effectivefrom\",\"effectiveUntil\":\"s-effectiveuntil\",\"recurrences\":[{\"endTime\":\"s-endtime\",\"recurrenceType\":\"Daily\",\"startTime\":\"s-starttime\"}],\"timeZone\":\"s-timezone\"},\"scopes\":[\"s-scopes\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"} RequestID=rid-1",
]

test "Go's Client.Update" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"actions\":[{\"actionGroupIds\":[\"s-actiongroupids\"],\"actionType\":\"AddActionGroups\"}],\"conditions\":[{\"field\":\"s-field\",\"operator\":\"s-operator\",\"values\":[\"s-values\"]}],\"description\":\"s-description\",\"enabled\":true,\"schedule\":{\"effectiveFrom\":\"s-effectivefrom\",\"effectiveUntil\":\"s-effectiveuntil\",\"recurrences\":[{\"endTime\":\"s-endtime\",\"recurrenceType\":\"Daily\",\"startTime\":\"s-starttime\"}],\"timeZone\":\"s-timezone\"},\"scopes\":[\"s-scopes\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL Client.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[PatchObject]("{\"properties\":{\"enabled\":true},\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), ClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_5)
}
