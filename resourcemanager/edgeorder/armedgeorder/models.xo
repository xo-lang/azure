  /// Any other billingType, as the base type.
  MeterDetails(from MeterDetails)
} derive Json(via: json.Value, to: meter_details_classification_json, from: parse_meter_details_classification)

fn meter_details_classification_json(c: MeterDetailsClassification) -> json.Value {
  match c {
    MeterDetailsClassification.Pav2MeterDetails(x) => json.to_value(x)
    MeterDetailsClassification.PurchaseMeterDetails(x) => json.to_value(x)
    MeterDetailsClassification.MeterDetails(x) => json.to_value(x)
  }
}

fn parse_meter_details_classification(v: json.Value) -> MeterDetailsClassification ! json.DecodeErr {
  match v.get("billingType") {
    Some(json.Value.Str("Pav2")) => Ok(MeterDetailsClassification.Pav2MeterDetails(json.from_value[Pav2MeterDetails](v)?))
    Some(json.Value.Str("Purchase")) => Ok(MeterDetailsClassification.PurchaseMeterDetails(json.from_value[PurchaseMeterDetails](v)?))
    _ => Ok(MeterDetailsClassification.MeterDetails(json.from_value[MeterDetails](v)?))
  }
}

/// `v` with its discriminator `key` set to `value`, as Go's
/// MarshalJSON writes a subtype's (its keys sorted).
fn with_discriminator(v: json.Value, key: Str, value: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object((fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != key }) + [(key, json.Value.Str(value))]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    other => other
  }
}

