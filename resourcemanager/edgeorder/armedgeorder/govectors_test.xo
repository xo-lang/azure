test "Go's OrdersClient.Get" {
  let f = gv_new_fake(os.net)
  let c = new_orders_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"currentStage\":{\"displayName\":\"s-displayname\",\"stageName\":\"s-stagename\",\"stageStatus\":\"s-stagestatus\",\"startTime\":\"2026-11-06T10:00:00Z\"},\"orderItemIds\":[\"s-orderitemids\"],\"orderMode\":\"s-ordermode\",\"orderStageHistory\":[{\"displayName\":\"s-displayname\",\"stageName\":\"s-stagename\",\"stageStatus\":\"s-stagestatus\",\"startTime\":\"2026-11-06T10:00:00Z\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL OrdersClient.Get")
  match c.get("id1/ x", "id2/ x", "id3/ x", OrdersClientGetOptions{}) {
