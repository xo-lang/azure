  gv_note(f, "CALL OrderItemsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", OrderItemsClientListByResourceGroupOptions{expand: Some("s-expand"), filter: Some("s-filter"), skip_token: Some("s-skiptoken"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_order_items_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_13)
}

fn show_order_items_client_list_by_subscription_response(r: OrderItemsClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.order_item_resource_list).to_str_lossy()}")
  parts.join(" ")
}

