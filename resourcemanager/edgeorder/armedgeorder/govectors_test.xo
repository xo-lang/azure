fn show_order_items_client_list_by_resource_group_response(r: OrderItemsClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.order_item_resource_list).to_str_lossy()}")
  parts.join(" ")
}

