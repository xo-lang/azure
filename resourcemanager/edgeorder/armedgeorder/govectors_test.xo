fn show_order_items_client_cancel_response(r: OrderItemsClientCancelResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_11: List[Str] = [
  "CALL OrderItemsClient.Cancel",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.EdgeOrder/orderItems/id2%2F%20x/cancel?api-version=2024-02-01",
  "  H authorization=Bearer tok | content-type=application/json",
  "  B {\"reason\":\"s-reason\"}",
  "  SERVED 200 ",
  "OUT: ",
]

test "Go's OrderItemsClient.Cancel" {
  let f = gv_new_fake(os.net)
  let c = new_order_items_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "")
  gv_note(f, "CALL OrderItemsClient.Cancel")
  match c.cancel("id1/ x", "id2/ x", (json.decode_str[CancellationReason]("{\"reason\":\"s-reason\"}") ?? e => fault("${e}")), OrderItemsClientCancelOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_order_items_client_cancel_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_11)
}

fn show_order_items_client_get_response(r: OrderItemsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.order_item_resource).to_str_lossy()}")
  parts.join(" ")
}

