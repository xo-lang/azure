pub struct RecommendVMSKUMemory {
  /// The key-value cache memory required for a single concurrent request, in gibibytes.
  pub kv_cache_gi_b_per_request as "kvCacheGiBPerRequest,omitempty": Float? = None
  /// The key-value cache memory required for all concurrent requests on a replica, in gibibytes.
  pub kv_cache_gi_b_total as "kvCacheGiBTotal,omitempty": Float? = None
  /// The combined model-weight and key-value cache memory required per replica, in gibibytes.
  pub model_and_kv_cache_gi_b as "modelAndKvCacheGiB,omitempty": Float? = None
  /// The memory required for the model weights, in gibibytes.
  pub model_weights_gi_b as "modelWeightsGiB,omitempty": Float? = None
} derive Json

/// The sources used for the sizing calculation.
pub struct RecommendVMSKUSizingBasis {
  /// Where the context length was resolved from.
  pub context_length_source as "contextLengthSource,omitempty": ContextLengthSource? = None
  /// How the model weight memory was calculated.
  pub model_weights_calculation as "modelWeightsCalculation,omitempty": ModelWeightsCalculation? = None
  /// Where the model parameter count was resolved from.
  pub parameter_count_source as "parameterCountSource,omitempty": ParameterCountSource? = None
} derive Json

/// The resolved workload sizing shared by every recommended option.
pub struct RecommendVMSKUSizing {
  /// The sources used for the sizing calculation.
  pub basis as "basis,omitempty": RecommendVMSKUSizingBasis? = None
  /// The memory calculation shared by every returned option.
  pub memory as "memory,omitempty": RecommendVMSKUMemory? = None
  /// The resolved model identity and weight precision.
  pub model as "model,omitempty": RecommendVMSKUSizingModel? = None
  /// The resolved per-replica workload inputs used for memory sizing.
  pub workload as "workload,omitempty": RecommendVMSKUSizingWorkload? = None
} derive Json

/// The recommended Azure virtual machine sizes for the workload, with the sizing calculation they were derived from.
pub struct RecommendVMSKUResponse {
  /// The recommended virtual machine size options, ordered from the best to the worst match.
  pub options as "options,omitempty": List[RecommendVMSKUOption]? = None
  /// The resolved workload sizing shared by every option.
  pub sizing as "sizing,omitempty": RecommendVMSKUSizing? = None
} derive Json
