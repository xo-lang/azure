fn show_task_hubs_client_list_by_scheduler_response(r: TaskHubsClientListBySchedulerResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.task_hub_list_result).to_str_lossy()}")
  parts.join(" ")
}

