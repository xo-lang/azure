fn show_service_client_check_name_availability_response(r: ServiceClientCheckNameAvailabilityResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.service_name_availability_result).to_str_lossy()}")
  parts.join(" ")
}

