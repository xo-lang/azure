test "Go's AuthorizationProviderClient.NewListByServicePager" {
  let f = gv_new_fake(os.net)
  let c = new_authorization_provider_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"displayName\":\"s-displayname\",\"identityProvider\":\"s-identityprovider\",\"oauth2\":{\"grantTypes\":{\"authorizationCode\":{\"k1\":\"s-authorizationcode\"},\"clientCredentials\":{\"k1\":\"s-clientcredentials\"}},\"redirectUrl\":\"s-redirecturl\"}},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AuthorizationProviderClient.NewListByServicePager")
  var pg = c.new_list_by_service_pager("id1/ x", "id2/ x", AuthorizationProviderClientListByServiceOptions{filter: Some("s-filter"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_authorization_provider_client_list_by_service_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_100)
}

