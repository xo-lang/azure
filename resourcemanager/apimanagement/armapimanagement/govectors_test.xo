test "Go's APIOperationClient.NewListByAPIPager" {
  let f = gv_new_fake(os.net)
  let c = new_api_operation_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"count\":7,\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"method\":\"s-method\",\"policies\":\"s-policies\",\"request\":{\"description\":\"s-description\",\"headers\":[{\"defaultValue\":\"s-defaultvalue\",\"description\":\"s-description\",\"name\":\"s-name\",\"required\":true,\"schemaId\":\"s-schemaid\",\"type\":\"s-type\",\"typeName\":\"s-typename\"}],\"queryParameters\":[{\"defaultValue\":\"s-defaultvalue\",\"description\":\"s-description\",\"name\":\"s-name\",\"required\":true,\"schemaId\":\"s-schemaid\",\"type\":\"s-type\",\"typeName\":\"s-typename\"}],\"representations\":[{\"contentType\":\"s-contenttype\",\"schemaId\":\"s-schemaid\",\"typeName\":\"s-typename\"}]},\"responses\":[{\"description\":\"s-description\",\"statusCode\":7}],\"templateParameters\":[{\"defaultValue\":\"s-defaultvalue\",\"description\":\"s-description\",\"name\":\"s-name\",\"required\":true,\"schemaId\":\"s-schemaid\",\"type\":\"s-type\",\"typeName\":\"s-typename\",\"values\":[\"s-values\"]}],\"urlTemplate\":\"s-urltemplate\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL APIOperationClient.NewListByAPIPager")
  var pg = c.new_list_by_api_pager("id1/ x", "id2/ x", "id3/ x", APIOperationClientListByAPIOptions{filter: Some("s-filter"), skip: Some(7), tags: Some("s-tags"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_api_operation_client_list_by_api_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_44)
}

