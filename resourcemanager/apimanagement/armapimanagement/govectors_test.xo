  let f = gv_new_fake(os.net)
  let c = new_api_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL APIClient.BeginDelete")
  match c.begin_delete("id1/ x", "id2/ x", "id3/ x", "id4/ x", APIClientBeginDeleteOptions{delete_revisions: Some(true)}) {
    Ok(p0) => {
      var p = p0
      match p.poll_until_done(os.clock, frequency: 1s) {
        Ok(r) => gv_note(f, "OUT: ${show_api_client_delete_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_1)
}

