  let c = new_backend_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"count\":7,\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"circuitBreaker\":{\"rules\":[{\"acceptRetryAfter\":true,\"name\":\"s-name\",\"tripDuration\":\"s-tripduration\"}]},\"credentials\":{\"authorization\":{\"parameter\":\"s-parameter\",\"scheme\":\"s-scheme\"},\"certificate\":[\"s-certificate\"],\"certificateIds\":[\"s-certificateids\"],\"header\":{\"k1\":[\"s-header\"]},\"query\":{\"k1\":[\"s-query\"]}},\"description\":\"s-description\",\"pool\":{\"services\":[{\"id\":\"s-id\",\"priority\":7,\"weight\":7}]},\"properties\":{\"serviceFabricCluster\":{\"clientCertificateId\":\"s-clientcertificateid\",\"clientCertificatethumbprint\":\"s-clientcertificatethumbprint\",\"managementEndpoints\":[\"s-managementendpoints\"],\"maxPartitionResolutionRetries\":7,\"serverCertificateThumbprints\":[\"s-servercertificatethumbprints\"]}},\"protocol\":\"s-protocol\",\"proxy\":{\"password\":\"s-password\",\"url\":\"s-url\",\"username\":\"s-username\"},\"resourceId\":\"s-resourceid\",\"title\":\"s-title\",\"tls\":{\"validateCertificateChain\":true,\"validateCertificateName\":true},\"type\":\"s-type\",\"url\":\"s-url\"},\"type\":\"s-type\"}]}")
