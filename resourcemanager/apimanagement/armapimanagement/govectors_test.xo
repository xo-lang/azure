test "Go's EmailTemplateClient.NewListByServicePager" {
  let f = gv_new_fake(os.net)
  let c = new_email_template_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"count\":7,\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"body\":\"s-body\",\"description\":\"s-description\",\"isDefault\":true,\"parameters\":[{\"description\":\"s-description\",\"name\":\"s-name\",\"title\":\"s-title\"}],\"subject\":\"s-subject\",\"title\":\"s-title\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EmailTemplateClient.NewListByServicePager")
  var pg = c.new_list_by_service_pager("id1/ x", "id2/ x", EmailTemplateClientListByServiceOptions{filter: Some("s-filter"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_email_template_client_list_by_service_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_161)
}

