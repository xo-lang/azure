  let f = gv_new_fake(os.net)
  let c = new_product_api_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"count\":7,\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"apiRevision\":\"s-apirevision\",\"apiRevisionDescription\":\"s-apirevisiondescription\",\"apiVersion\":\"s-apiversion\",\"apiVersionDescription\":\"s-apiversiondescription\",\"apiVersionSet\":{\"description\":\"s-description\",\"id\":\"s-id\",\"name\":\"s-name\",\"versionHeaderName\":\"s-versionheadername\",\"versionQueryName\":\"s-versionqueryname\",\"versioningScheme\":\"s-versioningscheme\"},\"apiVersionSetId\":\"s-apiversionsetid\",\"authenticationSettings\":{\"oAuth2\":{\"authorizationServerId\":\"s-authorizationserverid\",\"scope\":\"s-scope\"},\"oAuth2AuthenticationSettings\":[{\"authorizationServerId\":\"s-authorizationserverid\",\"scope\":\"s-scope\"}],\"openid\":{\"bearerTokenSendingMethods\":[\"s-bearertokensendingmethods\"],\"openidProviderId\":\"s-openidproviderid\"},\"openidAuthenticationSettings\":[{\"openidProviderId\":\"s-openidproviderid\"}]},\"contact\":{\"email\":\"s-email\",\"name\":\"s-name\",\"url\":\"s-url\"},\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isCurrent\":true,\"isOnline\":true,\"license\":{\"name\":\"s-name\",\"url\":\"s-url\"},\"path\":\"s-path\",\"protocols\":[\"s-protocols\"],\"provisioningState\":\"Succeeded\",\"serviceUrl\":\"s-serviceurl\",\"sourceApiId\":\"s-sourceapiid\",\"subscriptionKeyParameterNames\":{\"header\":\"s-header\",\"query\":\"s-query\"},\"subscriptionRequired\":true,\"termsOfServiceUrl\":\"s-termsofserviceurl\",\"type\":\"s-apitype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ProductAPIClient.NewListByProductPager")
  var pg = c.new_list_by_product_pager("id1/ x", "id2/ x", "id3/ x", ProductAPIClientListByProductOptions{filter: Some("s-filter"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_product_api_client_list_by_product_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_303)
}

