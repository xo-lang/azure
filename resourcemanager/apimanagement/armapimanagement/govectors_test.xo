fn show_service_client_migrate_to_stv2_response(r: ServiceClientMigrateToStv2Response) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.service_resource).to_str_lossy()}")
  parts.join(" ")
}

