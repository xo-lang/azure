test "Go's ServiceClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_service_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"additionalLocations\":[{\"disableGateway\":true,\"gatewayRegionalUrl\":\"s-gatewayregionalurl\",\"location\":\"s-location\",\"natGatewayState\":\"s-natgatewaystate\",\"outboundPublicIPAddresses\":[\"s-outboundpublicipaddresses\"],\"platformVersion\":\"s-platformversion\",\"privateIPAddresses\":[\"s-privateipaddresses\"],\"publicIPAddresses\":[\"s-publicipaddresses\"],\"publicIpAddressId\":\"s-publicipaddressid\",\"sku\":{\"capacity\":7,\"name\":\"s-name\"},\"virtualNetworkConfiguration\":{\"subnetResourceId\":\"s-subnetresourceid\",\"subnetname\":\"s-subnetname\",\"vnetid\":\"s-vnetid\"},\"zones\":[\"s-zones\"]}],\"apiVersionConstraint\":{\"minApiVersion\":\"s-minapiversion\"},\"certificates\":[{\"certificate\":{\"expiry\":\"2026-11-06T10:00:00Z\",\"subject\":\"s-subject\",\"thumbprint\":\"s-thumbprint\"},\"certificatePassword\":\"s-certificatepassword\",\"encodedCertificate\":\"s-encodedcertificate\",\"storeName\":\"s-storename\"}],\"configurationApi\":{\"legacyApi\":\"s-legacyapi\"},\"createdAtUtc\":\"2026-11-06T10:00:00Z\",\"customProperties\":{\"k1\":\"s-customproperties\"},\"developerPortalStatus\":\"s-developerportalstatus\",\"developerPortalUrl\":\"s-developerportalurl\",\"disableGateway\":true,\"enableClientCertificate\":true,\"gatewayRegionalUrl\":\"s-gatewayregionalurl\",\"gatewayUrl\":\"s-gatewayurl\",\"hostnameConfigurations\":[{\"certificate\":{\"expiry\":\"2026-11-06T10:00:00Z\",\"subject\":\"s-subject\",\"thumbprint\":\"s-thumbprint\"},\"certificatePassword\":\"s-certificatepassword\",\"certificateSource\":\"s-certificatesource\",\"certificateStatus\":\"s-certificatestatus\",\"defaultSslBinding\":true,\"encodedCertificate\":\"s-encodedcertificate\",\"hostName\":\"s-hostname\",\"identityClientId\":\"s-identityclientid\",\"keyVaultId\":\"s-keyvaultid\",\"negotiateClientCertificate\":true,\"type\":\"s-type\"}],\"legacyPortalStatus\":\"s-legacyportalstatus\",\"managementApiUrl\":\"s-managementapiurl\",\"natGatewayState\":\"s-natgatewaystate\",\"notificationSenderEmail\":\"s-notificationsenderemail\",\"outboundPublicIPAddresses\":[\"s-outboundpublicipaddresses\"],\"platformVersion\":\"s-platformversion\",\"portalUrl\":\"s-portalurl\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"privateIPAddresses\":[\"s-privateipaddresses\"],\"provisioningState\":\"Succeeded\",\"publicIPAddresses\":[\"s-publicipaddresses\"],\"publicIpAddressId\":\"s-publicipaddressid\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"publisherEmail\":\"s-publisheremail\",\"publisherName\":\"s-publishername\",\"restore\":true,\"scmUrl\":\"s-scmurl\",\"targetProvisioningState\":\"s-targetprovisioningstate\",\"virtualNetworkConfiguration\":{\"subnetResourceId\":\"s-subnetresourceid\",\"subnetname\":\"s-subnetname\",\"vnetid\":\"s-vnetid\"},\"virtualNetworkType\":\"s-virtualnetworktype\"},\"sku\":{\"capacity\":7,\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
  gv_note(f, "CALL ServiceClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ServiceClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_service_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_360)
}

fn show_service_client_list_response(r: ServiceClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.service_list_result).to_str_lossy()}")
  parts.join(" ")
}

