test "Go's WorkspaceAPIDiagnosticClient.NewListByWorkspacePager" {
  let f = gv_new_fake(os.net)
  let c = new_workspace_api_diagnostic_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"count\":7,\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"alwaysLog\":\"s-alwayslog\",\"backend\":{\"request\":{\"body\":{\"bytes\":7},\"dataMasking\":{},\"headers\":[\"s-headers\"]},\"response\":{\"body\":{\"bytes\":7},\"dataMasking\":{},\"headers\":[\"s-headers\"]}},\"frontend\":{\"request\":{\"body\":{\"bytes\":7},\"dataMasking\":{},\"headers\":[\"s-headers\"]},\"response\":{\"body\":{\"bytes\":7},\"dataMasking\":{},\"headers\":[\"s-headers\"]}},\"httpCorrelationProtocol\":\"s-httpcorrelationprotocol\",\"logClientIp\":true,\"loggerId\":\"s-loggerid\",\"metrics\":true,\"operationNameFormat\":\"s-operationnameformat\",\"sampling\":{\"percentage\":1.5,\"samplingType\":\"s-samplingtype\"},\"verbosity\":\"s-verbosity\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkspaceAPIDiagnosticClient.NewListByWorkspacePager")
  var pg = c.new_list_by_workspace_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", WorkspaceAPIDiagnosticClientListByWorkspaceOptions{filter: Some("s-filter"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workspace_api_diagnostic_client_list_by_workspace_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_453)
}

