test "Go's AuthorizationServerClient.NewListByServicePager" {
  let f = gv_new_fake(os.net)
  let c = new_authorization_server_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"count\":7,\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"authorizationEndpoint\":\"s-authorizationendpoint\",\"authorizationMethods\":[\"s-authorizationmethods\"],\"bearerTokenSendingMethods\":[\"s-bearertokensendingmethods\"],\"clientAuthenticationMethod\":[\"s-clientauthenticationmethod\"],\"clientId\":\"s-clientid\",\"clientRegistrationEndpoint\":\"s-clientregistrationendpoint\",\"clientSecret\":\"s-clientsecret\",\"defaultScope\":\"s-defaultscope\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"grantTypes\":[\"s-granttypes\"],\"resourceOwnerPassword\":\"s-resourceownerpassword\",\"resourceOwnerUsername\":\"s-resourceownerusername\",\"supportState\":true,\"tokenBodyParameters\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"tokenEndpoint\":\"s-tokenendpoint\",\"useInApiDocumentation\":true,\"useInTestConsole\":true},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AuthorizationServerClient.NewListByServicePager")
  var pg = c.new_list_by_service_pager("id1/ x", "id2/ x", AuthorizationServerClientListByServiceOptions{filter: Some("s-filter"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_authorization_server_client_list_by_service_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_106)
}

