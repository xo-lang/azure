  "OUT page 2: body={\"count\":7,\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"productId\":\"s-productid\"},\"type\":\"s-type\"}]}",
]

test "Go's WorkspaceTagProductLinkClient.NewListByProductPager" {
  let f = gv_new_fake(os.net)
  let c = new_workspace_tag_product_link_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"count\":7,\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"productId\":\"s-productid\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkspaceTagProductLinkClient.NewListByProductPager")
  var pg = c.new_list_by_product_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", WorkspaceTagProductLinkClientListByProductOptions{filter: Some("s-filter"), skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workspace_tag_product_link_client_list_by_product_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_612)
}
