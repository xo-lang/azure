  gv_set(f, 200, "{\"count\":7,\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"apiId\":\"s-apiid\"},\"type\":\"s-type\"}]}")
