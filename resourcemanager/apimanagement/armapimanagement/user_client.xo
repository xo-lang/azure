    return Err(azcore.CallErr.InvalidInput("parameter userID cannot be empty"))
  }
  path = path.replace("{userId}", url.path_escape(user_id))
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter client.subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: runtime.marshal_json(parameters)})
}

/// Gets the Shared Access Authorization Token for the User.
pub fn (c: UserClient) get_shared_access_token(resource_group_name: Str, service_name: Str, user_id: Str, parameters: UserTokenParameters, options: UserClientGetSharedAccessTokenOptions = UserClientGetSharedAccessTokenOptions{}) -> UserClientGetSharedAccessTokenResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let sp = runtime.start_span({}, "UserClient.GetSharedAccessToken", c.setup.pipeline.tracer)
  let req = sp.on(c.get_shared_access_token_create_request(resource_group_name, service_name, user_id, parameters, options) ?? e => return Err(sp.fail(e)))
  let resp = c.setup.pipeline.send(req) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![200].contains(resp.status) {
    return Err(sp.fail(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  let out = user_get_shared_access_token_handle(resp) ?? e => return Err(sp.fail(azcore.CallErr.Decode(e)))
  sp.end()
  Ok(out)
}
