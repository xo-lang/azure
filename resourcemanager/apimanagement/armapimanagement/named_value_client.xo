  let req = c.refresh_secret_create_request(resource_group_name, service_name, named_value_id, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "location", "NamedValueClientRefreshSecretResponse", fn(r: http.Response) -> NamedValueClientRefreshSecretResponse ! Str { named_value_refresh_secret_handle(r) })
}
