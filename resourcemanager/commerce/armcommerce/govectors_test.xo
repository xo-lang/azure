// Generated from the output of a local Go program that calls every
// public method of each client of armcommerce v0.4.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/runtime

fn show_rate_card_client_get_response(r: RateCardClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.resource_rate_card_info).to_str_lossy()}")
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL RateCardClient.Get",
  "REQ GET https://management.example.test/subscriptions/sub-test/providers/Microsoft.Commerce/rateCard?%24filter=id1%2F+x&api-version=2015-06-01-preview",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"Currency\":\"s-currency\",\"IsTaxIncluded\":true,\"Locale\":\"s-locale\",\"Meters\":[{\"EffectiveDate\":\"2026-11-06T10:00:00Z\",\"IncludedQuantity\":1.5,\"MeterCategory\":\"s-metercategory\",\"MeterId\":\"s-meterid\",\"MeterName\":\"s-metername\",\"MeterRates\":{\"k1\":1.5},\"MeterRegion\":\"s-meterregion\",\"MeterSubCategory\":\"s-metersubcategory\",\"MeterTags\":[\"s-metertags\"],\"Unit\":\"s-unit\"}],\"OfferTerms\":[{\"EffectiveDate\":\"2026-11-06T10:00:00Z\",\"ExcludedMeterIds\":[\"s-excludedmeterids\"],\"Name\":\"Monetary Commitment\",\"TieredDiscount\":{\"k1\":1.5}}]}",
  "OUT: body={\"Currency\":\"s-currency\",\"IsTaxIncluded\":true,\"Locale\":\"s-locale\",\"Meters\":[{\"EffectiveDate\":\"2026-11-06T10:00:00Z\",\"IncludedQuantity\":1.5,\"MeterCategory\":\"s-metercategory\",\"MeterId\":\"s-meterid\",\"MeterName\":\"s-metername\",\"MeterRates\":{\"k1\":1.5},\"MeterRegion\":\"s-meterregion\",\"MeterSubCategory\":\"s-metersubcategory\",\"MeterTags\":[\"s-metertags\"],\"Unit\":\"s-unit\"}],\"OfferTerms\":[{\"EffectiveDate\":\"2026-11-06T10:00:00Z\",\"ExcludedMeterIds\":[\"s-excludedmeterids\"],\"Name\":\"Monetary Commitment\",\"TieredDiscount\":{\"k1\":1.5}}]}",
]

test "Go's RateCardClient.Get" {
  let f = gv_new_fake(os.net)
  let c = new_rate_card_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"Currency\":\"s-currency\",\"IsTaxIncluded\":true,\"Locale\":\"s-locale\",\"Meters\":[{\"EffectiveDate\":\"2026-11-06T10:00:00Z\",\"IncludedQuantity\":1.5,\"MeterCategory\":\"s-metercategory\",\"MeterId\":\"s-meterid\",\"MeterName\":\"s-metername\",\"MeterRates\":{\"k1\":1.5},\"MeterRegion\":\"s-meterregion\",\"MeterSubCategory\":\"s-metersubcategory\",\"MeterTags\":[\"s-metertags\"],\"Unit\":\"s-unit\"}],\"OfferTerms\":[{\"EffectiveDate\":\"2026-11-06T10:00:00Z\",\"ExcludedMeterIds\":[\"s-excludedmeterids\"],\"Name\":\"Monetary Commitment\",\"TieredDiscount\":{\"k1\":1.5}}]}")
  gv_note(f, "CALL RateCardClient.Get")
  match c.get("id1/ x", RateCardClientGetOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_rate_card_client_get_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

fn show_usage_aggregates_client_list_response(r: UsageAggregatesClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.usage_aggregation_list_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_1: List[Str] = [
  "CALL UsageAggregatesClient.NewListPager",
  "REQ GET https://management.example.test/subscriptions/sub-test/providers/Microsoft.Commerce/usageAggregates?aggregationGranularity=s-aggregationgranularity&api-version=2015-06-01-preview&continuationToken=s-continuationtoken&reportedEndTime=2026-11-06T10%3A00%3A00Z&reportedStartTime=2026-11-06T10%3A00%3A00Z&showDetails=true",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"infoFields\":{\"k\":\"v\"},\"instanceData\":\"s-instancedata\",\"meterCategory\":\"s-metercategory\",\"meterId\":\"s-meterid\",\"meterName\":\"s-metername\",\"meterRegion\":\"s-meterregion\",\"meterSubCategory\":\"s-metersubcategory\",\"quantity\":1.5,\"subscriptionId\":\"s-subscriptionid\",\"unit\":\"s-unit\",\"usageEndTime\":\"2026-11-06T10:00:00Z\",\"usageStartTime\":\"2026-11-06T10:00:00Z\"},\"type\":\"s-type\"}]}",
  "OUT page 1: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"infoFields\":{\"k\":\"v\"},\"instanceData\":\"s-instancedata\",\"meterCategory\":\"s-metercategory\",\"meterId\":\"s-meterid\",\"meterName\":\"s-metername\",\"meterRegion\":\"s-meterregion\",\"meterSubCategory\":\"s-metersubcategory\",\"quantity\":1.5,\"subscriptionId\":\"s-subscriptionid\",\"unit\":\"s-unit\",\"usageEndTime\":\"2026-11-06T10:00:00Z\",\"usageStartTime\":\"2026-11-06T10:00:00Z\"},\"type\":\"s-type\"}]}",
  "REQ GET https://management.example.test/next?%24skiptoken=2",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"infoFields\":{\"k\":\"v\"},\"instanceData\":\"s-instancedata\",\"meterCategory\":\"s-metercategory\",\"meterId\":\"s-meterid\",\"meterName\":\"s-metername\",\"meterRegion\":\"s-meterregion\",\"meterSubCategory\":\"s-metersubcategory\",\"quantity\":1.5,\"subscriptionId\":\"s-subscriptionid\",\"unit\":\"s-unit\",\"usageEndTime\":\"2026-11-06T10:00:00Z\",\"usageStartTime\":\"2026-11-06T10:00:00Z\"},\"type\":\"s-type\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"infoFields\":{\"k\":\"v\"},\"instanceData\":\"s-instancedata\",\"meterCategory\":\"s-metercategory\",\"meterId\":\"s-meterid\",\"meterName\":\"s-metername\",\"meterRegion\":\"s-meterregion\",\"meterSubCategory\":\"s-metersubcategory\",\"quantity\":1.5,\"subscriptionId\":\"s-subscriptionid\",\"unit\":\"s-unit\",\"usageEndTime\":\"2026-11-06T10:00:00Z\",\"usageStartTime\":\"2026-11-06T10:00:00Z\"},\"type\":\"s-type\"}]}",
]

test "Go's UsageAggregatesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_usage_aggregates_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"infoFields\":{\"k\":\"v\"},\"instanceData\":\"s-instancedata\",\"meterCategory\":\"s-metercategory\",\"meterId\":\"s-meterid\",\"meterName\":\"s-metername\",\"meterRegion\":\"s-meterregion\",\"meterSubCategory\":\"s-metersubcategory\",\"quantity\":1.5,\"subscriptionId\":\"s-subscriptionid\",\"unit\":\"s-unit\",\"usageEndTime\":\"2026-11-06T10:00:00Z\",\"usageStartTime\":\"2026-11-06T10:00:00Z\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL UsageAggregatesClient.NewListPager")
  var pg = c.new_list_pager((azcore.parse_date_time("2026-11-06T10:00:00Z") ?? e => fault(e)), (azcore.parse_date_time("2026-11-06T10:00:00Z") ?? e => fault(e)), UsageAggregatesClientListOptions{aggregation_granularity: Some(AggregationGranularity("s-aggregationgranularity")), continuation_token: Some("s-continuationtoken"), show_details: Some(true)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_usage_aggregates_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_1)
}
