fn data_account_details_classification_json(c: DataAccountDetailsClassification) -> json.Value {
  match c {
    DataAccountDetailsClassification.ManagedDiskDetails(x) => json.to_value(x)
    DataAccountDetailsClassification.StorageAccountDetails(x) => json.to_value(x)
    DataAccountDetailsClassification.DataAccountDetails(x) => json.to_value(x)
  }
}

fn parse_data_account_details_classification(v: json.Value) -> DataAccountDetailsClassification ! json.DecodeErr {
  match v.get("dataAccountType") {
    Some(json.Value.Str("ManagedDisk")) => Ok(DataAccountDetailsClassification.ManagedDiskDetails(json.from_value[ManagedDiskDetails](v)?))
    Some(json.Value.Str("StorageAccount")) => Ok(DataAccountDetailsClassification.StorageAccountDetails(json.from_value[StorageAccountDetails](v)?))
    _ => Ok(DataAccountDetailsClassification.DataAccountDetails(json.from_value[DataAccountDetails](v)?))
  }
}

