/// The Status of the copy
pub type CopyStatus struct(Str)
/// Data copy completed.
pub const COPY_STATUS_COMPLETED: CopyStatus = CopyStatus("Completed")
/// Data copy completed with errors.
pub const COPY_STATUS_COMPLETED_WITH_ERRORS: CopyStatus = CopyStatus("CompletedWithErrors")
/// Data copy failed. The Device was formatted by user.
pub const COPY_STATUS_DEVICE_FORMATTED: CopyStatus = CopyStatus("DeviceFormatted")
/// Data copy failed. Device metadata was modified by user.
pub const COPY_STATUS_DEVICE_METADATA_MODIFIED: CopyStatus = CopyStatus("DeviceMetadataModified")
/// Copy failed due to corrupted drive.
pub const COPY_STATUS_DRIVE_CORRUPTED: CopyStatus = CopyStatus("DriveCorrupted")
/// Copy failed due to disk detection error.
pub const COPY_STATUS_DRIVE_NOT_DETECTED: CopyStatus = CopyStatus("DriveNotDetected")
/// No copy triggered as device was not received.
pub const COPY_STATUS_DRIVE_NOT_RECEIVED: CopyStatus = CopyStatus("DriveNotReceived")
/// Data copy failed. No data was copied.
pub const COPY_STATUS_FAILED: CopyStatus = CopyStatus("Failed")
/// The Device has hit hardware issues.
pub const COPY_STATUS_HARDWARE_ERROR: CopyStatus = CopyStatus("HardwareError")
/// Data copy is in progress.
pub const COPY_STATUS_IN_PROGRESS: CopyStatus = CopyStatus("InProgress")
/// Copy failed due to modified or removed metadata files.
pub const COPY_STATUS_METADATA_FILES_MODIFIED_OR_REMOVED: CopyStatus = CopyStatus("MetadataFilesModifiedOrRemoved")
/// No copy triggered as device was not returned.
pub const COPY_STATUS_NOT_RETURNED: CopyStatus = CopyStatus("NotReturned")
/// Data copy hasn't started yet.
pub const COPY_STATUS_NOT_STARTED: CopyStatus = CopyStatus("NotStarted")
/// Copy failed due to service error.
pub const COPY_STATUS_OTHER_SERVICE_ERROR: CopyStatus = CopyStatus("OtherServiceError")
/// Copy failed due to user error.
pub const COPY_STATUS_OTHER_USER_ERROR: CopyStatus = CopyStatus("OtherUserError")
/// Data copy failed. Storage Account was not accessible during copy.
pub const COPY_STATUS_STORAGE_ACCOUNT_NOT_ACCESSIBLE: CopyStatus = CopyStatus("StorageAccountNotAccessible")
/// Data copy failed. The Device data content is not supported.
pub const COPY_STATUS_UNSUPPORTED_DATA: CopyStatus = CopyStatus("UnsupportedData")
/// No copy triggered as device type is not supported.
pub const COPY_STATUS_UNSUPPORTED_DRIVE: CopyStatus = CopyStatus("UnsupportedDrive")

