  path = path.replace("{jobName}", url.path_escape(job_name))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  var q = url.values()
  var headers: List[(Str, Str)] = []
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: runtime.marshal_json(mark_devices_shipped_request)})
}

/// Request to mark devices for a given job as shipped
pub fn (c: JobsClient) mark_devices_shipped(job_name: Str, resource_group_name: Str, mark_devices_shipped_request: MarkDevicesShippedRequest, options: JobsClientMarkDevicesShippedOptions = JobsClientMarkDevicesShippedOptions{}) -> JobsClientMarkDevicesShippedResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.mark_devices_shipped_create_request(job_name, resource_group_name, mark_devices_shipped_request, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![204].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  jobs_mark_devices_shipped_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
