test "Go's JobsClient.NewListCredentialsPager" {
  let f = gv_new_fake(os.net)
  let c = new_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"jobName\":\"s-jobname\",\"jobSecrets\":{\"carrierAccountNumber\":\"s-carrieraccountnumber\",\"dcAccessSecurityCode\":{\"forwardDCAccessCode\":\"s-forwarddcaccesscode\",\"reverseDCAccessCode\":\"s-reversedcaccesscode\"},\"diskSecrets\":[{\"bitLockerKey\":\"s-bitlockerkey\",\"diskSerialNumber\":\"s-diskserialnumber\"}],\"error\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"},\"jobSecretsType\":\"DataBoxCustomerDisk\"}}]}")
  gv_note(f, "CALL JobsClient.NewListCredentialsPager")
  var pg = c.new_list_credentials_pager("id1/ x", "id2/ x", JobsClientListCredentialsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_jobs_client_list_credentials_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_8)
}

