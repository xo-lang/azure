fn show_jobs_client_mark_devices_shipped_response(r: JobsClientMarkDevicesShippedResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_6: List[Str] = [
  "CALL JobsClient.MarkDevicesShipped",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id2%2F%20x/providers/Microsoft.DataBox/jobs/id1%2F%20x/markDevicesShipped?api-version=2025-07-01",
