]

test "Go's JobsClient.MarkDevicesShipped" {
  let f = gv_new_fake(os.net)
  let c = new_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 204, "")
  gv_note(f, "CALL JobsClient.MarkDevicesShipped")
  match c.mark_devices_shipped("id1/ x", "id2/ x", (json.decode_str[MarkDevicesShippedRequest]("{\"deliverToDcPackageDetails\":{\"carrierName\":\"s-carriername\",\"trackingId\":\"s-trackingid\"}}") ?? e => fault("${e}")), JobsClientMarkDevicesShippedOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_jobs_client_mark_devices_shipped_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_6)
}

fn show_jobs_client_list_by_resource_group_response(r: JobsClientListByResourceGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.job_resource_list).to_str_lossy()}")
  parts.join(" ")
}

