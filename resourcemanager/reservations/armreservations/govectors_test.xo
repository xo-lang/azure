test "Go's AzureReservationAPIClient.NewGetCatalogPager" {
  let f = gv_new_fake(os.net)
  let c = new_azure_reservation_api_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"totalItems\":7,\"value\":[{\"billingPlans\":{\"k1\":[\"s-billingplans\"]},\"capabilities\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"locations\":[\"s-locations\"],\"msrp\":{\"p1Y\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"p3Y\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"p5Y\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"}},\"name\":\"s-name\",\"resourceType\":\"s-resourcetype\",\"restrictions\":[{\"reasonCode\":\"s-reasoncode\",\"type\":\"s-type\",\"values\":[\"s-values\"]}],\"size\":\"s-size\",\"skuProperties\":[{\"name\":\"s-name\",\"value\":\"s-value\"}],\"terms\":[\"s-terms\"],\"tier\":\"s-tier\"}]}")
  gv_note(f, "CALL AzureReservationAPIClient.NewGetCatalogPager")
  var pg = c.new_get_catalog_pager("id1/ x", AzureReservationAPIClientGetCatalogOptions{filter: Some("s-filter"), location: Some("s-location"), offer_id: Some("s-offerid"), plan_id: Some("s-planid"), publisher_id: Some("s-publisherid"), reserved_resource_type: Some("s-reservedresourcetype"), skip: Some(Float32(1.5)), take: Some(Float32(1.5))}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_azure_reservation_api_client_get_catalog_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_1)
}

