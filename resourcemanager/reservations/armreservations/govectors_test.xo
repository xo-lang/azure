test "Go's ReturnClient.BeginPost" {
  let f = gv_new_fake(os.net)
  let c = new_return_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"etag\":7,\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"benefitStartTime\":\"2026-11-06T10:00:00Z\",\"billingPlan\":\"s-billingplan\",\"createdDateTime\":\"2026-11-06T10:00:00Z\",\"displayName\":\"s-displayname\",\"expiryDate\":\"2026-11-06\",\"expiryDateTime\":\"2026-11-06T10:00:00Z\",\"originalQuantity\":7,\"planInformation\":{\"nextPaymentDueDate\":\"2026-11-06\",\"pricingCurrencyTotal\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"startDate\":\"2026-11-06\",\"transactions\":[{\"billingAccount\":\"s-billingaccount\",\"billingCurrencyTotal\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"dueDate\":\"2026-11-06\",\"extendedStatusInfo\":{\"message\":\"s-message\",\"statusCode\":\"s-statuscode\"},\"paymentDate\":\"2026-11-06\",\"pricingCurrencyTotal\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"status\":\"s-status\"}]},\"provisioningState\":\"Succeeded\",\"requestDateTime\":\"2026-11-06T10:00:00Z\",\"reservations\":[{\"etag\":7,\"id\":\"s-id\",\"kind\":\"Microsoft.Compute\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"appliedScopeProperties\":{\"displayName\":\"s-displayname\",\"managementGroupId\":\"s-managementgroupid\",\"resourceGroupId\":\"s-resourcegroupid\",\"subscriptionId\":\"s-subscriptionid\",\"tenantId\":\"s-tenantid\"},\"appliedScopeType\":\"s-appliedscopetype\",\"appliedScopes\":[\"s-appliedscopes\"],\"archived\":true,\"benefitStartTime\":\"2026-11-06T10:00:00Z\",\"billingPlan\":\"s-billingplan\",\"billingScopeId\":\"s-billingscopeid\",\"capabilities\":\"s-capabilities\",\"displayName\":\"s-displayname\",\"displayProvisioningState\":\"s-displayprovisioningstate\",\"effectiveDateTime\":\"2026-11-06T10:00:00Z\",\"expiryDate\":\"2026-11-06\",\"expiryDateTime\":\"2026-11-06T10:00:00Z\",\"extendedStatusInfo\":{\"message\":\"s-message\",\"statusCode\":\"s-statuscode\"},\"instanceFlexibility\":\"s-instanceflexibility\",\"lastUpdatedDateTime\":\"2026-11-06T10:00:00Z\",\"mergeProperties\":{\"mergeDestination\":\"s-mergedestination\",\"mergeSources\":[\"s-mergesources\"]},\"provisioningState\":\"Succeeded\",\"provisioningSubState\":\"s-provisioningsubstate\",\"purchaseDate\":\"2026-11-06\",\"purchaseDateTime\":\"2026-11-06T10:00:00Z\",\"quantity\":7,\"renew\":true,\"renewDestination\":\"s-renewdestination\",\"renewProperties\":{\"billingCurrencyTotal\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"pricingCurrencyTotal\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"purchaseProperties\":{\"location\":\"s-location\"}},\"renewSource\":\"s-renewsource\",\"reservedResourceType\":\"s-reservedresourcetype\",\"reviewDateTime\":\"2026-11-06T10:00:00Z\",\"skuDescription\":\"s-skudescription\",\"splitProperties\":{\"splitDestinations\":[\"s-splitdestinations\"],\"splitSource\":\"s-splitsource\"},\"swapProperties\":{\"swapDestination\":\"s-swapdestination\",\"swapSource\":\"s-swapsource\"},\"term\":\"s-term\",\"userFriendlyAppliedScopeType\":\"s-userfriendlyappliedscopetype\",\"userFriendlyRenewState\":\"s-userfriendlyrenewstate\",\"utilization\":{\"trend\":\"s-trend\"}},\"sku\":{\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"reviewDateTime\":\"2026-11-06T10:00:00Z\",\"term\":\"s-term\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ReturnClient.BeginPost")
  match c.begin_post("id1/ x", (json.decode_str[RefundRequest]("{\"properties\":{\"reservationToReturn\":{\"quantity\":7,\"reservationId\":\"s-reservationid\"},\"returnReason\":\"s-returnreason\",\"scope\":\"s-scope\",\"sessionId\":\"s-sessionid\"}}") ?? e => fault("${e}")), ReturnClientBeginPostOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_return_client_post_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_27)
}
