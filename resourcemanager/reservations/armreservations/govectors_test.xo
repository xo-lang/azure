-displayname\",\"quantity\":7,\"renew\":true,\"reservedResourceProperties\":{\"instanceFlexibility\":\"s-instanceflexibility\"},\"reservedResourceType\":\"s-reservedresourcetype\",\"reviewDateTime\":\"2026-11-06T10:00:00Z\",\"term\":\"s-term\"},\"sku\":{\"name\":\"s-name\"}}},\"renewSource\":\"s-renewsource\",\"reservedResourceType\":\"s-reservedresourcetype\",\"reviewDateTime\":\"2026-11-06T10:00:00Z\",\"skuDescription\":\"s-skudescription\",\"splitProperties\":{\"splitDestinations\":[\"s-splitdestinations\"],\"splitSource\":\"s-splitsource\"},\"swapProperties\":{\"swapDestination\":\"s-swapdestination\",\"swapSource\":\"s-swapsource\"},\"term\":\"s-term\",\"userFriendlyAppliedScopeType\":\"s-userfriendlyappliedscopetype\",\"userFriendlyRenewState\":\"s-userfriendlyrenewstate\",\"utilization\":{\"aggregates\":[{\"grain\":1.5,\"grainUnit\":\"s-grainunit\",\"value\":1.5,\"valueUnit\":\"s-valueunit\"}],\"trend\":\"s-trend\"}},\"sku\":{\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL ReservationClient.BeginUpdate")
  match c.begin_update("id1/ x", "id2/ x", (json.decode_str[Patch]("{\"properties\":{\"appliedScopeProperties\":{\"displayName\":\"s-displayname\",\"managementGroupId\":\"s-managementgroupid\",\"resourceGroupId\":\"s-resourcegroupid\",\"subscriptionId\":\"s-subscriptionid\",\"tenantId\":\"s-tenantid\"},\"appliedScopeType\":\"s-appliedscopetype\",\"appliedScopes\":[\"s-appliedscopes\"],\"instanceFlexibility\":\"s-instanceflexibility\",\"name\":\"s-name\",\"renew\":true,\"renewProperties\":{\"purchaseProperties\":{\"location\":\"s-location\",\"properties\":{\"appliedScopeProperties\":{\"displayName\":\"s-displayname\",\"managementGroupId\":\"s-managementgroupid\",\"resourceGroupId\":\"s-resourcegroupid\",\"subscriptionId\":\"s-subscriptionid\",\"tenantId\":\"s-tenantid\"},\"appliedScopeType\":\"s-appliedscopetype\",\"appliedScopes\":[\"s-appliedscopes\"],\"billingPlan\":\"s-billingplan\",\"billingScopeId\":\"s-billingscopeid\",\"displayName\":\"s-displayname\",\"quantity\":7,\"renew\":true,\"reservedResourceProperties\":{\"instanceFlexibility\":\"s-instanceflexibility\"},\"reservedResourceType\":\"s-reservedresourcetype\",\"reviewDateTime\":\"2026-11-06T10:00:00Z\",\"term\":\"s-term\"},\"sku\":{\"name\":\"s-name\"}}},\"reviewDateTime\":\"2026-11-06T10:00:00Z\"}}") ?? e => fault("${e}")), ReservationClientBeginUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_reservation_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_16)
}

fn show_reservation_client_get_response(r: ReservationClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.reservation_response).to_str_lossy()}")
  parts.join(" ")
}

