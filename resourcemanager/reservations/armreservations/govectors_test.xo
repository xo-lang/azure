fn show_reservation_client_split_response(r: ReservationClientSplitResponse) -> Str {
  var parts: List[Str] = []
  if !(r.value.is_empty()) {
    parts.push("ReservationResponseArray=${runtime.marshal_json(r.value).to_str_lossy()}")
  }
  parts.join(" ")
}

