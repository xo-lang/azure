  gv_set(f, 200, "{\"properties\":{\"scopes\":[{\"scope\":\"s-scope\",\"valid\":true}]}}")
  gv_note(f, "CALL ReservationClient.BeginAvailableScopes")
  match c.begin_available_scopes("id1/ x", "id2/ x", (json.decode_str[AvailableScopeRequest]("{\"properties\":{\"scopes\":[\"s-scopes\"]}}") ?? e => fault("${e}")), ReservationClientBeginAvailableScopesOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_reservation_client_available_scopes_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_13)
}

