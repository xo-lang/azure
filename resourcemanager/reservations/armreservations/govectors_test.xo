test "Go's ReservationClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_reservation_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":7,\"id\":\"s-id\",\"kind\":\"Microsoft.Compute\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"appliedScopeProperties\":{\"displayName\":\"s-displayname\",\"managementGroupId\":\"s-managementgroupid\",\"resourceGroupId\":\"s-resourcegroupid\",\"subscriptionId\":\"s-subscriptionid\",\"tenantId\":\"s-tenantid\"},\"appliedScopeType\":\"s-appliedscopetype\",\"appliedScopes\":[\"s-appliedscopes\"],\"archived\":true,\"benefitStartTime\":\"2026-11-06T10:00:00Z\",\"billingPlan\":\"s-billingplan\",\"billingScopeId\":\"s-billingscopeid\",\"capabilities\":\"s-capabilities\",\"displayName\":\"s-displayname\",\"displayProvisioningState\":\"s-displayprovisioningstate\",\"effectiveDateTime\":\"2026-11-06T10:00:00Z\",\"expiryDate\":\"2026-11-06\",\"expiryDateTime\":\"2026-11-06T10:00:00Z\",\"extendedStatusInfo\":{\"message\":\"s-message\",\"statusCode\":\"s-statuscode\"},\"instanceFlexibility\":\"s-instanceflexibility\",\"lastUpdatedDateTime\":\"2026-11-06T10:00:00Z\",\"mergeProperties\":{\"mergeDestination\":\"s-mergedestination\",\"mergeSources\":[\"s-mergesources\"]},\"provisioningState\":\"Succeeded\",\"provisioningSubState\":\"s-provisioningsubstate\",\"purchaseDate\":\"2026-11-06\",\"purchaseDateTime\":\"2026-11-06T10:00:00Z\",\"quantity\":7,\"renew\":true,\"renewDestination\":\"s-renewdestination\",\"renewProperties\":{\"billingCurrencyTotal\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"pricingCurrencyTotal\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"purchaseProperties\":{\"location\":\"s-location\",\"properties\":{\"appliedScopeType\":\"s-appliedscopetype\",\"billingPlan\":\"s-billingplan\",\"billingScopeId\":\"s-billingscopeid\",\"displayName\":\"s-displayname\",\"quantity\":7,\"renew\":true,\"reservedResourceType\":\"s-reservedresourcetype\",\"reviewDateTime\":\"2026-11-06T10:00:00Z\",\"term\":\"s-term\"},\"sku\":{\"name\":\"s-name\"}}},\"renewSource\":\"s-renewsource\",\"reservedResourceType\":\"s-reservedresourcetype\",\"reviewDateTime\":\"2026-11-06T10:00:00Z\",\"skuDescription\":\"s-skudescription\",\"splitProperties\":{\"splitDestinations\":[\"s-splitdestinations\"],\"splitSource\":\"s-splitsource\"},\"swapProperties\":{\"swapDestination\":\"s-swapdestination\",\"swapSource\":\"s-swapsource\"},\"term\":\"s-term\",\"userFriendlyAppliedScopeType\":\"s-userfriendlyappliedscopetype\",\"userFriendlyRenewState\":\"s-userfriendlyrenewstate\",\"utilization\":{\"aggregates\":[{\"grain\":1.5,\"grainUnit\":\"s-grainunit\",\"value\":1.5,\"valueUnit\":\"s-valueunit\"}],\"trend\":\"s-trend\"}},\"sku\":{\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ReservationClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", ReservationClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_reservation_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_19)
}

fn show_reservation_client_list_revisions_response(r: ReservationClientListRevisionsResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.reservation_list).to_str_lossy()}")
  parts.join(" ")
}

