  match c.get_applied_reservation_list("id1/ x", AzureReservationAPIClientGetAppliedReservationListOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_azure_reservation_api_client_get_applied_reservation_list_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

