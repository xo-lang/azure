  let f = gv_new_fake(os.net)
  let c = new_reservation_order_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":7,\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"benefitStartTime\":\"2026-11-06T10:00:00Z\",\"billingPlan\":\"s-billingplan\",\"createdDateTime\":\"2026-11-06T10:00:00Z\",\"displayName\":\"s-displayname\",\"expiryDate\":\"2026-11-06\",\"expiryDateTime\":\"2026-11-06T10:00:00Z\",\"originalQuantity\":7,\"planInformation\":{\"nextPaymentDueDate\":\"2026-11-06\",\"pricingCurrencyTotal\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"startDate\":\"2026-11-06\",\"transactions\":[{\"billingAccount\":\"s-billingaccount\",\"dueDate\":\"2026-11-06\",\"paymentDate\":\"2026-11-06\",\"status\":\"s-status\"}]},\"provisioningState\":\"Succeeded\",\"requestDateTime\":\"2026-11-06T10:00:00Z\",\"reservations\":[{\"etag\":7,\"id\":\"s-id\",\"kind\":\"Microsoft.Compute\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"appliedScopeType\":\"s-appliedscopetype\",\"archived\":true,\"benefitStartTime\":\"2026-11-06T10:00:00Z\",\"billingPlan\":\"s-billingplan\",\"billingScopeId\":\"s-billingscopeid\",\"capabilities\":\"s-capabilities\",\"displayName\":\"s-displayname\",\"displayProvisioningState\":\"s-displayprovisioningstate\",\"effectiveDateTime\":\"2026-11-06T10:00:00Z\",\"expiryDate\":\"2026-11-06\",\"expiryDateTime\":\"2026-11-06T10:00:00Z\",\"instanceFlexibility\":\"s-instanceflexibility\",\"lastUpdatedDateTime\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"provisioningSubState\":\"s-provisioningsubstate\",\"purchaseDate\":\"2026-11-06\",\"purchaseDateTime\":\"2026-11-06T10:00:00Z\",\"quantity\":7,\"renew\":true,\"renewDestination\":\"s-renewdestination\",\"renewSource\":\"s-renewsource\",\"reservedResourceType\":\"s-reservedresourcetype\",\"reviewDateTime\":\"2026-11-06T10:00:00Z\",\"skuDescription\":\"s-skudescription\",\"term\":\"s-term\",\"userFriendlyAppliedScopeType\":\"s-userfriendlyappliedscopetype\",\"userFriendlyRenewState\":\"s-userfriendlyrenewstate\"},\"sku\":{\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"reviewDateTime\":\"2026-11-06T10:00:00Z\",\"term\":\"s-term\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ReservationOrderClient.NewListPager")
  var pg = c.new_list_pager(ReservationOrderClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_reservation_order_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_26)
}

