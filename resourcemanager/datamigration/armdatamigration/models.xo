  pub limit as "limit,omitempty": Float? = None
  /// The name of the quota
  pub name as "name,omitempty": QuotaName? = None
  /// The unit for the quota, such as Count, Bytes, BytesPerSecond, etc.
  pub unit as "unit,omitempty": Str? = None
} derive Json

