test "Go's ProjectsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_projects_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"azureAuthenticationInfo\":{\"appKey\":\"s-appkey\",\"applicationId\":\"s-applicationid\",\"ignoreAzurePermissions\":true,\"tenantId\":\"s-tenantid\"},\"creationTime\":\"2026-11-06T10:00:00Z\",\"databasesInfo\":[{\"sourceDatabaseName\":\"s-sourcedatabasename\"}],\"provisioningState\":\"Succeeded\",\"sourceConnectionInfo\":{\"managedInstanceResourceId\":\"s-managedinstanceresourceid\",\"password\":\"s-password\",\"type\":\"MiSqlConnectionInfo\",\"userName\":\"s-username\"},\"sourcePlatform\":\"s-sourceplatform\",\"targetConnectionInfo\":{\"managedInstanceResourceId\":\"s-managedinstanceresourceid\",\"password\":\"s-password\",\"type\":\"MiSqlConnectionInfo\",\"userName\":\"s-username\"},\"targetPlatform\":\"s-targetplatform\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ProjectsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ProjectsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
