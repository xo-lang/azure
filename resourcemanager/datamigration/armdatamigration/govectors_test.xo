test "Go's TasksClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_tasks_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"clientData\":{\"k1\":\"s-clientdata\"},\"commands\":[{\"commandType\":\"Migrate.SqlServer.AzureDbSqlMi.Complete\",\"state\":\"s-state\"}],\"errors\":[{\"code\":\"s-code\",\"message\":\"s-message\"}],\"input\":{\"serverVersion\":\"s-serverversion\"},\"output\":[{}],\"state\":\"s-state\",\"taskType\":\"Service.Check.OCI\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL TasksClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", TasksClientListOptions{task_type: Some("s-tasktype")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_tasks_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_78)
}

