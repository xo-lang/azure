  match c.create_or_update("id1/ x", "id2/ x", (json.decode_str[Account]("{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), AccountsClientCreateOrUpdateOptions{}) {
