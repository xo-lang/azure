  pub maintain as "maintain,omitempty": Bool? = None
  /// Price per hour of each Spot VM will never exceed this.
  pub max_price_per_vm as "maxPricePerVM,omitempty": Float32? = None
  /// Minimum capacity to achieve which cannot be updated. If we will not be able to "guarantee" minimum capacity, we will reject the request in the sync path itself.
  pub min_capacity as "minCapacity,omitempty": Int? = None
} derive Json

