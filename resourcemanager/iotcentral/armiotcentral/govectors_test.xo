test "Go's AppsClient.BeginCreateOrUpdate" {
  let f = gv_new_fake(os.net)
  let c = new_apps_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"applicationId\":\"s-applicationid\",\"displayName\":\"s-displayname\",\"state\":\"s-state\",\"subdomain\":\"s-subdomain\",\"template\":\"s-template\"},\"sku\":{\"name\":\"s-name\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL AppsClient.BeginCreateOrUpdate")
  match c.begin_create_or_update("id1/ x", "id2/ x", (json.decode_str[App]("{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"applicationId\":\"s-applicationid\",\"displayName\":\"s-displayname\",\"state\":\"s-state\",\"subdomain\":\"s-subdomain\",\"template\":\"s-template\"},\"sku\":{\"name\":\"s-name\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), AppsClientBeginCreateOrUpdateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_apps_client_create_or_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

