  pub upgrade_graph: UpgradeGraph
}

fn appliances_get_upgrade_graph_handle(resp: http.Response) -> AppliancesClientGetUpgradeGraphResponse ! Str {
  let v = if resp.body.is_empty() { UpgradeGraph{} } else { json.decode[UpgradeGraph](resp.body) ?? e => return Err(e.display()) }
  Ok(AppliancesClientGetUpgradeGraphResponse{upgrade_graph: v})
}

fn (c: AppliancesClient) get_upgrade_graph_create_request(resource_group_name: Str, resource_name: Str, upgrade_graph: Str, options: AppliancesClientGetUpgradeGraphOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.ResourceConnector/appliances/{resourceName}/upgradeGraphs/{upgradeGraph}"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter client.subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if resource_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceName cannot be empty"))
  }
  path = path.replace("{resourceName}", url.path_escape(resource_name))
  if upgrade_graph == "" {
    return Err(azcore.CallErr.InvalidInput("parameter upgradeGraph cannot be empty"))
  }
  path = path.replace("{upgradeGraph}", url.path_escape(upgrade_graph))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  Ok(policy.Request{method: "GET", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: b""})
}

/// Gets the upgrade graph of an Appliance with a specified resource group and name and specific release train.
pub fn (c: AppliancesClient) get_upgrade_graph(resource_group_name: Str, resource_name: Str, upgrade_graph: Str, options: AppliancesClientGetUpgradeGraphOptions = AppliancesClientGetUpgradeGraphOptions{}) -> AppliancesClientGetUpgradeGraphResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.get_upgrade_graph_create_request(resource_group_name, resource_name, upgrade_graph, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  appliances_get_upgrade_graph_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
