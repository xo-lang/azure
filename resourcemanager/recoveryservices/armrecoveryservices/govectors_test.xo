test "Go's VaultsClient.BeginUpdate" {
  let f = gv_new_fake(os.net)
  let c = new_vaults_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"backupStorageVersion\":\"s-backupstorageversion\",\"bcdrSecurityLevel\":\"s-bcdrsecuritylevel\",\"costManagementSettings\":{\"granularityLevel\":\"s-granularitylevel\"},\"encryption\":{\"infrastructureEncryption\":\"s-infrastructureencryption\",\"kekIdentity\":{\"useSystemAssignedIdentity\":true,\"userAssignedIdentity\":\"s-userassignedidentity\"},\"keyVaultProperties\":{\"keyUri\":\"s-keyuri\"}},\"monitoringSettings\":{\"azureMonitorAlertSettings\":{\"alertsForAllFailoverIssues\":\"s-alertsforallfailoverissues\",\"alertsForAllJobFailures\":\"s-alertsforalljobfailures\",\"alertsForAllReplicationIssues\":\"s-alertsforallreplicationissues\"},\"classicAlertSettings\":{\"alertsForCriticalOperations\":\"s-alertsforcriticaloperations\",\"emailNotificationsForSiteRecovery\":\"s-emailnotificationsforsiterecovery\"}},\"moveDetails\":{\"completionTimeUtc\":\"2026-11-06T10:00:00Z\",\"operationId\":\"s-operationid\",\"sourceResourceId\":\"s-sourceresourceid\",\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"targetResourceId\":\"s-targetresourceid\"},\"moveState\":\"s-movestate\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"groupIds\":[\"s-groupids\"],\"privateEndpoint\":{\"id\":\"s-id\"},\"privateLinkServiceConnectionState\":{\"actionsRequired\":\"s-actionsrequired\",\"description\":\"s-description\",\"status\":\"s-status\"},\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"privateEndpointStateForBackup\":\"s-privateendpointstateforbackup\",\"privateEndpointStateForSiteRecovery\":\"s-privateendpointstateforsiterecovery\",\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"redundancySettings\":{\"crossRegionRestore\":\"s-crossregionrestore\",\"standardTierStorageRedundancy\":\"s-standardtierstorageredundancy\"},\"regionOfChoiceSettings\":{\"status\":\"s-status\"},\"resourceGuardOperationRequests\":[\"s-resourceguardoperationrequests\"],\"restoreSettings\":{\"crossSubscriptionRestoreSettings\":{\"crossSubscriptionRestoreState\":\"s-crosssubscriptionrestorestate\"}},\"secureScore\":\"s-securescore\",\"securitySettings\":{\"immutabilitySettings\":{\"configuration\":{\"durationInDays\":7,\"type\":\"s-type\"},\"state\":\"s-state\"},\"multiUserAuthorization\":\"s-multiuserauthorization\",\"softDeleteSettings\":{\"enhancedSecurityState\":\"s-enhancedsecuritystate\",\"softDeleteRetentionPeriodInDays\":7,\"softDeleteState\":\"s-softdeletestate\"},\"sourceScanConfiguration\":{\"sourceScanIdentity\":{\"operationIdentityType\":\"s-operationidentitytype\",\"userAssignedIdentity\":\"s-userassignedidentity\"},\"state\":\"s-state\"}},\"upgradeDetails\":{\"endTimeUtc\":\"2026-11-06T10:00:00Z\",\"lastUpdatedTimeUtc\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"operationId\":\"s-operationid\",\"previousResourceId\":\"s-previousresourceid\",\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"triggerType\":\"s-triggertype\",\"upgradedResourceId\":\"s-upgradedresourceid\"}},\"sku\":{\"capacity\":\"s-capacity\",\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL VaultsClient.BeginUpdate")
  match c.begin_update("id1/ x", "id2/ x", (json.decode_str[PatchVault]("{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"backupStorageVersion\":\"s-backupstorageversion\",\"bcdrSecurityLevel\":\"s-bcdrsecuritylevel\",\"costManagementSettings\":{\"granularityLevel\":\"s-granularitylevel\"},\"encryption\":{\"infrastructureEncryption\":\"s-infrastructureencryption\",\"kekIdentity\":{\"useSystemAssignedIdentity\":true,\"userAssignedIdentity\":\"s-userassignedidentity\"},\"keyVaultProperties\":{\"keyUri\":\"s-keyuri\"}},\"monitoringSettings\":{\"azureMonitorAlertSettings\":{\"alertsForAllFailoverIssues\":\"s-alertsforallfailoverissues\",\"alertsForAllJobFailures\":\"s-alertsforalljobfailures\",\"alertsForAllReplicationIssues\":\"s-alertsforallreplicationissues\"},\"classicAlertSettings\":{\"alertsForCriticalOperations\":\"s-alertsforcriticaloperations\",\"emailNotificationsForSiteRecovery\":\"s-emailnotificationsforsiterecovery\"}},\"moveDetails\":{\"completionTimeUtc\":\"2026-11-06T10:00:00Z\",\"operationId\":\"s-operationid\",\"sourceResourceId\":\"s-sourceresourceid\",\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"targetResourceId\":\"s-targetresourceid\"},\"moveState\":\"s-movestate\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"groupIds\":[\"s-groupids\"],\"privateEndpoint\":{\"id\":\"s-id\"},\"privateLinkServiceConnectionState\":{\"actionsRequired\":\"s-actionsrequired\",\"description\":\"s-description\",\"status\":\"s-status\"},\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"privateEndpointStateForBackup\":\"s-privateendpointstateforbackup\",\"privateEndpointStateForSiteRecovery\":\"s-privateendpointstateforsiterecovery\",\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"redundancySettings\":{\"crossRegionRestore\":\"s-crossregionrestore\",\"standardTierStorageRedundancy\":\"s-standardtierstorageredundancy\"},\"regionOfChoiceSettings\":{\"status\":\"s-status\"},\"resourceGuardOperationRequests\":[\"s-resourceguardoperationrequests\"],\"restoreSettings\":{\"crossSubscriptionRestoreSettings\":{\"crossSubscriptionRestoreState\":\"s-crosssubscriptionrestorestate\"}},\"secureScore\":\"s-securescore\",\"securitySettings\":{\"immutabilitySettings\":{\"configuration\":{\"durationInDays\":7,\"type\":\"s-type\"},\"state\":\"s-state\"},\"multiUserAuthorization\":\"s-multiuserauthorization\",\"softDeleteSettings\":{\"enhancedSecurityState\":\"s-enhancedsecuritystate\",\"softDeleteRetentionPeriodInDays\":7,\"softDeleteState\":\"s-softdeletestate\"},\"sourceScanConfiguration\":{\"sourceScanIdentity\":{\"operationIdentityType\":\"s-operationidentitytype\",\"userAssignedIdentity\":\"s-userassignedidentity\"},\"state\":\"s-state\"}},\"upgradeDetails\":{\"endTimeUtc\":\"2026-11-06T10:00:00Z\",\"lastUpdatedTimeUtc\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"operationId\":\"s-operationid\",\"previousResourceId\":\"s-previousresourceid\",\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"triggerType\":\"s-triggertype\",\"upgradedResourceId\":\"s-upgradedresourceid\"}},\"sku\":{\"capacity\":\"s-capacity\",\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), VaultsClientBeginUpdateOptions{x_ms_authorization_auxiliary: Some("s-xmsauthorizationauxiliary")}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_vaults_client_update_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_20)
}

fn show_vaults_client_get_response(r: VaultsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.vault).to_str_lossy()}")
  parts.join(" ")
}

