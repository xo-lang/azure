test "Go's VaultsClient.NewListBySubscriptionIDPager" {
  let f = gv_new_fake(os.net)
  let c = new_vaults_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"backupStorageVersion\":\"s-backupstorageversion\",\"bcdrSecurityLevel\":\"s-bcdrsecuritylevel\",\"costManagementSettings\":{\"granularityLevel\":\"s-granularitylevel\"},\"encryption\":{\"infrastructureEncryption\":\"s-infrastructureencryption\",\"kekIdentity\":{\"useSystemAssignedIdentity\":true,\"userAssignedIdentity\":\"s-userassignedidentity\"},\"keyVaultProperties\":{\"keyUri\":\"s-keyuri\"}},\"monitoringSettings\":{\"azureMonitorAlertSettings\":{\"alertsForAllFailoverIssues\":\"s-alertsforallfailoverissues\",\"alertsForAllJobFailures\":\"s-alertsforalljobfailures\",\"alertsForAllReplicationIssues\":\"s-alertsforallreplicationissues\"},\"classicAlertSettings\":{\"alertsForCriticalOperations\":\"s-alertsforcriticaloperations\",\"emailNotificationsForSiteRecovery\":\"s-emailnotificationsforsiterecovery\"}},\"moveDetails\":{\"completionTimeUtc\":\"2026-11-06T10:00:00Z\",\"operationId\":\"s-operationid\",\"sourceResourceId\":\"s-sourceresourceid\",\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"targetResourceId\":\"s-targetresourceid\"},\"moveState\":\"s-movestate\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"privateEndpointStateForBackup\":\"s-privateendpointstateforbackup\",\"privateEndpointStateForSiteRecovery\":\"s-privateendpointstateforsiterecovery\",\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"redundancySettings\":{\"crossRegionRestore\":\"s-crossregionrestore\",\"standardTierStorageRedundancy\":\"s-standardtierstorageredundancy\"},\"regionOfChoiceSettings\":{\"status\":\"s-status\"},\"resourceGuardOperationRequests\":[\"s-resourceguardoperationrequests\"],\"restoreSettings\":{\"crossSubscriptionRestoreSettings\":{\"crossSubscriptionRestoreState\":\"s-crosssubscriptionrestorestate\"}},\"secureScore\":\"s-securescore\",\"securitySettings\":{\"immutabilitySettings\":{\"configuration\":{\"durationInDays\":7,\"type\":\"s-type\"},\"state\":\"s-state\"},\"multiUserAuthorization\":\"s-multiuserauthorization\",\"softDeleteSettings\":{\"enhancedSecurityState\":\"s-enhancedsecuritystate\",\"softDeleteRetentionPeriodInDays\":7,\"softDeleteState\":\"s-softdeletestate\"},\"sourceScanConfiguration\":{\"sourceScanIdentity\":{\"operationIdentityType\":\"s-operationidentitytype\",\"userAssignedIdentity\":\"s-userassignedidentity\"},\"state\":\"s-state\"}},\"upgradeDetails\":{\"endTimeUtc\":\"2026-11-06T10:00:00Z\",\"lastUpdatedTimeUtc\":\"2026-11-06T10:00:00Z\",\"message\":\"s-message\",\"operationId\":\"s-operationid\",\"previousResourceId\":\"s-previousresourceid\",\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"status\":\"s-status\",\"triggerType\":\"s-triggertype\",\"upgradedResourceId\":\"s-upgradedresourceid\"}},\"sku\":{\"capacity\":\"s-capacity\",\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VaultsClient.NewListBySubscriptionIDPager")
  var pg = c.new_list_by_subscription_id_pager(VaultsClientListBySubscriptionIDOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_vaults_client_list_by_subscription_id_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_23)
}
