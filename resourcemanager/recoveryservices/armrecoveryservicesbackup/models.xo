pub const PRIVATE_ENDPOINT_CONNECTION_STATUS_REJECTED: PrivateEndpointConnectionStatus = PrivateEndpointConnectionStatus("Rejected")

/// The values of PrivateEndpointConnectionStatus this version knows; the service may send others.
pub fn possible_private_endpoint_connection_status_values() -> List[PrivateEndpointConnectionStatus] {
  [PRIVATE_ENDPOINT_CONNECTION_STATUS_APPROVED, PRIVATE_ENDPOINT_CONNECTION_STATUS_DISCONNECTED, PRIVATE_ENDPOINT_CONNECTION_STATUS_PENDING, PRIVATE_ENDPOINT_CONNECTION_STATUS_REJECTED]
}

