fn show_replication_protection_clusters_client_list_response(r: ReplicationProtectionClustersClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.replication_protection_cluster_collection).to_str_lossy()}")
  parts.join(" ")
}

