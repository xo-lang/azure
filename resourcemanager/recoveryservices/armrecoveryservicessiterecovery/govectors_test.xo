fn show_replication_protection_clusters_client_test_failover_response(r: ReplicationProtectionClustersClientTestFailoverResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.replication_protection_cluster).to_str_lossy()}")
  parts.join(" ")
}

