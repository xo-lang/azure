test "Go's ReplicationLogicalNetworksClient.NewListByReplicationFabricsPager" {
  let f = gv_new_fake(os.net)
  let c = new_replication_logical_networks_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"friendlyName\":\"s-friendlyname\",\"logicalNetworkDefinitionsStatus\":\"s-logicalnetworkdefinitionsstatus\",\"logicalNetworkUsage\":\"s-logicalnetworkusage\",\"networkVirtualizationStatus\":\"s-networkvirtualizationstatus\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ReplicationLogicalNetworksClient.NewListByReplicationFabricsPager")
  var pg = c.new_list_by_replication_fabrics_pager("id1/ x", "id2/ x", "id3/ x", ReplicationLogicalNetworksClientListByReplicationFabricsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
