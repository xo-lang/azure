fn show_replication_migration_items_client_resync_response(r: ReplicationMigrationItemsClientResyncResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.migration_item).to_str_lossy()}")
  parts.join(" ")
}

