test "Go's ReplicationProtectedItemsClient.NewListByReplicationProtectionContainersPager" {
  let f = gv_new_fake(os.net)
  let c = new_replication_protected_items_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"activeLocation\":\"s-activelocation\",\"allowedOperations\":[\"s-allowedoperations\"],\"currentScenario\":{\"jobId\":\"s-jobid\",\"scenarioName\":\"s-scenarioname\",\"startTime\":\"2026-11-06T10:00:00Z\"},\"eventCorrelationId\":\"s-eventcorrelationid\",\"failoverHealth\":\"s-failoverhealth\",\"failoverRecoveryPointId\":\"s-failoverrecoverypointid\",\"friendlyName\":\"s-friendlyname\",\"healthErrors\":[{\"creationTimeUtc\":\"2026-11-06T10:00:00Z\",\"customerResolvability\":\"s-customerresolvability\",\"entityId\":\"s-entityid\",\"errorCategory\":\"s-errorcategory\",\"errorCode\":\"s-errorcode\",\"errorId\":\"s-errorid\",\"errorLevel\":\"s-errorlevel\",\"errorMessage\":\"s-errormessage\",\"errorSource\":\"s-errorsource\",\"errorType\":\"s-errortype\",\"possibleCauses\":\"s-possiblecauses\",\"recommendedAction\":\"s-recommendedaction\",\"recoveryProviderErrorMessage\":\"s-recoveryprovidererrormessage\",\"summaryMessage\":\"s-summarymessage\"}],\"lastSuccessfulFailoverTime\":\"2026-11-06T10:00:00Z\",\"lastSuccessfulTestFailoverTime\":\"2026-11-06T10:00:00Z\",\"policyFriendlyName\":\"s-policyfriendlyname\",\"policyId\":\"s-policyid\",\"primaryFabricFriendlyName\":\"s-primaryfabricfriendlyname\",\"primaryFabricProvider\":\"s-primaryfabricprovider\",\"primaryProtectionContainerFriendlyName\":\"s-primaryprotectioncontainerfriendlyname\",\"protectableItemId\":\"s-protectableitemid\",\"protectedItemType\":\"s-protecteditemtype\",\"protectionState\":\"s-protectionstate\",\"protectionStateDescription\":\"s-protectionstatedescription\",\"providerSpecificDetails\":{\"fabricObjectId\":\"s-fabricobjectid\",\"instanceType\":\"A2ACrossClusterMigration\",\"lifecycleId\":\"s-lifecycleid\",\"osType\":\"s-ostype\",\"primaryFabricLocation\":\"s-primaryfabriclocation\",\"vmProtectionState\":\"s-vmprotectionstate\",\"vmProtectionStateDescription\":\"s-vmprotectionstatedescription\"},\"recoveryContainerId\":\"s-recoverycontainerid\",\"recoveryFabricFriendlyName\":\"s-recoveryfabricfriendlyname\",\"recoveryFabricId\":\"s-recoveryfabricid\",\"recoveryProtectionContainerFriendlyName\":\"s-recoveryprotectioncontainerfriendlyname\",\"recoveryServicesProviderId\":\"s-recoveryservicesproviderid\",\"replicationHealth\":\"s-replicationhealth\",\"switchProviderState\":\"s-switchproviderstate\",\"switchProviderStateDescription\":\"s-switchproviderstatedescription\",\"testFailoverState\":\"s-testfailoverstate\",\"testFailoverStateDescription\":\"s-testfailoverstatedescription\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ReplicationProtectedItemsClient.NewListByReplicationProtectionContainersPager")
  var pg = c.new_list_by_replication_protection_containers_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", ReplicationProtectedItemsClientListByReplicationProtectionContainersOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_replication_protected_items_client_list_by_replication_protection_containers_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_82)
}

fn show_replication_protected_items_client_list_response(r: ReplicationProtectedItemsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.replication_protected_item_collection).to_str_lossy()}")
  parts.join(" ")
}

