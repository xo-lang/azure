fn show_replication_protected_items_client_update_appliance_response(r: ReplicationProtectedItemsClientUpdateApplianceResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.replication_protected_item).to_str_lossy()}")
  parts.join(" ")
}

