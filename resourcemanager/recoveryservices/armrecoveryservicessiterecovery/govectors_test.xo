test "Go's TargetComputeSizesClient.NewListByReplicationProtectedItemsPager" {
  let f = gv_new_fake(os.net)
  let c = new_target_compute_sizes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"cpuCoresCount\":7,\"errors\":[{\"message\":\"s-message\",\"severity\":\"s-severity\"}],\"friendlyName\":\"s-friendlyname\",\"highIopsSupported\":\"s-highiopssupported\",\"hyperVGenerations\":[\"s-hypervgenerations\"],\"maxDataDiskCount\":7,\"maxNicsCount\":7,\"memoryInGB\":1.5,\"name\":\"s-name\",\"vCPUsAvailable\":7},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL TargetComputeSizesClient.NewListByReplicationProtectedItemsPager")
  var pg = c.new_list_by_replication_protected_items_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", "id5/ x", TargetComputeSizesClientListByReplicationProtectedItemsOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_target_compute_sizes_client_list_by_replication_protected_items_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_153)
}
