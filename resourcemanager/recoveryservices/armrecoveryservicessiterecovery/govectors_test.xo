test "Go's ReplicationPoliciesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_replication_policies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"friendlyName\":\"s-friendlyname\",\"providerSpecificDetails\":{\"appConsistentFrequencyInMinutes\":7,\"crashConsistentFrequencyInMinutes\":7,\"instanceType\":\"A2A\",\"multiVmSyncStatus\":\"s-multivmsyncstatus\",\"recoveryPointHistory\":7,\"recoveryPointThresholdInMinutes\":7}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ReplicationPoliciesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ReplicationPoliciesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_replication_policies_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_58)
}

