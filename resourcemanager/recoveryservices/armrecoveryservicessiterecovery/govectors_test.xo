  gv_note(f, "CALL ReplicationMigrationItemsClient.NewListByReplicationProtectionContainersPager")
  var pg = c.new_list_by_replication_protection_containers_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", ReplicationMigrationItemsClientListByReplicationProtectionContainersOptions{filter: Some("s-filter"), skip_token: Some("s-skiptoken"), take_token: Some("s-taketoken")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_replication_migration_items_client_list_by_replication_protection_containers_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
