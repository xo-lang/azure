      Ok(r) => gv_note(f, "OUT page ${page}: ${show_replication_logical_networks_client_list_by_replication_fabrics_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_32)
}

