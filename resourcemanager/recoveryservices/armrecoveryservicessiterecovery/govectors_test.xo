  gv_compare(gv_log_of(f), GO_43)
}

fn show_replication_migration_items_client_list_response(r: ReplicationMigrationItemsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.migration_item_collection).to_str_lossy()}")
  parts.join(" ")
}

