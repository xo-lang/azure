fn show_replication_protection_clusters_client_unplanned_failover_response(r: ReplicationProtectionClustersClientUnplannedFailoverResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.replication_protection_cluster).to_str_lossy()}")
  parts.join(" ")
}

