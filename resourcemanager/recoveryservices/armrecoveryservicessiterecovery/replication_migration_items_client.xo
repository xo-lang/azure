    return Err(azcore.CallErr.InvalidInput("parameter resourceName cannot be empty"))
  }
  path = path.replace("{resourceName}", url.path_escape(resource_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  if let Some(v) = options.skip_token {
    q.add("skipToken", v)
  }
  if let Some(v) = options.take_token {
    q.add("takeToken", v)
  }
  if let Some(v) = options.filter {
    q.add("$filter", v)
  }
  Ok(policy.Request{method: "GET", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: b""})
}

/// Gets the list of migration items in the vault.
pub fn (c: ReplicationMigrationItemsClient[fx]) new_list_pager(resource_group_name: Str, resource_name: Str, options: ReplicationMigrationItemsClientListOptions = ReplicationMigrationItemsClientListOptions{}) -> runtime.Pager[ReplicationMigrationItemsClientListResponse, fx] ! azcore.CallErr {
  let req = c.list_create_request(resource_group_name, resource_name, options)?
  Ok(runtime.new_next_link_pager(c.setup.pipeline, req, fn(r: http.Response) -> ReplicationMigrationItemsClientListResponse ! Str { replication_migration_items_list_handle(r) }, c.setup.endpoint, fn(r: ReplicationMigrationItemsClientListResponse) -> Str? { r.migration_item_collection.next_link }).traced_as("ReplicationMigrationItemsClientListResponse"))
}
