on\":\"s-collation\",\"isIfiEnabled\":true,\"isLpimEnabled\":true,\"isOptimizeForAdHocWorkloadsEnabled\":true,\"maxDop\":7,\"maxServerMemoryMB\":7,\"minServerMemoryMB\":7},\"sqlStorageUpdateSettings\":{\"diskConfigurationType\":\"s-diskconfigurationtype\",\"diskCount\":7,\"startingDeviceId\":7},\"sqlWorkloadTypeUpdateSettings\":{\"sqlWorkloadType\":\"s-sqlworkloadtype\"}},\"sqlImageOffer\":\"s-sqlimageoffer\",\"sqlImageSku\":\"s-sqlimagesku\",\"sqlManagement\":\"s-sqlmanagement\",\"sqlServerLicenseType\":\"s-sqlserverlicensetype\",\"sqlVirtualMachineGroupResourceId\":\"s-sqlvirtualmachinegroupresourceid\",\"storageConfigurationSettings\":{\"diskConfigurationType\":\"s-diskconfigurationtype\",\"enableStorageConfigBlade\":true,\"sqlDataSettings\":{\"defaultFilePath\":\"s-defaultfilepath\",\"luns\":[7],\"useStoragePool\":true},\"sqlLogSettings\":{\"defaultFilePath\":\"s-defaultfilepath\",\"luns\":[7],\"useStoragePool\":true},\"sqlSystemDbOnDataDisk\":true,\"sqlTempDbSettings\":{\"dataFileCount\":7,\"dataFileSize\":7,\"dataGrowth\":7,\"defaultFilePath\":\"s-defaultfilepath\",\"logFileSize\":7,\"logGrowth\":7,\"luns\":[7],\"persistFolder\":true,\"persistFolderPath\":\"s-persistfolderpath\",\"useStoragePool\":true},\"storageWorkloadType\":\"s-storageworkloadtype\"},\"troubleshootingStatus\":{\"endTimeUtc\":\"2026-11-06T10:00:00Z\",\"lastTriggerTimeUtc\":\"2026-11-06T10:00:00Z\",\"properties\":{\"unhealthyReplicaInfo\":{\"availabilityGroupName\":\"s-availabilitygroupname\"}},\"rootCause\":\"s-rootcause\",\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"troubleshootingScenario\":\"s-troubleshootingscenario\"},\"virtualMachineIdentitySettings\":{\"resourceId\":\"s-resourceid\",\"type\":\"s-type\"},\"virtualMachineResourceId\":\"s-virtualmachineresourceid\",\"wsfcDomainCredentials\":{\"clusterBootstrapAccountPassword\":\"s-clusterbootstrapaccountpassword\",\"clusterOperatorAccountPassword\":\"s-clusteroperatoraccountpassword\",\"sqlServiceAccountPassword\":\"s-sqlserviceaccountpassword\"},\"wsfcStaticIp\":\"s-wsfcstaticip\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SQLVirtualMachinesClient.NewListPager")
  var pg = c.new_list_pager(SQLVirtualMachinesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_sql_virtual_machines_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_20)
}

fn show_troubleshoot_client_troubleshoot_response(r: TroubleshootClientTroubleshootResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.sqlvm_troubleshooting).to_str_lossy()}")
  parts.join(" ")
}

const GO_21: List[Str] = [
  "CALL TroubleshootClient.BeginTroubleshoot",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.SqlVirtualMachine/sqlVirtualMachines/id2%2F%20x/troubleshoot?api-version=2023-10-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"endTimeUtc\":\"2026-11-06T10:00:00Z\",\"properties\":{\"unhealthyReplicaInfo\":{\"availabilityGroupName\":\"s-availabilitygroupname\"}},\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"troubleshootingScenario\":\"s-troubleshootingscenario\",\"virtualMachineResourceId\":\"s-virtualmachineresourceid\"}",
  "  SERVED 200 {\"endTimeUtc\":\"2026-11-06T10:00:00Z\",\"properties\":{\"unhealthyReplicaInfo\":{\"availabilityGroupName\":\"s-availabilitygroupname\"}},\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"troubleshootingScenario\":\"s-troubleshootingscenario\",\"virtualMachineResourceId\":\"s-virtualmachineresourceid\"}",
  "OUT: body={\"endTimeUtc\":\"2026-11-06T10:00:00Z\",\"properties\":{\"unhealthyReplicaInfo\":{\"availabilityGroupName\":\"s-availabilitygroupname\"}},\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"troubleshootingScenario\":\"s-troubleshootingscenario\",\"virtualMachineResourceId\":\"s-virtualmachineresourceid\"}",
]

test "Go's TroubleshootClient.BeginTroubleshoot" {
  let f = gv_new_fake(os.net)
  let c = new_troubleshoot_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"endTimeUtc\":\"2026-11-06T10:00:00Z\",\"properties\":{\"unhealthyReplicaInfo\":{\"availabilityGroupName\":\"s-availabilitygroupname\"}},\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"troubleshootingScenario\":\"s-troubleshootingscenario\",\"virtualMachineResourceId\":\"s-virtualmachineresourceid\"}")
  gv_note(f, "CALL TroubleshootClient.BeginTroubleshoot")
  match c.begin_troubleshoot("id1/ x", "id2/ x", (json.decode_str[SQLVMTroubleshooting]("{\"endTimeUtc\":\"2026-11-06T10:00:00Z\",\"properties\":{\"unhealthyReplicaInfo\":{\"availabilityGroupName\":\"s-availabilitygroupname\"}},\"startTimeUtc\":\"2026-11-06T10:00:00Z\",\"troubleshootingScenario\":\"s-troubleshootingscenario\",\"virtualMachineResourceId\":\"s-virtualmachineresourceid\"}") ?? e => fault("${e}")), TroubleshootClientBeginTroubleshootOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_troubleshoot_client_troubleshoot_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_21)
}
