  match c.check_availability((json.decode_str[NameIdentifier]("{\"name\":\"s-name\"}") ?? e => fault("${e}")), DomainsClientCheckAvailabilityOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_domains_client_check_availability_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_1)
}

