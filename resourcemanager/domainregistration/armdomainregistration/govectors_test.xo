  let f = gv_new_fake(os.net)
  let c = new_domains_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"available\":true,\"domainType\":\"s-domaintype\",\"name\":\"s-name\"}")
