test "Go's RulesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_rules_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"error\":{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"},\"evaluationState\":\"s-evaluationstate\",\"externalId\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"kind\":\"businessVerification\",\"provisioningState\":\"Succeeded\",\"registrationNumber\":{\"registrationRequirement\":\"s-registrationrequirement\",\"type\":[\"s-type\"],\"value\":\"s-value\"},\"soldTo\":{\"addressLine1\":\"s-addressline1\",\"addressLine2\":\"s-addressline2\",\"addressLine3\":\"s-addressline3\",\"city\":\"s-city\",\"companyName\":\"s-companyname\",\"country\":\"s-country\",\"district\":\"s-district\",\"email\":\"s-email\",\"firstName\":\"s-firstname\",\"lastName\":\"s-lastname\",\"middleName\":\"s-middlename\",\"phoneNumber\":\"s-phonenumber\",\"postalCode\":\"s-postalcode\",\"region\":\"s-region\"},\"supplementalDocuments\":[\"s-supplementaldocuments\"],\"taxIds\":[{\"country\":\"s-country\",\"scope\":\"s-scope\",\"status\":\"s-status\",\"type\":\"s-type\",\"value\":\"s-value\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RulesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", RulesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_rules_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_8)
}

