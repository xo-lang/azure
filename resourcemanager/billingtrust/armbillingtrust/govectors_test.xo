  "REQ PATCH https://management.example.test/id1/%20x/providers/Microsoft.BillingTrust/assessments/default/rules/id2/%20x?api-version=2026-03-17-preview",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"externalId\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"kind\":\"businessVerification\",\"supplementalDocuments\":[\"s-supplementaldocuments\"]}",
  "  SERVED 200 {\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"evaluationState\":\"s-evaluationstate\",\"externalId\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"kind\":\"businessVerification\",\"provisioningState\":\"Succeeded\",\"registrationNumber\":{\"registrationRequirement\":\"s-registrationrequirement\",\"type\":[\"s-type\"],\"value\":\"s-value\"},\"soldTo\":{\"addressLine1\":\"s-addressline1\",\"addressLine2\":\"s-addressline2\",\"addressLine3\":\"s-addressline3\",\"city\":\"s-city\",\"companyName\":\"s-companyname\",\"country\":\"s-country\",\"district\":\"s-district\",\"email\":\"s-email\",\"firstName\":\"s-firstname\",\"lastName\":\"s-lastname\",\"middleName\":\"s-middlename\",\"phoneNumber\":\"s-phonenumber\",\"postalCode\":\"s-postalcode\",\"region\":\"s-region\"},\"supplementalDocuments\":[\"s-supplementaldocuments\"],\"taxIds\":[{\"country\":\"s-country\",\"scope\":\"s-scope\",\"status\":\"s-status\",\"type\":\"s-type\",\"value\":\"s-value\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}",
  "OUT: body={\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"evaluationState\":\"s-evaluationstate\",\"externalId\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"kind\":\"businessVerification\",\"provisioningState\":\"Succeeded\",\"registrationNumber\":{\"registrationRequirement\":\"s-registrationrequirement\",\"type\":[\"s-type\"],\"value\":\"s-value\"},\"soldTo\":{\"addressLine1\":\"s-addressline1\",\"addressLine2\":\"s-addressline2\",\"addressLine3\":\"s-addressline3\",\"city\":\"s-city\",\"companyName\":\"s-companyname\",\"country\":\"s-country\",\"district\":\"s-district\",\"email\":\"s-email\",\"firstName\":\"s-firstname\",\"lastName\":\"s-lastname\",\"middleName\":\"s-middlename\",\"phoneNumber\":\"s-phonenumber\",\"postalCode\":\"s-postalcode\",\"region\":\"s-region\"},\"supplementalDocuments\":[\"s-supplementaldocuments\"],\"taxIds\":[{\"country\":\"s-country\",\"scope\":\"s-scope\",\"status\":\"s-status\",\"type\":\"s-type\",\"value\":\"s-value\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}",
]

test "Go's RulesClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_rules_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"evaluationState\":\"s-evaluationstate\",\"externalId\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"kind\":\"businessVerification\",\"provisioningState\":\"Succeeded\",\"registrationNumber\":{\"registrationRequirement\":\"s-registrationrequirement\",\"type\":[\"s-type\"],\"value\":\"s-value\"},\"soldTo\":{\"addressLine1\":\"s-addressline1\",\"addressLine2\":\"s-addressline2\",\"addressLine3\":\"s-addressline3\",\"city\":\"s-city\",\"companyName\":\"s-companyname\",\"country\":\"s-country\",\"district\":\"s-district\",\"email\":\"s-email\",\"firstName\":\"s-firstname\",\"lastName\":\"s-lastname\",\"middleName\":\"s-middlename\",\"phoneNumber\":\"s-phonenumber\",\"postalCode\":\"s-postalcode\",\"region\":\"s-region\"},\"supplementalDocuments\":[\"s-supplementaldocuments\"],\"taxIds\":[{\"country\":\"s-country\",\"scope\":\"s-scope\",\"status\":\"s-status\",\"type\":\"s-type\",\"value\":\"s-value\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL RulesClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[RulePatchPropertiesClassification]("{\"externalId\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"kind\":\"businessVerification\",\"supplementalDocuments\":[\"s-supplementaldocuments\"]}") ?? e => fault("${e}")), RulesClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_rules_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_9)
}
