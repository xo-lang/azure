test "Go's StreamingEndpointsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_streaming_endpoints_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"@odata.count\":7,\"@odata.nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessControl\":{\"akamai\":{},\"ip\":{}},\"availabilitySetName\":\"s-availabilitysetname\",\"cdnEnabled\":true,\"cdnProfile\":\"s-cdnprofile\",\"cdnProvider\":\"s-cdnprovider\",\"created\":\"2026-11-06T10:00:00Z\",\"crossSiteAccessPolicies\":{\"clientAccessPolicy\":\"s-clientaccesspolicy\",\"crossDomainPolicy\":\"s-crossdomainpolicy\"},\"customHostNames\":[\"s-customhostnames\"],\"description\":\"s-description\",\"freeTrialEndTime\":\"2026-11-06T10:00:00Z\",\"hostName\":\"s-hostname\",\"lastModified\":\"2026-11-06T10:00:00Z\",\"maxCacheAge\":7,\"provisioningState\":\"Succeeded\",\"resourceState\":\"s-resourcestate\",\"scaleUnits\":7},\"sku\":{\"capacity\":7,\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL StreamingEndpointsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", StreamingEndpointsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_streaming_endpoints_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_75)
}

