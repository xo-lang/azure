test "Go's TransformsClient.Update" {
  let f = gv_new_fake(os.net)
  let c = new_transforms_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"created\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"lastModified\":\"2026-11-06T10:00:00Z\",\"outputs\":[{\"onError\":\"s-onerror\",\"preset\":{\"@odata.type\":\"#Microsoft.Media.AudioAnalyzerPreset\",\"audioLanguage\":\"s-audiolanguage\",\"experimentalOptions\":{\"k1\":\"s-experimentaloptions\"},\"mode\":\"s-mode\"},\"relativePriority\":\"s-relativepriority\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL TransformsClient.Update")
  match c.update("id1/ x", "id2/ x", "id3/ x", (json.decode_str[Transform]("{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"created\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"lastModified\":\"2026-11-06T10:00:00Z\",\"outputs\":[{\"onError\":\"s-onerror\",\"preset\":{\"@odata.type\":\"#Microsoft.Media.AudioAnalyzerPreset\",\"audioLanguage\":\"s-audiolanguage\",\"experimentalOptions\":{\"k1\":\"s-experimentaloptions\"},\"mode\":\"s-mode\"},\"relativePriority\":\"s-relativepriority\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}") ?? e => fault("${e}")), TransformsClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_transforms_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_98)
}
