test "Go's JobsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_jobs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"@odata.nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"correlationData\":{\"k1\":\"s-correlationdata\"},\"created\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"endTime\":\"2026-11-06T10:00:00Z\",\"input\":{\"@odata.type\":\"#Microsoft.Media.JobInputAsset\",\"assetName\":\"s-assetname\",\"end\":{\"@odata.type\":\"#Microsoft.Media.AbsoluteClipTime\",\"time\":\"s-time\"},\"files\":[\"s-files\"],\"inputDefinitions\":[{\"@odata.type\":\"#Microsoft.Media.FromAllInputFile\"}],\"label\":\"s-label\",\"start\":{\"@odata.type\":\"#Microsoft.Media.AbsoluteClipTime\",\"time\":\"s-time\"}},\"lastModified\":\"2026-11-06T10:00:00Z\",\"outputs\":[{\"@odata.type\":\"#Microsoft.Media.JobOutputAsset\",\"assetName\":\"s-assetname\",\"endTime\":\"2026-11-06T10:00:00Z\",\"label\":\"s-label\",\"presetOverride\":{\"@odata.type\":\"#Microsoft.Media.AudioAnalyzerPreset\",\"audioLanguage\":\"s-audiolanguage\",\"experimentalOptions\":{\"k1\":\"s-experimentaloptions\"},\"mode\":\"s-mode\"},\"progress\":7,\"startTime\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\"}],\"priority\":\"s-priority\",\"startTime\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL JobsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", JobsClientListOptions{filter: Some("s-filter"), orderby: Some("s-orderby")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_jobs_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_38)
}

