test "Go's Client.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"@odata.nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"encryption\":{\"identity\":{\"useSystemAssignedIdentity\":true,\"userAssignedIdentity\":\"s-userassignedidentity\"},\"keyVaultProperties\":{\"currentKeyIdentifier\":\"s-currentkeyidentifier\",\"keyIdentifier\":\"s-keyidentifier\"},\"status\":\"s-status\",\"type\":\"s-type\"},\"keyDelivery\":{\"accessControl\":{\"defaultAction\":\"s-defaultaction\",\"ipAllowList\":[\"s-ipallowlist\"]}},\"mediaServiceId\":\"s-mediaserviceid\",\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"storageAccounts\":[{\"id\":\"s-id\",\"identity\":{\"useSystemAssignedIdentity\":true,\"userAssignedIdentity\":\"s-userassignedidentity\"},\"status\":\"s-status\",\"type\":\"s-type\"}],\"storageAuthentication\":\"s-storageauthentication\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Client.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(ClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_25)
}

