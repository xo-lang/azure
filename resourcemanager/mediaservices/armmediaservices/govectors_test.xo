  "OUT: body={\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"created\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"lastModified\":\"2026-11-06T10:00:00Z\",\"outputs\":[{\"onError\":\"s-onerror\",\"preset\":{\"@odata.type\":\"#Microsoft.Media.AudioAnalyzerPreset\",\"audioLanguage\":\"s-audiolanguage\",\"experimentalOptions\":{\"k1\":\"s-experimentaloptions\"},\"mode\":\"s-mode\"},\"relativePriority\":\"s-relativepriority\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}",
