fn show_operation_results_client_get_response(r: OperationResultsClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.media_service).to_str_lossy()}")
  if let Some(v) = r.azure_async_operation {
    parts.push("AzureAsyncOperation=${v}")
  }
  if let Some(v) = r.location {
    parts.push("Location=${v}")
  }
  if let Some(v) = r.retry_after {
    parts.push("RetryAfter=${"${v}"}")
  }
  parts.join(" ")
}

