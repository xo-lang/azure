  let f = gv_new_fake(os.net)
  let c = new_content_key_policies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"@odata.nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"created\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"lastModified\":\"2026-11-06T10:00:00Z\",\"options\":[{\"configuration\":{\"@odata.type\":\"#Microsoft.Media.ContentKeyPolicyClearKeyConfiguration\"},\"name\":\"s-name\",\"policyOptionId\":\"s-policyoptionid\",\"restriction\":{\"@odata.type\":\"#Microsoft.Media.ContentKeyPolicyOpenRestriction\"}}],\"policyId\":\"s-policyid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ContentKeyPoliciesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ContentKeyPoliciesClientListOptions{filter: Some("s-filter"), orderby: Some("s-orderby"), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_content_key_policies_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_32)
}

