test "Go's LiveOutputsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_live_outputs_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"@odata.count\":7,\"@odata.nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"archiveWindowLength\":\"s-archivewindowlength\",\"assetName\":\"s-assetname\",\"created\":\"2026-11-06T10:00:00Z\",\"description\":\"s-description\",\"hls\":{\"fragmentsPerTsSegment\":7},\"lastModified\":\"2026-11-06T10:00:00Z\",\"manifestName\":\"s-manifestname\",\"outputSnapTime\":7,\"provisioningState\":\"Succeeded\",\"resourceState\":\"s-resourcestate\",\"rewindWindowLength\":\"s-rewindwindowlength\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL LiveOutputsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", LiveOutputsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_live_outputs_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_55)
}

