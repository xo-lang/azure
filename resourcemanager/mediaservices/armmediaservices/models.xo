/// The type of AttributeFilter to apply to the TrackAttribute in order to select the tracks.
pub type AttributeFilter struct(Str)
/// All tracks will be included.
pub const ATTRIBUTE_FILTER_ALL: AttributeFilter = AttributeFilter("All")
/// The first track will be included when the attribute is sorted in ascending order.  Generally used to select the smallest bitrate.
pub const ATTRIBUTE_FILTER_BOTTOM: AttributeFilter = AttributeFilter("Bottom")
/// The first track will be included when the attribute is sorted in descending order.  Generally used to select the largest bitrate.
pub const ATTRIBUTE_FILTER_TOP: AttributeFilter = AttributeFilter("Top")
/// Any tracks that have an attribute equal to the value given will be included.
pub const ATTRIBUTE_FILTER_VALUE_EQUALS: AttributeFilter = AttributeFilter("ValueEquals")

/// The values of AttributeFilter this version knows; the service may send others.
pub fn possible_attribute_filter_values() -> List[AttributeFilter] {
  [ATTRIBUTE_FILTER_ALL, ATTRIBUTE_FILTER_BOTTOM, ATTRIBUTE_FILTER_TOP, ATTRIBUTE_FILTER_VALUE_EQUALS]
}

/// Error code describing the error.
pub type JobErrorCode struct(Str)
/// There was a problem with the combination of input files and the configuration settings applied, fix the configuration settings and retry with the same input, or change input to match the configuration.
