  [INTERLEAVE_OUTPUT_INTERLEAVED_OUTPUT, INTERLEAVE_OUTPUT_NON_INTERLEAVED_OUTPUT]
}

/// The built-in preset to be used for encoding videos.
pub type EncoderNamedPreset struct(Str)
/// Produces a single MP4 file containing only AAC stereo audio encoded at 192 kbps.
pub const ENCODER_NAMED_PRESET_AAC_GOOD_QUALITY_AUDIO: EncoderNamedPreset = EncoderNamedPreset("AACGoodQualityAudio")
/// Produces a set of GOP aligned MP4 files with H.264 video and stereo AAC audio. Auto-generates a bitrate ladder based on the input resolution, bitrate and frame rate. The auto-generated preset will never exceed the input resolution. For example, if the input is 720p, output will remain 720p at best.
pub const ENCODER_NAMED_PRESET_ADAPTIVE_STREAMING: EncoderNamedPreset = EncoderNamedPreset("AdaptiveStreaming")
/// Produces a set of GOP-aligned MP4s by using content-aware encoding. Given any input content, the service performs an initial lightweight analysis of the input content, and uses the results to determine the optimal number of layers, appropriate bitrate and resolution settings for delivery by adaptive streaming. This preset is particularly effective for low and medium complexity videos, where the output files will be at lower bitrates but at a quality that still delivers a good experience to viewers. The output will contain MP4 files with video and audio interleaved.
pub const ENCODER_NAMED_PRESET_CONTENT_AWARE_ENCODING: EncoderNamedPreset = EncoderNamedPreset("ContentAwareEncoding")
/// Exposes an experimental preset for content-aware encoding. Given any input content, the service attempts to automatically determine the optimal number of layers, appropriate bitrate and resolution settings for delivery by adaptive streaming. The underlying algorithms will continue to evolve over time. The output will contain MP4 files with video and audio interleaved.
pub const ENCODER_NAMED_PRESET_CONTENT_AWARE_ENCODING_EXPERIMENTAL: EncoderNamedPreset = EncoderNamedPreset("ContentAwareEncodingExperimental")
/// Copy all video and audio streams from the input asset as non-interleaved video and audio output files. This preset can be used to clip an existing asset or convert a group of key frame (GOP) aligned MP4 files as an asset that can be streamed.
pub const ENCODER_NAMED_PRESET_COPY_ALL_BITRATE_NON_INTERLEAVED: EncoderNamedPreset = EncoderNamedPreset("CopyAllBitrateNonInterleaved")
/// Produces a single MP4 file containing only DD(Digital Dolby) stereo audio encoded at 192 kbps.
pub const ENCODER_NAMED_PRESET_DD_GOOD_QUALITY_AUDIO: EncoderNamedPreset = EncoderNamedPreset("DDGoodQualityAudio")
/// Produces a set of 8 GOP-aligned MP4 files, ranging from 6000 kbps to 400 kbps, and stereo AAC audio. Resolution starts at 1080p and goes down to 180p.
pub const ENCODER_NAMED_PRESET_H264_MULTIPLE_BITRATE1080P: EncoderNamedPreset = EncoderNamedPreset("H264MultipleBitrate1080p")
/// Produces a set of 6 GOP-aligned MP4 files, ranging from 3400 kbps to 400 kbps, and stereo AAC audio. Resolution starts at 720p and goes down to 180p.
pub const ENCODER_NAMED_PRESET_H264_MULTIPLE_BITRATE720P: EncoderNamedPreset = EncoderNamedPreset("H264MultipleBitrate720p")
/// Produces a set of 5 GOP-aligned MP4 files, ranging from 1900kbps to 400 kbps, and stereo AAC audio. Resolution starts at 480p and goes down to 240p.
pub const ENCODER_NAMED_PRESET_H264_MULTIPLE_BITRATE_SD: EncoderNamedPreset = EncoderNamedPreset("H264MultipleBitrateSD")
/// Produces an MP4 file where the video is encoded with H.264 codec at 6750 kbps and a picture height of 1080 pixels, and the stereo audio is encoded with AAC-LC codec at 128 kbps.
pub const ENCODER_NAMED_PRESET_H264_SINGLE_BITRATE1080P: EncoderNamedPreset = EncoderNamedPreset("H264SingleBitrate1080p")
/// Produces an MP4 file where the video is encoded with H.264 codec at 4500 kbps and a picture height of 720 pixels, and the stereo audio is encoded with AAC-LC codec at 128 kbps.
pub const ENCODER_NAMED_PRESET_H264_SINGLE_BITRATE720P: EncoderNamedPreset = EncoderNamedPreset("H264SingleBitrate720p")
/// Produces an MP4 file where the video is encoded with H.264 codec at 2200 kbps and a picture height of 480 pixels, and the stereo audio is encoded with AAC-LC codec at 128 kbps.
pub const ENCODER_NAMED_PRESET_H264_SINGLE_BITRATE_SD: EncoderNamedPreset = EncoderNamedPreset("H264SingleBitrateSD")
/// Produces a set of GOP aligned MP4 files with H.265 video and stereo AAC audio. Auto-generates a bitrate ladder based on the input resolution, bitrate and frame rate. The auto-generated preset will never exceed the input resolution. For example, if the input is 720p, output will remain 720p at best.
pub const ENCODER_NAMED_PRESET_H265_ADAPTIVE_STREAMING: EncoderNamedPreset = EncoderNamedPreset("H265AdaptiveStreaming")
/// Produces a set of GOP-aligned MP4s by using content-aware encoding. Given any input content, the service performs an initial lightweight analysis of the input content, and uses the results to determine the optimal number of layers, appropriate bitrate and resolution settings for delivery by adaptive streaming. This preset is particularly effective for low and medium complexity videos, where the output files will be at lower bitrates but at a quality that still delivers a good experience to viewers. The output will contain MP4 files with video and audio interleaved.
pub const ENCODER_NAMED_PRESET_H265_CONTENT_AWARE_ENCODING: EncoderNamedPreset = EncoderNamedPreset("H265ContentAwareEncoding")
/// Produces an MP4 file where the video is encoded with H.265 codec at 3500 kbps and a picture height of 1080 pixels, and the stereo audio is encoded with AAC-LC codec at 128 kbps.
pub const ENCODER_NAMED_PRESET_H265_SINGLE_BITRATE1080P: EncoderNamedPreset = EncoderNamedPreset("H265SingleBitrate1080p")
/// Produces an MP4 file where the video is encoded with H.265 codec at 9500 kbps and a picture height of 2160 pixels, and the stereo audio is encoded with AAC-LC codec at 128 kbps.
pub const ENCODER_NAMED_PRESET_H265_SINGLE_BITRATE4_K: EncoderNamedPreset = EncoderNamedPreset("H265SingleBitrate4K")
/// Produces an MP4 file where the video is encoded with H.265 codec at 1800 kbps and a picture height of 720 pixels, and the stereo audio is encoded with AAC-LC codec at 128 kbps.
pub const ENCODER_NAMED_PRESET_H265_SINGLE_BITRATE720P: EncoderNamedPreset = EncoderNamedPreset("H265SingleBitrate720p")

/// The values of EncoderNamedPreset this version knows; the service may send others.
pub fn possible_encoder_named_preset_values() -> List[EncoderNamedPreset] {
  [ENCODER_NAMED_PRESET_AAC_GOOD_QUALITY_AUDIO, ENCODER_NAMED_PRESET_ADAPTIVE_STREAMING, ENCODER_NAMED_PRESET_CONTENT_AWARE_ENCODING, ENCODER_NAMED_PRESET_CONTENT_AWARE_ENCODING_EXPERIMENTAL, ENCODER_NAMED_PRESET_COPY_ALL_BITRATE_NON_INTERLEAVED, ENCODER_NAMED_PRESET_DD_GOOD_QUALITY_AUDIO, ENCODER_NAMED_PRESET_H264_MULTIPLE_BITRATE1080P, ENCODER_NAMED_PRESET_H264_MULTIPLE_BITRATE720P, ENCODER_NAMED_PRESET_H264_MULTIPLE_BITRATE_SD, ENCODER_NAMED_PRESET_H264_SINGLE_BITRATE1080P, ENCODER_NAMED_PRESET_H264_SINGLE_BITRATE720P, ENCODER_NAMED_PRESET_H264_SINGLE_BITRATE_SD, ENCODER_NAMED_PRESET_H265_ADAPTIVE_STREAMING, ENCODER_NAMED_PRESET_H265_CONTENT_AWARE_ENCODING, ENCODER_NAMED_PRESET_H265_SINGLE_BITRATE1080P, ENCODER_NAMED_PRESET_H265_SINGLE_BITRATE4_K, ENCODER_NAMED_PRESET_H265_SINGLE_BITRATE720P]
}

/// The field parity for de-interlacing, defaults to Auto.
pub type DeinterlaceParity struct(Str)
/// Automatically detect the order of fields
pub const DEINTERLACE_PARITY_AUTO: DeinterlaceParity = DeinterlaceParity("Auto")
/// Apply bottom field first processing of input video.
pub const DEINTERLACE_PARITY_BOTTOM_FIELD_FIRST: DeinterlaceParity = DeinterlaceParity("BottomFieldFirst")
/// Apply top field first processing of input video.
pub const DEINTERLACE_PARITY_TOP_FIELD_FIRST: DeinterlaceParity = DeinterlaceParity("TopFieldFirst")

/// The values of DeinterlaceParity this version knows; the service may send others.
pub fn possible_deinterlace_parity_values() -> List[DeinterlaceParity] {
  [DEINTERLACE_PARITY_AUTO, DEINTERLACE_PARITY_BOTTOM_FIELD_FIRST, DEINTERLACE_PARITY_TOP_FIELD_FIRST]
}

/// The deinterlacing mode. Defaults to AutoPixelAdaptive.
pub type DeinterlaceMode struct(Str)
/// Apply automatic pixel adaptive de-interlacing on each frame in the input video.
pub const DEINTERLACE_MODE_AUTO_PIXEL_ADAPTIVE: DeinterlaceMode = DeinterlaceMode("AutoPixelAdaptive")
/// Disables de-interlacing of the source video.
