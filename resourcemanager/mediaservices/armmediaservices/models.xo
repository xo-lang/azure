/// Tells the encoder to use settings that are optimized for faster encoding. Quality is sacrificed to decrease encoding time.
pub const H265_COMPLEXITY_SPEED: H265Complexity = H265Complexity("Speed")

/// The values of H265Complexity this version knows; the service may send others.
pub fn possible_h265_complexity_values() -> List[H265Complexity] {
  [H265_COMPLEXITY_BALANCED, H265_COMPLEXITY_QUALITY, H265_COMPLEXITY_SPEED]
}

