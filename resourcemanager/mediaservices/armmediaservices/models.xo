/// Defines the type of insights that you want the service to generate. The allowed values are 'AudioInsightsOnly', 'VideoInsightsOnly', and 'AllInsights'. The default is AllInsights. If you set this to AllInsights and the input is audio only, then only audio insights are generated. Similarly if the input is video only, then only video insights are generated. It is recommended that you not use AudioInsightsOnly if you expect some of your inputs to be video only; or use VideoInsightsOnly if you expect some of your inputs to be audio only. Your Jobs in such conditions would error out.
pub type InsightsType struct(Str)
/// Generate both audio and video insights. Fails if either audio or video Insights fail.
pub const INSIGHTS_TYPE_ALL_INSIGHTS: InsightsType = InsightsType("AllInsights")
/// Generate audio only insights. Ignore video even if present. Fails if no audio is present.
pub const INSIGHTS_TYPE_AUDIO_INSIGHTS_ONLY: InsightsType = InsightsType("AudioInsightsOnly")
/// Generate video only insights. Ignore audio if present. Fails if no video is present.
pub const INSIGHTS_TYPE_VIDEO_INSIGHTS_ONLY: InsightsType = InsightsType("VideoInsightsOnly")

/// The values of InsightsType this version knows; the service may send others.
pub fn possible_insights_type_values() -> List[InsightsType] {
  [INSIGHTS_TYPE_ALL_INSIGHTS, INSIGHTS_TYPE_AUDIO_INSIGHTS_ONLY, INSIGHTS_TYPE_VIDEO_INSIGHTS_ONLY]
}

/// The current state of the job.
pub type JobState struct(Str)
/// The job was canceled. This is a final state for the job.
pub const JOB_STATE_CANCELED: JobState = JobState("Canceled")
/// The job is in the process of being canceled. This is a transient state for the job.
pub const JOB_STATE_CANCELING: JobState = JobState("Canceling")
/// The job has encountered an error. This is a final state for the job.
pub const JOB_STATE_ERROR: JobState = JobState("Error")
/// The job is finished. This is a final state for the job.
pub const JOB_STATE_FINISHED: JobState = JobState("Finished")
/// The job is processing. This is a transient state for the job.
pub const JOB_STATE_PROCESSING: JobState = JobState("Processing")
/// The job is in a queued state, waiting for resources to become available. This is a transient state.
pub const JOB_STATE_QUEUED: JobState = JobState("Queued")
/// The job is being scheduled to run on an available resource. This is a transient state, between queued and processing states.
pub const JOB_STATE_SCHEDULED: JobState = JobState("Scheduled")

/// The values of JobState this version knows; the service may send others.
pub fn possible_job_state_values() -> List[JobState] {
  [JOB_STATE_CANCELED, JOB_STATE_CANCELING, JOB_STATE_ERROR, JOB_STATE_FINISHED, JOB_STATE_PROCESSING, JOB_STATE_QUEUED, JOB_STATE_SCHEDULED]
}

