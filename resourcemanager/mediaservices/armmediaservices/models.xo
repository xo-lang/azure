pub const COMPLEXITY_QUALITY: Complexity = Complexity("Quality")
/// Configures the encoder to use settings optimized for faster encoding. Quality is sacrificed to decrease encoding time.
pub const COMPLEXITY_SPEED: Complexity = Complexity("Speed")

/// The values of Complexity this version knows; the service may send others.
pub fn possible_complexity_values() -> List[Complexity] {
  [COMPLEXITY_BALANCED, COMPLEXITY_QUALITY, COMPLEXITY_SPEED]
}

