test "Go's SavingsPlanClient.NewListAllPager" {
  let f = gv_new_fake(os.net)
  let c = new_savings_plan_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"additionalProperties\":[{\"name\":\"s-name\",\"value\":{\"cancelledCount\":1.5,\"expiredCount\":1.5,\"expiringCount\":1.5,\"failedCount\":1.5,\"noBenefitCount\":1.5,\"pendingCount\":1.5,\"processingCount\":1.5,\"succeededCount\":1.5,\"warningCount\":1.5}}],\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"appliedScopeProperties\":{\"displayName\":\"s-displayname\",\"managementGroupId\":\"s-managementgroupid\",\"resourceGroupId\":\"s-resourcegroupid\",\"subscriptionId\":\"s-subscriptionid\",\"tenantId\":\"s-tenantid\"},\"appliedScopeType\":\"s-appliedscopetype\",\"benefitStartTime\":\"2026-11-06T10:00:00Z\",\"billingAccountId\":\"s-billingaccountid\",\"billingPlan\":\"s-billingplan\",\"billingProfileId\":\"s-billingprofileid\",\"billingScopeId\":\"s-billingscopeid\",\"commitment\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\",\"grain\":\"s-grain\"},\"customerId\":\"s-customerid\",\"displayName\":\"s-displayname\",\"displayProvisioningState\":\"s-displayprovisioningstate\",\"effectiveDateTime\":\"2026-11-06T10:00:00Z\",\"expiryDateTime\":\"2026-11-06T10:00:00Z\",\"extendedStatusInfo\":{\"message\":\"s-message\",\"statusCode\":\"s-statuscode\"},\"provisioningState\":\"Succeeded\",\"purchaseDateTime\":\"2026-11-06T10:00:00Z\",\"renew\":true,\"renewDestination\":\"s-renewdestination\",\"renewProperties\":{\"purchaseProperties\":{\"properties\":{\"appliedScopeType\":\"s-appliedscopetype\",\"billingPlan\":\"s-billingplan\",\"billingScopeId\":\"s-billingscopeid\",\"displayName\":\"s-displayname\",\"effectiveDateTime\":\"2026-11-06T10:00:00Z\",\"renew\":true,\"term\":\"s-term\"},\"sku\":{\"name\":\"s-name\"}}},\"renewSource\":\"s-renewsource\",\"term\":\"s-term\",\"userFriendlyAppliedScopeType\":\"s-userfriendlyappliedscopetype\",\"utilization\":{\"aggregates\":[{\"grain\":1.5,\"grainUnit\":\"s-grainunit\",\"value\":1.5,\"valueUnit\":\"s-valueunit\"}],\"trend\":\"s-trend\"}},\"sku\":{\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SavingsPlanClient.NewListAllPager")
  var pg = c.new_list_all_pager(SavingsPlanClientListAllOptions{filter: Some("s-filter"), orderby: Some("s-orderby"), refresh_summary: Some("s-refreshsummary"), selected_state: Some("s-selectedstate"), skiptoken: Some(1.5), take: Some(1.5)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_savings_plan_client_list_all_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_5)
}

fn show_savings_plan_client_list_response(r: SavingsPlanClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.savings_plan_model_list).to_str_lossy()}")
  parts.join(" ")
}

