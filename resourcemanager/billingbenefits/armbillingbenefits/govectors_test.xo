test "Go's SavingsPlanOrderClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_savings_plan_order_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"benefitStartTime\":\"2026-11-06T10:00:00Z\",\"billingAccountId\":\"s-billingaccountid\",\"billingPlan\":\"s-billingplan\",\"billingProfileId\":\"s-billingprofileid\",\"billingScopeId\":\"s-billingscopeid\",\"customerId\":\"s-customerid\",\"displayName\":\"s-displayname\",\"expiryDateTime\":\"2026-11-06T10:00:00Z\",\"extendedStatusInfo\":{\"message\":\"s-message\",\"statusCode\":\"s-statuscode\"},\"planInformation\":{\"nextPaymentDueDate\":\"2026-11-06\",\"pricingCurrencyTotal\":{\"amount\":1.5,\"currencyCode\":\"s-currencycode\"},\"startDate\":\"2026-11-06\",\"transactions\":[{\"billingAccount\":\"s-billingaccount\",\"dueDate\":\"2026-11-06\",\"paymentDate\":\"2026-11-06\",\"status\":\"s-status\"}]},\"provisioningState\":\"Succeeded\",\"savingsPlans\":[\"s-savingsplans\"],\"term\":\"s-term\"},\"sku\":{\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL SavingsPlanOrderClient.NewListPager")
  var pg = c.new_list_pager(SavingsPlanOrderClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_savings_plan_order_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_13)
}
