  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: b""})
}

/// Gets the SAS token associated with the specified Data Lake Analytics and Azure Storage account and container combination.
pub fn (c: StorageAccountsClient[fx]) new_list_sas_tokens_pager(resource_group_name: Str, account_name: Str, storage_account_name: Str, container_name: Str, options: StorageAccountsClientListSasTokensOptions = StorageAccountsClientListSasTokensOptions{}) -> runtime.Pager[StorageAccountsClientListSasTokensResponse, fx] ! azcore.CallErr {
  let req = c.list_sas_tokens_create_request(resource_group_name, account_name, storage_account_name, container_name, options)?
  Ok(runtime.new_pager(c.setup.pipeline, req, fn(r: http.Response) -> StorageAccountsClientListSasTokensResponse ! Str { storage_accounts_list_sas_tokens_handle(r) }, fn(r: StorageAccountsClientListSasTokensResponse) -> Str? { r.sas_token_information_list_result.next_link }).traced_as("StorageAccountsClientListSasTokensResponse"))
}
