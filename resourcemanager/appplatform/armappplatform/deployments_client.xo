fn (c: DeploymentsClient) start_jfr_create_request(resource_group_name: Str, service_name: Str, app_name: Str, deployment_name: Str, diagnostic_parameters: DiagnosticParameters, options: DeploymentsClientBeginStartJFROptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.AppPlatform/Spring/{serviceName}/apps/{appName}/deployments/{deploymentName}/startJFR"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter client.subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if service_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter serviceName cannot be empty"))
  }
  path = path.replace("{serviceName}", url.path_escape(service_name))
  if app_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter appName cannot be empty"))
  }
  path = path.replace("{appName}", url.path_escape(app_name))
  if deployment_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter deploymentName cannot be empty"))
  }
  path = path.replace("{deploymentName}", url.path_escape(deployment_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: runtime.marshal_json(diagnostic_parameters)})
}

/// Start JFR
pub fn (c: DeploymentsClient[fx]) begin_start_jfr(resource_group_name: Str, service_name: Str, app_name: Str, deployment_name: Str, diagnostic_parameters: DiagnosticParameters, options: DeploymentsClientBeginStartJFROptions = DeploymentsClientBeginStartJFROptions{}) -> runtime.Poller[DeploymentsClientStartJFRResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "DeploymentsClientStartJFRResponse", fn(r: http.Response) -> DeploymentsClientStartJFRResponse ! Str { deployments_start_jfr_handle(r) })
  }
  let req = c.start_jfr_create_request(resource_group_name, service_name, app_name, deployment_name, diagnostic_parameters, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "", "DeploymentsClientStartJFRResponse", fn(r: http.Response) -> DeploymentsClientStartJFRResponse ! Str { deployments_start_jfr_handle(r) })
