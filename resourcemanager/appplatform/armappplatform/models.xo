fn custom_persistent_disk_properties_classification_json(c: CustomPersistentDiskPropertiesClassification) -> json.Value {
  match c {
    CustomPersistentDiskPropertiesClassification.AzureFileVolume(x) => json.to_value(x)
    CustomPersistentDiskPropertiesClassification.CustomPersistentDiskProperties(x) => json.to_value(x)
  }
}

fn parse_custom_persistent_disk_properties_classification(v: json.Value) -> CustomPersistentDiskPropertiesClassification ! json.DecodeErr {
  match v.get("type") {
    Some(json.Value.Str("AzureFileVolume")) => Ok(CustomPersistentDiskPropertiesClassification.AzureFileVolume(json.from_value[AzureFileVolume](v)?))
    _ => Ok(CustomPersistentDiskPropertiesClassification.CustomPersistentDiskProperties(json.from_value[CustomPersistentDiskProperties](v)?))
  }
}

/// StoragePropertiesClassification: a StorageProperties by its storageType, Go's StoragePropertiesClassification interface.
