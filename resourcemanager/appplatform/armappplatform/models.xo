/// ContainerRegistryCredentialsClassification: a ContainerRegistryCredentials by its type, Go's ContainerRegistryCredentialsClassification interface.
pub enum ContainerRegistryCredentialsClassification {
  /// type "BasicAuth"
  ContainerRegistryBasicCredentials(from ContainerRegistryBasicCredentials)
  /// Any other type, as the base type.
  ContainerRegistryCredentials(from ContainerRegistryCredentials)
} derive Json(via: json.Value, to: container_registry_credentials_classification_json, from: parse_container_registry_credentials_classification)

fn container_registry_credentials_classification_json(c: ContainerRegistryCredentialsClassification) -> json.Value {
  match c {
    ContainerRegistryCredentialsClassification.ContainerRegistryBasicCredentials(x) => json.to_value(x)
    ContainerRegistryCredentialsClassification.ContainerRegistryCredentials(x) => json.to_value(x)
  }
}

fn parse_container_registry_credentials_classification(v: json.Value) -> ContainerRegistryCredentialsClassification ! json.DecodeErr {
  match v.get("type") {
    Some(json.Value.Str("BasicAuth")) => Ok(ContainerRegistryCredentialsClassification.ContainerRegistryBasicCredentials(json.from_value[ContainerRegistryBasicCredentials](v)?))
    _ => Ok(ContainerRegistryCredentialsClassification.ContainerRegistryCredentials(json.from_value[ContainerRegistryCredentials](v)?))
  }
}

/// CustomPersistentDiskPropertiesClassification: a CustomPersistentDiskProperties by its type, Go's CustomPersistentDiskPropertiesClassification interface.
pub enum CustomPersistentDiskPropertiesClassification {
  /// type "AzureFileVolume"
  AzureFileVolume(from AzureFileVolume)
  /// Any other type, as the base type.
  CustomPersistentDiskProperties(from CustomPersistentDiskProperties)
