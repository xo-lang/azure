  let f = gv_new_fake(os.net)
  let c = new_gateways_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"apiMetadataProperties\":{\"description\":\"s-description\",\"documentation\":\"s-documentation\",\"serverUrl\":\"s-serverurl\",\"title\":\"s-title\",\"version\":\"s-version\"},\"apms\":[{\"resourceId\":\"s-resourceid\"}],\"clientAuth\":{\"certificateVerification\":\"s-certificateverification\",\"certificates\":[\"s-certificates\"]},\"corsProperties\":{\"allowCredentials\":true,\"allowedHeaders\":[\"s-allowedheaders\"],\"allowedMethods\":[\"s-allowedmethods\"],\"allowedOriginPatterns\":[\"s-allowedoriginpatterns\"],\"allowedOrigins\":[\"s-allowedorigins\"],\"exposedHeaders\":[\"s-exposedheaders\"],\"maxAge\":7},\"environmentVariables\":{\"properties\":{\"k1\":\"s-properties\"},\"secrets\":{\"k1\":\"s-secrets\"}},\"httpsOnly\":true,\"instances\":[{\"name\":\"s-name\",\"status\":\"s-status\"}],\"operatorProperties\":{\"instances\":[{\"name\":\"s-name\",\"status\":\"s-status\"}],\"resourceRequests\":{\"cpu\":\"s-cpu\",\"instanceCount\":7,\"memory\":\"s-memory\"}},\"provisioningState\":\"Succeeded\",\"public\":true,\"resourceRequests\":{\"cpu\":\"s-cpu\",\"memory\":\"s-memory\"},\"ssoProperties\":{\"clientId\":\"s-clientid\",\"clientSecret\":\"s-clientsecret\",\"issuerUri\":\"s-issueruri\",\"scope\":[\"s-scope\"]},\"url\":\"s-url\"},\"sku\":{\"capacity\":7,\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL GatewaysClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", GatewaysClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_gateways_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_125)
}

