test "Go's CustomizedAcceleratorsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_customized_accelerators_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"acceleratorTags\":[\"s-acceleratortags\"],\"acceleratorType\":\"s-acceleratortype\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"gitRepository\":{\"authSetting\":{\"authType\":\"BasicAuth\",\"caCertResourceId\":\"s-cacertresourceid\",\"password\":\"s-password\",\"username\":\"s-username\"},\"branch\":\"s-branch\",\"commit\":\"s-commit\",\"gitTag\":\"s-gittag\",\"intervalInSeconds\":7,\"subPath\":\"s-subpath\",\"url\":\"s-url\"},\"iconUrl\":\"s-iconurl\",\"imports\":[\"s-imports\"],\"provisioningState\":\"Succeeded\"},\"sku\":{\"capacity\":7,\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL CustomizedAcceleratorsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", CustomizedAcceleratorsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_customized_accelerators_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_91)
}

