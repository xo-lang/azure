  let f = gv_new_fake(os.net)
  let c = new_services_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"fqdn\":\"s-fqdn\",\"marketplaceResource\":{\"plan\":\"s-plan\",\"product\":\"s-product\",\"publisher\":\"s-publisher\"},\"networkProfile\":{\"appNetworkResourceGroup\":\"s-appnetworkresourcegroup\",\"appSubnetId\":\"s-appsubnetid\",\"ingressConfig\":{\"readTimeoutInSeconds\":7},\"outboundIPs\":{\"publicIPs\":[\"s-publicips\"]},\"outboundType\":\"s-outboundtype\",\"requiredTraffics\":[{\"direction\":\"s-direction\",\"port\":7,\"protocol\":\"s-protocol\"}],\"serviceCidr\":\"s-servicecidr\",\"serviceRuntimeNetworkResourceGroup\":\"s-serviceruntimenetworkresourcegroup\",\"serviceRuntimeSubnetId\":\"s-serviceruntimesubnetid\"},\"powerState\":\"s-powerstate\",\"provisioningState\":\"Succeeded\",\"serviceId\":\"s-serviceid\",\"version\":7,\"vnetAddons\":{\"dataPlanePublicEndpoint\":true,\"logStreamPublicEndpoint\":true},\"zoneRedundant\":true},\"sku\":{\"capacity\":7,\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ServicesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(ServicesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_services_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_155)
}

