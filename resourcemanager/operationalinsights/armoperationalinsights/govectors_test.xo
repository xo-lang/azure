  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"createdDate\":\"2026-11-06T10:00:00Z\",\"customerId\":\"s-customerid\",\"defaultDataCollectionRuleResourceId\":\"s-defaultdatacollectionruleresourceid\",\"failover\":{\"lastModifiedDate\":\"2026-11-06T10:00:00Z\",\"state\":\"s-state\"},\"features\":{\"associations\":[\"s-associations\"],\"clusterResourceId\":\"s-clusterresourceid\",\"disableLocalAuth\":true,\"enableDataExport\":true,\"enableLogAccessUsingOnlyResourcePermissions\":true,\"immediatePurgeDataOn30Days\":true,\"k1\":{\"k\":\"v\"},\"unifiedSentinelBillingOnly\":true},\"forceCmkForQuery\":true,\"modifiedDate\":\"2026-11-06T10:00:00Z\",\"privateLinkScopedResources\":[{\"resourceId\":\"s-resourceid\",\"scopeId\":\"s-scopeid\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccessForIngestion\":\"s-publicnetworkaccessforingestion\",\"publicNetworkAccessForQuery\":\"s-publicnetworkaccessforquery\",\"replication\":{\"createdDate\":\"2026-11-06T10:00:00Z\",\"enabled\":true,\"lastModifiedDate\":\"2026-11-06T10:00:00Z\",\"location\":\"s-location\",\"provisioningState\":\"Succeeded\"},\"retentionInDays\":7,\"sku\":{\"capacityReservationLevel\":7,\"lastSkuUpdate\":\"2026-11-06T10:00:00Z\",\"name\":\"s-name\"},\"workspaceCapping\":{\"dailyQuotaGb\":1.5,\"dataIngestionStatus\":\"s-dataingestionstatus\",\"quotaNextResetTime\":\"s-quotanextresettime\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkspacesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", WorkspacesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
