tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DeletedWorkspacesClient.NewListPager")
  var pg = c.new_list_pager(DeletedWorkspacesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
