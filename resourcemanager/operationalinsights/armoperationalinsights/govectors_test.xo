test "Go's ClustersClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_clusters_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"associatedWorkspaces\":[{\"associateDate\":\"2026-11-06T10:00:00Z\",\"resourceId\":\"s-resourceid\",\"workspaceId\":\"s-workspaceid\",\"workspaceName\":\"s-workspacename\"}],\"billingType\":\"s-billingtype\",\"capacityReservationProperties\":{\"lastSkuUpdate\":\"2026-11-06T10:00:00Z\",\"minCapacity\":7},\"clusterId\":\"s-clusterid\",\"createdDate\":\"2026-11-06T10:00:00Z\",\"isAvailabilityZonesEnabled\":true,\"isDoubleEncryptionEnabled\":true,\"keyVaultProperties\":{\"keyName\":\"s-keyname\",\"keyRsaSize\":7,\"keyVaultUri\":\"s-keyvaulturi\",\"keyVersion\":\"s-keyversion\"},\"lastModifiedDate\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"replication\":{\"createdDate\":\"2026-11-06T10:00:00Z\",\"enabled\":true,\"isAvailabilityZonesEnabled\":true,\"lastModifiedDate\":\"2026-11-06T10:00:00Z\",\"location\":\"s-location\",\"provisioningState\":\"Succeeded\"}},\"sku\":{\"capacity\":7,\"name\":\"s-name\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ClustersClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ClustersClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_clusters_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_5)
}

