/// ClusterSKUPatch: ClusterSKU in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct ClusterSKUPatch {
  /// The capacity reservation level in Gigabytes for this cluster.
  pub capacity as "capacity,omitempty": json.Patch[Int] = json.Patch.Absent
  /// The SKU (tier) of a cluster.
  pub name as "name,omitempty": json.Patch[ClusterSKUNameEnum] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: ClusterSKU) patch() -> ClusterSKUPatch {
  ClusterSKUPatch{
    capacity: match m.capacity {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    name: match m.name {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}

