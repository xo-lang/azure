/// `v` with `extra`'s keys added (over a field's of the same name), as
/// Go's MarshalJSON writes AdditionalProperties (its keys sorted).
fn with_additional(v: json.Value, extra: Map[Str, json.Value]?) -> json.Value {
  let m = extra ?? return v
  match v {
    json.Value.Object(fs) => {
      var all = fs.filter(fn(f: (Str, json.Value)) -> Bool { !m.contains(f.0) })
      for (k, x) in m {
        all.push((k, x))
      }
      json.Value.Object(all.sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    }
    other => other
  }
}

/// The keys of `v` no field names (Go's AdditionalProperties); None
/// when there are none.
fn additional_of(v: json.Value, known: List[Str]) -> Map[Str, json.Value]? {
  match v {
    json.Value.Object(fs) => {
      var m: Map[Str, json.Value] = {}
      for (k, x) in fs {
        if !known.contains(k) {
          m[k] = x
        }
      }
      if m.is_empty() { None } else { Some(m) }
    }
    _ => None
  }
}
