  match c.validate_estimate_high_availability("id1/ x", "id2/ x", (json.decode_str[HighAvailabilityValidationEstimation]("{\"estimatedDowntime\":7,\"expectedStandbyAvailabilityZone\":\"s-expectedstandbyavailabilityzone\",\"scheduledStandbyAvailabilityZone\":\"s-scheduledstandbyavailabilityzone\"}") ?? e => fault("${e}")), ServersClientValidateEstimateHighAvailabilityOptions{}) {
