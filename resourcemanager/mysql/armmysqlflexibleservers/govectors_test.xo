  let f = gv_new_fake(os.net)
  let c = new_servers_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"administratorLogin\":\"s-administratorlogin\",\"administratorLoginPassword\":\"s-administratorloginpassword\",\"availabilityZone\":\"s-availabilityzone\",\"backup\":{\"backupIntervalHours\":7,\"backupRetentionDays\":7,\"earliestRestoreDate\":\"2026-11-06T10:00:00Z\",\"geoRedundantBackup\":\"s-georedundantbackup\"},\"createMode\":\"s-createmode\",\"dataEncryption\":{\"geoBackupKeyURI\":\"s-geobackupkeyuri\",\"geoBackupUserAssignedIdentityId\":\"s-geobackupuserassignedidentityid\",\"primaryKeyURI\":\"s-primarykeyuri\",\"primaryUserAssignedIdentityId\":\"s-primaryuserassignedidentityid\",\"type\":\"s-type\"},\"databasePort\":7,\"fullVersion\":\"s-fullversion\",\"fullyQualifiedDomainName\":\"s-fullyqualifieddomainname\",\"highAvailability\":{\"mode\":\"s-mode\",\"standbyAvailabilityZone\":\"s-standbyavailabilityzone\",\"state\":\"s-state\"},\"importSourceProperties\":{\"dataDirPath\":\"s-datadirpath\",\"sasToken\":\"s-sastoken\",\"storageType\":\"s-storagetype\",\"storageUrl\":\"s-storageurl\"},\"maintenancePolicy\":{\"patchStrategy\":\"s-patchstrategy\"},\"maintenanceWindow\":{\"batchOfMaintenance\":\"s-batchofmaintenance\",\"customWindow\":\"s-customwindow\",\"dayOfWeek\":7,\"startHour\":7,\"startMinute\":7},\"network\":{\"delegatedSubnetResourceId\":\"s-delegatedsubnetresourceid\",\"privateDnsZoneResourceId\":\"s-privatednszoneresourceid\",\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"replicaCapacity\":7,\"replicationRole\":\"s-replicationrole\",\"restorePointInTime\":\"2026-11-06T10:00:00Z\",\"sourceServerResourceId\":\"s-sourceserverresourceid\",\"state\":\"s-state\",\"storage\":{\"autoGrow\":\"s-autogrow\",\"autoIoScaling\":\"s-autoioscaling\",\"iops\":7,\"logOnDisk\":\"s-logondisk\",\"storageRedundancy\":\"s-storageredundancy\",\"storageSizeGB\":7,\"storageSku\":\"s-storagesku\"},\"version\":\"s-version\"},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ServersClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ServersClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_servers_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_60)
}

fn show_servers_client_list_response(r: ServersClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.server_list_result).to_str_lossy()}")
  parts.join(" ")
}

