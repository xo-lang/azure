test "Go's CustomResourceProviderClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_custom_resource_provider_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"actions\":[{\"endpoint\":\"s-endpoint\",\"name\":\"s-name\",\"routingType\":\"s-routingtype\"}],\"provisioningState\":\"Succeeded\",\"resourceTypes\":[{\"endpoint\":\"s-endpoint\",\"name\":\"s-name\",\"routingType\":\"s-routingtype\"}],\"validations\":[{\"specification\":\"s-specification\",\"validationType\":\"s-validationtype\"}]},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL CustomResourceProviderClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(CustomResourceProviderClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_custom_resource_provider_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_8)
}

fn show_custom_resource_provider_client_update_response(r: CustomResourceProviderClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.custom_rp_manifest).to_str_lossy()}")
  parts.join(" ")
}

