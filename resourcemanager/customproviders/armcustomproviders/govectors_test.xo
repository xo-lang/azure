  gv_note(f, "CALL CustomResourceProviderClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[ResourceProvidersUpdate]("{\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), CustomResourceProviderClientUpdateOptions{}) {
