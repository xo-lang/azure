test "Go's AccountsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_accounts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"activeDirectories\":[{\"activeDirectoryId\":\"s-activedirectoryid\",\"adName\":\"s-adname\",\"administrators\":[\"s-administrators\"],\"aesEncryption\":true,\"allowLocalNfsUsersWithLdap\":true,\"backupOperators\":[\"s-backupoperators\"],\"dns\":\"s-dns\",\"domain\":\"s-domain\",\"encryptDCConnections\":true,\"kdcIP\":\"s-kdcip\",\"ldapOverTLS\":true,\"ldapSearchScope\":{\"groupDN\":\"s-groupdn\",\"groupMembershipFilter\":\"s-groupmembershipfilter\",\"userDN\":\"s-userdn\"},\"ldapSigning\":true,\"organizationalUnit\":\"s-organizationalunit\",\"password\":\"s-password\",\"preferredServersForLdapClient\":\"s-preferredserversforldapclient\",\"securityOperators\":[\"s-securityoperators\"],\"serverRootCACertificate\":\"s-serverrootcacertificate\",\"site\":\"s-site\",\"smbServerName\":\"s-smbservername\",\"status\":\"s-status\",\"statusDetails\":\"s-statusdetails\",\"username\":\"s-username\"}],\"disableShowmount\":true,\"encryption\":{\"identity\":{\"federatedClientId\":\"s-federatedclientid\",\"principalId\":\"s-principalid\",\"userAssignedIdentity\":\"s-userassignedidentity\"},\"keySource\":\"s-keysource\",\"keyVaultProperties\":{\"keyName\":\"s-keyname\",\"keyVaultId\":\"s-keyvaultid\",\"keyVaultResourceId\":\"s-keyvaultresourceid\",\"keyVaultUri\":\"s-keyvaulturi\",\"status\":\"s-status\"}},\"ldapConfiguration\":{\"bindAuthenticationLevel\":\"s-bindauthenticationlevel\",\"bindDN\":\"s-binddn\",\"bindPasswordAkvConfig\":{\"azureKeyVaultUri\":\"s-azurekeyvaulturi\",\"secretName\":\"s-secretname\",\"userAssignedIdentity\":\"s-userassignedidentity\"},\"certificateCNHost\":\"s-certificatecnhost\",\"dnsServers\":[\"s-dnsservers\"],\"domain\":\"s-domain\",\"groupDN\":\"s-groupdn\",\"ldapPort\":7,\"ldapServers\":[\"s-ldapservers\"],\"netGroupDN\":\"s-netgroupdn\",\"secureLdapType\":\"s-secureldaptype\",\"serverCACertificate\":\"s-servercacertificate\",\"userDN\":\"s-userdn\"},\"multiAdStatus\":\"s-multiadstatus\",\"nfsV4IDDomain\":\"s-nfsv4iddomain\",\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AccountsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", AccountsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_accounts_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_10)
}

