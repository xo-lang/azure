test "Go's BucketsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_buckets_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"akvDetails\":{\"certificateAkvDetails\":{\"certificateKeyVaultUri\":\"s-certificatekeyvaulturi\",\"certificateName\":\"s-certificatename\"},\"credentialsAkvDetails\":{\"credentialsKeyVaultUri\":\"s-credentialskeyvaulturi\",\"secretName\":\"s-secretname\"}},\"fileSystemUser\":{\"cifsUser\":{\"username\":\"s-username\"},\"nfsUser\":{\"groupId\":7,\"userId\":7}},\"path\":\"s-path\",\"permissions\":\"s-permissions\",\"provisioningState\":\"Succeeded\",\"server\":{\"certificateCommonName\":\"s-certificatecommonname\",\"certificateExpiryDate\":\"2026-11-06T10:00:00Z\",\"certificateObject\":\"s-certificateobject\",\"fqdn\":\"s-fqdn\",\"ipAddress\":\"s-ipaddress\",\"onCertificateConflictAction\":\"s-oncertificateconflictaction\"},\"status\":\"s-status\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BucketsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", BucketsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_buckets_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_38)
}

