test "Go's VolumesClient.BeginSplitCloneFromParent" {
  let f = gv_new_fake(os.net)
  let c = new_volumes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"acceptGrowCapacityPoolForShortTermCloneSplit\":\"s-acceptgrowcapacitypoolforshorttermclonesplit\",\"actualThroughputMibps\":1.5,\"avsDataStore\":\"s-avsdatastore\",\"backupId\":\"s-backupid\",\"baremetalTenantId\":\"s-baremetaltenantid\",\"breakthroughMode\":\"s-breakthroughmode\",\"capacityPoolResourceId\":\"s-capacitypoolresourceid\",\"cloneProgress\":7,\"coolAccess\":true,\"coolAccessRetrievalPolicy\":\"s-coolaccessretrievalpolicy\",\"coolAccessTieringPolicy\":\"s-coolaccesstieringpolicy\",\"coolnessPeriod\":7,\"creationToken\":\"s-creationtoken\",\"dataProtection\":{\"backup\":{\"backupPolicyId\":\"s-backuppolicyid\",\"backupVaultId\":\"s-backupvaultid\",\"policyEnforced\":true},\"ransomwareProtection\":{\"actualRansomwareProtectionState\":\"s-actualransomwareprotectionstate\",\"desiredRansomwareProtectionState\":\"s-desiredransomwareprotectionstate\"},\"replication\":{\"destinationReplications\":[{\"region\":\"s-region\",\"replicationType\":\"s-replicationtype\",\"resourceId\":\"s-resourceid\",\"zone\":\"s-zone\"}],\"endpointType\":\"s-endpointtype\",\"externalReplicationSetupInfo\":\"s-externalreplicationsetupinfo\",\"externalReplicationSetupStatus\":\"s-externalreplicationsetupstatus\",\"mirrorState\":\"s-mirrorstate\",\"relationshipStatus\":\"s-relationshipstatus\",\"remotePath\":{\"externalHostName\":\"s-externalhostname\",\"serverName\":\"s-servername\",\"volumeName\":\"s-volumename\"},\"remoteVolumeRegion\":\"s-remotevolumeregion\",\"remoteVolumeResourceId\":\"s-remotevolumeresourceid\",\"replicationId\":\"s-replicationid\",\"replicationSchedule\":\"s-replicationschedule\"},\"snapshot\":{\"snapshotPolicyId\":\"s-snapshotpolicyid\"},\"volumeRelocation\":{\"readyToBeFinalized\":true,\"relocationRequested\":true}},\"dataStoreResourceId\":[\"s-datastoreresourceid\"],\"defaultGroupQuotaInKiBs\":7,\"defaultUserQuotaInKiBs\":7,\"deleteBaseSnapshot\":true,\"effectiveNetworkFeatures\":\"s-effectivenetworkfeatures\",\"enableSubvolumes\":\"s-enablesubvolumes\",\"encrypted\":true,\"encryptionKeySource\":\"s-encryptionkeysource\",\"exportPolicy\":{\"rules\":[{\"allowedClients\":\"s-allowedclients\",\"chownMode\":\"s-chownmode\",\"cifs\":true,\"hasRootAccess\":true,\"kerberos5ReadOnly\":true,\"kerberos5ReadWrite\":true,\"kerberos5iReadOnly\":true,\"kerberos5iReadWrite\":true,\"kerberos5pReadOnly\":true,\"kerberos5pReadWrite\":true,\"nfsv3\":true,\"nfsv41\":true,\"ruleIndex\":7,\"unixReadOnly\":true,\"unixReadWrite\":true}]},\"fileAccessLogs\":\"s-fileaccesslogs\",\"fileSystemId\":\"s-filesystemid\",\"inheritedSizeInBytes\":7,\"isDefaultQuotaEnabled\":true,\"isLargeVolume\":true,\"isRestoring\":true,\"kerberosEnabled\":true,\"keyVaultPrivateEndpointResourceId\":\"s-keyvaultprivateendpointresourceid\",\"ldapEnabled\":true,\"maximumNumberOfFiles\":7,\"mountTargets\":[{\"fileSystemId\":\"s-filesystemid\",\"ipAddress\":\"s-ipaddress\",\"mountTargetId\":\"s-mounttargetid\",\"smbServerFqdn\":\"s-smbserverfqdn\"}],\"networkFeatures\":\"s-networkfeatures\",\"networkSiblingSetId\":\"s-networksiblingsetid\",\"originatingResourceId\":\"s-originatingresourceid\",\"placementRules\":[{\"key\":\"s-key\",\"value\":\"s-value\"}],\"protocolTypes\":[\"s-protocoltypes\"],\"provisionedAvailabilityZone\":\"s-provisionedavailabilityzone\",\"provisioningState\":\"Succeeded\",\"proximityPlacementGroup\":\"s-proximityplacementgroup\",\"securityStyle\":\"s-securitystyle\",\"serviceLevel\":\"s-servicelevel\",\"smbAccessBasedEnumeration\":\"s-smbaccessbasedenumeration\",\"smbContinuouslyAvailable\":true,\"smbEncryption\":true,\"smbNonBrowsable\":\"s-smbnonbrowsable\",\"snapshotDirectoryVisible\":true,\"snapshotId\":\"s-snapshotid\",\"storageToNetworkProximity\":\"s-storagetonetworkproximity\",\"subnetId\":\"s-subnetid\",\"t2Network\":\"s-t2network\",\"throughputMibps\":1.5,\"unixPermissions\":\"s-unixpermissions\",\"usageThreshold\":7,\"volumeGroupName\":\"s-volumegroupname\",\"volumeSpecName\":\"s-volumespecname\",\"volumeType\":\"s-volumetype\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}")
  gv_note(f, "CALL VolumesClient.BeginSplitCloneFromParent")
  match c.begin_split_clone_from_parent("id1/ x", "id2/ x", "id3/ x", "id4/ x", VolumesClientBeginSplitCloneFromParentOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_volumes_client_split_clone_from_parent_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_119)
}

fn show_volumes_client_update_response(r: VolumesClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.volume).to_str_lossy()}")
  parts.join(" ")
}

