test "Go's VolumeGroupsClient.NewListByNetAppAccountPager" {
  let f = gv_new_fake(os.net)
  let c = new_volume_groups_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"groupMetaData\":{\"applicationIdentifier\":\"s-applicationidentifier\",\"applicationType\":\"s-applicationtype\",\"globalPlacementRules\":[{\"key\":\"s-key\",\"value\":\"s-value\"}],\"groupDescription\":\"s-groupdescription\",\"volumesCount\":7},\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VolumeGroupsClient.NewListByNetAppAccountPager")
  var pg = c.new_list_by_net_app_account_pager("id1/ x", "id2/ x", VolumeGroupsClientListByNetAppAccountOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_volume_groups_client_list_by_net_app_account_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_91)
}

