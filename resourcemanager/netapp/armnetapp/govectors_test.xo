  }
  gv_compare(gv_log_of(f), GO_120)
}

fn show_volumes_client_get_response(r: VolumesClientGetResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.volume).to_str_lossy()}")
  parts.join(" ")
}

