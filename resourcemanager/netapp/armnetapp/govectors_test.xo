fn show_volumes_client_delete_response(r: VolumesClientDeleteResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_102: List[Str] = [
  "CALL VolumesClient.BeginDelete",
  "REQ DELETE https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.NetApp/netAppAccounts/id2%2F%20x/capacityPools/id3%2F%20x/volumes/id4%2F%20x?api-version=2026-08-01&forceDelete=true",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 202 ",
  "OUT: error: response is missing polling URL",
]

test "Go's VolumesClient.BeginDelete" {
  let f = gv_new_fake(os.net)
  let c = new_volumes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL VolumesClient.BeginDelete")
  match c.begin_delete("id1/ x", "id2/ x", "id3/ x", "id4/ x", VolumesClientBeginDeleteOptions{force_delete: Some(true)}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_volumes_client_delete_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
