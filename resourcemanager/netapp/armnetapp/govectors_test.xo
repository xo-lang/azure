// Generated from the output of a local Go program that calls every
// public method of each client of armnetapp v11.0.0 (azcore v1.23.3) by reflection,
// every argument and option filled, against a fake transport answering
// each operation's success status; do not edit (codegen/cmd/vectors). Each test
// makes the same call here and compares every request, the response
// served and the result.

use std/json
use github.com/xo-lang/azure/runtime

fn show_accounts_client_change_key_vault_response(r: AccountsClientChangeKeyVaultResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_0: List[Str] = [
  "CALL AccountsClient.BeginChangeKeyVault",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.NetApp/netAppAccounts/id2%2F%20x/changeKeyVault?api-version=2026-08-01",
  "  H authorization=Bearer tok | content-type=application/json",
  "  B {\"keyName\":\"s-keyname\",\"keyVaultPrivateEndpoints\":[{\"privateEndpointId\":\"s-privateendpointid\",\"virtualNetworkId\":\"s-virtualnetworkid\"}],\"keyVaultResourceId\":\"s-keyvaultresourceid\",\"keyVaultUri\":\"s-keyvaulturi\"}",
  "  SERVED 202 ",
  "OUT: error: response is missing polling URL",
]

test "Go's AccountsClient.BeginChangeKeyVault" {
  let f = gv_new_fake(os.net)
  let c = new_accounts_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL AccountsClient.BeginChangeKeyVault")
  match c.begin_change_key_vault("id1/ x", "id2/ x", AccountsClientBeginChangeKeyVaultOptions{body: Some((json.decode_str[ChangeKeyVault]("{\"keyName\":\"s-keyname\",\"keyVaultPrivateEndpoints\":[{\"privateEndpointId\":\"s-privateendpointid\",\"virtualNetworkId\":\"s-virtualnetworkid\"}],\"keyVaultResourceId\":\"s-keyvaultresourceid\",\"keyVaultUri\":\"s-keyvaulturi\"}") ?? e => fault("${e}")))}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_accounts_client_change_key_vault_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

fn show_accounts_client_create_or_update_response(r: AccountsClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.account).to_str_lossy()}")
  parts.join(" ")
}

