  let c = new_backup_policies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"backupPolicyId\":\"s-backuppolicyid\",\"dailyBackupsToKeep\":7,\"enabled\":true,\"monthlyBackupsToKeep\":7,\"provisioningState\":\"Succeeded\",\"volumeBackups\":[{\"backupsCount\":7,\"policyEnabled\":true,\"volumeName\":\"s-volumename\",\"volumeResourceId\":\"s-volumeresourceid\"}],\"volumesAssigned\":7,\"weeklyBackupsToKeep\":7},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BackupPoliciesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", BackupPoliciesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_backup_policies_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_15)
}

