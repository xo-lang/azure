/// While auto splitting the short term clone volume, if the parent pool does not have enough space to accommodate the volume after split, it will be automatically resized, which will lead to increased billing. To accept capacity pool size auto grow and create a short term clone volume, set the property as accepted.
pub type AcceptGrowCapacityPoolForShortTermCloneSplit struct(Str)
/// Auto grow capacity pool for short term clone split is accepted.
pub const ACCEPT_GROW_CAPACITY_POOL_FOR_SHORT_TERM_CLONE_SPLIT_ACCEPTED: AcceptGrowCapacityPoolForShortTermCloneSplit = AcceptGrowCapacityPoolForShortTermCloneSplit("Accepted")
/// Auto grow capacity pool for short term clone split is declined. Short term clone volume creation will not be allowed, to create short term clone volume accept auto grow capacity pool.
pub const ACCEPT_GROW_CAPACITY_POOL_FOR_SHORT_TERM_CLONE_SPLIT_DECLINED: AcceptGrowCapacityPoolForShortTermCloneSplit = AcceptGrowCapacityPoolForShortTermCloneSplit("Declined")

/// The values of AcceptGrowCapacityPoolForShortTermCloneSplit this version knows; the service may send others.
pub fn possible_accept_grow_capacity_pool_for_short_term_clone_split_values() -> List[AcceptGrowCapacityPoolForShortTermCloneSplit] {
  [ACCEPT_GROW_CAPACITY_POOL_FOR_SHORT_TERM_CLONE_SPLIT_ACCEPTED, ACCEPT_GROW_CAPACITY_POOL_FOR_SHORT_TERM_CLONE_SPLIT_DECLINED]
}

