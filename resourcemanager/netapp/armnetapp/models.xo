pub const EXTERNAL_REPLICATION_SETUP_STATUS_REPLICATION_CREATE_REQUIRED: ExternalReplicationSetupStatus = ExternalReplicationSetupStatus("ReplicationCreateRequired")
/// Need to call 'authorizeExternalReplication' and accept the returned 'vserver peer accept' command on your cluster to finish setting up the external replication
pub const EXTERNAL_REPLICATION_SETUP_STATUS_V_SERVER_PEER_REQUIRED: ExternalReplicationSetupStatus = ExternalReplicationSetupStatus("VServerPeerRequired")

