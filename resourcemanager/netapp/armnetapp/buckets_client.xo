/// This operation will fetch the certificate from Azure Key Vault and install it on the bucket server.
pub fn (c: BucketsClient[fx]) begin_refresh_certificate(resource_group_name: Str, account_name: Str, pool_name: Str, volume_name: Str, bucket_name: Str, options: BucketsClientBeginRefreshCertificateOptions = BucketsClientBeginRefreshCertificateOptions{}) -> runtime.Poller[BucketsClientRefreshCertificateResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
