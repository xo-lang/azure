/// Generate the access key and secret key used for accessing the specified volume bucket. Also return expiry date and time of key pair (in UTC).
pub fn (c: BucketsClient) generate_credentials(resource_group_name: Str, account_name: Str, pool_name: Str, volume_name: Str, bucket_name: Str, body: BucketCredentialsExpiry, options: BucketsClientGenerateCredentialsOptions = BucketsClientGenerateCredentialsOptions{}) -> BucketsClientGenerateCredentialsResponse ! azcore.CallErr uses (net.dial, clock, rand) {
