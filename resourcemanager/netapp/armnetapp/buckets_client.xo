  let req = c.refresh_certificate_create_request(resource_group_name, account_name, pool_name, volume_name, bucket_name, options) ?? e => return Err(sp.fail(e))
  let resp = c.setup.pipeline.send(sp.on(req)) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![202].contains(resp.status) {
    return Err(sp.close(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  sp.end()
  runtime.new_poller(c.setup.pipeline, req, resp, "azure-async-operation", "BucketsClientRefreshCertificateResponse", fn(r: http.Response) -> BucketsClientRefreshCertificateResponse ! Str { buckets_refresh_certificate_handle(r) }, traced: true)
