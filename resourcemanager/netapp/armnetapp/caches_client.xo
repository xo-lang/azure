    return Err(azcore.CallErr.InvalidInput("parameter cacheName cannot be empty"))
  }
  path = path.replace("{cacheName}", url.path_escape(cache_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: b""})
}

/// Resets the SMB password for the cache
pub fn (c: CachesClient[fx]) begin_reset_smb_password(resource_group_name: Str, account_name: Str, pool_name: Str, cache_name: Str, options: CachesClientBeginResetSmbPasswordOptions = CachesClientBeginResetSmbPasswordOptions{}) -> runtime.Poller[CachesClientResetSmbPasswordResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "CachesClientResetSmbPasswordResponse", fn(r: http.Response) -> CachesClientResetSmbPasswordResponse ! Str { caches_reset_smb_password_handle(r) })
  }
  let req = c.reset_smb_password_create_request(resource_group_name, account_name, pool_name, cache_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200, 202].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.setup.pipeline, req, resp, "", "CachesClientResetSmbPasswordResponse", fn(r: http.Response) -> CachesClientResetSmbPasswordResponse ! Str { caches_reset_smb_password_handle(r) })
}
