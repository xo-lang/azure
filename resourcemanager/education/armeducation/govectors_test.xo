test "Go's GrantsClient.NewListAllPager" {
  let f = gv_new_fake(os.net)
  let c = new_grants_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"allocatedBudget\":{\"currency\":\"s-currency\",\"value\":1.5},\"effectiveDate\":\"2026-11-06T10:00:00Z\",\"expirationDate\":\"2026-11-06T10:00:00Z\",\"offerCap\":{\"currency\":\"s-currency\",\"value\":1.5},\"offerType\":\"s-offertype\",\"status\":\"s-status\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL GrantsClient.NewListAllPager")
  var pg = c.new_list_all_pager(GrantsClientListAllOptions{include_allocated_budget: Some(true)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_grants_client_list_all_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_1)
}

