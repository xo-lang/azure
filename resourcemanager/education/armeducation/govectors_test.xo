  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"budgetPerStudent\":{\"currency\":\"s-currency\",\"value\":1.5},\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"effectiveDate\":\"2026-11-06T10:00:00Z\",\"expirationDate\":\"2026-11-06T10:00:00Z\",\"invitationCode\":\"s-invitationcode\",\"maxStudentCount\":1.5,\"status\":\"s-status\",\"totalAllocatedBudget\":{\"currency\":\"s-currency\",\"value\":1.5},\"totalBudget\":{\"currency\":\"s-currency\",\"value\":1.5}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL LabsClient.NewListPager")
