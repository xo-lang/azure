  pub default_management_group as "defaultManagementGroup,omitempty": Str? = None
  /// Indicates whether RBAC access is required upon group creation under the root Management Group. If set to true, user will require Microsoft.Management/managementGroups/write action on the root Management Group scope in order to create new Groups directly under the root. This will prevent new users from creating new Management Groups, unless they are given access.
  pub require_authorization_for_group_creation as "requireAuthorizationForGroupCreation,omitempty": Bool? = None
} derive Json

/// Parameters for creating or updating Management Group settings
pub struct CreateOrUpdateSettingsRequest {
  /// The properties of the request to create or update Management Group settings
  pub properties as "properties,omitempty": CreateOrUpdateSettingsProperties? = None
} derive Json

/// The generic properties of subscription under a management group.
pub struct SubscriptionUnderManagementGroupProperties {
  /// The friendly name of the subscription.
  pub display_name as "displayName,omitempty": Str? = None
  /// The ID of the parent management group.
  pub parent as "parent,omitempty": DescendantParentGroupInfo? = None
  /// The state of the subscription.
  pub state as "state,omitempty": Str? = None
  /// The AAD Tenant ID associated with the subscription. For example, 00000000-0000-0000-0000-000000000000
  pub tenant as "tenant,omitempty": Str? = None
} derive Json

/// The details of subscription under management group.
pub struct SubscriptionUnderManagementGroup {
  /// Fully qualified resource ID for the resource. Ex - /subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/{resourceProviderNamespace}/{resourceType}/{resourceName}
  pub id as "id,omitempty": Str? = None
  /// The name of the resource
  pub name as "name,omitempty": Str? = None
  /// The generic properties of subscription under a management group.
  pub properties as "properties,omitempty": SubscriptionUnderManagementGroupProperties? = None
  /// Azure Resource Manager metadata containing createdBy and modifiedBy information.
  pub system_data as "systemData,omitempty": SystemData? = None
  /// The type of the resource. E.g. "Microsoft.Compute/virtualMachines" or "Microsoft.Storage/storageAccounts"
  pub type_ as "type,omitempty": Str? = None
} derive Json

