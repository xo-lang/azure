/// Localized display information for this particular operation.
pub struct OperationDisplay {
  /// The short, localized friendly description of the operation; suitable for tool tips and detailed views.
  pub description as "description,omitempty": Str? = None
  /// The concise, localized friendly name for the operation; suitable for dropdowns. E.g. "Create or Update Virtual Machine", "Restart Virtual Machine".
  pub operation as "operation,omitempty": Str? = None
  /// The localized friendly form of the resource provider name, e.g. "Microsoft Monitoring Insights" or "Microsoft Compute".
  pub provider as "provider,omitempty": Str? = None
  /// The localized friendly name of the resource type related to this operation. E.g. "Virtual Machines" or "Job Schedule Collections".
  pub resource as "resource,omitempty": Str? = None
} derive Json

/// Details of a REST API operation, returned from the Resource Provider Operations API
pub struct Operation {
  /// Enum. Indicates the action type. "Internal" refers to actions that are for internal only APIs.
  pub action_type as "actionType,omitempty": ActionType? = None
  /// Localized display information for this particular operation.
  pub display as "display,omitempty": OperationDisplay? = None
  /// Whether the operation applies to data-plane. This is "true" for data-plane operations and "false" for ARM/control-plane operations.
  pub is_data_action as "isDataAction,omitempty": Bool? = None
  /// The name of the operation, as per Resource-Based Access Control (RBAC). Examples: "Microsoft.Compute/virtualMachines/write", "Microsoft.Compute/virtualMachines/capture/action"
  pub name as "name,omitempty": Str? = None
  /// The intended executor of the operation; as in Resource Based Access Control (RBAC) and audit logs UX. Default value is "user,system"
  pub origin as "origin,omitempty": Origin? = None
} derive Json

/// A list of REST API operations supported by an Azure Resource Provider. It contains an URL link to get the next set of results.
pub struct OperationListResult {
  /// URL to get the next set of operation list results (if there are any).
  pub next_link as "nextLink,omitempty": Str? = None
  /// List of operations supported by the resource provider
  pub value as "value,omitempty": List[Operation]? = None
} derive Json

/// The tenant backfill status
pub struct TenantBackfillStatusResult {
  /// The status of the Tenant Backfill
  pub status as "status,omitempty": Status? = None
  /// The AAD Tenant ID associated with the management group. For example, 00000000-0000-0000-0000-000000000000
  pub tenant_id as "tenantId,omitempty": Str? = None
} derive Json
