test "Go's EntitiesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_entities_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"count\":7,\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"displayName\":\"s-displayname\",\"inheritedPermissions\":\"s-inheritedpermissions\",\"numberOfChildGroups\":7,\"numberOfChildren\":7,\"numberOfDescendants\":7,\"parent\":{\"id\":\"s-id\"},\"parentDisplayNameChain\":[\"s-parentdisplaynamechain\"],\"parentNameChain\":[\"s-parentnamechain\"],\"permissions\":\"s-permissions\",\"tenantId\":\"s-tenantid\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EntitiesClient.NewListPager")
  var pg = c.new_list_pager(EntitiesClientListOptions{cache_control: Some("s-cachecontrol"), filter: Some("s-filter"), group_name: Some("s-groupname"), search: Some(EntitySearchType("s-search")), select_: Some("s-select"), skip: Some(7), skiptoken: Some("s-skiptoken"), top: Some(7), view: Some(EntityViewParameterType("s-view"))}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_entities_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_9)
}

