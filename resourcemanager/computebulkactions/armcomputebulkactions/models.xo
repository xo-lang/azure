/// Specifies additional XML formatted information that can be included in the Unattend.xml file, which is used by Windows Setup. Contents are defined by setting name, component name, and the pass in which the content is applied.
pub struct AdditionalUnattendContent {
  /// The component name. Currently, the only allowable value is Microsoft-Windows-Shell-Setup.
  pub component_name as "componentName,omitempty": Str? = None
  /// Specifies the XML formatted content that is added to the unattend.xml file for the specified path and component. The XML must be less than 4KB and must include the root element for the setting or feature that is being inserted.
  pub content as "content,omitempty": Str? = None
  /// The pass name. Currently, the only allowable value is OobeSystem.
  pub pass_name as "passName,omitempty": Str? = None
  /// Specifies the name of the setting to which the content applies. Possible values are: FirstLogonCommands and AutoLogon.
  pub setting_name as "settingName,omitempty": SettingNames? = None
} derive Json(via: json.Value, to: additional_unattend_content_json, from: parse_additional_unattend_content)

/// AdditionalUnattendContent's named fields, for its JSON.
struct AdditionalUnattendContentKnown {
  component_name as "componentName,omitempty": Str? = None
  content as "content,omitempty": Str? = None
  pass_name as "passName,omitempty": Str? = None
  setting_name as "settingName,omitempty": SettingNames? = None
} derive Json

fn additional_unattend_content_json(x: AdditionalUnattendContent) -> json.Value {
  let known = AdditionalUnattendContentKnown{
    component_name: x.component_name.map(fn(_: Str) -> Str { "Microsoft-Windows-Shell-Setup" }),
    content: x.content,
    pass_name: x.pass_name.map(fn(_: Str) -> Str { "OobeSystem" }),
    setting_name: x.setting_name,
  }
  json.to_value(known)
}

fn parse_additional_unattend_content(v: json.Value) -> AdditionalUnattendContent ! json.DecodeErr {
  let k = json.from_value[AdditionalUnattendContentKnown](v)?
  Ok(AdditionalUnattendContent{
    component_name: k.component_name,
    content: k.content,
    pass_name: k.pass_name,
    setting_name: k.setting_name,
  })
}

