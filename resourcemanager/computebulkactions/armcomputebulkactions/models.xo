  pub linux_configuration as "linuxConfiguration,omitempty": LinuxConfiguration? = None
  /// Optional property which must either be set to True or omitted.
  pub require_guest_provision_signal as "requireGuestProvisionSignal,omitempty": Bool? = None
  /// Specifies set of certificates that should be installed onto the virtual machine. To install certificates on a virtual machine it is recommended to use the [Azure Key Vault virtual machine extension for Linux](https://docs.microsoft.com/azure/virtual-machines/extensions/key-vault-linux) or the [Azure Key Vault virtual machine extension for Windows](https://docs.microsoft.com/azure/virtual-machines/extensions/key-vault-windows).
  pub secrets as "secrets,omitempty": List[VaultSecretGroup]? = None
  /// Specifies Windows operating system settings on the virtual machine.
