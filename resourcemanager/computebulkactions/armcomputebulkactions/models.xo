  pub assessment_mode as "assessmentMode,omitempty": WindowsPatchAssessmentMode? = None
  /// Specifies additional settings for patch mode AutomaticByPlatform in VM Guest Patching on Windows.
  pub automatic_by_platform_settings as "automaticByPlatformSettings,omitempty": WindowsVMGuestPatchAutomaticByPlatformSettings? = None
