pub const ZONE_DISTRIBUTION_STRATEGY_BEST_EFFORT_BALANCED: ZoneDistributionStrategy = ZoneDistributionStrategy("BestEffortBalanced")
/// Default. Launch instances in a single zone based on best effort.     If capacity is not available, LaunchBulkInstancesOperation can allocate capacity in different zones.
pub const ZONE_DISTRIBUTION_STRATEGY_BEST_EFFORT_SINGLE_ZONE: ZoneDistributionStrategy = ZoneDistributionStrategy("BestEffortSingleZone")
/// Launch instances based on zone preferences.     Higher priority zones are filled first before allocating to lower priority zones.
pub const ZONE_DISTRIBUTION_STRATEGY_PRIORITIZED: ZoneDistributionStrategy = ZoneDistributionStrategy("Prioritized")
/// Launch instances across all provided zones, ensuring the difference between any two zones is no more than one instance.
pub const ZONE_DISTRIBUTION_STRATEGY_STRICT_BALANCED: ZoneDistributionStrategy = ZoneDistributionStrategy("StrictBalanced")

/// The values of ZoneDistributionStrategy this version knows; the service may send others.
pub fn possible_zone_distribution_strategy_values() -> List[ZoneDistributionStrategy] {
