test "Go's BulkActionsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_bulk_actions_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"name\":\"s-name\",\"plan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"promotionCode\":\"s-promotioncode\",\"publisher\":\"s-publisher\",\"version\":\"s-version\"},\"properties\":{\"capacity\":7,\"capacityType\":\"s-capacitytype\",\"computeProfile\":{\"computeApiVersion\":\"s-computeapiversion\",\"extensions\":[{\"name\":\"s-name\"}],\"virtualMachineProfile\":{\"additionalCapabilities\":{\"hibernationEnabled\":true,\"ultraSSDEnabled\":true},\"applicationProfile\":{},\"capacityReservation\":{},\"diagnosticsProfile\":{},\"extensionsTimeBudget\":\"s-extensionstimebudget\",\"licenseType\":\"s-licensetype\",\"networkProfile\":{\"networkApiVersion\":\"s-networkapiversion\"},\"osProfile\":{\"adminPassword\":\"s-adminpassword\",\"adminUsername\":\"s-adminusername\",\"allowExtensionOperations\":true,\"computerName\":\"s-computername\",\"customData\":\"s-customdata\",\"requireGuestProvisionSignal\":true},\"scheduledEventsPolicy\":{},\"scheduledEventsProfile\":{},\"securityProfile\":{\"encryptionAtHost\":true,\"securityType\":\"s-securitytype\"},\"storageProfile\":{\"diskControllerType\":\"s-diskcontrollertype\"},\"userData\":\"s-userdata\"}},\"priorityProfile\":{\"allocationStrategy\":\"s-allocationstrategy\",\"evictionPolicy\":\"s-evictionpolicy\",\"maxPricePerVM\":1.5,\"type\":\"s-type\"},\"provisioningState\":\"Succeeded\",\"retryPolicy\":{\"retryCount\":7,\"retryWindowInMinutes\":7},\"vmAttributes\":{\"acceleratorCount\":{\"max\":7,\"min\":7},\"acceleratorManufacturers\":[\"s-acceleratormanufacturers\"],\"acceleratorSupport\":\"s-acceleratorsupport\",\"acceleratorTypes\":[\"s-acceleratortypes\"],\"allowedVMSizes\":[\"s-allowedvmsizes\"],\"architectureTypes\":[\"s-architecturetypes\"],\"burstableSupport\":\"s-burstablesupport\",\"cpuManufacturers\":[\"s-cpumanufacturers\"],\"dataDiskCount\":{\"max\":7,\"min\":7},\"excludedVMSizes\":[\"s-excludedvmsizes\"],\"hyperVGenerations\":[\"s-hypervgenerations\"],\"localStorageDiskTypes\":[\"s-localstoragedisktypes\"],\"localStorageInGiB\":{\"max\":1.5,\"min\":1.5},\"localStorageSupport\":\"s-localstoragesupport\",\"memoryInGiB\":{\"max\":1.5,\"min\":1.5},\"memoryInGiBPerVCpu\":{\"max\":1.5,\"min\":1.5},\"networkBandwidthInMbps\":{\"max\":1.5,\"min\":1.5},\"networkInterfaceCount\":{\"max\":7,\"min\":7},\"rdmaNetworkInterfaceCount\":{\"max\":7,\"min\":7},\"rdmaSupport\":\"s-rdmasupport\",\"vCpuCount\":{\"max\":7,\"min\":7},\"vmCategories\":[\"s-vmcategories\"]},\"vmSizesProfile\":[{\"name\":\"s-name\",\"rank\":7}],\"zoneAllocationPolicy\":{\"distributionStrategy\":\"s-distributionstrategy\",\"zonePreferences\":[{\"rank\":7,\"zone\":\"s-zone\"}]}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\",\"zones\":[\"s-zones\"]}]}")
  gv_note(f, "CALL BulkActionsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", "id2/ x", BulkActionsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_bulk_actions_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_5)
}

fn show_bulk_actions_client_list_by_subscription_response(r: BulkActionsClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.launch_bulk_instances_operation_list_result).to_str_lossy()}")
  parts.join(" ")
}

