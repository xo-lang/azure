  gv_note(f, "CALL BulkActionsClient.BeginDelete")
  match c.begin_delete("id1/ x", "id2/ x", "id3/ x", BulkActionsClientBeginDeleteOptions{delete_instances: Some(true)}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_bulk_actions_client_delete_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_2)
}

