  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if virtual_enclave_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter virtualEnclaveName cannot be empty"))
  }
  path = path.replace("{virtualEnclaveName}", url.path_escape(virtual_enclave_name))
  if enclave_endpoint_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter enclaveEndpointName cannot be empty"))
  }
  path = path.replace("{enclaveEndpointName}", url.path_escape(enclave_endpoint_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: runtime.marshal_json(body)})
}

/// Callback that triggers on approval deletion state change.
pub fn (c: EndpointsClient[fx]) begin_handle_approval_deletion(resource_group_name: Str, virtual_enclave_name: Str, enclave_endpoint_name: Str, body: ApprovalDeletionCallbackRequest, options: EndpointsClientBeginHandleApprovalDeletionOptions = EndpointsClientBeginHandleApprovalDeletionOptions{}) -> runtime.Poller[EndpointsClientHandleApprovalDeletionResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "EndpointsClientHandleApprovalDeletionResponse", fn(r: http.Response) -> EndpointsClientHandleApprovalDeletionResponse ! Str { endpoints_handle_approval_deletion_handle(r) }, traced: true)
  }
  let sp = runtime.start_span({}, "EndpointsClient.BeginHandleApprovalDeletion", c.setup.pipeline.tracer)
  let req = c.handle_approval_deletion_create_request(resource_group_name, virtual_enclave_name, enclave_endpoint_name, body, options) ?? e => return Err(sp.fail(e))
  let resp = c.setup.pipeline.send(sp.on(req)) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![200, 202].contains(resp.status) {
    return Err(sp.close(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  sp.end()
  runtime.new_poller(c.setup.pipeline, req, resp, "", "EndpointsClientHandleApprovalDeletionResponse", fn(r: http.Response) -> EndpointsClientHandleApprovalDeletionResponse ! Str { endpoints_handle_approval_deletion_handle(r) }, traced: true)
}
