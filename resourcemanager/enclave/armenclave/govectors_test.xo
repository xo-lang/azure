test "Go's CommunityClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_community_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"addressSpace\":\"s-addressspace\",\"addressSpaces\":[\"s-addressspaces\"],\"approvalSettings\":{\"communityEndpointUpdate\":{\"approvalPolicy\":\"s-approvalpolicy\",\"minimumApproversRequired\":7},\"communityMaintenanceMode\":{\"approvalPolicy\":\"s-approvalpolicy\",\"minimumApproversRequired\":7},\"connectionCreation\":{\"approvalPolicy\":\"s-approvalpolicy\",\"minimumApproversRequired\":7},\"connectionUpdate\":{\"approvalPolicy\":\"s-approvalpolicy\",\"minimumApproversRequired\":7},\"enclaveCreation\":{\"approvalPolicy\":\"s-approvalpolicy\",\"minimumApproversRequired\":7},\"enclaveEndpointUpdate\":{\"approvalPolicy\":\"s-approvalpolicy\",\"minimumApproversRequired\":7},\"enclaveMaintenanceMode\":{\"approvalPolicy\":\"s-approvalpolicy\",\"minimumApproversRequired\":7}},\"communityRoleAssignments\":[{\"condition\":\"s-condition\",\"roleDefinitionId\":\"s-roledefinitionid\"}],\"dedicatedHubList\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"designation\":\"s-designation\",\"firewallPolicyResourceId\":\"s-firewallpolicyresourceid\",\"firewallResourceId\":\"s-firewallresourceid\",\"provisioningState\":\"Succeeded\",\"vHubResourceId\":\"s-vhubresourceid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}],\"dnsServers\":[\"s-dnsservers\"],\"firewallSku\":\"s-firewallsku\",\"governedServiceList\":[{\"enforcement\":\"s-enforcement\",\"initiatives\":[\"s-initiatives\"],\"option\":\"s-option\",\"policyAction\":\"s-policyaction\",\"serviceId\":\"s-serviceid\",\"serviceName\":\"s-servicename\"}],\"maintenanceModeConfiguration\":{\"justification\":\"s-justification\",\"mode\":\"s-mode\",\"principals\":[{\"id\":\"s-id\",\"type\":\"s-type\"}]},\"managedOnBehalfOfConfiguration\":{\"moboBrokerResources\":[{\"id\":\"s-id\"}]},\"managedResourceGroupName\":\"s-managedresourcegroupname\",\"monitoringSettings\":{\"diagnosticDestinations\":[{\"customWorkspaceResourceId\":\"s-customworkspaceresourceid\",\"destinationType\":\"s-destinationtype\",\"diagnosticSettingsName\":\"s-diagnosticsettingsname\"}],\"flowLogDestination\":{\"customWorkspaceResourceId\":\"s-customworkspaceresourceid\",\"destinationType\":\"s-destinationtype\",\"diagnosticSettingsName\":\"s-diagnosticsettingsname\"}},\"policyOverride\":\"s-policyoverride\",\"provisioningState\":\"Succeeded\",\"resourceCollection\":[\"s-resourcecollection\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL CommunityClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", CommunityClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_community_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_11)
}

fn show_community_client_list_by_subscription_response(r: CommunityClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.community_resource_list_result).to_str_lossy()}")
  parts.join(" ")
}

