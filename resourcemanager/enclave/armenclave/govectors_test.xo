ent\":\"s-enforcement\",\"initiatives\":[\"s-initiatives\"],\"option\":\"s-option\",\"policyAction\":\"s-policyaction\",\"serviceId\":\"s-serviceid\",\"serviceName\":\"s-servicename\"}],\"maintenanceModeConfiguration\":{\"justification\":\"s-justification\",\"mode\":\"s-mode\",\"principals\":[{\"id\":\"s-id\",\"type\":\"s-type\"}]},\"managedOnBehalfOfConfiguration\":{\"moboBrokerResources\":[{\"id\":\"s-id\"}]},\"managedResourceGroupName\":\"s-managedresourcegroupname\",\"monitoringSettings\":{\"diagnosticDestinations\":[{\"customWorkspaceResourceId\":\"s-customworkspaceresourceid\",\"destinationType\":\"s-destinationtype\",\"diagnosticSettingsName\":\"s-diagnosticsettingsname\"}],\"flowLogDestination\":{\"customWorkspaceResourceId\":\"s-customworkspaceresourceid\",\"destinationType\":\"s-destinationtype\",\"diagnosticSettingsName\":\"s-diagnosticsettingsname\"}},\"policyOverride\":\"s-policyoverride\",\"provisioningState\":\"Succeeded\",\"resourceCollection\":[\"s-resourcecollection\"]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL CommunityClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(CommunityClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_community_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_12)
}

