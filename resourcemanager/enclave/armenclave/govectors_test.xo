test "Go's ApprovalClient.NewListByParentPager" {
  let f = gv_new_fake(os.net)
  let c = new_approval_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"approvedByEntraIds\":[\"s-approvedbyentraids\"],\"approvers\":[{\"actionPerformed\":\"s-actionperformed\",\"approverEntraId\":\"s-approverentraid\",\"lastUpdatedAt\":\"2026-11-06T10:00:00Z\",\"mandatoryApprovalGroupMembershipIds\":[\"s-mandatoryapprovalgroupmembershipids\"]}],\"approversApprovedCount\":7,\"createdAt\":\"2026-11-06T10:00:00Z\",\"grandparentResourceId\":\"s-grandparentresourceid\",\"mandatoryApprovers\":[{\"approverEntraId\":\"s-approverentraid\"}],\"mandatoryApproversApprovedCount\":7,\"minimumApproversRequired\":7,\"parentResourceId\":\"s-parentresourceid\",\"provisioningState\":\"Succeeded\",\"requestMetadata\":{\"approvalCallbackPayload\":\"s-approvalcallbackpayload\",\"approvalCallbackRoute\":\"s-approvalcallbackroute\",\"approvalStatus\":\"s-approvalstatus\",\"resourceAction\":\"s-resourceaction\"},\"stateChangedAt\":\"2026-11-06T10:00:00Z\",\"ticketId\":\"s-ticketid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ApprovalClient.NewListByParentPager")
  var pg = c.new_list_by_parent_pager("id1/ x", ApprovalClientListByParentOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_approval_client_list_by_parent_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_5)
}

fn show_community_client_create_or_update_response(r: CommunityClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.community_resource).to_str_lossy()}")
  parts.join(" ")
}

