fn show_community_client_delete_response(r: CommunityClientDeleteResponse) -> Str {
  var parts: List[Str] = []
  parts.join(" ")
}

const GO_7: List[Str] = [
  "CALL CommunityClient.BeginDelete",
  "REQ DELETE https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.Mission/communities/id2%2F%20x?api-version=2026-04-01",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 202 ",
  "OUT: error: response is missing polling URL",
]

test "Go's CommunityClient.BeginDelete" {
  let f = gv_new_fake(os.net)
  let c = new_community_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 202, "")
  gv_note(f, "CALL CommunityClient.BeginDelete")
  match c.begin_delete("id1/ x", "id2/ x", CommunityClientBeginDeleteOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_community_client_delete_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_7)
}

fn show_community_client_update_response(r: CommunityClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.community_resource).to_str_lossy()}")
  parts.join(" ")
}

