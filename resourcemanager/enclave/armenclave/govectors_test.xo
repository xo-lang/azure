  gv_note(f, "CALL VirtualEnclaveClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(VirtualEnclaveClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
