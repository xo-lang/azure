  /// Resumes the operation from a poller's resume_token instead of starting it.
  pub resume_token: Str = ""
}

/// CassandraClustersClientStartResponse: the response of CassandraClustersClient.begin_start.
pub struct CassandraClustersClientStartResponse {}

fn cassandra_clusters_start_handle(resp: http.Response) -> CassandraClustersClientStartResponse ! Str {
  Ok(CassandraClustersClientStartResponse{})
}

fn (c: CassandraClustersClient) start_create_request(resource_group_name: Str, cluster_name: Str, options: CassandraClustersClientBeginStartOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.DocumentDB/cassandraClusters/{clusterName}/start"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if cluster_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter clusterName cannot be empty"))
  }
  path = path.replace("{clusterName}", url.path_escape(cluster_name))
  var q = url.values()
  var headers: List[(Str, Str)] = []
  q.add("api-version", API_VERSION)
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: b""})
}

/// Start the Managed Cassandra Cluster and Associated Data Centers. Start will start the host virtual machine of this cluster with reserved data disk. This won't do anything on an already running cluster. Use Deallocate to deallocate the cluster.
pub fn (c: CassandraClustersClient[fx]) begin_start(resource_group_name: Str, cluster_name: Str, options: CassandraClustersClientBeginStartOptions = CassandraClustersClientBeginStartOptions{}) -> runtime.Poller[CassandraClustersClientStartResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if options.resume_token != "" {
    return runtime.resume_poller(c.setup.pipeline, options.resume_token, "CassandraClustersClientStartResponse", fn(r: http.Response) -> CassandraClustersClientStartResponse ! Str { cassandra_clusters_start_handle(r) }, traced: true)
  }
  let sp = runtime.start_span({}, "CassandraClustersClient.BeginStart", c.setup.pipeline.tracer)
  let req = c.start_create_request(resource_group_name, cluster_name, options) ?? e => return Err(sp.fail(e))
  let resp = c.setup.pipeline.send(sp.on(req)) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![202].contains(resp.status) {
    return Err(sp.fail(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  sp.end()
  runtime.new_poller(c.setup.pipeline, req, resp, "", "CassandraClustersClientStartResponse", fn(r: http.Response) -> CassandraClustersClientStartResponse ! Str { cassandra_clusters_start_handle(r) }, traced: true)
}

/// CassandraClustersClientStatusOptions: the optional parameters of CassandraClustersClient.status.
pub struct CassandraClustersClientStatusOptions {}

/// CassandraClustersClientStatusResponse: the response of CassandraClustersClient.status.
pub struct CassandraClustersClientStatusResponse {
  pub cassandra_cluster_public_status: CassandraClusterPublicStatus
}

fn cassandra_clusters_status_handle(resp: http.Response) -> CassandraClustersClientStatusResponse ! Str {
  let v = if resp.body.is_empty() { CassandraClusterPublicStatus{} } else { json.decode[CassandraClusterPublicStatus](resp.body) ?? e => return Err(e.display()) }
  Ok(CassandraClustersClientStatusResponse{cassandra_cluster_public_status: v})
}

fn (c: CassandraClustersClient) status_create_request(resource_group_name: Str, cluster_name: Str, options: CassandraClustersClientStatusOptions) -> policy.Request ! azcore.CallErr {
  var path = "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.DocumentDB/cassandraClusters/{clusterName}/status"
  if c.subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionID cannot be empty"))
  }
  path = path.replace("{subscriptionId}", url.path_escape(c.subscription_id))
  if resource_group_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter resourceGroupName cannot be empty"))
  }
  path = path.replace("{resourceGroupName}", url.path_escape(resource_group_name))
  if cluster_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter clusterName cannot be empty"))
  }
  path = path.replace("{clusterName}", url.path_escape(cluster_name))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  Ok(policy.Request{method: "GET", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q, pct20: true), headers: headers, body: b""})
}

/// Gets the CPU, memory, and disk usage statistics for each Cassandra node in a cluster.
pub fn (c: CassandraClustersClient) status(resource_group_name: Str, cluster_name: Str, options: CassandraClustersClientStatusOptions = CassandraClustersClientStatusOptions{}) -> CassandraClustersClientStatusResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let sp = runtime.start_span({}, "CassandraClustersClient.Status", c.setup.pipeline.tracer)
  let req = sp.on(c.status_create_request(resource_group_name, cluster_name, options) ?? e => return Err(sp.fail(e)))
  let resp = c.setup.pipeline.send(req) ?? e => return Err(sp.fail(azcore.CallErr.Send(e)))
  if ![200].contains(resp.status) {
    return Err(sp.fail(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp))))
  }
  let out = cassandra_clusters_status_handle(resp) ?? e => return Err(sp.fail(azcore.CallErr.Decode(e)))
  sp.end()
  Ok(out)
}
