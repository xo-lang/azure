// Go's AdditionalProperties on the service resource properties: the keys
// no field names are kept on decode and written inline, keys sorted.

use std/json
use github.com/xo-lang/azure/runtime

test "service properties keep the keys no field names (Go's AdditionalProperties)" {
  let p = json.decode_str[DataTransferServiceResourceProperties]("{\"serviceType\":\"DataTransfer\",\"instanceCount\":2,\"zeta\":{\"a\":[1,true]},\"alpha\":\"x\"}") ?? e => fault("${e}")
  expect(p.instance_count) == Some(2)
  expect(p.additional_properties.map(fn(m: Map[Str, json.Value]) -> Int { m.len() })) == Some(2)
  expect(runtime.marshal_json(p).to_str_lossy()) == "{\"alpha\":\"x\",\"instanceCount\":2,\"serviceType\":\"DataTransfer\",\"zeta\":{\"a\":[1,true]}}"
  let none = json.decode_str[DataTransferServiceResourceProperties]("{\"instanceCount\":2}") ?? e => fault("${e}")
  expect(none.additional_properties.is_none()) == true
}

test "an extra key through the polymorphic union keeps its discriminator" {
  let c = json.decode_str[ServiceResourcePropertiesClassification]("{\"serviceType\":\"DataTransfer\",\"k1\":{\"k\":\"v\"}}") ?? e => fault("${e}")
  expect(runtime.marshal_json(c).to_str_lossy()) == "{\"k1\":{\"k\":\"v\"},\"serviceType\":\"DataTransfer\"}"
}
