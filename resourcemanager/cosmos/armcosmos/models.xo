/// Properties of a managed Cassandra cluster.
pub struct ClusterResourceProperties {
  /// Which authentication method Cassandra should use to authenticate clients. 'None' turns off authentication, so should not be used except in emergencies. 'Cassandra' is the default password based authentication. The default is 'Cassandra'.
  pub authentication_method as "authenticationMethod,omitempty": AuthenticationMethod? = None
  /// The form of AutoReplicate that is being used by this cluster.
  pub auto_replicate as "autoReplicate,omitempty": AutoReplicate? = None
  /// How to connect to the azure services needed for running the cluster
