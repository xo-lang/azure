    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_service_client_list_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_219)
}

