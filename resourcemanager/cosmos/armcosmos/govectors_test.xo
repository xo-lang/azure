test "Go's LocationsClient.NewListPager" {
  let f = new_fake(os.net)
  let c = new_locations_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"backupStorageRedundancies\":[\"s-backupstorageredundancies\"],\"isResidencyRestricted\":true,\"isSubscriptionRegionAccessAllowedForAz\":true,\"isSubscriptionRegionAccessAllowedForRegular\":true,\"status\":\"s-status\",\"supportsAvailabilityZone\":true},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  note(f, "CALL LocationsClient.NewListPager")
  var pg = c.new_list_pager(LocationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_locations_client_list_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_109)
}

