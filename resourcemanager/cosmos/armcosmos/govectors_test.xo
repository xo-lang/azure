  note(f, "CALL CassandraClustersClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(CassandraClustersClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
