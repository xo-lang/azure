test "Go's ServiceClient.NewListPager" {
  let f = new_fake(os.net)
  let c = new_service_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"creationTime\":\"2026-11-06T10:00:00Z\",\"instanceCount\":7,\"instanceSize\":\"s-instancesize\",\"k1\":{\"k\":\"v\"},\"locations\":[{\"location\":\"s-location\",\"name\":\"s-name\",\"status\":\"s-status\"}],\"serviceType\":\"DataTransfer\",\"status\":\"s-status\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  note(f, "CALL ServiceClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", ServiceClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
