test "Go's FleetspaceClient.NewListPager" {
  let f = new_fake(os.net)
  let c = new_fleetspace_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"dataRegions\":[\"s-dataregions\"],\"fleetspaceApiKind\":\"s-fleetspaceapikind\",\"provisioningState\":\"Succeeded\",\"serviceTier\":\"s-servicetier\",\"throughputPoolConfiguration\":{\"dedicatedRUs\":7,\"maxConsumableRUs\":7,\"maxThroughput\":7,\"minThroughput\":7}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  note(f, "CALL FleetspaceClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", "id2/ x", FleetspaceClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_fleetspace_client_list_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_82)
}

