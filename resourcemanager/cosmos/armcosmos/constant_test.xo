// Go's JSON for models with CONSTANT fields (a one-value enum sealed
// to a string), from a Go program over Go's armcosmos/v4 v4.0.0: each
// unset, then set to another value. Go writes a required one always, an
// optional one when set, as its constant whatever the field holds.

use github.com/xo-lang/azure/runtime

/// Where ours still differs from Go's: (Go's line, ours).
const CONST_KNOWN: List[(Str, Str)] = [
  ("cosmos.create.unset {\"databaseAccountOfferType\":\"Standard\"}", "cosmos.create.unset {}"),
  ("cosmos.create.other {\"databaseAccountOfferType\":\"Standard\"}", "cosmos.create.other {\"databaseAccountOfferType\":\"other\"}"),
  ("cosmos.get.other {\"databaseAccountOfferType\":\"Standard\"}", "cosmos.get.other {\"databaseAccountOfferType\":\"other\"}"),
]

test "constant fields encode as Go's" {
  let got = [
    "cosmos.create.unset ${runtime.marshal_json(DatabaseAccountCreateUpdateProperties{}).to_str_lossy()}",
    "cosmos.create.other ${runtime.marshal_json(DatabaseAccountCreateUpdateProperties{database_account_offer_type: Some("other")}).to_str_lossy()}",
    "cosmos.get.unset ${runtime.marshal_json(DatabaseAccountGetProperties{}).to_str_lossy()}",
    "cosmos.get.other ${runtime.marshal_json(DatabaseAccountGetProperties{database_account_offer_type: Some("other")}).to_str_lossy()}",
  ]
  let want = [
    "cosmos.create.unset {\"databaseAccountOfferType\":\"Standard\"}",
    "cosmos.create.other {\"databaseAccountOfferType\":\"Standard\"}",
    "cosmos.get.unset {}",
    "cosmos.get.other {\"databaseAccountOfferType\":\"Standard\"}",
  ]
  expect(got.len()) == want.len()
  var bad: List[Str] = []
  var i = 0
  while i < want.len() {
    let w = want[i]
    let ours = CONST_KNOWN.filter(fn(p: (Str, Str)) -> Bool { p.0 == w }).get(0).map(fn(p: (Str, Str)) -> Str { p.1 }) ?? w
    if got[i] != ours {
      bad.push("want: ${ours}\n  got:  ${got[i]}")
    }
    i += 1
  }
  expect(bad.join("\n")) == ""
}
