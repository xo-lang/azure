// Go's JSON for polymorphic models, from a Go program over Go's
// armcosmos/v4 v4.0.0: a subtype alone (its discriminator unset, or set to
// another value), the base alone, and each through a field of the
// base's interface type. Go's subtype writes its own value always.

use github.com/xo-lang/azure/runtime

/// Where ours still differs from Go's: (Go's line, ours).
const DISC_KNOWN: List[(Str, Str)] = [
  ("cosmos.derived {\"migrationState\":{\"targetType\":\"Continuous\"},\"type\":\"Periodic\"}", "cosmos.derived {\"migrationState\":{\"targetType\":\"Continuous\"}}"),
  ("cosmos.derived_other {\"type\":\"Periodic\"}", "cosmos.derived_other {\"type\":\"Continuous\"}"),
  ("cosmos.through_base {\"backupPolicy\":{},\"databaseAccountOfferType\":\"Standard\"}", "cosmos.through_base {\"backupPolicy\":{\"type\":null},\"databaseAccountOfferType\":\"Standard\"}"),
]

test "polymorphic models encode as Go's, alone and through the base" {
  let got = [
    "cosmos.derived ${runtime.marshal_json(PeriodicModeBackupPolicy{migration_state: Some(BackupPolicyMigrationState{target_type: Some(BACKUP_POLICY_TYPE_CONTINUOUS)})}).to_str_lossy()}",
    "cosmos.derived_other ${runtime.marshal_json(PeriodicModeBackupPolicy{type_: Some(BACKUP_POLICY_TYPE_CONTINUOUS)}).to_str_lossy()}",
    "cosmos.base ${runtime.marshal_json(BackupPolicy{}).to_str_lossy()}",
    "cosmos.base_set ${runtime.marshal_json(BackupPolicy{type_: Some(BACKUP_POLICY_TYPE_PERIODIC)}).to_str_lossy()}",
    "cosmos.through ${runtime.marshal_json(DatabaseAccountCreateUpdateProperties{backup_policy: Some(BackupPolicyClassification.PeriodicModeBackupPolicy(PeriodicModeBackupPolicy{})), database_account_offer_type: Some("Standard")}).to_str_lossy()}",
    "cosmos.through_base ${runtime.marshal_json(DatabaseAccountCreateUpdateProperties{backup_policy: Some(BackupPolicyClassification.BackupPolicy(BackupPolicy{})), database_account_offer_type: Some("Standard")}).to_str_lossy()}",
  ]
  let want = [
    "cosmos.derived {\"migrationState\":{\"targetType\":\"Continuous\"},\"type\":\"Periodic\"}",
    "cosmos.derived_other {\"type\":\"Periodic\"}",
    "cosmos.base {}",
    "cosmos.base_set {\"type\":\"Periodic\"}",
    "cosmos.through {\"backupPolicy\":{\"type\":\"Periodic\"},\"databaseAccountOfferType\":\"Standard\"}",
    "cosmos.through_base {\"backupPolicy\":{},\"databaseAccountOfferType\":\"Standard\"}",
  ]
  expect(got.len()) == want.len()
  var bad: List[Str] = []
  var i = 0
  while i < want.len() {
    let w = want[i]
    let ours = DISC_KNOWN.filter(fn(p: (Str, Str)) -> Bool { p.0 == w }).get(0).map(fn(p: (Str, Str)) -> Str { p.1 }) ?? w
    if got[i] != ours {
      bad.push("want: ${ours}\n  got:  ${got[i]}")
    }
    i += 1
  }
  expect(bad.join("\n")) == ""
}
