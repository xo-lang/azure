  "OUT: body={\"properties\":{\"disabled\":true}}",
]

test "Go's MicrosoftSerialConsoleClient.GetConsoleStatus" {
  let f = gv_new_fake(os.net)
  let c = new_microsoft_serial_console_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"properties\":{\"disabled\":true}}")
  gv_note(f, "CALL MicrosoftSerialConsoleClient.GetConsoleStatus")
  match c.get_console_status("id1/ x", MicrosoftSerialConsoleClientGetConsoleStatusOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_microsoft_serial_console_client_get_console_status_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_2)
}

