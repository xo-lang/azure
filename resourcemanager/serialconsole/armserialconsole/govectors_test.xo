fn show_microsoft_serial_console_client_get_console_status_response(r: MicrosoftSerialConsoleClientGetConsoleStatusResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.status).to_str_lossy()}")
  parts.join(" ")
}

const GO_2: List[Str] = [
  "CALL MicrosoftSerialConsoleClient.GetConsoleStatus",
  "REQ GET https://management.example.test/subscriptions/sub-test/providers/Microsoft.SerialConsole/consoleServices/id1%2F%20x?api-version=2024-07-01",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
