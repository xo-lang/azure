  let f = gv_new_fake(os.net)
  let c = new_enterprise_policies_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"systemAssignedIdentityPrincipalId\":\"s-systemassignedidentityprincipalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"encryption\":{\"keyVault\":{\"id\":\"s-id\",\"key\":{\"name\":\"s-name\",\"version\":\"s-version\"}},\"state\":\"s-state\"},\"healthStatus\":\"s-healthstatus\",\"lockbox\":{\"state\":\"s-state\"},\"networkInjection\":{\"virtualNetworks\":[{\"id\":\"s-id\"}]},\"systemId\":\"s-systemid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL EnterprisePoliciesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", EnterprisePoliciesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
