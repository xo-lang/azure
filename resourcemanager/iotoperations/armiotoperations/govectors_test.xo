test "Go's DataflowEndpointClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_dataflow_endpoint_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"dataExplorerSettings\":{\"authentication\":{\"method\":\"s-method\",\"systemAssignedManagedIdentitySettings\":{\"audience\":\"s-audience\"},\"userAssignedManagedIdentitySettings\":{\"clientId\":\"s-clientid\",\"scope\":\"s-scope\",\"tenantId\":\"s-tenantid\"}},\"batching\":{\"latencySeconds\":7,\"maxMessages\":7},\"database\":\"s-database\",\"host\":\"s-host\"},\"dataLakeStorageSettings\":{\"authentication\":{\"accessTokenSettings\":{\"secretRef\":\"s-secretref\"},\"method\":\"s-method\",\"systemAssignedManagedIdentitySettings\":{\"audience\":\"s-audience\"},\"userAssignedManagedIdentitySettings\":{\"clientId\":\"s-clientid\",\"scope\":\"s-scope\",\"tenantId\":\"s-tenantid\"}},\"batching\":{\"latencySeconds\":7,\"maxMessages\":7},\"host\":\"s-host\"},\"endpointType\":\"s-endpointtype\",\"fabricOneLakeSettings\":{\"authentication\":{\"method\":\"s-method\",\"systemAssignedManagedIdentitySettings\":{\"audience\":\"s-audience\"},\"userAssignedManagedIdentitySettings\":{\"clientId\":\"s-clientid\",\"scope\":\"s-scope\",\"tenantId\":\"s-tenantid\"}},\"batching\":{\"latencySeconds\":7,\"maxMessages\":7},\"host\":\"s-host\",\"names\":{\"lakehouseName\":\"s-lakehousename\",\"workspaceName\":\"s-workspacename\"},\"oneLakePathType\":\"s-onelakepathtype\"},\"healthState\":\"s-healthstate\",\"hostType\":\"s-hosttype\",\"kafkaSettings\":{\"authentication\":{\"method\":\"s-method\",\"saslSettings\":{\"saslType\":\"s-sasltype\",\"secretRef\":\"s-secretref\"},\"systemAssignedManagedIdentitySettings\":{\"audience\":\"s-audience\"},\"userAssignedManagedIdentitySettings\":{\"clientId\":\"s-clientid\",\"scope\":\"s-scope\",\"tenantId\":\"s-tenantid\"},\"x509CertificateSettings\":{\"secretRef\":\"s-secretref\"}},\"batching\":{\"latencyMs\":7,\"maxBytes\":7,\"maxMessages\":7,\"mode\":\"s-mode\"},\"cloudEventAttributes\":\"s-cloudeventattributes\",\"compression\":\"s-compression\",\"consumerGroupId\":\"s-consumergroupid\",\"copyMqttProperties\":\"s-copymqttproperties\",\"host\":\"s-host\",\"kafkaAcks\":\"s-kafkaacks\",\"partitionStrategy\":\"s-partitionstrategy\",\"tls\":{\"mode\":\"s-mode\",\"trustedCaCertificateConfigMapRef\":\"s-trustedcacertificateconfigmapref\"}},\"localStorageSettings\":{\"persistentVolumeClaimRef\":\"s-persistentvolumeclaimref\"},\"mqttSettings\":{\"authentication\":{\"method\":\"s-method\",\"serviceAccountTokenSettings\":{\"audience\":\"s-audience\"},\"systemAssignedManagedIdentitySettings\":{\"audience\":\"s-audience\"},\"userAssignedManagedIdentitySettings\":{\"clientId\":\"s-clientid\",\"scope\":\"s-scope\",\"tenantId\":\"s-tenantid\"},\"x509CertificateSettings\":{\"secretRef\":\"s-secretref\"}},\"clientIdPrefix\":\"s-clientidprefix\",\"cloudEventAttributes\":\"s-cloudeventattributes\",\"host\":\"s-host\",\"keepAliveSeconds\":7,\"maxInflightMessages\":7,\"protocol\":\"s-protocol\",\"qos\":7,\"retain\":\"s-retain\",\"sessionExpirySeconds\":7,\"tls\":{\"mode\":\"s-mode\",\"trustedCaCertificateConfigMapRef\":\"s-trustedcacertificateconfigmapref\"}},\"openTelemetrySettings\":{\"authentication\":{\"method\":\"Anonymous\"},\"batching\":{\"latencySeconds\":7,\"maxMessages\":7},\"host\":\"s-host\",\"tls\":{\"mode\":\"s-mode\",\"trustedCaCertificateConfigMapRef\":\"s-trustedcacertificateconfigmapref\"}},\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DataflowEndpointClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", "id2/ x", DataflowEndpointClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_dataflow_endpoint_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_35)
}

fn show_dataflow_graph_client_create_or_update_response(r: DataflowGraphClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.dataflow_graph_resource).to_str_lossy()}")
  parts.join(" ")
}

