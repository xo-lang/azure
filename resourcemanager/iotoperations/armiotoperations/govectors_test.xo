test "Go's RegistryEndpointClient.NewListByInstanceResourcePager" {
  let f = gv_new_fake(os.net)
  let c = new_registry_endpoint_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"authentication\":{\"anonymousSettings\":{},\"method\":\"Anonymous\"},\"codeSigningCas\":[{\"configMapRef\":\"s-configmapref\",\"type\":\"ConfigMap\"}],\"healthState\":\"s-healthstate\",\"host\":\"s-host\",\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RegistryEndpointClient.NewListByInstanceResourcePager")
  var pg = c.new_list_by_instance_resource_pager("id1/ x", "id2/ x", RegistryEndpointClientListByInstanceResourceOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_registry_endpoint_client_list_by_instance_resource_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_54)
}
