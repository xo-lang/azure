test "Go's AkriConnectorClient.NewListByTemplatePager" {
  let f = gv_new_fake(os.net)
  let c = new_akri_connector_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"allocatedDevices\":[{\"deviceInboundEndpointName\":\"s-deviceinboundendpointname\",\"deviceName\":\"s-devicename\"}],\"healthState\":\"s-healthstate\",\"provisioningState\":\"Succeeded\",\"status\":{\"healthState\":{\"lastTransitionTime\":\"s-lasttransitiontime\",\"lastUpdateTime\":\"s-lastupdatetime\",\"message\":\"s-message\",\"reasonCode\":\"s-reasoncode\",\"status\":\"s-status\"}}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL AkriConnectorClient.NewListByTemplatePager")
  var pg = c.new_list_by_template_pager("id1/ x", "id2/ x", "id3/ x", AkriConnectorClientListByTemplateOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_akri_connector_client_list_by_template_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_3)
}

