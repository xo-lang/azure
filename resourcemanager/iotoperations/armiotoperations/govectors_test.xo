  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"healthState\":\"s-healthstate\",\"mode\":\"s-mode\",\"nodeConnections\":[{\"from\":{\"name\":\"s-name\"},\"to\":{\"name\":\"s-name\"}}],\"nodes\":[{\"name\":\"s-name\",\"nodeType\":\"Destination\"}],\"provisioningState\":\"Succeeded\",\"requestDiskPersistence\":\"s-requestdiskpersistence\",\"status\":{\"healthState\":{\"lastTransitionTime\":\"s-lasttransitiontime\",\"lastUpdateTime\":\"s-lastupdatetime\",\"message\":\"s-message\",\"reasonCode\":\"s-reasoncode\",\"status\":\"s-status\"}}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
