test "Go's BrokerClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_broker_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"extendedLocation\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"advanced\":{\"clients\":{\"maxKeepAliveSeconds\":7,\"maxMessageExpirySeconds\":7,\"maxPacketSizeBytes\":7,\"maxReceiveMaximum\":7,\"maxSessionExpirySeconds\":7,\"subscriberQueueLimit\":{\"length\":7,\"strategy\":\"s-strategy\"}},\"encryptInternalTraffic\":\"s-encryptinternaltraffic\",\"internalCerts\":{\"duration\":\"s-duration\",\"privateKey\":{\"algorithm\":\"s-algorithm\",\"rotationPolicy\":\"s-rotationpolicy\"},\"renewBefore\":\"s-renewbefore\"}},\"cardinality\":{\"backendChain\":{\"partitions\":7,\"redundancyFactor\":7,\"workers\":7},\"frontend\":{\"replicas\":7,\"workers\":7}},\"diagnostics\":{\"logs\":{\"level\":\"s-level\"},\"metrics\":{\"prometheusPort\":7},\"selfCheck\":{\"intervalSeconds\":7,\"mode\":\"s-mode\",\"timeoutSeconds\":7},\"traces\":{\"cacheSizeMegabytes\":7,\"mode\":\"s-mode\",\"selfTracing\":{\"intervalSeconds\":7,\"mode\":\"s-mode\"},\"spanChannelCapacity\":7}},\"diskBackedMessageBuffer\":{\"ephemeralVolumeClaimSpec\":{\"accessModes\":[\"s-accessmodes\"],\"dataSource\":{\"apiGroup\":\"s-apigroup\",\"kind\":\"s-kind\",\"name\":\"s-name\"},\"dataSourceRef\":{\"apiGroup\":\"s-apigroup\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"namespace\":\"s-namespace\"},\"resources\":{\"limits\":{\"k1\":\"s-limits\"},\"requests\":{\"k1\":\"s-requests\"}},\"selector\":{\"matchLabels\":{\"k1\":\"s-matchlabels\"}},\"storageClassName\":\"s-storageclassname\",\"volumeMode\":\"s-volumemode\",\"volumeName\":\"s-volumename\"},\"maxSize\":\"s-maxsize\",\"persistentVolumeClaimSpec\":{\"accessModes\":[\"s-accessmodes\"],\"dataSource\":{\"apiGroup\":\"s-apigroup\",\"kind\":\"s-kind\",\"name\":\"s-name\"},\"dataSourceRef\":{\"apiGroup\":\"s-apigroup\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"namespace\":\"s-namespace\"},\"resources\":{\"limits\":{\"k1\":\"s-limits\"},\"requests\":{\"k1\":\"s-requests\"}},\"selector\":{\"matchLabels\":{\"k1\":\"s-matchlabels\"}},\"storageClassName\":\"s-storageclassname\",\"volumeMode\":\"s-volumemode\",\"volumeName\":\"s-volumename\"}},\"generateResourceLimits\":{\"cpu\":\"s-cpu\"},\"healthState\":\"s-healthstate\",\"highPriorityMessagesBackpressureHandling\":\"s-highprioritymessagesbackpressurehandling\",\"memoryProfile\":\"s-memoryprofile\",\"persistence\":{\"encryption\":{\"mode\":\"s-mode\"},\"maxSize\":\"s-maxsize\",\"persistentVolumeClaimSpec\":{\"accessModes\":[\"s-accessmodes\"],\"dataSource\":{\"apiGroup\":\"s-apigroup\",\"kind\":\"s-kind\",\"name\":\"s-name\"},\"dataSourceRef\":{\"apiGroup\":\"s-apigroup\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"namespace\":\"s-namespace\"},\"resources\":{\"limits\":{\"k1\":\"s-limits\"},\"requests\":{\"k1\":\"s-requests\"}},\"selector\":{\"matchLabels\":{\"k1\":\"s-matchlabels\"}},\"storageClassName\":\"s-storageclassname\",\"volumeMode\":\"s-volumemode\",\"volumeName\":\"s-volumename\"},\"retain\":{\"mode\":\"Custom\"},\"stateStore\":{\"mode\":\"Custom\"},\"subscriberQueue\":{\"mode\":\"Custom\"}},\"provisioningState\":\"Succeeded\",\"status\":{\"healthState\":{\"lastTransitionTime\":\"s-lasttransitiontime\",\"lastUpdateTime\":\"s-lastupdatetime\",\"message\":\"s-message\",\"reasonCode\":\"s-reasoncode\",\"status\":\"s-status\"}}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL BrokerClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", "id2/ x", BrokerClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_broker_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_23)
}

fn show_broker_listener_client_create_or_update_response(r: BrokerListenerClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.broker_listener_resource).to_str_lossy()}")
  parts.join(" ")
}

