/// AkriConnectorTemplateAllocationClassification: a AkriConnectorTemplateAllocation by its policy, Go's AkriConnectorTemplateAllocationClassification interface.
pub enum AkriConnectorTemplateAllocationClassification {
  /// policy "Bucketized"
  AkriConnectorTemplateBucketizedAllocation(from AkriConnectorTemplateBucketizedAllocation)
  /// Any other policy, as the base type.
  AkriConnectorTemplateAllocation(from AkriConnectorTemplateAllocation)
} derive Json(via: json.Value, to: akri_connector_template_allocation_classification_json, from: parse_akri_connector_template_allocation_classification)

fn akri_connector_template_allocation_classification_json(c: AkriConnectorTemplateAllocationClassification) -> json.Value {
  match c {
    AkriConnectorTemplateAllocationClassification.AkriConnectorTemplateBucketizedAllocation(x) => json.to_value(x)
    AkriConnectorTemplateAllocationClassification.AkriConnectorTemplateAllocation(x) => json.to_value(x)
  }
}

fn parse_akri_connector_template_allocation_classification(v: json.Value) -> AkriConnectorTemplateAllocationClassification ! json.DecodeErr {
  match v.get("policy") {
    Some(json.Value.Str("Bucketized")) => Ok(AkriConnectorTemplateAllocationClassification.AkriConnectorTemplateBucketizedAllocation(json.from_value[AkriConnectorTemplateBucketizedAllocation](v)?))
    _ => Ok(AkriConnectorTemplateAllocationClassification.AkriConnectorTemplateAllocation(json.from_value[AkriConnectorTemplateAllocation](v)?))
  }
}

/// AkriConnectorsRegistrySettingsClassification: a AkriConnectorsRegistrySettings by its registrySettingsType, Go's AkriConnectorsRegistrySettingsClassification interface.
