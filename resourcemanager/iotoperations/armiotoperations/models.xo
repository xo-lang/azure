  match c {
    AkriConnectorsRegistrySettingsClassification.AkriConnectorsContainerRegistry(x) => json.to_value(x)
    AkriConnectorsRegistrySettingsClassification.AkriConnectorsRegistryEndpointRef(x) => json.to_value(x)
    AkriConnectorsRegistrySettingsClassification.AkriConnectorsRegistrySettings(x) => json.to_value(x)
  }
}

