  gv_set(f, 200, "{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"additionalCustomerProperties\":{\"customerAsn\":\"s-customerasn\",\"customerAsnEstimatedEgressPeekGbps\":1.5,\"customerEmail\":\"s-customeremail\",\"customerEntitlementExpiration\":\"2026-11-06T10:00:00Z\",\"customerEntitlementSkuGuid\":\"s-customerentitlementskuguid\",\"customerEntitlementSkuId\":\"s-customerentitlementskuid\",\"customerEntitlementSkuName\":\"s-customerentitlementskuname\",\"customerOrgName\":\"s-customerorgname\",\"customerPropertiesOverviewAverageEgressMbps\":1.5,\"customerPropertiesOverviewAverageMissMbps\":1.5,\"customerPropertiesOverviewCacheEfficiency\":1.5,\"customerPropertiesOverviewCacheNodesHealthyCount\":7,\"customerPropertiesOverviewCacheNodesUnhealthyCount\":7,\"customerPropertiesOverviewEgressMbpsMax\":1.5,\"customerPropertiesOverviewEgressMbpsMaxDateTime\":\"2026-11-06T10:00:00Z\",\"customerPropertiesOverviewMissMbpsMax\":1.5,\"customerPropertiesOverviewMissMbpsMaxDateTime\":\"2026-11-06T10:00:00Z\",\"customerTransitAsn\":\"s-customertransitasn\",\"customerTransitState\":\"s-customertransitstate\",\"optionalProperty1\":\"s-optionalproperty1\",\"optionalProperty2\":\"s-optionalproperty2\",\"optionalProperty3\":\"s-optionalproperty3\",\"optionalProperty4\":\"s-optionalproperty4\",\"optionalProperty5\":\"s-optionalproperty5\",\"peeringDbLastUpdateDate\":\"2026-11-06T10:00:00Z\",\"signupPhaseStatusCode\":7,\"signupPhaseStatusText\":\"s-signupphasestatustext\",\"signupStatus\":true,\"signupStatusCode\":7,\"signupStatusText\":\"s-signupstatustext\"},\"customer\":{\"clientTenantId\":\"s-clienttenantid\",\"contactEmail\":\"s-contactemail\",\"contactName\":\"s-contactname\",\"contactPhone\":\"s-contactphone\",\"createAsyncOperationId\":\"s-createasyncoperationid\",\"customerId\":\"s-customerid\",\"customerName\":\"s-customername\",\"deleteAsyncOperationId\":\"s-deleteasyncoperationid\",\"fullyQualifiedResourceId\":\"s-fullyqualifiedresourceid\",\"isEnterpriseManaged\":true,\"isEntitled\":true,\"lastSyncWithAzureTimestamp\":\"2026-11-06T10:00:00Z\",\"releaseVersion\":7,\"resendSignupCode\":true,\"shouldMigrate\":true,\"synchWithAzureAttemptsCount\":7,\"verifySignupCode\":true,\"verifySignupPhrase\":\"s-verifysignupphrase\"},\"error\":{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"additionalInfo\":[{\"info\":{\"k\":\"v\"},\"type\":\"s-type\"}],\"code\":\"s-code\",\"details\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"}],\"message\":\"s-message\",\"target\":\"s-target\"},\"provisioningState\":\"Succeeded\",\"status\":\"s-status\",\"statusCode\":\"s-statuscode\",\"statusDetails\":\"s-statusdetails\",\"statusText\":\"s-statustext\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL IspCustomersClient.Update")
  match c.update("id1/ x", "id2/ x", (json.decode_str[PatchResource]("{\"tags\":{\"k1\":\"s-tags\"}}") ?? e => fault("${e}")), IspCustomersClientUpdateOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_isp_customers_client_update_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_29)
}

fn show_operations_client_list_response(r: OperationsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_list_result).to_str_lossy()}")
  parts.join(" ")
}

const GO_30: List[Str] = [
  "CALL OperationsClient.NewListPager",
  "REQ GET https://management.example.test/providers/Microsoft.ConnectedCache/operations?api-version=2026-06-01",
  "  H accept=application/json | authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "OUT page 1: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "REQ GET https://management.example.test/next?%24skiptoken=2",
  "  H authorization=Bearer tok",
  "  B ",
  "  SERVED 200 {\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
]

test "Go's OperationsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_operations_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"actionType\":\"s-actiontype\",\"display\":{\"description\":\"s-description\",\"operation\":\"s-operation\",\"provider\":\"s-provider\",\"resource\":\"s-resource\"},\"isDataAction\":true,\"name\":\"s-name\",\"origin\":\"s-origin\"}]}")
  gv_note(f, "CALL OperationsClient.NewListPager")
  var pg = c.new_list_pager(OperationsClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_operations_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_30)
}
