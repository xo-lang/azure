fn show_isp_customers_client_create_or_update_response(r: IspCustomersClientCreateOrUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.isp_customer_resource).to_str_lossy()}")
  parts.join(" ")
}

