test "Go's Client.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"cors\":{\"allowedOrigins\":[\"s-allowedorigins\"]},\"disableAadAuth\":true,\"disableLocalAuth\":true,\"externalIP\":\"s-externalip\",\"features\":[{\"flag\":\"s-flag\",\"properties\":{\"k1\":\"s-properties\"},\"value\":\"s-value\"}],\"hostName\":\"s-hostname\",\"hostNamePrefix\":\"s-hostnameprefix\",\"liveTraceConfiguration\":{\"categories\":[{\"enabled\":\"s-enabled\",\"name\":\"s-name\"}],\"enabled\":\"s-enabled\"},\"networkACLs\":{\"defaultAction\":\"s-defaultaction\",\"privateEndpoints\":[{\"name\":\"s-name\"}],\"publicNetwork\":{\"allow\":[\"s-allow\"],\"deny\":[\"s-deny\"]}},\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"publicPort\":7,\"resourceLogConfiguration\":{\"categories\":[{\"enabled\":\"s-enabled\",\"name\":\"s-name\"}]},\"serverPort\":7,\"serverless\":{\"connectionTimeoutInSeconds\":7},\"sharedPrivateLinkResources\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"groupId\":\"s-groupid\",\"privateLinkResourceId\":\"https://management.example.test/next?\$skiptoken=2\",\"provisioningState\":\"Succeeded\",\"requestMessage\":\"s-requestmessage\",\"status\":\"s-status\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"tls\":{\"clientCertEnabled\":true},\"upstream\":{\"templates\":[{\"categoryPattern\":\"s-categorypattern\",\"eventPattern\":\"s-eventpattern\",\"hubPattern\":\"s-hubpattern\",\"urlTemplate\":\"s-urltemplate\"}]},\"version\":\"s-version\"},\"sku\":{\"capacity\":7,\"family\":\"s-family\",\"name\":\"s-name\",\"size\":\"s-size\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Client.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_9)
}

fn show_client_list_by_subscription_response(r: ClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.resource_info_list).to_str_lossy()}")
  parts.join(" ")
}

