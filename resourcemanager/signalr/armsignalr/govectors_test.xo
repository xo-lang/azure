  "  SERVED 200 {\"message\":\"s-message\",\"nameAvailable\":true,\"reason\":\"s-reason\"}",
  "OUT: body={\"message\":\"s-message\",\"nameAvailable\":true,\"reason\":\"s-reason\"}",
]

test "Go's Client.CheckNameAvailability" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"message\":\"s-message\",\"nameAvailable\":true,\"reason\":\"s-reason\"}")
  gv_note(f, "CALL Client.CheckNameAvailability")
  match c.check_name_availability("id1/ x", (json.decode_str[NameAvailabilityParameters]("{\"name\":\"s-name\",\"type\":\"s-type\"}") ?? e => fault("${e}")), ClientCheckNameAvailabilityOptions{}) {
    Ok(r) => gv_note(f, "OUT: ${show_client_check_name_availability_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_5)
}

