fn show_client_check_name_availability_response(r: ClientCheckNameAvailabilityResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.name_availability).to_str_lossy()}")
  parts.join(" ")
}

const GO_5: List[Str] = [
  "CALL Client.CheckNameAvailability",
  "REQ POST https://management.example.test/subscriptions/sub-test/providers/Microsoft.SignalRService/locations/id1%2F%20x/checkNameAvailability?api-version=2023-02-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
