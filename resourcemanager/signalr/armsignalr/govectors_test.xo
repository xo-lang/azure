test "Go's UsagesClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_usages_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"currentValue\":7,\"id\":\"s-id\",\"limit\":7,\"name\":{\"localizedValue\":\"s-localizedvalue\",\"value\":\"s-value\"},\"unit\":\"s-unit\"}]}")
  gv_note(f, "CALL UsagesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", UsagesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_usages_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_29)
}
