test "Go's LinkerClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_linker_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"authInfo\":{\"authType\":\"secret\",\"name\":\"s-name\",\"secretInfo\":{\"name\":\"s-name\",\"secretType\":\"keyVaultSecretReference\",\"version\":\"s-version\"}},\"clientType\":\"s-clienttype\",\"provisioningState\":\"Succeeded\",\"scope\":\"s-scope\",\"secretStore\":{\"keyVaultId\":\"s-keyvaultid\"},\"targetService\":{\"id\":\"s-id\",\"resourceProperties\":{\"connectAsKubernetesCsiDriver\":true,\"type\":\"KeyVault\"},\"type\":\"AzureResource\"},\"vNetSolution\":{\"type\":\"s-type\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL LinkerClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", LinkerClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_linker_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_6)
}

fn show_operations_client_list_response(r: OperationsClientListResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.operation_list_result).to_str_lossy()}")
  parts.join(" ")
}

