    Ok(r) => gv_note(f, "OUT: ${show_scheduled_actions_client_virtual_machines_submit_start_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_11)
}
