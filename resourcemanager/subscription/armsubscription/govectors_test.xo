test "Go's AliasClient.BeginCreate" {
  let f = gv_new_fake(os.net)
  let c = new_alias_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"acceptOwnershipState\":\"s-acceptownershipstate\",\"acceptOwnershipUrl\":\"s-acceptownershipurl\",\"billingScope\":\"s-billingscope\",\"createdTime\":\"s-createdtime\",\"displayName\":\"s-displayname\",\"managementGroupId\":\"s-managementgroupid\",\"provisioningState\":\"Succeeded\",\"resellerId\":\"s-resellerid\",\"subscriptionId\":\"s-subscriptionid\",\"subscriptionOwnerId\":\"s-subscriptionownerid\",\"tags\":{\"k1\":\"s-tags\"},\"workload\":\"s-workload\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}")
  gv_note(f, "CALL AliasClient.BeginCreate")
  match c.begin_create("id1/ x", (json.decode_str[PutAliasRequest]("{\"properties\":{\"additionalProperties\":{\"managementGroupId\":\"s-managementgroupid\",\"subscriptionOwnerId\":\"s-subscriptionownerid\",\"subscriptionTenantId\":\"s-subscriptiontenantid\",\"tags\":{\"k1\":\"s-tags\"}},\"billingScope\":\"s-billingscope\",\"displayName\":\"s-displayname\",\"resellerId\":\"s-resellerid\",\"subscriptionId\":\"s-subscriptionid\",\"workload\":\"s-workload\"}}") ?? e => fault("${e}")), AliasClientBeginCreateOptions{}) {
    Ok(p0) => {
      var p = p0
      gv_quiet(f, true)
      let done = p.poll_until_done(os.clock, frequency: 1s)
      gv_quiet(f, false)
      match done {
        Ok(r) => gv_note(f, "OUT: ${show_alias_client_create_response(r)}")
        Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
      }
    }
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

