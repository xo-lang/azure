test "Go's SubscriptionsClient.NewListByTopicPager" {
  let f = new_fake(os.net)
  let c = new_subscriptions_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessedAt\":\"2026-11-06T10:00:00Z\",\"autoDeleteOnIdle\":\"s-autodeleteonidle\",\"clientAffineProperties\":{\"clientId\":\"s-clientid\",\"isDurable\":true,\"isShared\":true},\"countDetails\":{\"activeMessageCount\":7,\"deadLetterMessageCount\":7,\"scheduledMessageCount\":7,\"transferDeadLetterMessageCount\":7,\"transferMessageCount\":7},\"createdAt\":\"2026-11-06T10:00:00Z\",\"deadLetteringOnFilterEvaluationExceptions\":true,\"deadLetteringOnMessageExpiration\":true,\"defaultMessageTimeToLive\":\"s-defaultmessagetimetolive\",\"duplicateDetectionHistoryTimeWindow\":\"s-duplicatedetectionhistorytimewindow\",\"enableBatchedOperations\":true,\"forwardDeadLetteredMessagesTo\":\"s-forwarddeadletteredmessagesto\",\"forwardTo\":\"s-forwardto\",\"isClientAffine\":true,\"lockDuration\":\"s-lockduration\",\"maxDeliveryCount\":7,\"messageCount\":7,\"requiresSession\":true,\"status\":\"s-status\",\"updatedAt\":\"2026-11-06T10:00:00Z\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  note(f, "CALL SubscriptionsClient.NewListByTopicPager")
  var pg = c.new_list_by_topic_pager("id1/ x", "id2/ x", "id3/ x", SubscriptionsClientListByTopicOptions{skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_subscriptions_client_list_by_topic_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_55)
}

