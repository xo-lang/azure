test "Go's RulesClient.NewListBySubscriptionsPager" {
  let f = new_fake(os.net)
  let c = new_rules_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"action\":{\"compatibilityLevel\":7,\"requiresPreprocessing\":true,\"sqlExpression\":\"s-sqlexpression\"},\"correlationFilter\":{\"contentType\":\"s-contenttype\",\"correlationId\":\"s-correlationid\",\"label\":\"s-label\",\"messageId\":\"s-messageid\",\"properties\":{\"k1\":\"s-properties\"},\"replyTo\":\"s-replyto\",\"replyToSessionId\":\"s-replytosessionid\",\"requiresPreprocessing\":true,\"sessionId\":\"s-sessionid\",\"to\":\"s-to\"},\"filterType\":\"s-filtertype\",\"sqlFilter\":{\"compatibilityLevel\":7,\"requiresPreprocessing\":true,\"sqlExpression\":\"s-sqlexpression\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  note(f, "CALL RulesClient.NewListBySubscriptionsPager")
  var pg = c.new_list_by_subscriptions_pager("id1/ x", "id2/ x", "id3/ x", "id4/ x", RulesClientListBySubscriptionsOptions{skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_rules_client_list_by_subscriptions_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_51)
}

