  var pg = c.new_list_authorization_rules_pager("id1/ x", "id2/ x", "id3/ x", DisasterRecoveryConfigsClientListAuthorizationRulesOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
