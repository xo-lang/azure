test "Go's TopicsClient.NewListByNamespacePager" {
  let f = new_fake(os.net)
  let c = new_topics_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessedAt\":\"2026-11-06T10:00:00Z\",\"autoDeleteOnIdle\":\"s-autodeleteonidle\",\"countDetails\":{\"activeMessageCount\":7,\"deadLetterMessageCount\":7,\"scheduledMessageCount\":7,\"transferDeadLetterMessageCount\":7,\"transferMessageCount\":7},\"createdAt\":\"2026-11-06T10:00:00Z\",\"defaultMessageTimeToLive\":\"s-defaultmessagetimetolive\",\"duplicateDetectionHistoryTimeWindow\":\"s-duplicatedetectionhistorytimewindow\",\"enableBatchedOperations\":true,\"enableExpress\":true,\"enablePartitioning\":true,\"maxMessageSizeInKilobytes\":7,\"maxSizeInMegabytes\":7,\"requiresDuplicateDetection\":true,\"sizeInBytes\":7,\"status\":\"s-status\",\"subscriptionCount\":7,\"supportOrdering\":true,\"updatedAt\":\"2026-11-06T10:00:00Z\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  note(f, "CALL TopicsClient.NewListByNamespacePager")
  var pg = c.new_list_by_namespace_pager("id1/ x", "id2/ x", TopicsClientListByNamespaceOptions{skip: Some(7), top: Some(7)}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => note(f, "OUT page ${page}: ${show_topics_client_list_by_namespace_response(r)}")
      Err(e) => {
        note_lines(f, "OUT page ${page}: error: ${err_text(e)}")
        break
      }
    }
  }
  compare(log_of(f), GO_64)
}

fn show_topics_client_regenerate_keys_response(r: TopicsClientRegenerateKeysResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.access_keys).to_str_lossy()}")
  parts.join(" ")
}

const GO_65: List[Str] = [
  "CALL TopicsClient.RegenerateKeys",
  "REQ POST https://management.example.test/subscriptions/sub-test/resourceGroups/id1%2F%20x/providers/Microsoft.ServiceBus/namespaces/id2%2F%20x/topics/id3%2F%20x/authorizationRules/id4%2F%20x/regenerateKeys?api-version=2021-11-01",
  "  H accept=application/json | authorization=Bearer tok | content-type=application/json",
  "  B {\"key\":\"s-key\",\"keyType\":\"s-keytype\"}",
  "  SERVED 200 {\"aliasPrimaryConnectionString\":\"s-aliasprimaryconnectionstring\",\"aliasSecondaryConnectionString\":\"s-aliassecondaryconnectionstring\",\"keyName\":\"s-keyname\",\"primaryConnectionString\":\"s-primaryconnectionstring\",\"primaryKey\":\"s-primarykey\",\"secondaryConnectionString\":\"s-secondaryconnectionstring\",\"secondaryKey\":\"s-secondarykey\"}",
  "OUT: body={\"aliasPrimaryConnectionString\":\"s-aliasprimaryconnectionstring\",\"aliasSecondaryConnectionString\":\"s-aliassecondaryconnectionstring\",\"keyName\":\"s-keyname\",\"primaryConnectionString\":\"s-primaryconnectionstring\",\"primaryKey\":\"s-primarykey\",\"secondaryConnectionString\":\"s-secondaryconnectionstring\",\"secondaryKey\":\"s-secondarykey\"}",
]

test "Go's TopicsClient.RegenerateKeys" {
  let f = new_fake(os.net)
  let c = new_topics_client(os.net, os.clock, os.rand, "sub-test", Cred{}, opts()) ?? e => fault(e)
  set(f, 200, "{\"aliasPrimaryConnectionString\":\"s-aliasprimaryconnectionstring\",\"aliasSecondaryConnectionString\":\"s-aliassecondaryconnectionstring\",\"keyName\":\"s-keyname\",\"primaryConnectionString\":\"s-primaryconnectionstring\",\"primaryKey\":\"s-primarykey\",\"secondaryConnectionString\":\"s-secondaryconnectionstring\",\"secondaryKey\":\"s-secondarykey\"}")
  note(f, "CALL TopicsClient.RegenerateKeys")
  match c.regenerate_keys("id1/ x", "id2/ x", "id3/ x", "id4/ x", (json.decode_str[RegenerateAccessKeyParameters]("{\"key\":\"s-key\",\"keyType\":\"s-keytype\"}") ?? e => fault("${e}")), TopicsClientRegenerateKeysOptions{}) {
    Ok(r) => note(f, "OUT: ${show_topics_client_regenerate_keys_response(r)}")
    Err(e) => note_lines(f, "OUT: error: ${err_text(e)}")
  }
  compare(log_of(f), GO_65)
}
