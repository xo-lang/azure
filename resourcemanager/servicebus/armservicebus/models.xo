  pub default_message_time_to_live as "defaultMessageTimeToLive,omitempty": Str? = None
  /// ISO 8601 timeSpan structure that defines the duration of the duplicate detection history. The default value is 10 minutes.
  pub duplicate_detection_history_time_window as "duplicateDetectionHistoryTimeWindow,omitempty": Str? = None
  /// Value that indicates whether server-side batched operations are enabled.
  pub enable_batched_operations as "enableBatchedOperations,omitempty": Bool? = None
  /// A value that indicates whether Express Entities are enabled. An express queue holds a message in memory temporarily before writing it to persistent storage.
