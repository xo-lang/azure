  /// Fully qualified resource ID for the resource. Ex - /subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/{resourceProviderNamespace}/{resourceType}/{resourceName}
  pub id as "id,omitempty": Str? = None
  /// The geo-location where the resource lives
  pub location as "location,omitempty": Str? = None
  /// The name of the resource
  pub name as "name,omitempty": Str? = None
  /// Properties of subscriptions resource.
  pub properties as "properties,omitempty": SBSubscriptionProperties? = None
  /// The system meta data relating to this resource.
  pub system_data as "systemData,omitempty": SystemData? = None
  /// The type of the resource. E.g. "Microsoft.EventHub/Namespaces" or "Microsoft.EventHub/Namespaces/EventHubs"
  pub type_ as "type,omitempty": Str? = None
} derive Json

/// The response to the List Subscriptions operation.
pub struct SBSubscriptionListResult {
  /// Link to the next set of results. Not empty if Value contains incomplete list of subscriptions.
  pub next_link as "nextLink,omitempty": Str? = None
  /// Result of the List Subscriptions operation.
  pub value as "value,omitempty": List[SBSubscription]? = None
} derive Json

/// Description of a Check Name availability request properties.
pub struct CheckNameAvailability {
  /// The Name to check the namespace name availability and The namespace name can contain only letters, numbers, and hyphens. The namespace must start with a letter, and it must end with a letter or number.
  pub name as "name,omitempty": Str? = None
} derive Json

/// Description of a Check Name availability request properties.
pub struct CheckNameAvailabilityResult {
  /// The detailed info regarding the reason associated with the namespace.
  pub message as "message,omitempty": Str? = None
  /// Value indicating namespace is availability, true if the namespace is available; otherwise, false.
  pub name_available as "nameAvailable,omitempty": Bool? = None
  /// The reason for unavailability of a namespace.
  pub reason as "reason,omitempty": UnavailableReason? = None
} derive Json

/// Represents set of actions written in SQL language-based syntax that is performed against a ServiceBus.Messaging.BrokeredMessage
pub struct SQLRuleAction {
  /// This property is reserved for future use. An integer value showing the compatibility level, currently hard-coded to 20.
  pub compatibility_level as "compatibilityLevel,omitempty": Int? = None
  /// Value that indicates whether the rule action requires preprocessing.
  pub requires_preprocessing as "requiresPreprocessing,omitempty": Bool? = None
  /// SQL expression. e.g. MyProperty='ABC'
  pub sql_expression as "sqlExpression,omitempty": Str? = None
} derive Json

/// EncryptionPatch: Encryption in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct EncryptionPatch {
  /// Enumerates the possible value of keySource for Encryption
  pub key_source as "keySource,omitempty": json.Patch[Str] = json.Patch.Absent
  /// Properties of KeyVault
  pub key_vault_properties as "keyVaultProperties,omitempty": json.Patch[List[KeyVaultProperties]] = json.Patch.Absent
  /// Enable Infrastructure Encryption (Double Encryption)
  pub require_infrastructure_encryption as "requireInfrastructureEncryption,omitempty": json.Patch[Bool] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: Encryption) patch() -> EncryptionPatch {
  EncryptionPatch{
    key_vault_properties: match m.key_vault_properties {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    key_source: match m.key_source {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    require_infrastructure_encryption: match m.require_infrastructure_encryption {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}

/// IdentityPatch: Identity in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct IdentityPatch {
  /// ObjectId from the KeyVault
  pub principal_id as "principalId,omitempty": json.Patch[Str] = json.Patch.Absent
  /// TenantId from the KeyVault
  pub tenant_id as "tenantId,omitempty": json.Patch[Str] = json.Patch.Absent
  /// Type of managed service identity.
  pub type_ as "type,omitempty": json.Patch[ManagedServiceIdentityType] = json.Patch.Absent
  /// Properties for User Assigned Identities
  pub user_assigned_identities as "userAssignedIdentities,omitempty": json.Patch[Map[Str, UserAssignedIdentity]] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: Identity) patch() -> IdentityPatch {
  IdentityPatch{
    principal_id: match m.principal_id {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    tenant_id: match m.tenant_id {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    type_: match m.type_ {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    user_assigned_identities: match m.user_assigned_identities {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}

/// SBSKUPatch: SBSKU in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct SBSKUPatch {
  /// The specified messaging units for the tier. For Premium tier, capacity are 1,2 and 4.
  pub capacity as "capacity,omitempty": json.Patch[Int] = json.Patch.Absent
  /// Name of this SKU.
  pub name as "name,omitempty": json.Patch[SKUName] = json.Patch.Absent
  /// The billing tier of this particular SKU.
  pub tier as "tier,omitempty": json.Patch[SKUTier] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: SBSKU) patch() -> SBSKUPatch {
  SBSKUPatch{
    name: match m.name {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    tier: match m.tier {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    capacity: match m.capacity {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
