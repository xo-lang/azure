  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"availability\":\"s-availability\",\"branding\":{\"k1\":\"s-branding\"},\"collectionIds\":[\"s-collectionids\"],\"eTag\":\"s-etag\",\"isGov\":true,\"notificationsSettings\":{\"recipients\":[{\"displayName\":\"s-displayname\",\"emailAddress\":\"s-emailaddress\",\"principalId\":\"s-principalid\"}],\"sendToAllMarketplaceAdmins\":true},\"privateStoreId\":\"s-privatestoreid\",\"privateStoreName\":\"s-privatestorename\",\"tenantId\":\"s-tenantid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
