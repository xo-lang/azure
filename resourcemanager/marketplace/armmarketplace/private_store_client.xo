fn private_store_create_approval_request_handle(resp: http.Response) -> PrivateStoreClientCreateApprovalRequestResponse ! Str {
  let v = if resp.body.is_empty() { RequestApprovalResource{} } else { json.decode[RequestApprovalResource](resp.body) ?? e => return Err(e.display()) }
