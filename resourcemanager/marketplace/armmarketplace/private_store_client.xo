  var path = "/providers/Microsoft.Marketplace/privateStores/{privateStoreId}/requestApprovals/{requestApprovalId}"
  if private_store_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter privateStoreID cannot be empty"))
  }
  path = path.replace("{privateStoreId}", url.path_escape(private_store_id))
  if request_approval_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter requestApprovalID cannot be empty"))
  }
  path = path.replace("{requestApprovalId}", url.path_escape(request_approval_id))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "PUT", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: runtime.marshal_json(payload)})
}

