      Ok(r) => gv_note(f, "OUT page ${page}: ${show_global_rulestack_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_39)
}

