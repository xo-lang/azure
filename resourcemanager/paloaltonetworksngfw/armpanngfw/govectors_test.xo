test "Go's FirewallsClient.SaveLogProfile" {
  let f = gv_new_fake(os.net)
  let c = new_firewalls_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 204, "")
  gv_note(f, "CALL FirewallsClient.SaveLogProfile")
  match c.save_log_profile("id1/ x", "id2/ x", FirewallsClientSaveLogProfileOptions{log_settings: Some((json.decode_str[LogSettings]("{\"applicationInsights\":{\"id\":\"s-id\",\"key\":\"s-key\"},\"commonDestination\":{\"eventHubConfigurations\":{\"id\":\"s-id\",\"name\":\"s-name\",\"nameSpace\":\"s-namespace\",\"policyName\":\"s-policyname\",\"subscriptionId\":\"s-subscriptionid\"},\"monitorConfigurations\":{\"id\":\"s-id\",\"primaryKey\":\"s-primarykey\",\"secondaryKey\":\"s-secondarykey\",\"subscriptionId\":\"s-subscriptionid\",\"workspace\":\"s-workspace\"},\"storageConfigurations\":{\"accountName\":\"s-accountname\",\"id\":\"s-id\",\"subscriptionId\":\"s-subscriptionid\"}},\"decryptLogDestination\":{\"eventHubConfigurations\":{\"id\":\"s-id\",\"name\":\"s-name\",\"nameSpace\":\"s-namespace\",\"policyName\":\"s-policyname\",\"subscriptionId\":\"s-subscriptionid\"},\"monitorConfigurations\":{\"id\":\"s-id\",\"primaryKey\":\"s-primarykey\",\"secondaryKey\":\"s-secondarykey\",\"subscriptionId\":\"s-subscriptionid\",\"workspace\":\"s-workspace\"},\"storageConfigurations\":{\"accountName\":\"s-accountname\",\"id\":\"s-id\",\"subscriptionId\":\"s-subscriptionid\"}},\"logOption\":\"s-logoption\",\"logType\":\"s-logtype\",\"threatLogDestination\":{\"eventHubConfigurations\":{\"id\":\"s-id\",\"name\":\"s-name\",\"nameSpace\":\"s-namespace\",\"policyName\":\"s-policyname\",\"subscriptionId\":\"s-subscriptionid\"},\"monitorConfigurations\":{\"id\":\"s-id\",\"primaryKey\":\"s-primarykey\",\"secondaryKey\":\"s-secondarykey\",\"subscriptionId\":\"s-subscriptionid\",\"workspace\":\"s-workspace\"},\"storageConfigurations\":{\"accountName\":\"s-accountname\",\"id\":\"s-id\",\"subscriptionId\":\"s-subscriptionid\"}},\"trafficLogDestination\":{\"eventHubConfigurations\":{\"id\":\"s-id\",\"name\":\"s-name\",\"nameSpace\":\"s-namespace\",\"policyName\":\"s-policyname\",\"subscriptionId\":\"s-subscriptionid\"},\"monitorConfigurations\":{\"id\":\"s-id\",\"primaryKey\":\"s-primarykey\",\"secondaryKey\":\"s-secondarykey\",\"subscriptionId\":\"s-subscriptionid\",\"workspace\":\"s-workspace\"},\"storageConfigurations\":{\"accountName\":\"s-accountname\",\"id\":\"s-id\",\"subscriptionId\":\"s-subscriptionid\"}}}") ?? e => fault("${e}")))}) {
    Ok(r) => gv_note(f, "OUT: ${show_firewalls_client_save_log_profile_response(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${gv_err_text(e)}")
  }
  gv_compare(gv_log_of(f), GO_18)
}

fn show_firewalls_client_update_response(r: FirewallsClientUpdateResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.firewall_resource).to_str_lossy()}")
  parts.join(" ")
}

