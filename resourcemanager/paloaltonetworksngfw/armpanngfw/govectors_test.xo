test "Go's FirewallsClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_firewalls_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"associatedRulestack\":{\"location\":\"s-location\",\"resourceId\":\"s-resourceid\",\"rulestackId\":\"s-rulestackid\"},\"dnsSettings\":{\"dnsServers\":[{\"address\":\"s-address\",\"resourceId\":\"s-resourceid\"}],\"enableDnsProxy\":\"s-enablednsproxy\",\"enabledDnsType\":\"s-enableddnstype\"},\"frontEndSettings\":[{\"backendConfiguration\":{\"port\":\"s-port\"},\"frontendConfiguration\":{\"port\":\"s-port\"},\"name\":\"s-name\",\"protocol\":\"s-protocol\"}],\"isPanoramaManaged\":\"s-ispanoramamanaged\",\"isStrataCloudManaged\":\"s-isstratacloudmanaged\",\"marketplaceDetails\":{\"marketplaceSubscriptionId\":\"s-marketplacesubscriptionid\",\"marketplaceSubscriptionStatus\":\"s-marketplacesubscriptionstatus\",\"offerId\":\"s-offerid\",\"publisherId\":\"s-publisherid\"},\"networkProfile\":{\"egressNatIp\":[{\"address\":\"s-address\",\"resourceId\":\"s-resourceid\"}],\"enableEgressNat\":\"s-enableegressnat\",\"networkType\":\"s-networktype\",\"privateSourceNatRulesDestination\":[\"s-privatesourcenatrulesdestination\"],\"publicIps\":[{\"address\":\"s-address\",\"resourceId\":\"s-resourceid\"}],\"trustedRanges\":[\"s-trustedranges\"],\"vnetConfiguration\":{\"ipOfTrustSubnetForUdr\":{\"address\":\"s-address\",\"resourceId\":\"s-resourceid\"},\"trustSubnet\":{\"addressSpace\":\"s-addressspace\",\"resourceId\":\"s-resourceid\"},\"unTrustSubnet\":{\"addressSpace\":\"s-addressspace\",\"resourceId\":\"s-resourceid\"},\"vnet\":{\"addressSpace\":\"s-addressspace\",\"resourceId\":\"s-resourceid\"}},\"vwanConfiguration\":{\"ipOfTrustSubnetForUdr\":{\"address\":\"s-address\",\"resourceId\":\"s-resourceid\"},\"networkVirtualApplianceId\":\"s-networkvirtualapplianceid\",\"trustSubnet\":{\"addressSpace\":\"s-addressspace\",\"resourceId\":\"s-resourceid\"},\"unTrustSubnet\":{\"addressSpace\":\"s-addressspace\",\"resourceId\":\"s-resourceid\"},\"vHub\":{\"addressSpace\":\"s-addressspace\",\"resourceId\":\"s-resourceid\"}}},\"panEtag\":\"s-panetag\",\"panoramaConfig\":{\"cgName\":\"s-cgname\",\"configString\":\"s-configstring\",\"dgName\":\"s-dgname\",\"hostName\":\"s-hostname\",\"panoramaServer\":\"s-panoramaserver\",\"panoramaServer2\":\"s-panoramaserver2\",\"tplName\":\"s-tplname\",\"vmAuthKey\":\"s-vmauthkey\"},\"planData\":{\"billingCycle\":\"s-billingcycle\",\"effectiveDate\":\"2026-11-06T10:00:00Z\",\"planId\":\"s-planid\",\"usageType\":\"s-usagetype\"},\"provisioningState\":\"Succeeded\",\"strataCloudManagerConfig\":{\"cloudManagerName\":\"s-cloudmanagername\"}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL FirewallsClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", FirewallsClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_firewalls_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_16)
}

fn show_firewalls_client_list_by_subscription_response(r: FirewallsClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.firewall_resource_list_result).to_str_lossy()}")
  parts.join(" ")
}

