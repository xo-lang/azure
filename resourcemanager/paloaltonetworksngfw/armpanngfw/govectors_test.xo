test "Go's PrefixListLocalRulestackClient.NewListByLocalRulestacksPager" {
  let f = gv_new_fake(os.net)
  let c = new_prefix_list_local_rulestack_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"auditComment\":\"s-auditcomment\",\"description\":\"s-description\",\"etag\":\"s-etag\",\"prefixList\":[\"s-prefixlist\"],\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PrefixListLocalRulestackClient.NewListByLocalRulestacksPager")
  var pg = c.new_list_by_local_rulestacks_pager("id1/ x", "id2/ x", PrefixListLocalRulestackClientListByLocalRulestacksOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_prefix_list_local_rulestack_client_list_by_local_rulestacks_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_95)
}
