  let f = gv_new_fake(os.net)
  let c = new_pre_rules_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"actionType\":\"s-actiontype\",\"applications\":[\"s-applications\"],\"auditComment\":\"s-auditcomment\",\"category\":{\"feeds\":[\"s-feeds\"],\"urlCustom\":[\"s-urlcustom\"]},\"decryptionRuleType\":\"s-decryptionruletype\",\"description\":\"s-description\",\"destination\":{\"cidrs\":[\"s-cidrs\"],\"countries\":[\"s-countries\"],\"feeds\":[\"s-feeds\"],\"fqdnLists\":[\"s-fqdnlists\"],\"prefixLists\":[\"s-prefixlists\"]},\"enableLogging\":\"s-enablelogging\",\"etag\":\"s-etag\",\"inboundInspectionCertificate\":\"s-inboundinspectioncertificate\",\"negateDestination\":\"s-negatedestination\",\"negateSource\":\"s-negatesource\",\"priority\":7,\"protocol\":\"s-protocol\",\"protocolPortList\":[\"s-protocolportlist\"],\"provisioningState\":\"Succeeded\",\"ruleName\":\"s-rulename\",\"ruleState\":\"s-rulestate\",\"source\":{\"cidrs\":[\"s-cidrs\"],\"countries\":[\"s-countries\"],\"feeds\":[\"s-feeds\"],\"prefixLists\":[\"s-prefixlists\"]},\"tags\":[{\"key\":\"s-key\",\"value\":\"s-value\"}]},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL PreRulesClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", PreRulesClientListOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_pre_rules_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_85)
}

