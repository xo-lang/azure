  q.add("api-version", API_VERSION)
  var body = b""
  if let Some(v) = options.log_settings {
    headers.push(("Content-Type", "application/json"))
    body = runtime.marshal_json(v)
  }
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: body})
}

/// Log Profile for Firewall
pub fn (c: FirewallsClient) save_log_profile(resource_group_name: Str, firewall_name: Str, options: FirewallsClientSaveLogProfileOptions = FirewallsClientSaveLogProfileOptions{}) -> FirewallsClientSaveLogProfileResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.save_log_profile_create_request(resource_group_name, firewall_name, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![204].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  firewalls_save_log_profile_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
