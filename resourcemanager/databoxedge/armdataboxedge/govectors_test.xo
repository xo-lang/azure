test "Go's DevicesClient.NewListByResourceGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_devices_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"configuredRoleTypes\":[\"s-configuredroletypes\"],\"culture\":\"s-culture\",\"dataBoxEdgeDeviceStatus\":\"s-databoxedgedevicestatus\",\"dataResidency\":{\"type\":\"s-type\"},\"description\":\"s-description\",\"deviceHcsVersion\":\"s-devicehcsversion\",\"deviceLocalCapacity\":7,\"deviceModel\":\"s-devicemodel\",\"deviceSoftwareVersion\":\"s-devicesoftwareversion\",\"deviceType\":\"s-devicetype\",\"edgeProfile\":{\"subscription\":{\"id\":\"s-id\",\"properties\":{\"locationPlacementId\":\"s-locationplacementid\",\"quotaId\":\"s-quotaid\",\"serializedDetails\":\"s-serializeddetails\",\"tenantId\":\"s-tenantid\"},\"registrationDate\":\"s-registrationdate\",\"registrationId\":\"s-registrationid\",\"state\":\"s-state\",\"subscriptionId\":\"s-subscriptionid\"}},\"friendlyName\":\"s-friendlyname\",\"kubernetesWorkloadProfile\":\"s-kubernetesworkloadprofile\",\"modelDescription\":\"s-modeldescription\",\"nodeCount\":7,\"resourceMoveDetails\":{\"operationInProgress\":\"s-operationinprogress\",\"operationInProgressLockTimeoutInUTC\":\"2026-11-06T10:00:00Z\"},\"serialNumber\":\"s-serialnumber\",\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"timeZone\":\"s-timezone\"},\"sku\":{\"name\":\"s-name\",\"tier\":\"s-tier\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL DevicesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", DevicesClientListByResourceGroupOptions{expand: Some("s-expand")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_devices_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_29)
}

fn show_devices_client_list_by_subscription_response(r: DevicesClientListBySubscriptionResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.device_list).to_str_lossy()}")
  parts.join(" ")
}

