fn show_volumes_client_list_by_volume_group_response(r: VolumesClientListByVolumeGroupResponse) -> Str {
  var parts: List[Str] = []
  parts.push("body=${runtime.marshal_json(r.volume_list).to_str_lossy()}")
  parts.join(" ")
}

