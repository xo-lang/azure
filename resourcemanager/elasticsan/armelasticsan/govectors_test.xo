test "Go's VolumesClient.NewListByVolumeGroupPager" {
  let f = gv_new_fake(os.net)
  let c = new_volumes_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"creationData\":{\"createSource\":\"s-createsource\",\"sourceId\":\"s-sourceid\"},\"managedBy\":{\"resourceId\":\"s-resourceid\"},\"provisioningState\":\"Succeeded\",\"sizeGiB\":7,\"storageTarget\":{\"provisioningState\":\"Succeeded\",\"status\":\"s-status\",\"targetIqn\":\"s-targetiqn\",\"targetPortalHostname\":\"s-targetportalhostname\",\"targetPortalPort\":7},\"volumeId\":\"s-volumeid\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL VolumesClient.NewListByVolumeGroupPager")
  var pg = c.new_list_by_volume_group_pager("id1/ x", "id2/ x", "id3/ x", VolumesClientListByVolumeGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_volumes_client_list_by_volume_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_28)
}
