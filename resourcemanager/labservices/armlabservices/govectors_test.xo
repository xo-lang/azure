test "Go's ImagesClient.NewListByLabPlanPager" {
  let f = gv_new_fake(os.net)
  let c = new_images_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"author\":\"s-author\",\"availableRegions\":[\"s-availableregions\"],\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"enabledState\":\"s-enabledstate\",\"iconUrl\":\"s-iconurl\",\"offer\":\"s-offer\",\"osState\":\"s-osstate\",\"osType\":\"s-ostype\",\"plan\":\"s-plan\",\"provisioningState\":\"Succeeded\",\"publisher\":\"s-publisher\",\"sharedGalleryId\":\"s-sharedgalleryid\",\"sku\":\"s-sku\",\"termsStatus\":\"s-termsstatus\",\"version\":\"s-version\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ImagesClient.NewListByLabPlanPager")
  var pg = c.new_list_by_lab_plan_pager("id1/ x", "id2/ x", ImagesClientListByLabPlanOptions{filter: Some("s-filter")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_images_client_list_by_lab_plan_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_2)
}

