test "Go's RegistrationDefinitionsClient.NewListPager" {
  let f = gv_new_fake(os.net)
  let c = new_registration_definitions_client(os.net, os.clock, os.rand, GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"plan\":{\"name\":\"s-name\",\"product\":\"s-product\",\"publisher\":\"s-publisher\",\"version\":\"s-version\"},\"properties\":{\"authorizations\":[{\"delegatedRoleDefinitionIds\":[\"s-delegatedroledefinitionids\"],\"principalId\":\"s-principalid\",\"principalIdDisplayName\":\"s-principaliddisplayname\",\"roleDefinitionId\":\"s-roledefinitionid\"}],\"description\":\"s-description\",\"eligibleAuthorizations\":[{\"justInTimeAccessPolicy\":{\"maximumActivationDuration\":\"s-maximumactivationduration\",\"multiFactorAuthProvider\":\"s-multifactorauthprovider\"},\"principalId\":\"s-principalid\",\"principalIdDisplayName\":\"s-principaliddisplayname\",\"roleDefinitionId\":\"s-roledefinitionid\"}],\"managedByTenantId\":\"s-managedbytenantid\",\"managedByTenantName\":\"s-managedbytenantname\",\"manageeTenantId\":\"s-manageetenantid\",\"manageeTenantName\":\"s-manageetenantname\",\"provisioningState\":\"Succeeded\",\"registrationDefinitionName\":\"s-registrationdefinitionname\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL RegistrationDefinitionsClient.NewListPager")
  var pg = c.new_list_pager("id1/ x", RegistrationDefinitionsClientListOptions{filter: Some("s-filter")}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_registration_definitions_client_list_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_13)
}
