test "Go's Client.NewListByParentPager" {
  let f = gv_new_fake(os.net)
  let c = new_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"hostName\":\"s-hostname\",\"includedBurstIOPerSec\":7,\"maxBurstIOPerSecCredits\":7,\"mediaTier\":\"s-mediatier\",\"mountName\":\"s-mountname\",\"nfsProtocolProperties\":{\"encryptionInTransitRequired\":\"s-encryptionintransitrequired\",\"rootSquash\":\"s-rootsquash\"},\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"type\":\"s-type\"}],\"protocol\":\"s-protocol\",\"provisionedIOPerSec\":7,\"provisionedIOPerSecNextAllowedDowngrade\":\"2026-11-06T10:00:00Z\",\"provisionedStorageGiB\":7,\"provisionedStorageNextAllowedDowngrade\":\"2026-11-06T10:00:00Z\",\"provisionedThroughputMiBPerSec\":7,\"provisionedThroughputNextAllowedDowngrade\":\"2026-11-06T10:00:00Z\",\"provisioningState\":\"Succeeded\",\"publicAccessProperties\":{\"allowedSubnets\":[\"s-allowedsubnets\"]},\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"redundancy\":\"s-redundancy\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL Client.NewListByParentPager")
  var pg = c.new_list_by_parent_pager("id1/ x", ClientListByParentOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_client_list_by_parent_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_5)
}

