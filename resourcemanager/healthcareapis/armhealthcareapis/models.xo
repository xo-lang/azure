/// ServiceManagedIdentityIdentityPatch: ServiceManagedIdentityIdentity in a PATCH body, each field Absent (left out), Null (removed) or a value.
pub struct ServiceManagedIdentityIdentityPatch {
  /// The service principal ID of the system assigned identity. This property will only be provided for a system assigned identity.
  pub principal_id as "principalId,omitempty": json.Patch[Str] = json.Patch.Absent
  /// The tenant ID of the system assigned identity. This property will only be provided for a system assigned identity.
  pub tenant_id as "tenantId,omitempty": json.Patch[Str] = json.Patch.Absent
  /// Type of identity being specified, currently SystemAssigned and None are allowed.
  pub type_ as "type,omitempty": json.Patch[ServiceManagedIdentityType] = json.Patch.Absent
  pub user_assigned_identities as "userAssignedIdentities,omitempty": json.Patch[Map[Str, UserAssignedIdentity]] = json.Patch.Absent
} derive Json

/// `m` as a patch: each set field a value, each unset one Absent.
pub fn (m: ServiceManagedIdentityIdentity) patch() -> ServiceManagedIdentityIdentityPatch {
  ServiceManagedIdentityIdentityPatch{
    type_: match m.type_ {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    principal_id: match m.principal_id {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    tenant_id: match m.tenant_id {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
    user_assigned_identities: match m.user_assigned_identities {
      Some(x) => json.Patch.Value(x)
      None => json.Patch.Absent
    },
  }
}
