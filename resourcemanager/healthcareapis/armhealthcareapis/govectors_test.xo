  "OUT page 2: body={\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}",
]

test "Go's WorkspacesClient.NewListBySubscriptionPager" {
  let f = gv_new_fake(os.net)
  let c = new_workspaces_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL WorkspacesClient.NewListBySubscriptionPager")
  var pg = c.new_list_by_subscription_pager(WorkspacesClientListBySubscriptionOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_workspaces_client_list_by_subscription_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_45)
}
