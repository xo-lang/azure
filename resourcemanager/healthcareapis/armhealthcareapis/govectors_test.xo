  let c = new_services_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\"},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"accessPolicies\":[{\"objectId\":\"s-objectid\"}],\"acrConfiguration\":{\"loginServers\":[\"s-loginservers\"],\"ociArtifacts\":[{\"digest\":\"s-digest\",\"imageName\":\"s-imagename\",\"loginServer\":\"s-loginserver\"}]},\"authenticationConfiguration\":{\"audience\":\"s-audience\",\"authority\":\"s-authority\",\"smartProxyEnabled\":true},\"corsConfiguration\":{\"allowCredentials\":true,\"headers\":[\"s-headers\"],\"maxAge\":7,\"methods\":[\"s-methods\"],\"origins\":[\"s-origins\"]},\"cosmosDbConfiguration\":{\"crossTenantCmkApplicationId\":\"s-crosstenantcmkapplicationid\",\"keyVaultKeyUri\":\"s-keyvaultkeyuri\",\"offerThroughput\":7},\"exportConfiguration\":{\"storageAccountName\":\"s-storageaccountname\"},\"importConfiguration\":{\"enabled\":true,\"initialImportMode\":true,\"integrationDataStore\":\"s-integrationdatastore\"},\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\"},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL ServicesClient.NewListByResourceGroupPager")
  var pg = c.new_list_by_resource_group_pager("id1/ x", ServicesClientListByResourceGroupOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_services_client_list_by_resource_group_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_32)
}

