test "Go's FhirServicesClient.NewListByWorkspacePager" {
  let f = gv_new_fake(os.net)
  let c = new_fhir_services_client(os.net, os.clock, os.rand, "sub-test", GvCred{}, gv_opts()) ?? e => fault(e)
  gv_set(f, 200, "{\"nextLink\":\"https://management.example.test/next?\$skiptoken=2\",\"value\":[{\"etag\":\"s-etag\",\"id\":\"s-id\",\"identity\":{\"principalId\":\"s-principalid\",\"tenantId\":\"s-tenantid\",\"type\":\"s-type\",\"userAssignedIdentities\":{\"k1\":{\"clientId\":\"s-clientid\",\"principalId\":\"s-principalid\"}}},\"kind\":\"s-kind\",\"location\":\"s-location\",\"name\":\"s-name\",\"properties\":{\"acrConfiguration\":{\"loginServers\":[\"s-loginservers\"],\"ociArtifacts\":[{\"digest\":\"s-digest\",\"imageName\":\"s-imagename\",\"loginServer\":\"s-loginserver\"}]},\"authenticationConfiguration\":{\"audience\":\"s-audience\",\"authority\":\"s-authority\",\"smartIdentityProviders\":[{\"authority\":\"s-authority\"}],\"smartProxyEnabled\":true},\"corsConfiguration\":{\"allowCredentials\":true,\"headers\":[\"s-headers\"],\"maxAge\":7,\"methods\":[\"s-methods\"],\"origins\":[\"s-origins\"]},\"encryption\":{\"customerManagedKeyEncryption\":{\"keyEncryptionKeyUrl\":\"s-keyencryptionkeyurl\"}},\"eventState\":\"s-eventstate\",\"exportConfiguration\":{\"storageAccountName\":\"s-storageaccountname\"},\"implementationGuidesConfiguration\":{\"usCoreMissingData\":true},\"importConfiguration\":{\"enabled\":true,\"initialImportMode\":true,\"integrationDataStore\":\"s-integrationdatastore\"},\"privateEndpointConnections\":[{\"id\":\"s-id\",\"name\":\"s-name\",\"properties\":{\"provisioningState\":\"Succeeded\"},\"type\":\"s-type\"}],\"provisioningState\":\"Succeeded\",\"publicNetworkAccess\":\"s-publicnetworkaccess\",\"resourceVersionPolicyConfiguration\":{\"default\":\"s-default\",\"resourceTypeOverrides\":{\"k1\":\"s-resourcetypeoverrides\"}}},\"systemData\":{\"createdAt\":\"2026-11-06T10:00:00Z\",\"createdBy\":\"s-createdby\",\"createdByType\":\"s-createdbytype\",\"lastModifiedAt\":\"2026-11-06T10:00:00Z\",\"lastModifiedBy\":\"s-lastmodifiedby\",\"lastModifiedByType\":\"s-lastmodifiedbytype\"},\"tags\":{\"k1\":\"s-tags\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL FhirServicesClient.NewListByWorkspacePager")
  var pg = c.new_list_by_workspace_pager("id1/ x", "id2/ x", FhirServicesClientListByWorkspaceOptions{}) ?? e => fault("${e}")
  for page in [1, 2] {
    if !pg.more() {
      gv_note(f, "OUT page ${page}: no more")
      break
    }
    match pg.next_page() {
      Ok(r) => gv_note(f, "OUT page ${page}: ${show_fhir_services_client_list_by_workspace_response(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT page ${page}: error: ${gv_err_text(e)}")
        break
      }
    }
  }
  gv_compare(gv_log_of(f), GO_10)
}

