// Decision 0013: query/azlogs' spans against Go's. A Go program
// (query/azlogs v1.2.0, azcore v1.24.0, a recording tracing.Provider
// over a fake transport; local only) printed TRACE_GO
// (tracevectors_test.xo).

use github.com/xo-lang/azure/cloud
use github.com/xo-lang/azure/policy

const TR_BAD: Str = "{\"error\":{\"code\":\"BadArgumentError\",\"message\":\"bad query\"}}"
const TR_RESULTS: Str = "{\"tables\":[{\"name\":\"PrimaryResult\",\"columns\":[{\"name\":\"x\",\"type\":\"long\"}],\"rows\":[[1]]}]}"

fn tr_client(net: Net, clock: Clock, rand: Rand, log: TrLog) -> Client[()] {
  let c = cloud.Configuration{authority_host: "https://login.example.test/", services: {SERVICE_NAME: cloud.ServiceConfiguration{audience: "https://logs.example.test", endpoint: "https://logs.example.test"}}}
  new_client(net, clock, rand, Cred{log: Mutex[List[Str]].new([])}, ClientOptions{client: policy.ClientOptions{cloud: c, tracing_provider: tr_provider(log), retry: policy.RetryOptions{max_retries: -1}}}).ok() ?? fault("client")
}

test "spans as Go's query/azlogs v1.2.0 makes them" {
  let log = tr_new_log(os.net, ["logs.example.test"])
  let q = QueryBody{query: Some("T | take 1")}

  tr_replies(log, [tr_r(200, TR_RESULTS)])
  tr_dump(log, "azlogs query workspace", tr_err(tr_client(os.net, os.clock, os.rand, log).query_workspace("ws1", q)))

  tr_replies(log, [])
  tr_dump(log, "azlogs query workspace empty id", tr_err(tr_client(os.net, os.clock, os.rand, log).query_workspace("", q)))

  tr_replies(log, [tr_r(400, TR_BAD)])
  tr_dump(log, "azlogs query resource 400", tr_err(tr_client(os.net, os.clock, os.rand, log).query_resource("subscriptions/s1/resourceGroups/g/providers/P/x/n", q)))

  tr_replies(log, [tr_r(200, "{\"responses\":[]}")])
  tr_dump(log, "azlogs query batch", tr_err(tr_client(os.net, os.clock, os.rand, log).query_batch(BatchRequest{requests: [BatchQueryRequest{body: Some(q), id: Some("1"), workspace_id: Some("ws1")}]})))

  // Known difference: an invalid input's error says "invalid input: "
  // first (azcore.CallErr's display, decision 0013); the span's status
  // has the message alone, as Go's.
  tr_compare(tr_got(log), TRACE_GO, known: [
    ("  ERR \"parameter workspaceID cannot be empty\"", "  ERR \"invalid input: parameter workspaceID cannot be empty\""),
  ])
}
