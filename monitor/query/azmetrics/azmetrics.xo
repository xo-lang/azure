// Azure Monitor metrics queries over many resources, a port of Go's
// sdk/monitor/query/azmetrics v1.3.0 (client.go, custom_client.go,
// cloud_config.go, models.go, time_rfc3339.go; MIT, Copyright (c)
// Microsoft Corporation; NOTICE.md): the regional metrics:getBatch API
// (REST API version 2024-02-01).

use std/json
use std/url
use std/path
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/cloud
use github.com/xo-lang/azure/policy
use github.com/xo-lang/azure/runtime

pub const MODULE: Str = "azmetrics"
pub const VERSION: Str = "v0.1.0"
/// The REST API version; `policy.ClientOptions.api_version` overrides it.
pub const API_VERSION: Str = "2024-02-01"

/// The key of this service in `cloud.Configuration.services` (Go's
/// ServiceName).
pub const SERVICE_NAME: Str = "query/azmetrics"

/// The token audience of each Azure cloud, as Go's cloud_config.go adds
/// them to azcore's clouds.
fn builtin_audience(c: cloud.Configuration) -> Str? {
  if c == cloud.AZURE_PUBLIC {
    Some("https://metrics.monitor.azure.com")
  } else if c == cloud.AZURE_CHINA {
    Some("https://metrics.monitor.azure.cn")
  } else if c == cloud.AZURE_GOVERNMENT {
    Some("https://metrics.monitor.azure.us")
  } else {
    None
  }
}

/// Options of new_client.
pub struct ClientOptions {
  pub client: policy.ClientOptions = policy.ClientOptions{}
}

/// Client queries the metrics of many resources in one region.
pub struct Client {
  pipeline: runtime.Pipeline
  endpoint: Str
  api_version: Str
}

/// A client for the regional endpoint `endpoint`
/// (`https://<region>.metrics.monitor.azure.com`). The cloud's
/// `SERVICE_NAME` entry gives the token audience; Azure's three clouds
/// have one built in, and another cloud without it is Go's error.
pub fn new_client(net: Net, clock: Clock, rand: Rand, endpoint: Str, cred: azcore.TokenCredential, opts: ClientOptions = ClientOptions{}) -> Client ! Str {
  let c = opts.client.cloud
  let audience = match c.services.get(SERVICE_NAME) {
    Some(s) => s.audience
    None => builtin_audience(c) ?? ""
  }
  if audience == "" {
    return Err("provided Cloud field is missing Azure Monitor Metrics configuration")
  }
  let auth = runtime.new_bearer_token_policy(cred, ["${audience}/.default"], clock)
  // Go's api-version policy sets the query parameter and encodes the
  // query sorted; the request below does the same, so the pipeline's
  // policy (which appends it) is not used
  let api = if opts.client.api_version != "" { opts.client.api_version } else { API_VERSION }
  let pl = runtime.new_pipeline(MODULE, VERSION, net, clock, rand, runtime.PipelineOptions{per_retry: [auth]}, opts.client with {api_version: ""})
  Ok(Client{pipeline: pl, endpoint: endpoint, api_version: api})
}

/// Options of Client.query_resources: each is a query parameter when set.
pub struct QueryResourcesOptions {
  /// The aggregations, comma separated (`average,total`).
  pub aggregation: Str? = None
  /// The end of the time span, ISO 8601 (`2026-11-05T01:00:00Z`).
  pub end_time: Str? = None
  /// An OData filter on the dimensions (`GeoType eq '*'`).
  pub filter: Str? = None
  /// The interval of the time grain, ISO 8601 (`PT1M`).
  pub interval: Str? = None
  /// The aggregation to sort by and its direction (`total desc`).
  pub order_by: Str? = None
  /// The dimension to roll up by.
  pub roll_up_by: Str? = None
  /// The start of the time span, ISO 8601.
  pub start_time: Str? = None
  /// The maximum number of records per dimension.
  pub top: Int? = None
}

fn (c: Client) query_request(subscription_id: Str, metric_namespace: Str, metric_names: List[Str], resource_ids: ResourceIDList, o: QueryResourcesOptions) -> policy.Request ! azcore.CallErr {
  if subscription_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter subscriptionID cannot be empty"))
  }
  let u = join_paths(c.endpoint, "/subscriptions/${url.path_escape(subscription_id)}/metrics:getBatch")
  let (base, raw) = u.cut("?") ?? (u, "")
  var q = url.parse_query(raw).ok() ?? url.values()
  for (name, v) in [("aggregation", o.aggregation), ("endtime", o.end_time), ("filter", o.filter), ("interval", o.interval), ("orderby", o.order_by), ("rollupby", o.roll_up_by), ("starttime", o.start_time), ("top", o.top.map(fn(n: Int) -> Str { "${n}" }))] {
    if let Some(x) = v {
      q.set(name, x)
    }
  }
  q.set("api-version", c.api_version)
  q.set("metricnames", metric_names.join(","))
  q.set("metricnamespace", metric_namespace)
  Ok(policy.Request{method: "POST", url: "${base}?${q.encode()}", headers: [("Accept", "application/json"), ("Content-Type", "application/json")], body: json.encode_str(resource_ids).bytes()})
}

/// The metrics `metric_names` of namespace `metric_namespace` for the
/// resources in `resource_ids`, all in subscription `subscription_id` and
/// the client's region.
pub fn (c: Client) query_resources(subscription_id: Str, metric_namespace: Str, metric_names: List[Str], resource_ids: ResourceIDList, options: QueryResourcesOptions = QueryResourcesOptions{}) -> MetricResults ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.query_request(subscription_id, metric_namespace, metric_names, resource_ids, options)?
  let resp = c.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if resp.status != 200 {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  json.decode_str[MetricResults](resp.body.to_str_lossy()) ?? e => Err(azcore.CallErr.Decode("unmarshalling type MetricResults: ${e.display()}"))
}

/// `root` with `segment` joined to its path, its query kept after it
/// (Go's runtime.JoinPaths with one path).
fn join_paths(root: Str, segment: Str) -> Str {
  var r = root
  var qps = ""
  if r.contains("?") {
    // Go splits on every "?" and keeps the first two parts
    let parts = r.split("?")
    r = parts[0]
    qps = parts[1]
  }
  var p = if segment == "" { "" } else { path.clean(segment) }
  if segment.ends_with("/") && !p.ends_with("/") {
    p = p + "/"
  }
  if qps != "" {
    p = if p.contains("?") { "${p}&${qps}" } else { "${p}?${qps}" }
  }
  if r.ends_with("/") && p.starts_with("/") {
    r = r[0..r.len() - 1]
  } else if !r.ends_with("/") && !p.starts_with("/") && !p.starts_with("?") {
    p = "/" + p
  }
  r + p
}
