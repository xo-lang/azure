// The models of Go's azmetrics v1.3.0 (models.go, models_serde.go,
// constants.go). Fields are in the order Go's MarshalJSON writes them
// (its keys sorted), and a time stamp is read as Go's dateTimeRFC3339
// reads it: one without an offset is UTC.

use github.com/xo-lang/azure/azcore

/// The unit of a metric (Go's MetricUnit).
pub type MetricUnit struct(Str)
pub const METRIC_UNIT_BITS_PER_SECOND: MetricUnit = MetricUnit("BitsPerSecond")
pub const METRIC_UNIT_BYTE_SECONDS: MetricUnit = MetricUnit("ByteSeconds")
pub const METRIC_UNIT_BYTES: MetricUnit = MetricUnit("Bytes")
pub const METRIC_UNIT_BYTES_PER_SECOND: MetricUnit = MetricUnit("BytesPerSecond")
pub const METRIC_UNIT_CORES: MetricUnit = MetricUnit("Cores")
pub const METRIC_UNIT_COUNT: MetricUnit = MetricUnit("Count")
pub const METRIC_UNIT_COUNT_PER_SECOND: MetricUnit = MetricUnit("CountPerSecond")
pub const METRIC_UNIT_MILLI_CORES: MetricUnit = MetricUnit("MilliCores")
pub const METRIC_UNIT_MILLI_SECONDS: MetricUnit = MetricUnit("MilliSeconds")
pub const METRIC_UNIT_NANO_CORES: MetricUnit = MetricUnit("NanoCores")
pub const METRIC_UNIT_PERCENT: MetricUnit = MetricUnit("Percent")
pub const METRIC_UNIT_SECONDS: MetricUnit = MetricUnit("Seconds")
pub const METRIC_UNIT_UNSPECIFIED: MetricUnit = MetricUnit("Unspecified")

/// The values of MetricUnit this version knows; the service may send others.
pub fn possible_metric_unit_values() -> List[MetricUnit] {
  [METRIC_UNIT_BITS_PER_SECOND, METRIC_UNIT_BYTE_SECONDS, METRIC_UNIT_BYTES, METRIC_UNIT_BYTES_PER_SECOND, METRIC_UNIT_CORES, METRIC_UNIT_COUNT, METRIC_UNIT_COUNT_PER_SECOND, METRIC_UNIT_MILLI_CORES, METRIC_UNIT_MILLI_SECONDS, METRIC_UNIT_NANO_CORES, METRIC_UNIT_PERCENT, METRIC_UNIT_SECONDS, METRIC_UNIT_UNSPECIFIED]
}

/// The resources to query (Go's ResourceIDList; `resourceids` is left
/// out when empty, where Go writes `[]` for a non-nil empty slice).
pub struct ResourceIDList {
  pub resource_ids as "resourceids,omitempty": List[Str] = []
} derive Json

/// A name and its localized form.
pub struct LocalizableString {
  pub localized_value as "localizedValue,omitempty": Str? = None
  pub value as "value,omitempty": Str? = None
} derive Json

/// A dimension's name and value.
pub struct MetadataValue {
  pub name as "name,omitempty": LocalizableString? = None
  pub value as "value,omitempty": Str? = None
} derive Json

/// One data point.
pub struct MetricValue {
  pub average as "average,omitempty": Float? = None
  pub count as "count,omitempty": Float? = None
  pub maximum as "maximum,omitempty": Float? = None
  pub minimum as "minimum,omitempty": Float? = None
  pub time_stamp as "timeStamp,omitempty": azcore.DateTime? = None
  pub total as "total,omitempty": Float? = None
} derive Json

/// The data points of one combination of dimension values.
pub struct TimeSeriesElement {
  pub data as "data,omitempty": List[MetricValue]? = None
  pub metadata_values as "metadatavalues,omitempty": List[MetadataValue]? = None
} derive Json

/// One metric of one resource.
pub struct Metric {
  pub display_description as "displayDescription,omitempty": Str? = None
  pub error_code as "errorCode,omitempty": Str? = None
  pub error_message as "errorMessage,omitempty": Str? = None
  pub id as "id,omitempty": Str? = None
  pub name as "name,omitempty": LocalizableString? = None
  pub time_series as "timeseries,omitempty": List[TimeSeriesElement]? = None
  pub type_ as "type,omitempty": Str? = None
  pub unit as "unit,omitempty": MetricUnit? = None
} derive Json

/// The metrics of one resource.
pub struct MetricData {
  pub end_time as "endtime,omitempty": Str? = None
  pub interval as "interval,omitempty": Str? = None
  pub namespace as "namespace,omitempty": Str? = None
  pub resource_id as "resourceid,omitempty": Str? = None
  pub resource_region as "resourceregion,omitempty": Str? = None
  pub start_time as "starttime,omitempty": Str? = None
  pub values as "value,omitempty": List[Metric]? = None
} derive Json

/// The metrics of every resource queried (Go's MetricResults).
pub struct MetricResults {
  pub values as "values,omitempty": List[MetricData]? = None
} derive Json
