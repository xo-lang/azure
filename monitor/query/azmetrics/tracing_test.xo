// Decision 0013: azmetrics' spans against Go's. A Go program (azmetrics
// v1.3.0, azcore v1.24.0, a recording tracing.Provider over a fake
// transport; local only) printed TRACE_GO (tracevectors_test.xo).

use github.com/xo-lang/azure/cloud
use github.com/xo-lang/azure/policy

test "spans as Go's azmetrics v1.3.0 makes them" {
  let log = tr_new_log(os.net, ["eastus.metrics.example.test"])
  let c = cloud.Configuration{authority_host: "https://login.example.test/", services: {SERVICE_NAME: cloud.ServiceConfiguration{audience: "https://metrics.example.test", endpoint: ""}}}
  let client = new_client(os.net, os.clock, os.rand, "https://eastus.metrics.example.test", Cred{log: Mutex[List[Str]].new([])}, ClientOptions{client: policy.ClientOptions{cloud: c, tracing_provider: tr_provider(log), retry: policy.RetryOptions{max_retries: -1}}}).ok() ?? fault("client")

  tr_replies(log, [tr_r(200, "{\"values\":[]}")])
  tr_dump(log, "azmetrics query resources", tr_err(client.query_resources("s1", "Microsoft.Storage/storageAccounts", ["Ingress"], ResourceIDList{resource_ids: ["/subscriptions/s1/x"]})))

  tr_compare(tr_got(log), TRACE_GO)
}
