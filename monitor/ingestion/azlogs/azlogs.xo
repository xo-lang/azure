// Azure Monitor Logs ingestion, a port of Go's
// sdk/monitor/ingestion/azlogs v1.1.0 (client.go, custom_client.go,
// cloud_config.go; MIT, Copyright (c) Microsoft Corporation; NOTICE.md):
// upload logs to a data collection endpoint (REST API version
// 2023-01-01).

use std/url
use std/path
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/cloud
use github.com/xo-lang/azure/policy
use github.com/xo-lang/azure/runtime

pub const MODULE: Str = "azlogs"
pub const VERSION: Str = "v0.1.0"
/// The REST API version of Upload.
pub const API_VERSION: Str = "2023-01-01"

/// The key of this service in `cloud.Configuration.services` (Go's
/// ServiceNameIngestion).
pub const SERVICE_NAME: Str = "ingestion/azlogs"

/// The token audience of each Azure cloud, as Go's cloud_config.go adds
/// them to azcore's clouds (`https://monitor.azure.com/`, with its slash,
/// so the scope is `https://monitor.azure.com//.default` as Go asks).
fn builtin_audience(c: cloud.Configuration) -> Str? {
  if c == cloud.AZURE_PUBLIC {
    Some("https://monitor.azure.com/")
  } else if c == cloud.AZURE_CHINA {
    Some("https://monitor.azure.cn/")
  } else if c == cloud.AZURE_GOVERNMENT {
    Some("https://monitor.azure.us/")
  } else {
    None
  }
}

/// Options of new_client.
pub struct ClientOptions[fx: Effects] {
  pub client: policy.ClientOptions[fx] = policy.ClientOptions{}
}

/// Client uploads logs to one data collection endpoint.
pub struct Client[fx: Effects] {
  pipeline: runtime.Pipeline[fx]
  endpoint: Str
}

/// A client for the data collection endpoint `endpoint`
/// (`https://<dce>.<region>.ingest.monitor.azure.com`). The cloud's
/// `SERVICE_NAME` entry gives the token audience; Azure's three clouds
/// have one built in, and another cloud without it is Go's error.
pub fn new_client[fx: Effects](net: Net, clock: Clock, rand: Rand, endpoint: Str, cred: azcore.TokenCredential[fx], opts: ClientOptions[fx] = ClientOptions{}) -> Client[fx] ! Str {
  let c = opts.client.cloud
  let audience = match c.services.get(SERVICE_NAME) {
    Some(s) => s.audience
    None => builtin_audience(c) ?? ""
  }
  if audience == "" {
    return Err("provided Cloud field is missing Azure Monitor Ingestion configuration")
  }
  let auth = runtime.new_bearer_token_policy(cred, ["${audience}/.default"], clock)
  let pl = runtime.new_pipeline(MODULE, VERSION, net, clock, rand, runtime.PipelineOptions{per_retry: [auth]}, opts.client)
  Ok(Client{pipeline: pl, endpoint: endpoint})
}

/// Options of Client.upload.
pub struct UploadOptions {
  /// The body's `Content-Encoding`, `gzip` when the logs are gzipped.
  pub content_encoding: Str? = None
}

/// The response of Client.upload (the service answers 204 with no body).
pub struct UploadResponse {
}

fn (c: Client) upload_request(rule_id: Str, stream_name: Str, logs: Bytes, options: UploadOptions) -> policy.Request ! azcore.CallErr {
  if rule_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter ruleID cannot be empty"))
  }
  if stream_name == "" {
    return Err(azcore.CallErr.InvalidInput("parameter streamName cannot be empty"))
  }
  let p = "/dataCollectionRules/${url.path_escape(rule_id)}/streams/${url.path_escape(stream_name)}"
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  if let Some(e) = options.content_encoding {
    headers.push(("Content-Encoding", e))
  }
  headers.push(("Content-Type", "application/json"))
  Ok(policy.Request{method: "POST", url: with_query(join_paths(c.endpoint, p), "api-version", API_VERSION), headers: headers, body: logs})
}

/// Uploads `logs`, a JSON array of records (gzipped with
/// `content_encoding: Some("gzip")`), to stream `stream_name` of data
/// collection rule `rule_id` (its immutable ID). Only a 204 succeeds.
pub fn (c: Client) upload(rule_id: Str, stream_name: Str, logs: Bytes, options: UploadOptions = UploadOptions{}) -> UploadResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.upload_request(rule_id, stream_name, logs, options)?
  let resp = c.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if resp.status != 204 {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  Ok(UploadResponse{})
}

/// `root` with `segment` joined to its path, its query kept after it
/// (Go's runtime.JoinPaths with one path).
fn join_paths(root: Str, segment: Str) -> Str {
  var r = root
  var qps = ""
  if r.contains("?") {
    // Go splits on every "?" and keeps the first two parts
    let parts = r.split("?")
    r = parts[0]
    qps = parts[1]
  }
  var p = if segment == "" { "" } else { path.clean(segment) }
  if segment.ends_with("/") && !p.ends_with("/") {
    p = p + "/"
  }
  if qps != "" {
    p = if p.contains("?") { "${p}&${qps}" } else { "${p}?${qps}" }
  }
  if r.ends_with("/") && p.starts_with("/") {
    r = r[0..r.len() - 1]
  } else if !r.ends_with("/") && !p.starts_with("/") && !p.starts_with("?") {
    p = "/" + p
  }
  r + p
}

/// `u` with query parameter `name` set, the query encoded as Go's
/// url.Values.Encode writes it (keys sorted).
fn with_query(u: Str, name: Str, value: Str) -> Str {
  let (base, raw) = u.cut("?") ?? (u, "")
  var q = url.parse_query(raw).ok() ?? url.values()
  q.set(name, value)
  "${base}?${q.encode()}"
}
