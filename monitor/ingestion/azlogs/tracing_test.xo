// Decision 0013: ingestion/azlogs' spans against Go's. A Go program
// (ingestion/azlogs v1.1.0, azcore v1.24.0, a recording
// tracing.Provider over a fake transport; local only) printed TRACE_GO
// (tracevectors_test.xo).

use github.com/xo-lang/azure/cloud
use github.com/xo-lang/azure/policy

const TR_BAD: Str = "{\"error\":{\"code\":\"BadArgumentError\",\"message\":\"bad query\"}}"

fn tr_client(net: Net, clock: Clock, rand: Rand, log: TrLog) -> Client[()] {
  let c = cloud.Configuration{authority_host: "https://login.example.test/", services: {SERVICE_NAME: cloud.ServiceConfiguration{audience: "https://ingest.example.test", endpoint: ""}}}
  new_client(net, clock, rand, "https://dce.ingest.example.test", Cred{log: Mutex[List[Str]].new([])}, ClientOptions{client: policy.ClientOptions{cloud: c, tracing_provider: tr_provider(log), retry: policy.RetryOptions{max_retries: -1}}}).ok() ?? fault("client")
}

test "spans as Go's ingestion/azlogs v1.1.0 makes them" {
  let log = tr_new_log(os.net, ["dce.ingest.example.test"])

  tr_replies(log, [tr_r(204)])
  tr_dump(log, "ingestion upload", tr_err(tr_client(os.net, os.clock, os.rand, log).upload("dcr-1", "Custom-S", "[{\"a\":1}]".bytes())))

  tr_replies(log, [tr_r(400, TR_BAD)])
  tr_dump(log, "ingestion upload 400", tr_err(tr_client(os.net, os.clock, os.rand, log).upload("dcr-1", "Custom-S", "[{\"a\":1}]".bytes())))

  tr_compare(tr_got(log), TRACE_GO)
}
