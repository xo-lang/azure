// The metrics models of Go's azquery v1.2.0 (models.go, models_serde.go,
// constants.go). Fields are in the order Go's MarshalJSON writes them
// (its keys sorted), and a time stamp is read as Go's dateTimeRFC3339
// reads it: one without an offset is UTC.

use github.com/xo-lang/azure/azcore

/// An aggregation of a metric (Go's AggregationType).
pub type AggregationType struct(Str)
pub const AGGREGATION_TYPE_AVERAGE: AggregationType = AggregationType("Average")
pub const AGGREGATION_TYPE_COUNT: AggregationType = AggregationType("Count")
pub const AGGREGATION_TYPE_MAXIMUM: AggregationType = AggregationType("Maximum")
pub const AGGREGATION_TYPE_MINIMUM: AggregationType = AggregationType("Minimum")
pub const AGGREGATION_TYPE_NONE: AggregationType = AggregationType("None")
pub const AGGREGATION_TYPE_TOTAL: AggregationType = AggregationType("Total")

/// The values of AggregationType this version knows; the service may send others.
pub fn possible_aggregation_type_values() -> List[AggregationType] {
  [AGGREGATION_TYPE_AVERAGE, AGGREGATION_TYPE_COUNT, AGGREGATION_TYPE_MAXIMUM, AGGREGATION_TYPE_MINIMUM, AGGREGATION_TYPE_NONE, AGGREGATION_TYPE_TOTAL]
}

/// The class of a metric (Go's MetricClass).
pub type MetricClass struct(Str)
pub const METRIC_CLASS_AVAILABILITY: MetricClass = MetricClass("Availability")
pub const METRIC_CLASS_ERRORS: MetricClass = MetricClass("Errors")
pub const METRIC_CLASS_LATENCY: MetricClass = MetricClass("Latency")
pub const METRIC_CLASS_SATURATION: MetricClass = MetricClass("Saturation")
pub const METRIC_CLASS_TRANSACTIONS: MetricClass = MetricClass("Transactions")

/// The values of MetricClass this version knows; the service may send others.
pub fn possible_metric_class_values() -> List[MetricClass] {
  [METRIC_CLASS_AVAILABILITY, METRIC_CLASS_ERRORS, METRIC_CLASS_LATENCY, METRIC_CLASS_SATURATION, METRIC_CLASS_TRANSACTIONS]
}

/// The kind of a metric namespace (Go's NamespaceClassification).
pub type NamespaceClassification struct(Str)
pub const NAMESPACE_CLASSIFICATION_CUSTOM: NamespaceClassification = NamespaceClassification("Custom")
pub const NAMESPACE_CLASSIFICATION_PLATFORM: NamespaceClassification = NamespaceClassification("Platform")
pub const NAMESPACE_CLASSIFICATION_QOS: NamespaceClassification = NamespaceClassification("Qos")

/// The values of NamespaceClassification this version knows; the service may send others.
pub fn possible_namespace_classification_values() -> List[NamespaceClassification] {
  [NAMESPACE_CLASSIFICATION_CUSTOM, NAMESPACE_CLASSIFICATION_PLATFORM, NAMESPACE_CLASSIFICATION_QOS]
}

/// What a metrics query returns (Go's ResultType).
pub type ResultType struct(Str)
pub const RESULT_TYPE_DATA: ResultType = ResultType("Data")
pub const RESULT_TYPE_METADATA: ResultType = ResultType("Metadata")

/// The values of ResultType this version knows; the service may send others.
pub fn possible_result_type_values() -> List[ResultType] {
  [RESULT_TYPE_DATA, RESULT_TYPE_METADATA]
}

/// The unit of a metric (Go's MetricUnit).
pub type MetricUnit struct(Str)
pub const METRIC_UNIT_BITS_PER_SECOND: MetricUnit = MetricUnit("BitsPerSecond")
pub const METRIC_UNIT_BYTE_SECONDS: MetricUnit = MetricUnit("ByteSeconds")
pub const METRIC_UNIT_BYTES: MetricUnit = MetricUnit("Bytes")
pub const METRIC_UNIT_BYTES_PER_SECOND: MetricUnit = MetricUnit("BytesPerSecond")
pub const METRIC_UNIT_CORES: MetricUnit = MetricUnit("Cores")
pub const METRIC_UNIT_COUNT: MetricUnit = MetricUnit("Count")
pub const METRIC_UNIT_COUNT_PER_SECOND: MetricUnit = MetricUnit("CountPerSecond")
pub const METRIC_UNIT_MILLI_CORES: MetricUnit = MetricUnit("MilliCores")
pub const METRIC_UNIT_MILLI_SECONDS: MetricUnit = MetricUnit("MilliSeconds")
pub const METRIC_UNIT_NANO_CORES: MetricUnit = MetricUnit("NanoCores")
pub const METRIC_UNIT_PERCENT: MetricUnit = MetricUnit("Percent")
pub const METRIC_UNIT_SECONDS: MetricUnit = MetricUnit("Seconds")
pub const METRIC_UNIT_UNSPECIFIED: MetricUnit = MetricUnit("Unspecified")

/// The values of MetricUnit this version knows; the service may send others.
pub fn possible_metric_unit_values() -> List[MetricUnit] {
  [METRIC_UNIT_BITS_PER_SECOND, METRIC_UNIT_BYTE_SECONDS, METRIC_UNIT_BYTES, METRIC_UNIT_BYTES_PER_SECOND, METRIC_UNIT_CORES, METRIC_UNIT_COUNT, METRIC_UNIT_COUNT_PER_SECOND, METRIC_UNIT_MILLI_CORES, METRIC_UNIT_MILLI_SECONDS, METRIC_UNIT_NANO_CORES, METRIC_UNIT_PERCENT, METRIC_UNIT_SECONDS, METRIC_UNIT_UNSPECIFIED]
}

/// A name and its localized form.
pub struct LocalizableString {
  pub localized_value as "localizedValue,omitempty": Str? = None
  pub value as "value,omitempty": Str? = None
} derive Json

/// A dimension's name and value.
pub struct MetadataValue {
  pub name as "name,omitempty": LocalizableString? = None
  pub value as "value,omitempty": Str? = None
} derive Json

/// One data point.
pub struct MetricValue {
  pub average as "average,omitempty": Float? = None
  pub count as "count,omitempty": Float? = None
  pub maximum as "maximum,omitempty": Float? = None
  pub minimum as "minimum,omitempty": Float? = None
  pub time_stamp as "timeStamp,omitempty": azcore.DateTime? = None
  pub total as "total,omitempty": Float? = None
} derive Json

/// The data points of one combination of dimension values.
pub struct TimeSeriesElement {
  pub data as "data,omitempty": List[MetricValue]? = None
  pub metadata_values as "metadatavalues,omitempty": List[MetadataValue]? = None
} derive Json

/// One metric of one resource.
pub struct Metric {
  pub display_description as "displayDescription,omitempty": Str? = None
  pub error_code as "errorCode,omitempty": Str? = None
  pub error_message as "errorMessage,omitempty": Str? = None
  pub id as "id,omitempty": Str? = None
  pub name as "name,omitempty": LocalizableString? = None
  pub time_series as "timeseries,omitempty": List[TimeSeriesElement]? = None
  pub type_ as "type,omitempty": Str? = None
  pub unit as "unit,omitempty": MetricUnit? = None
} derive Json

/// A resource's metrics (Go's Response).
pub struct Response {
  /// The query's cost.
  pub cost as "cost,omitempty": Int? = None
  /// The time grain of the data.
  pub interval as "interval,omitempty": Str? = None
  pub namespace as "namespace,omitempty": Str? = None
  pub resource_region as "resourceregion,omitempty": Str? = None
  /// The time span of the data.
  pub timespan as "timespan,omitempty": TimeInterval? = None
  pub value as "value,omitempty": List[Metric]? = None
} derive Json

/// A time grain and how long its data is kept.
pub struct MetricAvailability {
  pub retention as "retention,omitempty": Str? = None
  pub time_grain as "timeGrain,omitempty": Str? = None
} derive Json

/// What a metric is and how it can be queried.
pub struct MetricDefinition {
  pub category as "category,omitempty": Str? = None
  pub dimensions as "dimensions,omitempty": List[LocalizableString]? = None
  pub display_description as "displayDescription,omitempty": Str? = None
  pub id as "id,omitempty": Str? = None
  pub is_dimension_required as "isDimensionRequired,omitempty": Bool? = None
  pub metric_availabilities as "metricAvailabilities,omitempty": List[MetricAvailability]? = None
  pub metric_class as "metricClass,omitempty": MetricClass? = None
  pub name as "name,omitempty": LocalizableString? = None
  pub namespace as "namespace,omitempty": Str? = None
  pub primary_aggregation_type as "primaryAggregationType,omitempty": AggregationType? = None
  pub resource_id as "resourceId,omitempty": Str? = None
  pub supported_aggregation_types as "supportedAggregationTypes,omitempty": List[AggregationType]? = None
  pub unit as "unit,omitempty": MetricUnit? = None
} derive Json

/// A resource's metric definitions.
pub struct MetricDefinitionCollection {
  pub value as "value,omitempty": List[MetricDefinition]? = None
} derive Json

/// The fully qualified name of a metric namespace.
pub struct MetricNamespaceName {
  pub metric_namespace_name as "metricNamespaceName,omitempty": Str? = None
} derive Json

/// A metric namespace of a resource.
pub struct MetricNamespace {
  pub classification as "classification,omitempty": NamespaceClassification? = None
  pub id as "id,omitempty": Str? = None
  pub name as "name,omitempty": Str? = None
  pub properties as "properties,omitempty": MetricNamespaceName? = None
  pub type_ as "type,omitempty": Str? = None
} derive Json

/// A resource's metric namespaces.
pub struct MetricNamespaceCollection {
  pub value as "value,omitempty": List[MetricNamespace]? = None
} derive Json
