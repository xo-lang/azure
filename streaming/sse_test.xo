// Edges Go's program cannot reach: a `retry` past the longest Duration
// (Go would sleep it), and the whole-body reader.

test "a retry past the longest Duration waits the longest Duration" {
  let r = SSEReader[Bytes, ()]{connect: fn(s: Str) -> Body? ! SSEErr { Ok(None) }, decode: fn(f: SSEFrame) -> Decoded[Bytes] ! Str { Ok(Decoded.Stop) }, reconnect: true, clock: os.clock, retry: 9223372036855}
  expect(r.reopen_delay()) == Duration.from_nanos(9223372036854775807)
  expect((r with {retry: 9223372036854}).reopen_delay()) == Duration.from_millis(9223372036854)
  expect((r with {retry: -1}).reopen_delay()) == 3s
}

test "a whole body is read in pieces, then ends" {
  let b = bytes_body(b"abcde")
  expect(b.read(2)) == Ok(Some(b"ab"))
  expect(b.read(10)) == Ok(Some(b"cde"))
  expect(b.read(10)) == Ok(None)
  let c = bytes_body(b"xyz")
  c.close()
  expect(c.read(10)) == Ok(None)
}
