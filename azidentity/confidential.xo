// The OAuth 2.0 client credentials grant at the Entra ID token endpoint
// (`<authority>/<tenant>/oauth2/v2.0/token`), shared by the secret,
// certificate and workload identity credentials, with a token cache per
// credential. azidentity uses MSAL Go for this; only this
// grant is needed (decision 0003). Behavior follows azidentity and MSAL
// Go (MIT, Copyright (c) Microsoft Corporation; NOTICE.md).

use std/http
use std/json
use std/url
use std/uuid
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/policy
use github.com/xo-lang/azure/runtime

pub const VERSION: Str = "v0.1.0"

/// Options every credential takes.
pub struct Options {
  /// The pipeline options of the credential's own requests; `cloud`
  /// gives the authority host.
  pub client: policy.ClientOptions[()] = policy.ClientOptions{}
  /// Tenants besides the credential's that a token may be asked for;
  /// `*` allows any.
  pub additionally_allowed_tenants: List[Str] = []
  /// Skip instance discovery: no `common/discovery/instance` lookups, the
  /// tenant's OpenID configuration read straight from the authority
  /// (Go's DisableInstanceDiscovery; for disconnected clouds and Azure
  /// Stack).
  pub disable_instance_discovery: Bool = false
}

/// A credential that asks the token endpoint for an app's tokens.
pub struct Confidential {
  pub name: Str
  pub tenant_id: Str
  pub client_id: Str
  pub authority_host: Str
  pub allowed: List[Str]
  pub pipeline: runtime.Pipeline[()]
  pub clock: Clock
  rand: Rand
  cache: Mutex[List[(Str, azcore.AccessToken)]]
  disable_discovery: Bool
  /// Hosts whose instance metadata a cache read has fetched, per MSAL
  /// client (`cae|host`).
  hosts: Mutex[Map[Str, Bool]]
  /// Token endpoints resolved per MSAL client and tenant (`cae|tenant`).
  endpoints: Mutex[Map[Str, Str]]
  /// Workload identity's Azure Kubernetes token proxy: every request
  /// goes to it.
  pub proxy: TokenProxy? = None
}

/// `u` as sent: to the token proxy when there is one.
fn (c: Confidential) target(u: Str) -> Str {
  match c.proxy {
    Some(p) => p.rewrite(u)
    None => u
  }
}

/// Sends `req` through the pipeline; with a token proxy, to the proxy
/// on its client, with the URL's own authority as the Host (Go's
/// transport keeps Request.Host while it rewrites the URL).
fn (c: Confidential) send(req: policy.Request) -> http.Response ! policy.SendErr uses (net.dial, clock, rand) {
  match c.proxy {
    Some(p) => policy.Next{policies: c.pipeline.policies, transport: p.current()}.send(req with {url: p.rewrite(req.url), host: authority_of(req.url)})
    None => c.pipeline.send(req)
  }
}

/// The host and port of an absolute URL (Go's URL.Host).
fn authority_of(u: Str) -> Str {
  let after = u.cut("://").map(fn(x: (Str, Str)) -> Str { x.1 }) ?? u
  let end = after.find("/") ?? after.find("?") ?? after.len()
  let a = after[0..end]
  match a.cut("@") {
    Some((_, h)) => h
    None => a
  }
}

/// Go's error for a tenant that is not a tenant ID or domain.
pub const INVALID_TENANT: Str = "invalid tenantID. You can locate your tenantID by following the instructions listed here: https://learn.microsoft.com/partner-center/find-ids-and-domain-names"

/// The troubleshooting guide's section of each credential (azidentity's
/// tsgAnchors).
fn tsg_link(name: Str) -> Str {
  let anchor = match name {
    "AzurePipelinesCredential" => "apc"
    "ClientCertificateCredential" => "client-cert"
    "ManagedIdentityCredential" => "managed-id"
    "ClientSecretCredential" => "client-secret"
    "WorkloadIdentityCredential" => "workload"
    _ => return ""
  }
  "To troubleshoot, visit https://aka.ms/azsdk/go/identity/troubleshoot#${anchor}"
}

const SEPARATOR: Str = "--------------------------------------------------------------------------------"

/// azidentity's AuthenticationFailedError for an error response to
/// `method url`: the request line (scheme, host and path), the status,
/// the body (indented when it is JSON) and the troubleshooting link.
pub fn auth_failed(name: Str, method: Str, u: Str, resp: http.Response, message: Str = "") -> azcore.AuthErr {
  let raw = resp.body.to_str_lossy()
  let body = if raw == "" { "Response contained no body" } else {
    // json.indent keeps the text's trailing white space, as Go's
    json.indent(raw) ?? _ => raw
  }
  let link = tsg_link(name)
  let text = "${name} authentication failed. ${message}\n${method} ${azcore.redacted_url(u)}\n${SEPARATOR}\nRESPONSE ${resp.status}: ${resp.status} ${azcore.status_text(resp.status)}\n${SEPARATOR}\n${body}\n${SEPARATOR}${if link == "" { "" } else { "\n${link}" }}"
  let code = match json.parse_value(raw) {
    Ok(doc) => str_field(doc, "error")
    Err(_) => ""
  }
  azcore.AuthErr{credential: name, msg: "HTTP ${resp.status} ${code}".trim(), text: text, status: resp.status, failed: true}
}

/// Whether `t` can be a tenant id or domain (azidentity's check).
pub fn valid_tenant(t: Str) -> Bool {
  t != "" && t.runes().all(fn(r: Rune) -> Bool { (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') || r == '-' || r == '.' })
}

pub fn confidential(name: Str, tenant_id: Str, client_id: Str, net: Net, clock: Clock, rand: Rand, opts: Options) -> Confidential ! azcore.AuthErr {
  if !valid_tenant(tenant_id) {
    return Err(azcore.AuthErr{credential: name, msg: "invalid tenantID", text: INVALID_TENANT})
  }
  let host = opts.client.cloud.authority_host
  Ok(Confidential{
    name: name,
    tenant_id: tenant_id,
    client_id: client_id,
    authority_host: if host.ends_with("/") { host } else { "${host}/" },
    allowed: opts.additionally_allowed_tenants,
    pipeline: runtime.new_pipeline("azidentity", VERSION, net, clock, rand, runtime.PipelineOptions{}, opts.client),
    clock: clock,
    rand: rand,
    cache: Mutex.new([]),
    disable_discovery: opts.disable_instance_discovery,
    hosts: Mutex.new({}),
    endpoints: Mutex.new({}),
  })
}

/// The tenant a request is for: the credential's, or an allowed other.
pub fn (c: Confidential) tenant_for(opts: azcore.TokenRequestOptions) -> Str ! azcore.AuthErr {
  if opts.tenant_id == "" || opts.tenant_id == c.tenant_id {
    return Ok(c.tenant_id)
  }
  if c.allowed.contains("*") || c.allowed.contains(opts.tenant_id) {
    return Ok(opts.tenant_id)
  }
  Err(azcore.AuthErr{credential: c.name, msg: "tenant ${opts.tenant_id} is not allowed", text: "${c.name} isn't configured to acquire tokens for tenant ${json.encode_str(opts.tenant_id)}. To enable acquiring tokens for this tenant add it to the AdditionallyAllowedTenants on the credential options, or add \"*\" to allow acquiring tokens for any tenant"})
}

/// The hosts MSAL Go trusts without instance discovery (its
/// aadTrustedHostList).
pub const TRUSTED_HOSTS: List[Str] = [
  "login.windows.net",
  "login.partner.microsoftonline.cn",
  "login.chinacloudapi.cn",
  "login.microsoftonline.de",
  "login-us.microsoftonline.com",
  "login.microsoftonline.us",
  "login.microsoftonline.com",
  "login.microsoft.com",
  "sts.windows.net",
  "login.usgovcloudapi.net",
  "login.sovcloud-identity.fr",
  "login.sovcloud-identity.de",
  "login.sovcloud-identity.sg",
]

/// The authority's host (with its port), lower case.
fn (c: Confidential) host() -> Str {
  let rest = c.authority_host.cut("://").map(fn(p: (Str, Str)) -> Str { p.1 }) ?? c.authority_host
  (rest.cut("/").map(fn(p: (Str, Str)) -> Str { p.0 }) ?? rest).to_lower()
}

/// MSAL's instance discovery request for `tenant`: at the authority's
/// host when MSAL trusts it, else at login.microsoftonline.com.
fn (c: Confidential) discovery_url(tenant: Str) -> Str {
  let h = c.host()
  let at = if TRUSTED_HOSTS.contains(h) { h } else { "login.microsoftonline.com" }
  "https://${at}/common/discovery/instance?api-version=1.1&authorization_endpoint=${url.query_escape("https://${h}/${tenant}/oauth2/v2.0/authorize")}"
}

/// A GET as MSAL sends one (its client-request-id headers). Go's URL
/// for the OpenID configuration ends in an empty query (`?`); Xo's URL
/// has no empty query, so that `?` is not sent.
fn (c: Confidential) msal_get(u: Str) -> http.Response ! policy.SendErr uses (net.dial, clock, rand) {
  c.send(policy.Request{method: "GET", url: u, headers: [("client-request-id", uuid.v4(c.rand).display()), ("return-client-request-id", "false")]})
}

/// azidentity's error without a response: `<credential>: <msg>` and the
/// troubleshooting link.
fn failed_text(name: Str, msg: Str) -> azcore.AuthErr {
  let link = tsg_link(name)
  let tail = if link == "" { "" } else if msg.ends_with(".") { " ${link}" } else { ". ${link}" }
  azcore.AuthErr{credential: name, msg: msg, text: "${name}: ${msg}${tail}", failed: true}
}

/// MSAL's cache read: the first for a host (per MSAL client) asks for
/// the host's instance metadata, unless discovery is off. Its failure
/// is not the caller's: MSAL goes on to ask for a token, and keeps a
/// fallback entry unless the host was invalid.
fn (c: Confidential) read_metadata(tenant: Str, cae: Bool) uses (net.dial, clock, rand) {
  if c.disable_discovery {
    return
  }
  let k = "${cae}|${c.host()}"
  if c.hosts.with_read(fn(m: Map[Str, Bool]) -> Bool { m.contains(k) }) {
    return
  }
  let keep = match c.msal_get(c.discovery_url(tenant)) {
    Ok(r) => !(r.status == 400 && r.body.to_str_lossy().contains("invalid_instance"))
    Err(_) => true
  }
  if keep {
    c.hosts.with(fn(var m: Map[Str, Bool]) { m[k] = true })
  }
}

/// The token endpoint of `tenant`, resolved as MSAL Go does once per
/// tenant (per MSAL client): instance discovery for a host MSAL does not
/// trust (unless off), then the tenant's OpenID configuration, whose
/// fields and issuer are checked.
pub fn (c: Confidential) endpoint(tenant: Str, cae: Bool = false) -> Str ! azcore.AuthErr uses (net.dial, clock, rand) {
  let k = "${cae}|${tenant}"
  if let Some(e) = c.endpoints.with_read(fn(m: Map[Str, Str]) -> Str? { m.get(k) }) {
    return Ok(e)
  }
  let h = c.host()
  let authority = "${c.authority_host}${tenant}/"
  var oidc = "${authority}v2.0/.well-known/openid-configuration"
  var aliases: List[Str] = []
  let unresolved = fn(m: Str) -> azcore.AuthErr { failed_text(c.name, "unable to resolve an endpoint: ${m}") }
  if !c.disable_discovery && !TRUSTED_HOSTS.contains(h) {
    let du = c.discovery_url(tenant)
    let r = c.msal_get(du) ?? e => return Err(unresolved(e.display()))
    if r.status != 200 {
      return Err(auth_failed(c.name, "GET", c.target(du), r))
    }
    let doc = json.parse_value(r.body.to_str_lossy()) ?? e => return Err(unresolved(e.display()))
    oidc = str_field(doc, "tenant_discovery_endpoint")
    if let Some(json.Value.List(ms)) = doc.get("metadata") {
      for m in ms {
        let names = match m.get("aliases") {
          Some(json.Value.List(xs)) => xs.map(fn(x: json.Value) -> Str { str_of_value(x) })
          _ => []
        }
        if names.any(fn(a: Str) -> Bool { a.to_lower() == h }) {
          aliases = names
          break
        }
      }
    }
  }
  let r = c.msal_get(oidc) ?? e => return Err(unresolved(e.display()))
  if r.status != 200 {
    return Err(auth_failed(c.name, "GET", c.target(oidc), r))
  }
  let doc = json.parse_value(r.body.to_str_lossy()) ?? e => return Err(unresolved(e.display()))
  let auth_ep = str_field(doc, "authorization_endpoint")
  let token_ep = str_field(doc, "token_endpoint")
  let issuer = str_field(doc, "issuer")
  let missing = if auth_ep == "" { "authorize endpoint was not found" } else if token_ep == "" { "token endpoint was not found" } else if issuer == "" { "issuer was not found" } else { "" }
  if missing != "" {
    return Err(unresolved("ResolveEndpoints(): TenantDiscoveryResponse: ${missing} in the openid configuration"))
  }
  if !issuer_matches(issuer, authority, aliases) {
    return Err(unresolved("ResolveEndpoints(): TenantDiscoveryResponse: issuer '${issuer}' does not match authority '${authority}' or any trusted/alias rule"))
  }
  let e = token_ep.replace("{tenant}", tenant)
  c.endpoints.with(fn(var m: Map[Str, Str]) { m[k] = e })
  Ok(e)
}

/// MSAL's ValidateIssuerMatchesAuthority: the same scheme and host, an
/// alias of the authority, a host MSAL trusts, or a regional authority
/// under the issuer's host.
fn issuer_matches(issuer: Str, authority: Str, aliases: List[Str]) -> Bool {
  let parts = fn(u: Str) -> (Str, Str) {
    let (scheme, rest) = u.cut("://") ?? return ("", "")
    (scheme.to_lower(), (rest.cut("/").map(fn(p: (Str, Str)) -> Str { p.0 }) ?? rest).to_lower())
  }
  let (is, ih) = parts(issuer)
  let (as_, ah) = parts(authority)
  if is == as_ && ih == ah {
    return true
  }
  aliases.any(fn(a: Str) -> Bool { a.to_lower() == ih }) || TRUSTED_HOSTS.contains(ih) || (ih != "" && ah.ends_with(".${ih}"))
}

/// A cached token for `opts`, if still fresh; never for a request with
/// claims (MSAL's WithClaims skips the cache). The read is MSAL's: the
/// first for the host fetches its instance metadata.
pub fn (c: Confidential) cached(tenant: Str, key: Str, opts: azcore.TokenRequestOptions) -> azcore.AccessToken? uses (net.dial, clock, rand) {
  if opts.claims != "" {
    return None
  }
  c.read_metadata(tenant, opts.enable_cae)
  let now = c.clock.now()
  c.cache.with_read(fn(xs: List[(Str, azcore.AccessToken)]) -> azcore.AccessToken? {
    for (k, t) in xs {
      if k == key && !azcore.needs_refresh(t, now) {
        return Some(t)
      }
    }
    None
  })
}

/// MSAL Go's scopes on every token request, after the caller's.
pub const MSAL_SCOPES: List[Str] = ["openid", "offline_access", "profile"]

/// Asks the token endpoint of `tenant` with the grant's `fields`
/// (client_secret, or client_assertion and its type), and caches it.
/// The form is MSAL Go's: its keys sorted (Go's url.Values.Encode), the
/// scopes followed by MSAL_SCOPES, `client_info=1` with an assertion,
/// and MSAL's `client-request-id` and `return-client-request-id` headers.
/// A token request with the client's `fields`; `grant` is MSAL's grant
/// type (an on-behalf-of request's is the JWT bearer grant), and every
/// grant but client credentials, or a client assertion, adds MSAL's
/// `client_info=1`.
pub fn (c: Confidential) request(tenant: Str, key: Str, opts: azcore.TokenRequestOptions, fields: List[(Str, Str)], grant: Str = "client_credentials") -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand) {
  Ok(c.request_rt(tenant, key, opts, fields, grant)?.0)
}

/// `request`, with the response's `refresh_token` ("" when it has none).
pub fn (c: Confidential) request_rt(tenant: Str, key: Str, opts: azcore.TokenRequestOptions, fields: List[(Str, Str)], grant: Str = "client_credentials") -> (azcore.AccessToken, Str) ! azcore.AuthErr uses (net.dial, clock, rand) {
  var form: List[(Str, Str)] = [("client_id", c.client_id), ("grant_type", grant), ("scope", (opts.scopes + MSAL_SCOPES).join(" "))]
  form = form + fields
  if grant != "client_credentials" || fields.any(fn(f: (Str, Str)) -> Bool { f.0 == "client_assertion" }) {
    form.push(("client_info", "1"))
  }
  let claims = merge_claims(opts.claims, opts.enable_cae) ?? e => return Err(azcore.AuthErr{credential: c.name, msg: e})
  if claims != "" {
    form.push(("claims", claims))
  }
  let body = form.sort_by(fn(f: (Str, Str)) -> Str { f.0 }).map(fn(f: (Str, Str)) -> Str { "${url.query_escape(f.0)}=${url.query_escape(f.1)}" }).join("&")
  let headers = [
    ("Content-Type", "application/x-www-form-urlencoded; charset=utf-8"),
    ("client-request-id", uuid.v4(c.rand).display()),
    ("return-client-request-id", "false"),
  ]
  let req = policy.Request{method: "POST", url: c.endpoint(tenant, opts.enable_cae)?, headers: headers, body: body.bytes()}
  let resp = c.send(req) ?? e => return Err(azcore.AuthErr{credential: c.name, msg: e.display(), failed: true})
  if resp.status != 200 {
    return Err(auth_failed(c.name, req.method, c.target(req.url), resp))
  }
  let t = parse_token_response(c.name, resp, c.clock.now())?
  c.cache.with(fn(var xs: List[(Str, azcore.AccessToken)]) {
    xs = xs.filter(fn(e: (Str, azcore.AccessToken)) -> Bool { e.0 != key })
    xs.push((key, t))
  })
  let rt = match json.parse_value(resp.body.to_str_lossy()) {
    Ok(doc) => str_field(doc, "refresh_token")
    Err(_) => ""
  }
  Ok((t, rt))
}

fn num_field(doc: json.Value, k: Str) -> Int? {
  match doc.get(k) {
    Some(json.Value.Int(n)) => Some(n)
    Some(json.Value.Num(f)) => Some(Int(f))
    Some(json.Value.Str(s)) => Int.parse(s)
    _ => None
  }
}

fn str_field(doc: json.Value, k: Str) -> Str {
  match doc.get(k) {
    Some(json.Value.Str(s)) => s
    _ => ""
  }
}

/// An OAuth token response (`access_token`, `expires_in`, `refresh_in`),
/// or the error it carries (`error`, `error_description`).
pub fn parse_token_response(name: Str, resp: http.Response, now: Time) -> azcore.AccessToken ! azcore.AuthErr {
  let doc = json.parse_value(resp.body.to_str_lossy()) ?? _ => return Err(azcore.AuthErr{credential: name, msg: "HTTP ${resp.status}: the token response is not JSON", failed: true})
  if resp.status != 200 {
    let code = str_field(doc, "error")
    let desc = str_field(doc, "error_description")
    return Err(azcore.AuthErr{credential: name, msg: "HTTP ${resp.status} ${code}: ${desc}".trim(), failed: true})
  }
  let token = str_field(doc, "access_token")
  if token == "" {
    return Err(azcore.AuthErr{credential: name, msg: "the token response has no access_token", failed: true})
  }
  let at = now.unix_millis()
  // managed identity endpoints send expires_on (epoch seconds) instead
  let expires = match num_field(doc, "expires_in") {
    Some(s) => Time.from_unix_millis(at + s * 1000)
    None => match num_field(doc, "expires_on") {
      Some(e) => Time.from_unix_millis(e * 1000)
      None => return Err(azcore.AuthErr{credential: name, msg: "the token response has no expires_in", failed: true})
    }
  }
  let refresh = num_field(doc, "refresh_in").map(fn(s: Int) -> Time { Time.from_unix_millis(at + s * 1000) })
  Ok(azcore.AccessToken{token: Secret.new(token), expires_on: expires, refresh_on: refresh})
}

/// The cache key of a token request; CAE tokens are kept apart, as
/// azidentity keeps a CAE client and a plain one.
pub fn key_of(tenant: Str, scopes: List[Str], cae: Bool = false) -> Str {
  "${if cae { "cae " } else { "" }}${tenant} ${scopes.join(" ")}"
}

/// The `claims` parameter: the challenge's claims, with MSAL's `CP1`
/// client capability under access_token.xms_cc when `cae`, as MSAL Go
/// merges them; "" when there is neither.
pub fn merge_claims(claims: Str, cae: Bool) -> Str ! Str {
  if claims == "" && !cae {
    return Ok("")
  }
  let doc = if claims == "" { json.Value.Object([]) } else { json.parse_value(claims) ?? e => return Err("the claims are not JSON: ${e.display()}") }
  if !cae {
    return Ok(doc.encode())
  }
  let fields = match doc {
    json.Value.Object(fs) => fs
    _ => return Err("the claims are not a JSON object")
  }
  let cc = ("xms_cc", json.Value.Object([("values", json.Value.List([json.Value.Str("CP1")]))]))
  var out: List[(Str, json.Value)] = []
  var had = false
  for (k, v) in fields {
    if k == "access_token" {
      had = true
      let inner = match v {
        json.Value.Object(fs) => fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != "xms_cc" })
        _ => []
      }
      out.push((k, json.Value.Object(inner + [cc])))
    } else {
      out.push((k, v))
    }
  }
  if !had {
    out.push(("access_token", json.Value.Object([cc])))
  }
  Ok(json.Value.Object(out).encode())
}

fn str_of_value(v: json.Value) -> Str {
  match v {
    json.Value.Str(s) => s
    _ => ""
  }
}
