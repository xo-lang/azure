// ClientSecretCredential, ClientCertificateCredential and
// WorkloadIdentityCredential, as azidentity's (MIT, Copyright (c)
// Microsoft Corporation; NOTICE.md). The certificate credential signs a
// client assertion as MSAL does: PS256, header `x5t#S256` (the SHA-256
// of the certificate's DER), claims aud (the token endpoint), iss and
// sub (the client id), jti (a UUID), nbf, exp (10 minutes).

use std/crypto
use std/jwt
use std/uuid
use std/x509
use github.com/xo-lang/azure/azcore

pub const ASSERTION_TYPE: Str = "urn:ietf:params:oauth:client-assertion-type:jwt-bearer"

pub struct ClientSecretCredential {
  c: Confidential
  secret: Secret[Str]
}

pub fn new_client_secret_credential(tenant_id: Str, client_id: Str, secret: Str, net: Net, clock: Clock, rand: Rand, opts: Options = Options{}) -> ClientSecretCredential ! azcore.AuthErr {
  if secret == "" {
    return Err(azcore.AuthErr{credential: "ClientSecretCredential", msg: "no client secret"})
  }
  Ok(ClientSecretCredential{c: confidential("ClientSecretCredential", tenant_id, client_id, net, clock, rand, opts)?, secret: Secret.new(secret)})
}

pub fn (s: ClientSecretCredential) get_token(opts: azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand) {
  let tenant = s.c.tenant_for(opts)?
  let key = key_of(tenant, opts.scopes)
  if let Some(t) = s.c.cached(key) {
    return Ok(t)
  }
  s.c.request(tenant, key, opts.scopes, [("client_secret", s.secret.reveal())])
}

/// The claims of a client assertion.
struct AssertionClaims {
  aud: Str
  iss: Str
  sub: Str
  jti: Str
  nbf: Int
  exp: Int
} derive Json

pub struct ClientCertificateCredential {
  c: Confidential
  thumbprint: Str
  key: crypto.PrivateKey
  rand: Rand
  /// The certificate chain's DER in base64, sent as x5c when asked.
  chain: List[Str] = []
}

/// The certificate's SHA-256 thumbprint in base64url, the `x5t#S256`
/// header.
pub fn thumbprint_s256(cert: x509.Certificate) -> Str {
  crypto.digest(crypto.Hash.Sha256, cert.raw).to_base64().replace("+", "-").replace("/", "_").trim_end_chars("=")
}

/// A credential from `certs` (the leaf first) and its private key.
/// `send_chain` sends the chain as x5c (subject name and issuer auth,
/// AZURE_CLIENT_SEND_CERTIFICATE_CHAIN).
pub fn new_client_certificate_credential(tenant_id: Str, client_id: Str, certs: List[x509.Certificate], key: crypto.PrivateKey, net: Net, clock: Clock, rand: Rand, send_chain: Bool = false, opts: Options = Options{}) -> ClientCertificateCredential ! azcore.AuthErr {
  let leaf = certs.first() ?? return Err(azcore.AuthErr{credential: "ClientCertificateCredential", msg: "no certificate"})
  Ok(ClientCertificateCredential{
    c: confidential("ClientCertificateCredential", tenant_id, client_id, net, clock, rand, opts)?,
    thumbprint: thumbprint_s256(leaf),
    key: key,
    rand: rand,
    chain: if send_chain { certs.map(fn(c: x509.Certificate) -> Str { c.raw.to_base64() }) } else { [] },
  })
}

/// The certificates and key in a PEM file's bytes (a `.pem` with the
/// certificate and an unencrypted PKCS #8, PKCS #1 or SEC 1 key).
pub fn parse_certificates(pem: Bytes) -> (List[x509.Certificate], crypto.PrivateKey) ! azcore.AuthErr {
  let name = "ClientCertificateCredential"
  let certs = x509.parse_pem(pem) ?? e => return Err(azcore.AuthErr{credential: name, msg: e.display()})
  if certs.is_empty() {
    return Err(azcore.AuthErr{credential: name, msg: "no CERTIFICATE block in the PEM data (a .pfx is not read yet: convert it with openssl pkcs12 -nodes)"})
  }
  let text = pem.to_str_lossy()
  var key: crypto.PrivateKey? = None
  for marker in ["PRIVATE KEY", "RSA PRIVATE KEY", "EC PRIVATE KEY"] {
    let begin = "-----BEGIN ${marker}-----"
    let end = "-----END ${marker}-----"
    if let Some(i) = text.find(begin) {
      if let Some(j) = text.find(end) {
        let b64 = text[i + begin.len()..j].split_where(fn(r: Rune) -> Bool { r == '\n' || r == '\r' || r == ' ' }).join("")
        let der = Bytes.from_base64(b64) ?? return Err(azcore.AuthErr{credential: name, msg: "the private key is not base64"})
        key = Some(crypto.parse_private_key(der) ?? e => return Err(azcore.AuthErr{credential: name, msg: e.display()}))
        break
      }
    }
  }
  let k = key ?? return Err(azcore.AuthErr{credential: name, msg: "no unencrypted PRIVATE KEY block in the PEM data"})
  Ok((certs, k))
}

/// A client assertion for `endpoint`, signed with `key`.
pub fn client_assertion(r: Rand, key: crypto.PrivateKey, thumbprint: Str, chain: List[Str], client_id: Str, endpoint: Str, now: Time) -> Str ! azcore.AuthErr uses rand {
  let secs = now.unix_millis() / 1000
  let claims = AssertionClaims{aud: endpoint, iss: client_id, sub: client_id, jti: uuid.v4(r).display(), nbf: secs, exp: secs + 600}
  jwt.sign(r, jwt.Alg.PS256, jwt.Key.Private(key), claims, header: {"x5t#S256": thumbprint}, x5c: chain) ?? e => Err(azcore.AuthErr{credential: "ClientCertificateCredential", msg: e.display()})
}

pub fn (c: ClientCertificateCredential) get_token(opts: azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand) {
  let tenant = c.c.tenant_for(opts)?
  let key = key_of(tenant, opts.scopes)
  if let Some(t) = c.c.cached(key) {
    return Ok(t)
  }
  let a = client_assertion(c.rand, c.key, c.thumbprint, c.chain, c.c.client_id, c.c.endpoint(tenant), c.c.clock.now())?
  c.c.request(tenant, key, opts.scopes, [("client_assertion_type", ASSERTION_TYPE), ("client_assertion", a)])
}

/// A federated token file (Kubernetes' projected service account token),
/// read when the credential is built and again by `watch`.
pub struct WorkloadIdentityCredential {
  c: Confidential
  pub file: Str
  token: Mutex[Secret[Str]]
}

pub fn new_workload_identity_credential(tenant_id: Str, client_id: Str, token_file: Str, fs: Fs, net: Net, clock: Clock, rand: Rand, opts: Options = Options{}) -> WorkloadIdentityCredential ! azcore.AuthErr uses fs.read {
  let name = "WorkloadIdentityCredential"
  let t = read_token(fs, token_file) ?? e => return Err(azcore.AuthErr{credential: name, msg: e})
  Ok(WorkloadIdentityCredential{c: confidential(name, tenant_id, client_id, net, clock, rand, opts)?, file: token_file, token: Mutex.new(Secret.new(t))})
}

fn read_token(fs: Fs, path: Str) -> Str ! Str uses fs.read {
  let b = fs.read(path) ?? e => return Err("reading ${path}: ${e.display()}")
  let s = (b.to_str() ?? "").trim()
  if s == "" {
    return Err("${path} is empty")
  }
  Ok(s)
}

/// Rereads the token file every `every` until cancelled: start it on a
/// group that lives as long as the program (`os.tasks.spawn_background(fn()
/// { cred.watch(os.fs, os.clock) })`), since Kubernetes rotates the token.
pub fn (w: WorkloadIdentityCredential) watch(fs: Fs, clock: Clock, every: Duration = 5m) uses (fs.read, clock) {
  while true {
    clock.sleep(every)
    if let Ok(t) = read_token(fs, w.file) {
      w.token.reset(Secret.new(t))
    }
  }
}

pub fn (w: WorkloadIdentityCredential) get_token(opts: azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand) {
  let tenant = w.c.tenant_for(opts)?
  let key = key_of(tenant, opts.scopes)
  if let Some(t) = w.c.cached(key) {
    return Ok(t)
  }
  let a = w.token.with_read(fn(s: Secret[Str]) -> Str { s.reveal() })
  w.c.request(tenant, key, opts.scopes, [("client_assertion_type", ASSERTION_TYPE), ("client_assertion", a)])
}
