// ClientSecretCredential, ClientCertificateCredential and
// WorkloadIdentityCredential, as azidentity's (MIT, Copyright (c)
// Microsoft Corporation; NOTICE.md). The certificate credential signs a
// client assertion as MSAL does: PS256, header `x5t#S256` (the SHA-256
// of the certificate's DER), claims aud (the token endpoint), iss and
// sub (the client id), jti (a UUID), nbf, exp (10 minutes).

use std/crypto
use std/jwt
use std/uuid
use std/x509
use github.com/xo-lang/azure/azcore

pub const ASSERTION_TYPE: Str = "urn:ietf:params:oauth:client-assertion-type:jwt-bearer"

pub struct ClientSecretCredential {
  c: Confidential
  secret: Secret[Str]
}

pub fn new_client_secret_credential(tenant_id: Str, client_id: Str, secret: Str, net: Net, clock: Clock, rand: Rand, opts: Options = Options{}) -> ClientSecretCredential ! azcore.AuthErr {
  if secret == "" {
    return Err(azcore.AuthErr{credential: "ClientSecretCredential", msg: "no client secret", text: "secret can't be empty string"})
  }
  Ok(ClientSecretCredential{c: confidential("ClientSecretCredential", tenant_id, client_id, net, clock, rand, opts)?, secret: Secret.new(secret)})
}

pub fn (s: ClientSecretCredential) get_token(opts: azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand) {
  let tenant = s.c.tenant_for(opts)?
  let key = key_of(tenant, opts.scopes, opts.enable_cae)
  if let Some(t) = s.c.cached(tenant, key, opts) {
    return Ok(t)
  }
  s.c.request(tenant, key, opts, [("client_secret", s.secret.reveal())])
}

/// The claims of a client assertion.
struct AssertionClaims {
  aud: Str
  iss: Str
  sub: Str
  jti: Str
  nbf: Int
  exp: Int
} derive Json

pub struct ClientCertificateCredential {
  c: Confidential
  thumbprint: Str
  key: crypto.PrivateKey
  rand: Rand
  /// The certificate chain's DER in base64, sent as x5c when asked.
  chain: List[Str] = []
}

/// The certificate's SHA-256 thumbprint as MSAL Go sends it in
/// `x5t#S256`: standard base64 with padding (MSAL's
/// base64.StdEncoding, not the base64url RFC 7515 names).
pub fn thumbprint_s256(cert: x509.Certificate) -> Str {
  crypto.digest(crypto.Hash.Sha256, cert.raw).to_base64()
}

/// azidentity's certificate errors are Go's plain errors: the text alone.
fn cert_err(m: Str) -> azcore.AuthErr {
  azcore.AuthErr{credential: "ClientCertificateCredential", msg: m, text: m}
}

/// A credential from `certs` and its RSA private key, as MSAL Go's
/// NewCredFromCert: the certificate whose public key is the key's signs
/// (`x5t#S256`), wherever it is in `certs`; with `send_chain` (subject
/// name and issuer auth, AZURE_CLIENT_SEND_CERTIFICATE_CHAIN) `x5c` is
/// that certificate followed by the others in order.
pub fn new_client_certificate_credential(tenant_id: Str, client_id: Str, certs: List[x509.Certificate], key: crypto.PrivateKey, net: Net, clock: Clock, rand: Rand, send_chain: Bool = false, opts: Options = Options{}) -> ClientCertificateCredential ! azcore.AuthErr {
  if certs.is_empty() {
    return Err(cert_err("at least one certificate is required"))
  }
  if key.alg() != crypto.KeyAlg.Rsa {
    return Err(cert_err("key must be an RSA key"))
  }
  let public = key.public_key()
  var leaf: x509.Certificate? = None
  var chain: List[Str] = []
  for c in certs {
    let der = c.raw.to_base64()
    if c.public_key == Some(public) {
      leaf = Some(c)
      chain = [der] + chain
    } else {
      chain.push(der)
    }
  }
  let l = leaf ?? return Err(cert_err("key doesn't match any certificate"))
  Ok(ClientCertificateCredential{
    c: confidential("ClientCertificateCredential", tenant_id, client_id, net, clock, rand, opts)?,
    thumbprint: thumbprint_s256(l),
    key: key,
    rand: rand,
    chain: if send_chain { chain } else { [] },
  })
}

/// How a private key's DER is laid out: `pkcs1`, `pkcs8`, `sec1` or
/// `?`, from the version INTEGER and the element after it.
fn key_der_kind(der: Bytes) -> Str {
  if der.len() < 2 || der[0] != 0x30 {
    return "?"
  }
  // the outer SEQUENCE's length takes 1 byte, or 1 + n for 0x8n
  let at = if der[1] < 0x80 { 2 } else { 2 + Int(der[1] & 0x7f) }
  if der.len() < at + 4 || der[at] != 0x02 || der[at + 1] != 0x01 {
    return "?"
  }
  let version = der[at + 2]
  let next = der[at + 3]
  if version == 0 && next == 0x30 { "pkcs8" } else if version == 0 && next == 0x02 { "pkcs1" } else if version == 1 && next == 0x04 { "sec1" } else { "?" }
}

/// Go's x509.ParsePKCS1PrivateKey: its error names the parser to use.
fn parse_pkcs1(der: Bytes) -> crypto.PrivateKey ! Str {
  match key_der_kind(der) {
    "pkcs1" => crypto.parse_private_key(der).map_err(fn(e: crypto.KeyErr) -> Str { e.display() })
    "pkcs8" => Err("x509: failed to parse private key (use ParsePKCS8PrivateKey instead for this key format)")
    "sec1" => Err("x509: failed to parse private key (use ParseECPrivateKey instead for this key format)")
    _ => Err("x509: failed to parse private key")
  }
}

/// The certificates and private key in a PEM file or a PKCS #12 file
/// (`.pfx`), as Go's ParseCertificates: with no password the PEM blocks,
/// else (or when there are none) the PKCS #12 file opened with
/// `password` (3DES and 40 bit RC2, as Go's golang.org/x/crypto/pkcs12;
/// an AES file is `pkcs12: algorithm ... is not supported`; an EC key in
/// one is refused, as Go's). A PEM key is a `PRIVATE KEY` (PKCS #8, else
/// PKCS #1) or `RSA PRIVATE KEY` block; Go skips `EC PRIVATE KEY`
/// blocks, and so does this. Errors are
/// Go's texts. A PKCS #12 file's certificates come back with the key's
/// certificate first, then the others in file order (Go keeps file
/// order); new_client_certificate_credential finds the key's certificate
/// either way.
pub fn parse_certificates(data: Bytes, password: Str = "") -> (List[x509.Certificate], crypto.PrivateKey) ! azcore.AuthErr {
  var blocks: List[crypto.PemBlock] = []
  if password == "" {
    blocks = crypto.pem_decode(data.to_str_lossy())
  }
  if blocks.is_empty() {
    let p = x509.parse_pkcs12(data, password) ?? e => return Err(cert_err(e.display()))
    // Go's ToPEM writes an EC key's SEC 1 DER in a PRIVATE KEY block,
    // which ParseCertificates then fails to read; it refuses any other
    // key that is not RSA
    if p.key.alg() == crypto.KeyAlg.Ed25519 {
      return Err(cert_err("found unknown private key type in PKCS#8 wrapping"))
    }
    if p.key.alg() != crypto.KeyAlg.Rsa {
      return Err(cert_err("x509: failed to parse private key (use ParseECPrivateKey instead for this key format)"))
    }
    return Ok(([p.certificate] + p.ca, p.key))
  }
  var certs: List[x509.Certificate] = []
  var key: crypto.PrivateKey? = None
  for b in blocks {
    match b.kind {
      "CERTIFICATE" => certs.push(x509.parse(b.bytes) ?? e => return Err(cert_err(e.display())))
      "PRIVATE KEY" => {
        if key.is_some() {
          return Err(cert_err("certData contains multiple private keys"))
        }
        key = Some(match crypto.parse_private_key(b.bytes) {
          Ok(k) if key_der_kind(b.bytes) == "pkcs8" => k
          _ => parse_pkcs1(b.bytes) ?? e => return Err(cert_err(e))
        })
      }
      "RSA PRIVATE KEY" => {
        if key.is_some() {
          return Err(cert_err("certData contains multiple private keys"))
        }
        key = Some(parse_pkcs1(b.bytes) ?? e => return Err(cert_err(e)))
      }
      _ => {}
    }
  }
  if certs.is_empty() {
    return Err(cert_err("found no certificate"))
  }
  let k = key ?? return Err(cert_err("found no private key"))
  Ok((certs, k))
}

/// A client assertion for `endpoint`, signed with `key`.
pub fn client_assertion(r: Rand, key: crypto.PrivateKey, thumbprint: Str, chain: List[Str], client_id: Str, endpoint: Str, now: Time) -> Str ! azcore.AuthErr uses rand {
  let secs = now.unix_millis() / 1000
  let claims = AssertionClaims{aud: endpoint, iss: client_id, sub: client_id, jti: uuid.v4(r).display(), nbf: secs, exp: secs + 600}
  jwt.sign(r, jwt.Alg.PS256, jwt.Key.Private(key), claims, header: {"x5t#S256": thumbprint}, x5c: chain) ?? e => Err(azcore.AuthErr{credential: "ClientCertificateCredential", msg: e.display()})
}

pub fn (c: ClientCertificateCredential) get_token(opts: azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand) {
  let tenant = c.c.tenant_for(opts)?
  let key = key_of(tenant, opts.scopes, opts.enable_cae)
  if let Some(t) = c.c.cached(tenant, key, opts) {
    return Ok(t)
  }
  let a = client_assertion(c.rand, c.key, c.thumbprint, c.chain, c.c.client_id, c.c.endpoint(tenant, opts.enable_cae)?, c.c.clock.now())?
  c.c.request(tenant, key, opts, [("client_assertion_type", ASSERTION_TYPE), ("client_assertion", a)])
}

/// A federated token file (Kubernetes' projected service account token),
/// read when the credential is built and again by `watch`.
pub struct WorkloadIdentityCredential {
  c: Confidential
  pub file: Str
  fs: Fs
  /// The file's text and when it is read again (Go's getAssertion: every
  /// 10 minutes, at the first token request after that).
  assertion: Mutex[(Secret[Str], Time?)]
}

/// The service principal `client_id` in `tenant_id`, its assertion the
/// Kubernetes service account token in `token_file`, read when a token is
/// first asked for and again 10 minutes after each read, so a rotated
/// token is picked up (Go's WorkloadIdentityCredential).
pub fn new_workload_identity_credential(tenant_id: Str, client_id: Str, token_file: Str, fs: Fs, net: Net, clock: Clock, rand: Rand, opts: Options = Options{}) -> WorkloadIdentityCredential ! azcore.AuthErr {
  Ok(WorkloadIdentityCredential{c: confidential(WI_NAME, tenant_id, client_id, net, clock, rand, opts)?, file: token_file, fs: fs, assertion: Mutex.new((Secret.new(""), None))})
}

pub fn (w: WorkloadIdentityCredential) get_token(opts: azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand, fs.read) {
  let tenant = w.c.tenant_for(opts)?
  let key = key_of(tenant, opts.scopes, opts.enable_cae)
  if let Some(t) = w.c.cached(tenant, key, opts) {
    return Ok(t)
  }
  w.c.endpoint(tenant, opts.enable_cae)?
  let a = w.assertion.with(fn(var cur: (Secret[Str], Time?)) -> Str ! azcore.AuthErr uses (clock, fs.read) {
    let now = w.c.clock.now()
    let fresh = match cur.1 {
      Some(at) => now < at
      None => false
    }
    if !fresh {
      // os.ReadFile's error names its operation; the text is sent as it is
      let b = w.fs.read(w.file) ?? e => return Err(failed_text(WI_NAME, "open ${e.display()}"))
      cur = (Secret.new(b.to_str_lossy()), Some(now + 10m))
    }
    Ok(cur.0.reveal())
  })?
  w.c.request(tenant, key, opts, [("client_assertion_type", ASSERTION_TYPE), ("client_assertion", a)])
}

/// A client assertion from a callback (Go's ClientAssertionCredential):
/// a JWT another identity provider signed, sent as `client_assertion`.
/// The callback runs only when no cached token fits, after the
/// tenant's endpoint is resolved; its error is the credential's
/// (`ClientAssertionCredential: <msg>`).
pub struct ClientAssertionCredential {
  c: Confidential
  get_assertion: fn() -> Str ! Str uses (net.dial, clock, rand)
}

pub fn new_client_assertion_credential(tenant_id: Str, client_id: Str, get_assertion: fn() -> Str ! Str uses (net.dial, clock, rand), net: Net, clock: Clock, rand: Rand, opts: Options = Options{}) -> ClientAssertionCredential ! azcore.AuthErr {
  Ok(ClientAssertionCredential{c: confidential("ClientAssertionCredential", tenant_id, client_id, net, clock, rand, opts)?, get_assertion: get_assertion})
}

pub fn (c: ClientAssertionCredential) get_token(opts: azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand) {
  let tenant = c.c.tenant_for(opts)?
  let key = key_of(tenant, opts.scopes, opts.enable_cae)
  if let Some(t) = c.c.cached(tenant, key, opts) {
    return Ok(t)
  }
  c.c.endpoint(tenant, opts.enable_cae)?
  let a = (c.get_assertion)() ?? e => return Err(failed_text(c.c.name, e))
  c.c.request(tenant, key, opts, [("client_assertion_type", ASSERTION_TYPE), ("client_assertion", a)])
}
