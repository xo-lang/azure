// UsernamePasswordCredential by hand (decision 0003, Amendment 2): the
// requests azidentity v1.15.0 makes through MSAL Go v1.10.1's
// AcquireTokenByUsernamePassword (MIT, Copyright (c) Microsoft
// Corporation; NOTICE.md). The user realm says how the account signs in:
// a managed account sends its password in the password grant; a
// federated one asks its WS-Trust 1.3 service (found in the realm's mex
// document) for a SAML assertion and sends that in the SAML grant. An
// ADFS authority (tenant `adfs`) takes the password grant with no realm.

use std/base64
use std/http
use std/json
use std/time
use std/url
use std/uuid
use std/xml
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/policy

/// UsernamePasswordCredential's options (Go's
/// UsernamePasswordCredentialOptions).
///
/// Deprecated: UsernamePasswordCredential is deprecated because it can't
/// support multifactor authentication. See https://aka.ms/azsdk/identity/mfa
/// for migration guidance.
pub struct UsernamePasswordCredentialOptions[fx: Effects] {
  pub opts: Options[fx] = Options{}
  /// An account signed in before, to start from silently.
  pub authentication_record: AuthenticationRecord = AuthenticationRecord{}
}

/// Authenticates a user with a password (Go's UsernamePasswordCredential).
/// Microsoft doesn't recommend this kind of authentication, because it's
/// less secure than other authentication flows. This credential is not
/// interactive, so it isn't compatible with any form of multifactor
/// authentication, and the application must already have user or admin
/// consent. It can only authenticate work and school accounts; it can't
/// authenticate Microsoft accounts.
///
/// Deprecated: this credential is deprecated because it can't support
/// multifactor authentication. See https://aka.ms/azsdk/identity/mfa for
/// migration guidance.
pub struct UsernamePasswordCredential[fx: Effects] {
  p: Public[fx]
  username: Str
  password: Secret[Str]
}

/// A UsernamePasswordCredential (Go's NewUsernamePasswordCredential):
/// `client_id` is the application the user signs in to.
///
/// Deprecated: see UsernamePasswordCredential.
pub fn new_username_password_credential[fx: Effects](tenant_id: Str, client_id: Str, username: Str, password: Str, net: Net, clock: Clock, rand: Rand, o: UsernamePasswordCredentialOptions[fx] = UsernamePasswordCredentialOptions{}) -> UsernamePasswordCredential[fx] ! azcore.AuthErr {
  let p = public_client("UsernamePasswordCredential", tenant_id, client_id, net, clock, rand, o.opts, o.authentication_record, false)?
  Ok(UsernamePasswordCredential{p: p, username: username, password: Secret.new(password)})
}

/// A token: silently when it can (the cached access token, then the
/// refresh token), else by the password.
pub fn (c: UsernamePasswordCredential[fx]) get_token(opts: azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand, fx) {
  let tenant = c.p.check(opts)?
  if let Ok(t) = c.p.silent(tenant, opts) {
    return Ok(t)
  }
  c.flow(opts)
}

/// Signs the user in once and gives the account (Go's Authenticate): no
/// silent request first. With no scopes, the cloud's Resource Manager
/// scope.
pub fn (c: UsernamePasswordCredential[fx]) authenticate(opts: azcore.TokenRequestOptions = azcore.TokenRequestOptions{scopes: []}) -> AuthenticationRecord ! azcore.AuthErr uses (net.dial, clock, rand, fx) {
  let o = c.p.auth_opts(opts)?
  c.flow(o)?
  Ok(c.p.record())
}

/// The account signed in last, as an AuthenticationRecord.
pub fn (c: UsernamePasswordCredential[fx]) record() -> AuthenticationRecord {
  c.p.record()
}

const SAML_V1_GRANT: Str = "urn:ietf:params:oauth:grant-type:saml1_1-bearer"
const SAML_V2_GRANT: Str = "urn:ietf:params:oauth:grant-type:saml2-bearer"

/// MSAL's UsernamePassword: the realm, then the grant the account takes.
fn (c: UsernamePasswordCredential[fx]) flow(opts: azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand, fx) {
  let p = c.p
  p.begin(opts.enable_cae)
  let name = p.c.name
  let tenant = p.c.tenant_for(opts)?
  let token_ep = p.c.endpoint(tenant, opts.enable_cae)?
  let pw = c.password.reveal()
  let fields = if tenant == ADFS_TENANT {
    [("password", pw), ("username", c.username)]
  } else {
    let realm = c.user_realm()?
    match realm.account_type {
      "Federated" => {
        let mex = c.mex(realm.federation_metadata_url)?
        let (grant, assertion) = c.saml(realm.cloud_audience_urn, mex)?
        return c.grant(tenant, opts, token_ep, [("assertion", base64.encode(assertion.bytes(), base64.Base64.Std)), ("password", pw), ("username", c.username)], grant)
      }
      "Managed" => [("password", pw), ("username", c.username)]
      _ => return Err(failed_text(name, "unknown account type"))
    }
  }
  c.grant(tenant, opts, token_ep, fields, "password")
}

/// The token request of `grant`; MSAL takes a 200 or 201 response.
fn (c: UsernamePasswordCredential[fx]) grant(tenant: Str, opts: azcore.TokenRequestOptions, token_ep: Str, fields: List[(Str, Str)], grant: Str) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand, fx) {
  let r = c.p.post_token(tenant, opts, fields, grant)?
  if r.status == 200 || r.status == 201 {
    return c.p.accept(tenant, opts, r)
  }
  Err(auth_failed(c.p.c.name, "POST", c.p.c.target(token_ep), r))
}

/// A GET as MSAL's XML and JSON calls send one, with `extra` headers.
fn (c: UsernamePasswordCredential[fx]) get(u: Str, extra: List[(Str, Str)]) -> http.Response ! azcore.AuthErr uses (net.dial, clock, rand) {
  let headers = extra + [("client-request-id", uuid.v4(c.p.c.rand).display()), ("return-client-request-id", "false")]
  c.p.c.send(policy.Request{method: "GET", url: u, headers: headers}) ?? e => Err(failed_text(c.p.c.name, e.display()))
}

/// MSAL's comm error for a response that is not 200 or 201 (its
/// CallErr): azidentity reports the response.
fn (c: UsernamePasswordCredential[fx]) call_err(method: Str, u: Str, r: http.Response) -> azcore.AuthErr? {
  if r.status == 200 || r.status == 201 {
    return None
  }
  Some(auth_failed(c.p.c.name, method, c.p.c.target(u), r))
}

/// The user realm (MSAL's UserRealm): how the account signs in.
struct UserRealm {
  account_type: Str = ""
  domain_name: Str = ""
  cloud_instance_name: Str = ""
  cloud_audience_urn: Str = ""
  federation_protocol: Str = ""
  federation_metadata_url: Str = ""
}

/// The realm of the user, from the authority host's
/// `common/UserRealm/<user>`, checked as MSAL's validate does.
fn (c: UsernamePasswordCredential[fx]) user_realm() -> UserRealm ! azcore.AuthErr uses (net.dial, clock, rand) {
  let name = c.p.c.name
  let base = "https://${c.p.c.host()}/common/UserRealm/${url.path_escape(c.username)}"
  let r = c.get("${base}?api-version=1.0", [])?
  if let Some(e) = c.call_err("GET", base, r) {
    return Err(e)
  }
  let realm_err = fn(m: Str) -> azcore.AuthErr { failed_text(name, "problem getting user realm from authority: ${m}") }
  let raw = r.body.to_str_lossy()
  let u = msal_realm(raw) ?? e => return Err(realm_err("json decode error: ${e}\njson message bytes were: ${raw}"))
  let missing = if u.account_type == "" {
    "the account type (Federated or Managed) is missing"
  } else if u.domain_name == "" {
    "domain name of user realm is missing"
  } else if u.cloud_instance_name == "" {
    "cloud instance name of user realm is missing"
  } else if u.cloud_audience_urn == "" {
    "cloud Instance URN is missing"
  } else if u.account_type == "Federated" && u.federation_protocol == "" {
    "federation protocol of user realm is missing"
  } else if u.account_type == "Federated" && u.federation_metadata_url == "" {
    "federation metadata URL of user realm is missing"
  } else {
    ""
  }
  if missing != "" {
    return Err(realm_err(missing))
  }
  Ok(u)
}

/// MSAL's JSON decode of the realm: a token at a time, as Go's
/// json.Decoder reads it, so what follows the object is never read; an
/// empty body is an empty realm; the field names match exactly.
fn msal_realm(raw: Str) -> UserRealm ! Str {
  var u = UserRealm{}
  if raw == "" {
    return Ok(u)
  }
  var r = json.tokens(raw.bytes())
  let first = r.next() ?? e => return Err(go_token_err(e))
  match first {
    Some(json.Token.ObjectStart) => ()
    Some(t) => return Err("Unmarshal expected opening {, received ${token_text(t)}")
    None => return Err("EOF")
  }
  while r.more() {
    let key = match r.next() ?? e => return Err(go_token_err(e)) {
      Some(json.Token.Key(k)) => k
      _ => return Err("EOF")
    }
    // MSAL reads the value with Decode, whose check of the colon has its
    // own text
    let v = r.value() ?? e => {
      let m = go_token_err(e)
      return Err(if m.starts_with("invalid character ") && m.ends_with("' after object key") { "expected colon after object key" } else { m })
    }
    let known = ["account_type", "domain_name", "cloud_instance_name", "cloud_audience_urn", "federation_protocol", "federation_metadata_url"]
    if !known.contains(key) {
      // MSAL keeps it in AdditionalFields
      continue
    }
    let type_name = if key == "account_type" { "authority.UserRealmAccountType" } else { "string" }
    let s = match v {
      json.Value.Str(s) => s
      json.Value.Null => ""
      json.Value.Bool(_) => return Err("json: cannot unmarshal bool into Go value of type ${type_name}")
      json.Value.Object(_) => return Err("json: cannot unmarshal object into Go value of type ${type_name}")
      json.Value.List(_) => return Err("json: cannot unmarshal array into Go value of type ${type_name}")
      _ => return Err("json: cannot unmarshal number into Go value of type ${type_name}")
    }
    match key {
      "account_type" => u.account_type = s
      "domain_name" => u.domain_name = s
      "cloud_instance_name" => u.cloud_instance_name = s
      "cloud_audience_urn" => u.cloud_audience_urn = s
      "federation_protocol" => u.federation_protocol = s
      "federation_metadata_url" => u.federation_metadata_url = s
      _ => ()
    }
  }
  match r.next() ?? e => return Err(go_token_err(e)) {
    Some(json.Token.ObjectEnd) => Ok(u)
    _ => Err("EOF")
  }
}

/// How Go's %v prints a json.Decoder token.
fn token_text(t: json.Token) -> Str {
  match t {
    json.Token.ObjectStart => "{"
    json.Token.ObjectEnd => "}"
    json.Token.ArrayStart => "["
    json.Token.ArrayEnd => "]"
    json.Token.Key(s) => s
    json.Token.Str(s) => s
    json.Token.Number(n) => n
    json.Token.Bool(b) => "${b}"
    json.Token.Null => "<nil>"
  }
}

/// Go's json.Decoder.Token error for a reader error.
fn go_token_err(e: json.DecodeErr) -> Str {
  let m = e.msg.trim_prefix("invalid JSON: ")
  if m == "unexpected EOF" || m == "unexpected end of JSON input" {
    return "EOF"
  }
  m
}

// WS-Trust (MSAL's wstrust package).

const TRUST_13_SPEC: Str = "http://docs.oasis-open.org/ws-sx/ws-trust/200512/RST/Issue"
const TRUST_2005_SPEC: Str = "http://schemas.xmlsoap.org/ws/2005/02/trust/RST/Issue"
const SOAP_HTTP: Str = "http://schemas.xmlsoap.org/soap/http"

/// A WS-Trust endpoint of the mex document: its version (0 unknown,
/// 2005, 13) and URL.
struct TrustEndpoint {
  version: Int = 0
  url: Str = ""
}

/// The endpoints the mex document gives (MSAL's MexDocument).
struct Mex {
  username_password: TrustEndpoint
  windows: TrustEndpoint
}

/// The mex document at `u` (MSAL's WSTrust.Mex and defs.NewFromDef).
fn (c: UsernamePasswordCredential[fx]) mex(u: Str) -> Mex ! azcore.AuthErr uses (net.dial, clock, rand) {
  let name = c.p.c.name
  let mex_err = fn(m: Str) -> azcore.AuthErr { failed_text(name, "problem getting mex doc from federated url(${u}): ${m}") }
  let r = c.get(u, [("Content-Type", "application/xml; charset=utf-8")])?
  if let Some(e) = c.call_err("GET", u, r) {
    return Err(e)
  }
  let root = go_xml_root(r.body.to_str_lossy(), "definitions") ?? e => return Err(mex_err(e))
  parse_mex(root) ?? e => Err(mex_err(e))
}

/// MSAL's NewFromDef over the document's tree: the policies with a
/// transport binding and a user name or Windows token, the SOAP over
/// HTTP bindings of those policies, and the ports of those bindings.
fn parse_mex(root: xml.Element) -> Mex ! Str {
  // 1: user name and password; 2: Windows transport
  var policies: Map[Str, Int] = {}
  for pol in root.children_named("Policy") {
    let all = xpath([pol], ["ExactlyOne", "All"])
    let id = xattr([pol], "Id")
    let bound = xattr(xpath(all, ["TransportBinding"]), "sp") != "" && id != ""
    if bound && !xpath(all, ["NegotiateAuthentication"]).is_empty() {
      policies["#${id}"] = 2
    }
    let token = ["Policy", "UsernameToken", "Policy", "WssUsernameToken10"]
    if bound && !xpath(all, ["SignedEncryptedSupportingTokens"] + token).is_empty() {
      policies["#${id}"] = 1
    }
    if bound && !xpath(all, ["SignedSupportingTokens"] + token).is_empty() {
      policies["#${id}"] = 1
    }
  }
  if policies.is_empty() {
    return Err("no policies for mex document")
  }
  // binding name: (version, endpoint type)
  var bindings: Map[Str, (Int, Int)] = {}
  for b in root.children_named("binding") {
    if xattr(xpath([b], ["binding"]), "transport") != SOAP_HTTP {
      continue
    }
    let kind = policies.get(xattr(xpath([b], ["PolicyReference"]), "URI")) ?? continue
    let version = match xattr(xpath([b], ["operation", "operation"]), "soapAction") {
      TRUST_13_SPEC => 13
      TRUST_2005_SPEC => 2005
      _ => return Err("found unknown spec version in mex document")
    }
    bindings[xattr([b], "name")] = (version, kind)
  }
  var mex = Mex{username_password: TrustEndpoint{}, windows: TrustEndpoint{}}
  for port in xpath([root], ["service", "port"]) {
    let bn = xattr([port], "binding")
    let bname = match bn.cut(":") {
      Some((_, after)) => after
      None => bn
    }
    let (version, kind) = bindings.get(bname) ?? continue
    let u = xtext(xpath([port], ["EndpointReference", "Address"])).trim()
    if u == "" {
      return Err("MexDocument cannot have blank URL endpoint")
    }
    let found = TrustEndpoint{version: version, url: u}
    if kind == 1 {
      mex.username_password = better_endpoint(mex.username_password, found)
    } else {
      mex.windows = better_endpoint(mex.windows, found)
    }
  }
  Ok(mex)
}

/// MSAL's updateEndpoint: the first found, unless a 1.3 one follows a
/// 2005 one.
fn better_endpoint(cached: TrustEndpoint, found: TrustEndpoint) -> TrustEndpoint {
  if cached.version == 0 || (cached.version == 2005 && found.version == 13) { found } else { cached }
}

/// The SAML assertion the WS-Trust endpoint gives for the user, and the
/// grant it is sent in (MSAL's WSTrust.SAMLTokenInfo).
fn (c: UsernamePasswordCredential[fx]) saml(audience: Str, mex: Mex) -> (Str, Str) ! azcore.AuthErr uses (net.dial, clock, rand) {
  let name = c.p.c.name
  let saml_err = fn(m: Str) -> azcore.AuthErr { failed_text(name, "problem getting SAML token info: ${m}") }
  let ep = mex.username_password
  let msg = c.rst(ep, audience) ?? e => return Err(saml_err(e))
  if ep.version == 2005 {
    return Err(saml_err("WS Trust 2005 support is not implemented"))
  }
  let headers = [
    ("Content-Type", "application/soap+xml; charset=utf-8"),
    ("SOAPAction", TRUST_13_SPEC),
    ("client-request-id", uuid.v4(c.p.c.rand).display()),
    ("return-client-request-id", "false"),
  ]
  let r = c.p.c.send(policy.Request{method: "POST", url: ep.url, headers: headers, body: msg.bytes()}) ?? e => return Err(failed_text(name, e.display()))
  if let Some(e) = c.call_err("POST", ep.url, r) {
    return Err(e)
  }
  let text = r.body.to_str_lossy()
  let root = go_xml_root(text, "Envelope") ?? e => return Err(saml_err(e))
  let raws = requested_tokens_raw(text)
  let responses = xpath([root], ["Body", "RequestSecurityTokenResponseCollection", "RequestSecurityTokenResponse"])
  for (i, resp) in responses.indexed() {
    let assertions = xpath([resp], ["RequestedSecurityToken", "Assertion"])
    if assertions.is_empty() {
      continue
    }
    let raw = if i < raws.len() { raws[i] } else { "" }
    return match xattr(assertions, "saml") {
      "urn:oasis:names:tc:SAML:1.0:assertion" => Ok((SAML_V1_GRANT, raw))
      "urn:oasis:names:tc:SAML:2.0:assertion" => Ok((SAML_V2_GRANT, raw))
      v => Err(saml_err("couldn't parse SAML assertion, version unknown: ${json.encode_str(v)}"))
    }
  }
  Err(saml_err("unknown WS-Trust version"))
}

/// The WS-Trust request for the user (MSAL's
/// BuildTokenRequestMessageUsernamePassword), as Go's xml.Marshal writes
/// it: created now, expiring in ten minutes, two fresh UUIDs.
fn (c: UsernamePasswordCredential[fx]) rst(ep: TrustEndpoint, audience: Str) -> Str ! Str {
  let (action, ns, key_type, request_type, tok) = match ep.version {
    2005 => (TRUST_2005_SPEC, "http://schemas.xmlsoap.org/ws/2005/02/trust", "http://schemas.xmlsoap.org/ws/2005/05/identity/NoProofKey", "http://schemas.xmlsoap.org/ws/2005/02/trust/Issue", "UnPwSecTok2005-")
    13 => (TRUST_13_SPEC, "http://docs.oasis-open.org/ws-sx/ws-trust/200512", "http://docs.oasis-open.org/ws-sx/ws-trust/200512/Bearer", "http://docs.oasis-open.org/ws-sx/ws-trust/200512/Issue", "UnPwSecTok13-")
    _ => return Err("buildTokenRequestMessage had Version == \"TrustUnknown\", which is not recognized")
  }
  let now = c.p.c.clock.now()
  let layout = "{year}-{month}-{day}T{hour}:{minute}:{second}{frac:3}Z"
  let created = time.format(now, time.utc(), layout)
  let expires = time.format(Time.from_unix_millis(now.unix_millis() + 600000), time.utc(), layout)
  let message_id = uuid.v4(c.p.c.rand).display()
  let token_id = uuid.v4(c.p.c.rand).display()
  let e = xml.escape
  Ok("<s:Envelope xmlns:s=\"http://www.w3.org/2003/05/soap-envelope\" xmlns:wsa=\"http://www.w3.org/2005/08/addressing\" xmlns:wsu=\"http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd\"><s:Header><wsa:Action s:mustUnderstand=\"1\">${e(action)}</wsa:Action><wsa:messageID>urn:uuid:${message_id}</wsa:messageID><wsa:ReplyTo><wsa:Address>http://www.w3.org/2005/08/addressing/anonymous</wsa:Address></wsa:ReplyTo><wsa:To s:mustUnderstand=\"1\">${e(ep.url)}</wsa:To><wsse:Security s:mustUnderstand=\"1\" xmlns:wsse=\"http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd\"><wsu:Timestamp wsu:Id=\"MSATimeStamp\"><wsu:Created>${created}</wsu:Created><wsu:Expires>${expires}</wsu:Expires></wsu:Timestamp><wsse:UsernameToken wsu:Id=\"${tok}${token_id}\"><wsse:Username>${e(c.username)}</wsse:Username><wsse:Password>${e(c.password.reveal())}</wsse:Password></wsse:UsernameToken></wsse:Security></s:Header><s:Body><wst:RequestSecurityToken xmlns:wst=\"${ns}\"><wsp:AppliesTo xmlns:wsp=\"http://schemas.xmlsoap.org/ws/2004/09/policy\"><wsa:EndpointReference><wsa:Address>${e(audience)}</wsa:Address></wsa:EndpointReference></wsp:AppliesTo><wst:KeyType>${key_type}</wst:KeyType><wst:RequestType>${request_type}</wst:RequestType></wst:RequestSecurityToken></s:Body></s:Envelope>")
}

// Go's encoding/xml Unmarshal, as MSAL's structs read the documents.

/// The root element of `text` as Go's Unmarshal reads it: tokens up to
/// the end of the first element (anything before it skipped, nothing
/// after it read), which must have the local name `want`.
fn go_xml_root(text: Str, want: Str) -> xml.Element ! Str {
  var r = xml.reader(text)
  var stack: List[xml.Element] = []
  while {
    let t = r.next() ?? e => return Err(e.display())
    match t {
      None => return Err("EOF")
      Some(xml.Token.Start(n, attrs)) => {
        if stack.is_empty() && n.local != want {
          return Err("expected element type <${want}> but have <${n.local}>")
        }
        stack.push(xml.Element{name: n, attrs: attrs, children: []})
      }
      Some(xml.Token.End(_)) => {
        let done = stack.pop() ?? return Err("EOF")
        if stack.is_empty() {
          return Ok(done)
        }
        var parent = stack.pop() ?? return Err("EOF")
        parent.children.push(xml.Node.Elem(done))
        stack.push(parent)
      }
      Some(xml.Token.Text(s)) => {
        if !stack.is_empty() {
          var top = stack.pop() ?? return Err("EOF")
          top.children.push(xml.Node.Text(s))
          stack.push(top)
        }
      }
      Some(_) => ()
    }
  }
}

/// The elements a path of local names reaches from `els`, any namespace:
/// a field that is not a list takes every element that matches it, in
/// turn, as Go's Unmarshal does.
fn xpath(els: List[xml.Element], names: List[Str]) -> List[xml.Element] {
  var cur = els
  for n in names {
    var next: List[xml.Element] = []
    for e in cur {
      next = next + e.children_named(n)
    }
    cur = next
  }
  cur
}

/// The attribute of that local name (any namespace, `xmlns:` ones too)
/// that Go's Unmarshal keeps: the last one set.
fn xattr(els: List[xml.Element], local: Str) -> Str {
  var v = ""
  for e in els {
    for a in e.attrs {
      if a.name.local == local {
        v = a.value
      }
    }
  }
  v
}

/// The character data directly inside the last of `els` (a `,chardata`
/// field).
fn xtext(els: List[xml.Element]) -> Str {
  let e = els.last() ?? return ""
  var s = ""
  for n in e.children {
    if let xml.Node.Text(t) = n {
      s = s + t
    }
  }
  s
}

/// Each RequestSecurityTokenResponse's raw RequestedSecurityToken
/// content, as written (the `,innerxml` field: the last such element in
/// the response; "" when none), in document order. `text` already parsed.
fn requested_tokens_raw(text: Str) -> List[Str] {
  var out: List[Str] = []
  // the open elements' local names, and where each one's content starts
  var stack: List[(Str, Int)] = []
  var i = 0
  let n = text.len()
  while i < n {
    let lt = text[i..n].find("<") ?? break
    i = i + lt
    let rest = text[i..n]
    if rest.starts_with("<!--") {
      i = i + (rest.find("-->") ?? break) + 3
      continue
    }
    if rest.starts_with("<![CDATA[") {
      i = i + (rest.find("]]>") ?? break) + 3
      continue
    }
    if rest.starts_with("<?") {
      i = i + (rest.find("?>") ?? break) + 2
      continue
    }
    if rest.starts_with("<!") {
      i = i + (rest.find(">") ?? break) + 1
      continue
    }
    // a tag: find its end outside quoted values
    var j = i + 1
    var quote = ""
    while j < n {
      let ch = text[j..j + 1]
      if quote != "" {
        if ch == quote {
          quote = ""
        }
      } else if ch == "\"" || ch == "'" {
        quote = ch
      } else if ch == ">" {
        break
      }
      j = j + 1
    }
    let tag = text[i + 1..j]
    let closing = tag.starts_with("/")
    let self_closing = tag.ends_with("/")
    let head = tag.trim_prefix("/").trim_end_chars("/").replace("\t", " ").replace("\n", " ").replace("\r", " ")
    let qname = match head.cut(" ") {
      Some((q, _)) => q
      None => head
    }
    let local = match qname.cut(":") {
      Some((_, l)) => l
      None => qname
    }
    if closing {
      if let Some((l, start)) = stack.pop() {
        if l == "RequestedSecurityToken" && stack.len() == 4 && stack[3].0 == "RequestSecurityTokenResponse" && stack[1].0 == "Body" && stack[2].0 == "RequestSecurityTokenResponseCollection" && !out.is_empty() {
          let k = out.len() - 1
          out[k] = text[start..i]
        }
      }
    } else {
      if stack.len() == 3 && local == "RequestSecurityTokenResponse" && stack[1].0 == "Body" && stack[2].0 == "RequestSecurityTokenResponseCollection" {
        out.push("")
      }
      if !self_closing {
        stack.push((local, j + 1))
      }
    }
    i = j + 1
  }
  out
}
