// ManagedIdentityCredential, as azidentity with MSAL Go's managed
// identity sources (MIT, Copyright (c) Microsoft Corporation;
// NOTICE.md), chosen from the environment when the credential is built:
// App Service (IDENTITY_ENDPOINT and IDENTITY_HEADER), Azure ML
// (MSI_ENDPOINT and MSI_SECRET), Cloud Shell (MSI_ENDPOINT), Azure Arc
// (IDENTITY_ENDPOINT and IMDS_ENDPOINT, or the agent's himds file), else
// IMDS. Service Fabric (it pins the server's certificate) comes later.
// Azure Arc reads the key file its agent names, so the credential is a
// TokenCredential[fs.read] (decision 0009).

use std/http
use std/json
use std/path as gopath
use std/time
use std/timego
use std/url
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/policy
use github.com/xo-lang/azure/runtime

pub const IMDS_ENDPOINT: Str = "http://169.254.169.254/metadata/identity/oauth2/token"

/// The Azure Arc agent's endpoint when IDENTITY_ENDPOINT is not set.
pub const ARC_ENDPOINT: Str = "http://127.0.0.1:40342/metadata/identity/oauth2/token"

/// The most bytes an Azure Arc key file may have.
pub const ARC_MAX_KEY_SIZE: Int = 4096

pub enum Source {
  Imds
  AppService(endpoint: Str, header: Secret[Str])
  AzureMl(endpoint: Str, secret: Secret[Str])
  CloudShell(endpoint: Str)
  AzureArc(endpoint: Str)
}

/// A user-assigned identity, or None for the system-assigned one.
pub enum UserAssigned {
  ClientId(id: Str)
  ObjectId(id: Str)
  ResourceId(id: Str)
}

pub struct ManagedIdentityOptions {
  pub id: UserAssigned? = None
  pub client: policy.ClientOptions[()] = policy.ClientOptions{}
  /// Inside DefaultAzureCredential: before the first IMDS token request,
  /// a probe (a GET with no query or Metadata header, 1 s, no retries);
  /// any answer means IMDS is there, no answer means unavailable, and a
  /// failed probe is tried again on the next call, as Go's.
  pub probe: Bool = false
  /// In a chain (DefaultAzureCredential sets it): an IMDS answer that is
  /// not JSON is unavailable, so the chain goes on (something else
  /// listens there). Go's NewChainedTokenCredential sets this on any
  /// ManagedIdentityCredential it is given; an Xo chain cannot see the
  /// type of its sources, so a ChainedTokenCredential built by hand
  /// leaves it as the credential was built.
  pub chained: Bool = false
  /// Azure Arc's token directory, where its agent writes the key files
  /// it names; None is the platform's (`arc_paths`). Only a key file in
  /// exactly this directory is read. Tests point it at a MemFs
  /// directory.
  pub arc_token_dir: Str? = None
  /// The Azure Arc agent's himds file, whose presence selects Azure Arc;
  /// None is the platform's (`arc_paths`), "" never selects it.
  pub arc_himds: Str? = None
}

/// Azure Arc's token directory and himds file on `os`, as MSAL Go's
/// getAzureArcPlatformPath and getAzureArcHimdsFilePath: on Windows under
/// `program_data` (%ProgramData%), joined as Go's filepath.Join; ("", "")
/// where the agent does not run, so Azure Arc reports "platform not
/// supported".
pub fn arc_paths(os: TargetOs, program_data: Str) -> (Str, Str) {
  match os {
    Linux => ("/var/opt/azcmagent/tokens", "/opt/azcmagent/bin/himds")
    Windows => (win_join([program_data, "AzureConnectedMachineAgent", "Tokens"]), win_join([program_data, "AzureConnectedMachineAgent", "himds.exe"]))
    Darwin => ("", "")
    Wasi => ("", "")
  }
}

pub struct ManagedIdentityCredential {
  pub source: Source
  fs: Fs
  arc_dir: Str
  arc_os: TargetOs
  id: UserAssigned?
  pipeline: runtime.Pipeline[()]
  probe_pipeline: runtime.Pipeline[()]
  probing: Mutex[Bool]
  chained: Bool
  clock: Clock
  cache: Mutex[List[(Str, azcore.AccessToken)]]
}

/// The source the environment `env` names; `himds` is whether the Azure
/// Arc agent's himds file exists.
pub fn source_of(env: Env, himds: Bool = false) -> Source uses env {
  let get = fn(k: Str) -> Str { env.get(k) ?? "" }
  if get("IDENTITY_ENDPOINT") != "" && get("IDENTITY_HEADER") != "" {
    return Source.AppService(endpoint: get("IDENTITY_ENDPOINT"), header: Secret.new(get("IDENTITY_HEADER")))
  }
  if get("MSI_ENDPOINT") != "" {
    if get("MSI_SECRET") != "" {
      return Source.AzureMl(endpoint: get("MSI_ENDPOINT"), secret: Secret.new(get("MSI_SECRET")))
    }
    return Source.CloudShell(endpoint: get("MSI_ENDPOINT"))
  }
  if get("IDENTITY_ENDPOINT") != "" && get("IMDS_ENDPOINT") != "" || himds {
    // MSAL Go reads IDENTITY_ENDPOINT again for each request
    return Source.AzureArc(endpoint: if get("IDENTITY_ENDPOINT") != "" { get("IDENTITY_ENDPOINT") } else { ARC_ENDPOINT })
  }
  Source.Imds
}

pub fn new_managed_identity_credential(env: Env, fs: Fs, net: Net, clock: Clock, rand: Rand, opts: ManagedIdentityOptions = ManagedIdentityOptions{}) -> ManagedIdentityCredential uses (env, fs.read) {
  let (dir, himds) = arc_paths(target.os, env.get("ProgramData") ?? "")
  let arc_himds = opts.arc_himds ?? himds
  // Go's os.Stat: any file or directory there, followed through links
  let found = match fs.stat(arc_himds) {
    Ok(Some(_)) => true
    _ => false
  }
  let src = source_of(env, himds: arc_himds != "" && found)
  // IMDS answers 404 and 410 while it starts (MSAL retries them)
  let client = opts.client with {retry: opts.client.retry with {status_codes: opts.client.retry.status_codes + [404, 410]}}
  let probe_client = opts.client with {timeout: 1s, retry: opts.client.retry with {max_retries: -1}}
  ManagedIdentityCredential{
    source: src, id: opts.id, fs: fs, arc_dir: opts.arc_token_dir ?? dir, arc_os: target.os,
    pipeline: runtime.new_pipeline("azidentity", VERSION, net, clock, rand, runtime.PipelineOptions{}, client),
    probe_pipeline: runtime.new_pipeline("azidentity", VERSION, net, clock, rand, runtime.PipelineOptions{}, probe_client),
    probing: Mutex.new(opts.probe && src is Source.Imds), chained: opts.chained, clock: clock, cache: Mutex.new([]),
  }
}

/// The resource of a scope (`https://vault.azure.net/.default` is
/// `https://vault.azure.net`): managed identity takes one resource.
pub fn resource_of(scopes: List[Str]) -> Str ! Str {
  if scopes.len() != 1 {
    return Err("managed identity takes exactly one scope, got ${scopes.len()}")
  }
  Ok(scopes[0].trim_suffix("/.default"))
}

/// The request for `resource` from `src`, its query sorted by key as
/// MSAL Go encodes it (url.Values.Encode).
pub fn token_request(src: Source, id: UserAssigned?, resource: Str) -> policy.Request {
  let ua = fn(names: (Str, Str, Str)) -> List[(Str, Str)] {
    match id {
      Some(UserAssigned.ClientId(v)) => [(names.0, v)]
      Some(UserAssigned.ObjectId(v)) => [(names.1, v)]
      Some(UserAssigned.ResourceId(v)) => [(names.2, v)]
      None => []
    }
  }
  let query = fn(pairs: List[(Str, Str)]) -> Str {
    pairs.sort_by(fn(p: (Str, Str)) -> Str { p.0 }).map(fn(p: (Str, Str)) -> Str { "${url.query_escape(p.0)}=${url.query_escape(p.1)}" }).join("&")
  }
  match src {
    Imds => policy.Request{method: "GET", url: "${IMDS_ENDPOINT}?${query([("api-version", "2018-02-01"), ("resource", resource)] + ua(("client_id", "object_id", "msi_res_id")))}", headers: [("Metadata", "true")]}
    AppService(endpoint, header) => policy.Request{method: "GET", url: "${endpoint}?${query([("api-version", "2019-08-01"), ("resource", resource)] + ua(("client_id", "object_id", "mi_res_id")))}", headers: [("X-IDENTITY-HEADER", header.reveal())]}
    // Azure ML always sends clientid, empty for the system-assigned identity
    AzureMl(endpoint, secret) => {
      let extra = match id {
        None => [("clientid", "")]
        Some(_) => ua(("clientid", "object_id", "mi_res_id"))
      }
      policy.Request{method: "GET", url: "${endpoint}?${query([("api-version", "2017-09-01"), ("resource", resource)] + extra)}", headers: [("secret", secret.reveal())]}
    }
    CloudShell(endpoint) => policy.Request{method: "POST", url: endpoint, headers: [("Metadata", "true"), ("Content-Type", "application/x-www-form-urlencoded")], body: "resource=${url.query_escape(resource)}".bytes()}
    // the endpoint's own query is kept, with api-version, resource and
    // the identity set over it (MSAL Go's createAzureArcAuthRequest)
    AzureArc(endpoint) => {
      let (no_frag, frag) = match endpoint.cut("#") {
        Some((a, f)) => (a, "#${f}")
        None => (endpoint, "")
      }
      let (base, raw) = no_frag.cut("?") ?? (no_frag, "")
      // Go's URL.Query keeps the pairs that parse
      var v = url.values()
      for pair in raw.split("&") {
        if let Ok(q) = url.parse_query(pair) {
          for k in q.keys() {
            for x in q.all(k) {
              v.add(k, x)
            }
          }
        }
      }
      v.set("api-version", "2020-06-01")
      v.set("resource", resource)
      for (k, x) in ua(("client_id", "object_id", "msi_res_id")) {
        v.set(k, x)
      }
      policy.Request{method: "GET", url: "${base}?${v.encode()}${frag}", headers: [("Metadata", "true")]}
    }
  }
}

const MI_NAME: Str = "ManagedIdentityCredential"

/// azidentity's credentialUnavailableError: `<credential>: <msg>`; a
/// chain goes on to its next credential.
fn mi_unavailable(msg: Str) -> azcore.AuthErr {
  azcore.AuthErr{credential: MI_NAME, msg: msg, text: "${MI_NAME}: ${msg}", unavailable: true}
}

/// The probe of a credential inside DefaultAzureCredential: Ok once
/// something answers at IMDS (any status), and every call after that.
fn (m: ManagedIdentityCredential) probe() -> () ! azcore.AuthErr uses (net.dial, clock, rand) {
  if !m.probing.with_read(fn(p: Bool) -> Bool { p }) {
    return Ok(())
  }
  match m.probe_pipeline.send(policy.Request{method: "GET", url: IMDS_ENDPOINT}) {
    Ok(_) => {
      m.probing.reset(false)
      Ok(())
    }
    Err(policy.SendErr.Http(http.ClientErr.Timeout)) => Err(mi_unavailable("managed identity timed out. See https://aka.ms/azsdk/go/identity/troubleshoot#dac for more information"))
    Err(e) => Err(mi_unavailable(e.display()))
  }
}

/// MSAL Go's reading of a managed identity token response (its
/// TokenResponse.UnmarshalJSON and authResultFromToken), with its only
/// errors: a body that is not JSON, a bad duration or expires_on, or no
/// expiry. Unlike the token endpoint's, a response without access_token
/// gives an empty token.
fn mi_token(resp: http.Response, now: Time) -> azcore.AccessToken ! Str {
  let _ = json.parse_value(resp.body.to_str_lossy()) ?? e => return Err("error parsing the json error: ${e.msg.trim_prefix("invalid JSON: ")}")
  // encoding/json decodes the members in the body's order, matching
  // names without case and the last of a name winning; the first bad
  // duration ends the decoding. A duration reads the value's text.
  var expires_in: Time? = None
  var refresh: Time? = None
  var expires_on: json.Value? = None
  var token = ""
  var r = json.tokens(resp.body)
  if let Ok(Some(json.Token.ObjectStart)) = r.next() {
    while r.more() {
      let k = match r.next() {
        Ok(Some(json.Token.Key(k))) => k.to_lower()
        _ => break
      }
      let from = r.offset()
      if r.skip().is_err() {
        break
      }
      let raw = resp.body[from..r.offset()].to_str_lossy().trim().trim_prefix(":").trim()
      if k == "expires_in" {
        expires_in = Some(mi_duration(raw, now).map_err(fn(e: Str) -> Str { "error parsing the json error: ${e}" })?)
      } else if k == "refresh_in" {
        refresh = Some(mi_duration(raw, now).map_err(fn(e: Str) -> Str { "error parsing the json error: ${e}" })?)
      } else if k == "expires_on" {
        expires_on = json.parse_value(raw).ok()
      } else if k == "access_token" {
        if let Ok(json.Value.Str(t)) = json.parse_value(raw) {
          token = t
        }
      }
    }
  }
  let on: Time? = match expires_on {
    Some(json.Value.Str(t)) if t != "" => match Int.parse(t) {
      Some(n) => Some(Time.from_unix(n))
      None => Some(mi_expires_on(t) ?? return Err("error parsing the json error: invalid ExpiresOn format: ${t}"))
    }
    Some(json.Value.Int(n)) => Some(Time.from_unix(n))
    Some(json.Value.Num(f)) => Some(Time.from_unix(Int(f)))
    _ => None
  }
  let expires = on ?? expires_in ?? return Err("error parsing the json error: expires_in and expires_on are both missing or invalid")
  // without refresh_in, half the lifetime when that is over 2 hours
  if refresh.is_none() && expires.unix_millis() - now.unix_millis() > 2 * 3600 * 1000 {
    refresh = Some(Time.from_unix_millis(now.unix_millis() + (expires.unix_millis() - now.unix_millis()) / 2))
  }
  Ok(azcore.AccessToken{token: Secret.new(token), expires_on: expires, refresh_on: refresh})
}

/// MSAL Go's DurationTime: strconv.Atoi of the value's JSON text
/// without its quotes, as seconds from now.
fn mi_duration(raw: Str, now: Time) -> Time ! Str {
  let text = raw.trim_chars("\"")
  let n = Int.parse(text) ?? return Err("unix time(${raw}) could not be converted from string to int: strconv.Atoi: parsing ${json.encode_str(text)}: invalid syntax")
  Ok(Time.from_unix_millis(now.unix_millis() + n * 1000))
}

/// The date forms MSAL Go accepts for expires_on, in UTC without an
/// offset (MSAL .NET issue 4963).
fn mi_expires_on(t: Str) -> Time? {
  for layout in ["01/02/2006 15:04:05", "2006-01-02 15:04:05", "2006-01-02T15:04:05.999999999Z07:00"] {
    if let Ok(at) = timego.parse(t, layout, time.utc()) {
      return Some(at)
    }
  }
  None
}

/// The error for a token request that did not give a token, as
/// azidentity's managedIdentityClient.GetToken sorts MSAL's errors.
fn (m: ManagedIdentityCredential) token_err(req: policy.Request, resp: http.Response) -> azcore.AuthErr {
  let imds = m.source is Source.Imds
  if imds && resp.status == 400 {
    if m.id.is_some() {
      return auth_failed(MI_NAME, req.method, req.url, resp, message: "the requested identity isn't assigned to this resource")
    }
    let body = resp.body.to_str_lossy()
    return mi_unavailable("failed to authenticate a system assigned identity${if body == "" { "" } else { ". The endpoint responded with ${body}" }}")
  }
  if imds && resp.status == 403 && resp.body.to_str_lossy().contains("unreachable") {
    // Docker Desktop's proxy answers IMDS with 403
    return mi_unavailable("unexpected response ${json.encode_str(resp.body.to_str_lossy())}")
  }
  auth_failed(MI_NAME, req.method, req.url, resp)
}

/// The key file `WWW-Authenticate` names, checked as MSAL Go's
/// getAzureArcSecretKey checks it before reading: `Basic realm=<path>`, a
/// `.key` file directly in `dir`, the token directory on `os` ("" where
/// Azure Arc does not run). Paths are Go's filepath on `os`.
pub fn arc_key_path(header: Str, dir: Str, os: TargetOs) -> Str ! Str {
  if dir == "" {
    return Err("platform not supported, expected linux or windows")
  }
  // strings.Split's second part: up to the next "Basic realm=", if any
  let parts = header.split("Basic realm=")
  if parts.len() < 2 {
    return Err("basic realm= not found in the string, instead found: ${header}")
  }
  let path = parts[1]
  let (in_dir, name, ext) = match os {
    Windows => (win_dir(path), win_base(path), win_ext(win_base(path)))
    _ => (gopath.dir(path), gopath.base(path), gopath.ext(gopath.base(path)))
  }
  if !name.ends_with(".key") {
    return Err("invalid file extension, expected .key, got ${ext}")
  }
  if dir != in_dir {
    return Err("invalid file path, expected ${dir}, got ${in_dir}")
  }
  Ok(path)
}

/// Azure Arc's challenge (MSAL Go's acquireTokenForAzureArc and
/// getAzureArcSecretKey): `req` is answered 401 with
/// `WWW-Authenticate: Basic realm=<path>`, the path of a `.key` file in
/// the token directory of at most 4096 bytes; the request again with
/// `Authorization: Basic <the file's text>` gets the token. Each check
/// fails with MSAL Go's text.
fn (m: ManagedIdentityCredential) arc_challenge(req: policy.Request) -> policy.Request ! azcore.AuthErr uses (net.dial, clock, rand, fs.read) {
  let fail = fn(msg: Str) -> azcore.AuthErr { failed_text(MI_NAME, msg) }
  let resp = m.pipeline.send(req) ?? e => return Err(fail(e.display()))
  if resp.status != 401 {
    return Err(fail("expected a 401 response, received ${resp.status}"))
  }
  let header = resp.header("WWW-Authenticate") ?? ""
  if header == "" {
    return Err(fail("response has no www-authenticate header"))
  }
  let path = arc_key_path(header, m.arc_dir, m.arc_os) ?? msg => return Err(fail(msg))
  // Linux resolves `..` after walking the directory before it, which
  // MSAL Go's lexical check does not see (a link there leads out of the
  // token directory); an Fs resolves it by text. A missing directory
  // before `..` fails as Go's stat does, and any other `..` is refused,
  // where Go would read the file. Windows resolves `..` by text, as an Fs.
  let segs = path.split("/")
  if m.arc_os != TargetOs.Windows && segs.contains("..") {
    for (i, seg) in segs.indexed() {
      if seg == ".." && i > 1 {
        let before = segs[..i].join("/")
        match m.fs.stat(before) {
          Ok(Some(d)) if d.is_dir => ()
          Ok(Some(_)) => return Err(fail("failed to get metadata for ${path} due to error: stat ${path}: not a directory"))
          _ => return Err(fail("failed to get metadata for ${path} due to error: stat ${path}: no such file or directory"))
        }
      }
    }
    return Err(fail("invalid file path, expected a file in ${m.arc_dir} named without .., got ${path}"))
  }
  // os.Stat's and os.ReadFile's errors name their operation
  let info = match m.fs.stat(path) {
    Ok(Some(i)) => i
    Ok(None) => return Err(fail("failed to get metadata for ${path} due to error: stat ${path}: no such file or directory"))
    Err(e) => return Err(fail("failed to get metadata for ${path} due to error: stat ${e.display()}"))
  }
  if info.size > ARC_MAX_KEY_SIZE {
    return Err(fail("invalid secret file size, expected ${ARC_MAX_KEY_SIZE}, file size was ${info.size}"))
  }
  let key = m.fs.read(path) ?? e => {
    let op = if e is FsErr.IsDir(..) { "read" } else { "open" }
    return Err(fail("failed to read ${json.encode_str(path)} due to error: ${op} ${e.display()}"))
  }
  // an empty key sends no Authorization header, as MSAL Go's
  let k = key.to_str_lossy()
  Ok(if k == "" { req } else { req with {headers: req.headers + [("Authorization", "Basic ${k}")]} })
}

/// The first of `keys` whose member is a non-empty string in the token
/// response, a name's last member counting (MSAL Go reads its
/// TokenResponse.AdditionalFields, a map).
fn arc_echo(body: Bytes, keys: List[Str]) -> Str {
  var found: Map[Str, Str] = {}
  var r = json.tokens(body)
  if let Ok(Some(json.Token.ObjectStart)) = r.next() {
    while r.more() {
      let k = match r.next() {
        Ok(Some(json.Token.Key(k))) => k
        _ => break
      }
      let from = r.offset()
      if r.skip().is_err() {
        break
      }
      let raw = body[from..r.offset()].to_str_lossy().trim().trim_prefix(":").trim()
      found.put(k, match json.parse_value(raw) {
        Ok(json.Value.Str(v)) => v
        _ => ""
      })
    }
  }
  for k in keys {
    let v = found.get(k) ?? ""
    if v != "" {
      return v
    }
  }
  ""
}

/// MSAL Go's verifyAzureArcUserAssignedIdentity: an agent that ignores a
/// user-assigned identity answers for the system-assigned one, so the
/// token response must name the identity asked for (ignoring case).
fn arc_verify(id: UserAssigned?, body: Bytes) -> () ! Str {
  let (keys, want) = match id {
    None => return Ok(())
    Some(UserAssigned.ClientId(v)) => (["client_id"], v)
    Some(UserAssigned.ObjectId(v)) => (["object_id"], v)
    Some(UserAssigned.ResourceId(v)) => (["msi_res_id", "mi_res_id"], v)
  }
  let echoed = arc_echo(body, keys)
  if echoed == "" || !echoed.equal_fold(want) {
    return Err("azure arc did not confirm the requested user-assigned managed identity in the token response; the agent likely does not support user-assigned managed identities and returned the system-assigned identity")
  }
  Ok(())
}

pub fn (m: ManagedIdentityCredential) get_token(opts: azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand, fs.read) {
  let name = "ManagedIdentityCredential"
  let resource = resource_of(opts.scopes) ?? e => return Err(azcore.AuthErr{credential: name, msg: e})
  // one call fetches while the others wait for its token
  m.cache.with(fn(var xs: List[(Str, azcore.AccessToken)]) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand, fs.read) {
    let now = m.clock.now()
    for (k, t) in xs {
      if k == resource && !azcore.needs_refresh(t, now) {
        return Ok(t)
      }
    }
    m.probe()?
    let first = token_request(m.source, m.id, resource)
    let req = if m.source is Source.AzureArc(..) { m.arc_challenge(first)? } else { first }
    let resp = m.pipeline.send(req) ?? e => return Err(failed_text(name, e.display()))
    if resp.status < 200 || resp.status > 299 {
      return Err(m.token_err(req, resp))
    }
    let t = mi_token(resp, now) ?? msg => {
      if m.chained && m.source is Source.Imds {
        // something other than IMDS answered: the chain goes on
        return Err(mi_unavailable(msg))
      }
      return Err(failed_text(name, msg))
    }
    if m.source is Source.AzureArc(..) {
      arc_verify(m.id, resp.body) ?? msg => return Err(failed_text(name, msg))
    }
    // MSAL Go never serves an empty token from its cache (its
    // dac-no-access vector: the second call asks again)
    if t.token.reveal() != "" {
      xs = xs.filter(fn(e: (Str, azcore.AccessToken)) -> Bool { e.0 != resource })
      xs.push((resource, t))
    }
    Ok(t)
  })
}
