// Replays the Go program's developer-tool calls (devcredvectors_test.xo):
// FakeProc answers `/bin/sh` as each fake script did, and its runs()
// give the arguments the shell would give the tool.

use std/json
use std/testing
use std/time
use github.com/xo-lang/azure/azcore

const ARM: Str = "https://management.azure.com/.default"
const T1: Str = "tenant-one"
const T2: Str = "tenant-two"

/// The words `/bin/sh` makes of a command line with only spaces and
/// double quotes, as Go's commands are.
fn sh_words(c: Str) -> List[Str] {
  var words: List[Str] = []
  var cur = ""
  var quoted = false
  var any = false
  for r in c.runes() {
    if r == '"' {
      quoted = !quoted
      any = true
    } else if r == ' ' && !quoted {
      if any {
        words.push(cur)
      }
      cur = ""
      any = false
    } else {
      cur = cur + "${r}"
      any = true
    }
  }
  if any {
    words.push(cur)
  }
  words
}

struct Rec {
  log: Mutex[List[Str]]
  /// How many of the FakeProc's runs are logged already.
  seen: Mutex[Int]
  /// The tool is on PATH (the fake writes its ARGV line).
  found: Mutex[Bool]
}

fn rec_note(r: Rec, s: Str) {
  r.log.with(fn(var l: List[Str]) { l.push(s) })
}

/// The FakeProc's new runs as the fake tools' ARGV lines: each run is
/// `/bin/sh -c "COMMAND"` (strconv.Quote), COMMAND split as the shell
/// splits it.
fn log_runs(r: Rec, p: testing.FakeProc, sec: Str) {
  let all = p.runs()
  let from = r.seen.with(fn(var n: Int) -> Int {
    let f = n
    n = all.len()
    f
  })
  if !r.found.with_read(fn(f: Bool) -> Bool { f }) {
    return
  }
  for run in all[from..all.len()] {
    let q = run.trim_prefix("/bin/sh -c ")
    let cmd = match json.parse_value(q) {
      Ok(json.Value.Str(c)) => c
      _ => q
    }
    let w = sh_words(cmd)
    rec_note(r, "${sec}:   ARGV ${w[0]}${w[1..w.len()].map(fn(a: Str) -> Str { " [${a}]" }).join("")}")
  }
}

fn kind(e: azcore.AuthErr) -> Str {
  if e.failed { "authfailed" } else if e.unavailable { "unavailable" } else { "other" }
}

fn rfc3339(t: Time) -> Str {
  time.format(t, time.utc(), "{year}-{month}-{day}T{hour}:{minute}:{second}Z")
}

fn shown(r: Rec, p: testing.FakeProc, sec: Str, res: Result[azcore.AccessToken, azcore.AuthErr]) {
  log_runs(r, p, sec)
  match res {
    Ok(t) => rec_note(r, "${sec}: token=${t.token.reveal()} expires=${rfc3339(t.expires_on)}")
    Err(e) => rec_note(r, "${sec}: error ${kind(e)}: ${json.encode_str(e.display())}")
  }
}

fn dtro(scopes: List[Str], tenant: Str = "", claims: Str = "") -> azcore.TokenRequestOptions {
  azcore.TokenRequestOptions{scopes: scopes, tenant_id: tenant, claims: claims}
}

test "azidentity's developer-tool credentials against Go's fake tools" {
  let r = Rec{log: Mutex.new([]), seen: Mutex.new(0), found: Mutex.new(true)}
  let env = os.env
  env.set("TZ", "UTC")
  let p = os.proc
  let answer = fn(out: Str, err: Str, code: Int) {
    p.on_run("/bin/sh", ProcOutput{code: code, stdout: out.bytes(), stderr: err.bytes()})
  }
  let cerr = fn(sec: Str, e: azcore.AuthErr) { rec_note(r, "${sec}: constructor error: ${json.encode_str(e.display())}") }

  let cli = new_azure_cli_credential(p, os.clock, env)?
  answer("{\"accessToken\":\"cli-tok\",\"expires_on\":1700000000,\"expiresOn\":\"2023-11-14 22:13:20.000000\"}", "", 0)
  shown(r, p, "cli1", cli.get_token(dtro([ARM])))
  answer("{\"accessToken\":\"cli-tok2\",\"expiresOn\":\"2030-01-02 03:04:05.123456\"}", "", 0)
  shown(r, p, "cli2", cli.get_token(dtro([ARM])))
  let sub = new_azure_cli_credential(p, os.clock, env, DevToolOptions{tenant_id: T1, subscription: "my sub-1.x_y"})?
  answer("{\"accessToken\":\"cli-tok3\",\"expires_on\":1700000003}", "", 0)
  shown(r, p, "cli3", sub.get_token(dtro(["api://my-app/.default"])))
  shown(r, p, "cli3b", sub.get_token(dtro([ARM], tenant: T2)))
  let allow = new_azure_cli_credential(p, os.clock, env, DevToolOptions{tenant_id: T1, additionally_allowed_tenants: ["*"]})?
  shown(r, p, "cli4", allow.get_token(dtro([ARM], tenant: T2)))
  shown(r, p, "cli5", cli.get_token(dtro([ARM], claims: "{\"access_token\":{\"acrs\":{\"essential\":true,\"value\":\"p1\"}}}")))
  shown(r, p, "cli5b", allow.get_token(dtro([ARM], claims: "c")))
  shown(r, p, "cli6", cli.get_token(dtro([ARM, "b"])))
  shown(r, p, "cli7", cli.get_token(dtro(["a b"])))
  shown(r, p, "cli7b", cli.get_token(dtro(["https://x/.default;rm"])))
  match new_azure_cli_credential(p, os.clock, env, DevToolOptions{subscription: "bad;sub"}) {
    Ok(_) => rec_note(r, "cli8: no error")
    Err(e) => cerr("cli8", e)
  }
  match new_azure_cli_credential(p, os.clock, env, DevToolOptions{tenant_id: "bad tenant"}) {
    Ok(_) => rec_note(r, "cli8b: no error")
    Err(e) => cerr("cli8b", e)
  }
  answer("", "ERROR: Please run 'az login' to setup account.\r\n", 1)
  shown(r, p, "cli9", cli.get_token(dtro([ARM])))
  answer("", "", 2)
  shown(r, p, "cli9b", cli.get_token(dtro([ARM])))
  answer("not json", "", 0)
  shown(r, p, "cli9c", cli.get_token(dtro([ARM])))
  answer("{\"accessToken\":\"x\",\"expiresOn\":\"tomorrow\"}", "", 0)
  shown(r, p, "cli9d", cli.get_token(dtro([ARM])))
  r.found.with(fn(var f: Bool) { f = false })
  answer("", "/bin/sh: az: command not found\n", 127)
  shown(r, p, "cli10", cli.get_token(dtro([ARM])))
  r.found.with(fn(var f: Bool) { f = true })

  let azd = new_azure_developer_cli_credential(p, os.clock, env)?
  answer("{\"token\":\"azd-tok\",\"expiresOn\":\"2030-01-02T03:04:05Z\"}", "", 0)
  shown(r, p, "azd1", azd.get_token(dtro([ARM, "api://x/.default"])))
  let azdt = new_azure_developer_cli_credential(p, os.clock, env, DevToolOptions{tenant_id: T1})?
  shown(r, p, "azd2", azdt.get_token(dtro([ARM])))
  shown(r, p, "azd3", azd.get_token(dtro([])))
  shown(r, p, "azd3b", azd.get_token(dtro(["a b"])))
  answer("", "Error: unknown flag: --claims\n", 1)
  shown(r, p, "azd4", azd.get_token(dtro([ARM], claims: "claims!")))
  answer("", "some failure\n", 1)
  shown(r, p, "azd5", azd.get_token(dtro([ARM], claims: "claims!")))
  answer("", "{\"type\":\"consoleMessage\",\"data\":{\"message\":\"  first message  \"}}\n{\"error\":\"not logged in, run azd auth login\"}\n", 1)
  shown(r, p, "azd6", azd.get_token(dtro([ARM])))
  answer("", "{\"data\":{\"message\":\"only data\"}}\n", 1)
  shown(r, p, "azd6b", azd.get_token(dtro([ARM])))
  answer("", "plain failure\n", 1)
  shown(r, p, "azd6c", azd.get_token(dtro([ARM])))
  answer("{\"token\":\"t\",\"expiresOn\":\"2030-01-02 03:04:05\"}", "", 0)
  shown(r, p, "azd7", azd.get_token(dtro([ARM])))

  let ps = new_azure_powershell_credential(p, os.clock, env)?
  answer("{\"Token\":\"ps-tok\",\"ExpiresOn\":1700000009}", "", 0)
  shown(r, p, "ps1", ps.get_token(dtro([ARM])))
  let pst = new_azure_powershell_credential(p, os.clock, env, DevToolOptions{tenant_id: T1})?
  shown(r, p, "ps2", pst.get_token(dtro([ARM])))
  shown(r, p, "ps3", pst.get_token(dtro([ARM], claims: "cl")))
  shown(r, p, "ps3b", ps.get_token(dtro([ARM], claims: "cl")))
  answer("", "Run Connect-AzAccount to login.\n", 1)
  shown(r, p, "ps4", ps.get_token(dtro([ARM])))
  answer("", "Write-Error: Az.Accounts module not found\n", 1)
  shown(r, p, "ps5", ps.get_token(dtro([ARM])))
  shown(r, p, "ps6", ps.get_token(dtro([ARM, ARM])))

  // the chain: FakeProc answers every tool alike
  env.set("AZURE_TOKEN_CREDENTIALS", "dev")
  let dac = new_default_azure_credential_with_dev(env, os.fs, os.net, os.clock, os.rand, p)?
  answer("", "boom\n", 1)
  shown(r, p, "dac1", dac.get_token(dtro([ARM])))
  r.found.with(fn(var f: Bool) { f = false })
  answer("", "/bin/sh: az: command not found\n", 127)
  shown(r, p, "dac2", dac.get_token(dtro([ARM])))
  r.found.with(fn(var f: Bool) { f = true })
  answer("{\"accessToken\":\"dac-tok\",\"expires_on\":1700000010}", "", 0)
  shown(r, p, "dac3", dac.get_token(dtro([ARM])))
  env.set("AZURE_TOKEN_CREDENTIALS", "AzureDeveloperCLICredential")
  let d2 = new_default_azure_credential_with_dev(env, os.fs, os.net, os.clock, os.rand, p)?
  answer("", "plain failure\n", 1)
  shown(r, p, "dac4", d2.get_token(dtro([ARM])))

  let want = GO_DEVCRED_LINES
  let got = r.log.with_read(fn(l: List[Str]) -> List[Str] { l })
  var i = 0
  while i < want.len() || i < got.len() {
    let w = if i < want.len() { want[i] } else { "<none>" }
    let g = if i < got.len() { got[i] } else { "<none>" }
    expect((i, g)) == (i, w)
    i = i + 1
  }
}

test "the old default chain still refuses the developer tools" {
  let env = os.env
  env.set("AZURE_TOKEN_CREDENTIALS", "AzureCLICredential")
  match new_default_azure_credential(env, os.fs, os.net, os.clock, os.rand) {
    Err(e) => expect(e.msg.contains("use new_default_azure_credential_with_dev")) == true
    Ok(_) => expect("Ok") == "Err"
  }
}
