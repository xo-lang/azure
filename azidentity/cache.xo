// A credential's persistent token cache (decision 0012, step a): Go's
// `Cache` option. MSAL Go v1.10.1 reads the stored cache before each
// lookup (`Replace`) and writes the whole cache after each token
// response (`Export`), in MSAL's shared cache schema, which MSAL .NET,
// Python and Java read too (MIT, Copyright (c) Microsoft Corporation;
// NOTICE.md). Where the bytes live is the caller's: a `TokenStore`
// performs its own effects `fx` (a file needs fs.read and fs.write), so
// only a credential given a cache performs them.

use std/json
use github.com/xo-lang/azure/azcore

/// One storage location of a cache (Go's cache.ExportReplace).
pub struct TokenStore[fx: Effects] {
  /// The stored cache, "" when nothing is stored yet; `hint` is MSAL's
  /// partition key (`<client>_<tenant>_AppTokenCache`, or the user's
  /// home account id).
  pub replace: fn(Str) -> Str ! Str uses (fx)
  /// Stores the whole cache (`hint`, then the JSON).
  pub export: fn(Str, Str) -> () ! Str uses (fx)
}

/// The stores a credential's tokens go to (Go's azidentity.Cache): one
/// for requests with continuous access evaluation, one for the rest,
/// as MSAL's cache doesn't look at a token's claims. `factory` makes
/// each the first time it is needed (`true`: the CAE one).
pub struct Cache[fx: Effects] {
  factory: fn(Bool) -> TokenStore[fx] ! Str uses (fx)
  made: Mutex[List[(Bool, TokenStore[fx])]]
}

/// A cache whose stores `factory` makes (Go's internal.NewCache, which
/// azidentity/cache.New calls with its per-OS store).
pub fn new_cache[fx: Effects](factory: fn(Bool) -> TokenStore[fx] ! Str uses (fx)) -> Cache[fx] {
  Cache{factory: factory, made: Mutex.new([])}
}

/// The store for `cae` requests, made on first use (public so a store
/// module such as azidentity/cache can test its stores through it).
pub fn (c: Cache[fx]) store(cae: Bool) -> TokenStore[fx] ! Str uses (fx) {
  if let Some(s) = c.made.with_read(fn(xs: List[(Bool, TokenStore[fx])]) -> TokenStore[fx]? { xs.filter(fn(x: (Bool, TokenStore[fx])) -> Bool { x.0 == cae }).first().map(fn(x: (Bool, TokenStore[fx])) -> TokenStore[fx] { x.1 }) }) {
    return Ok(s)
  }
  let s = (c.factory)(cae)?
  c.made.with(fn(var xs: List[(Bool, TokenStore[fx])]) { xs.push((cae, s)) })
  Ok(s)
}

// MSAL's cache contract (MSAL Go's storage.Contract), kept as the JSON
// the store gave: entries this module doesn't write (other clients',
// other MSAL programs', fields it doesn't know) go back as they came.

/// The contract in `text` as MSAL's Unmarshal reads it: an empty
/// contract for nothing stored; else a JSON object whose sections MSAL
/// knows hold objects of entries, each entry's known fields decoded to
/// their Go types (`normalize_entry`); MSAL's error text for what it
/// can't decode. Everything else is kept; text after the object is
/// ignored, as MSAL's decoder never reads it.
fn parse_contract(text: Str) -> json.Value ! Str {
  if text == "" {
    return Ok(json.Value.Object([]))
  }
  // MSAL's decoder reads one value; what follows it is never read
  var r = json.tokens(text.bytes())
  let v = r.value() ?? e => return Err(go_token_err(e))
  let fields = match v {
    json.Value.Object(xs) => xs
    _ => return Err(not_object(v))
  }
  var out: List[(Str, json.Value)] = []
  for (k, sv) in fields {
    if !CONTRACT_SECTIONS.contains(k) {
      out.push((k, sv))
      continue
    }
    let entries = match sv {
      json.Value.Object(es) => es
      _ => return Err(not_object(sv))
    }
    var norm: List[(Str, json.Value)] = []
    for (ek, e) in entries {
      let ef = match e {
        json.Value.Object(f) => f
        _ => return Err(not_object(e))
      }
      norm.push((ek, normalize_entry(k, ef)?))
    }
    out.push((k, json.Value.Object(norm)))
  }
  Ok(json.Value.Object(out))
}

/// MSAL's error for a value where its decoder wants an object.
fn not_object(v: json.Value) -> Str {
  "Unmarshal expected opening {, received ${token_text_of(v)}"
}

/// The access token fields MSAL keeps as Unix times (its time.Unix).
const UNIX_FIELDS: List[Str] = ["refresh_on", "expires_on", "extended_expires_on", "cached_at"]

/// The string fields of each section's entries, as MSAL's structs name
/// them; any other field is MSAL's AdditionalFields, kept as it is.
fn string_fields(section: Str) -> List[Str] {
  match section {
    "AccessToken" => ["home_account_id", "environment", "realm", "credential_type", "client_id", "secret", "target", "user_assertion_hash", "token_type", "keyid", "ext_cache_key"]
    "RefreshToken" => ["home_account_id", "environment", "credential_type", "client_id", "family_id", "secret", "realm", "target", "user_assertion_hash"]
    "IdToken" => ["home_account_id", "environment", "realm", "credential_type", "client_id", "secret", "user_assertion_hash"]
    "Account" => ["home_account_id", "environment", "realm", "local_account_id", "authority_type", "username", "given_name", "family_name", "middle_name", "name", "alternative_account_id", "client_info", "user_assertion_hash"]
    "AppMetadata" => ["family_id", "client_id", "environment"]
    _ => []
  }
}

/// An entry as MSAL decodes it and writes it back: a string field that
/// is empty or null left out (Go's omitempty), a Unix time as its
/// seconds in a string; Go's error for a value of another type.
fn normalize_entry(section: Str, fields: List[(Str, json.Value)]) -> json.Value ! Str {
  let strings = string_fields(section)
  var out: List[(Str, json.Value)] = []
  for (f, x) in fields {
    if section == "AccessToken" && UNIX_FIELDS.contains(f) {
      out.push((f, json.Value.Str("${unix_field(x)?}")))
    } else if strings.contains(f) {
      match x {
        json.Value.Str(v) => if v != "" { out.push((f, x)) }
        json.Value.Null => ()
        _ => return Err("json: cannot unmarshal ${go_kind(x)} into Go value of type string")
      }
    } else {
      out.push((f, x))
    }
  }
  Ok(json.Value.Object(out))
}

/// The JSON kind Go's errors name.
fn go_kind(v: json.Value) -> Str {
  match v {
    json.Value.Bool(_) => "bool"
    json.Value.Int(_) => "number"
    json.Value.Num(_) => "number"
    json.Value.List(_) => "array"
    json.Value.Object(_) => "object"
    _ => "string"
  }
}

/// MSAL's time.Unix UnmarshalJSON: the value's text with its quotes
/// trimmed, read by Go's strconv.Atoi.
fn unix_field(x: json.Value) -> Int ! Str {
  let raw = x.encode()
  let text = raw.trim_chars("\"")
  let digits = if text.starts_with("+") || text.starts_with("-") { text[1..text.len()] } else { text }
  let why = if digits == "" || !digits.runes().all(fn(r: Rune) -> Bool { r >= '0' && r <= '9' }) {
    "invalid syntax"
  } else {
    match Int.parse(text.trim_start_chars("+")) {
      Some(n) => return Ok(n)
      None => "value out of range"
    }
  }
  Err("unix time(${raw}) could not be converted from string to int: strconv.Atoi: parsing ${json.encode_str(text)}: ${why}")
}

/// How Go's %v prints the first token of a value that isn't an object.
fn token_text_of(v: json.Value) -> Str {
  match v {
    json.Value.List(_) => "["
    json.Value.Str(s) => s
    json.Value.Null => "<nil>"
    json.Value.Bool(b) => "${b}"
    _ => v.encode()
  }
}

/// The entries of a contract's section, by key.
fn section_of(doc: json.Value, name: Str) -> List[(Str, json.Value)] {
  match doc.get(name) {
    Some(json.Value.Object(xs)) => xs
    _ => []
  }
}

/// `doc` with its section `name`'s entry `key` set to `entry` (a new
/// section when it had none).
fn put_entry(doc: json.Value, name: Str, key: Str, entry: json.Value) -> json.Value {
  let fields = match doc {
    json.Value.Object(xs) => xs
    _ => []
  }
  let entries = section_of(doc, name).filter(fn(e: (Str, json.Value)) -> Bool { e.0 != key }) + [(key, entry)]
  var out = fields.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != name })
  out.push((name, json.Value.Object(entries)))
  json.Value.Object(out)
}

/// The sections MSAL Go writes, in its order; then any others, sorted.
const CONTRACT_SECTIONS: List[Str] = ["AccessToken", "RefreshToken", "IdToken", "Account", "AppMetadata"]

/// The contract's JSON as MSAL Go writes it: every section (empty ones
/// too), each section's entries sorted by key (Go writes its maps in no
/// fixed order), an entry's fields as stored.
fn encode_contract(doc: json.Value) -> Str {
  let fields = match doc {
    json.Value.Object(xs) => xs
    _ => []
  }
  let sorted = fn(xs: List[(Str, json.Value)]) -> json.Value { json.Value.Object(xs.sort_by(fn(e: (Str, json.Value)) -> Str { e.0 })) }
  var out: List[(Str, json.Value)] = []
  for s in CONTRACT_SECTIONS {
    out.push((s, sorted(section_of(doc, s))))
  }
  for (k, v) in fields.sort_by(fn(e: (Str, json.Value)) -> Str { e.0 }) {
    if !CONTRACT_SECTIONS.contains(k) {
      out.push((k, v))
    }
  }
  json.Value.Object(out).encode()
}

fn entry_str(e: json.Value, k: Str) -> Str {
  match e.get(k) {
    Some(json.Value.Str(s)) => s
    _ => ""
  }
}

/// A stored Unix time (seconds in a string, as `parse_contract` leaves
/// it); None for none. Zero is the Unix epoch, as in Go.
fn entry_time(e: json.Value, k: Str) -> Time? {
  match e.get(k) {
    Some(json.Value.Str(s)) => Int.parse(s).map(fn(n: Int) -> Time { Time.from_unix_millis(n * 1000) })
    _ => None
  }
}

/// MSAL's needsUpgrade: a key of the v1.0 schema has an upper-case
/// letter (v1.1 keys are lower case).
fn needs_upgrade(key: Str) -> Bool {
  key.runes().any(fn(r: Rune) -> Bool { r >= 'A' && r <= 'Z' })
}

/// MSAL's upgrade of the v1.0 entry `key` of `section`: the entry moves
/// to its lower-case key, unless one is there already, which MSAL
/// prefers (a newer MSAL wrote it); the v1.0 entry is removed. Gives the
/// contract and the entry now under the lower-case key.
fn upgrade(doc: json.Value, section: Str, key: Str) -> (json.Value, json.Value) {
  let lower = key.to_lower()
  let entries = section_of(doc, section)
  let find = fn(k: Str) -> json.Value? { entries.filter(fn(x: (Str, json.Value)) -> Bool { x.0 == k }).first().map(fn(x: (Str, json.Value)) -> json.Value { x.1 }) }
  let v = find(lower) ?? find(key) ?? json.Value.Object([])
  let fields = match doc {
    json.Value.Object(xs) => xs
    _ => []
  }
  let kept = entries.filter(fn(x: (Str, json.Value)) -> Bool { x.0 != key && x.0 != lower }) + [(lower, v)]
  (json.Value.Object(fields.map(fn(f: (Str, json.Value)) -> (Str, json.Value) { if f.0 == section { (f.0, json.Value.Object(kept)) } else { f } })), v)
}

/// The first entry of `section` (by key; Go's map order is random) that
/// `matches`, upgraded when its key is v1.0's, as MSAL's read functions
/// take it.
fn take_entry(doc: json.Value, section: Str, matches: fn(json.Value) -> Bool) -> (json.Value, json.Value?) {
  for (k, e) in section_of(doc, section).sort_by(fn(x: (Str, json.Value)) -> Str { x.0 }) {
    if matches(e) {
      if needs_upgrade(k) {
        let (d, v) = upgrade(doc, section, k)
        return (d, Some(v))
      }
      return (doc, Some(e))
    }
  }
  (doc, None)
}

/// MSAL's isMatchingScopes: every requested scope in the entry's
/// target, ignoring case.
fn scopes_match(requested: List[Str], target: Str) -> Bool {
  let have = target.split(" ").map(fn(s: Str) -> Str { s.to_lower() })
  requested.all(fn(s: Str) -> Bool { have.contains(s.to_lower()) })
}

/// MSAL's readAccessToken, then its checks of the token: the first entry
/// for the account (`home` "" for an app), an environment in `aliases`,
/// the realm, client and a bearer token type, whose target holds the
/// scopes (upgraded when its key is v1.0's, which may give the entry
/// already under the lower-case key); usable when it was cached in the
/// past and expires 5 minutes from now or later, before its refresh
/// time. Gives the contract as the read left it.
fn find_access_token(doc: json.Value, home: Str, aliases: List[Str], realm: Str, client: Str, scopes: List[Str], now: Time) -> (json.Value, azcore.AccessToken?) {
  let matches = fn(e: json.Value) -> Bool {
    let tt = entry_str(e, "token_type")
    let bearer = (tt.to_lower() == "bearer" && entry_str(e, "keyid") == "") || tt == ""
    entry_str(e, "home_account_id") == home && entry_str(e, "realm") == realm && entry_str(e, "client_id") == client && bearer && aliases.contains(entry_str(e, "environment")) && scopes_match(scopes, entry_str(e, "target")) && entry_str(e, "ext_cache_key") == ""
  }
  let (d, found) = take_entry(doc, "AccessToken", matches)
  let e = found ?? return (d, None)
  let cached = entry_time(e, "cached_at") ?? return (d, None)
  let expires = entry_time(e, "expires_on") ?? return (d, None)
  if cached.unix_millis() > now.unix_millis() || expires.unix_millis() < now.unix_millis() + 5 * 60 * 1000 {
    return (d, None)
  }
  let refresh = entry_time(e, "refresh_on")
  if let Some(r) = refresh {
    if now.unix_millis() > r.unix_millis() {
      return (d, None)
    }
  }
  (d, Some(azcore.AccessToken{token: Secret.new(entry_str(e, "secret")), expires_on: expires, refresh_on: refresh}))
}

/// What MSAL keeps of a token response.
struct Granted {
  home: Str
  environment: Str
  realm: Str
  client: Str
  target: Str
  secret: Str
  token_type: Str
  /// Unix seconds; 0 for none.
  cached_at: Int
  expires_on: Int
  ext_expires_on: Int
  refresh_on: Int
}

/// `doc` with the access token of `g` written as MSAL's Write writes it:
/// only when it is good for 5 minutes or more (MSAL's Validate).
fn write_access_token(doc: json.Value, g: Granted, now: Int) -> json.Value {
  if g.cached_at > now || g.expires_on < now + 300 {
    return doc
  }
  var f: List[(Str, json.Value)] = []
  let s = fn(k: Str, v: Str) -> (Str, json.Value) { (k, json.Value.Str(v)) }
  if g.home != "" {
    f.push(s("home_account_id", g.home))
  }
  f = f + [s("environment", g.environment), s("realm", g.realm), s("credential_type", "AccessToken"), s("client_id", g.client), s("secret", g.secret), s("target", g.target)]
  if g.refresh_on != 0 {
    f.push(s("refresh_on", "${g.refresh_on}"))
  }
  f.push(s("expires_on", "${g.expires_on}"))
  if g.ext_expires_on != 0 {
    f.push(s("extended_expires_on", "${g.ext_expires_on}"))
  }
  f = f + [s("cached_at", "${g.cached_at}"), s("token_type", g.token_type)]
  var key = [g.home, g.environment, "accesstoken", g.client, g.realm, g.target]
  if g.token_type.to_lower() != "bearer" {
    key.push(g.token_type)
  }
  put_entry(doc, "AccessToken", key.join("-").to_lower(), json.Value.Object(f))
}

/// An entry of MSAL's: its fields in order, those empty left out (Go's
/// omitempty).
fn entry_of(fields: List[(Str, Str)]) -> json.Value {
  json.Value.Object(fields.filter(fn(f: (Str, Str)) -> Bool { f.1 != "" }).map(fn(f: (Str, Str)) -> (Str, json.Value) { (f.0, json.Value.Str(f.1)) }))
}

/// `doc` with the client's app metadata (MSAL's AppMetaData).
fn write_app_metadata(doc: json.Value, environment: Str, client: Str, family: Str) -> json.Value {
  put_entry(doc, "AppMetadata", "appmetadata-${environment}-${client}".to_lower(), entry_of([("family_id", family), ("client_id", client), ("environment", environment)]))
}

/// What MSAL keeps of a user's token response besides the access token.
struct UserGranted {
  home: Str
  environment: Str
  realm: Str
  client: Str
  refresh_token: Str
  family: Str
  /// The raw ID token, "" for none.
  id_token: Str
  local_account_id: Str
  authority_type: Str
  username: Str
}

/// `doc` with a user's refresh token, ID token and account written as
/// MSAL's Write writes them (before the access token, which
/// `write_access_token` writes), and the app metadata.
fn write_user(doc: json.Value, u: UserGranted, at: Granted, now: Int) -> json.Value {
  var d = doc
  if u.refresh_token != "" {
    let fourth = if u.family == "" { u.client } else { u.family }
    d = put_entry(d, "RefreshToken", [u.home, u.environment, "refreshtoken", fourth].join("-").to_lower(), entry_of([("home_account_id", u.home), ("environment", u.environment), ("credential_type", "RefreshToken"), ("client_id", u.client), ("family_id", u.family), ("secret", u.refresh_token)]))
  }
  d = write_access_token(d, at, now)
  if u.id_token != "" {
    d = put_entry(d, "IdToken", [u.home, u.environment, "idtoken", u.client, u.realm].join("-").to_lower(), entry_of([("home_account_id", u.home), ("environment", u.environment), ("realm", u.realm), ("credential_type", "IdToken"), ("client_id", u.client), ("secret", u.id_token)]))
    d = put_entry(d, "Account", [u.home, u.environment, u.realm].join("-").to_lower(), entry_of([("home_account_id", u.home), ("environment", u.environment), ("realm", u.realm), ("local_account_id", u.local_account_id), ("authority_type", u.authority_type), ("username", u.username)]))
  }
  write_app_metadata(d, u.environment, u.client, u.family)
}

/// The rest of MSAL's Read for an account, after the access token: the
/// ID token, the app metadata and (when that is found) the refresh
/// token, then the account, each upgraded when its key is v1.0's. Gives
/// the contract as the read left it and the refresh token: the
/// account's for this client, else a family one, by the client first
/// unless the metadata names a family (MSAL's readRefreshToken).
fn read_account(doc: json.Value, home: Str, aliases: List[Str], realm: Str, client: Str) -> (json.Value, Str?) {
  let env_ok = fn(e: json.Value) -> Bool { aliases.contains(entry_str(e, "environment")) }
  var (d, _) = take_entry(doc, "IdToken", fn(e: json.Value) -> Bool { entry_str(e, "home_account_id") == home && entry_str(e, "realm") == realm && entry_str(e, "client_id") == client && env_ok(e) })
  let (d2, meta) = take_entry(d, "AppMetadata", fn(e: json.Value) -> Bool { env_ok(e) && entry_str(e, "client_id") == client })
  d = d2
  var rt: Str? = None
  if let Some(m) = meta {
    let ours = fn(e: json.Value) -> Bool { entry_str(e, "home_account_id") == home && env_ok(e) }
    let by_client = fn(e: json.Value) -> Bool { ours(e) && entry_str(e, "client_id") == client }
    let by_family = fn(e: json.Value) -> Bool { ours(e) && entry_str(e, "family_id") != "" }
    let order = if entry_str(m, "family_id") == "" { [by_client, by_family] } else { [by_family, by_client] }
    for f in order {
      let (d3, found) = take_entry(d, "RefreshToken", f)
      d = d3
      if let Some(e) = found {
        rt = Some(entry_str(e, "secret"))
        break
      }
    }
  }
  let (d4, _) = take_entry(d, "Account", fn(e: json.Value) -> Bool { entry_str(e, "home_account_id") == home && env_ok(e) && entry_str(e, "realm") == realm })
  (d4, rt)
}
