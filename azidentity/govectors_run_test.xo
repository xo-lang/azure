// The credentials against the Go program's fake token endpoint: each
// token request must be Go's (govectors_test.xo), MSAL Go's form and
// headers included.

use std/crypto
use std/http
use std/json
use std/x509
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/cloud
use github.com/xo-lang/azure/policy

const GV_AUTHORITY: Str = "https://login.example.test/"

struct GvFake {
  log: Mutex[List[Str]]
  /// statuses for the next token requests (else 200)
  next: Mutex[List[Int]]
  /// one-shot replies by path substring: (status, body)
  overrides: Mutex[List[(Str, Int, Str)]]
}

/// The Go program's fake: instance discovery names the tenant of its
/// authorization_endpoint, the OpenID configuration names the endpoints
/// of the host it was asked on, the token endpoint gives `at-1`.
fn gv_serve(net: testing.FakeNet, section: Str) -> GvFake {
  let f = GvFake{log: Mutex[List[Str]].new([]), next: Mutex[List[Int]].new([]), overrides: Mutex[List[(Str, Int, Str)]].new([])}
  let h = fn(req: http.Request) -> http.Response { gv_answer(f, section, req) }
  for host in ["https://login.example.test", "https://login.microsoftonline.com", "https://login.microsoftonline.us", "https://other.example.test", "https://westus2.login.example.test"] {
    net.handle("GET ${host}/{rest...}", h)
    net.handle("POST ${host}/{rest...}", h)
  }
  f
}

/// A signed client assertion's JOSE header as the Go program prints it:
/// `k=v` sorted, x5c as its certificates' common names; "" when the
/// form's assertion is not a JWT.
fn gv_jose(form: Str) -> Str {
  let (_, rest) = form.cut("client_assertion=") ?? return ""
  let a = (rest.cut("&").map(fn(p: (Str, Str)) -> Str { p.0 })) ?? rest
  let parts = a.split(".")
  if parts.len() != 3 {
    return ""
  }
  var b64 = parts[0].replace("-", "+").replace("_", "/")
  while b64.len() % 4 != 0 {
    b64 = b64 + "="
  }
  let raw = Bytes.from_base64(b64) ?? return "bad header"
  let doc = json.parse_value(raw.to_str_lossy()) ?? _ => return "bad header json"
  var kv: List[Str] = []
  if let json.Value.Object(fields) = doc {
    for (k, v) in fields {
      if k == "x5c" {
        let names = match v {
          json.Value.List(xs) => xs.map(fn(x: json.Value) -> Str {
            let der = Bytes.from_base64(str_of_value(x)) ?? return "?"
            (x509.parse(der) ?? _ => return "?").subject.common_name
          })
          _ => []
        }
        kv.push("x5c=[${names.join(",")}]")
      } else {
        kv.push("${k}=${str_of_value(v)}")
      }
    }
  }
  kv.sort().join(" | ")
}

fn gv_answer(f: GvFake, section: Str, req: http.Request) -> http.Response {
  var hs: List[Str] = []
  for (k, v) in req.headers {
    let lk = k.to_lower()
    if lk != "user-agent" && lk != "accept-encoding" && lk != "x-ms-client-request-id" && lk != "content-length" {
      hs.push("${lk}=${if lk == "client-request-id" { "<uuid>" } else { v }}")
    }
  }
  var body = req.body.to_str_lossy()
  if let Some((a, rest)) = body.cut("client_assertion=") {
    let tail = match rest.cut("&") {
      Some((_, t)) => "&${t}"
      None => ""
    }
    body = "${a}client_assertion=<jwt>${tail}"
  }
  let host = req.header("Host") ?? req.url.host
  let path = req.escaped_path()
  let qs = req.raw_query()
  let jose = gv_jose(req.body.to_str_lossy())
  f.log.with(fn(var l: List[Str]) { l.push("${section}: REQ ${req.method} https://${host}${path}${if qs == "" { "" } else { "?${qs}" }}\n  H ${hs.sort().join(" | ")}\n  B ${body}${if jose == "" { "" } else { "\n  J ${jose}" }}") })
  let o = f.overrides.with(fn(var os: List[(Str, Int, Str)]) -> (Int, Str)? {
    for i in 0..os.len() {
      if path.contains(os[i].0) {
        let r = (os[i].1, os[i].2)
        os.remove_at(i)
        return Some(r)
      }
    }
    None
  })
  if let Some((st, b)) = o {
    return http.text(st, b)
  }
  if path.contains("discovery/instance") {
    let ae = req.query("authorization_endpoint") ?? ""
    let t = (ae.trim_prefix("https://login.example.test/").cut("/").map(fn(p: (Str, Str)) -> Str { p.0 })) ?? ""
    return http.text(200, "{\"tenant_discovery_endpoint\":\"https://login.example.test/${t}/v2.0/.well-known/openid-configuration\",\"api-version\":\"1.1\",\"metadata\":[{\"preferred_network\":\"login.example.test\",\"preferred_cache\":\"login.example.test\",\"aliases\":[\"login.example.test\"]}]}")
  }
  if path.ends_with("openid-configuration") {
    let t = path.trim_prefix("/").cut("/").map(fn(p: (Str, Str)) -> Str { p.0 }) ?? ""
    return http.text(200, "{\"token_endpoint\":\"https://${host}/${t}/oauth2/v2.0/token\",\"authorization_endpoint\":\"https://${host}/${t}/oauth2/v2.0/authorize\",\"issuer\":\"https://${host}/${t}/v2.0\"}")
  }
  let st = f.next.with(fn(var n: List[Int]) -> Int { if n.is_empty() { 200 } else { n.remove_at(0) } })
  if st != 200 {
    return http.text(st, "{\"error\":\"invalid_client\",\"error_description\":\"AADSTS7000215: bad secret\",\"error_codes\":[7000215]}")
  }
  http.text(200, "{\"token_type\":\"Bearer\",\"expires_in\":3600,\"ext_expires_in\":3600,\"access_token\":\"at-1\"}")
}

fn gv_opts[fx: Effects](allowed: List[Str] = [], authority: Str = GV_AUTHORITY, nodisc: Bool = false) -> Options[fx] {
  Options{client: policy.ClientOptions{cloud: cloud.Configuration{authority_host: authority}, retry: policy.RetryOptions{max_retries: -1}}, additionally_allowed_tenants: allowed, disable_instance_discovery: nodisc}
}

/// The Go program's lines of `section`, and the ones logged here.
fn gv_lines(f: GvFake, section: Str, all: List[Str] = GO_TOKEN_LINES) -> (List[Str], List[Str]) {
  let got = f.log.with_read(fn(l: List[Str]) -> List[Str] { l.join("\n").split("\n") })
  var want: List[Str] = []
  var keep = false
  for l in all {
    if l.starts_with("${section}: ") {
      keep = true
      want.push(l)
    } else if keep && l.starts_with("  ") {
      want.push(l)
    } else {
      keep = false
    }
  }
  (got, want)
}

fn gv_note(f: GvFake, s: Str) {
  f.log.with(fn(var l: List[Str]) { l.push(s) })
}

/// The Go program's line for a credential's construction.
fn gv_new[T](f: GvFake, section: Str, label: Str, r: Result[T, azcore.AuthErr]) {
  match r {
    Ok(_) => gv_note(f, "${section}: NEW ${label}: <nil>")
    Err(e) => gv_note(f, "${section}: NEW ${label}: ${e.display()}")
  }
}

/// The Go program's line for a token, an AuthenticationFailedError (a
/// status) or another error, each further line behind `| `.
fn gv_get(f: GvFake, section: Str, label: Str, r: Result[azcore.AccessToken, azcore.AuthErr]) {
  match r {
    Ok(t) => gv_note(f, "${section}: OUT ${label}: token=${t.token.reveal()} expires=<t>")
    Err(e) => {
      let kind = if e.failed { "auth failed" } else { "error" }
      gv_note(f, "${section}: OUT ${label}: ${kind}: ${e.display().replace("\n", "\n${section}: | ")}")
    }
  }
}

const GV_SCOPE: Str = "https://vault.example.test/.default"

test "the client secret credential's requests and errors are Go's" {
  let f = gv_serve(os.net, "secret")
  let mk = fn(t: Str, c: Str, sec: Str, allowed: List[Str]) -> ClientSecretCredential ! azcore.AuthErr { new_client_secret_credential(t, c, sec, os.net, os.clock, os.rand, gv_opts(allowed)) }
  gv_new(f, "secret", "secret", mk("tenant-a", "client-1", "s3cret", ["tenant-b"]))
  gv_new(f, "secret", "secret no client", mk("tenant-a", "", "s", []))
  gv_new(f, "secret", "secret no secret", mk("tenant-a", "client-1", "", []))
  let c = mk("tenant-a", "client-1", "s3cret", ["tenant-b"])?
  gv_get(f, "secret", "secret first", c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE]}))
  gv_get(f, "secret", "secret cached", c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE]}))
  gv_get(f, "secret", "secret tenant-b", c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE], tenant_id: "tenant-b"}))
  gv_get(f, "secret", "secret tenant-c", c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE], tenant_id: "tenant-c"}))
  gv_get(f, "secret", "secret claims", c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE], claims: "{\"access_token\":{\"nbf\":{\"essential\":true}}}", enable_cae: true}))
  gv_get(f, "secret", "secret two scopes", c.get_token(azcore.TokenRequestOptions{scopes: ["a", "b"]}))
  f.next.reset([401])
  gv_get(f, "secret", "secret 401", c.get_token(azcore.TokenRequestOptions{scopes: ["https://other.example.test/.default"]}))
  gv_new(f, "secret", "bad tenant", mk("bad tenant!", "client-1", "s", []))
  let (got, want) = gv_lines(f, "secret")
  expect(got) == want
}

test "the workload identity credential's token request is MSAL Go's" {
  let f = gv_serve(os.net, "workload")
  os.fs.write("/var/run/idgo-token", b"fed-token-1")?
  let w = new_workload_identity_credential("tenant-a", "client-1", "/var/run/idgo-token", os.fs, os.net, os.clock, os.rand, gv_opts())
  gv_new(f, "workload", "workload", w)
  gv_get(f, "workload", "workload", w?.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE]}))
  let (got, want) = gv_lines(f, "workload")
  // the options taking AZURE_CLIENT_ID and the others come with (9)
  expect(got) == want.filter(fn(l: Str) -> Bool { !l.starts_with("workload: NEW workload empty") })
}

/// One discovery case of the Go program: a secret credential at
/// `authority`, with replies overridden by path.
fn gv_disc(os: testing.TestOs, section: Str, label: Str, authority: Str, nodisc: Bool, overrides: List[(Str, Int, Str)], scopes: List[List[Str]] = [[GV_SCOPE]], labels: List[Str] = [], cae: List[Bool] = [], unlogged: Int = 0) {
  let f = gv_serve(os.net, section)
  f.overrides.reset(overrides)
  let c = new_client_secret_credential("tenant-a", "client-1", "s3cret", os.net, os.clock, os.rand, gv_opts(authority: authority, nodisc: nodisc)) ?? e => {
    expect(e.display()) == "built"
    return
  }
  for (i, sc) in scopes.indexed() {
    gv_get(f, section, if labels.is_empty() { label } else { labels[i] }, c.get_token(azcore.TokenRequestOptions{scopes: sc, enable_cae: !cae.is_empty() && cae[i]}))
  }
  let (got, want) = gv_lines(f, section)
  // a request FakeNet fails never reaches the handler, so its three
  // lines are not logged; the Go program logs them first
  expect(got) == want[unlogged * 3..want.len()]
}

const MS: Str = "https://login.microsoftonline.com/"

test "instance discovery and the OpenID configuration are MSAL Go's" {
  gv_disc(os, "disc-trusted", "", MS, false, [], scopes: [[GV_SCOPE], ["https://other.example.test/.default"]], labels: ["trusted first", "trusted second scope"])
  gv_disc(os, "disc-trusted-nodisc", "trusted nodisc", MS, true, [])
  gv_disc(os, "nodisc", "secret no discovery", GV_AUTHORITY, true, [])
  gv_disc(os, "disc-disc500", "disc500", GV_AUTHORITY, false, [("discovery/instance", 500, "{\"error\":\"server_error\"}")])
  gv_disc(os, "disc-invalid-instance", "invalid instance", GV_AUTHORITY, false, [("discovery/instance", 400, "{\"error\":\"invalid_instance\",\"error_description\":\"AADSTS50049: Unknown or invalid instance.\"}")])
  gv_disc(os, "disc-oidc-missing", "oidc missing", GV_AUTHORITY, true, [("openid-configuration", 200, "{\"authorization_endpoint\":\"https://login.example.test/tenant-a/oauth2/v2.0/authorize\",\"issuer\":\"https://login.example.test/tenant-a/v2.0\"}")])
  gv_disc(os, "disc-oidc-issuer", "oidc issuer", GV_AUTHORITY, true, [("openid-configuration", 200, "{\"token_endpoint\":\"https://login.example.test/tenant-a/oauth2/v2.0/token\",\"authorization_endpoint\":\"https://login.example.test/tenant-a/oauth2/v2.0/authorize\",\"issuer\":\"https://evil.example.test/tenant-a/v2.0\"}")])
  gv_disc(os, "disc-oidc-404", "oidc 404", GV_AUTHORITY, true, [("openid-configuration", 404, "{\"error\":\"not_found\"}")])
  gv_disc(os, "disc-tenant-token", "tenant template", GV_AUTHORITY, true, [("openid-configuration", 200, "{\"token_endpoint\":\"https://login.example.test/{tenant}/oauth2/v2.0/token\",\"authorization_endpoint\":\"https://login.example.test/{tenant}/oauth2/v2.0/authorize\",\"issuer\":\"https://login.example.test/{tenant}/v2.0\"}")])
  gv_disc(os, "disc-cae", "", GV_AUTHORITY, false, [], scopes: [[GV_SCOPE], [GV_SCOPE]], labels: ["plain", "cae"], cae: [false, true])
  let other = ["https://other.example.test/.default"]
  gv_disc(os, "disc-invalid-instance-twice", "", GV_AUTHORITY, false, [("discovery/instance", 400, "{\"error\":\"invalid_instance\",\"error_description\":\"AADSTS50049: Unknown or invalid instance.\"}")], scopes: [[GV_SCOPE], other], labels: ["first", "second scope"])
  gv_disc(os, "disc-disc500-twice", "", GV_AUTHORITY, false, [("discovery/instance", 500, "{\"error\":\"server_error\"}")], scopes: [[GV_SCOPE], other], labels: ["first", "second scope"])
  gv_disc(os, "disc-disc-fail", "discovery fails", GV_AUTHORITY, false, [("discovery/instance", 500, "{\"error\":\"server_error\"}"), ("discovery/instance", 500, "{\"error\":\"server_error\"}")])
  gv_disc(os, "disc-alias", "alias", GV_AUTHORITY, false, [("discovery/instance", 200, "{\"tenant_discovery_endpoint\":\"https://other.example.test/tenant-a/v2.0/.well-known/openid-configuration\",\"api-version\":\"1.1\",\"metadata\":[{\"preferred_network\":\"login.example.test\",\"preferred_cache\":\"login.example.test\",\"aliases\":[\"login.example.test\",\"other.example.test\"]}]}"), ("discovery/instance", 200, "{\"tenant_discovery_endpoint\":\"https://other.example.test/tenant-a/v2.0/.well-known/openid-configuration\",\"api-version\":\"1.1\",\"metadata\":[{\"preferred_network\":\"login.example.test\",\"preferred_cache\":\"login.example.test\",\"aliases\":[\"login.example.test\",\"other.example.test\"]}]}")])
  gv_disc(os, "disc-alias-miss", "alias miss", GV_AUTHORITY, false, [("discovery/instance", 200, "{\"tenant_discovery_endpoint\":\"https://other.example.test/tenant-a/v2.0/.well-known/openid-configuration\",\"api-version\":\"1.1\",\"metadata\":[{\"preferred_network\":\"x.example.test\",\"preferred_cache\":\"x.example.test\",\"aliases\":[\"x.example.test\",\"other.example.test\"]}]}"), ("discovery/instance", 200, "{\"tenant_discovery_endpoint\":\"https://other.example.test/tenant-a/v2.0/.well-known/openid-configuration\",\"api-version\":\"1.1\",\"metadata\":[{\"preferred_network\":\"x.example.test\",\"preferred_cache\":\"x.example.test\",\"aliases\":[\"x.example.test\",\"other.example.test\"]}]}")])
  gv_disc(os, "disc-issuer-trusted", "issuer trusted", GV_AUTHORITY, true, [("openid-configuration", 200, "{\"token_endpoint\":\"https://login.example.test/tenant-a/oauth2/v2.0/token\",\"authorization_endpoint\":\"https://login.example.test/tenant-a/oauth2/v2.0/authorize\",\"issuer\":\"https://login.microsoftonline.com/tenant-a/v2.0\"}")])
  gv_disc(os, "disc-issuer-regional", "issuer regional", "https://westus2.login.example.test/", true, [("openid-configuration", 200, "{\"token_endpoint\":\"https://westus2.login.example.test/tenant-a/oauth2/v2.0/token\",\"authorization_endpoint\":\"https://westus2.login.example.test/tenant-a/oauth2/v2.0/authorize\",\"issuer\":\"https://login.example.test/tenant-a/v2.0\"}")])
  // a transport error on the first instance discovery: MSAL keeps its
  // fallback entry, so the next token request asks for none
  os.net.fail_next("GET https://login.microsoftonline.com/common/discovery/instance", http.ClientErr.Connect("fake transport error"))
  gv_disc(os, "disc-neterr-twice", "", GV_AUTHORITY, false, [], scopes: [[GV_SCOPE], other], labels: ["first", "second scope"], unlogged: 1)
  gv_disc(os, "disc-trusted-us", "trusted us", "https://login.microsoftonline.us/", false, [])
}

test "the client assertion credential calls back only on a cache miss, as Go's" {
  let f = gv_serve(os.net, "assertion2")
  let calls = Atomic[Int].new(0)
  let cb = fn() -> Str ! Str { Ok("assert-${calls.add(1)}") }
  let c = new_client_assertion_credential("tenant-a", "client-1", cb, os.net, os.clock, os.rand, gv_opts(["tenant-b"]))?
  gv_get(f, "assertion2", "assertion first", c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE]}))
  gv_get(f, "assertion2", "assertion cached", c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE]}))
  gv_get(f, "assertion2", "assertion tenant-b", c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE], tenant_id: "tenant-b"}))
  gv_get(f, "assertion2", "assertion tenant-c", c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE], tenant_id: "tenant-c"}))
  // Go's program prints CALLS 2 here
  expect(calls.get()) == 2
  f.next.reset([401])
  gv_get(f, "assertion2", "assertion 401", c.get_token(azcore.TokenRequestOptions{scopes: ["https://other.example.test/.default"]}))
  gv_new(f, "assertion2", "assertion bad tenant", new_client_assertion_credential("bad tenant!", "client-1", cb, os.net, os.clock, os.rand, gv_opts()))
  let (got, want) = gv_lines(f, "assertion2")
  // a callback cannot be nil in Xo, so Go's nil check has no counterpart
  expect(got) == want.filter(fn(l: Str) -> Bool { !l.starts_with("assertion2: NEW assertion nil") })
  // the harness masks the assertion; it is the callback's text, sent as is
  let bodies = os.net.requests().filter(fn(r: http.Request) -> Bool { r.method == "POST" }).map(fn(r: http.Request) -> Str { r.body.to_str_lossy() })
  expect(bodies[0].contains("client_assertion=assert-1&")) == true
  expect(bodies[1].contains("client_assertion=assert-2&")) == true
}

test "a client assertion callback's error is the credential's, as Go's" {
  let f = gv_serve(os.net, "assertion-err")
  let c = new_client_assertion_credential("tenant-a", "client-1", fn() -> Str ! Str { Err("no assertion here") }, os.net, os.clock, os.rand, gv_opts())?
  gv_get(f, "assertion-err", "assertion error", c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE]}))
  gv_get(f, "assertion-err", "assertion error again", c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE]}))
  let (got, want) = gv_lines(f, "assertion-err")
  expect(got) == want
}

test "the client assertion credential's first request is MSAL Go's" {
  let f = gv_serve(os.net, "assertion")
  let c = new_client_assertion_credential("tenant-a", "client-1", fn() -> Str ! Str { Ok("assert-1") }, os.net, os.clock, os.rand, gv_opts())
  gv_new(f, "assertion", "assertion", c)
  gv_get(f, "assertion", "assertion", c?.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE]}))
  let (got, want) = gv_lines(f, "assertion")
  expect(got) == want
}

const PFX_LEGACY: Bytes = embed("testdata/test-legacy.pfx")
const PFX_NOPASS: Bytes = embed("testdata/test-nopass.pfx")
const PFX_AES: Bytes = embed("testdata/test-aes.pfx")
const PFX_CHAIN: Bytes = embed("testdata/test-chain.pfx")
const PFX_EC: Bytes = embed("testdata/test-ec.pfx")
const PFX_PASSWORD: Str = "xo-test-only"

/// The key a PKCS #8 DER wraps (PKCS #1 for RSA, SEC 1 for EC): the
/// contents of its OCTET STRING after the version and the algorithm.
fn inner_key(p8: Bytes) -> Bytes {
  // a DER element's header length and contents length at `at`
  let element = fn(at: Int) -> (Int, Int) {
    let first = Int(p8[at + 1])
    if first < 0x80 {
      return (2, first)
    }
    let n = first & 0x7f
    var len = 0
    for i in 0..n {
      len = len * 256 + Int(p8[at + 2 + i])
    }
    (2 + n, len)
  }
  let (outer, _) = element(0)
  var at = outer
  for _ in 0..2 {
    // the version INTEGER, then the AlgorithmIdentifier SEQUENCE
    let (h, l) = element(at)
    at += h + l
  }
  let (h, l) = element(at)
  p8[at + h..at + h + l]
}

/// The Go program's describe: the certificates' common names and the
/// key's Go type.
fn gv_describe(r: Result[(List[x509.Certificate], crypto.PrivateKey), azcore.AuthErr]) -> Str {
  match r {
    Ok((certs, key)) => {
      let kind = if key.alg() == crypto.KeyAlg.Rsa { "*rsa.PrivateKey" } else if key.alg() == crypto.KeyAlg.Ed25519 { "ed25519.PrivateKey" } else { "*ecdsa.PrivateKey" }
      "certs=[${certs.map(fn(c: x509.Certificate) -> Str { c.subject.common_name }).join(",")}] key=${kind}"
    }
    Err(e) => "error: ${e.display()}"
  }
}

test "certificates and PKCS #12 files are read as Go's ParseCertificates reads them" {
  let f = gv_serve(os.net, "pfx")
  let pem = TEST_PEM
  let blocks = crypto.pem_decode(pem)
  let cert_pem = crypto.pem_encode(blocks[0])?
  let key_pem = crypto.pem_encode(blocks[1])?
  let ec_key = crypto.generate_key(os.rand, crypto.KeyAlg.EcdsaP256)?
  let ec_cert = x509.create_certificate(os.rand, x509.Template{subject: x509.Name{common_name: "xo-azure-test-only-ec"}, not_before: Time.from_unix_millis(0), not_after: Time.from_unix_millis(4000000000000)}, ec_key.public_key(), None, ec_key)?
  let ec_cert_pem = crypto.pem_encode(crypto.PemBlock{kind: "CERTIFICATE", headers: {}, bytes: ec_cert.raw})?
  let ec_p8 = crypto.marshal_private_key(ec_key)
  // Go's program writes SEC 1 DER here; ParseCertificates skips the
  // block by its type whatever it holds
  let ec_sec1_pem = crypto.pem_encode(crypto.PemBlock{kind: "EC PRIVATE KEY", headers: {}, bytes: ec_p8})?
  let ec_p8_pem = crypto.pem_encode(crypto.PemBlock{kind: "PRIVATE KEY", headers: {}, bytes: ec_p8})?
  let parse = fn(name: Str, data: Bytes, pw: Str) {
    gv_note(f, "pfx: PARSE ${name}: ${gv_describe(parse_certificates(data, pw))}")
  }
  parse("pem", pem.bytes(), "")
  parse("pem with password", pem.bytes(), PFX_PASSWORD)
  parse("pem cert only", cert_pem.bytes(), "")
  parse("pem key only", key_pem.bytes(), "")
  parse("pem key first", (key_pem + cert_pem).bytes(), "")
  parse("pem two keys", (cert_pem + key_pem + key_pem).bytes(), "")
  parse("pem rsa private key", (cert_pem + key_pem.replace("PRIVATE KEY", "RSA PRIVATE KEY")).bytes(), "")
  parse("pem bad certificate", ("-----BEGIN CERTIFICATE-----\nAAAA\n-----END CERTIFICATE-----\n" + key_pem).bytes(), "")
  parse("pem ec sec1", (ec_cert_pem + ec_sec1_pem).bytes(), "")
  parse("pem ec pkcs8", (ec_cert_pem + ec_p8_pem).bytes(), "")
  // PKCS #8's inner key bytes under a PRIVATE KEY label, and two RSA
  // PRIVATE KEY blocks
  let rsa_p1 = inner_key(blocks[1].bytes)
  parse("pem private key pkcs1", (cert_pem + crypto.pem_encode(crypto.PemBlock{kind: "PRIVATE KEY", headers: {}, bytes: rsa_p1})?).bytes(), "")
  // PKCS #8 leaves the curve out of the SEC 1 key it wraps; Go's
  // MarshalECPrivateKey, which the Go program uses, puts it back as [0]
  // (prime256v1's OID) after the private key OCTET STRING
  let bare = inner_key(ec_p8)
  let curve = Bytes.from_hex("a00a06082a8648ce3d030107")?
  // the 1 byte length (under 128) grows by the 12 bytes added
  let n = Int(bare[1]) + curve.len()
  let digits = "0123456789abcdef"
  let header = Bytes.from_hex("30${digits[n / 16..n / 16 + 1]}${digits[n % 16..n % 16 + 1]}")?
  let sec1 = header + bare[2..39] + curve + bare[39..bare.len()]
  parse("pem private key sec1", (ec_cert_pem + crypto.pem_encode(crypto.PemBlock{kind: "PRIVATE KEY", headers: {}, bytes: sec1})?).bytes(), "")
  parse("pem rsa private key sec1", (ec_cert_pem + crypto.pem_encode(crypto.PemBlock{kind: "RSA PRIVATE KEY", headers: {}, bytes: sec1})?).bytes(), "")
  let rsa_block = crypto.pem_encode(crypto.PemBlock{kind: "RSA PRIVATE KEY", headers: {}, bytes: rsa_p1})?
  parse("pem two rsa keys", (cert_pem + rsa_block + rsa_block).bytes(), "")
  parse("not pem", b"hello", "")
  parse("empty", b"", "")
  parse("legacy", PFX_LEGACY, PFX_PASSWORD)
  parse("legacy wrong password", PFX_LEGACY, "nope")
  parse("legacy no password", PFX_LEGACY, "")
  parse("nopass", PFX_NOPASS, "")
  parse("nopass with password", PFX_NOPASS, PFX_PASSWORD)
  parse("aes", PFX_AES, PFX_PASSWORD)
  parse("chain", PFX_CHAIN, PFX_PASSWORD)
  parse("ec pfx", PFX_EC, PFX_PASSWORD)
  os.fs.write("test-legacy.pfx", PFX_LEGACY)?
  for (name, path, pw) in [("env pfx", "test-legacy.pfx", PFX_PASSWORD), ("env pfx wrong password", "test-legacy.pfx", "nope"), ("env missing file", "missing.pfx", "")] {
    let env = os.env
    env.set("AZURE_TENANT_ID", "tenant-a")
    env.set("AZURE_CLIENT_ID", "client-1")
    env.set("AZURE_CLIENT_CERTIFICATE_PATH", path)
    env.set("AZURE_CLIENT_CERTIFICATE_PASSWORD", pw)
    let r = new_environment_credential(env, os.fs, os.net, os.clock, os.rand, gv_opts(nodisc: true))
    gv_new(f, "pfx", name, r)
    if let Ok(c) = r {
      gv_get(f, "pfx", name, c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE]}))
    }
  }
  let (chain, key) = parse_certificates(PFX_CHAIN, PFX_PASSWORD)?
  let leaf = chain[0]
  let ca = chain[1]
  let mk = fn(name: Str, certs: List[x509.Certificate], k: crypto.PrivateKey, send: Bool) {
    let o = gv_opts(nodisc: true)
    let r = new_client_certificate_credential("tenant-a", "client-1", certs, k, os.net, os.clock, os.rand, send_chain: send, opts: o)
    gv_new(f, "pfx", name, r)
    if let Ok(c) = r {
      gv_get(f, "pfx", name, c.get_token(azcore.TokenRequestOptions{scopes: [GV_SCOPE]}))
    }
  }
  mk("cert leaf", [leaf], key, false)
  mk("cert ca first, chain", [ca, leaf], key, true)
  mk("cert ca first, no chain", [ca, leaf], key, false)
  mk("cert ca only", [ca], key, false)
  mk("cert none", [], key, false)
  let (ec_certs, ec_k) = parse_certificates((ec_cert_pem + ec_p8_pem).bytes(), "")?
  mk("cert ec", ec_certs, ec_k, false)
  let (got, want) = gv_lines(f, "pfx")
  // std's PKCS #12 reader says `malformed PFX` where Go prints
  // encoding/asn1's detail (`asn1: structure error: tags don't match
  // ...`); those lines are compared up to Go's common prefix
  let prefix = "error: pkcs12: error reading P12 data: "
  let cut = fn(l: Str) -> Str {
    match l.find(prefix) {
      Some(i) => l[0..i + prefix.len()]
      None => l
    }
  }
  expect(got.map(cut)) == want.map(cut)
  expect(got.filter(fn(l: Str) -> Bool { l.contains(prefix) }).len()) == 3
}
