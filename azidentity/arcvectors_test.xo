// Generated from the output of a local Go program that runs azidentity
// v1.15.0's ManagedIdentityCredential with MSAL Go v1.10.1 against a fake
// Azure Arc agent (no network), its token directory a scratch directory
// shown as /tokens; do not edit. For DefaultAzureCredential only
// ManagedIdentityCredential's part of the aggregate error is kept.

/// One case: `arc1` answers a request without Authorization and `arc2`
/// one with it (`ERR` a transport error, else `status|body`, and for
/// `arc1` `status|WWW-Authenticate|body`); `files` are in the token
/// directory; `env` sets IDENTITY_ENDPOINT (`endpoint`, else the agent's)
/// and IMDS_ENDPOINT; `himds` writes the himds file; `dac` builds the
/// credential as DefaultAzureCredential does.
struct ArcCase {
  name: Str
  arc1: Str
  arc2: Str
  files: List[(Str, Str)]
  id_kind: Str
  id: Str
  env: Bool
  endpoint: Str
  himds: Bool
  dac: Bool
}

const GO_ARC_CASES: List[ArcCase] = [
