// Replays the Go program's UsernamePasswordCredential cases
// (upvectors_test.xo) against the same fakes: the token host (its OpenID
// configuration, the user realm and the token endpoint) and the WS-Trust
// host (the mex document and the username endpoint), reply queues per
// "METHOD host/path[ grant]", the last reply repeating.

use std/http
use std/regexp
use std/testing
use std/time
use std/url
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/policy

const UP_MEX: Str = "https://adfs.example.test/adfs/services/trust/mex"
const UP_13: Str = "https://adfs.example.test/adfs/services/trust/13/usernamemixed"
const UP_2005: Str = "https://adfs.example.test/adfs/services/trust/2005/usernamemixed"
const UP_WIN: Str = "https://adfs.example.test/adfs/services/trust/13/windowstransport"
const UP_REALM: Str = "GET login.example.test/common/UserRealm/"
const UP_MANAGED: Str = "{\"ver\":\"1.0\",\"account_type\":\"Managed\",\"domain_name\":\"example.test\",\"cloud_instance_name\":\"example.test\",\"cloud_audience_urn\":\"urn:federation:Example\"}"
const UP_FEDERATED: Str = "{\"ver\":\"1.0\",\"account_type\":\"Federated\",\"domain_name\":\"example.test\",\"federation_protocol\":\"WSTrust\",\"federation_metadata_url\":\"https://adfs.example.test/adfs/services/trust/mex\",\"federation_active_auth_url\":\"https://adfs.example.test/adfs/services/trust/2005/usernamemixed\",\"cloud_instance_name\":\"example.test\",\"cloud_audience_urn\":\"urn:federation:Example\"}"
const UP_SP: Str = "http://docs.oasis-open.org/ws-sx/ws-securitypolicy/200702"
const UP_T13: Str = "http://docs.oasis-open.org/ws-sx/ws-trust/200512/RST/Issue"
const UP_T2005: Str = "http://schemas.xmlsoap.org/ws/2005/02/trust/RST/Issue"
const UP_SOAP: Str = "http://schemas.xmlsoap.org/soap/http"
const UP_V1: Str = "urn:ietf:params:oauth:grant-type:saml1_1-bearer"
const UP_V2: Str = "urn:ietf:params:oauth:grant-type:saml2-bearer"

/// The Go program's masking of the SOAP request: UUIDs, and the
/// timestamp's times (the expiry checked to be ten minutes on).
fn up_mask(body: Str) -> Str {
  var b = regexp.must("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}").replace_all_literal(body, "<uuid>")
  let caps = regexp.must("<wsu:Created>([^<]*)</wsu:Created><wsu:Expires>([^<]*)</wsu:Expires>").captures(b) ?? return b
  let whole = caps[0] ?? return b
  let layout = "{year}-{month}-{day}T{hour}:{minute}:{second}{frac:3}Z"
  let ten = match (time.parse(caps[1] ?? "", layout, time.utc()), time.parse(caps[2] ?? "", layout, time.utc())) {
    (Ok(c), Ok(x)) => x.unix_millis() - c.unix_millis() == 600000
    _ => false
  }
  b.replace(whole, "<wsu:Created><t0></wsu:Created><wsu:Expires>${if ten { "<t0+10m>" } else { "<bad-expires>" }}</wsu:Expires>")
}

fn up_answer(f: PcFake, req: http.Request) -> http.Response {
  var hs: List[Str] = []
  for (k, v) in req.headers {
    let lk = k.to_lower()
    if lk != "user-agent" && lk != "accept-encoding" && lk != "x-ms-client-request-id" && lk != "content-length" {
      hs.push("${lk}=${if lk == "client-request-id" { "<uuid>" } else { v }}")
    }
  }
  let body = req.body.to_str_lossy()
  let path = req.escaped_path()
  let qs = req.raw_query()
  pc_note(f, "${pc_sec(f)}: REQ ${req.method} https://${req.url.host}${path}${if qs == "" { "" } else { "?${qs}" }}")
  pc_note(f, "  H ${hs.sort().join(" | ")}")
  pc_note(f, "  B ${up_mask(body)}")
  var key = "${req.method} ${req.url.host}${req.url.path}"
  if req.method == "POST" && path.ends_with("/token") {
    for kv in body.split("&") {
      if kv.starts_with("grant_type=") {
        key = "${key} ${url.query_unescape(kv.trim_prefix("grant_type=")).ok() ?? ""}"
      }
    }
  }
  let r = f.q.with(fn(var m: Map[Str, List[(Int, Str)]]) -> (Int, Str)? {
    let rs = m.get(key) ?? return None
    if rs.is_empty() {
      return None
    }
    if rs.len() > 1 {
      m[key] = rs[1..rs.len()]
    }
    Some(rs[0])
  })
  match r {
    Some((st, b)) => http.text(st, b)
    None => {
      pc_note(f, "${pc_sec(f)}: NO REPLY for ${key}")
      http.text(404, "{}")
    }
  }
}

fn up_serve(net: testing.FakeNet) -> PcFake {
  let f = PcFake{section: Mutex[Str].new(""), log: Mutex[List[Str]].new([]), q: Mutex[Map[Str, List[(Int, Str)]]].new({})}
  let h = fn(req: http.Request) -> http.Response { up_answer(f, req) }
  net.handle("GET https://login.example.test/{rest...}", h)
  net.handle("POST https://login.example.test/{rest...}", h)
  net.handle("GET https://adfs.example.test/{rest...}", h)
  net.handle("POST https://adfs.example.test/{rest...}", h)
  f
}

/// A section's fake: both tenants' OpenID configuration, and the user's
/// realm when given.
fn up_start(f: PcFake, section: Str, user: Str = "user@example.com", realm: Str = "") {
  f.section.with(fn(var s: Str) { s = section })
  f.q.with(fn(var m: Map[Str, List[(Int, Str)]]) {
    m = {}
    m["GET login.example.test/tenant-a/v2.0/.well-known/openid-configuration"] = [(200, pc_openid("tenant-a"))]
    m["GET login.example.test/tenant-b/v2.0/.well-known/openid-configuration"] = [(200, pc_openid("tenant-b"))]
    if realm != "" {
      m["${UP_REALM}${user}"] = [(200, realm)]
    }
  })
}

fn up_fed(f: PcFake, section: Str, mex: Str, soap: List[(Int, Str)], user: Str = "user@example.com") {
  up_start(f, section, user, UP_FEDERATED)
  pc_on(f, "GET adfs.example.test/adfs/services/trust/mex", [(200, mex)])
  pc_on(f, "POST adfs.example.test/adfs/services/trust/13/usernamemixed", soap)
}

fn up_tok(at: Str, scope: Str, tid: Str = "tenant-a") -> (Int, Str) {
  (200, pc_token(at, "rt-${at}", "${scope} openid profile offline_access", tid))
}

fn up_opts(allowed: List[Str] = []) -> UsernamePasswordCredentialOptions {
  // the default retries, as the Go program's
  let o = gv_opts(allowed: allowed, nodisc: true)
  UsernamePasswordCredentialOptions{opts: o with {client: o.client with {retry: policy.RetryOptions{}}}}
}

/// The test's capabilities, for the helpers.
struct UpEnv {
  net: Net
  clock: Clock
  rand: Rand
}

fn up_cred(e: UpEnv, user: Str, pw: Str, o: UsernamePasswordCredentialOptions = up_opts(), tenant: Str = "tenant-a") -> UsernamePasswordCredential ! azcore.AuthErr {
  new_username_password_credential(tenant, "client-1", user, pw, e.net, e.clock, e.rand, o)
}

fn up_get(f: PcFake, c: UsernamePasswordCredential, label: Str, o: azcore.TokenRequestOptions) {
  pc_show(f, label, c.get_token(o))
}

fn up_compare(f: PcFake, sections: List[Str]) {
  pc_compare(f, sections, GO_UP_LINES)
}

// The mex document, built from parts as the Go program builds it.

fn up_transport() -> Str {
  "<sp:TransportBinding xmlns:sp=\"${UP_SP}\"><wsp:Policy><sp:TransportToken><wsp:Policy><sp:HttpsToken/></wsp:Policy></sp:TransportToken><sp:AlgorithmSuite><wsp:Policy><sp:Basic256/></wsp:Policy></sp:AlgorithmSuite><sp:Layout><wsp:Policy><sp:Strict/></wsp:Policy></sp:Layout><sp:IncludeTimestamp/></wsp:Policy></sp:TransportBinding>"
}

fn up_pol_user(id: Str, wrapper: Str) -> Str {
  "<wsp:Policy wsu:Id=\"${id}\"><wsp:ExactlyOne><wsp:All>${up_transport()}<sp:${wrapper} xmlns:sp=\"${UP_SP}\"><wsp:Policy><sp:UsernameToken sp:IncludeToken=\"${UP_SP}/IncludeToken/AlwaysToRecipient\"><wsp:Policy><sp:WssUsernameToken10/></wsp:Policy></sp:UsernameToken></wsp:Policy></sp:${wrapper}><wsaw:UsingAddressing/></wsp:All></wsp:ExactlyOne></wsp:Policy>"
}

fn up_pol_win(id: Str) -> Str {
  "<wsp:Policy wsu:Id=\"${id}\"><wsp:ExactlyOne><wsp:All><http:NegotiateAuthentication xmlns:http=\"http://schemas.microsoft.com/ws/06/2004/policy/http\"/>${up_transport()}<wsaw:UsingAddressing/></wsp:All></wsp:ExactlyOne></wsp:Policy>"
}

fn up_binding(name: Str, policy_id: Str, transport: Str, action: Str) -> Str {
  "<wsdl:binding name=\"${name}\" type=\"tns:IWSTrust13Async\"><wsp:PolicyReference URI=\"#${policy_id}\"/><soap12:binding transport=\"${transport}\"/><wsdl:operation name=\"Trust13IssueAsync\"><soap12:operation soapAction=\"${action}\" style=\"document\"/><wsdl:input><soap12:body use=\"literal\"/></wsdl:input><wsdl:output><soap12:body use=\"literal\"/></wsdl:output></wsdl:operation></wsdl:binding>"
}

fn up_port(name: Str, bind: Str, addr: Str) -> Str {
  "<wsdl:port name=\"${name}\" binding=\"${bind}\"><soap12:address location=\"${addr}\"/><wsa10:EndpointReference><wsa10:Address>${addr}</wsa10:Address></wsa10:EndpointReference></wsdl:port>"
}

fn up_mex(policies: Str, bindings: Str, ports: Str) -> Str {
  "<?xml version=\"1.0\" encoding=\"utf-8\"?><wsdl:definitions name=\"SecurityTokenService\" targetNamespace=\"http://tempuri.org/\" xmlns:wsdl=\"http://schemas.xmlsoap.org/wsdl/\" xmlns:soap12=\"http://schemas.xmlsoap.org/wsdl/soap12/\" xmlns:wsu=\"http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd\" xmlns:wsp=\"http://schemas.xmlsoap.org/ws/2004/09/policy\" xmlns:wsaw=\"http://www.w3.org/2006/05/addressing/wsdl\" xmlns:wsa10=\"http://www.w3.org/2005/08/addressing\" xmlns:tns=\"http://tempuri.org/\">${policies}${bindings}<wsdl:service name=\"SecurityTokenService\">${ports}</wsdl:service></wsdl:definitions>"
}

fn up_std_mex() -> Str {
  up_mex(up_pol_user("UserNameWSTrustBinding_IWSTrust13Async_policy", "SignedEncryptedSupportingTokens"), up_binding("UserNameWSTrustBinding_IWSTrust13Async", "UserNameWSTrustBinding_IWSTrust13Async_policy", UP_SOAP, UP_T13), up_port("UserNameWSTrustBinding_IWSTrust13Async", "tns:UserNameWSTrustBinding_IWSTrust13Async", UP_13))
}

const UP_SAML1: Str = "<saml:Assertion MajorVersion=\"1\" MinorVersion=\"1\" AssertionID=\"_a1\" Issuer=\"http://adfs.example.test/adfs/services/trust\" IssueInstant=\"2026-11-08T00:00:00.000Z\" xmlns:saml=\"urn:oasis:names:tc:SAML:1.0:assertion\"><saml:Conditions NotBefore=\"2026-11-08T00:00:00.000Z\" NotOnOrAfter=\"2026-11-08T01:00:00.000Z\"/><saml:AttributeStatement><saml:Subject><saml:NameIdentifier>user</saml:NameIdentifier></saml:Subject></saml:AttributeStatement></saml:Assertion>"
const UP_SAML2: Str = "<saml:Assertion ID=\"_a2\" IssueInstant=\"2026-11-08T00:00:00.000Z\" Version=\"2.0\" xmlns:saml=\"urn:oasis:names:tc:SAML:2.0:assertion\"><saml:Issuer>http://adfs.example.test/adfs/services/trust</saml:Issuer></saml:Assertion>"
const UP_SAML2_DEFAULT: Str = "<Assertion ID=\"_a3\" IssueInstant=\"2026-11-08T00:00:00.000Z\" Version=\"2.0\" xmlns=\"urn:oasis:names:tc:SAML:2.0:assertion\"><Issuer>http://adfs.example.test/adfs/services/trust</Issuer></Assertion>"

/// The WS-Trust response with one token response per entry ("-": one
/// without a token).
fn up_rstr(tokens: List[Str]) -> Str {
  var b = "<s:Envelope xmlns:s=\"http://www.w3.org/2003/05/soap-envelope\" xmlns:a=\"http://www.w3.org/2005/08/addressing\" xmlns:u=\"http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd\"><s:Header><a:Action s:mustUnderstand=\"1\">http://docs.oasis-open.org/ws-sx/ws-trust/200512/RSTRC/IssueFinal</a:Action></s:Header><s:Body><trust:RequestSecurityTokenResponseCollection xmlns:trust=\"http://docs.oasis-open.org/ws-sx/ws-trust/200512\">"
  for t in tokens {
    b = b + "<trust:RequestSecurityTokenResponse><trust:Lifetime><wsu:Created xmlns:wsu=\"http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd\">2026-11-08T00:00:00.000Z</wsu:Created></trust:Lifetime>"
    if t != "-" {
      b = b + "<trust:RequestedSecurityToken>${t}</trust:RequestedSecurityToken>"
    }
    b = b + "<trust:TokenType>urn:oasis:names:tc:SAML:1.0:assertion</trust:TokenType></trust:RequestSecurityTokenResponse>"
  }
  b + "</trust:RequestSecurityTokenResponseCollection></s:Body></s:Envelope>"
}

/// A federated section: both SAML grants answered with a token.
fn up_fed_case(e: UpEnv, f: PcFake, section: Str, label: Str, mex: Str, soap: List[(Int, Str)] = []) -> () ! azcore.AuthErr {
  up_fed(f, section, mex, soap)
  pc_on(f, "POST login.example.test/tenant-a/oauth2/v2.0/token ${UP_V1}", [up_tok("at-${section}", PC_S1)])
  pc_on(f, "POST login.example.test/tenant-a/oauth2/v2.0/token ${UP_V2}", [up_tok("at-${section}", PC_S1)])
  up_get(f, up_cred(e, "user@example.com", "pw")?, label, tro([PC_S1]))
  Ok(())
}

test "UsernamePasswordCredential's managed flow is MSAL Go's" {
  let f = up_serve(os.net)
  let env = UpEnv{net: os.net, clock: os.clock, rand: os.rand}
  up_start(f, "mg1", realm: UP_MANAGED)
  pc_on(f, "POST login.example.test/tenant-a/oauth2/v2.0/token password", [up_tok("at-m1", PC_S1)])
  pc_on(f, "POST login.example.test/tenant-a/oauth2/v2.0/token refresh_token", [up_tok("at-m2", PC_S2)])
  let c = up_cred(env, "user@example.com", "p@ss w&rd")?
  up_get(f, c, "first", tro([PC_S1]))
  up_get(f, c, "cached", tro([PC_S1]))
  up_get(f, c, "other scope", tro([PC_S2]))
  up_get(f, c, "claims", tro([PC_S1], claims: "{\"access_token\":{\"nbf\":{\"essential\":true,\"value\":\"1700000000\"}}}"))
  match c.authenticate(tro([PC_S1])) {
    Ok(r) => pc_note(f, "mg1: authenticate: err=<nil> record=${r.encode()}")
    Err(e) => pc_note(f, "mg1: authenticate: err=${e.display()}")
  }

  up_start(f, "mg2", realm: UP_MANAGED)
  let c2 = up_cred(env, "user@example.com", "pw")?
  match c2.authenticate() {
    Ok(_) => pc_note(f, "mg2: authenticate no scope: err=<nil>")
    Err(e) => pc_note(f, "mg2: authenticate no scope: err=${e.display()}")
  }
  up_get(f, c2, "no scope", tro([]))
  up_get(f, c2, "other tenant", tro([PC_S1], tenant: "tenant-b"))

  up_start(f, "mg3", realm: UP_MANAGED)
  pc_on(f, "POST login.example.test/tenant-b/oauth2/v2.0/token password", [up_tok("at-m3", PC_S1, tid: "tenant-b")])
  up_get(f, up_cred(env, "user@example.com", "pw", up_opts(allowed: ["*"]))?, "allowed tenant", tro([PC_S1], tenant: "tenant-b"))
  up_compare(f, ["mg1", "mg2", "mg3"])
}

test "UsernamePasswordCredential's realm errors are MSAL Go's" {
  let f = up_serve(os.net)
  let env = UpEnv{net: os.net, clock: os.clock, rand: os.rand}
  up_start(f, "mg4", realm: UP_MANAGED)
  pc_on(f, "POST login.example.test/tenant-a/oauth2/v2.0/token password", [(400, "{\"error\":\"invalid_grant\",\"error_description\":\"AADSTS50126: Error validating credentials due to invalid username or password.\",\"error_codes\":[50126]}")])
  up_get(f, up_cred(env, "user@example.com", "wrong")?, "bad password", tro([PC_S1]))

  up_start(f, "mg5", realm: "{\"ver\":\"1.0\",\"account_type\":\"Managed\",\"cloud_instance_name\":\"example.test\",\"cloud_audience_urn\":\"urn:federation:Example\"}")
  up_get(f, up_cred(env, "user@example.com", "pw")?, "realm no domain", tro([PC_S1]))

  up_start(f, "mg6", realm: "{\"ver\":\"1.0\",\"account_type\":\"Unknown\",\"domain_name\":\"example.test\",\"cloud_instance_name\":\"example.test\",\"cloud_audience_urn\":\"urn:federation:Example\"}")
  up_get(f, up_cred(env, "user@example.com", "pw")?, "unknown realm", tro([PC_S1]))

  up_start(f, "mg7")
  pc_on(f, "${UP_REALM}user@example.com", [(500, "{\"error\":\"server_error\"}")])
  up_get(f, up_cred(env, "user@example.com", "pw")?, "realm 500", tro([PC_S1]))

  up_start(f, "mg8", realm: "{\"account_type\":")
  up_get(f, up_cred(env, "user@example.com", "pw")?, "realm bad json", tro([PC_S1]))

  up_start(f, "mg9", user: "first last+x@example.com", realm: UP_MANAGED)
  pc_on(f, "POST login.example.test/tenant-a/oauth2/v2.0/token password", [up_tok("at-m9", PC_S1)])
  up_get(f, up_cred(env, "first last+x@example.com", "pw")?, "escaped user", tro([PC_S1]))

  up_start(f, "mg10", realm: "{\"ver\":\"1.0\",\"domain_name\":\"example.test\",\"cloud_instance_name\":\"example.test\",\"cloud_audience_urn\":\"urn:federation:Example\"}")
  up_get(f, up_cred(env, "user@example.com", "pw")?, "realm no type", tro([PC_S1]))

  up_start(f, "mg11", realm: "{\"ver\":\"1.0\",\"account_type\":\"Federated\",\"domain_name\":\"example.test\",\"federation_protocol\":\"WSTrust\",\"cloud_instance_name\":\"example.test\",\"cloud_audience_urn\":\"urn:federation:Example\"}")
  up_get(f, up_cred(env, "user@example.com", "pw")?, "federated no mex url", tro([PC_S1]))
  up_compare(f, ["mg4", "mg5", "mg6", "mg7", "mg8", "mg9", "mg10", "mg11"])
}

const UP_REALM_BODIES: List[Str] = [
  "",
  "  ",
  "[1]",
  "\"x\"",
  "5",
  "null",
  "{",
  "{\"account_type\" 1}",
  "{\"account_type\":\"Managed\",}",
  "{\"account_type\":5,\"domain_name\":\"d\"}",
  "{\"account_type\":\"Managed\",\"domain_name\":\"d\",\"cloud_instance_name\":\"c\",\"cloud_audience_urn\":\"u\",\"extra\":{\"a\":[1,2]}} trailing",
  "{\"account_type\":\"Managed\",\"domain_name\":\"d\",\"cloud_instance_name\":\"c\",\"cloud_audience_urn\":\"u\"}{\"x\":1}",
  "{\"account_type\":null,\"domain_name\":\"d\"}",
  "{\"Account_Type\":\"Managed\",\"domain_name\":\"d\",\"cloud_instance_name\":\"c\",\"cloud_audience_urn\":\"u\"}",
]

test "UsernamePasswordCredential reads the realm's JSON as MSAL Go's decoder" {
  let f = up_serve(os.net)
  let env = UpEnv{net: os.net, clock: os.clock, rand: os.rand}
  var sections: List[Str] = []
  for (i, body) in UP_REALM_BODIES.indexed() {
    let s = "rj${i + 1}"
    sections.push(s)
    up_start(f, s)
    pc_on(f, "${UP_REALM}user@example.com", [(200, body)])
    pc_on(f, "POST login.example.test/tenant-a/oauth2/v2.0/token password", [up_tok("at-rj", PC_S1)])
    pc_note(f, "${s}: body ${json_q(body)}")
    up_get(f, up_cred(env, "user@example.com", "pw")?, "realm json", tro([PC_S1]))
  }
  up_compare(f, sections)
}

test "UsernamePasswordCredential's federated flow is MSAL Go's" {
  let f = up_serve(os.net)
  let env = UpEnv{net: os.net, clock: os.clock, rand: os.rand}
  let user = "first last+x@example.com"
  up_fed(f, "fd1", up_std_mex(), [(200, up_rstr([UP_SAML1]))], user: user)
  pc_on(f, "POST login.example.test/tenant-a/oauth2/v2.0/token ${UP_V1}", [up_tok("at-f1", PC_S1)])
  pc_on(f, "POST login.example.test/tenant-a/oauth2/v2.0/token refresh_token", [up_tok("at-f2", PC_S2)])
  let c = up_cred(env, user, "p&<>\"'\tx\ny")?
  up_get(f, c, "first", tro([PC_S1]))
  up_get(f, c, "cached", tro([PC_S1]))
  up_get(f, c, "other scope", tro([PC_S2]))

  up_fed_case(env, f, "fd2", "saml2", up_std_mex(), [(200, up_rstr([UP_SAML2]))])?
  up_fed_case(env, f, "fd3", "saml2 default ns", up_std_mex(), [(200, up_rstr([UP_SAML2_DEFAULT]))])?
  up_fed_case(env, f, "fd4", "no assertion", up_std_mex(), [(200, up_rstr(["-"]))])?
  up_fed_case(env, f, "fd5", "second response", up_std_mex(), [(200, up_rstr(["-", "\n  ${UP_SAML1}\n"]))])?
  up_fed_case(env, f, "fd6", "soap fault", up_std_mex(), [(500, "<s:Envelope xmlns:s=\"http://www.w3.org/2003/05/soap-envelope\"><s:Body><s:Fault><s:Code><s:Value>s:Sender</s:Value></s:Code><s:Reason><s:Text xml:lang=\"en-US\">ID3242: The security token could not be authenticated or authorized.</s:Text></s:Reason></s:Fault></s:Body></s:Envelope>")])?
  up_fed_case(env, f, "fd7", "soap bad xml", up_std_mex(), [(200, "<s:Envelope><s:Body>")])?
  up_compare(f, ["fd1", "fd2", "fd3", "fd4", "fd5", "fd6", "fd7"])
}

test "UsernamePasswordCredential reads the mex document as MSAL Go" {
  let f = up_serve(os.net)
  let env = UpEnv{net: os.net, clock: os.clock, rand: os.rand}
  up_start(f, "fd8", realm: UP_FEDERATED)
  pc_on(f, "GET adfs.example.test/adfs/services/trust/mex", [(503, "upstream down")])
  up_get(f, up_cred(env, "user@example.com", "pw")?, "mex 503", tro([PC_S1]))

  let p13 = up_pol_user("P13", "SignedEncryptedSupportingTokens")
  up_fed_case(env, f, "fd9", "mex bad xml", "<wsdl:definitions><wsdl:service>")?
  up_fed_case(env, f, "fd10", "mex no policies", up_mex("", up_binding("B13", "P13", UP_SOAP, UP_T13), up_port("B13", "tns:B13", UP_13)))?
  up_fed_case(env, f, "fd11", "mex 2005 only", up_mex(up_pol_user("P05", "SignedSupportingTokens"), up_binding("B05", "P05", UP_SOAP, UP_T2005), up_port("B05", "tns:B05", UP_2005)))?
  up_fed_case(env, f, "fd12", "mex windows only", up_mex(up_pol_win("PW"), up_binding("BW", "PW", UP_SOAP, UP_T13), up_port("BW", "tns:BW", UP_WIN)))?
  up_fed_case(env, f, "fd13", "mex unknown action", up_mex(p13, up_binding("B13", "P13", UP_SOAP, "http://example.test/other/Issue"), up_port("B13", "tns:B13", UP_13)))?
  up_fed_case(env, f, "fd14", "mex blank address", up_mex(p13, up_binding("B13", "P13", UP_SOAP, UP_T13), up_port("B13", "tns:B13", "  ")))?
  up_fed_case(env, f, "fd15", "mex 2005 then 13", up_mex(up_pol_user("P05", "SignedSupportingTokens") + p13 + up_pol_win("PW"), up_binding("B05", "P05", UP_SOAP, UP_T2005) + up_binding("B13", "P13", UP_SOAP, UP_T13) + up_binding("BW", "PW", UP_SOAP, UP_T13), up_port("B05", "tns:B05", UP_2005) + up_port("BW", "BW", UP_WIN) + up_port("B13", "B13", "  ${UP_13}\n")), [(200, up_rstr([UP_SAML1]))])?
  up_fed_case(env, f, "fd16", "mex non soap transport", up_mex(p13, up_binding("B13", "P13", "http://example.test/other", UP_T13), up_port("B13", "tns:B13", UP_13)))?
  up_fed_case(env, f, "fd17", "mex no transport binding attr", up_std_mex().replace("<sp:TransportBinding xmlns:sp=\"${UP_SP}\">", "<sp:TransportBinding>"))?
  up_compare(f, ["fd8", "fd9", "fd10", "fd11", "fd12", "fd13", "fd14", "fd15", "fd16", "fd17"])
}

test "UsernamePasswordCredential at an ADFS authority, and a failed SAML grant" {
  let f = up_serve(os.net)
  let env = UpEnv{net: os.net, clock: os.clock, rand: os.rand}
  up_start(f, "ad1")
  let adfs_openid = pc_openid("adfs").replace("/adfs/oauth2/v2.0/", "/adfs/oauth2/").replace("{tenantid}/v2.0", "adfs")
  pc_on(f, "GET login.example.test/adfs/.well-known/openid-configuration", [(200, adfs_openid)])
  pc_on(f, "POST login.example.test/adfs/oauth2/token password", [up_tok("at-ad1", PC_S1)])
  up_get(f, up_cred(env, "user@example.com", "pw", tenant: "adfs")?, "adfs", tro([PC_S1]))

  up_fed(f, "fd18", up_std_mex(), [(200, up_rstr([UP_SAML1]))])
  pc_on(f, "POST login.example.test/tenant-a/oauth2/v2.0/token ${UP_V1}", [(400, "{\"error\":\"invalid_grant\",\"error_description\":\"AADSTS50008: SAML token is invalid.\",\"error_codes\":[50008]}")])
  up_get(f, up_cred(env, "user@example.com", "pw")?, "saml grant error", tro([PC_S1]))
  up_compare(f, ["ad1", "fd18"])
}
