test "Go's Windows filepath Clean, Dir, Base, Ext" {
  for (p, clean, dir, base, ext) in WIN_PATHS {
    expect((p, win_clean(p), win_dir(p), win_base(p), win_ext(p))) == (p, clean, dir, base, ext)
  }
}

test "Go's Windows filepath Join" {
  for (es, j) in WIN_JOINS {
    expect((es, win_join(es))) == (es, j)
  }
}
