// How a program gives InteractiveBrowserCredential its browser: the
// credential never starts a process, so the caller passes an `open_url`
// that runs the system's opener. Type checked here; the test builds the
// credential and signs no one in.

use github.com/xo-lang/azure/azcore

/// The system's URL opener as an open_url: `open` on macOS, `xdg-open`
/// on Linux; on Windows, opener "rundll32" with first_args
/// ["url.dll,FileProtocolHandler"].
fn system_browser(proc: Proc, opener: Str, first_args: List[Str] = []) -> fn(Str) -> () ! Str uses proc {
  fn(u: Str) -> () ! Str uses proc {
    let out = proc.run(opener, first_args + [u]) ?? e => return Err(e.display())
    if out.code != 0 {
      return Err("${opener} exited with ${out.code}")
    }
    Ok(())
  }
}

test "a caller passes the system's opener as open_url" {
  // A program passes its own Proc, Net, Clock and Rand; the test's fakes
  // stand in, and nothing is opened.
  let c = new_interactive_browser_credential(system_browser(os.proc, "open"), os.net, os.clock, os.rand, InteractiveBrowserCredentialOptions{tenant_id: "tenant-a", client_id: "client-1"})?
  expect(c.record().home_account_id) == ""
  let _check: fn(azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, net.listen, clock, rand, proc) = fn(o: azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, net.listen, clock, rand, proc) { c.get_token(o) }
}
