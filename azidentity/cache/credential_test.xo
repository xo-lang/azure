// A credential with this cache, end to end over the test fakes: a
// second credential (another process) gets the token from the store
// without asking the token endpoint. Instance discovery is off: with no
// metadata for the host, MSAL Go matches no cached entry (azidentity's
// cache_run_test.xo does the same).

use std/http
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/azidentity
use github.com/xo-lang/azure/cloud
use github.com/xo-lang/azure/policy

const TENANT: Str = "00000000-0000-0000-0000-000000000000"
const CLIENT: Str = "00000000-0000-0000-0000-000000000000"
const AUTHORITY: Str = "https://login.example.test/"
const SCOPE: Str = "https://management.core.windows.net//.default"

fn serve(net: testing.FakeNet, calls: Atomic[Int]) {
  net.handle("GET https://login.microsoftonline.com/common/discovery/instance", fn(req: http.Request) -> http.Response {
    http.text(200, "{\"tenant_discovery_endpoint\":\"${AUTHORITY}${TENANT}/v2.0/.well-known/openid-configuration\",\"metadata\":[]}")
  })
  net.handle("GET ${AUTHORITY}${TENANT}/v2.0/.well-known/openid-configuration", fn(req: http.Request) -> http.Response {
    http.text(200, "{\"token_endpoint\":\"${AUTHORITY}${TENANT}/oauth2/v2.0/token\",\"authorization_endpoint\":\"${AUTHORITY}${TENANT}/oauth2/v2.0/authorize\",\"issuer\":\"${AUTHORITY}${TENANT}/v2.0\"}")
  })
  net.handle("POST ${AUTHORITY}${TENANT}/oauth2/v2.0/token", fn(req: http.Request) -> http.Response {
    calls.add(1)
    http.text(200, "{\"token_type\":\"Bearer\",\"expires_in\":3600,\"access_token\":\"tok-${calls.get()}\"}")
  })
}

test "a second credential reads the token the first one stored, for each store" {
  os.env.set("HOME", "/home/u")
  os.env.set("LOCALAPPDATA", "C:/Users/u/AppData/Local")
  let calls = Atomic[Int].new(0)
  serve(os.net, calls)
  for store in ["keyring", "keychain", "dpapi"] {
    let caps = Caps{fs: os.fs, env: os.env, secrets: os.secrets.only([store]), clock: os.clock, rand: os.rand}
    let name = "e2e-${store}"
    let mk = fn() -> azidentity.ClientSecretCredential[(fs, secrets, clock, rand)] ! Str uses (fs, env, secrets, clock, rand) {
      let opts = azidentity.Options{client: policy.ClientOptions{cloud: cloud.Configuration{authority_host: AUTHORITY}}, disable_instance_discovery: true, cache: Some(new(caps, Options{name: name})?)}
      azidentity.new_client_secret_credential(TENANT, CLIENT, "invented-secret", os.net, os.clock, os.rand, opts).map_err(fn(e: azcore.AuthErr) -> Str { e.display() })
    }
    let before = calls.get()
    let a = mk()?
    let t1 = a.get_token(azcore.TokenRequestOptions{scopes: [SCOPE]})?
    expect(calls.get()) == before + 1
    let b = mk()?
    let t2 = b.get_token(azcore.TokenRequestOptions{scopes: [SCOPE]})?
    expect(t2.token.reveal()) == t1.token.reveal()
    expect(calls.get()) == before + 1
  }
}
