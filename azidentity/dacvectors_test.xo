// Generated from the output of a local Go program that runs azidentity
// v1.15.0's DefaultAzureCredential against fake token and IMDS endpoints
// (no network); do not edit. Tokens are asked for only with
// AZURE_TOKEN_CREDENTIALS=prod; the other values are only constructed.
// Files the environment names are shown as /fed/token and /fed/missing.

/// One case: `env` (FED and MISSING stand for the token file and a
/// missing one); `probe` and `imds` answer IMDS (ERR, HANG or
/// `status|body`); `status` answers the token host's requests (0: 200);
/// `fed` is the token file's text; `scope` the token request's tenant.
struct DacCase {
  name: Str
  env: List[(Str, Str)]
  require: Bool
  tenant: Str
  allowed: List[Str]
  probe: Str
  imds: Str
  status: Int
  fed: Str
  scope: Str
}

