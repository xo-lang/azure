// The hand written part of azadmin/rbac, as Go's rbac/custom_client.go
// (azadmin v1.5.0; MIT, Copyright (c) Microsoft Corporation; NOTICE.md):
// the client and its options. The rest of the package is generated
// (client.xo, models.xo).

use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/policy
use github.com/xo-lang/azure/runtime
use github.com/xo-lang/azure/security/keyvault/internal

/// Options of new_client.
pub struct ClientOptions[fx: Effects] {
  pub client: policy.ClientOptions[fx] = policy.ClientOptions{}
  /// Accept a challenge resource that is not a parent of the vault's
  /// host. See https://aka.ms/azsdk/blog/vault-uri.
  pub disable_challenge_resource_verification: Bool = false
  /// Send tokens over plain HTTP too (tests against a local fake only).
  pub insecure_allow_http: Bool = false
}

struct Setup[fx: Effects] {
  pipeline: runtime.Pipeline[fx]
  endpoint: Str
}

/// Client: the role definitions and role assignments of a Managed HSM.
pub struct Client[fx: Effects] {
  setup: Setup[fx]
}

/// A client for the Managed HSM at `vault_url`
/// (`https://<name>.managedhsm.azure.net`), authorized by Key Vault's
/// challenge policy.
pub fn new_client[fx: Effects](net: Net, clock: Clock, rand: Rand, vault_url: Str, cred: azcore.TokenCredential[fx], opts: ClientOptions[fx] = ClientOptions{}) -> Client[fx] {
  let auth = internal.new_challenge_policy(cred, clock, internal.ChallengePolicyOptions{disable_challenge_resource_verification: opts.disable_challenge_resource_verification, insecure_allow_http: opts.insecure_allow_http})
  let pl = runtime.new_pipeline(MODULE, VERSION, net, clock, rand, runtime.PipelineOptions{per_retry: [auth]}, opts.client)
  Client{setup: Setup{pipeline: pl, endpoint: vault_url.trim_end_chars("/")}}
}
