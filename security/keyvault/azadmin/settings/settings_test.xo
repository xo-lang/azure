// The settings Client against the Go program's fake Managed HSM: each
// request and result must be Go's (govectors_test.xo).

use std/json

test "settings: get, list and update are Go's, challenge first" {
  let f = serve(os.net)
  let c = new_client(os.net, os.clock, os.rand, VAULT, Fixed{})
  add(f, "GET", "/settings", Reply{status: 200, body: "{\"settings\":[{\"name\":\"AllowKeyManagementOperationsThroughARM\",\"value\":\"false\",\"type\":\"boolean\"}]}"})
  show(f, "get_settings", c.get_settings().map(fn(r: GetSettingsResponse) -> ListResult { r.list_result }))
  add(f, "GET", "/settings/AllowKeyManagementOperationsThroughARM", Reply{status: 200, body: "{\"name\":\"AllowKeyManagementOperationsThroughARM\",\"value\":\"true\",\"type\":\"boolean\"}"})
  show(f, "get_setting", c.get_setting("AllowKeyManagementOperationsThroughARM").map(fn(r: GetSettingResponse) -> Setting { r.setting }))
  add(f, "PATCH", "/settings/AllowKeyManagementOperationsThroughARM", Reply{status: 200, body: "{\"name\":\"AllowKeyManagementOperationsThroughARM\",\"value\":\"true\",\"type\":\"boolean\"}"})
  show(f, "update_setting", c.update_setting("AllowKeyManagementOperationsThroughARM", UpdateSettingRequest{value: json.Patch.Value("true")}).map(fn(r: UpdateSettingResponse) -> Setting { r.setting }))
  show(f, "get_setting_empty", c.get_setting("").map(fn(r: GetSettingResponse) -> Setting { r.setting }))
  add(f, "GET", "/settings/missing", Reply{status: 404, headers: [("Content-Type", "application/json")], body: "{\"error\":{\"code\":\"SettingNotFound\",\"message\":\"no such setting\"}}"})
  show(f, "get_setting_404", c.get_setting("missing").map(fn(r: GetSettingResponse) -> Setting { r.setting }))
  check(f)
}
