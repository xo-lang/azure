  /// Application specific metadata in the form of key-value pairs.
  pub tags as "tags,omitempty": Map[Str, Str]? = None
  /// Elliptic curve name. For valid values, see JsonWebKeyCurveName.
  pub curve as "crv,omitempty": CurveName? = None
  /// The policy rules under which the key can be exported.
  pub release_policy as "release_policy,omitempty": KeyReleasePolicy? = None
} derive Json

/// A condition to be satisfied for an action to be executed.
pub struct LifetimeActionTrigger {
  /// Time after creation to attempt to rotate. It only applies to rotate. It will be in ISO 8601 duration format. Example: 90 days : "P90D"
  pub time_after_create as "timeAfterCreate,omitempty": Str? = None
  /// Time before expiry to attempt to rotate or notify. It will be in ISO 8601 duration format. Example: 90 days : "P90D"
  pub time_before_expiry as "timeBeforeExpiry,omitempty": Str? = None
} derive Json

/// The action that will be executed.
pub struct LifetimeActionType {
  /// The type of the action. The value should be compared case-insensitively.
  pub type_ as "type,omitempty": KeyRotationPolicyAction? = None
} derive Json

/// Action and its trigger that will be performed by Key Vault over the lifetime of a key.
pub struct LifetimeAction {
  /// The condition that will execute the action.
  pub trigger as "trigger,omitempty": LifetimeActionTrigger? = None
  /// The action that will be executed.
  pub action as "action,omitempty": LifetimeActionType? = None
} derive Json

/// The key rotation policy attributes.
pub struct KeyRotationPolicyAttributes {
  /// The expiryTime will be applied on the new key version. It should be at least 28 days. It will be in ISO 8601 Format. Examples: 90 days: P90D, 3 months: P3M, 48 hours: PT48H, 1 year and 10 days: P1Y10D
  pub expiry_time as "expiryTime,omitempty": Str? = None
  /// The key rotation policy created time in UTC.
  pub created as "created,omitempty": azcore.UnixTime? = None
  /// The key rotation policy's last updated time in UTC.
  pub updated as "updated,omitempty": azcore.UnixTime? = None
} derive Json

/// Management policy for a key.
pub struct KeyRotationPolicy {
  /// The key policy id.
  pub id as "id,omitempty": Str? = None
  /// Actions that will be performed by Key Vault over the lifetime of a key. For preview, lifetimeActions can only have two items at maximum: one for rotate, one for notify. Notification time would be default to 30 days before expiry and it is not configurable.
  pub lifetime_actions as "lifetimeActions,omitempty": List[LifetimeAction]? = None
  /// The key rotation policy attributes.
  pub attributes as "attributes,omitempty": KeyRotationPolicyAttributes? = None
} derive Json

/// The key restore parameters.
pub struct RestoreKeyParameters {
  /// The backup blob associated with a key bundle.
  pub key_backup as "value,omitempty": azcore.Base64URL? = None
} derive Json

/// The get random bytes request object.
pub struct GetRandomBytesParameters {
  /// The requested number of random bytes.
  pub count as "count,omitempty": Int? = None
} derive Json

/// The get random bytes response object containing the bytes.
pub struct RandomBytes {
  /// The bytes encoded as a base64url string.
  pub value as "value,omitempty": azcore.Base64URL? = None
} derive Json
