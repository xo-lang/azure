// The client against the Go program's fake vault: each request (with
// the challenge), decoded key bundle and page must be Go's
// (govectors_test.xo).

use std/json

const GV_KB: Str = "{\"key\":{\"kid\":\"https://kv1.vault.example.test/keys/k1/v1\",\"kty\":\"EC\",\"crv\":\"P-256\",\"key_ops\":[\"sign\",\"verify\"],\"x\":\"AQAB\",\"y\":\"AQAB\"},\"attributes\":{\"enabled\":true,\"nbf\":1767225600,\"exp\":1893456000,\"created\":1767225600,\"updated\":1767225601,\"recoveryLevel\":\"CustomizedRecoverable+Purgeable\",\"recoverableDays\":7,\"exportable\":false},\"tags\":{\"env\":\"a&b\"},\"managed\":true,\"release_policy\":{\"contentType\":\"application/json; charset=utf-8\",\"immutable\":true,\"data\":\"eyJ4IjoxfQ\"}}"

test "get_key and the key list pages match Go's" {
  let f = gv_serve(os.net)
  let c = new_client(os.net, os.clock, os.rand, GV_HOST, Fixed{})
  gv_add(f, "GET", "/keys/k1/v1", GvReply{status: 200, body: GV_KB})
  gv_show(f, "get_key", c.get_key("k1", "v1"), fn(r: GetKeyResponse) -> Str { gv_json(json.to_value(r.key_bundle)) })
  gv_add(f, "GET", "/keys", GvReply{status: 200, body: "{\"value\":[{\"kid\":\"https://kv1.vault.example.test/keys/k1\",\"attributes\":{\"enabled\":true,\"created\":1767225600},\"tags\":{\"a\":\"b\"}}],\"nextLink\":\"https://kv1.vault.example.test/keys?api-version=2025-07-01&\$skiptoken=eyJ4IjoxfQ&maxresults=1\"}"})
  gv_add(f, "GET", "/keys", GvReply{status: 200, body: "{\"value\":[],\"nextLink\":null}"})
  var pl = c.new_list_key_properties_pager()?
  while pl.more() {
    let pg = pl.next_page()
    gv_show(f, "list_page", pg, fn(r: ListKeyPropertiesResponse) -> Str { gv_json(json.to_value(r.key_properties_list_result)) })
    if pg.is_err() {
      break
    }
  }
  gv_check(f)
}
