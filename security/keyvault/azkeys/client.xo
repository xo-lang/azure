fn get_random_bytes_handle(resp: http.Response) -> GetRandomBytesResponse ! Str {
  let v = if resp.body.is_empty() { RandomBytes{} } else { json.decode[RandomBytes](resp.body) ?? e => return Err(e.display()) }
  Ok(GetRandomBytesResponse{random_bytes: v})
}

fn (c: Client) get_random_bytes_create_request(parameters: GetRandomBytesParameters, options: GetRandomBytesOptions) -> policy.Request ! azcore.CallErr {
  var path = "/rng"
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  headers.push(("Content-Type", "application/json"))
  let qs = q.encode()
  Ok(policy.Request{method: "POST", url: "${runtime.join_paths(c.setup.endpoint, path)}${if qs == "" { "" } else { "?${qs}" }}", headers: headers, body: runtime.marshal_json(parameters)})
}

/// Get the requested number of bytes containing random values from a managed HSM.
pub fn (c: Client) get_random_bytes(parameters: GetRandomBytesParameters, options: GetRandomBytesOptions = GetRandomBytesOptions{}) -> GetRandomBytesResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let req = c.get_random_bytes_create_request(parameters, options)?
  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if ![200].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  get_random_bytes_handle(resp) ?? e => Err(azcore.CallErr.Decode(e))
}
