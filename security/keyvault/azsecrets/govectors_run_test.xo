// The client against the Go program's fake vault: each request (with
// the challenge), decoded secret and version page must be Go's
// (govectors_test.xo).

use std/json

const GV_SB: Str = "{\"value\":\"v&1 <x>\",\"id\":\"https://kv1.vault.example.test/secrets/s1/v1\",\"contentType\":\"text/plain\",\"kid\":\"https://kv1.vault.example.test/keys/s1/v1\",\"managed\":false,\"attributes\":{\"enabled\":true,\"created\":1767225600,\"updated\":1767225600,\"recoveryLevel\":\"Recoverable\"},\"tags\":{\"env\":\"a&b\"},\"previousVersion\":\"v0\"}"

test "get_secret of the latest version and the version pages match Go's" {
  let f = gv_serve(os.net)
  let c = new_client(os.net, os.clock, os.rand, GV_HOST, fixed())
  gv_add(f, "GET", "/secrets/s1/", GvReply{status: 200, body: GV_SB})
  gv_show(f, "get_secret", c.get_secret("s1", ""), fn(r: GetSecretResponse) -> Str { gv_json(json.to_value(r.secret)) })
  gv_add(f, "GET", "/secrets/s1/versions", GvReply{status: 200, body: "{\"value\":[{\"id\":\"https://kv1.vault.example.test/secrets/s1/v1\",\"attributes\":{\"enabled\":false,\"exp\":1893456000},\"contentType\":\"text/plain\"}],\"nextLink\":\"https://kv1.vault.example.test/secrets/s1/versions?api-version=7.6&\$skiptoken=s%2B1\"}"})
  gv_add(f, "GET", "/secrets/s1/versions", GvReply{status: 200, body: "{\"value\":[]}"})
  var pl = c.new_list_secret_properties_versions_pager("s1")?
  while pl.more() {
    let pg = pl.next_page()
    gv_show(f, "list_versions_page", pg, fn(r: ListSecretPropertiesVersionsResponse) -> Str { gv_json(json.to_value(r.secret_properties_list_result)) })
    if pg.is_err() {
      break
    }
  }
  gv_check(f)
}
