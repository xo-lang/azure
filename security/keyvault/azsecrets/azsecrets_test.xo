// The generated azsecrets client against a fake vault that answers a
// request without a token with Key Vault's challenge (invented hosts).

use std/http
use std/json
use std/testing
use github.com/xo-lang/azure/azcore

const VAULT: Str = "https://kv1.vault.example.test"
const CHALLENGE: Str = "Bearer authorization=\"https://login.example.test/tenant-a\", resource=\"https://vault.example.test\""
const SECRET: Str = "{\"value\":\"s3cret\",\"id\":\"https://kv1.vault.example.test/secrets/db/v2\",\"attributes\":{\"enabled\":true,\"created\":1793847845,\"updated\":1793847845,\"recoveryLevel\":\"Recoverable+Purgeable\"},\"tags\":{\"env\":\"test\"}}"

struct Fixed {
  seen: Mutex[List[azcore.TokenRequestOptions]]
}

fn (c: Fixed) get_token(opts: azcore.TokenRequestOptions) -> azcore.AccessToken ! azcore.AuthErr uses (net.dial, clock, rand) {
  c.seen.with(fn(var xs: List[azcore.TokenRequestOptions]) { xs.push(opts) })
  Ok(azcore.AccessToken{token: Secret.new("tok-test"), expires_on: Time.from_unix_millis(4102444800000)})
}

fn fixed() -> Fixed {
  Fixed{seen: Mutex.new([])}
}

/// A vault route: 401 with the challenge without a token, else `status`
/// and `body`. It records the authorized requests.
fn route(net: testing.FakeNet, pattern: Str, status: Int, body: Str) -> Mutex[List[http.Request]] {
  let seen = Mutex[List[http.Request]].new([])
  net.handle(pattern, fn(req: http.Request) -> http.Response {
    if req.header("Authorization").is_none() {
      return http.text(401, "").with_header("WWW-Authenticate", CHALLENGE)
    }
    seen.with(fn(var xs: List[http.Request]) { xs.push(req) })
    http.text(status, body)
  })
  seen
}

fn first(seen: Mutex[List[http.Request]]) -> http.Request {
  seen.with_read(fn(xs: List[http.Request]) -> http.Request { xs[0] })
}

test "set_secret answers the challenge, sends the body with api-version 7.6, and decodes the secret" {
  let seen = route(os.net, "PUT ${VAULT}/secrets/db", 200, SECRET)
  let cred = fixed()
  let c = new_client(os.net, os.clock, os.rand, VAULT, cred)
  let r = c.set_secret("db", SetSecretParameters{value: Some("s3cret"), tags: Some({"env": "test"})})?
  expect(r.secret.value) == Some("s3cret")
  let id = r.secret.id ?? ID("")
  expect(id.name()) == "db"
  expect(id.version()) == "v2"
  let at = r.secret.attributes ?? SecretAttributes{}
  expect(at.created.map(fn(t: azcore.UnixTime) -> Int { t.0.unix() })) == Some(1793847845)
  expect(at.recovery_level) == Some("Recoverable+Purgeable")
  let req = first(seen)
  expect(req.url.query.get("api-version")) == Some("7.6")
  expect(req.header("Authorization")) == Some("Bearer tok-test")
  expect(json.parse_value(req.body.to_str_lossy())?.get("value")) == Some(json.Value.Str("s3cret"))
  let tro = cred.seen.with_read(fn(xs: List[azcore.TokenRequestOptions]) -> azcore.TokenRequestOptions { xs[0] })
  expect(tro.scopes) == ["https://vault.example.test/.default"]
  expect(tro.tenant_id) == "tenant-a"
}

test "get_secret with an empty version asks for the latest" {
  route(os.net, "GET ${VAULT}/secrets/db/", 200, SECRET)
  let c = new_client(os.net, os.clock, os.rand, VAULT, fixed())
  expect(c.get_secret("db", "")?.secret.value) == Some("s3cret")
  match c.get_secret("", "") {
    Err(azcore.CallErr.InvalidInput(m)) => expect(m) == "parameter name cannot be empty"
    other => expect("${other:?}") == "InvalidInput"
  }
}

test "a missing secret is a response error with Key Vault's code" {
  route(os.net, "GET ${VAULT}/secrets/gone/", 404, "{\"error\":{\"code\":\"SecretNotFound\",\"message\":\"A secret with (name/id) gone was not found in this key vault.\"}}")
  let c = new_client(os.net, os.clock, os.rand, VAULT, fixed())
  match c.get_secret("gone", "") {
    Err(azcore.CallErr.Response(e)) => {
      expect(e.status_code) == 404
      expect(e.error_code) == "SecretNotFound"
    }
    other => expect("${other:?}") == "a SecretNotFound response error"
  }
}

test "the secret properties pager follows nextLink" {
  route(os.net, "GET ${VAULT}/secrets", 200, "{\"value\":[{\"id\":\"${VAULT}/secrets/a\"},{\"id\":\"${VAULT}/secrets/b\"}],\"nextLink\":\"${VAULT}/secretspage2\"}")
  route(os.net, "GET ${VAULT}/secretspage2", 200, "{\"value\":[{\"id\":\"${VAULT}/secrets/c\"}],\"nextLink\":null}")
  let c = new_client(os.net, os.clock, os.rand, VAULT, fixed())
  var p = c.new_list_secret_properties_pager()?
  var names: List[Str] = []
  while p.more() {
    for s in p.next_page()?.secret_properties_list_result.value ?? [] {
      names.push((s.id ?? ID("")).name())
    }
  }
  expect(names) == ["a", "b", "c"]
}

test "backup and restore carry the blob as base64url" {
  route(os.net, "POST ${VAULT}/secrets/db/backup", 200, "{\"value\":\"-_8\"}")
  let restored = route(os.net, "POST ${VAULT}/secrets/restore", 200, SECRET)
  let c = new_client(os.net, os.clock, os.rand, VAULT, fixed())
  let blob = c.backup_secret("db")?.backup_secret_result.value ?? azcore.Base64URL(b"")
  expect(blob.0) == b"\xfb\xff"
  c.restore_secret(RestoreSecretParameters{secret_backup: Some(blob)})?
  expect(first(restored).body) == b"{\"value\":\"-_8\"}"
}
