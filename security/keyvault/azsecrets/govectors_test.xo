  "  B ",
  "OUT list_versions_page: {\"nextLink\":\"https://kv1.vault.example.test/secrets/s1/versions?api-version=7.6\\u0026\$skiptoken=s%2B1\",\"value\":[{\"attributes\":{\"enabled\":false,\"exp\":1893456000},\"contentType\":\"text/plain\",\"id\":\"https://kv1.vault.example.test/secrets/s1/v1\"}]}",
