  "OUT get_secret: {\"attributes\":{\"created\":1767225600,\"enabled\":true,\"recoveryLevel\":\"Recoverable\",\"updated\":1767225600},\"contentType\":\"text/plain\",\"id\":\"https://kv1.vault.example.test/secrets/s1/v1\",\"kid\":\"https://kv1.vault.example.test/keys/s1/v1\",\"managed\":false,\"tags\":{\"env\":\"a\\u0026b\"},\"value\":\"v\\u00261 \\u003cx\\u003e\"}",
