// The client against the Go program's fake vault: each request (with
// the challenge), decoded certificate and its policy, and page must be
// Go's (govectors_test.xo).

use std/json

const GV_CB: Str = "{\"id\":\"https://kv1.vault.example.test/certificates/c1/v1\",\"kid\":\"https://kv1.vault.example.test/keys/c1/v1\",\"sid\":\"https://kv1.vault.example.test/secrets/c1/v1\",\"x5t\":\"AQAB\",\"cer\":\"AQAB\",\"attributes\":{\"enabled\":true,\"nbf\":1767225600,\"exp\":1893456000,\"created\":1767225600,\"updated\":1767225600,\"recoveryLevel\":\"Recoverable+Purgeable\",\"recoverableDays\":90},\"policy\":{\"id\":\"https://kv1.vault.example.test/certificates/c1/policy\",\"key_props\":{\"exportable\":true,\"kty\":\"RSA\",\"key_size\":2048,\"reuse_key\":false},\"secret_props\":{\"contentType\":\"application/x-pkcs12\"},\"x509_props\":{\"subject\":\"CN=a&b\",\"sans\":{\"dns_names\":[\"a.example.test\"]},\"ekus\":[\"1.3.6.1.5.5.7.3.1\"],\"key_usage\":[\"digitalSignature\",\"keyEncipherment\"],\"validity_months\":12},\"lifetime_actions\":[{\"trigger\":{\"lifetime_percentage\":80},\"action\":{\"action_type\":\"AutoRenew\"}}],\"issuer\":{\"name\":\"Self\"},\"attributes\":{\"enabled\":true,\"created\":1767225600}},\"tags\":{\"env\":\"a&b\"}}"

test "get_certificate and the certificate list pages match Go's" {
  let f = gv_serve(os.net)
  let c = new_client(os.net, os.clock, os.rand, GV_HOST, Fixed{})
  gv_add(f, "GET", "/certificates/c1/v1", GvReply{status: 200, body: GV_CB})
  gv_show(f, "get_certificate", c.get_certificate("c1", "v1"), fn(r: GetCertificateResponse) -> Str { gv_json(json.to_value(r.certificate)) })
  gv_add(f, "GET", "/certificates", GvReply{status: 200, body: "{\"value\":[{\"id\":\"https://kv1.vault.example.test/certificates/c1\",\"x5t\":\"AQAB\",\"attributes\":{\"enabled\":true},\"tags\":{\"a\":\"b\"}}],\"nextLink\":\"https://kv1.vault.example.test/certificates?api-version=2025-07-01&\$skiptoken=c1&includePending=true\"}"})
  gv_add(f, "GET", "/certificates", GvReply{status: 200, body: "{\"value\":[]}"})
  var pl = c.new_list_certificate_properties_pager(ListCertificatePropertiesOptions{include_pending: Some(true)})?
  while pl.more() {
    let pg = pl.next_page()
    gv_show(f, "list_page", pg, fn(r: ListCertificatePropertiesResponse) -> Str { gv_json(json.to_value(r.certificate_properties_list_result)) })
    if pg.is_err() {
      break
    }
  }
  gv_check(f)
}
