// The Go vector writer, run from the repository root:
//   xo run ./codegen/cmd/vectors -- <go out> <Go responses file> <module dir> <out> <module name> <azcore version>
// reads the output of the Go program codegen/govec writes for an ARM
// module (CALL lines: each method's arguments as JSON, its requests,
// the responses served and its result), Go's response structs (their
// field order) and the module's generated .xo, and writes a test per
// call that makes the same call here and compares the same lines.

use std/json
use github.com/xo-lang/azure/codegen/gen

struct Method {
  pub params: List[(Str, Str)]
  pub ret: Str
}

struct Call {
  pub name: Str
  pub spec: List[json.Value]
  pub lines: List[Str]
  pub served: List[(Int, Str)]
}

/// An Xo string literal of `s`.
fn lit(s: Str) -> Str {
  var o = "\""
  for ch in s.runes() {
    let c = Int(ch)
    if ch == '"' {
      o = o + "\\\""
    } else if ch == '\\' {
      o = o + "\\\\"
    } else if ch == '$' {
      o = o + "\\$"
    } else if c < 0x20 || c == 0x7f {
      o = o + "\\u{${hex4(c)}}"
    } else {
      o = o + "${ch}"
    }
  }
  o + "\""
}

fn hex4(c: Int) -> Str {
  let d = "0123456789abcdef"
  var s = ""
  var n = c
  for _ in 0..4 {
    s = d[n % 16..n % 16 + 1] + s
    n = n / 16
  }
  s
}

fn norm(n: Str) -> Str {
  n.replace("_", "").to_lower()
}

fn is_upper(c: Str) -> Bool {
  c >= "A" && c <= "Z"
}

fn is_lower_digit(c: Str) -> Bool {
  c >= "a" && c <= "z" || c >= "0" && c <= "9"
}

/// Go's name in snake case (`ListByID` is `list_by_id`).
fn snake(n: Str) -> Str {
  let cs = n.runes().map(fn(c: Rune) -> Str { "${c}" })
  var o = ""
  for i in 0..cs.len() {
    if i > 0 {
      let prev = cs[i - 1]
      let cur = cs[i]
      let next = if i + 1 < cs.len() { cs[i + 1] } else { "" }
      if is_lower_digit(prev) && is_upper(cur) || is_upper(prev) && is_upper(cur) && next >= "a" && next <= "z" {
        o = o + "_"
      }
    }
    o = o + cs[i]
  }
  o.to_lower()
}

fn is_word(s: Str) -> Bool {
  s != "" && s.runes().all(fn(c: Rune) -> Bool {
    let t = "${c}"
    is_lower_digit(t) || is_upper(t) || t == "_"
  })
}

/// The generated structs: name to fields (name, type).
fn structs_of(xo: Str) -> Map[Str, List[(Str, Str)]] {
  var out: Map[Str, List[(Str, Str)]] = {}
  var cur: Str? = None
  var fields: List[(Str, Str)] = []
  for line in xo.split("\n") {
    match cur {
      None => {
        if line.starts_with("pub struct ") && line.ends_with(" {}") {
          out[line[11..line.len() - 3]] = []
        } else if line.starts_with("pub struct ") && line.ends_with(" {") {
          cur = Some(line[11..line.len() - 2])
          fields = []
        }
      }
      Some(n) => {
        if line.starts_with("}") {
          out[n] = fields
          cur = None
        } else if line.starts_with("  pub ") {
          let rest = line[6..line.len()]
          if let Some((name, t0)) = rest.cut(": ") {
            let t = (t0.cut(" = ") ?? (t0, "")).0
            if is_word(name) && !t.contains("=") && t != "" {
              fields.push((name, t))
            }
          }
        }
      }
    }
  }
  out
}

/// A parameter list split at its top-level ", " (a `Map[Str, Str]`
/// parameter's comma stays in its type).
fn split_params(ps: Str) -> List[Str] {
  var out: List[Str] = []
  var depth = 0
  var start = 0
  let b = ps.bytes()
  var i = 0
  while i < b.len() {
    let ch = b[i]
    if ch == 91 || ch == 40 {
      depth += 1
    } else if ch == 93 || ch == 41 {
      depth -= 1
    } else if ch == 44 && depth == 0 && i + 1 < b.len() && b[i + 1] == 32 {
      out.push(ps[start..i])
      start = i + 2
      i += 1
    }
    i += 1
  }
  out.push(ps[start..ps.len()])
  out
}

/// The generated client methods: (client, method) to its parameters and
/// return type.
fn methods_of(xo: Str) -> Map[Str, Method] {
  var out: Map[Str, Method] = {}
  for line in xo.split("\n") {
    if !line.starts_with("pub fn (c: ") {
      continue
    }
    let rest = line[11..line.len()]
    let (recv, after) = rest.cut(") ") ?? continue
    let cl = if recv.ends_with("[fx]") { recv[0..recv.len() - 4] } else { recv }
    let (name, ps0) = after.cut("(") ?? continue
    let (ps, ret0) = ps0.cut(") -> ") ?? continue
    let i1 = ret0.find(" !") ?? ret0.len()
    let i2 = ret0.find(" {") ?? ret0.len()
    let ret = ret0[0..if i1 < i2 { i1 } else { i2 }]
    var params: List[(Str, Str)] = []
    for p in split_params(ps) {
      if p == "" {
        continue
      }
      let (n, t) = p.cut(": ") ?? continue
      params.push((n, (t.cut(" = ") ?? (t, "")).0))
    }
    out["${cl}.${name}"] = Method{params: params, ret: ret}
  }
  out
}

/// Go's response structs: name to fields (name, embedded).
fn go_responses(src: Str) -> Map[Str, List[(Str, Bool)]] {
  var out: Map[Str, List[(Str, Bool)]] = {}
  var cur: Str? = None
  var fields: List[(Str, Bool)] = []
  for line in src.split("\n") {
    match cur {
      None => {
        if line.starts_with("type ") && line.ends_with("Response struct {") {
          let n = line[5..line.len() - 9]
          if is_word(n) {
            cur = Some(n)
            fields = []
          }
        }
      }
      Some(n) => {
        if line == "}" {
          out[n] = fields
          cur = None
        } else {
          let l = line.trim()
          if l != "" && !l.starts_with("//") {
            let parts = l.split(" ").filter(fn(s: Str) -> Bool { s != "" })
            fields.push((parts[0], parts.len() == 1))
          }
        }
      }
    }
  }
  out
}

/// Python's json.dumps(v, separators=(',', ':'), ensure_ascii=False).
fn dumps(v: json.Value) -> Str {
  match v {
    json.Value.Null => "null"
    json.Value.Bool(b) => if b { "true" } else { "false" }
    json.Value.Int(n) => "${n}"
    json.Value.Num(n) => "${n}"
    json.Value.Str(s) => py_str(s)
    json.Value.List(items) => "[" + items.map(fn(i: json.Value) -> Str { dumps(i) }).join(",") + "]"
    json.Value.Object(fields) => "{" + fields.map(fn(f: (Str, json.Value)) -> Str { py_str(f.0) + ":" + dumps(f.1) }).join(",") + "}"
    _ => v.encode()
  }
}

fn py_str(s: Str) -> Str {
  var o = "\""
  for ch in s.runes() {
    let c = Int(ch)
    if ch == '"' {
      o = o + "\\\""
    } else if ch == '\\' {
      o = o + "\\\\"
    } else if c == 0x0a {
      o = o + "\\n"
    } else if c == 0x0d {
      o = o + "\\r"
    } else if c == 0x09 {
      o = o + "\\t"
    } else if c == 0x08 {
      o = o + "\\b"
    } else if c == 0x0c {
      o = o + "\\f"
    } else if c < 0x20 {
      o = o + "\\u${hex4(c)}"
    } else {
      o = o + "${ch}"
    }
  }
  o + "\""
}

fn str_val(v: json.Value) -> Str {
  match v {
    json.Value.Str(s) => s
    _ => dumps(v)
  }
}

/// An Xo expression of type `t` holding Go's argument `v`.
fn value(t0: Str, v: json.Value, enums: List[Str]) -> Str {
  let t = t0.trim()
  let opt = t.ends_with("?")
  let base = if opt { t[0..t.len() - 1] } else { t }
  let x = if base == "Str" {
    lit(str_val(v))
  } else if base == "Int" || base == "Float" {
    dumps(v)
  } else if base == "Float32" {
    "Float32(${dumps(v)})"
  } else if base == "Bool" {
    if v == json.Value.Bool(true) { "true" } else { "false" }
  } else if base == "Time" {
    "gv_at3339(${lit(str_val(v))})"
  } else if base == "azcore.DateTime" {
    "(azcore.parse_date_time(${lit(str_val(v))}) ?? e => fault(e))"
  } else if base == "List[Str]" {
    match v {
      json.Value.List(items) => "[" + items.map(fn(i: json.Value) -> Str { lit(str_val(i)) }).join(", ") + "]"
      _ => "[]"
    }
  } else if base == "Bytes" {
    "${lit(str_val(v))}.bytes()"
  } else if enums.contains(base) {
    "${base}(${lit(str_val(v))})"
  } else {
    "(json.decode_str[${base}](${lit(dumps(v))}) ?? e => fault(\"\${e}\"))"
  }
  if opt { "Some(${x})" } else { x }
}

fn show_fn(rname: Str, structs: Map[Str, List[(Str, Str)]], goresp: Map[Str, List[(Str, Bool)]]) -> Str {
  let fs = structs.get(rname) ?? []
  let gofs = goresp.get(rname) ?? []
  let body = fs.filter(fn(f: (Str, Str)) -> Bool { !f.1.trim().ends_with("?") })
  var heads: Map[Str, (Str, Str)] = {}
  for f in fs {
    if f.1.trim().ends_with("?") {
      heads[norm(f.0)] = (f.0, f.1.trim())
    }
  }
  var lines = ["fn show_${snake(rname)}(r: ${rname}) -> Str {", "  var parts: List[Str] = []"]
  for (gname, anon) in gofs {
    if anon {
      lines.push("  parts.push(\"body=\${runtime.marshal_json(r.${body[0].0}).to_str_lossy()}\")")
      continue
    }
    if gname == "Body" {
      lines.push("  parts.push(\"Body=\${gv_go_q(r.body)}\")")
      continue
    }
    if gname == "Success" {
      lines.push("  parts.push(\"Success=\${r.success}\")")
      continue
    }
    match heads.get(norm(gname)) {
      None => {
        if body.is_empty() || !(gname == "Value" || gname == "Interface" || gname.ends_with("Array")) {
          lines.push("  // Go's ${gname} has no field here")
        } else {
          // Go's body that is not a model (Value, <Model>Array,
          // Interface): JSON, and nothing when empty (Go's nil)
          let bname = body[0].0
          let bt = body[0].1.trim()
          let empty = if bt == "json.Value" { "r.${bname} == json.Value.Null" } else if bt == "Str" || bt.starts_with("List[") || bt.starts_with("Map[") { "r.${bname}.is_empty()" } else { "false" }
          lines.push("  if !(${empty}) {\n    parts.push(\"${gname}=\${runtime.marshal_json(r.${bname}).to_str_lossy()}\")\n  }")
        }
      }
      Some((fname, t)) => {
        let conv = match t {
          "Str?" => "v"
          "Int?" => "\"\${v}\""
          "Bool?" => "\"\${v}\""
          "Time?" => "gv_t3339(v)"
          _ => fault("header type ${t}")
        }
        if conv == "v" {
          lines.push("  if let Some(v) = r.${fname} {\n    parts.push(\"${gname}=\${v}\")\n  }")
        } else {
          lines.push("  if let Some(v) = r.${fname} {\n    parts.push(\"${gname}=\${${conv}}\")\n  }")
        }
      }
    }
  }
  lines.push("  parts.join(\" \")")
  lines.push("}")
  lines.join("\n")
}

fn parse_calls(text: Str) -> List[Call] ! Str {
  var calls: List[Call] = []
  var lines = text.split("\n")
  while lines.len() > 0 && lines[lines.len() - 1] == "" {
    lines = lines[0..lines.len() - 1]
  }
  for line in lines {
    if line.starts_with("CALL ") {
      let (name, spec) = line[5..line.len()].cut(" ") ?? return Err("bad CALL line: ${line}")
      let args = match json.parse_value(spec) {
        Ok(json.Value.List(items)) => items
        Ok(_) => return Err("CALL args not a list: ${line}")
        Err(e) => return Err("CALL args: ${e.display()}")
      }
      calls.push(Call{name: name, spec: args, lines: ["CALL ${name}"], served: []})
      continue
    }
    let k = calls.len() - 1
    if k < 0 {
      continue
    }
    var c = calls[k]
    c.lines.push(line)
    let n = c.served.len()
    if n > 0 && !line.starts_with("REQ ") && !line.starts_with("  ") && !line.starts_with("OUT") && c.lines[c.lines.len() - 2].starts_with("  SERVED ") {
      let (st, body) = c.served[n - 1]
      c.served[n - 1] = (st, body + "\n" + line)
    }
    if line.starts_with("  SERVED ") {
      let rest = line[9..line.len()]
      let (st, body) = rest.cut(" ") ?? (rest, "")
      c.served.push((Int.parse(st) ?? 200, body))
    }
    calls[k] = c
  }
  Ok(calls)
}

/// The Go program's options argument: `{"options": {...}}` alone (a body
/// may have an `options` field too: armresources' ExportTemplateRequest).
fn is_options(v: json.Value) -> Bool {
  match v {
    json.Value.Object(fields) => fields.len() == 1 && fields[0].0 == "options" && match fields[0].1 {
      json.Value.Object(_) => true
      _ => false
    }
    _ => false
  }
}

fn kind_name(v: json.Value) -> Str {
  if is_options(v) {
    return "options"
  }
  match v {
    json.Value.Str(_) => "str"
    json.Value.Int(_) => "int"
    json.Value.Num(_) => "float"
    json.Value.Bool(_) => "bool"
    json.Value.List(_) => "list"
    json.Value.Object(_) => "dict"
    _ => "NoneType"
  }
}

fn main(os: Os) -> () ! Error {
  let args = os.env.args()
  if args.len() != 6 {
    os.stdio.println("usage: vectors <go out> <Go responses file> <module dir> <out> <module name> <azcore version>")
    return Ok(())
  }
  let (goout, gosrc, mdir, out_path, modname, azcore) = (args[0], args[1], args[2], args[3], args[4], args[5])
  var names: List[Str] = []
  for f in os.fs.walk(mdir)? {
    if !f.is_dir && f.name.ends_with(".xo") && !f.name.ends_with("_test.xo") && f.path[0..f.path.len() - f.name.len() - 1] == mdir {
      names.push(f.path)
    }
  }
  names = names.sort()
  var texts: List[Str] = []
  for p in names {
    texts.push(os.fs.read_text(p)?)
  }
  let xo = texts.join("\n")
  let structs = structs_of(xo)
  let methods = methods_of(xo)
  let goresp = go_responses(os.fs.read_text(gosrc)?)
  var subs: List[Str] = []
  var enums: List[Str] = []
  for line in xo.split("\n") {
    // a client parameter (subscription_id, or a @@clientInitialization
    // one: armalertsmanagement's scope), Go's program's "sub-test"
    let (_, after_rand) = line.cut("[fx: Effects](net: Net, clock: Clock, rand: Rand, ") ?? ("", "")
    if line.starts_with("pub fn new_") && !after_rand.starts_with("cred:") && (after_rand.cut(", ") ?? ("", "")).0.ends_with(": Str") {
      subs.push((line[7..line.len()].cut("[") ?? ("", "")).0)
    }
    if line.starts_with("pub type ") && line.ends_with(" struct(Str)") {
      enums.push(line[9..line.len() - 12])
    }
  }
  let calls = parse_calls(os.fs.read_text(goout)?)?
  var out = ["// Generated from the output of a local Go program that calls every\n// public method of each client of ${modname} (azcore ${azcore}) by reflection,\n// every argument and option filled, against a fake transport answering\n// each operation's success status; do not edit (codegen/cmd/vectors). Each test\n// makes the same call here and compares every request, the response\n// served and the result.\n\nuse std/json\nuse github.com/xo-lang/azure/azcore\nuse github.com/xo-lang/azure/runtime\n"]
  var shown: List[Str] = []
  for i in 0..calls.len() {
    let c = calls[i]
    let (cl, meth) = c.name.cut(".") ?? continue
    let pager = meth.starts_with("New") && meth.ends_with("Pager")
    let xname = gen.snake(meth)
    let m = methods.get("${cl}.${xname}") ?? {
      out.push("// ${c.name}: no method ${xname}")
      continue
    }
    var shape_ok = m.params.len() == c.spec.len()
    if shape_ok {
      for j in 0..m.params.len() {
        // Go's options struct is the method's `options` parameter (a
        // model may be named ...Options too)
        if is_options(c.spec[j]) != (m.params[j].0 == "options") {
          shape_ok = false
        }
      }
    }
    if !shape_ok {
      let gk = "[" + c.spec.map(fn(v: json.Value) -> Str { "'${kind_name(v)}'" }).join(", ") + "]"
      let ok = "[" + m.params.map(fn(p: (Str, Str)) -> Str { "'${p.1}'" }).join(", ") + "]"
      out.push("test \"Go's ${c.name}\" {\n  expect(${lit("parameters differ: Go ${gk}, ours ${ok}")}) == \"\"\n}")
      continue
    }
    var call_args: List[Str] = []
    for j in 0..m.params.len() {
      let (_, pt) = m.params[j]
      let v = c.spec[j]
      if is_options(v) {
        let o = v.get("options") ?? json.Value.Object([])
        var sf: Map[Str, (Str, Str)] = {}
        for f in structs.get(pt) ?? [] {
          sf[norm(f.0)] = f
        }
        var fields: List[Str] = []
        match o {
          json.Value.Object(kvs) => {
            for (k, val) in kvs {
              match sf.get(norm(k)) {
                None => fields.push("/* Go option ${k} has no field */")
                Some(f) => fields.push("${f.0}: ${value(f.1, val, enums)}")
              }
            }
          }
          _ => {}
        }
        call_args.push("${pt}{${fields.join(", ")}}")
      } else {
        call_args.push(value(pt, v, enums))
      }
    }
    let rname = response_name(m.ret) ?? {
      out.push("// ${c.name}: no response type in ${m.ret}")
      continue
    }
    if !shown.contains(rname) {
      out.push(show_fn(rname, structs, goresp))
      shown.push(rname)
    }
    let (st, body) = c.served.get(0) ?? (200, "")
    out.push("const GO_${i}: List[Str] = [\n" + c.lines.map(fn(l: Str) -> Str { "  ${lit(l)}," }).join("\n") + "\n]")
    let sub = if subs.contains("new_${gen.snake(cl)}") { "\"sub-test\", " } else { "" }
    var t = ["test \"Go's ${c.name}\" {", "  let f = gv_new_fake(os.net)", "  let c = new_${gen.snake(cl)}(os.net, os.clock, os.rand, ${sub}GvCred{}, gv_opts()) ?? e => fault(e)", "  gv_set(f, ${st}, ${lit(body)})", "  gv_note(f, \"CALL ${c.name}\")"]
    let call = "c.${xname}(${call_args.join(", ")})"
    let sn = snake(rname)
    if meth.starts_with("Begin") && m.ret.contains("Pager[") {
      let cut = index_of_panic(c.lines)
      t = t + ["  match ${call} {", "    Ok(p0) => {", "      var p = p0", "      gv_quiet(f, true)", "      let done = p.poll_until_done(os.clock, frequency: 1s)", "      gv_quiet(f, false)", "      match done {", "        Ok(pg0) => {", "          var pg = pg0", "          for page in [1, 2] {", "            if !pg.more() {", "              gv_note(f, \"OUT page \${page}: no more\")", "              break", "            }", "            match pg.next_page() {", "              Ok(r) => gv_note(f, \"OUT page \${page}: \${show_${sn}(r)}\")", "              Err(e) => {", "                gv_note_lines(f, \"OUT page \${page}: error: \${gv_err_text(e)}\")", "                break", "              }", "            }", "          }", "        }", "        Err(e) => gv_note_lines(f, \"OUT: error: \${gv_err_text(e)}\")", "      }", "    }", "    Err(e) => gv_note_lines(f, \"OUT: error: \${gv_err_text(e)}\")", "  }"]
      if cut < c.lines.len() {
        t = t + ["  // Go panics at line ${cut} (its pager has no handler); ours reads page one", "  let got = gv_log_of(f)", "  gv_compare(got[0..${cut}], GO_${i}[0..${cut}])", "  expect(got[${cut}].starts_with(\"OUT page 1: \")) == true", "}"]
        out.push(t.join("\n"))
        continue
      }
    } else if meth.starts_with("Begin") {
      t = t + ["  match ${call} {", "    Ok(p0) => {", "      var p = p0", "      gv_quiet(f, true)", "      let done = p.poll_until_done(os.clock, frequency: 1s)", "      gv_quiet(f, false)", "      match done {", "        Ok(r) => gv_note(f, \"OUT: \${show_${sn}(r)}\")", "        Err(e) => gv_note_lines(f, \"OUT: error: \${gv_err_text(e)}\")", "      }", "    }", "    Err(e) => gv_note_lines(f, \"OUT: error: \${gv_err_text(e)}\")", "  }"]
    } else if pager {
      t = t + ["  var pg = ${call} ?? e => fault(\"\${e}\")", "  for page in [1, 2] {", "    if !pg.more() {", "      gv_note(f, \"OUT page \${page}: no more\")", "      break", "    }", "    match pg.next_page() {", "      Ok(r) => gv_note(f, \"OUT page \${page}: \${show_${sn}(r)}\")", "      Err(e) => {", "        gv_note_lines(f, \"OUT page \${page}: error: \${gv_err_text(e)}\")", "        break", "      }", "    }", "  }"]
    } else {
      t = t + ["  match ${call} {", "    Ok(r) => gv_note(f, \"OUT: \${show_${sn}(r)}\")", "    Err(e) => gv_note_lines(f, \"OUT: error: \${gv_err_text(e)}\")", "  }"]
    }
    t = t + ["  gv_compare(gv_log_of(f), GO_${i})", "}"]
    out.push(t.join("\n"))
  }
  var text = out.join("\n\n") + "\n"
  // std/json only when a test uses it (a module whose every call is a
  // shape mismatch, or has no JSON body, does not)
  if !out[1..out.len()].any(fn(t: Str) -> Bool { t.contains("json.") }) {
    text = text.replace("use std/json\n", "")
  }
  let (_, after) = text.cut("use github.com/xo-lang/azure/runtime") ?? ("", "")
  if !after.contains("azcore.") {
    text = text.replace("use github.com/xo-lang/azure/azcore\n", "")
  }
  os.fs.write(out_path, text.bytes())?
  os.stdio.println("${calls.len()} calls")
  Ok(())
}

fn index_of_panic(lines: List[Str]) -> Int {
  for k in 0..lines.len() {
    if lines[k].contains(": panic: ") {
      return k
    }
  }
  lines.len()
}

/// The first `<Word>Response` in a return type.
fn response_name(ret: Str) -> Str? {
  for w in ret.replace("[", " ").replace("]", " ").replace(",", " ").replace("!", " ").split(" ") {
    if w.ends_with("Response") && is_word(w) {
      return Some(w)
    }
  }
  None
}
