// The generator's command, run from the repository root:
//   xo run ./codegen/cmd/gen -- <module dir>
// finds the module's row in codegen/services.toml, reads its spec from
// codegen/.specs/<commit>/ (codegen/fetch-specs.sh): a readme tag's
// input files (an autorest module) or one OpenAPI file emitted from
// TypeSpec with the project's Go renames (a TypeSpec module), plus
// every file they `$ref` and codegen/custom/<module>.toml when present,
// and writes the module into <module dir>.
// What the generator does not handle is printed, never dropped silently.

use std/json
use std/regexp
use std/toml
use github.com/xo-lang/azure/codegen/gen
use github.com/xo-lang/azure/codegen/spec

struct Service {
  pub dir: Str
  pub spec: Str
  pub readme_tag: Str = ""
  /// A TypeSpec module's emitted OpenAPI file, from the repository root.
  pub openapi: Str = ""
  /// A TypeSpec project that emits several OpenAPI files (armcompute's
  /// ComputeRP, DiskRP, GalleryRP and skus, each its own api-version):
  /// the others, after `openapi`.
  pub openapi_more: List[Str] = []
  /// An autorest module's one input file, from the repository root,
  /// when Go's autorest.md names it directly (`input-file:`) rather
  /// than a readme tag: the spec's readme and readme.go.md directives do
  /// not apply (azcontainerregistry).
  pub swagger: Str = ""
  /// The spec commit, when not specs.lock's.
  pub commit: Str = ""
  pub go_module: Str = ""
  pub go_version: Str = ""
  pub version: Str
  /// autorest.md's `modelerfour: seal-single-value-enum-by-default`.
  pub seal_single_value_enums: Bool = false
  /// Go's module writes its `date-time` fields in UTC (the TypeSpec Go
  /// emitter's populateTime with utc; armresources v4's older emitter
  /// keeps the offset): they are azcore.DateTimeUTC.
  pub utc_date_times: Bool = false
} derive Json

struct Services {
  pub service: List[Service]
} derive Json

/// One `[[replace]]`: Go's `$.replace(/pattern/g, "with")`.
struct TextReplace {
  pub pattern: Str
  pub repl as "with": Str
} derive Json

/// `text` with each of `reps` applied.
fn rewrite(text: Str, reps: List[TextReplace]) -> Str ! Str {
  var t = text
  for r in reps {
    let re = regexp.compile(r.pattern) ?? e => return Err("replace ${r.pattern}: ${e.display()}")
    t = re.replace_all(t, r.repl)
  }
  Ok(t)
}

/// codegen/custom/<module>.toml: what Go's module changes after
/// generating (its transforms), and the data plane shape.
struct CustomFile {
  pub data_plane: Bool = false
  pub reachable_only: Bool = false
  /// autorest.md's `remove-unreferenced-types: true`: only the types
  /// operations reach, as `reachable_only`, but autorest.go's shapes.
  pub remove_unreferenced: Bool = false
  pub field_types: Map[Str, Str] = {}
  pub replace_types: Map[Str, Str] = {}
  /// Type names Go's modelerfour gives an inline schema from its JSON
  /// path (Components1Jq1T4I...), keyed by the name this generator gives.
  pub models: Map[Str, Str] = {}
  /// Enum values Go's transforms delete (`SignatureAlgorithmRSNULL`), by
  /// enum name: their wire values.
  pub drop_values: Map[Str, List[Str]] = {}
  pub drop_params: List[Str] = []
  /// An operation's (operationId, lower case) path parameters in Go's
  /// order, where Go's TypeSpec emitter orders them otherwise than the
  /// path (armkeyvault v2's `VaultsClient.GetDeleted(vaultName, location)`).
  pub param_order: Map[Str, List[Str]] = {}
  pub allow_empty: List[Str] = []
  /// A data plane module whose Go emitter sends Accept on every
  /// operation (azsecrets v1.4.0); later ones only with a response body.
  pub accept_always: Bool = false
  /// A Go emitter that writes a query's spaces as `%20`, not `+`
  /// (`strings.ReplaceAll(reqQP.Encode(), "+", "%20")`: azsecrets v1.5.1,
  /// azappconfig v2.3.0).
  pub query_pct20: Bool = false
  /// Other modules of this repository the hand written files use.
  pub needs as "requires": List[Str] = []
  /// operationIds polled by runtime.new_status_poller (see gen.Custom).
  pub status_pollers: List[Str] = []
  /// Edits of the spec before it is read: autorest.md's swagger-document
  /// transforms, in their order (spec.Patch).
  pub patch: List[spec.Patch] = []
  /// autorest.md's `rename-operation`s: operationId (any case) to its
  /// new operationId's operation part.
  pub ops: Map[Str, Str] = {}
  /// Go's response field of an operation's binary body (operationId):
  /// autorest.md's replace of `Body` (`BlobData`).
  pub body_fields: Map[Str, Str] = {}
  /// See gen.Package: a next link header's hand-written transform, and
  /// the operations (`BlobClient.UploadChunk`) and types Go hides.
  pub next_link_transform: Str = ""
  pub private_ops: List[Str] = []
  pub private_types: List[Str] = []
  /// A parameter's Go name by wire name, where Go's emitter casing is not
  /// the wire's (Batch's `ocp-date` is OCPDate); over TypeSpec's renames.
  pub param_names: Map[Str, Str] = {}
  /// A response header's field by header name (lower case), where Go's
  /// differs from the header's words.
  pub header_names: Map[Str, Str] = {}
  /// See gen.Custom.merge_update_variants.
  pub merge_update_variants: Bool = false
  /// See gen.Custom.patch_twins.
  pub patch_twins: Bool = true
  /// Keep only the input files' definitions named one of these
  /// prefixes and more (spec.keep_definitions), before the patches.
  pub keep_definitions: List[Str] = []
  /// Emit every definition of a TypeSpec module (gen.Custom).
  pub all_definitions: Bool = false
  /// Models Go's own generate step deletes after generation, by name.
  pub drop_models: List[Str] = []
  /// Go's azsystemevents event type constants (gen.emit_event_types).
  pub event_types: Bool = false
  /// autorest.md's transforms of Go's generated text, as regular
  /// expressions over every generated file, in order (azwebpubsub's
  /// `Client(\w+)(Options|Response)` to `$1$2`).
  pub replace: List[TextReplace] = []
} derive Json

fn main(os: Os) -> () ! Error {
  let args = os.env.args()
  if args.len() != 1 {
    os.stdio.println("usage: gen <module dir>")
    return Ok(())
  }
  let dir = args[0]
  let services = toml.decode[Services](os.fs.read_text("codegen/services.toml")?)?
  let svc = services.service.filter(fn(s: Service) -> Bool { s.dir == dir }).get(0) ?? return Err("no row for ${dir} in codegen/services.toml")
  var commit = svc.commit
  if commit == "" {
    for line in os.fs.read_text("codegen/specs.lock")?.split("\n") {
      if line.starts_with("commit ") {
        commit = line[7..line.len()].trim()
      }
    }
  }
  let base = "codegen/.specs/${commit}"
  let name = dir.split("/").last() ?? dir
  let custom_path = "codegen/custom/${name}.toml"
  let cf = if os.fs.exists(custom_path)? { toml.decode[CustomFile](os.fs.read_text(custom_path)?)? } else { CustomFile{} }
  var custom = gen.Custom{models: cf.models, drop_values: cf.drop_values, field_types: cf.field_types, replace_types: cf.replace_types, drop_params: cf.drop_params, param_order: cf.param_order, allow_empty: cf.allow_empty, reachable_only: cf.reachable_only || cf.remove_unreferenced || svc.openapi != "", seal_single_value_enums: svc.seal_single_value_enums, utc_date_times: svc.utc_date_times, tsp: svc.openapi != "", all_definitions: cf.all_definitions, data_plane: cf.data_plane, status_pollers: cf.status_pollers.map(fn(s: Str) -> Str { s.to_lower() }), ops: lower_keys(cf.ops), body_fields: lower_keys(cf.body_fields), merge_update_variants: cf.merge_update_variants, patch_twins: cf.patch_twins}
  var inputs: List[Str] = []
  var source = ""
  if svc.openapi != "" {
    inputs = ["${base}/${svc.openapi}"] + svc.openapi_more.map(fn(o: Str) -> Str { "${base}/${o}" })
    // every .tsp of the project, its subprojects' folders too
    var texts: List[Str] = []
    // each namespace's emitted file: a folder's main.tsp declares it,
    // and the folder's tspconfig.yaml names the file (output-file)
    var ns_file: Map[Str, Str] = {}
    for f in os.fs.walk("${base}/${svc.spec}")? {
      if !f.is_dir && f.name.ends_with(".tsp") && !f.path.contains("/examples/") {
        let text = os.fs.read_text(f.path)?
        texts.push(text)
        if f.name == "main.tsp" {
          let dir = f.path[0..f.path.len() - f.name.len() - 1]
          let cfg = "${dir}/tspconfig.yaml"
          if os.fs.exists(cfg)? {
            if let Some(out) = output_file(os.fs.read_text(cfg)?) {
              for line in text.split("\n") {
                let l = line.trim()
                if l.starts_with("namespace ") && l.ends_with(";") {
                  ns_file[l[10..l.len() - 1].trim()] = out
                }
              }
            }
          }
        }
      }
    }
    let r = spec.renames(texts)?
    let input_names = inputs.map(fn(i: Str) -> Str { i.split("/").last() ?? i })
    var file_models: Map[Str, Str] = {}
    var models = r.models
    for (k, v) in r.ns_models {
      let (ns, m) = k.cut("#") ?? continue
      match ns_file.get(ns) {
        Some(file) if input_names.contains(file) => file_models["${file}#${m}"] = v
        _ => models[m] = v
      }
    }
    custom = custom with {ops: r.ops, models: models, file_models: file_models, fields: r.fields, not_go_fields: r.not_go_fields, params: merged(r.params, cf.param_names), client_ops: r.client_ops, alt_fields: r.field_types, param_types: r.param_types, alt_models: r.model_types, tsp_ops: r.tsp_ops, final_states: r.final_states, body_roots: r.body_roots, method_params: r.method_params}
    source = "${svc.openapi} (from ${svc.spec})"
  } else if svc.swagger != "" {
    inputs = ["${base}/${svc.swagger}"]
    source = svc.swagger
  } else {
    let root = "${base}/${svc.spec}"
    let readme = os.fs.read_text("${root}/readme.md")?
    inputs = spec.input_files(readme, svc.readme_tag)?.map(fn(f: Str) -> Str { "${root}/${f}" })
    source = "${svc.spec}, tag ${svc.readme_tag}"
  }
  var files: Map[Str, json.Value] = {}
  var queue = inputs
  while let Some(f) = queue.pop() {
    if files.contains(f) {
      continue
    }
    let doc = json.parse_value(os.fs.read_text(f)?)?
    for r in gen.refs_of(f, doc) {
      if !files.contains(r) {
        queue.push(r)
      }
    }
    files[f] = doc
  }
  // each patch must change one of the files it is for
  var patch_hits: Map[Str, Int] = {}
  for f in inputs {
    files[f] = spec.keep_definitions(files.get(f) ?? json.Value.Null, cf.keep_definitions)
  }
  for (f, doc) in files {
    let (d, m) = spec.apply_patches(doc, f, cf.patch)?
    files[f] = d
    for pt in cf.patch {
      let k = "${pt.op} ${pt.pointer}"
      if (pt.file == "" || f.ends_with("/${pt.file}")) && !m.contains(k) {
        patch_hits[k] = (patch_hits.get(k) ?? 0) + 1
      }
    }
  }
  let unpatched = cf.patch.map(fn(pt: spec.Patch) -> Str { "${pt.op} ${pt.pointer}" }).filter(fn(k: Str) -> Bool { !patch_hits.contains(k) })
  // readme.go.md's assignments (enum and field renames for Go).
  var skipped: List[Str] = []
  if svc.openapi == "" && svc.swagger == "" {
    let go_md = "${base}/${svc.spec}/readme.go.md"
    if os.fs.exists(go_md)? {
      let ds = spec.go_directives(os.fs.read_text(go_md)?)?
      // readme.md's own for the tag first (every language's), then Go's.
      let ts = spec.tag_directives(os.fs.read_text("${base}/${svc.spec}/readme.md")?, svc.readme_tag)?
      for (f, doc) in files {
        let (d0, _) = spec.apply(doc, f, ts.assigns)
        let (d1, _) = spec.apply_renames(d0, ts.renames)
        let (d, _) = spec.apply(d1, f, ds.assigns)
        let (d2, _) = spec.apply_renames(d, ds.renames)
        files[f] = d2
      }
      skipped = ds.skipped
    }
  }
  var b = gen.builder(files, name, custom)
  let built = b.build(inputs)
  let api = built with {models: built.models.filter(fn(m: gen.Model) -> Bool { !cf.drop_models.contains(m.name) })}
  let tspconfig = "${base}/${svc.spec}/tspconfig.yaml"
  let head_as_boolean = svc.openapi != "" && os.fs.exists(tspconfig)? && go_option(os.fs.read_text(tspconfig)?, "head-as-boolean") == Some("true")
  let p = gen.Package{name: name, module: "github.com/xo-lang/azure/${dir}", version: svc.version, source: "${source} at ${commit[0..12]}", data_plane: cf.data_plane, allow_empty: cf.allow_empty, accept_always: cf.accept_always, query_pct20: cf.query_pct20, typespec: cf.reachable_only || svc.openapi != "", tsp_arm: svc.openapi != "" && !cf.data_plane, head_as_boolean: head_as_boolean, go_package: go_package(svc.go_module, name), next_link_transform: cf.next_link_transform, private_ops: cf.private_ops, private_types: cf.private_types, header_names: lower_keys(cf.header_names)}
  os.fs.create_dir_all(dir)?
  os.fs.write("${dir}/xo.mod", ("module ${p.module}\nedition preview\n\nrequire github.com/xo-lang/azure v0.1.0\n" + cf.needs.map(fn(r: Str) -> Str { "require ${r} v0.1.0\n" }).join("")).bytes())?
  let m = gen.emit_models(p, api)
  os.fs.write("${dir}/${m.name}", rewrite(m.text, cf.replace)?.bytes())?
  if cf.event_types {
    let f = gen.emit_event_types(p, api)?
    os.fs.write("${dir}/${f.name}", (f.text).bytes())?
  }
  for f in gen.emit_clients(p, api) {
    os.fs.write("${dir}/${f.name}", rewrite(f.text, cf.replace)?.bytes())?
  }
  os.stdio.println("${name}: ${api.ops.len()} operations, ${api.models.len()} models, ${api.enums.len()} enums, api-version ${api.api_version}")
  for r in api.report {
    os.stdio.println("  not handled: ${r}")
  }
  for w in unpatched {
    os.stdio.println("  patch not applied: ${w}")
  }
  for w in skipped {
    os.stdio.println("  readme.go.md directive not applied: ${w}")
  }
  Ok(())
}

/// The OpenAPI file name a tspconfig.yaml's autorest emitter writes
/// (`output-file: "../{version-status}/{version}/DiskRP.json"` is
/// DiskRP.json).
fn output_file(cfg: Str) -> Str? {
  for line in cfg.split("\n") {
    let l = line.trim()
    if l.starts_with("output-file:") {
      let v = l[12..l.len()].trim().trim_prefix("\"").trim_suffix("\"")
      return Some(v.split("/").last() ?? v)
    }
  }
  None
}

/// Option `key` of tspconfig.yaml's `"@azure-tools/typespec-go"` block
/// (`head-as-boolean: true` is `Some("true")`).
fn go_option(cfg: Str, key: Str) -> Str? {
  var in_go = false
  for line in cfg.split("\n") {
    let l = line.trim()
    if l.starts_with("\"@") {
      in_go = l.starts_with("\"@azure-tools/typespec-go\"")
    } else if in_go && l.starts_with("${key}:") {
      return Some(l[key.len() + 1..l.len()].trim().trim_prefix("\"").trim_suffix("\""))
    }
  }
  None
}

/// The Go import path of package `name` in module `module`: the module
/// itself when it ends in the package (`.../armnetwork/v8`), else the
/// package's directory under it (`.../azadmin/backup`).
fn go_package(module: Str, name: Str) -> Str {
  let parts = module.split("/")
  var last = parts[parts.len() - 1]
  if parts.len() > 1 && is_major_suffix(last) {
    last = parts[parts.len() - 2]
  }
  if last == name { module } else { "${module}/${name}" }
}

/// A Go major version suffix: `v` and digits (`v8`).
fn is_major_suffix(s: Str) -> Bool {
  if s.len() < 2 || !s.starts_with("v") {
    return false
  }
  for i in 1..s.len() {
    if !"0123456789".contains(s[i..i + 1]) {
      return false
    }
  }
  true
}

/// `m` with its keys in lower case.
fn lower_keys(m: Map[Str, Str]) -> Map[Str, Str] {
  var out: Map[Str, Str] = {}
  for (k, v) in m {
    out[k.to_lower()] = v
  }
  out
}

/// a with b's entries over it.
fn merged(a: Map[Str, Str], b: Map[Str, Str]) -> Map[Str, Str] {
  var out = a
  for (k, v) in b {
    out[k] = v
  }
  out
}
