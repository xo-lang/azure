// The generator's command, run from the repository root:
//   xo run ./codegen/cmd/gen -- <module dir>
// finds the module's row in codegen/services.toml, reads its spec from
// codegen/.specs/<commit>/ (codegen/fetch-specs.sh): a readme tag's
// input files (an autorest module) or one OpenAPI file emitted from
// TypeSpec with the project's Go renames (a TypeSpec module), plus
// every file they `$ref` and codegen/custom/<module>.toml when present,
// and writes the module into <module dir>.
// What the generator does not handle is printed, never dropped silently.

use std/json
use std/toml
use github.com/xo-lang/azure/codegen/gen
use github.com/xo-lang/azure/codegen/spec

struct Service {
  pub dir: Str
  pub spec: Str
  pub readme_tag: Str = ""
  /// A TypeSpec module's emitted OpenAPI file, from the repository root.
  pub openapi: Str = ""
  /// A TypeSpec project that emits several OpenAPI files (armcompute's
  /// ComputeRP, DiskRP, GalleryRP and skus, each its own api-version):
  /// the others, after `openapi`.
  pub openapi_more: List[Str] = []
  /// The spec commit, when not specs.lock's.
  pub commit: Str = ""
  pub go_module: Str = ""
  pub go_version: Str = ""
  pub version: Str
  /// autorest.md's `modelerfour: seal-single-value-enum-by-default`.
  pub seal_single_value_enums: Bool = false
} derive Json

struct Services {
  pub service: List[Service]
} derive Json

/// codegen/custom/<module>.toml: what Go's module changes after
/// generating (its transforms), and the data plane shape.
struct CustomFile {
  pub data_plane: Bool = false
  pub reachable_only: Bool = false
  pub field_types: Map[Str, Str] = {}
  pub replace_types: Map[Str, Str] = {}
  /// Type names Go's modelerfour gives an inline schema from its JSON
  /// path (Components1Jq1T4I...), keyed by the name this generator gives.
  pub models: Map[Str, Str] = {}
  /// Enum values Go's transforms delete (`SignatureAlgorithmRSNULL`), by
  /// enum name: their wire values.
  pub drop_values: Map[Str, List[Str]] = {}
  pub drop_params: List[Str] = []
  pub allow_empty: List[Str] = []
  /// A data plane module whose Go emitter sends Accept on every
  /// operation (azsecrets v1.4.0); later ones only with a response body.
  pub accept_always: Bool = false
  /// A Go emitter that writes a query's spaces as `%20`, not `+`
  /// (`strings.ReplaceAll(reqQP.Encode(), "+", "%20")`: azsecrets v1.5.1,
  /// azappconfig v2.3.0).
  pub query_pct20: Bool = false
  /// Other modules of this repository the hand written files use.
  pub needs as "requires": List[Str] = []
  /// operationIds polled by runtime.new_status_poller (see gen.Custom).
  pub status_pollers: List[Str] = []
} derive Json

fn main(os: Os) -> () ! Error {
  let args = os.env.args()
  if args.len() != 1 {
    os.stdio.println("usage: gen <module dir>")
    return Ok(())
  }
  let dir = args[0]
  let services = toml.decode[Services](os.fs.read_text("codegen/services.toml")?)?
  let svc = services.service.filter(fn(s: Service) -> Bool { s.dir == dir }).get(0) ?? return Err("no row for ${dir} in codegen/services.toml")
  var commit = svc.commit
  if commit == "" {
    for line in os.fs.read_text("codegen/specs.lock")?.split("\n") {
      if line.starts_with("commit ") {
        commit = line[7..line.len()].trim()
      }
    }
  }
  let base = "codegen/.specs/${commit}"
  let name = dir.split("/").last() ?? dir
  let custom_path = "codegen/custom/${name}.toml"
  let cf = if os.fs.exists(custom_path)? { toml.decode[CustomFile](os.fs.read_text(custom_path)?)? } else { CustomFile{} }
  var custom = gen.Custom{models: cf.models, drop_values: cf.drop_values, field_types: cf.field_types, replace_types: cf.replace_types, drop_params: cf.drop_params, allow_empty: cf.allow_empty, reachable_only: cf.reachable_only || svc.openapi != "", seal_single_value_enums: svc.seal_single_value_enums, tsp: svc.openapi != "", data_plane: cf.data_plane, status_pollers: cf.status_pollers.map(fn(s: Str) -> Str { s.to_lower() })}
  var inputs: List[Str] = []
  var source = ""
  if svc.openapi != "" {
    inputs = ["${base}/${svc.openapi}"] + svc.openapi_more.map(fn(o: Str) -> Str { "${base}/${o}" })
    // every .tsp of the project, its subprojects' folders too
    var texts: List[Str] = []
    // each namespace's emitted file: a folder's main.tsp declares it,
    // and the folder's tspconfig.yaml names the file (output-file)
    var ns_file: Map[Str, Str] = {}
    for f in os.fs.walk("${base}/${svc.spec}")? {
      if !f.is_dir && f.name.ends_with(".tsp") && !f.path.contains("/examples/") {
        let text = os.fs.read_text(f.path)?
        texts.push(text)
        if f.name == "main.tsp" {
          let dir = f.path[0..f.path.len() - f.name.len() - 1]
          let cfg = "${dir}/tspconfig.yaml"
          if os.fs.exists(cfg)? {
            if let Some(out) = output_file(os.fs.read_text(cfg)?) {
              for line in text.split("\n") {
                let l = line.trim()
                if l.starts_with("namespace ") && l.ends_with(";") {
                  ns_file[l[10..l.len() - 1].trim()] = out
                }
              }
            }
          }
        }
      }
    }
    let r = spec.renames(texts)?
    let input_names = inputs.map(fn(i: Str) -> Str { i.split("/").last() ?? i })
    var file_models: Map[Str, Str] = {}
    var models = r.models
    for (k, v) in r.ns_models {
      let (ns, m) = k.cut("#") ?? continue
      match ns_file.get(ns) {
        Some(file) if input_names.contains(file) => file_models["${file}#${m}"] = v
        _ => models[m] = v
      }
    }
    custom = custom with {ops: r.ops, models: models, file_models: file_models, fields: r.fields, params: r.params, client_ops: r.client_ops, alt_fields: r.field_types, param_types: r.param_types, alt_models: r.model_types, tsp_ops: r.tsp_ops, final_states: r.final_states, body_roots: r.body_roots}
    source = "${svc.openapi} (from ${svc.spec})"
  } else {
    let root = "${base}/${svc.spec}"
    let readme = os.fs.read_text("${root}/readme.md")?
    inputs = spec.input_files(readme, svc.readme_tag)?.map(fn(f: Str) -> Str { "${root}/${f}" })
    source = "${svc.spec}, tag ${svc.readme_tag}"
  }
  var files: Map[Str, json.Value] = {}
  var queue = inputs
  while let Some(f) = queue.pop() {
    if files.contains(f) {
      continue
    }
    let doc = json.parse_value(os.fs.read_text(f)?)?
    for r in gen.refs_of(f, doc) {
      if !files.contains(r) {
        queue.push(r)
      }
    }
    files[f] = doc
  }
  // readme.go.md's assignments (enum and field renames for Go).
  var skipped: List[Str] = []
  if svc.openapi == "" {
    let go_md = "${base}/${svc.spec}/readme.go.md"
    if os.fs.exists(go_md)? {
      let ds = spec.go_directives(os.fs.read_text(go_md)?)?
      // readme.md's own for the tag first (every language's), then Go's.
      let ts = spec.tag_directives(os.fs.read_text("${base}/${svc.spec}/readme.md")?, svc.readme_tag)?
      for (f, doc) in files {
        let (d0, _) = spec.apply(doc, f, ts.assigns)
        let (d1, _) = spec.apply_renames(d0, ts.renames)
        let (d, _) = spec.apply(d1, f, ds.assigns)
        let (d2, _) = spec.apply_renames(d, ds.renames)
        files[f] = d2
      }
      skipped = ds.skipped
    }
  }
  var b = gen.builder(files, name, custom)
  let api = b.build(inputs)
  let tspconfig = "${base}/${svc.spec}/tspconfig.yaml"
  let head_as_boolean = svc.openapi != "" && os.fs.exists(tspconfig)? && go_option(os.fs.read_text(tspconfig)?, "head-as-boolean") == Some("true")
  let p = gen.Package{name: name, module: "github.com/xo-lang/azure/${dir}", version: svc.version, source: "${source} at ${commit[0..12]}", data_plane: cf.data_plane, allow_empty: cf.allow_empty, accept_always: cf.accept_always, query_pct20: cf.query_pct20, typespec: cf.reachable_only || svc.openapi != "", tsp_arm: svc.openapi != "" && !cf.data_plane, head_as_boolean: head_as_boolean, go_package: go_package(svc.go_module, name)}
  os.fs.create_dir_all(dir)?
  os.fs.write("${dir}/xo.mod", ("module ${p.module}\nedition preview\n\nrequire github.com/xo-lang/azure v0.1.0\n" + cf.needs.map(fn(r: Str) -> Str { "require ${r} v0.1.0\n" }).join("")).bytes())?
  let m = gen.emit_models(p, api)
  os.fs.write("${dir}/${m.name}", (m.text).bytes())?
  for f in gen.emit_clients(p, api) {
    os.fs.write("${dir}/${f.name}", (f.text).bytes())?
  }
  os.stdio.println("${name}: ${api.ops.len()} operations, ${api.models.len()} models, ${api.enums.len()} enums, api-version ${api.api_version}")
  for r in api.report {
    os.stdio.println("  not handled: ${r}")
  }
  for w in skipped {
    os.stdio.println("  readme.go.md directive not applied: ${w}")
  }
  Ok(())
}

/// The OpenAPI file name a tspconfig.yaml's autorest emitter writes
/// (`output-file: "../{version-status}/{version}/DiskRP.json"` is
/// DiskRP.json).
fn output_file(cfg: Str) -> Str? {
  for line in cfg.split("\n") {
    let l = line.trim()
    if l.starts_with("output-file:") {
      let v = l[12..l.len()].trim().trim_prefix("\"").trim_suffix("\"")
      return Some(v.split("/").last() ?? v)
    }
  }
  None
}

/// Option `key` of tspconfig.yaml's `"@azure-tools/typespec-go"` block
/// (`head-as-boolean: true` is `Some("true")`).
fn go_option(cfg: Str, key: Str) -> Str? {
  var in_go = false
  for line in cfg.split("\n") {
    let l = line.trim()
    if l.starts_with("\"@") {
      in_go = l.starts_with("\"@azure-tools/typespec-go\"")
    } else if in_go && l.starts_with("${key}:") {
      return Some(l[key.len() + 1..l.len()].trim().trim_prefix("\"").trim_suffix("\""))
    }
  }
  None
}

/// The Go import path of package `name` in module `module`: the module
/// itself when it ends in the package (`.../armnetwork/v8`), else the
/// package's directory under it (`.../azadmin/backup`).
fn go_package(module: Str, name: Str) -> Str {
  let parts = module.split("/")
  var last = parts[parts.len() - 1]
  if parts.len() > 1 && is_major_suffix(last) {
    last = parts[parts.len() - 2]
  }
  if last == name { module } else { "${module}/${name}" }
}

/// A Go major version suffix: `v` and digits (`v8`).
fn is_major_suffix(s: Str) -> Bool {
  if s.len() < 2 || !s.starts_with("v") {
    return false
  }
  for i in 1..s.len() {
    if !"0123456789".contains(s[i..i + 1]) {
      return false
    }
  }
  true
}
