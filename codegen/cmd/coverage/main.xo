// The coverage report's ARM sections, run from the repository root:
//   xo run ./codegen/cmd/coverage
// rewrites docs/reports/azure-go-coverage.md's ARM tables from the
// repository: each Go ARM module row (Go's columns kept as the report
// has them) goes under its status, which is derived, never written by
// hand:
//   - Go-verified: the module has govectors_test.xo (a test per call of
//     every client against Go's own requests and results), which the
//     gate runs; vectors that do not pass yet are not committed
//     (scripts/refresh.sh removes them), so the file means they pass.
//     "old vector format": only goscenario_test.xo, the hand-picked calls
//     recorded before the reflection program, until the full set passes
//     (the scenarios stay beside it: resume tokens, multi-step polls).
//   - compiled: a services.toml row and generated code, which the gate
//     builds and tests; no Go vectors yet.
//   - not generated: no services.toml row yet.
// A module is "ported" only once Go-verified.

use std/toml

struct Service {
  pub dir: Str
  pub go_version: Str = ""
  /// Why a module stays compiled, not Go-verified, written after its
  /// status (armvideoanalyzer: a retired service).
  pub status_note: Str = ""
} derive Json

struct Services {
  pub service: List[Service]
} derive Json

const REPORT: Str = "docs/reports/azure-go-coverage.md"

struct Row {
  pub dir: Str
  pub cells: List[Str]
}

fn cells_of(line: Str) -> List[Str] {
  let inner = line.trim()
  let body = inner[1..inner.len() - 1]
  body.split("|").map(fn(c: Str) -> Str { c.trim() })
}

fn row_text(cells: List[Str]) -> Str {
  "| " + cells.join(" | ") + " |"
}

fn main(os: Os) -> () ! Error {
  let services = toml.decode[Services](os.fs.read_text("codegen/services.toml")?)?
  var rows_by_dir: Map[Str, Service] = {}
  for s in services.service {
    rows_by_dir[s.dir] = s
  }
  let text = os.fs.read_text(REPORT)?
  let lines = text.split("\n")
  // the report's ARM rows (Go's columns), from whichever ARM section
  // holds them; the sections before the first ARM one are kept
  var head: List[Str] = []
  var tail: List[Str] = []
  var arm: List[Row] = []
  var state = 0
  for line in lines {
    if state == 0 && line.starts_with("## ARM modules") {
      state = 1
    } else if state == 1 && line.starts_with("## ") && !line.starts_with("## ARM modules") {
      state = 2
    }
    if state == 0 {
      head.push(line)
    } else if state == 2 {
      tail.push(line)
    } else if line.starts_with("| resourcemanager/") && !line.contains("(support module)") {
      let cs = cells_of(line)
      // Go's columns: module, latest, kind, Go lines (a ported row has
      // Go's hand-written lines before Go lines)
      let go_lines = if cs.len() >= 8 { cs[4] } else { cs[3] }
      arm.push(Row{dir: cs[0], cells: [cs[0], cs[1], cs[2], go_lines]})
    }
  }
  arm = arm.sort_by(fn(r: Row) -> Str { r.dir })
  var verified: List[Str] = []
  var compiled: List[Str] = []
  var missing: List[Str] = []
  for r in arm {
    match rows_by_dir.get(r.dir) {
      None => missing.push(row_text(r.cells + ["", "", "not generated"]))
      Some(s) => {
        let lines_n = generated_lines(os, r.dir)?
        if os.fs.exists("${r.dir}/govectors_test.xo")? {
          verified.push(row_text(r.cells + [s.go_version, "${lines_n} gen", "Go-verified"]))
        } else if os.fs.exists("${r.dir}/goscenario_test.xo")? {
          verified.push(row_text(r.cells + [s.go_version, "${lines_n} gen", "Go-verified (old vector format)"]))
        } else {
          compiled.push(row_text(r.cells + [s.go_version, "${lines_n} gen", if s.status_note == "" { "compiled" } else { "compiled (${s.status_note})" }]))
        }
      }
    }
  }
  let header = "| Go module | latest | kind | Go lines | our port | our lines | status |\n|---|---|---|---:|---|---:|---|"
  var out = head
  out.push("## ARM modules: Go-verified (${verified.len()})")
  out.push("")
  out.push("All ARM code is generated, in Go and here. Generated by")
  out.push("codegen/cmd/coverage from the repository: a module is ported once its")
  out.push("Go vectors pass (every call of every client against Go's own requests")
  out.push("and results).")
  out.push("")
  out.push(header)
  out = out + verified
  out.push("")
  out.push("## ARM modules: compiled, not yet Go-verified (${compiled.len()})")
  out.push("")
  out.push("Generated from Go's pinned spec and built and tested by the gate; not")
  out.push("counted as ported until their Go vectors pass.")
  out.push("")
  out.push(header)
  out = out + compiled
  out.push("")
  out.push("## ARM modules not generated yet (${missing.len()})")
  out.push("")
  out.push("<details><summary>The list</summary>")
  out.push("")
  out.push(header)
  out = out + missing
  out.push("")
  out.push("</details>")
  out.push("")
  out = out + tail
  os.fs.write(REPORT, out.join("\n").bytes())?
  os.stdio.println("Go-verified ${verified.len()}, compiled ${compiled.len()}, not generated ${missing.len()}")
  Ok(())
}

/// The newline count of a module's generated .xo files (not tests).
fn generated_lines(os: Os, dir: Str) -> Int ! Error {
  var n = 0
  if !os.fs.exists(dir)? {
    return Ok(0)
  }
  for f in os.fs.walk(dir)? {
    if !f.is_dir && f.name.ends_with(".xo") && !f.name.ends_with("_test.xo") {
      n = n + os.fs.read_text(f.path)?.split("\n").len() - 1
    }
  }
  Ok(n)
}
