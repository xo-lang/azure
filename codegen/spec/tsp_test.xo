use std/json

const CLIENT: Str = "@@clientName(KeyVault, \"Client\", \"go\");\n@@clientName(getSecrets, \"ListSecretProperties\", \"go\");\n@@clientName(SecretBundle, \"Secret\", \"go\");\n@@clientName(SecretBundle, \"SecretBundleRust\", \"rust\");\n@@clientName(DeletedSecretListResult,\n  \"DeletedSecretPropertiesListResult\",\n  \"go\"\n);\n@@clientName(SecretBundle.kid, \"KID\", \"go\");\n"
const ROUTES: Str = "op getSecret is KeyVaultOperation<\n  {\n    /**\n     * The name.\n     */\n    @pattern(\"^[0-9a-zA-Z-]+$\")\n    @path(\"secret-name\")\n    @clientName(\"name\", \"go\")\n    secretName: string;\n    @path(\"secret-version\")\n    @clientName(\"version\", \"go\")\n    secretVersion: string;\n  }, SecretBundle>;\n"

test "Go renames come from @@clientName statements and parameter decorators" {
  let r = renames([CLIENT, ROUTES])?
  expect(r.ops.get("getsecrets")) == Some("ListSecretProperties")
  expect(r.models.get("SecretBundle")) == Some("Secret")
  expect(r.models.get("DeletedSecretListResult")) == Some("DeletedSecretPropertiesListResult")
  expect(r.models.get("KeyVault")) == Some("Client")
  expect(r.fields.get("SecretBundle.kid")) == Some("KID")
  expect(r.params.get("secret-name")) == Some("name")
  expect(r.params.get("secret-version")) == Some("version")
}

const README: Str = "### Tag: package-2024-01\n\n```yaml $(tag) == 'package-2024-01'\ninput-file:\n  - Microsoft.Storage/stable/2024-01-01/blob.json\n  - Microsoft.Storage/stable/2024-01-01/common.json\n\ndirective:\n  - suppress: R1\n```\n\n``` yaml $(tag) == 'package-2023-05'\ninput-file:\n  - Microsoft.Storage/stable/2023-05-01/storage.json\n```\n"

test "a readme tag's input files, whatever the fence spacing" {
  expect(input_files(README, "package-2024-01")?) == ["Microsoft.Storage/stable/2024-01-01/blob.json", "Microsoft.Storage/stable/2024-01-01/common.json"]
  expect(input_files(README, "package-2023-05")?) == ["Microsoft.Storage/stable/2023-05-01/storage.json"]
}

const README_GO: Str = "## Go\n\n```yaml $(go) && !$(track2)\ndirective:\n  - where: $.definitions.Track1\n    transform: $['a'] = 'b'\n```\n\n``` yaml $(go) && $(track2)\nlicense-header: MICROSOFT_MIT_NO_VERSION\ndirective:\n  - from: swagger-document\n    where: $.definitions.CorsRule\n    transform: $['properties']['allowedMethods']['items']['x-ms-enum']['name'] = 'CorsRuleAllowedMethodsItem'\n  - from: diskRPCommon.json\n    where: \"$.definitions.PurchasePlan\"\n    transform: >\n      $[\"x-ms-client-name\"] = \"DiskPurchasePlan\";\n  - from: swagger-document\n    where: $.paths..parameters[?(@.name == \"x\")].pattern\n    set: abc\n```\n\n``` yaml $(python)\ndirective:\n  - where: $.definitions.Other\n    transform: $['a'] = 'b'\n```\n"

test "readme.go.md assignments are read and applied; other directives are reported" {
  let ds = go_directives(README_GO)?
  expect(ds.assigns.len()) == 2
  expect(ds.assigns[1].from) == "diskRPCommon.json"
  expect(ds.assigns[1].keys) == ["x-ms-client-name"]
  expect(ds.assigns[0].definition) == "CorsRule"
  expect(ds.assigns[0].keys) == ["properties", "allowedMethods", "items", "x-ms-enum", "name"]
  expect(ds.skipped) == ["$.paths..parameters[?(@.name == \"x\")].pattern"]
  let doc = json.parse_value("{\"definitions\":{\"CorsRule\":{\"properties\":{\"allowedMethods\":{\"items\":{\"x-ms-enum\":{\"name\":\"AllowedMethods\"}}}}}}}")?
  let (out, n) = apply(doc, "x/common.json", ds.assigns)
  expect(n) == 1
  let pp = json.parse_value("{\"definitions\":{\"PurchasePlan\":{}}}")?
  expect(apply(pp, "a/diskRPCommon.json", ds.assigns).1) == 1
  expect(apply(pp, "a/other.json", ds.assigns).1) == 0
  expect(out.encode()) == "{\"definitions\":{\"CorsRule\":{\"properties\":{\"allowedMethods\":{\"items\":{\"x-ms-enum\":{\"name\":\"CorsRuleAllowedMethodsItem\"}}}}}}}"
}
