use std/json

const CLIENT: Str = "@@clientName(KeyVault, \"Client\", \"go\");\n@@clientName(getSecrets, \"ListSecretProperties\", \"go\");\n@@clientName(SecretBundle, \"Secret\", \"go\");\n@@clientName(SecretBundle, \"SecretBundleRust\", \"rust\");\n@@clientName(DeletedSecretListResult,\n  \"DeletedSecretPropertiesListResult\",\n  \"go\"\n);\n@@clientName(SecretBundle.kid, \"KID\", \"go\");\n"
const ROUTES: Str = "op getSecret is KeyVaultOperation<\n  {\n    /**\n     * The name.\n     */\n    @pattern(\"^[0-9a-zA-Z-]+$\")\n    @path(\"secret-name\")\n    @clientName(\"name\", \"go\")\n    secretName: string;\n    @path(\"secret-version\")\n    @clientName(\"version\", \"go\")\n    secretVersion: string;\n  }, SecretBundle>;\n"

test "Go renames come from @@clientName statements and parameter decorators" {
  let r = renames([CLIENT, ROUTES])?
  expect(r.ops.get("getsecrets")) == Some("ListSecretProperties")
  expect(r.models.get("SecretBundle")) == Some("Secret")
  expect(r.models.get("DeletedSecretListResult")) == Some("DeletedSecretPropertiesListResult")
  expect(r.models.get("KeyVault")) == Some("Client")
  expect(r.fields.get("SecretBundle.kid")) == Some("KID")
  expect(r.params.get("secret-name")) == Some("name")
  expect(r.params.get("secret-version")) == Some("version")
}

const QUALIFIED: Str = "namespace Customizations;\n@@clientName(KeyVault.updateSecret, \"UpdateSecretProperties\", \"go\");\n@@clientName(KeyVault.SecretBundle.kid, \"KID\", \"go\");\n@@clientName(Other.thing, \"Thing\", \"go\");\n"
const NAMESPACE: Str = "import \"./models.tsp\";\n\nnamespace KeyVault;\n"

test "a target qualified by a project namespace is read without it" {
  let r = renames([QUALIFIED, NAMESPACE])?
  expect(r.ops.get("updatesecret")) == Some("UpdateSecretProperties")
  expect(r.fields.get("SecretBundle.kid")) == Some("KID")
  expect(r.fields.get("Other.thing")) == Some("Thing")
  expect(r.ops.get("thing")) == None
}

const README: Str = "### Tag: package-2024-01\n\n```yaml $(tag) == 'package-2024-01'\ninput-file:\n  - Microsoft.Storage/stable/2024-01-01/blob.json\n  - Microsoft.Storage/stable/2024-01-01/common.json\n\ndirective:\n  - suppress: R1\n```\n\n``` yaml $(tag) == 'package-2023-05'\ninput-file:\n  - Microsoft.Storage/stable/2023-05-01/storage.json\n```\n"

test "a readme tag's input files, whatever the fence spacing" {
  expect(input_files(README, "package-2024-01")?) == ["Microsoft.Storage/stable/2024-01-01/blob.json", "Microsoft.Storage/stable/2024-01-01/common.json"]
  expect(input_files(README, "package-2023-05")?) == ["Microsoft.Storage/stable/2023-05-01/storage.json"]
}

const README_GO: Str = "## Go\n\n```yaml $(go) && !$(track2)\ndirective:\n  - where: $.definitions.Track1\n    transform: $['a'] = 'b'\n```\n\n``` yaml $(go) && $(track2)\nlicense-header: MICROSOFT_MIT_NO_VERSION\ndirective:\n  - from: swagger-document\n    where: $.definitions.CorsRule\n    transform: $['properties']['allowedMethods']['items']['x-ms-enum']['name'] = 'CorsRuleAllowedMethodsItem'\n  - from: diskRPCommon.json\n    where: \"$.definitions.PurchasePlan\"\n    transform: >\n      $[\"x-ms-client-name\"] = \"DiskPurchasePlan\";\n  - from: swagger-document\n    where: $.paths..parameters[?(@.name == \"x\")].pattern\n    set: abc\n```\n\n``` yaml $(python)\ndirective:\n  - where: $.definitions.Other\n    transform: $['a'] = 'b'\n```\n"

test "readme.go.md assignments are read and applied; other directives are reported" {
  let ds = go_directives(README_GO)?
  expect(ds.assigns.len()) == 2
  expect(ds.assigns[1].from) == "diskRPCommon.json"
  expect(ds.assigns[1].keys) == ["x-ms-client-name"]
  expect(ds.assigns[0].definition) == "CorsRule"
  expect(ds.assigns[0].keys) == ["properties", "allowedMethods", "items", "x-ms-enum", "name"]
  expect(ds.skipped) == ["$.paths..parameters[?(@.name == \"x\")].pattern"]
  let doc = json.parse_value("{\"definitions\":{\"CorsRule\":{\"properties\":{\"allowedMethods\":{\"items\":{\"x-ms-enum\":{\"name\":\"AllowedMethods\"}}}}}}}")?
  let (out, n) = apply(doc, "x/common.json", ds.assigns)
  expect(n) == 1
  let pp = json.parse_value("{\"definitions\":{\"PurchasePlan\":{}}}")?
  expect(apply(pp, "a/diskRPCommon.json", ds.assigns).1) == 1
  expect(apply(pp, "a/other.json", ds.assigns).1) == 0
  expect(out.encode()) == "{\"definitions\":{\"CorsRule\":{\"properties\":{\"allowedMethods\":{\"items\":{\"x-ms-enum\":{\"name\":\"CorsRuleAllowedMethodsItem\"}}}}}}}"
}

test "rename-model renames a definition and every $ref to it; rename-property renames the key" {
  let ds = go_directives("``` yaml $(go) && $(track2)\ndirective:\n- rename-model:\n    from: ExplicitProxy\n    to: ExplicitProxySettings\n- where-model: Policy\n  rename-property:\n    from: explicitProxy\n    to: explicitProxySettings\n```\n")?
  expect(ds.renames.len()) == 2
  let doc = json.parse_value("{\"definitions\":{\"ExplicitProxy\":{\"type\":\"object\"},\"Policy\":{\"required\":[\"explicitProxy\"],\"properties\":{\"explicitProxy\":{\"$ref\":\"#/definitions/ExplicitProxy\"}}}}}")?
  let (d, n) = apply_renames(doc, ds.renames)
  expect(n) == 2
  expect(d.encode()) == "{\"definitions\":{\"ExplicitProxySettings\":{\"type\":\"object\"},\"Policy\":{\"required\":[\"explicitProxySettings\"],\"properties\":{\"explicitProxySettings\":{\"$ref\":\"#/definitions/ExplicitProxySettings\"}}}}}"
}

test "rename-operation and an operationId prefix replace rename operations" {
  let ds = go_directives("``` yaml $(go) && $(track2)\ndirective:\n- rename-operation:\n    from: OperationResults_Get\n    to: AssetTrackOperationResults_Get\n- from: swagger-document\n  where: '$.paths.*[?(@.operationId.startsWith(\"OperationStatuses_\"))]'\n  transform: >\n    $[\"operationId\"] = $[\"operationId\"].replace(\"OperationStatuses_\", \"PrivateEndpointConnectionsOperationStatuses_\")\n```\n")?
  expect(ds.op_renames.len()) == 2
  expect(ds.skipped) == []
  let doc = json.parse_value("{\"paths\":{\"/a\":{\"get\":{\"operationId\":\"OperationResults_Get\"}},\"/b\":{\"get\":{\"operationId\":\"OperationStatuses_Get\"},\"put\":{\"operationId\":\"Other_Put\"}},\"/c\":{\"get\":{\"operationId\":\"MediaServicesOperationResults_Get\"}}}}")?
  let (d, n) = apply_op_renames(doc, ds.op_renames)
  expect(n) == 2
  expect(d.encode()) == "{\"paths\":{\"/a\":{\"get\":{\"operationId\":\"AssetTrackOperationResults_Get\"}},\"/b\":{\"get\":{\"operationId\":\"PrivateEndpointConnectionsOperationStatuses_Get\"},\"put\":{\"operationId\":\"Other_Put\"}},\"/c\":{\"get\":{\"operationId\":\"MediaServicesOperationResults_Get\"}}}}"
}

test "where-operation replaces an operation's parameter" {
  let ds = go_directives("``` yaml $(go) && $(track2)\ndirective:\n  - where-operation: V_GetBySubscription\n    transform: >\n      $.parameters[1] = {\n        \"name\": \"subscriptionId\",\n        \"in\": \"path\",\n        \"required\": true,\n        \"type\": \"string\"\n      };\n```\n")?
  expect(ds.op_params.len()) == 1
  expect(ds.skipped) == []
  let doc = json.parse_value("{\"paths\":{\"/a\":{\"get\":{\"operationId\":\"V_GetBySubscription\",\"parameters\":[{\"name\":\"v\"},{\"$ref\":\"#/parameters/S\"}]}},\"/b\":{\"get\":{\"operationId\":\"V_Get\",\"parameters\":[{\"name\":\"v\"},{\"$ref\":\"#/parameters/S\"}]}}}}")?
  let (d, n) = apply_op_params(doc, ds.op_params)
  expect(n) == 1
  expect(d.encode()) == "{\"paths\":{\"/a\":{\"get\":{\"operationId\":\"V_GetBySubscription\",\"parameters\":[{\"name\":\"v\"},{\"name\":\"subscriptionId\",\"in\":\"path\",\"required\":true,\"type\":\"string\"}]}},\"/b\":{\"get\":{\"operationId\":\"V_Get\",\"parameters\":[{\"name\":\"v\"},{\"$ref\":\"#/parameters/S\"}]}}}}"
}

test "readme.md's directives apply for the row's tag only" {
  let readme = "``` yaml $(tag) == 'package-b'\ndirective:\n  - where: \"$.definitions.Resource\"\n    transform: >\n      $[\"x-ms-client-name\"] = \"PerimeterResource\"\n```\n\n``` yaml $(tag) == 'package-a'\ndirective:\n  - where: \"$.definitions.Other\"\n    transform: >\n      $[\"x-ms-client-name\"] = \"X\"\n```\n\n``` yaml\ndirective:\n  - suppress: R4009\n```\n"
  let ds = tag_directives(readme, "package-b")?
  expect(ds.assigns.map(fn(a: Assign) -> Str { a.definition })) == ["Resource"]
  expect(ds.skipped) == []
}

const ARM_OPS: Str = "namespace Microsoft.Compute;\n\n@armResourceOperations\ninterface SharedGalleryInvites {\n  @added(Versions.v2026_03_03)\n  @operationId(\"GallerySharing_Accept\")\n  gallerySharingAccept is ArmResourceActionAsync<Gallery, Invite, Gallery>;\n  @operationId(\"SharedGalleries_Get\")\n  get is ArmResourceRead<Gallery>;\n}\n"
const ARM_FINAL: Str = "namespace Microsoft.Storage {\n  @armResourceOperations\n  interface StorageTaskAssignments {\n    /**\n     * Create.\n     */\n    @put\n    @Azure.Core.useFinalStateVia(\"azure-async-operation\")\n    create is ArmResourceCreateOrReplaceAsync<StorageTaskAssignment>;\n    @useFinalStateVia(\"location\")\n    @operationId(\"StorageTaskAssignments_Remove\")\n    delete is ArmResourceDeleteWithoutOkAsync<StorageTaskAssignment>;\n    list is ArmResourceListByParent<StorageTaskAssignment>;\n  }\n}\n"

test "an @added operation whose operationId is not its interface's is named by the interface" {
  let r = renames([ARM_OPS])?
  expect(r.tsp_ops.get("gallerysharing_accept")) == Some(("SharedGalleryInvites", "gallerySharingAccept"))
  expect(r.tsp_ops.get("sharedgalleries_get")) == None
}

test "a final state comes from @useFinalStateVia, qualified or not, in an indented interface" {
  let r = renames([ARM_FINAL])?
  expect(r.final_states.get("storagetaskassignments_create")) == Some("azure-async-operation")
  expect(r.final_states.get("storagetaskassignments_remove")) == Some("location")
  expect(r.final_states.get("storagetaskassignments_list")) == None
}

const ARM_LOC: Str = "namespace Microsoft.Network;\ninterface CheckDnsNameAvailability {\n  @operationId(\"CheckDnsNameAvailability\")\n  checkDnsNameAvailability is ArmProviderActionSync<Result>;\n}\ninterface VirtualWans {\n  supportedSecurityProviders is ArmResourceActionSync<VirtualWAN, void, Providers>;\n}\ninterface ExpressRouteCircuits {\n  stopCircuitLinkFailoverTest is ArmResourceActionAsync<\n    ExpressRouteCircuit,\n    {\n      /** Parameters supplied to stop the test. */\n      @bodyRoot stopParameters: ExpressRouteLinkFailoverStopApiParameters;\n    },\n    Result\n  >;\n}\n"
const CLIENT_LOC: Str = "@@clientLocation(\n  CheckDnsNameAvailability.checkDnsNameAvailability,\n  \"ManagementClient\",\n  \"go\"\n);\n@@clientLocation(VirtualWans.supportedSecurityProviders, \"ManagementClient\", \"go\");\n@@clientLocation(VirtualWans.supportedSecurityProviders, CombineClient, \"java\");\n"

test "@@clientLocation for Go moves an operation to another client, keeping its operationId's name" {
  let r = renames([ARM_LOC, CLIENT_LOC])?
  expect(r.tsp_ops.get("checkdnsnameavailability")) == Some(("Management", "CheckDnsNameAvailability"))
  expect(r.tsp_ops.get("virtualwans_supportedsecurityproviders")) == Some(("Management", "SupportedSecurityProviders"))
}

test "an action's inline @bodyRoot request is Go's unused <Op>ParameterBody" {
  let r = renames([ARM_LOC])?
  expect(r.body_roots) == [("StopCircuitLinkFailoverTestParameterBody", "stopParameters", "ExpressRouteLinkFailoverStopApiParameters", "Parameters supplied to stop the test.")]
}

test "patches set, delete, push and copy at JSON pointers" {
  let doc = json.parse_value("{\"paths\":{\"/a/{b}\":{\"get\":{\"parameters\":[1,2,3,4],\"responses\":{\"201\":{\"d\":1}}}}},\"x\":{}}").or_fault("doc")
  let ps = [
    Patch{pointer: "/paths/~1a~1{b}/get/parameters/3", op: "delete"},
    Patch{pointer: "/paths/~1a~1{b}/get/parameters", op: "push", value: "{\"name\":\"orderby\"}"},
    Patch{pointer: "/paths/~1a~1{b}/get/responses/202", op: "copy", from: "/paths/~1a~1{b}/get/responses/201"},
    Patch{pointer: "/x/required", op: "set", value: "true"},
    Patch{pointer: "/nothing/here", op: "delete"},
    Patch{pointer: "/x/y", op: "set", value: "1", file: "other.json"},
  ]
  let (d, missed) = apply_patches(doc, "dir/spec.json", ps).or_fault("apply")
  expect(d.encode()) == "{\"paths\":{\"/a/{b}\":{\"get\":{\"parameters\":[1,2,3,{\"name\":\"orderby\"}],\"responses\":{\"201\":{\"d\":1},\"202\":{\"d\":1}}}}},\"x\":{\"required\":true}}"
  expect(missed) == ["delete /nothing/here"]
}

test "@@override for go: the custom operation's path parameter order" {
  let main = "interface Defs {\n  @operationId(\"SqlResources_GetSqlRoleDefinition\")\n  getSqlRoleDefinition is ArmResourceRead<D>;\n}\n"
  let client = "op getCustomized(\n  ...Azure.ResourceManager.ApiVersionParameter,\n  ...Azure.ResourceManager.SubscriptionIdParameter,\n  ...Azure.ResourceManager.Legacy.Provider,\n\n  #suppress \"x\" \"y\"\n  @path\n  roleDefinitionId: string,\n\n  ...Azure.ResourceManager.ResourceGroupParameter,\n\n  @path\n  @pattern(\"^[a-z]+$\")\n  accountName: string,\n): ArmResponse<D>;\n\n@@override(Defs.getSqlRoleDefinition, getCustomized, \"go,java\");\n@@override(Defs.other, getCustomized, \"java\");\n"
  let r = renames([main, client]) ?? e => fault(e)
  expect(r.param_order.get("sqlresources_getsqlroledefinition")) == Some(["subscriptionId", "roleDefinitionId", "resourceGroupName", "accountName"])
  expect(r.param_order.len()) == 1
}

test "@@override for go keyed by an unscoped @@clientLocation's operationId" {
  let ops = "interface DefsGroup {\n  getDef is ArmResourceRead<D>;\n}\n@@clientLocation(\n  DefsGroup.getDef,\n  SqlResources\n);\n"
  let client = "op getCustomized(\n  ...Azure.ResourceManager.SubscriptionIdParameter,\n  @path\n  defId: string,\n  ...Azure.ResourceManager.ResourceGroupParameter,\n): ArmResponse<D>;\n@@override(DefsGroup.getDef, getCustomized, \"go\");\n"
  let r = renames([ops, client]) ?? e => fault(e)
  expect(r.param_order.get("sqlresources_getdef")) == Some(["subscriptionId", "defId", "resourceGroupName"])
}

test "@@override keyed by a negation-scoped move, and of a namespace's own operation (armdatabox)" {
  let ops = "interface JobResources {\n  markDevicesShipped is ArmResourceActionSync<J, R, NoContentResponse>;\n}\n@@clientLocation(JobResources.markDevicesShipped, \"Jobs\", \"!csharp\");\n"
  let client = "op shipCustomized(\n  ...Azure.ResourceManager.SubscriptionIdParameter,\n  @path\n  jobName: string,\n  ...Azure.ResourceManager.ResourceGroupParameter,\n): NoContentResponse;\nop mitigateCustomized(\n  @path\n  jobName: string,\n  ...Azure.ResourceManager.ResourceGroupParameter,\n): NoContentResponse;\n@@override(JobResources.markDevicesShipped, shipCustomized);\n@@override(mitigate, mitigateCustomized);\n"
  let r = renames([ops, client]) ?? e => fault(e)
  expect(r.param_order.get("jobs_markdevicesshipped")) == Some(["subscriptionId", "jobName", "resourceGroupName"])
  expect(r.param_order.get("mitigate")) == Some(["jobName", "resourceGroupName"])
}

test "@@override's resource group spread by its bare or CommonTypes name (armappservice, armdataboxedge)" {
  let ops = "interface Users {\n  @operationId(\"Users_Get\")\n  get is ArmResourceRead<U>;\n  @operationId(\"Users_List\")\n  list is ArmResourceListByParent<U>;\n}\n"
  let client = "op getCustomized(\n  ...Azure.ResourceManager.CommonTypes.SubscriptionIdParameter,\n  @path\n  deviceName: string,\n  @path name: string,\n  ...Azure.ResourceManager.CommonTypes.ResourceGroupNameParameter,\n): U;\nop listCustomized(\n  ...ResourceGroupParameter,\n  @path\n  deviceName: string,\n): U;\n@@override(Users.get, getCustomized, \"python,go\");\n@@override(\n  Users.list,\n  listCustomized\n);\n"
  let r = renames([ops, client]) ?? e => fault(e)
  expect(r.param_order.get("users_get")) == Some(["subscriptionId", "deviceName", "name", "resourceGroupName"])
  expect(r.param_order.get("users_list")) == Some(["resourceGroupName", "deviceName"])
}

test "@@override by an interface's operation, its undecorated path property in order (armfrontdoor)" {
  let ops = "interface Profiles {\n  @operationId(\"NetworkExperimentProfiles_CreateOrUpdate\")\n  createOrUpdate is ArmResourceCreateOrReplaceAsync<Profile>;\n}\n"
  let client = "interface ProfilesOverrides {\n  /**\n   * override: x\n   */\n  replaceCreateOrUpdate(\n    ...ApiVersionParameter,\n    #suppress \"x\" \"y\"\n    profileName: string,\n    ...ResourceGroupParameter,\n    @query(\"q\")\n    q?: string,\n    parameters: Microsoft.Network.Profile,\n  ): ArmResourceUpdatedResponse<Profile>;\n}\n@@override(\n  Profiles.createOrUpdate,\n  ProfilesOverrides.replaceCreateOrUpdate,\n  \"go,javascript\"\n);\n"
  let r = renames([ops, client]) ?? e => fault(e)
  expect(r.param_order.get("networkexperimentprofiles_createorupdate")) == Some(["profileName", "resourceGroupName", "q", "parameters"])
}

test "a property @@clientLocation moves onto an override's operation is the method's (armmanagementgroups)" {
  let ops = "interface Subs {\n  @operationId(\"ManagementGroupSubscriptions_Create\")\n  create is ArmResourceCreateOrReplaceSync<S>;\n}\n"
  let client = "op putCustomized(\n  @path\n  groupId: string,\n  ...PutSubscriptionId,\n): S;\n@@override(Subs.create, putCustomized);\n@@clientLocation(PutSubscriptionId.subscriptionId, putCustomized);\n"
  let r = renames([ops, client]) ?? e => fault(e)
  expect(r.method_params) == ["managementgroupsubscriptions_create#subscriptionId"]
}

test "an unscoped @@clientLocation's group may be quoted (armnetwork)" {
  let ops = "interface TypesOperationGroup {\n  listByResourceGroup is ArmProviderActionSync<R>;\n}\n@@clientLocation(\n  TypesOperationGroup.listByResourceGroup,\n  \"AvailableTypes\"\n);\n"
  let client = "op customList(\n  @path\n  @segment(\"locations\")\n  location: string,\n\n  @path\n  @segment(\"resourceGroups\")\n  resourceGroupName: string,\n\n  ...ApiVersionParameter,\n): ArmResponse<R>;\n@@override(TypesOperationGroup.listByResourceGroup, customList, \"go,python,java\");\n"
  let r = renames([ops, client]) ?? e => fault(e)
  expect(r.param_order.get("availabletypes_listbyresourcegroup")) == Some(["location", "resourceGroupName"])
  // an unscoped @@clientName renames the operationId's operation part
  let renamed = renames([ops + "@@clientName(TypesOperationGroup.listByResourceGroup, \"List\");\n", client]) ?? e => fault(e)
  expect(renamed.param_order.get("availabletypes_list")) == Some(["location", "resourceGroupName"])
}

test "Go-scoped renames and moves of an operation (armappservice)" {
  let site = "interface WebApps {\n  @action(\"slotsswap\")\n  swapSlotSlot is ActionAsync<S>;\n}\n"
  let client = "@@clientName(WebApps.swapSlotSlot, \"swapSlot\", \"python,go\");\n@@clientName(WebApps.other, \"x\", \"python\");\n@@clientLocation(checkNameAvailability, \"WebSiteManagement\", \"go\");\n"
  let r = renames([site, client]) ?? e => fault(e)
  expect(r.ops.get("webapps_swapslotslot")) == Some("SwapSlot")
  expect(r.fields.get("WebApps.swapSlotSlot")) == None
  expect(r.tsp_ops.get("checknameavailability")) == Some(("WebSiteManagement", "CheckNameAvailability"))
}

test "a directive on $.parameters sets a shared parameter's key" {
  let ds = go_directives("``` yaml $(go) && $(track2)\ndirective:\n- from: swagger-document\n  where: $.parameters.ResourceGroupNameParameter\n  transform: >\n    $[\"x-ms-parameter-location\"] = \"method\"; \n```\n")?
  expect(ds.skipped) == []
  expect(ds.assigns[0].section) == "parameters"
  let doc = json.parse_value("{\"parameters\":{\"ResourceGroupNameParameter\":{\"name\":\"resourceGroupName\",\"x-ms-parameter-location\":\"client\"}}}")?
  let (out, n) = apply(doc, "a/x.json", ds.assigns)
  expect(n) == 1
  expect(out.encode()) == "{\"parameters\":{\"ResourceGroupNameParameter\":{\"name\":\"resourceGroupName\",\"x-ms-parameter-location\":\"method\"}}}"
}

test "@@clientInitialization parameters are Go's client parameters (armalertsmanagement)" {
  let client = "model AlertsClientOptions {\n  #suppress \"x\" \"y\"\n  scope: string;\n}\n\n@@Azure.ClientGenerator.Core.clientInitialization(Microsoft.AlertsManagement,\n  {\n    parameters: AlertsClientOptions,\n  },\n  \"!(python,java)\"\n);\n"
  let r = renames([client]) ?? e => fault(e)
  expect(r.client_params) == ["scope"]
  // excluded for Go
  let not_go = renames([client.replace("!(python,java)", "!(go,java)")]) ?? e => fault(e)
  expect(not_go.client_params) == []
}

test "an ARM action re-declared in a Go @operationGroup is routed by its new name (armchaos)" {
  let main = "namespace Microsoft.Chaos;\n\ninterface ExperimentExecutions {\n  @operationId(\"Experiments_ExecutionDetails\")\n  getExecutionDetails is ArmResourceActionSync<\n    ExperimentExecution,\n    void,\n    D\n  >;\n  @action(\"start\")\n  begin is ArmResourceActionAsync<E, void, void>;\n}\n"
  let client = "@operationGroup(\"java,go,javascript\")\n@armResourceOperations\ninterface Experiments {\n  executionDetails is Microsoft.Chaos.ExperimentExecutions.getExecutionDetails;\n  started is Microsoft.Chaos.ExperimentExecutions.begin;\n}\n"
  let r = renames([main, client]) ?? e => fault(e)
  expect(r.action_routes.get("experiments_executiondetails")) == Some(("getExecutionDetails", "executionDetails"))
  // an @action route keeps its name
  expect(r.action_routes.len()) == 1
}

test "ArmResourcePatch's body is the resource (armcommvaultcontentstore)" {
  let main = "namespace Commvault.ContentStore;\n\n@armResourceOperations\ninterface CloudAccounts {\n  update is ArmResourcePatchAsync<CloudAccount, CloudAccountProperties>;\n  other is ArmCustomPatchAsync<CloudAccount, CloudAccountPatch>;\n}\n"
  let r = renames([main]) ?? e => fault(e)
  expect(r.patch_bodies.get("cloudaccounts_update")) == Some("CloudAccount")
  expect(r.patch_bodies.len()) == 1
}

test "@@segment on ResourceGroupParameter is Go's resource group segment; written routes keep theirs (armmonitor)" {
  let compat = "@@TypeSpec.Rest.segment(\n  Azure.ResourceManager.ResourceGroupParameter.resourceGroupName,\n  \"resourcegroups\"\n);\n"
  let main = "interface A {\n  @get\n  @route(\"/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.Insights/x/{n}\")\n  g is Op;\n}\nalias O = Legacy.RoutedOperations<P, Q, ResourceRoute = #{\n    route: \"/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/microsoft.Insights/y/{m}\",\n  }\n>;\n"
  let r = renames([compat, main]) ?? e => fault(e)
  expect(r.rg_segment) == "resourcegroups"
  expect(r.routes.len()) == 2
  let none = renames([main]) ?? e => fault(e)
  expect(none.rg_segment) == ""
}

test "a template interface's ArmResourcePatch body is the extending interface's resource (armdiscovery)" {
  let shared = "interface DiscoveryResource<\n  T extends Azure.ResourceManager.Foundations.TrackedResource,\n  P extends {},\n  L extends {} = T\n> {\n  get is ArmResourceRead<T>;\n  update is ArmResourcePatchAsync<T, P>;\n}\n"
  let tool = "@armResourceOperations\ninterface Tools extends DiscoveryResource<Tool, ToolProperties> {}\n"
  let r = renames([tool, shared]) ?? e => fault(e)
  expect(r.patch_bodies.get("tools_update")) == Some("Tool")
  expect(r.patch_bodies.len()) == 1
}

test "a negation-scoped @@clientName names the overridden operation's operationId (armguestconfiguration)" {
  let main = "namespace Microsoft.GuestConfiguration;\ninterface GuestConfigurationAssignments {\n  reportsGet is Ops.ActionSync<A, void>;\n}\n"
  let client = "@@clientLocation(\n  GuestConfigurationAssignments.reportsGet,\n  \"GuestConfigurationAssignmentReports\"\n);\n@@clientName(\n  GuestConfigurationAssignments.reportsGet,\n  \"Get\",\n  \"!csharp\"\n);\nop reportsGetCustomized(\n  ...Azure.ResourceManager.ResourceGroupParameter,\n  @path\n  assignmentName: string,\n  @path\n  @pattern(\"^[a-z]$\")\n  vmName: string,\n): void;\n@@override(\n  GuestConfigurationAssignments.reportsGet,\n  reportsGetCustomized\n);\n"
  let r = renames([main, client]) ?? e => fault(e)
  expect(r.param_order.get("guestconfigurationassignmentreports_get")) == Some(["resourceGroupName", "assignmentName", "vmName"])
}

test "an override's model parameter of @path properties is Go's parameter group; a qualified @@override counts (armsecurity)" {
  let main = "namespace Microsoft.Security;\ninterface PrivateLinks {\n  get is ArmResourceRead<PrivateLinkResource>;\n}\n"
  let client = "model `private-link-parameters` {\n  /**\n   * The name.\n   */\n  @path\n  @minLength(3)\n  @pattern(\"^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\\$\")\n  privateLinkName: string;\n}\nop privateLinksGetCustomization(\n  ...ApiVersionParameter,\n  ...ResourceGroupParameter,\n  @query\n  privateLinkName: `private-link-parameters`,\n): ArmResponse<PrivateLinkResource>;\n@@Azure.ClientGenerator.Core.override(\n  PrivateLinks.get,\n  privateLinksGetCustomization,\n  \"!python,!java\"\n);\n"
  let r = renames([main, client]) ?? e => fault(e)
  expect(r.param_order.get("privatelinks_get")) == Some(["resourceGroupName", "privateLinkName"])
  expect(r.param_groups.get("privatelinks_get")) == Some([("privateLinkName", "PrivateLinkParameters", ["privateLinkName"])])
}

test "a response header's property names Go's field (armstoragesync's XMSRequestID)" {
  let text = "model R {\n  @header(\"x-ms-request-id\")\n  @doc(\"request id.\")\n  xMsRequestId?: string;\n  @header(\"Retry-After\") retryAfter?: int32;\n}\n"
  let r = renames([text]) ?? e => fault(e)
  expect(r.header_props.get("x-ms-request-id")) == Some("xMsRequestId")
  expect(r.header_props.get("retry-after")) == Some("retryAfter")
  let renamed = renames(["model CustomErrorResponse {\n  @header(\"x-ms-request-id\")\n  requestId?: string;\n}\nalias RequestIdResponseHeader = {\n  @header(\"x-ms-request-id\")\n  requestId?: string;\n};\n@@clientName(RequestIdResponseHeader.requestId, \"xMsRequestId\", \"java,go\");\n"]) ?? e => fault(e)
  expect(renamed.header_props.get("x-ms-request-id")) == Some("xMsRequestId")
}

test "@@Legacy.nextLinkVerb sends a pageable operation's next link with its verb (armpanngfw)" {
  let main = "namespace PaloAltoNetworks.Cloudngfw;\ninterface LocalRulestackResources {\n  listAppIds is ArmResourceActionSync<LocalRulestackResource, void, ListAppIdResponse>;\n}\n"
  let client = "@@Legacy.nextLinkVerb(LocalRulestackResources.listAppIds, \"POST\");\n"
  let r = renames([main, client]) ?? e => fault(e)
  expect(r.next_verbs.get("localrulestackresources_listappids")) == Some("POST")
}

test "an operation a negation-scoped @@clientLocation puts in a namespace has a bare operationId (armrecoveryservicesbackup)" {
  let main = "namespace Microsoft.RecoveryServices;\ninterface StorageConfigs {\n  @action(\"prepareDataMove\")\n  bmsPrepareDataMove is ArmResourceActionAsync<R, P, void>;\n}\n"
  let client = "@@clientName(StorageConfigs.bmsPrepareDataMove, \"BMSPrepareDataMove\");\n@@clientLocation(\n  StorageConfigs.bmsPrepareDataMove,\n  Microsoft.RecoveryServices,\n  \"!csharp,!go\"\n);\nop prepareCustom(\n  @path vaultName: string,\n  ...ResourceGroupParameter,\n  body: P,\n): void;\n@@override(StorageConfigs.bmsPrepareDataMove, prepareCustom, \"go\");\n"
  let r = renames([main, client]) ?? e => fault(e)
  expect(r.param_order.get("bmspreparedatamove")) == Some(["vaultName", "resourceGroupName", "body"])
}

test "a response's @header contentType is Go's ContentType field (armpeering)" {
  let text = "namespace Microsoft.Peering;\n@autoRoute\nop checkServiceProviderAvailability is ArmProviderActionSync<\n  Request = In,\n  Response = {\n    @header contentType: \"application/json\";\n    @body body: Out;\n  },\n  Scope = SubscriptionActionScope\n>;\ninterface Peerings {\n  get is ArmResourceRead<Peering>;\n}\n"
  let r = renames([text]) ?? e => fault(e)
  expect(r.content_type_ops) == ["checkserviceprovideravailability"]
}

test "@@alternateType of a library model's property, to a model, for Go (armmonitor)" {
  let client = "@@alternateType(\n  Azure.ResourceManager.CommonTypes.AccessRuleProperties.subscriptions,\n  AccessRulePropertiesSubscriptionsItem[],\n  \"csharp\"\n);\n@@alternateType(\n  Azure.ResourceManager.CommonTypes.AccessRuleProperties.subscriptions,\n  AccessRulePropertiesSubscriptionsItem,\n  \"go\"\n);\n"
  let r = renames([client]) ?? e => fault(e)
  expect(r.field_types.get("AccessRuleProperties.subscriptions")) == Some("AccessRulePropertiesSubscriptionsItem")
}

test "an ArmProviderAction operation, by its moved operationId (armmonitor)" {
  let routes = "namespace AlertRulesIncidentsApi;\ninterface AlertRuleIncidentsOperationGroup {\n  @autoRoute\n  @get\n  @list\n  listByAlertRule is ArmProviderActionSync<\n    Response = IncidentListResult,\n    Scope = Extension.ResourceGroup\n  >;\n}\n"
  let compat = "@@clientLocation(\n  AlertRuleIncidentsOperationGroup.listByAlertRule,\n  \"AlertRuleIncidents\"\n);\n"
  let r = renames([routes, compat]) ?? e => fault(e)
  expect(r.provider_action_ops) == ["alertruleincidents_listbyalertrule"]
  expect(r.content_type_ops) == []
}

test "a subscriptionId moved onto an @@override operation, in its order (armpolicyinsights)" {
  let client = "op policyEventsListForRg(\n  ...ApiVersionParameter,\n\n  @path\n  @segment(\"policyEvents\")\n  policyEventsResource: PolicyEventsResourceType,\n\n  ...SubscriptionIdParameter,\n  ...ResourceGroupParameter,\n): R;\n@@override(\n  PolicyEventsOperationGroup.listQueryResultsForResourceGroup,\n  policyEventsListForRg,\n  \"!java,!python\"\n);\n@@clientLocation(\n  policyEventsListForRg::parameters.subscriptionId,\n  policyEventsListForRg\n);\n@@clientLocation(PolicyEventsOperationGroup.listQueryResultsForResourceGroup, \"PolicyEvents\");\n"
  let ops = "interface PolicyEventsOperationGroup {\n  @list\n  listQueryResultsForResourceGroup(...ApiVersionParameter): R;\n}\n"
  let r = renames([client, ops]) ?? e => fault(e)
  expect(r.method_params) == ["policyevents_listqueryresultsforresourcegroup#subscriptionId"]
  expect(r.param_order.get("policyevents_listqueryresultsforresourcegroup")) == Some(["policyEventsResource", "subscriptionId", "resourceGroupName"])
}

test "a subscriptionId moved onto a namespace's operation or from a parameter model (armreservations)" {
  let client = "@@clientLocation(getAppliedReservationList, \"AzureReservationAPIClient\", \"go\");\n@@clientLocation(\n  Reservations.getAppliedReservationList::parameters.subscriptionId,\n  Reservations.getAppliedReservationList\n);\n@@clientLocation(\n  Quota.QuotaPutBaseParam.subscriptionId,\n  Quota.CurrentQuotaLimitBases.createOrUpdate\n);\n"
  let ops = "namespace Quota;\ninterface CurrentQuotaLimitBases {\n  @operationId(\"Quota_CreateOrUpdate\")\n  createOrUpdate is ArmResourceCreateOrReplaceAsync<CurrentQuotaLimitBase>;\n}\n"
  let r = renames([client, ops]) ?? e => fault(e)
  expect(r.method_params) == ["getappliedreservationlist#subscriptionId", "quota_createorupdate#subscriptionId"]
}
