// Go's client renames in a TypeSpec project (decision 0002): the
// `@@clientName(Target, "Name", "go")` statements of client.tsp and the
// `@clientName("name", "go")` decorators on parameters, read with
// regular expressions. Only the Go scope is read.

use std/regexp

pub struct Renames {
  /// operation (TypeSpec's name, lower case) to Go's name
  pub ops: Map[Str, Str] = {}
  /// `@@clientLocation(Iface.op::parameters.p, Iface.op)`: a client
  /// parameter Go takes on that operation's method instead
  /// (armsubscriptions' `Client.Get(ctx, subscriptionID, ...)`), as
  /// `operationid#wire`, lower case operationId.
  pub method_params: List[Str] = []
  /// `@@clientInitialization(Namespace, {parameters: Model}, scope)`
  /// for Go: Model's properties, which Go's clients take in their
  /// constructors (armalertsmanagement's `NewAlertsClient(scope, ...)`),
  /// by wire name.
  pub client_params: List[Str] = []
  /// `@@override(Iface.op, customOp, "go")`: the custom operation's path
  /// parameters in the order it declares them, which is Go's method's
  /// order (armcosmos' `GetSQLRoleDefinition(ctx, roleDefinitionID,
  /// resourceGroupName, accountName)`), by operationId, lower case.
  pub param_order: Map[Str, List[Str]] = {}
  /// model to Go's name
  pub models: Map[Str, Str] = {}
  /// `Model.property` to Go's field name
  pub fields: Map[Str, Str] = {}
  /// parameter wire name to Go's name
  pub params: Map[Str, Str] = {}
  /// A `@client({name: ...}, "go") interface` block: the operations it
  /// lists (OpenAPI operationId, lower case) to Go's operation name. An
  /// operation it does not list is not in Go's client.
  pub client_ops: Map[Str, Str] = {}
  /// `@@alternateType(Model.property, type, "go")`: `Model.property` to
  /// the Xo type (`string` is Str).
  pub field_types: Map[Str, Str] = {}
  /// `@alternateType(Type, "go")` on a parameter: its wire name to Type.
  pub param_types: Map[Str, Str] = {}
  /// `@@alternateType(Azure.X.Model, Project.Model, "go")`: a library
  /// model (by its name) to the project's model that Go uses in its place.
  pub model_types: Map[Str, Str] = {}
  /// An operation added after the move to TypeSpec (`@added`) whose
  /// `@operationId` is not its TypeSpec name
  /// (`@operationId("GallerySharing_Accept")` on
  /// `SharedGalleryInvites.gallerySharingAccept`): the operationId, lower
  /// case, to the interface and the operation, as Go's emitter names it.
  pub tsp_ops: Map[Str, (Str, Str)] = {}
  /// A model rename whose target names the project namespace
  /// (`Compute.NetworkAccessPolicy`), keyed `namespace#Model`: in a
  /// project of several namespaces, each emitted to its own file, it is
  /// that file's model only (ComputeDisk's NetworkAccessPolicy keeps its
  /// name).
  pub ns_models: Map[Str, Str] = {}
  /// `@useFinalStateVia("x")` on an operation: its operationId (lower
  /// case) to x. Go's emitter sets a poller's final state from it alone,
  /// not from the OpenAPI file's final-state-via.
  pub final_states: Map[Str, Str] = {}
  /// An ARM action whose request is an inline `{ @bodyRoot x: T; }`
  /// (armnetwork's stopCircuitLinkFailoverTest): Go's emitter also
  /// writes that model, unused, as `<Op>ParameterBody`. Each is (model
  /// name, field, field type, field documentation).
  pub body_roots: List[(Str, Str, Str, Str)] = []
  /// A property renamed for other emitters but not Go (`"!go, !csharp"`),
  /// which the OpenAPI file carries as x-ms-client-name: `Model.name`
  /// (that client name) to the property's own name, Go's.
  pub not_go_fields: Map[Str, Str] = {}
  /// An ARM action re-declared under another name in a Go
  /// `@operationGroup` interface (`executionDetails is
  /// ExperimentExecutions.getExecutionDetails`), with no `@action`: Go's
  /// emitter routes it by the new name (armchaos'
  /// `.../executionDetails`, the OpenAPI file's `.../getExecutionDetails`).
  /// The operationId, lower case, to (the path's last segment, Go's).
  pub action_routes: Map[Str, (Str, Str)] = {}
  /// `op is ArmResourcePatchAsync<R, P>` (or Sync): Go's body is the
  /// resource R itself; the OpenAPI file has an `RUpdate` visibility
  /// variant (armcommvaultcontentstore). The operationId, lower case, to R.
  pub patch_bodies: Map[Str, Str] = {}
}

/// Each operation in an interface of `text` that carries decorator `dec`
/// (`@useFinalStateVia(`): its operationId (an `@operationId` among its
/// decorators, else `Interface_Op`) and the decorator's argument.
fn decorated(text: Str, dec: Str) -> List[(Str, Str)] {
  var out: List[(Str, Str)] = []
  let chunks = interface_chunks(text)
  for ci in 1..chunks.len() {
    let chunk = chunks[ci]
    let iface = ident_prefix(chunk)
    let parts = chunk.split(dec)
    for pi in 1..parts.len() {
      let part = parts[pi]
      let (q, rest) = part.cut(")") ?? continue
      let arg = q.trim().trim_prefix("\"").trim_suffix("\"")
      let prev = parts[pi - 1]
      var from = 0
      for (i, b) in prev.bytes().indexed() {
        if b == 0x3b || b == 0x7b {
          from = i + 1
        }
      }
      let before = prev[from..prev.len()]
      for line in rest.split("\n") {
        let l = line.trim()
        if l == "" || l.starts_with("@") || l.starts_with("#") || l.starts_with("//") || l.starts_with("*") || l.starts_with("/*") || l.starts_with(")") || l.starts_with("\"") {
          continue
        }
        let op = ident_prefix(l)
        let after = l[op.len()..l.len()].trim()
        if op != "" && (after.starts_with("is ") || after.starts_with("(")) {
          let decl = rest.find(l) ?? 0
          let span = before + rest[0..decl]
          let id = match span.cut("@operationId(") {
            Some((_, x)) => (x.cut(")").map(fn(p: (Str, Str)) -> Str { p.0 }) ?? "").trim().trim_prefix("\"").trim_suffix("\"")
            None => "${iface}_${op[0..1].to_upper()}${op[1..op.len()]}"
          }
          out.push((id, arg))
        }
        break
      }
    }
  }
  out
}

/// `text` split before each interface declaration (a line whose text
/// starts with `interface `, at any indentation), each chunk after the
/// first starting at the interface's name.
fn interface_chunks(text: Str) -> List[Str] {
  var out: List[Str] = [""]
  for line in text.split("\n") {
    let l = line.trim_start()
    if l.starts_with("interface ") {
      out.push(l[10..l.len()] + "\n")
    } else {
      let i = out.len() - 1
      out[i] = out[i] + line + "\n"
    }
  }
  out
}

/// The identifier `s` starts with (letters, digits and `_`).
fn ident_prefix(s: Str) -> Str {
  var n = 0
  for b in s.bytes() {
    if (b >= 0x61 && b <= 0x7a) || (b >= 0x41 && b <= 0x5a) || (b >= 0x30 && b <= 0x39) || b == 0x5f {
      n += 1
    } else {
      break
    }
  }
  s[0..n]
}

/// Each interface's operations that carry `@operationId`, from `text`:
/// (operationId, interface, operation, whether its decorators include
/// `@added`).
/// Every interface operation (`iface.op`, lower case) declared in
/// `text`, with an @operationId or not.
fn interface_ops(text: Str) -> List[Str] {
  var out: List[Str] = []
  let chunks = interface_chunks(text)
  for ci in 1..chunks.len() {
    let iface = ident_prefix(chunks[ci])
    for line in chunks[ci].split("\n") {
      let l = line.trim()
      let op = ident_prefix(l)
      if op != "" && op[0..1] >= "a" && op[0..1] <= "z" && l[op.len()..l.len()].trim().starts_with("is ") {
        out.push("${iface}.${op}".to_lower())
      }
    }
  }
  out
}

fn operation_ids(text: Str) -> List[(Str, Str, Str, Bool)] {
  var out: List[(Str, Str, Str, Bool)] = []
  let chunks = interface_chunks(text)
  for ci in 1..chunks.len() {
    let chunk = chunks[ci]
    let iface = ident_prefix(chunk)
    let parts = chunk.split("@operationId(")
    for pi in 1..parts.len() {
      let part = parts[pi]
      // the decorators before @operationId: after the previous
      // declaration's `;` or `{`
      let prev = parts[pi - 1]
      var from = 0
      for (i, b) in prev.bytes().indexed() {
        if b == 0x3b || b == 0x7b {
          from = i + 1
        }
      }
      let before = prev[from..prev.len()]
      let (q, rest) = part.cut(")") ?? continue
      let id = q.trim().trim_prefix("\"").trim_suffix("\"")
      // the declaration: the first line after it that is not a
      // decorator, a directive or a comment
      for line in rest.split("\n") {
        let l = line.trim()
        if l == "" || l.starts_with("@") || l.starts_with("#") || l.starts_with("//") || l.starts_with("*") || l.starts_with("/*") || l.starts_with(")") || l.starts_with("\"") {
          continue
        }
        let op = ident_prefix(l)
        let after = l[op.len()..l.len()].trim()
        if op != "" && (after.starts_with("is ") || after.starts_with("(")) {
          let decl = rest.find(l) ?? 0
          out.push((id, iface, op, before.contains("@added(") || rest[0..decl].contains("@added(")))
        }
        break
      }
    }
  }
  out
}

/// TypeSpec's scalar names as Xo types; a model or union keeps its name.
fn xo_type(t: Str) -> Str {
  match t {
    "string" => "Str"
    "boolean" => "Bool"
    "int32" => "Int"
    "int64" => "Int"
    "float32" => "Float32"
    "float64" => "Float"
    // Go's `any` (armdeploymentstacks' identifiers)
    "unknown" => "json.Value"
    "url" => "Str"
    _ => t
  }
}

/// `KeyVault.RoleDefinitions.delete` as its OpenAPI operationId,
/// `RoleDefinitions_Delete` (the namespace dropped, the operation's first
/// letter upper case, an interface its group).
fn operation_id(target: Str) -> Str {
  let parts = target.split(".")
  let rest = if parts.len() > 1 { parts[1..parts.len()] } else { parts }
  let op = rest.last() ?? ""
  let up = if op == "" { "" } else { op[0..1].to_upper() + op[1..op.len()] }
  if rest.len() > 1 { "${rest[0..rest.len() - 1].join("_")}_${up}" } else { up }
}

/// `target` without a leading `<namespace>.` from `namespaces` (the
/// longest one that matches).
fn strip_namespace(target: Str, namespaces: List[Str]) -> Str {
  var best = ""
  for n in namespaces {
    if target.starts_with("${n}.") && n.len() > best.len() {
      best = n
    }
  }
  if best == "" { target } else { target[best.len() + 1..target.len()] }
}

/// A decorator's scope (`"go"`, `"go, java"`, `"csharp,go"`, `"!csharp"`)
/// covers Go: Go is listed, or only negations are and Go's is not.
fn for_go(scope: Str) -> Bool {
  let parts = scope.split(",").map(fn(s: Str) -> Str { s.trim() }).filter(fn(s: Str) -> Bool { s != "" })
  if parts.contains("go") {
    return true
  }
  // `"!(python,java)"`: every emitter but those listed
  if scope.trim().starts_with("!(") {
    return !scope.trim().trim_prefix("!(").trim_suffix(")").split(",").any(fn(s: Str) -> Bool { s.trim() == "go" })
  }
  !parts.is_empty() && parts.all(fn(s: Str) -> Bool { s.starts_with("!") }) && !parts.contains("!go")
}

/// A dotted target naming a library type
/// (`Azure.ResourceManager.CommonTypes.Encryption`), not a property
/// (`Contact.EmailAddress`, whose property is capitalized too).
fn names_type(target: Str) -> Bool {
  if !target.starts_with("Azure.") && !target.starts_with("TypeSpec.") {
    return false
  }
  let last = target.split(".").last() ?? ""
  last != "" && last[0..1] >= "A" && last[0..1] <= "Z"
}

/// The Go renames in `texts` (the project's .tsp files).
pub fn renames(texts: List[Str]) -> Renames ! Str {
  let aug = regexp.compile("@@clientName\\(\\s*([A-Za-z0-9_.]+)\\s*,\\s*\"([^\"]+)\"\\s*,\\s*\"([^\"]*)\"\\s*\\)") ?? e => return Err(e.display())
  let inline = regexp.compile("(?:^|[^@])@clientName\\(\\s*\"([^\"]+)\"\\s*,\\s*\"([^\"]*)\"\\s*\\)") ?? e => return Err(e.display())
  let loc = regexp.compile("@(?:path|query|header)\\(\\s*\"([^\"]+)\"") ?? e => return Err(e.display())
  let bare_loc = regexp.compile("@(?:path|query)\\b(?:\\s*\\(\\s*\\))?[\\s\\S]*?([A-Za-z0-9_]+)\\??\\s*:\\s*[A-Za-z]") ?? e => return Err(e.display())
  let client = regexp.compile("@client\\(\\s*\\{[^}]*\\}\\s*(?:,\\s*\"([^\"]*)\"\\s*)?\\)\\s*interface\\s+[A-Za-z0-9_]+\\s*\\{([^}]*)\\}") ?? e => return Err(e.display())
  let member = regexp.compile("([A-Za-z0-9_]+)\\s+is\\s+([A-Za-z0-9_.]+)\\s*;") ?? e => return Err(e.display())
  let alt_field = regexp.compile("@@alternateType\\(\\s*([A-Za-z0-9_]+\\.[A-Za-z0-9_]+)\\s*,\\s*([A-Za-z0-9_]+)\\s*,\\s*\"([^\"]*)\"\\s*\\)") ?? e => return Err(e.display())
  let alt_param = regexp.compile("(?:^|[^@])@alternateType\\(\\s*([A-Za-z0-9_]+)\\s*,\\s*\"([^\"]*)\"\\s*\\)\\s*(?:@[A-Za-z]+(?:\\([^)]*\\))?\\s*)*([A-Za-z0-9_]+)\\??\\s*:") ?? e => return Err(e.display())
  let unscoped_loc = regexp.compile("@@clientLocation\\(\\s*([A-Za-z0-9_.]+)\\s*,\\s*\"?([A-Za-z0-9_]+)\"?\\s*,?\\s*\\)") ?? e => return Err(e.display())
  let override_re = regexp.compile("@@override\\(\\s*([A-Za-z0-9_.]+)\\s*,\\s*([A-Za-z0-9_]+)\\s*(?:,\\s*\"([^\"]*)\"\\s*)?\\)") ?? e => return Err(e.display())
  let param_loc = regexp.compile("@@clientLocation\\(\\s*([A-Za-z0-9_.]+)::parameters\\.([A-Za-z0-9_]+)\\s*,\\s*([A-Za-z0-9_.]+)\\s*(?:,\\s*\"([^\"]*)\"\\s*)?\\)") ?? e => return Err(e.display())
  let client_loc = regexp.compile("@@clientLocation\\(\\s*([A-Za-z0-9_.]+)\\s*,\\s*(?:\"([^\"]+)\"|([A-Za-z0-9_.]+))\\s*,\\s*\"([^\"]*)\"\\s*\\)") ?? e => return Err(e.display())
  let body_root = regexp.compile("([A-Za-z0-9_]+)\\s+is\\s+ArmResourceAction[A-Za-z]*<\\s*[A-Za-z0-9_.]+\\s*,\\s*\\{\\s*(?:/\\*\\*([^*]*)\\*/\\s*)?@bodyRoot\\s+([A-Za-z0-9_]+)\\s*:\\s*([A-Za-z0-9_.]+)\\s*;\\s*\\}") ?? e => return Err(e.display())
  let alt_model = regexp.compile("@@alternateType\\(\\s*(Azure\\.[A-Za-z0-9_.]+)\\s*,\\s*([A-Za-z0-9_.]+)\\s*,\\s*\"([^\"]*)\"\\s*\\)") ?? e => return Err(e.display())
  // `@@clientName(T, "Name")` with no scope: the name every emitter,
  // the OpenAPI one too, gives T
  let unscoped = regexp.compile("@@clientName\\(\\s*([A-Za-z0-9_.]+)\\s*,\\s*\"([^\"]+)\"\\s*\\)") ?? e => return Err(e.display())
  let client_init = regexp.compile("@@(?:Azure\\.ClientGenerator\\.Core\\.)?clientInitialization\\(\\s*[A-Za-z0-9_.]+\\s*,\\s*\\{\\s*parameters\\s*:\\s*([A-Za-z0-9_]+)\\s*,?\\s*\\}\\s*(?:,\\s*\"([^\"]*)\"\\s*)?\\)") ?? e => return Err(e.display())
  let patch_op = regexp.compile("\\b([A-Za-z0-9_]+)\\s+is\\s+ArmResourcePatch(?:Async|Sync)\\s*<\\s*([A-Za-z0-9_.]+)") ?? e => return Err(e.display())
  let op_group = regexp.compile("@operationGroup\\(\\s*\"([^\"]*)\"\\s*\\)[^{]*?interface\\s+[A-Za-z0-9_]+\\s*\\{([^}]*)\\}") ?? e => return Err(e.display())
  let type_decl = regexp.compile("(?:^|\\n)\\s*(?:enum|union|model|scalar)\\s+([A-Za-z0-9_]+)") ?? e => return Err(e.display())
  let ns_decl = regexp.compile("(?:^|\\n)\\s*namespace\\s+([A-Za-z0-9_.]+)\\s*;") ?? e => return Err(e.display())
  // `Namespace.op` names the operation: the project's namespaces, from
  // every file, are stripped from a target before it is read.
  var namespaces: List[Str] = []
  // each operation's operationId by `iface.op` (lower case), from every
  // file: a `@@clientLocation` in one file names an operation of another
  var ids: Map[Str, Str] = {}
  // every interface operation, `iface.op` (lower case)
  var iface_ops: List[Str] = []
  // `@@clientLocation(Iface.op, Group)` with no scope: `iface.op` (lower
  // case) to Group
  var moved: Map[Str, Str] = {}
  for text in texts {
    for whole in unscoped_loc.find_all(text) {
      let m = unscoped_loc.captures(whole) ?? continue
      let segs = (m[1] ?? "").split(".")
      if segs.len() >= 2 {
        moved["${segs[segs.len() - 2]}.${segs[segs.len() - 1]}".to_lower()] = m[2] ?? ""
      }
    }
  }
  for text in texts {
    for (id, iface, op, _) in operation_ids(text) {
      ids["${iface}.${op}".to_lower()] = id
    }
    iface_ops = iface_ops + interface_ops(text)
    for whole in ns_decl.find_all(text) {
      let n = (ns_decl.captures(whole) ?? continue)[1] ?? ""
      if n != "" && !namespaces.contains(n) {
        namespaces.push(n)
      }
    }
  }
  // each declared type's name, and the name the OpenAPI file gives it
  var types: List[Str] = []
  var emitted: Map[Str, Str] = {}
  for text in texts {
    for whole in type_decl.find_all(text) {
      let n = (type_decl.captures(whole) ?? continue)[1] ?? ""
      if n != "" && !types.contains(n) {
        types.push(n)
      }
    }
    for whole in unscoped.find_all(text) {
      let m = unscoped.captures(whole) ?? continue
      emitted[strip_namespace(m[1] ?? "", namespaces)] = m[2] ?? ""
    }
  }
  var r = Renames{}
  // a property's rename for other emitters, not Go's: the OpenAPI file
  // carries it as x-ms-client-name, and Go keeps the property's name
  var not_go: Map[Str, Str] = {}
  for text in texts {
    for whole in client.find_all(text) {
      let cc = client.captures(whole) ?? continue
      // a block without a scope is every language's, Go's too (Batch)
      if let Some(scope) = cc[1] {
        if !for_go(scope) {
          continue
        }
      }
      let body = cc[2] ?? ""
      for m in member.find_all(body) {
        let c = member.captures(m) ?? continue
        let name = c[1] ?? ""
        if name != "" {
          // `Iface.op` after the project's namespace (Batch's
          // `Azure.Batch.Pools.createPool`) is Iface_Op or its @operationId
          let t = strip_namespace(c[2] ?? "", namespaces)
          let id = match t.cut(".") {
            Some((iface, op)) if !op.contains(".") => ids.get(t.to_lower()) ?? "${iface}_${op[0..1].to_upper()}${op[1..op.len()]}"
            _ => operation_id(c[2] ?? "")
          }
          r.client_ops[id.to_lower()] = name[0..1].to_upper() + name[1..name.len()]
        }
      }
    }
    let chunks = interface_chunks(text)
    for ci in 1..chunks.len() {
      let iface = ident_prefix(chunks[ci])
      for whole in patch_op.find_all(chunks[ci]) {
        let m = patch_op.captures(whole) ?? continue
        let op = m[1] ?? ""
        let res = strip_namespace(m[2] ?? "", namespaces)
        if op == "" || res == "" {
          continue
        }
        let id = ids.get("${iface}.${op}".to_lower()) ?? "${iface}_${op[0..1].to_upper()}${op[1..op.len()]}"
        r.patch_bodies[id.to_lower()] = res.split(".").last() ?? res
      }
    }
    for whole in op_group.find_all(text) {
      let g = op_group.captures(whole) ?? continue
      if !for_go(g[1] ?? "") {
        continue
      }
      for m in member.find_all(g[2] ?? "") {
        let c = member.captures(m) ?? continue
        let name = c[1] ?? ""
        let t = strip_namespace(c[2] ?? "", namespaces)
        let (iface, op) = t.cut(".") ?? continue
        if name == "" || name == op || op.contains(".") {
          continue
        }
        if !texts.any(fn(x: Str) -> Bool { plain_action(x, op) }) {
          continue
        }
        let id = ids.get(t.to_lower()) ?? "${iface}_${op[0..1].to_upper()}${op[1..op.len()]}"
        r.action_routes[id.to_lower()] = (op, name)
      }
    }
    for whole in alt_field.find_all(text) {
      let m = alt_field.captures(whole) ?? continue
      if !for_go(m[3] ?? "") {
        continue
      }
      r.field_types[m[1] ?? ""] = xo_type(m[2] ?? "")
    }
    // Go's emitter names an operation by its operationId, as autorest
    // did, except one added after the move to TypeSpec (`@added`), named
    // by its interface and operation (armcompute v9's
    // SharedGalleryInvites.gallerySharingAccept, operationId
    // GallerySharing_Accept)
    for (id, iface, op, added) in operation_ids(text) {
      let default = "${iface}_${op[0..1].to_upper()}${op[1..op.len()]}"
      if added && id.to_lower() != default.to_lower() {
        r.tsp_ops[id.to_lower()] = (iface, op)
      }
    }
    for whole in body_root.find_all(text) {
      let m = body_root.captures(whole) ?? continue
      let op = m[1] ?? ""
      let ty = m[4] ?? ""
      r.body_roots.push(("${op[0..1].to_upper()}${op[1..op.len()]}ParameterBody", m[3] ?? "", ty.split(".").last() ?? ty, (m[2] ?? "").trim()))
    }
    for (id, via) in decorated(text.replace("@Azure.Core.useFinalStateVia(", "@useFinalStateVia("), "@useFinalStateVia(") {
      r.final_states[id.to_lower()] = via
    }
    for whole in alt_model.find_all(text) {
      let m = alt_model.captures(whole) ?? continue
      let from = m[1] ?? ""
      let to = m[2] ?? ""
      if for_go(m[3] ?? "") && names_type(from) && (to.split(".").last() ?? "").len() > 0 && to.split(".").last().map(fn(s: Str) -> Bool { s[0..1] >= "A" && s[0..1] <= "Z" }) == Some(true) {
        r.model_types[from.split(".").last() ?? from] = to.split(".").last() ?? to
      }
    }
    for whole in alt_param.find_all(text) {
      let m = alt_param.captures(whole) ?? continue
      if !for_go(m[2] ?? "") {
        continue
      }
      r.param_types[m[3] ?? ""] = xo_type(m[1] ?? "")
    }
    for whole in aug.find_all(text) {
      let m = aug.captures(whole) ?? continue
      if !for_go(m[3] ?? "") {
        let target = strip_namespace(m[1] ?? "", namespaces)
        if target.contains(".") && !names_type(target) {
          let (model, prop) = target.cut(".") ?? continue
          not_go["${model}.${m[2] ?? ""}"] = prop
        }
        continue
      }
      let full = m[1] ?? ""
      let target = strip_namespace(full, namespaces)
      let name = m[2] ?? ""
      if iface_ops.contains(target.to_lower()) {
        // an interface's operation (`WebApps.swapSlotSlot`, armappservice):
        // Go's method by the new name, keyed by its operationId
        let (iface, op) = target.cut(".") ?? continue
        let id = ids.get(target.to_lower()) ?? "${iface}_${op[0..1].to_upper()}${op[1..op.len()]}"
        r.ops[id.to_lower()] = name[0..1].to_upper() + name[1..name.len()]
      } else if target.contains(".") && !names_type(target) {
        r.fields[target] = name
      } else if types.contains(target) && target[0..1] >= "a" && target[0..1] <= "z" {
        // a type declared in lower case (azsystemevents' union
        // recordingChannelType), by the name the OpenAPI file gives it
        r.models[emitted.get(target) ?? target] = name
      } else if target != "" && target[0..1] >= "a" && target[0..1] <= "z" {
        r.ops[target.to_lower()] = name
      } else if full != target {
        r.ns_models["${full[0..full.len() - target.len() - 1]}#${target}"] = name
      } else {
        r.models[target] = name
      }
    }
    // A parameter's decorators sit between the previous `;`, `{` or
    // comment end and its declaration.
    // Several may be stacked, one per language (Batch's timeOut); a bare
    // `@query` or `@path` sends the property's own name.
    for seg in text.replace("{", ";").replace("*/", ";").split(";") {
      var go_name = ""
      for whole in inline.find_all(seg) {
        let m = inline.captures(whole) ?? continue
        if for_go(m[2] ?? "") {
          go_name = m[1] ?? ""
        }
      }
      if go_name == "" {
        continue
      }
      let wire = match loc.captures(seg) {
        Some(w) => w[1] ?? ""
        None => match bare_loc.captures(seg) {
          Some(b) => b[1] ?? ""
          None => continue
        }
      }
      r.params[wire] = go_name
    }
  }
  // an unscoped property rename is Go's too, unless Go has its own
  for text in texts {
    for whole in unscoped.find_all(text) {
      let m = unscoped.captures(whole) ?? continue
      let target = strip_namespace(m[1] ?? "", namespaces)
      if target.contains(".") && !names_type(target) && !r.fields.contains(target) {
        r.fields[target] = m[2] ?? ""
      }
    }
  }
  // a model that spreads another (`...ResourceBaseEventData;`) has its
  // properties, and their renames
  var spreads: Map[Str, List[Str]] = {}
  for text in texts {
    for (i, chunk) in text.split("model ").indexed() {
      if i == 0 {
        continue
      }
      let name = ident_prefix(chunk)
      let (head, body) = chunk.cut("{") ?? continue
      if name == "" || head.contains(";") || head.contains("}") {
        continue
      }
      let (inner, _) = body.cut("}") ?? continue
      for (j, part) in inner.split("...").indexed() {
        if j == 0 {
          continue
        }
        let base = ident_prefix(part.trim())
        if base != "" {
          spreads[name] = (spreads.get(name) ?? []) + [base]
        }
      }
    }
  }
  r.fields = spread_keys(r.fields, spreads)
  r.not_go_fields = spread_keys(not_go, spreads)

  for text in texts {
    // `@@clientLocation(Iface.op, "ManagementClient", "go")` moves an
    // operation to another client (Go names armnetwork's
    // CheckDNSNameAvailability on ManagementClient); an interface target
    // (`Microsoft.Network.NetworkInterfaces`) is that interface's client.
    // The operation keeps the name its operationId gives.
    for whole in client_loc.find_all(text) {
      let m = client_loc.captures(whole) ?? continue
      if !for_go(m[4] ?? "") {
        continue
      }
      let segs = (m[1] ?? "").split(".")
      let op = segs.last() ?? ""
      if op == "" {
        continue
      }
      let dest = m[2] ?? ""
      let group = if dest != "" { dest.trim_suffix("Client") } else { (m[3] ?? "").split(".").last() ?? "" }
      // a namespace's own operation (`checkNameAvailability`, outside any
      // interface: armappservice) has the operationId its name gives
      let upper = "${op[0..1].to_upper()}${op[1..op.len()]}"
      let id = if segs.len() < 2 { upper } else {
        let iface = segs[segs.len() - 2]
        ids.get("${iface}.${op}".to_lower()) ?? "${iface}_${upper}"
      }
      // A scope of negations only (`"!java"`) covers typespec-autorest
      // too: the OpenAPI file has the operation in its new group already,
      // under the operationId the move gives it (armcdn's
      // Profiles.listResourceUsage is AFDProfiles_ListResourceUsage, and
      // Profiles_ListResourceUsage is another operation).
      let autorest_too = (m[4] ?? "").split(",").all(fn(x: Str) -> Bool { x.trim().starts_with("!") })
      if autorest_too && segs.len() >= 2 && !ids.contains("${segs[segs.len() - 2]}.${op}".to_lower()) {
        continue
      }
      let name = match r.tsp_ops.get(id.to_lower()) {
        Some((_, n)) => n
        None => match id.find("_") {
          Some(i) => id[i + 1..id.len()]
          None => id
        }
      }
      r.tsp_ops[id.to_lower()] = (group, name)
    }
    for whole in param_loc.find_all(text) {
      let m = param_loc.captures(whole) ?? continue
      // unscoped, or scoped to Go; only a parameter moved onto its own
      // operation
      let scope = m[4] ?? ""
      if (scope != "" && !for_go(scope)) || (m[1] ?? "") != (m[3] ?? "") {
        continue
      }
      let segs = (m[1] ?? "").split(".")
      if segs.len() < 2 {
        continue
      }
      let iface = segs[segs.len() - 2]
      let op = segs[segs.len() - 1]
      let id = ids.get("${iface}.${op}".to_lower()) ?? "${iface}_${op[0..1].to_upper()}${op[1..op.len()]}"
      r.method_params.push("${id.to_lower()}#${m[2] ?? ""}")
    }
    for whole in client_init.find_all(text) {
      let m = client_init.captures(whole) ?? continue
      let scope = m[2] ?? ""
      if scope != "" && !for_go(scope) {
        continue
      }
      for t in texts {
        for f in model_props(t, m[1] ?? "") {
          if !r.client_params.contains(f) {
            r.client_params.push(f)
          }
        }
      }
    }
    for whole in override_re.find_all(text) {
      let m = override_re.captures(whole) ?? continue
      if !for_go(m[3] ?? "") {
        continue
      }
      let segs = (m[1] ?? "").split(".")
      if segs.len() < 2 {
        continue
      }
      let iface = segs[segs.len() - 2]
      let op = segs[segs.len() - 1]
      // an unscoped `@@clientLocation(Iface.op, Group)` moves it to Group
      // for every emitter, the OpenAPI one's operationId too, and an
      // unscoped `@@clientName(Iface.op, "Name")` renames its part
      // (armnetwork's PrivateDnsZoneGroups_List)
      let opn = emitted.get("${iface}.${op}") ?? op
      let id = ids.get("${iface}.${op}".to_lower()) ?? "${moved.get("${iface}.${op}".to_lower()) ?? iface}_${opn[0..1].to_upper()}${opn[1..opn.len()]}"
      for t in texts {
        let order = override_path_order(t, m[2] ?? "")
        if !order.is_empty() {
          r.param_order[id.to_lower()] = order
          break
        }
      }
    }
  }
  Ok(r)
}

/// Whether `text` declares operation `op` as an ARM action
/// (`op is ArmResourceAction...<`) with no `@action` among its
/// decorators: its route is its name.
fn plain_action(text: Str, op: Str) -> Bool {
  let decl = regexp.compile("(?:^|[;{}])([^;{}]*?)\\b${op}\\s+is\\s+ArmResourceAction[A-Za-z]*\\s*<").ok() ?? return false
  for whole in decl.find_all(text) {
    let m = decl.captures(whole) ?? continue
    if !(m[1] ?? "").contains("@action(") {
      return true
    }
  }
  false
}

/// The property names of `model name { ... }` in `text` ([] when `text`
/// has no such model): what a `@@clientInitialization` names.
fn model_props(text: Str, name: Str) -> List[Str] {
  let re = regexp.compile("(?:^|\\n)\\s*model\\s+${name}\\s*\\{([^}]*)\\}").ok() ?? return []
  let prop = regexp.compile("(?:^|\\n)\\s*(?:@[A-Za-z.]+(?:\\([^)]*\\))?\\s*)*([A-Za-z0-9_]+)\\??\\s*:").ok() ?? return []
  let whole = re.find_all(text).get(0) ?? return []
  let m = re.captures(whole) ?? return []
  var out: List[Str] = []
  for line in prop.find_all(m[1] ?? "") {
    let c = prop.captures(line) ?? continue
    out.push(c[1] ?? "")
  }
  out
}

/// The path parameters of `op name(...)` in `text`, in the order it
/// declares them: the spread resource group by its wire name, a `@path`
/// property by its name ([] when `text` has no such operation).
fn override_path_order(text: Str, name: Str) -> List[Str] {
  if name == "" {
    return []
  }
  let start = match text.find("op ${name}(") {
    Some(i) => i + name.len() + 4
    None => return []
  }
  let rest = text[start..text.len()]
  let body = match rest.find("\n):") {
    Some(j) => rest[0..j]
    None => match rest.find("):") {
      Some(j) => rest[0..j]
      None => return []
    }
  }
  var out: List[Str] = []
  var path = false
  for raw in body.split("\n") {
    let l = raw.trim()
    if l.starts_with("...") {
      let spread = l.trim_suffix(",")
      // the subscription is the client's, not the method's
      if spread.ends_with(".ResourceGroupParameter") {
        out.push("resourceGroupName")
      }
      path = false
    } else if l.starts_with("@path") {
      path = true
    } else if l.contains(":") && !l.starts_with("@") && !l.starts_with("#") && !l.starts_with("//") {
      if path {
        out.push(l[0..(l.find(":") ?? 0)].trim().trim_suffix("?"))
      }
      path = false
    }
  }
  out
}

/// `fields` (`Model.prop` to a name) with each key repeated for every
/// model that spreads Model, directly or through others; a model's own
/// key wins.
fn spread_keys(fields: Map[Str, Str], spreads: Map[Str, List[Str]]) -> Map[Str, Str] {
  var out = fields
  for (model, bases) in spreads {
    var todo = bases
    var seen: List[Str] = []
    while let Some(base) = todo.pop() {
      if seen.contains(base) {
        continue
      }
      seen.push(base)
      todo = todo + (spreads.get(base) ?? [])
      for (k, v) in fields {
        if let Some((m, prop)) = k.cut(".") {
          if m == base && !out.contains("${model}.${prop}") {
            out["${model}.${prop}"] = v
          }
        }
      }
    }
  }
  out
}
