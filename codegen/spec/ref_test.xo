// A `$ref`'s pointer is a URI fragment: percent-decoded before it is
// looked up (typespec-autorest writes `_exact_:my_model` as
// `#/definitions/_exact_%3Amy_model`).

use std/json

test "a $ref's fragment is percent-decoded" {
  expect(split_ref("a/b.json", "#/definitions/_exact_%3Amy_model")) == ("a/b.json", "/definitions/_exact_:my_model")
  expect(split_ref("a/b.json", "#/definitions/Plain")) == ("a/b.json", "/definitions/Plain")
  let doc = json.parse_value("{\"definitions\":{\"_exact_:my_model\":{\"type\":\"object\"}}}") ?? e => fault("${e}")
  let (_, p) = split_ref("a/b.json", "#/definitions/_exact_%3Amy_model")
  expect(at(doc, p).is_some()) == true
}
