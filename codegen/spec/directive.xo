// The directives of a readme.go.md (autorest's swagger-document
// transforms) that are plain assignments: `where: $.definitions.X` (or
// `$.definitions["X"]`) with `transform: $['a']['b'] = 'v'` statements,
// or `set:` on such a path, and autorest's `rename-model` and
// `where-model` + `rename-property`. They rename types and fields for Go
// (decision 0002, amendment 2). Any other directive is reported, not
// applied.

use std/json
use std/regexp
use std/yaml

/// One assignment: the definition, the keys inside it, the value.
pub struct Assign {
  /// The file it applies to (`diskRPCommon.json`), empty for every file
  /// (`from: swagger-document`).
  pub from: Str = ""
  pub definition: Str
  pub keys: List[Str]
  pub value: json.Value
}

/// `rename-model`, or with a `model`, `where-model` + `rename-property`
/// (which renames the property's wire key too, as Go's generated
/// serializers show).
pub struct Rename {
  pub model: Str = ""
  pub from: Str
  pub to: Str
}

pub struct Directives {
  pub assigns: List[Assign] = []
  pub renames: List[Rename] = []
  /// Directives not applied, as their `where` text.
  pub skipped: List[Str] = []
}

/// The Go directives in `readme_go`: every yaml block without a
/// condition or whose condition names `$(go)`.
pub fn go_directives(readme_go: Str) -> Directives ! Str {
  directives(readme_go, "", true)
}

/// The directives of readme.md for `tag`: every yaml block without a
/// condition or with `$(tag) == '<tag>'` (Network's renames of the
/// common types). Those it cannot apply (suppressions, other languages'
/// transforms) are not reported.
pub fn tag_directives(readme: Str, tag: Str) -> Directives ! Str {
  directives(readme, tag, false)
}

fn directives(readme_go: Str, tag: Str, go: Bool) -> Directives ! Str {
  let where_re = regexp.compile("^\\$\\.definitions(?:\\.([A-Za-z0-9_]+)|\\[['\"]([^'\"]+)['\"]\\])$") ?? e => return Err(e.display())
  let stmt = regexp.compile("\\$((?:\\[['\"][^'\"]+['\"]\\])+)\\s*=\\s*(?:'([^']*)'|\"([^\"]*)\"|(true|false))") ?? e => return Err(e.display())
  let key = regexp.compile("\\[['\"]([^'\"]+)['\"]\\]") ?? e => return Err(e.display())
  var out = Directives{}
  var block = ""
  var inside = false
  for raw in readme_go.split("\n") {
    let t = raw.trim()
    if t.starts_with("```") {
      if inside {
        inside = false
        let doc = json.parse_value(yaml.to_json(block) ?? e => return Err(e.display())) ?? e => return Err(e.display())
        let ds = match doc.get("directive") {
          Some(json.Value.List(xs)) => xs
          Some(x) => [x]
          None => []
        }
        for d in ds {
          let w = match d.get("where") {
            Some(json.Value.Str(s)) => s
            _ => ""
          }
          let def = match where_re.captures(w) {
            Some(m) => m[1] ?? m[2] ?? ""
            None => ""
          }
          let from = match d.get("from") {
            Some(json.Value.Str(f)) => if f == "swagger-document" { "" } else { f }
            _ => ""
          }
          let tr = match d.get("transform") {
            Some(json.Value.Str(s)) => s
            _ => ""
          }
          var n = 0
          let str_at = fn(x: json.Value?, k: Str) -> Str {
            match x.and_then(fn(o: json.Value) -> json.Value? { o.get(k) }) {
              Some(json.Value.Str(v)) => v
              _ => ""
            }
          }
          if let Some(rm) = d.get("rename-model") {
            if str_at(Some(rm), "from") != "" && str_at(Some(rm), "to") != "" {
              out.renames.push(Rename{from: str_at(Some(rm), "from"), to: str_at(Some(rm), "to")})
              n += 1
            }
          }
          let wm = str_at(Some(d), "where-model")
          if let Some(rp) = d.get("rename-property") {
            if wm != "" && str_at(Some(rp), "from") != "" && str_at(Some(rp), "to") != "" {
              out.renames.push(Rename{model: wm, from: str_at(Some(rp), "from"), to: str_at(Some(rp), "to")})
              n += 1
            }
          }
          if def != "" && tr != "" {
            for whole in stmt.find_all(tr) {
              let m = stmt.captures(whole) ?? continue
              let keys = key.find_all(m[1] ?? "").map(fn(k: Str) -> Str { key.captures(k).and_then(fn(c: List[Str?]) -> Str? { c[1] }) ?? "" })
              let value = match m[4] {
                Some(b) => json.Value.Bool(b == "true")
                None => json.Value.Str(m[2] ?? m[3] ?? "")
              }
              out.assigns.push(Assign{from: from, definition: def, keys: keys, value: value})
              n += 1
            }
          }
          if n == 0 && go {
            out.skipped.push(if w != "" { w } else if wm != "" { "where-model: ${wm}" } else { "a directive without where" })
          }
        }
        block = ""
      } else {
        // A block applies to Go when it has no condition or names $(go).
        let cond = t[3..t.len()].trim().trim_prefix("yaml").trim()
        // ...and is not for track 1 (`$(go) && !$(track2)`).
        let for_tag = tag != "" && (cond == "$(tag) == '${tag}'" || cond == "$(tag) == \"${tag}\"")
        inside = t[3..t.len()].trim().starts_with("yaml") && (cond == "" || (go && cond.contains("$(go)")) || for_tag) && !cond.contains("!$(track2)")
      }
      continue
    }
    if inside {
      block = "${block}${raw}\n"
    }
  }
  Ok(out)
}

/// `v` with `keys` set to `value` (objects made on the way).
pub fn set_at(v: json.Value, keys: List[Str], value: json.Value) -> json.Value {
  if keys.is_empty() {
    return value
  }
  let fs = match v {
    json.Value.Object(fs) => fs
    _ => []
  }
  let k = keys[0]
  let rest = keys[1..keys.len()]
  var out: List[(Str, json.Value)] = []
  var found = false
  for (name, x) in fs {
    if name == k {
      out.push((name, set_at(x, rest, value)))
      found = true
    } else {
      out.push((name, x))
    }
  }
  if !found {
    out.push((k, set_at(json.Value.Object([]), rest, value)))
  }
  json.Value.Object(out)
}

/// `doc` (the file `file`) with the assignments to its definitions
/// applied, and how many.
pub fn apply(doc: json.Value, file: Str, assigns: List[Assign]) -> (json.Value, Int) {
  var d = doc
  var n = 0
  for a in assigns {
    if a.from != "" && !file.ends_with("/${a.from}") {
      continue
    }
    if d.get("definitions").and_then(fn(x: json.Value) -> json.Value? { x.get(a.definition) }).is_some() {
      d = set_at(d, ["definitions", a.definition] + a.keys, a.value)
      n += 1
    }
  }
  (d, n)
}

/// A key of an object renamed, its place kept.
fn rename_key(v: json.Value, from: Str, to: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object(fs.map(fn(f: (Str, json.Value)) -> (Str, json.Value) { if f.0 == from { (to, f.1) } else { f } }))
    other => other
  }
}

/// Every `$ref` to definition `from` (in any file) pointed at `to`.
fn rewrite_refs(v: json.Value, from: Str, to: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object(fs.map(fn(f: (Str, json.Value)) -> (Str, json.Value) {
      match f {
        ("$ref", json.Value.Str(r)) => if r.ends_with("#/definitions/${from}") { ("$ref", json.Value.Str("${r.trim_suffix(from)}${to}")) } else { f }
        (k, x) => (k, rewrite_refs(x, from, to))
      }
    }))
    json.Value.List(xs) => json.Value.List(xs.map(fn(x: json.Value) -> json.Value { rewrite_refs(x, from, to) }))
    other => other
  }
}

/// `doc` with the renames applied, and how many changed it.
pub fn apply_renames(doc: json.Value, renames: List[Rename]) -> (json.Value, Int) {
  var d = doc
  var n = 0
  for r in renames {
    let defs = d.get("definitions") ?? json.Value.Object([])
    if r.model == "" {
      if defs.get(r.from).is_some() {
        d = set_at(d, ["definitions"], rename_key(defs, r.from, r.to))
        n += 1
      }
      d = rewrite_refs(d, r.from, r.to)
    } else if let Some(m) = defs.get(r.model) {
      if let Some(props) = m.get("properties") {
        if props.get(r.from).is_some() {
          var m2 = set_at(m, ["properties"], rename_key(props, r.from, r.to))
          if let Some(json.Value.List(req)) = m.get("required") {
            m2 = set_at(m2, ["required"], json.Value.List(req.map(fn(x: json.Value) -> json.Value { if x == json.Value.Str(r.from) { json.Value.Str(r.to) } else { x } })))
          }
          d = set_at(d, ["definitions", r.model], m2)
          n += 1
        }
      }
    }
  }
  (d, n)
}
