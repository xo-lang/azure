// The directives of a readme.go.md (autorest's swagger-document
// transforms) that are plain assignments or deletions: `where:
// $.definitions.X` or `$.parameters.X` (or `$.definitions["X"]`, or a path under it such as
// `$.definitions.X.properties.y`) with `transform: $['a']['b'] = 'v'`
// and `delete $['a']` statements, `where: $.definitions` with `delete
// $['X']` (the definition dropped), and autorest's `rename-model` and
// `where-model` + `rename-property`. They rename types and fields for Go
// (decision 0002, amendment 2). Any other directive is reported, not
// applied.

use std/json
use std/regexp
use std/yaml

/// One assignment: the definition, the keys inside it, the value.
pub struct Assign {
  /// The file it applies to (`diskRPCommon.json`), empty for every file
  /// (`from: swagger-document`).
  pub from: Str = ""
  pub definition: Str
  /// The document's section that holds it: `definitions`, or
  /// `parameters` (armpowerbiprivatelinks' `x-ms-parameter-location`).
  pub section: Str = "definitions"
  pub keys: List[Str]
  pub value: json.Value
  /// `delete $[...]`: the key removed instead of set.
  pub delete: Bool = false
}

/// `rename-model`, or with a `model`, `where-model` + `rename-property`
/// (which renames the property's wire key too, as Go's generated
/// serializers show).
pub struct Rename {
  pub model: Str = ""
  pub from: Str
  pub to: Str
}

pub struct Directives {
  pub assigns: List[Assign] = []
  pub renames: List[Rename] = []
  /// Directives not applied, as their `where` text.
  pub skipped: List[Str] = []
}

/// The Go directives in `readme_go`: every yaml block without a
/// condition or whose condition names `$(go)`.
pub fn go_directives(readme_go: Str) -> Directives ! Str {
  directives(readme_go, "", true)
}

/// The directives of readme.md for `tag`: every yaml block without a
/// condition or with `$(tag) == '<tag>'` (Network's renames of the
/// common types). Those it cannot apply (suppressions, other languages'
/// transforms) are not reported.
pub fn tag_directives(readme: Str, tag: Str) -> Directives ! Str {
  directives(readme, tag, false)
}

fn directives(readme_go: Str, tag: Str, go: Bool) -> Directives ! Str {
  let where_re = regexp.compile("^\\$\\.(definitions|parameters)(?:\\.([A-Za-z0-9_]+)|\\[['\"]([^'\"]+)['\"]\\])((?:\\.[A-Za-z0-9_]+)*)$") ?? e => return Err(e.display())
  let del = regexp.compile("delete\\s+\\$((?:\\[['\"][^'\"]+['\"]\\])+)") ?? e => return Err(e.display())
  let stmt = regexp.compile("\\$((?:\\[['\"][^'\"]+['\"]\\])+)\\s*=\\s*(?:'([^']*)'|\"([^\"]*)\"|(true|false))") ?? e => return Err(e.display())
  let key = regexp.compile("\\[['\"]([^'\"]+)['\"]\\]") ?? e => return Err(e.display())
  var out = Directives{}
  var block = ""
  var inside = false
  for raw in readme_go.split("\n") {
    let t = raw.trim()
    if t.starts_with("```") {
      if inside {
        inside = false
        let doc = json.parse_value(yaml.to_json(block) ?? e => return Err(e.display())) ?? e => return Err(e.display())
        let ds = match doc.get("directive") {
          Some(json.Value.List(xs)) => xs
          Some(x) => [x]
          None => []
        }
        for d in ds {
          let w = match d.get("where") {
            Some(json.Value.Str(s)) => s
            _ => ""
          }
          let (section, def, under) = match where_re.captures(w) {
            Some(m) => (m[1] ?? "definitions", m[2] ?? m[3] ?? "", (m[4] ?? "").split(".").filter(fn(x: Str) -> Bool { x != "" }))
            None => ("definitions", "", [])
          }
          let from = match d.get("from") {
            Some(json.Value.Str(f)) => if f == "swagger-document" { "" } else { f }
            _ => ""
          }
          let tr = match d.get("transform") {
            Some(json.Value.Str(s)) => s
            _ => ""
          }
          var n = 0
          let str_at = fn(x: json.Value?, k: Str) -> Str {
            match x.and_then(fn(o: json.Value) -> json.Value? { o.get(k) }) {
              Some(json.Value.Str(v)) => v
              _ => ""
            }
          }
          if let Some(rm) = d.get("rename-model") {
            if str_at(Some(rm), "from") != "" && str_at(Some(rm), "to") != "" {
              out.renames.push(Rename{from: str_at(Some(rm), "from"), to: str_at(Some(rm), "to")})
              n += 1
            }
          }
          let wm = str_at(Some(d), "where-model")
          if let Some(rp) = d.get("rename-property") {
            if wm != "" && str_at(Some(rp), "from") != "" && str_at(Some(rp), "to") != "" {
              out.renames.push(Rename{model: wm, from: str_at(Some(rp), "from"), to: str_at(Some(rp), "to")})
              n += 1
            }
          }
          let keys_of = fn(path: Str) -> List[Str] { key.find_all(path).map(fn(k: Str) -> Str { key.captures(k).and_then(fn(c: List[Str?]) -> Str? { c[1] }) ?? "" }) }
          if def != "" && tr != "" {
            // in the transform's order: a deletion before an assignment
            // to the same object (`delete $["$ref"]; $["type"] = ...`)
            for whole in del.find_all(tr) {
              let m = del.captures(whole) ?? continue
              out.assigns.push(Assign{from: from, definition: def, section: section, keys: under + keys_of(m[1] ?? ""), value: json.Value.Null, delete: true})
              n += 1
            }
            for whole in stmt.find_all(tr) {
              let m = stmt.captures(whole) ?? continue
              let value = match m[4] {
                Some(b) => json.Value.Bool(b == "true")
                None => json.Value.Str(m[2] ?? m[3] ?? "")
              }
              out.assigns.push(Assign{from: from, definition: def, section: section, keys: under + keys_of(m[1] ?? ""), value: value})
              n += 1
            }
          } else if w == "$.definitions" && tr != "" {
            // `delete $["X"]`: the definition dropped
            for whole in del.find_all(tr) {
              let m = del.captures(whole) ?? continue
              let ks = keys_of(m[1] ?? "")
              if ks.len() == 1 {
                out.assigns.push(Assign{from: from, definition: ks[0], keys: [], value: json.Value.Null, delete: true})
                n += 1
              }
            }
          }
          if n == 0 && go {
            out.skipped.push(if w != "" { w } else if wm != "" { "where-model: ${wm}" } else { "a directive without where" })
          }
        }
        block = ""
      } else {
        // A block applies to Go when it has no condition or names $(go).
        let cond = t[3..t.len()].trim().trim_prefix("yaml").trim()
        // ...and is not for track 1 (`$(go) && !$(track2)`).
        let for_tag = tag != "" && (cond == "$(tag) == '${tag}'" || cond == "$(tag) == \"${tag}\"")
        inside = t[3..t.len()].trim().starts_with("yaml") && (cond == "" || (go && cond.contains("$(go)")) || for_tag) && !cond.contains("!$(track2)")
      }
      continue
    }
    if inside {
      block = "${block}${raw}\n"
    }
  }
  Ok(out)
}

/// `v` with `keys` set to `value` (objects made on the way).
pub fn set_at(v: json.Value, keys: List[Str], value: json.Value) -> json.Value {
  if keys.is_empty() {
    return value
  }
  let fs = match v {
    json.Value.Object(fs) => fs
    _ => []
  }
  let k = keys[0]
  let rest = keys[1..keys.len()]
  var out: List[(Str, json.Value)] = []
  var found = false
  for (name, x) in fs {
    if name == k {
      out.push((name, set_at(x, rest, value)))
      found = true
    } else {
      out.push((name, x))
    }
  }
  if !found {
    out.push((k, set_at(json.Value.Object([]), rest, value)))
  }
  json.Value.Object(out)
}

/// `v` without the key at `keys` (unchanged when it is not there).
pub fn remove_at(v: json.Value, keys: List[Str]) -> json.Value {
  if keys.is_empty() {
    return v
  }
  let fs = match v {
    json.Value.Object(fs) => fs
    other => return other
  }
  let k = keys[0]
  if keys.len() == 1 {
    return json.Value.Object(fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != k }))
  }
  let rest = keys[1..keys.len()]
  json.Value.Object(fs.map(fn(f: (Str, json.Value)) -> (Str, json.Value) { if f.0 == k { (f.0, remove_at(f.1, rest)) } else { f } }))
}

/// `doc` with only the definitions whose name is one of `prefixes`
/// followed by at least one more character, as a Go autorest.md
/// transform that keeps `^(OnYour|Azure|...).+$` (azopenai); an empty
/// list keeps every definition.
pub fn keep_definitions(doc: json.Value, prefixes: List[Str]) -> json.Value {
  if prefixes.is_empty() {
    return doc
  }
  let defs = match get_at(doc, ["definitions"]) {
    Some(json.Value.Object(fs)) => fs
    _ => return doc
  }
  let kept = defs.filter(fn(f: (Str, json.Value)) -> Bool {
    prefixes.any(fn(p: Str) -> Bool { f.0.len() > p.len() && f.0.starts_with(p) })
  })
  set_at(doc, ["definitions"], json.Value.Object(kept))
}

/// `doc` (the file `file`) with the assignments to its definitions
/// applied, and how many.
pub fn apply(doc: json.Value, file: Str, assigns: List[Assign]) -> (json.Value, Int) {
  var d = doc
  var n = 0
  for a in assigns {
    if a.from != "" && !file.ends_with("/${a.from}") {
      continue
    }
    if d.get(a.section).and_then(fn(x: json.Value) -> json.Value? { x.get(a.definition) }).is_some() {
      d = if a.delete { remove_at(d, [a.section, a.definition] + a.keys) } else { set_at(d, [a.section, a.definition] + a.keys, a.value) }
      n += 1
    }
  }
  (d, n)
}

/// A key of an object renamed, its place kept.
fn rename_key(v: json.Value, from: Str, to: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object(fs.map(fn(f: (Str, json.Value)) -> (Str, json.Value) { if f.0 == from { (to, f.1) } else { f } }))
    other => other
  }
}

/// Every `$ref` to definition `from` (in any file) pointed at `to`.
fn rewrite_refs(v: json.Value, from: Str, to: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object(fs.map(fn(f: (Str, json.Value)) -> (Str, json.Value) {
      match f {
        ("$ref", json.Value.Str(r)) => if r.ends_with("#/definitions/${from}") { ("$ref", json.Value.Str("${r.trim_suffix(from)}${to}")) } else { f }
        (k, x) => (k, rewrite_refs(x, from, to))
      }
    }))
    json.Value.List(xs) => json.Value.List(xs.map(fn(x: json.Value) -> json.Value { rewrite_refs(x, from, to) }))
    other => other
  }
}

/// `doc` with the renames applied, and how many changed it.
pub fn apply_renames(doc: json.Value, renames: List[Rename]) -> (json.Value, Int) {
  var d = doc
  var n = 0
  for r in renames {
    let defs = d.get("definitions") ?? json.Value.Object([])
    if r.model == "" {
      if defs.get(r.from).is_some() {
        d = set_at(d, ["definitions"], rename_key(defs, r.from, r.to))
        n += 1
      }
      d = rewrite_refs(d, r.from, r.to)
    } else if let Some(m) = defs.get(r.model) {
      if let Some(props) = m.get("properties") {
        if props.get(r.from).is_some() {
          var m2 = set_at(m, ["properties"], rename_key(props, r.from, r.to))
          if let Some(json.Value.List(req)) = m.get("required") {
            m2 = set_at(m2, ["required"], json.Value.List(req.map(fn(x: json.Value) -> json.Value { if x == json.Value.Str(r.from) { json.Value.Str(r.to) } else { x } })))
          }
          d = set_at(d, ["definitions", r.model], m2)
          n += 1
        }
      }
    }
  }
  (d, n)
}

/// One edit of a spec file, a structured form of an autorest.md
/// directive's JavaScript transform (codegen/custom/<module>.toml's
/// `[[patch]]`): `op` at JSON pointer `pointer` (RFC 6901, `~1` for `/`).
pub struct Patch {
  /// The file it applies to (`containerregistry.json`), empty for every
  /// file.
  pub file: Str = ""
  pub pointer: Str
  /// `set` (the key or index to `value`), `delete` (the key or index
  /// removed), `push` (`value` appended to the list), `copy` (the value
  /// at pointer `from` set here).
  pub op: Str
  /// JSON text.
  pub value: Str = ""
  pub from: Str = ""
} derive Json

/// The keys of a JSON pointer, unescaped.
pub fn pointer_keys(ptr: Str) -> List[Str] {
  ptr.trim_prefix("/").split("/").filter(fn(k: Str) -> Bool { k != "" }).map(fn(k: Str) -> Str { k.replace("~1", "/").replace("~0", "~") })
}

/// The value at `keys` (a list's index as its decimal text).
pub fn get_at(v: json.Value, keys: List[Str]) -> json.Value? {
  var cur = v
  for k in keys {
    cur = match cur {
      json.Value.Object(_) => cur.get(k) ?? return None
      json.Value.List(xs) => xs.get(Int.parse(k) ?? return None) ?? return None
      _ => return None
    }
  }
  Some(cur)
}

/// `v` with `f` applied to the value at `keys`, None when a key on the
/// way is missing (the last one may be missing in an object).
fn update_at(v: json.Value, keys: List[Str], f: fn(json.Value?) -> json.Value?) -> json.Value? {
  if keys.is_empty() {
    return f(Some(v))
  }
  let k = keys[0]
  let rest = keys[1..keys.len()]
  match v {
    json.Value.Object(fs) => {
      var out: List[(Str, json.Value)] = []
      var found = false
      for (name, x) in fs {
        if name == k {
          found = true
          if rest.is_empty() {
            if let Some(nx) = f(Some(x)) {
              out.push((name, nx))
            }
          } else {
            out.push((name, update_at(x, rest, f)?))
          }
        } else {
          out.push((name, x))
        }
      }
      if !found {
        if !rest.is_empty() {
          return None
        }
        out.push((k, f(None)?))
      }
      Some(json.Value.Object(out))
    }
    json.Value.List(xs) => {
      let i = Int.parse(k) ?? return None
      if i < 0 || i >= xs.len() {
        return None
      }
      var out: List[json.Value] = []
      for (j, x) in xs.indexed() {
        if j != i {
          out.push(x)
        } else if rest.is_empty() {
          if let Some(nx) = f(Some(x)) {
            out.push(nx)
          }
        } else {
          out.push(update_at(x, rest, f)?)
        }
      }
      Some(json.Value.List(out))
    }
    _ => None
  }
}

/// `doc` (the file `file`) with the patches for it applied, and the
/// pointers of those that found nothing to change.
pub fn apply_patches(doc: json.Value, file: Str, patches: List[Patch]) -> (json.Value, List[Str]) ! Str {
  var d = doc
  var missed: List[Str] = []
  for p in patches {
    if p.file != "" && !file.ends_with("/${p.file}") {
      continue
    }
    let value = if p.value == "" { json.Value.Null } else { json.parse_value(p.value) ?? e => return Err("patch ${p.pointer}: ${e.display()}") }
    let keys = pointer_keys(p.pointer)
    let r = match p.op {
      "set" => update_at(d, keys, fn(_: json.Value?) -> json.Value? { Some(value) })
      "delete" => if get_at(d, keys).is_some() { update_at(d, keys, fn(_: json.Value?) -> json.Value? { None }) } else { None }
      "push" => update_at(d, keys, fn(x: json.Value?) -> json.Value? {
        match x {
          Some(json.Value.List(xs)) => Some(json.Value.List(xs + [value]))
          _ => None
        }
      })
      "copy" => {
        let src = get_at(d, pointer_keys(p.from))
        match src {
          Some(sv) => update_at(d, keys, fn(_: json.Value?) -> json.Value? { Some(sv) })
          None => None
        }
      }
      other => return Err("patch ${p.pointer}: unknown op ${other}")
    }
    match r {
      Some(nd) => d = nd
      None => missed.push("${p.op} ${p.pointer}")
    }
  }
  Ok((d, missed))
}
