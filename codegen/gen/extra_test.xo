// An object with no properties, read as Go reads it: `additionalProperties:
// true` is a map of any JSON (map[string]any), and from autorest
// `additionalProperties: false` is any JSON (any).

use std/json

test "additionalProperties true is a map, false any JSON (autorest)" {
  var b = builder({}, "armx")
  b.files["f.json"] = json.parse_value("{\"definitions\":{\"Open\":{\"properties\":{},\"additionalProperties\":true},\"Closed\":{\"type\":\"object\",\"additionalProperties\":false}}}")?
  expect(b.type_of("f.json", json.parse_value("{\"$ref\":\"#/definitions/Open\"}")?, "")) == "Map[Str, json.Value]"
  expect(b.type_of("f.json", json.parse_value("{\"$ref\":\"#/definitions/Closed\"}")?, "")) == "json.Value"
  expect(b.type_of("f.json", json.parse_value("{\"type\":\"object\",\"additionalProperties\":true}")?, "X")) == "Map[Str, json.Value]"
}
