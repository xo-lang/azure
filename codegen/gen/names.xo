// Names, as azure-sdk-for-go's generator writes them, then in Xo style
// (decision 0004): Go's exported names in snake_case for functions,
// fields and parameters, PascalCase for types.

/// Xo's 27 keywords and predeclared values (spec/core.md 1.4), taken
/// from the spec rather than from what `xo check` refuses today, so a word
/// the checker starts refusing later cannot break a released module's
/// names. The contextual words (`scope`, `derive`, `is`, ...) are names.
const KEYWORDS: List[Str] = ["as", "break", "const", "continue", "defer", "else", "ensures", "enum", "fn", "for", "if", "in", "interface", "invariant", "let", "match", "pub", "requires", "return", "select", "struct", "test", "type", "use", "uses", "var", "while", "true", "false", "self", "target", "fault", "dbg"]

const RESERVED_TYPES: List[Str] = ["Error", "Result", "Option", "List", "Map", "Set", "Time", "Duration", "Str", "Int", "Bool", "Bytes", "Float", "Secret", "Value", "Client", "Rune"]

fn is_upper(c: Str) -> Bool {
  c != c.to_lower()
}

fn is_alnum(c: Str) -> Bool {
  let l = c.to_lower()
  (l >= "a" && l <= "z") || (l >= "0" && l <= "9")
}

/// Words of an identifier: split at separators and case changes
/// (`resourceGroupName`, `HTTPServer`, `x-ms-client-request-id`).
pub fn words(s: Str) -> List[Str] {
  split_words(s, false)
}

/// Words as modelerfour splits a type name: also a letter after digits
/// starts a word (V2s is V2 S, P2sVpn is P2 S Vpn).
fn type_words(s: Str) -> List[Str] {
  split_words(s, true)
}

fn split_words(s: Str, digits: Bool) -> List[Str] {
  var out: List[Str] = []
  var cur = ""
  let cs = s.runes().map(fn(r: Rune) -> Str { "${r}" })
  for (i, c) in cs.indexed() {
    if !is_alnum(c) {
      if cur != "" {
        out.push(cur)
        cur = ""
      }
      continue
    }
    // a letter after digits starts a word, as modelerfour splits
    // (V2s is V2 S, P2sVpn is P2 S Vpn)
    if digits && cur != "" && !all_digits(c) && all_digits(cur[cur.len() - 1..cur.len()]) {
      out.push(cur)
      cur = ""
    }
    if cur != "" && is_upper(c) {
      let prev = cs[i - 1]
      let next_lower = i + 1 < cs.len() && is_alnum(cs[i + 1]) && !is_upper(cs[i + 1]) && cs[i + 1].to_lower() >= "a"
      // a plural initialism stays whole: VMs, IDs (an `s` ending the word)
      let plural = next_lower && cs[i + 1] == "s" && (i + 2 >= cs.len() || !is_alnum(cs[i + 2]) || is_upper(cs[i + 2])) && cur.len() >= 1 && is_upper(prev)
      if !is_upper(prev) || (next_lower && !plural) {
        out.push(cur)
        cur = ""
      }
    }
    cur = cur + c
  }
  if cur != "" {
    out.push(cur)
  }
  out
}

/// snake_case, not a keyword, not starting with a digit.
pub fn snake(s: Str) -> Str {
  // Each word in Go's casing first, so its breaks carry over (Ipsec is
  // IPSec, ip_sec).
  var ws: List[Str] = []
  for w in words(s) {
    ws = ws + words(cap(w))
  }
  var n = ws.map(fn(w: Str) -> Str { w.to_lower() }).join("_")
  if n == "" {
    n = "value"
  }
  if n[0..1] >= "0" && n[0..1] <= "9" {
    n = "n${n}"
  }
  if KEYWORDS.contains(n) {
    n = "${n}_"
  }
  n
}

/// The acronyms autorest.go writes in capitals, as its CommonAcronyms
/// list (packages/naming.go/src/mappings.ts, MIT, Copyright (c)
/// Microsoft Corporation; NOTICE.md): the words matched whole.
const ACRONYMS: List[Str] = ["aad", "api", "ascii", "cpu", "css", "csv", "dns", "eof", "guid", "html", "jpeg", "json", "lhs", "mbcs", "md5", "pdf", "png", "qps", "ram", "rhs", "rpc", "sla", "smtp", "sql", "ssh", "ssl", "tcp", "tiff", "tls", "ttl", "udp", "ui", "uid", "uri", "url", "utc", "uuid", "xml", "xsrf", "xss"]

fn all_digits(s: Str) -> Bool {
  s.runes().all(fn(r: Rune) -> Bool { "${r}" >= "0" && "${r}" <= "9" })
}

/// The span of `l` (a lowercase word) autorest.go's list puts in
/// capitals, as (start, end), or None. Its patterns in order: `^acl`,
/// `aes\d+`, `^crc\d*$`, `gcm`, `^http[s|\d]?$`, `^(id)s?$`,
/// `^(ipc)onfig`, `^(ip)s?$`, `^(ips)ec`, `^(ip)[vV]\d`, `^(od)ata$`,
/// `^rfc\d*$`, `^sha\d*$`, `^(sku)[sS]?$`, `^utf\d*$`, `^(vm)s?$`,
/// `^(vpn)s?$`, and the whole words of ACRONYMS.
fn acronym_spans(l: Str) -> List[(Int, Int)] {
  var out: List[(Int, Int)] = []
  let n = l.len()
  if ACRONYMS.contains(l) {
    out.push((0, n))
  }
  if l.starts_with("acl") {
    out.push((0, 3))
  }
  if let Some(a) = l.find("aes") {
    if a + 3 < n && all_digits(l[a + 3..a + 4]) {
      out.push((a, a + 3))
    }
  }
  for p in ["crc", "rfc", "sha", "utf"] {
    if l.starts_with(p) && all_digits(l[3..n]) {
      out.push((0, n))
    }
  }
  if let Some(g) = l.find("gcm") {
    out.push((g, g + 3))
  }
  if l == "http" || ((l.starts_with("http") && n == 5) && (l[4..5] == "s" || l[4..5] == "|" || all_digits(l[4..5]))) {
    out.push((0, n))
  }
  for (p, plural) in [("id", "s"), ("ip", "s"), ("sku", "s"), ("vm", "s"), ("vpn", "s")] {
    if l == p || l == "${p}${plural}" {
      out.push((0, p.len()))
    }
  }
  if l.starts_with("ipconfig") {
    out.push((0, 3))
  }
  if l.starts_with("ipsec") {
    out.push((0, 3))
  }
  if n >= 4 && l.starts_with("ipv") && all_digits(l[3..4]) {
    out.push((0, 2))
  }
  if l == "odata" {
    out.push((0, 2))
  }
  out
}

/// A word as autorest.go's ensureNameCase writes it: the acronym spans
/// in capitals, then the first letter.
fn cap(w: Str) -> Str {
  if w == "" {
    return ""
  }
  var r = w
  for (a, b) in acronym_spans(w.to_lower()) {
    r = "${r[0..a]}${r[a..b].to_upper()}${r[b..r.len()]}"
  }
  "${r[0..1].to_upper()}${r[1..r.len()]}"
}

/// PascalCase of a word inside a longer name (`ResourceGroupsClientListOptions`).
pub fn part(s: Str) -> Str {
  type_words(s).map(fn(w: Str) -> Str { cap(w) }).join("")
}

/// PascalCase for a type name; builtin names get a `Model` suffix.
pub fn pascal(s: Str) -> Str {
  var n = type_words(s).map(fn(w: Str) -> Str { cap(w) }).join("")
  if n == "" {
    n = "Value"
  }
  if n[0..1] >= "0" && n[0..1] <= "9" {
    n = "N${n}"
  }
  reserve(n)
}

/// `n` without the suffix reserve added (`SecretModel` is `Secret`).
pub fn unreserve(n: Str) -> Str {
  let base = n.trim_suffix("Model")
  if base != n && RESERVED_TYPES.contains(base) { base } else { n }
}

/// `n`, with a `Model` suffix when Xo predeclares it (`Secret`), and
/// UpperCamel when Go's is unexported (`internalACSRouterCommunicationError`).
pub fn reserve(n: Str) -> Str {
  let u = if is_unexported(n) { "${n[0..1].to_upper()}${n[1..n.len()]}" } else { n }
  if RESERVED_TYPES.contains(u) { "${u}Model" } else { u }
}

/// Go's name `n` is unexported (a lower-case first letter).
pub fn is_unexported(n: Str) -> Bool {
  n != "" && n[0..1] >= "a" && n[0..1] <= "z"
}

/// autorest's name for an enum value of symbols only (`*` is Go's
/// `Asterisk`).
pub fn symbol_name(s: Str) -> Str? {
  match s {
    "*" => Some("Asterisk")
    _ => None
  }
}

/// An enum value's Go name part, its constants' sort key.
pub fn value_part(s: Str) -> Str {
  let p = part(s)
  if p == "" { symbol_name(s) ?? "" } else { p }
}

/// SCREAMING_SNAKE for a constant.
pub fn screaming(s: Str) -> Str {
  var ws = words(s)
  // autorest's fixLeadingNumber: a leading number is said in words
  // (`2020-11-01` is Go's `TwoThousandTwenty1101`, `1.0` is `One0`)
  if !ws.is_empty() {
    if let Some(v) = Int.parse(ws[0]) {
      ws = number_words(v) + ws[1..ws.len()]
    }
  }
  var n = ws.map(fn(w: Str) -> Str { w.to_upper() }).join("_")
  if n == "" {
    n = (symbol_name(s) ?? "Empty").to_upper()
  }
  if n[0..1] >= "0" && n[0..1] <= "9" {
    n = "N${n}"
  }
  n
}

/// A number in English words, as @azure-tools/codegen's convert:
/// `2022` is two thousand twenty two.
pub fn number_words(n: Int) -> List[Str] {
  let ones = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"]
  let tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
  let rest = fn(r: Int) -> List[Str] { if r == 0 { [] } else { number_words(r) } }
  if n < 20 {
    return [ones[n]]
  }
  if n < 100 {
    return [tens[n / 10]] + rest(n % 10)
  }
  if n < 1000 {
    return [ones[n / 100], "hundred"] + rest(n % 100)
  }
  if n < 1000000 {
    return number_words(n / 1000) + ["thousand"] + rest(n % 1000)
  }
  if n < 1000000000 {
    return number_words(n / 1000000) + ["million"] + rest(n % 1000000)
  }
  number_words(n / 1000000000) + ["billion"] + rest(n % 1000000000)
}
