// Names, as azure-sdk-for-go's generator writes them, then in Xo style
// (decision 0004): Go's exported names in snake_case for functions,
// fields and parameters, PascalCase for types.

/// Xo's 27 keywords (core 1.4) and the predeclared values `true`,
/// `false` and `dbg`: the words `xo check` refuses as a name.
const KEYWORDS: List[Str] = ["as", "break", "const", "continue", "defer", "else", "ensures", "enum", "fn", "for", "if", "in", "interface", "invariant", "let", "match", "pub", "requires", "return", "select", "struct", "test", "type", "use", "uses", "var", "while", "true", "false", "dbg"]

const RESERVED_TYPES: List[Str] = ["Error", "Result", "Option", "List", "Map", "Set", "Time", "Duration", "Str", "Int", "Bool", "Bytes", "Float", "Secret", "Value", "Client", "Rune"]

fn is_upper(c: Str) -> Bool {
  c != c.to_lower()
}

fn is_alnum(c: Str) -> Bool {
  let l = c.to_lower()
  (l >= "a" && l <= "z") || (l >= "0" && l <= "9")
}

/// Words of an identifier: split at separators and case changes
/// (`resourceGroupName`, `HTTPServer`, `x-ms-client-request-id`).
pub fn words(s: Str) -> List[Str] {
  var out: List[Str] = []
  var cur = ""
  let cs = s.runes().map(fn(r: Rune) -> Str { "${r}" })
  for (i, c) in cs.indexed() {
    if !is_alnum(c) {
      if cur != "" {
        out.push(cur)
        cur = ""
      }
      continue
    }
    if cur != "" && is_upper(c) {
      let prev = cs[i - 1]
      let next_lower = i + 1 < cs.len() && is_alnum(cs[i + 1]) && !is_upper(cs[i + 1]) && cs[i + 1].to_lower() >= "a"
      // a plural initialism stays whole: VMs, IDs (an `s` ending the word)
      let plural = next_lower && cs[i + 1] == "s" && (i + 2 >= cs.len() || !is_alnum(cs[i + 2]) || is_upper(cs[i + 2])) && cur.len() >= 1 && is_upper(prev)
      if !is_upper(prev) || (next_lower && !plural) {
        out.push(cur)
        cur = ""
      }
    }
    cur = cur + c
  }
  if cur != "" {
    out.push(cur)
  }
  out
}

/// snake_case, not a keyword, not starting with a digit.
pub fn snake(s: Str) -> Str {
  var n = words(s).map(fn(w: Str) -> Str { w.to_lower() }).join("_")
  if n == "" {
    n = "value"
  }
  if n[0..1] >= "0" && n[0..1] <= "9" {
    n = "n${n}"
  }
  if KEYWORDS.contains(n) {
    n = "${n}_"
  }
  n
}

/// The initialisms Go's generator (autorest.go) writes in capitals.
const INITIALISMS: List[Str] = ["acl", "api", "ascii", "cpu", "css", "dns", "eof", "guid", "html", "http", "https", "id", "ip", "json", "lhs", "qps", "ram", "rhs", "rpc", "sla", "smtp", "sku", "sql", "ssh", "tcp", "tls", "ttl", "udp", "ui", "uid", "uuid", "uri", "url", "utf8", "vm", "xml", "xsrf", "xss"]

fn cap(w: Str) -> Str {
  let l = w.to_lower()
  if INITIALISMS.contains(l) {
    return w.to_upper()
  }
  // a plural initialism: Skus is SKUs, Ids is IDs
  if l.len() > 2 && l.ends_with("s") && INITIALISMS.contains(l[0..l.len() - 1]) {
    return "${l[0..l.len() - 1].to_upper()}s"
  }
  if w == "" { "" } else { "${w[0..1].to_upper()}${w[1..w.len()]}" }
}

/// PascalCase of a word inside a longer name (`ResourceGroupsClientListOptions`).
pub fn part(s: Str) -> Str {
  words(s).map(fn(w: Str) -> Str { cap(w) }).join("")
}

/// PascalCase for a type name; builtin names get a `Model` suffix.
pub fn pascal(s: Str) -> Str {
  var n = words(s).map(fn(w: Str) -> Str { cap(w) }).join("")
  if n == "" {
    n = "Value"
  }
  if n[0..1] >= "0" && n[0..1] <= "9" {
    n = "N${n}"
  }
  reserve(n)
}

/// `n` without the suffix reserve added (`SecretModel` is `Secret`).
pub fn unreserve(n: Str) -> Str {
  let base = n.trim_suffix("Model")
  if base != n && RESERVED_TYPES.contains(base) { base } else { n }
}

/// `n`, with a `Model` suffix when Xo predeclares it (`Secret`).
pub fn reserve(n: Str) -> Str {
  if RESERVED_TYPES.contains(n) { "${n}Model" } else { n }
}

/// SCREAMING_SNAKE for a constant.
pub fn screaming(s: Str) -> Str {
  var n = words(s).map(fn(w: Str) -> Str { w.to_upper() }).join("_")
  if n == "" {
    n = "EMPTY"
  }
  if n[0..1] >= "0" && n[0..1] <= "9" {
    n = "N${n}"
  }
  n
}
