// The model of one ARM package, built from its OpenAPI 2.0 files: the
// operations grouped into clients as Go groups them (the operationId's
// `Group_Op`), and the types they reach. A type is carried as its Xo
// source text (`List[ResourceGroup]`).

use std/json
use github.com/xo-lang/azure/codegen/spec

pub struct Field {
  pub name: Str
  pub wire: Str
  pub typ: Str
  pub doc: Str = ""
  /// Go's CONSTANT field (a one-value enum sealed to a string): the
  /// value Go's MarshalJSON writes in place of the field's, "" for none.
  pub constant: Str = ""
  /// The schema, or an allOf parent, lists it as required: Go writes a
  /// constant one always, an optional one only when set.
  pub required: Bool = false
}

pub struct Model {
  pub name: Str
  pub fields: List[Field]
  pub doc: Str = ""
  /// Only ever sent as (part of) a PATCH body: its fields are
  /// json.Patch[T], so a caller can send an explicit null (Go's
  /// azcore.NullValue), which JSON merge patch reads as "remove".
  pub patch: Bool = false
  /// The model this is the patch twin of (`VirtualMachineProperties` for
  /// `VirtualMachinePropertiesPatch`), "" for a spec model.
  pub twin_of: Str = ""
  /// Go's type is unexported (a TypeSpec rename to a lower-case name):
  /// the module's own, without `pub`.
  pub private: Bool = false
  /// The schema, or an allOf parent, has `additionalProperties: {}`
  /// beside its properties: Go's `AdditionalProperties map[string]any`,
  /// the keys no field names, written inline.
  pub extra: Bool = false
}

/// An extensible string enum (x-ms-enum): a newtype with constants.
pub struct StrEnum {
  pub name: Str
  pub values: List[(Str, Str, Str)]
  pub doc: Str = ""
  /// The value type: Str, or Int for an integer enum (Go's int32).
  pub base: Str = "Str"
}

/// A number's name, as autorest.go names an integer enum's values
/// (`FirewallPolicyIDPSSignatureDirectionFive`).
fn number_name(v: Str) -> Str {
  let names = ["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen", "Twenty"]
  let n = Int.parse(v) ?? return v
  if n >= 0 && n < names.len() { names[n] } else { v }
}

pub struct Param {
  pub name: Str
  /// Go's parameter name (in its error messages).
  pub go_name: Str = ""
  pub wire: Str
  /// path, query, header or body
  pub loc: Str
  pub required: Bool
  pub typ: Str
  pub skip_encoding: Bool = false
  /// An array sent as one query parameter per value (collectionFormat
  /// multi; Go's `for _, qv := range ...{ reqQP.Add(...) }`).
  pub multi: Bool = false
  /// subscriptionId: a client field
  pub client: Bool = false
  /// api-version and other constants
  pub constant: Str? = None
  /// An optional single-value sealed enum: Go's option is a *string, and
  /// when set the constant is sent, not its value (armstorage's
  /// failoverType is always "Planned").
  pub opt_constant: Str? = None
  pub doc: Str = ""
  /// A body sent as it is (`format: binary` or `file`; Go's
  /// io.ReadSeekCloser), not as JSON.
  pub binary: Bool = false
  /// A `format: date` parameter: a Time written as its date
  /// (runtime.date_text).
  pub date: Bool = false
}

pub struct Op {
  /// Go's client group (`ResourceGroups`) and method (`CreateOrUpdate`).
  pub group: Str
  pub name: Str
  pub method: Str
  pub path: Str
  pub params: List[Param]
  pub ok: List[Int]
  /// The response body's type name, None without a body.
  pub resp: Str? = None
  pub pageable: Bool = false
  pub next_link: Str? = None
  pub item_name: Str = "value"
  pub lro: Bool = false
  /// Whether a response has a body schema (Go sends Accept then).
  pub accept: Bool = true
  /// A pageable long-running operation: its result is a pager whose
  /// first page is the operation's final response (Go's
  /// `Poller[*Pager[T]]`).
  pub paged_lro: Bool = false
  pub final_state: Str = ""
  /// The operation's poller is runtime.new_status_poller (a Go
  /// module's custom handler, such as azadmin's restorePoller).
  pub status_poller: Bool = false
  pub doc: Str = ""
  /// The operation's `produces` content types (Go's Accept value).
  pub produces: List[Str] = []
  /// The headers of its success responses (wire names, in order) and
  /// whether each is an integer.
  /// Each success header and its kind: "int", "bool", "time" (RFC 1123)
  /// or "" (text).
  pub resp_headers: List[(Str, Str)] = []
  /// The operation's `consumes` content types (a binary body's
  /// Content-Type).
  pub consumes: List[Str] = []
  /// A success response's body is binary (`format: file` or `binary`):
  /// `Bytes` as received, in the response field `body_field`.
  pub binary_resp: Bool = false
  /// A string response the operation also produces as `text/*`
  /// (armautomation's `text/powershell`): TypeSpec's Go emitter reads
  /// the body as text, unparsed.
  pub text_resp: Bool = false
  pub body_field: Str = ""
}

/// A polymorphic type (a definition with a `discriminator`): Go's
/// `<Base>Classification` interface, here an enum of its subtypes and,
/// for any other discriminator value, the base.
pub struct Poly {
  pub name: Str
  pub base: Str
  /// The discriminator's wire key (`ruleType`).
  pub tag: Str
  /// Each subtype and its discriminator value.
  pub variants: List[(Str, Str)]
  pub doc: Str = ""
}

pub struct Api {
  pub api_version: Str
  pub ops: List[Op]
  pub models: List[Model]
  pub enums: List[StrEnum]
  pub polys: List[Poly] = []
  pub report: List[Str]
}

/// A module's renames and fixes beyond the OpenAPI: TypeSpec's Go
/// `@@clientName`s (read from client.tsp) and the transforms Go's
/// module applies after generating (codegen/custom/<module>.toml).
pub struct Custom {
  /// tspconfig.yaml's typespec-go `stutter`: the name Go's emitter drops
  /// from the front of type names in place of the package's
  /// (armdeployments' `resources`); "" for the package's.
  pub stutter: Str = ""
  /// operationId (any case) to Go's operation name.
  pub ops: Map[Str, Str] = {}
  /// A client parameter an operation's method takes instead
  /// (`operationid#wire`, lower case operationId): TypeSpec's
  /// `@@clientLocation(Iface.op::parameters.p, Iface.op)`.
  pub method_params: List[Str] = []
  /// TypeSpec's `@@clientInitialization` parameters for Go (wire names):
  /// client parameters, as subscriptionId.
  pub client_params: List[Str] = []
  /// TypeSpec's ARM actions Go routes by another name (spec.Renames'
  /// action_routes): operationId, lower case, to (old segment, new).
  pub action_routes: Map[Str, (Str, Str)] = {}
  /// TypeSpec's `op is ArmResourcePatch(Async|Sync)<R, P>`: operationId,
  /// lower case, to R, Go's body type.
  pub patch_bodies: Map[Str, Str] = {}
  /// An OpenAPI `<Model>Update` or `<Model>Patch` definition (TypeSpec's
  /// update visibility, which the autorest emitter writes as its own
  /// definition) is `<Model>` when its properties are a subset of
  /// `<Model>`'s, as Go's emitter, which reads the TypeSpec, has it.
  pub merge_update_variants: Bool = false
  /// False: a PATCH body's models are plain (each field optional, None
  /// left out), as Go's are when the body is not a merge patch (Batch
  /// sends `application/json; odata=minimalmetadata`).
  pub patch_twins: Bool = true
  /// A TypeSpec `@client` block's operations (operationId, lower case)
  /// to Go's names; when set, the others are left out and these are on
  /// the package's Client.
  pub client_ops: Map[Str, Str] = {}
  /// `Definition.property` to its type (TypeSpec's `@@alternateType`).
  pub alt_fields: Map[Str, Str] = {}
  /// Parameter wire name to its type (`@alternateType` on a parameter).
  pub param_types: Map[Str, Str] = {}
  /// Long-running operations (operationId, lower case) whose Go module
  /// polls them with a custom handler that runtime.new_status_poller ports.
  pub status_pollers: List[Str] = []
  /// definition name to Go's type name.
  pub models: Map[Str, Str] = {}
  /// `Definition.property` to Go's field name.
  pub fields: Map[Str, Str] = {}
  /// TypeSpec renames for other emitters, not Go (spec.Renames
  /// not_go_fields): `Model.client name` to Go's name.
  pub not_go_fields: Map[Str, Str] = {}
  /// parameter wire name to Go's parameter name.
  pub params: Map[Str, Str] = {}
  /// Go field name (lower case) of a `Str` field to its type (`ID`).
  pub field_types: Map[Str, Str] = {}
  /// Generated type names replaced by another type (`DeletionRecoveryLevel` by `Str`).
  pub replace_types: Map[Str, Str] = {}
  /// Parameters dropped from every operation (wire names).
  pub drop_params: List[Str] = []
  /// operationId (lower case) to its path parameters' wire names in Go's
  /// order (custom `param_order`).
  pub param_order: Map[Str, List[Str]] = {}
  /// Path parameters that may be empty (wire names).
  pub allow_empty: List[Str] = []
  /// autorest's modelerfour `seal-single-value-enum-by-default`: an
  /// enum with one value is that string (a required parameter, a
  /// constant), not a type.
  pub seal_single_value_enums: Bool = false
  /// `date-time` fields are azcore.DateTimeUTC, written in UTC as Go's
  /// module writes them.
  pub utc_date_times: Bool = false
  /// A module TypeSpec emits: a definition key qualified by a namespace
  /// (`Azure.ResourceManager.CommonTypes.Encryption`) is named by its
  /// last segment, the TypeSpec type's own name, as Go's emitter does.
  pub tsp: Bool = false
  /// A common-types model (by name) to the project's model Go uses in
  /// its place (`@@alternateType`: armstorage's UserAssignedIdentity).
  pub alt_models: Map[Str, Str] = {}
  /// operationId (lower case) to the TypeSpec interface and operation
  /// that Go's emitter names it by, where they differ.
  pub tsp_ops: Map[Str, (Str, Str)] = {}
  /// A rename for one emitted file's model, keyed `<file name>#<Model>`
  /// (`ComputeRP.json#NetworkAccessPolicy`).
  pub file_models: Map[Str, Str] = {}
  /// An ARM module from TypeSpec: operationId (lower case) to its
  /// `@useFinalStateVia`; the OpenAPI file's final-state-via is not used.
  pub final_states: Map[Str, Str] = {}
  /// Go's unused `<Op>ParameterBody` models (spec.Renames.body_roots):
  /// (model, field, field type, field documentation).
  pub body_roots: List[(Str, Str, Str, Str)] = []
  /// Enum values Go's transforms delete, by enum: wire values.
  pub drop_values: Map[Str, List[Str]] = {}
  /// A data-plane module: operations without a group stay on its Client.
  pub data_plane: Bool = false
  /// The response field of an operation's binary body (operationId,
  /// lower case), Go's name for it (`BlobData`); `Body` otherwise.
  pub body_fields: Map[Str, Str] = {}
  /// Emit only the types operations reach (TypeSpec's Go emitter), not
  /// every definition (autorest.go).
  pub reachable_only: Bool = false
  /// Every definition is emitted though the shapes are TypeSpec's (a
  /// models-only TypeSpec module, azsystemevents: its tspconfig keeps
  /// unreachable types).
  pub all_definitions: Bool = false
}

pub struct Builder {
  custom: Custom = Custom{}
  files: Map[Str, json.Value]
  /// The first input file (build's).
  primary: Str = ""
  models: List[Model] = []
  enums: List[StrEnum] = []
  /// Each string enum's values with their sort keys, so a second
  /// x-ms-enum of the same name adds its values (modelerfour's union).
  enum_keys: Map[Str, List[(Str, (Str, Str, Str))]] = {}
  polys: List[Poly] = []
  known: Map[Str, Str] = {}
  /// The package's api-version: the first input file with operations.
  api_version: Str = ""
  /// `file#definition` to its type, so two definitions with one name
  /// stay apart (the later one is `<Name>AutoGenerated`, as modelerfour
  /// names it).
  ids: Map[Str, Str] = {}
  /// A model name's first definition (file, schema), to merge an
  /// identical later one (modelerfour's lenient deduplication).
  firsts: Map[Str, (Str, json.Value)] = {}
  /// Definitions whose shape is being computed.
  shaping: List[Str] = []
  report: List[Str] = []
  /// The package's name without `arm` (`resources`): Go's generator
  /// drops it from the front of type names (`ResourcesMoveInfo` is
  /// `MoveInfo`), so names don't stutter.
  stutter: Str = ""
}

pub fn builder(files: Map[Str, json.Value], package: Str, custom: Custom = Custom{}) -> Builder {
  let p = package.to_lower()
  // autorest.go drops a data plane package's name from its groups too,
  // without its `az` (azcontainerregistry's ContainerRegistryBlob is Blob)
  // TypeSpec's Go emitter too (azbatch's BatchJob is Job)
  let stem = if p.starts_with("arm") { p[3..p.len()] } else if custom.data_plane && p.starts_with("az") { p[2..p.len()] } else { p }
  Builder{files: files, custom: custom, stutter: if custom.stutter != "" { custom.stutter.to_lower() } else { stem }}
}

/// A name with a word repeated back to back said once, as modelerfour
/// names types (`RoleInstanceInstanceView` is `RoleInstanceView`).
fn dedup_words(s: Str) -> Str {
  var out: List[Str] = []
  for w in words(s) {
    if out.is_empty() || (out.last() ?? "").to_lower() != w.to_lower() {
      out.push(w)
    }
  }
  out.map(fn(w: Str) -> Str { "${w[0..1].to_upper()}${w[1..w.len()]}" }).join("")
}

/// An x-ms-enum's type name: Go keeps the package name in it
/// (armstorage's StorageAccountExpand).
fn (b: Builder) enum_name(s: Str) -> Str {
  // TypeSpec's Go emitter drops a data plane package's name from enums
  // too (azbatch's BatchJobState is JobState)
  let n = pascal(b.local(s))
  b.custom.models.get(s).map(fn(r: Str) -> Str { reserve(r) }) ?? (if b.custom.data_plane && b.custom.tsp { b.unstutter(n) } else { n })
}

/// A TypeSpec module's namespace-qualified definition key without its
/// namespace; any other name as it is.
fn (b: Builder) local(s: Str) -> Str {
  if b.custom.tsp && s.contains(".") { s.split(".").last() ?? s } else { s }
}

/// `n` without the package name in front (when more follows it).
fn (b: Builder) unstutter(n: Str) -> Str {
  let k = b.stutter.len()
  if k > 0 && n.len() > k && n[0..k].to_lower() == b.stutter {
    let rest = n[k..n.len()]
    if rest[0..1] >= "A" && rest[0..1] <= "Z" {
      return rest
    }
  }
  n
}

/// The rename of model `n` that applies in `file` only.
fn (b: Builder) renamed_in(file: Str, n: Str) -> Str? {
  let base = file.split("/").last() ?? file
  if let Some(r) = b.custom.file_models.get("${base}#${n}") {
    return Some(reserve(r))
  }
  // a library type renamed by its TypeSpec name
  // (`Azure.ResourceManager.CommonTypes.Operation`), defined in
  // common-types' own file by its short name
  if file.contains("/common-types/") {
    for (k, r) in b.custom.models {
      if k.starts_with("Azure.") && k.ends_with(".${n}") {
        return Some(reserve(r))
      }
    }
  }
  None
}

/// A schema name as a type name, without the package's stutter.
fn (b: Builder) type_name(s: Str, dedup: Bool = true) -> Str {
  if let Some(r) = b.custom.models.get(s) {
    return reserve(r)
  }
  let l = b.local(s)
  let n = pascal(if dedup && !b.custom.tsp { dedup_words(l) } else { l })
  let k = b.stutter.len()
  if k > 0 && n.len() > k && n[0..k].to_lower() == b.stutter {
    let rest = n[k..n.len()]
    if rest[0..1] >= "A" && rest[0..1] <= "Z" {
      return pascal(rest)
    }
  }
  n
}

fn str_of(v: json.Value?) -> Str {
  match v {
    Some(json.Value.Str(s)) => s
    _ => ""
  }
}

fn bool_of(v: json.Value?) -> Bool {
  match v {
    Some(json.Value.Bool(b)) => b
    _ => false
  }
}

fn list_of(v: json.Value?) -> List[json.Value] {
  match v {
    Some(json.Value.List(xs)) => xs
    _ => []
  }
}

fn fields_of(v: json.Value?) -> List[(Str, json.Value)] {
  match v {
    Some(json.Value.Object(fs)) => fs
    _ => []
  }
}

fn doc_of(v: json.Value) -> Str {
  let d = str_of(v.get("description"))
  if d != "" { d } else { str_of(v.get("title")) }
}

/// Follows `$ref`s to the schema itself: its file, pointer and value.
fn (b: Builder) deref(file: Str, v: json.Value) -> (Str, Str, json.Value) {
  var f = file
  var p = ""
  var x = v
  var hops = 0
  while hops < 20 {
    let r = str_of(x.get("$ref"))
    if r == "" {
      break
    }
    let (nf, np) = spec.split_ref(f, r)
    let doc = b.files.get(nf) ?? break
    x = spec.at(doc, np) ?? break
    f = nf
    p = np
    hops += 1
  }
  (f, p, x)
}

/// A common-types definition that `@@alternateType` replaces: the
/// project's definition of the name it gives, in the first input file.
fn (b: Builder) alt_model(f: Str, p: Str, x: json.Value) -> (Str, Str, json.Value) {
  if !f.contains("/common-types/") || !p.starts_with("/definitions/") {
    return (f, p, x)
  }
  let to = b.custom.alt_models.get(spec.last(p)) ?? return (f, p, x)
  let np = "/definitions/${to}"
  let doc = b.files.get(b.primary) ?? return (f, p, x)
  let nx = spec.at(doc, np) ?? return (f, p, x)
  (b.primary, np, nx)
}

/// Every `$ref` in `v`.
fn refs_in(v: json.Value) -> List[Str] {
  var out: List[Str] = []
  match v {
    json.Value.Object(kvs) => {
      for (k, x) in kvs {
        if k == "\$ref" {
          out.push(str_of(Some(x)))
        } else {
          out = out + refs_in(x)
        }
      }
    }
    json.Value.List(xs) => {
      for x in xs {
        out = out + refs_in(x)
      }
    }
    _ => {}
  }
  out
}

/// An update visibility variant's base definition (merge_update_variants,
/// or a TypeSpec ARM module's library variant).
fn (b: Builder) update_base(f: Str, p: Str, x: json.Value) -> (Str, Str, json.Value) {
  if !p.starts_with("/definitions/") {
    return (f, p, x)
  }
  let name = spec.last(p)
  // A TypeSpec ARM module's library variant
  // (`Azure.ResourceManager.CommonTypes.ManagedServiceIdentityUpdate`)
  // is always its base: no Go module has one (every emitter version;
  // armcommvaultcontentstore, armagricultureplatform). A resource's own
  // `...Update` is a TypeSpec model Go has too.
  let library = b.custom.tsp && !b.custom.data_plane && name.contains(".")
  if !library && !(b.custom.merge_update_variants && b.custom.data_plane) {
    return (f, p, x)
  }
  for suffix in ["Update", "Patch"] {
    if name.ends_with(suffix) && name.len() > suffix.len() {
      let base = name[0..name.len() - suffix.len()]
      let doc = b.files.get(f) ?? return (f, p, x)
      // a library variant's base is the common-types definition the
      // file refers to (`.../managedidentity.json#/definitions/
      // ManagedServiceIdentity`)
      let (bf, bp, bx) = match spec.at(doc, "/definitions/${base}") {
        Some(v) => (f, "/definitions/${base}", v)
        None => {
          let short = base.split(".").last() ?? base
          let r = refs_in(doc).filter(fn(r: Str) -> Bool { r.ends_with("#/definitions/${short}") }).get(0) ?? continue
          let (f2, p2, x2) = b.deref(f, json.Value.Object([("\$ref", json.Value.Str(r))]))
          if p2 == "" { continue }
          (f2, p2, x2)
        }
      }
      let mine = fields_of(x.get("properties")).map(fn(kv: (Str, json.Value)) -> Str { kv.0 })
      let theirs = fields_of(bx.get("properties")).map(fn(kv: (Str, json.Value)) -> Str { kv.0 })
      if mine.all(fn(k: Str) -> Bool { theirs.contains(k) }) {
        return (bf, bp, bx)
      }
    }
  }
  (f, p, x)
}

/// The Xo type of a schema; `hint` names an inline object.
pub fn (var b: Builder) type_of(file: Str, v: json.Value, hint: Str) -> Str {
  if str_of(v.get("$ref")) != "" {
    let (f0, p0, x0) = b.deref(file, v)
    let (f1, p1, x1) = b.alt_model(f0, p0, x0)
    let (f, p, x) = b.update_base(f1, p1, x1)
    if p.starts_with("/definitions/") {
      let t = b.named(f, spec.last(p), x)
      // A struct with a discriminator stands for its subtypes too.
      if str_of(x.get("discriminator")) != "" && b.known.get(t) == Some(t) {
        return b.poly(f, spec.last(p), x, t)
      }
      return t
    }
    if str_of(x.get("$ref")) != "" {
      // a $ref that does not resolve: reported, never followed forever
      b.report.push("${hint}: unresolved \$ref ${str_of(x.get("$ref"))}")
      return "json.Value"
    }
    return b.type_of(f, x, hint)
  }
  b.inline(file, v, hint)
}

/// Whether definition `v` (in `file`) has the definition `root_def` of
/// `root_file` among its allOf ancestors.
fn (b: Builder) descends(file: Str, v: json.Value, root_file: Str, root_def: Str, depth: Int) -> Bool {
  if depth > 10 {
    return false
  }
  for parent in list_of(v.get("allOf")) {
    let r = str_of(parent.get("$ref"))
    if r == "" {
      continue
    }
    let (pf, pp, px) = b.deref(file, parent)
    if pf == root_file && pp == "/definitions/${root_def}" {
      return true
    }
    if b.descends(pf, px, root_file, root_def, depth + 1) {
      return true
    }
  }
  false
}

/// The polymorphic type of the definition `def` (type `base`): its
/// subtypes are the definitions of every file that descend from it.
fn (var b: Builder) poly(file: Str, def: Str, v: json.Value, base: Str) -> Str {
  let name = "${base}Classification"
  if b.known.contains(name) {
    return name
  }
  b.known[name] = name
  var variants: List[(Str, Str)] = []
  for (f, doc) in b.files {
    for (d, x) in fields_of(doc.get("definitions")) {
      if (f == file && d == def) || !b.descends(f, x, file, def, 0) {
        continue
      }
      let t = b.named(f, d, x)
      if variants.any(fn(e: (Str, Str)) -> Bool { e.0 == t }) {
        continue
      }
      let value = str_of(x.get("x-ms-discriminator-value"))
      variants.push((t, if value != "" { value } else { d }))
    }
  }
  b.polys.push(Poly{name: name, base: base, tag: str_of(v.get("discriminator")), variants: variants, doc: "${name}: a ${base} by its ${str_of(v.get("discriminator"))}, Go's ${name} interface."})
  name
}

/// A schema's structure without its documentation, keys sorted and
/// each `$ref` replaced by the type it resolves to, to compare two
/// definitions of one name. A definition being shaped stands for
/// itself (recursive types).
fn (var b: Builder) shape(file: Str, v: json.Value) -> Str {
  b.strip_docs(file, v).encode()
}

fn (var b: Builder) strip_docs(file: Str, v: json.Value) -> json.Value {
  match v {
    json.Value.Object(fs) => {
      var out: List[(Str, json.Value)] = []
      for (k, x) in fs.sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }) {
        if k == "description" || k == "title" || k == "x-ms-examples" {
          continue
        }
        // a reachable-only module emits no allOf parent: compare the
        // parent's own shape, not the type it would be
        if k == "allOf" && b.custom.reachable_only {
          var ps: List[json.Value] = []
          for parent in list_of(Some(x)) {
            if str_of(parent.get("$ref")) != "" {
              let (pf, pp, pv) = b.deref(file, parent)
              let id = "${pf}#${spec.last(pp)}"
              if b.shaping.contains(id) {
                ps.push(json.Value.Str(id))
              } else {
                b.shaping.push(id)
                ps.push(b.strip_docs(pf, pv))
                b.shaping.pop()
              }
            } else {
              ps.push(b.strip_docs(file, parent))
            }
          }
          out.push((k, json.Value.List(ps)))
          continue
        }
        if k == "$ref" {
          if let json.Value.Str(r) = x {
            let (f, p) = spec.split_ref(file, r)
            let id = "${f}#${spec.last(p)}"
            let t = if b.shaping.contains(id) { id } else { b.type_of(file, json.Value.Object([("$ref", x)]), "") }
            out.push((k, json.Value.Str(t)))
            continue
          }
        }
        out.push((k, b.strip_docs(file, x)))
      }
      json.Value.Object(out)
    }
    json.Value.List(xs) => {
      var out: List[json.Value] = []
      for x in xs {
        out.push(b.strip_docs(file, x))
      }
      json.Value.List(out)
    }
    other => other
  }
}

/// Whether `v` is an enum of one value that is sealed to a string.
fn (b: Builder) sealed(v: json.Value) -> Bool {
  // an integer one (analysisservices' GatewayListStatusLive.status) is
  // Go's plain int32
  if list_of(v.get("enum")).len() != 1 || str_of(v.get("type")) == "integer" {
    return false
  }
  // modelAsString false always seals; unset, only with the flag.
  match v.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("modelAsString") }) {
    Some(json.Value.Bool(m)) => !m
    _ => b.custom.seal_single_value_enums
  }
}

fn (var b: Builder) inline(file: Str, v: json.Value, hint: Str) -> Str {
  if b.sealed(v) {
    return "Str"
  }
  let one_int = list_of(v.get("enum")).len() == 1 && model_as_string(v) == Some(false)
  if v.get("x-ms-enum").is_some() && int_enum(v) && !one_int {
    let name = str_of(v.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("name") }))
    if name != "" {
      return b.str_enum(b.enum_name(name), v, base: "Int")
    }
  }
  if v.get("x-ms-enum").is_some() && str_of(v.get("type")) == "string" {
    let name = str_of(v.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("name") }))
    if name != "" {
      return b.str_enum(b.renamed_in(file, name) ?? b.enum_name(name), v)
    }
  }
  // an enum without x-ms-enum: modelerfour's sealed choice, named
  // from where it is (a form field's is `PostContentSchema<Field>`)
  if v.get("x-ms-enum").is_none() && str_of(v.get("type")) == "string" && list_of(v.get("enum")).len() > 1 && hint != "" {
    return b.str_enum(b.enum_name(hint), v)
  }
  match str_of(v.get("type")) {
    "string" => match str_of(v.get("format")) {
      "date-time" => if b.custom.utc_date_times { "azcore.DateTimeUTC" } else { "azcore.DateTime" }
      "date-time-rfc1123" => "azcore.DateTimeRFC1123"
      // typespec-go's datetime.RFC7231 (armstorage v4's FileShareProperties)
      "date-time-rfc7231" => "azcore.DateTimeRFC7231"
      "base64url" => "azcore.Base64URL"
      "byte" => "Bytes"
      _ => "Str"
    }
    "integer" => if str_of(v.get("format")) == "unixtime" { "azcore.UnixTime" } else { "Int" }
    // Go's float32 (decision on Float32): `format: float`
    "number" => if str_of(v.get("format")) == "float" { "Float32" } else { "Float" }
    "boolean" => "Bool"
    "array" => {
      let items = v.get("items") ?? return "List[json.Value]"
      "List[${b.type_of(file, items, "${hint}Item")}]"
    }
    _ => {
      let props = fields_of(v.get("properties"))
      if props.is_empty() && v.get("allOf").is_none() {
        match v.get("additionalProperties") {
          Some(json.Value.Object(fs)) => return "Map[Str, ${b.type_of(file, json.Value.Object(fs), "${hint}Value")}]"
          // `true` is `{}`: Go's map[string]any
          Some(json.Value.Bool(true)) => return "Map[Str, json.Value]"
          _ => {}
        }
        return "json.Value"
      }
      b.named(file, hint, v, inline: true)
    }
  }
}

/// An enum of whole numbers: `integer`, or TypeSpec's `number` whose
/// values are all integers (armnetwork v12's
/// FirewallPolicyIDPSSignatureDirection, Go's int32).
fn int_enum(v: json.Value) -> Bool {
  match str_of(v.get("type")) {
    "integer" => true
    "number" => {
      let vals = list_of(v.get("enum"))
      !vals.is_empty() && vals.all(fn(x: json.Value) -> Bool {
        let s = x.encode()
        s != "" && !s.contains(".") && !s.contains("e") && !s.contains("E") && !s.contains("\"")
      })
    }
    _ => false
  }
}

fn (var b: Builder) str_enum(given: Str, v: json.Value, base: Str = "Str") -> Str {
  // Merging would give two constants one name ("default" and
  // "Default"): the later enum stays apart, `<Name>AutoGenerated`, as in
  // Go (armsynapse's SecurityAlertPolicyName path parameters).
  var name = given
  if b.enum_clash(name, v) {
    var n = 1
    name = "${given}AutoGenerated"
    while b.enum_keys.contains(name) && b.enum_clash(name, v) {
      n += 1
      name = "${given}AutoGenerated${n}"
    }
  }
  let merging = b.enum_keys.contains(name)
  if b.known.contains(name) && !merging {
    return name
  }
  b.known[name] = name
  // Go's order: autorest.go and the TypeSpec Go emitter list a type's
  // constants, and its Possible<Type>Values, sorted by Go name.
  var keyed: List[(Str, (Str, Str, Str))] = []
  let named = list_of(v.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("values") }))
  if !named.is_empty() {
    for x in named {
      let value = match x.get("value") {
        Some(json.Value.Str(s)) => s
        Some(other) => other.encode()
        None => ""
      }
      let n = str_of(x.get("name"))
      // an integer value named by itself (TypeSpec's `0 | 1`) is named
      // as a number word, as Go names it (`...DirectionFive`)
      let raw = if base == "Int" && (n == "" || n == value) { number_name(value) } else if n != "" { n } else { value }
      keyed.push((value_part(raw), (screaming(raw), value, str_of(x.get("description")))))
    }
  } else {
    for x in list_of(v.get("enum")) {
      let value = match x {
        json.Value.Str(s) => s
        other => other.encode()
      }
      let raw = if base == "Int" { number_name(value) } else { value }
      keyed.push((value_part(raw), (screaming(raw), value, "")))
    }
  }
  // Two x-ms-enums of one name are one type with every value of both,
  // as modelerfour merges them (armstorage's ProvisioningState: the
  // account's three and the task assignment's eight); the first's
  // documentation stays.
  if merging {
    var before = b.enum_keys.get(name) ?? []
    for k in keyed {
      if !before.any(fn(x: (Str, (Str, Str, Str))) -> Bool { x.1.1 == k.1.1 }) {
        before.push(k)
      }
    }
    keyed = before
  }
  b.enum_keys[name] = keyed
  var vals = keyed.sort_by(fn(k: (Str, (Str, Str, Str))) -> Str { k.0 }).map(fn(k: (Str, (Str, Str, Str))) -> (Str, Str, Str) { k.1 })
  let dropped = b.custom.drop_values.get(name) ?? []
  vals = vals.filter(fn(x: (Str, Str, Str)) -> Bool { !dropped.contains(x.1) })
  if merging {
    b.enums = b.enums.map(fn(e: StrEnum) -> StrEnum { if e.name == name { e with {values: vals} } else { e } })
  } else {
    b.enums.push(StrEnum{name: name, values: vals, doc: doc_of(v), base: base})
  }
  name
}

/// An enum `v`'s values would clash with enum `name`'s: a value that
/// differs from one of them only in case.
fn (b: Builder) enum_clash(name: Str, v: json.Value) -> Bool {
  let have = (b.enum_keys.get(name) ?? []).map(fn(k: (Str, (Str, Str, Str))) -> Str { k.1.1 })
  for x in list_of(v.get("enum")) {
    if let json.Value.Str(s) = x {
      if !have.contains(s) && have.any(fn(h: Str) -> Bool { h.to_lower() == s.to_lower() }) {
        return true
      }
    }
  }
  false
}

/// The modules a client file uses: a parameter of one of their names
/// would hide it in the method's body.
const CLIENT_MODULES: List[Str] = ["arm", "azcore", "http", "json", "policy", "regexp", "runtime", "url"]

/// A parameter's Xo name: Go's in snake_case, with `_` after a module's
/// name (armdevtestlabs' `policy` body is `policy_`, as a keyword is).
fn param_name(go_name: Str) -> Str {
  let n = snake(go_name)
  if CLIENT_MODULES.contains(n) { "${n}_" } else { n }
}

/// A definition: a struct, an enum, or the primitive it stands for.
fn (var b: Builder) named(file: Str, def: Str, v: json.Value, inline: Bool = false) -> Str {
  let id = "${file}#${def}"
  if let Some(t) = b.ids.get(id) {
    return t
  }
  // A definition's x-ms-client-name renames its type; on an inline
  // schema it names the property. A repeated word is said once only in a
  // definition's own name, not in a name composed for an inline schema.
  let cn = if inline { "" } else { str_of(v.get("x-ms-client-name")) }
  var name = if inline { b.type_name(def, dedup: false) } else { b.renamed_in(file, def) ?? b.type_name(if cn != "" { cn } else { def }) }
  if bool_of(v.get("x-ms-external")) {
    b.ids[id] = "json.Value"
    return "json.Value"
  }
  if b.sealed(v) {
    b.ids[id] = "Str"
    return "Str"
  }
  // An object with no properties, parent, or map values is any JSON, as
  // modelerfour reads it (Go's `any`): NspAssociationReconcile, and
  // armmachinelearning's PartialUserAssignedIdentity (`additionalProperties:
  // false`; from TypeSpec, Go keeps that an empty struct:
  // armiotoperations' DataflowEndpointAuthenticationAnonymous).
  if !inline && list_of(v.get("enum")).is_empty() && fields_of(v.get("properties")).is_empty() && v.get("allOf").is_none() && (v.get("additionalProperties").is_none() || (!b.custom.tsp && v.get("additionalProperties") == Some(json.Value.Bool(false)))) && v.get("discriminator").is_none() && (str_of(v.get("type")) == "object" || str_of(v.get("type")) == "") {
    b.ids[id] = "json.Value"
    return "json.Value"
  }
  if let Some(r) = b.custom.replace_types.get(name) {
    b.ids[id] = r
    return r
  }
  // An enum is known by its x-ms-enum name, which may repeat.
  if !list_of(v.get("enum")).is_empty() {
    let en = str_of(v.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("name") }))
    let t = b.str_enum(if en != "" { b.renamed_in(file, en) ?? b.enum_name(en) } else { name }, v, base: if int_enum(v) { "Int" } else { "Str" })
    b.ids[id] = t
    return t
  }
  // From TypeSpec one name is one model: an older API version's copy of
  // it in another file (armnetwork v12's 2018-10-01 vmssNetwork.json
  // `NetworkInterface`) is the model Go emits once, not a second type.
  if b.custom.tsp && b.firsts.contains(name) {
    let t = b.known.get(name) ?? name
    b.ids[id] = t
    return t
  }
  if let Some((ff, fv)) = b.firsts.get(name) {
    b.shaping.push(id)
    let same = b.shape(ff, fv) == b.shape(file, v)
    b.shaping.pop()
    if same {
      let t = b.known.get(name) ?? name
      b.ids[id] = t
      return t
    }
  }
  if b.known.contains(name) {
    var n = 1
    var cand = "${name}AutoGenerated"
    while b.known.contains(cand) {
      n += 1
      cand = "${name}AutoGenerated${n}"
    }
    name = cand
  }
  let t = b.named_as(file, def, name, v)
  b.ids[id] = t
  t
}

fn (var b: Builder) named_as(file: Str, def: Str, name: Str, v: json.Value) -> Str {
  if let Some(r) = b.custom.replace_types.get(name) {
    b.known[name] = r
    return r
  }
  if !list_of(v.get("enum")).is_empty() {
    let en = str_of(v.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("name") }))
    return b.str_enum(if en != "" { b.renamed_in(file, en) ?? b.type_name(en) } else { name }, v, base: if int_enum(v) { "Int" } else { "Str" })
  }
  let props = fields_of(v.get("properties"))
  let t = str_of(v.get("type"))
  if props.is_empty() && v.get("allOf").is_none() && (t != "object" && t != "") {
    return b.inline(file, v, def)
  }
  if props.is_empty() && v.get("allOf").is_none() {
    // `additionalProperties: true` is `{}`, Go's map[string]any
    // (armapimanagement's ContentItemContractProperties)
    let ap = match v.get("additionalProperties") {
      Some(json.Value.Bool(true)) => Some(json.Value.Object([]))
      other => other
    }
    if let Some(json.Value.Object(fs)) = ap {
      let m = "Map[Str, ${b.type_of(file, json.Value.Object(fs), "${def}Value")}]"
      b.known[name] = m
      return m
    }
  }
  // mark before the fields, for recursive types
  b.known[name] = name
  if !b.firsts.contains(name) {
    b.firsts[name] = (file, v)
  }
  b.ids["${file}#${def}"] = name
  // Go emits allOf parents as types of their own too, unless it keeps
  // only the types operations reach (a parent's fields are copied).
  for parent in if b.custom.reachable_only { [] } else { list_of(v.get("allOf")) } {
    if str_of(parent.get("$ref")) != "" {
      b.type_of(file, parent, "")
    }
  }
  var fields: List[Field] = []
  var seen: List[Str] = []
  let required = b.required_of(file, v, 0)
  for (wire, prop, pf) in b.properties(file, v) {
    if seen.contains(wire) {
      continue
    }
    seen.push(wire)
    let raw_client = str_of(prop.get("x-ms-client-name"))
    // a Go rename by the property's own (wire) name first, then one by
    // the OpenAPI file's x-ms-client-name (or a rename for other
    // emitters undone), else that name
    let undone = if raw_client != "" { b.custom.not_go_fields.get("${def}.${raw_client}") } else { None }
    let client = b.custom.fields.get("${def}.${wire}") ?? undone ?? b.custom.fields.get("${def}.${if raw_client != "" { raw_client } else { wire }}") ?? raw_client
    // an inline schema is named after the definition's key, not its
    // x-ms-client-name (modelerfour names it before the rename: Compute's
    // Operation, renamed OperationValue, has an OperationDisplay)
    var typ = b.custom.alt_fields.get("${def}.${wire}") ?? b.type_of(pf, prop, "${def}${pascal_part(wire)}")
    let go_name = if client != "" { client } else { wire }
    if typ == "Str" {
      // `Model.field` first (one model's), then the field in every model.
      if let Some(t) = b.custom.field_types.get("${name}.${go_name}".to_lower()) ?? b.custom.field_types.get(go_name.to_lower()) {
        typ = t
      }
    } else if let Some(t) = b.custom.field_types.get("${name}.${go_name}".to_lower()) {
      // any other type (an x-ms-external one, a model Go's own generate
      // step swaps): a hand-written one, by `Model.field` only
      typ = t
    }
    let (_, _, target) = b.deref(pf, prop)
    let constant = match list_of(target.get("enum")).get(0) {
      Some(json.Value.Str(c)) if typ == "Str" && b.sealed(target) => c
      _ => ""
    }
    fields.push(Field{name: snake(go_name), wire: wire, typ: typ, doc: doc_of(prop), constant: constant, required: constant != "" && required.contains(wire)})
  }
  let private = b.custom.models.values().any(fn(r: Str) -> Bool { is_unexported(r) && reserve(r) == name })
  b.models.push(Model{name: name, fields: fields, doc: doc_of(v), private: private, extra: !fields.is_empty() && b.has_extra(file, v, 0)})
  name
}

/// Every property of a schema, its allOf parents' first, with the file
/// each is in.
fn (b: Builder) properties(file: Str, v: json.Value) -> List[(Str, json.Value, Str)] {
  var out: List[(Str, json.Value, Str)] = []
  for parent in list_of(v.get("allOf")) {
    let (f, _, x) = b.deref(file, parent)
    out = out + b.properties(f, x)
  }
  for (k, p) in fields_of(v.get("properties")) {
    out.push((k, p, file))
  }
  out
}

/// The required property names of a schema and its allOf parents.
fn (b: Builder) required_of(file: Str, v: json.Value, depth: Int) -> List[Str] {
  var out: List[Str] = []
  if depth < 20 {
    for parent in list_of(v.get("allOf")) {
      let (f, _, x) = b.deref(file, parent)
      out = out + b.required_of(f, x, depth + 1)
    }
  }
  for r in list_of(v.get("required")) {
    if let json.Value.Str(s) = r {
      out.push(s)
    }
  }
  out
}

/// `params` with those whose wire names `order` lists put in its order,
/// in the places they held together; the others stay where they are.
fn reordered(params: List[Param], order: List[Str]) -> List[Param] {
  var listed: List[Param] = []
  for w in order {
    for q in params {
      if q.wire == w && q.loc == "path" {
        listed.push(q)
      }
    }
  }
  var out: List[Param] = []
  var next = 0
  for q in params {
    if q.loc == "path" && order.contains(q.wire) && next < listed.len() {
      out.push(listed[next])
      next += 1
    } else {
      out.push(q)
    }
  }
  out
}

/// A schema of raw bytes: `format: binary` or `file` (any type), sent
/// and received as it is.
fn is_binary(v: json.Value?) -> Bool {
  let f = str_of(v.and_then(fn(x: json.Value) -> json.Value? { x.get("format") }))
  let t = str_of(v.and_then(fn(x: json.Value) -> json.Value? { x.get("type") }))
  f == "binary" || f == "file" || t == "file"
}

fn (var b: Builder) param(file: Str, raw: json.Value) -> Param {
  let (f, _, p) = b.deref(file, raw)
  let wire = str_of(p.get("name"))
  let loc = str_of(p.get("in"))
  let binary = loc == "body" && is_binary(p.get("schema"))
  // The api-version is a constant: its enum (some files have one) is
  // not a type, as in Go.
  let typ = if wire == "api-version" {
    "Str"
  } else if binary {
    "Bytes"
  } else if loc == "body" {
    b.type_of(f, p.get("schema") ?? json.Value.Object([]), pascal(wire))
  } else if loc == "formData" {
    // modelerfour gathers a form's fields into one schema, POST's
    // `PostContentSchema`, and names an inline enum after its field
    b.custom.param_types.get(wire) ?? b.inline(f, p, "PostContentSchema${pascal_part(wire)}")
  } else if loc != "body" && str_of(p.get("format")) == "date" {
    // Go's time.Time, written by t.Format("2006-01-02") (armbilling's
    // periodStartDate)
    "Time"
  } else if loc == "header" && str_of(p.get("format")) == "date-time-rfc7231" {
    // TypeSpec's rfc7231 header (Batch's ocp-date): Go's *time.Time,
    // written by t.Format(time.RFC1123)
    "Time"
  } else {
    b.custom.param_types.get(wire) ?? b.inline(f, p, pascal(wire))
  }
  // a required parameter with a client default is optional (the
  // service's default applies when it is left out)
  let required = (bool_of(p.get("required")) && p.get("x-ms-client-default").is_none()) || loc == "path"
  let one = list_of(p.get("enum"))
  let sealed_one = one.len() == 1 && (model_as_string(p) == Some(false) || b.custom.seal_single_value_enums && model_as_string(p) != Some(true))
  let one_lit = match one.get(0) {
    Some(json.Value.Str(c)) => Some("\"${c.replace("\\", "\\\\").replace("\"", "\\\"")}\"")
    _ => None
  }
  // TypeSpec's `@apiVersion(false) @query("api-version") apiVersion:
  // string` is the method's argument in Go (armresources' generic
  // resource calls): in the OpenAPI, the only api-version written in the
  // operation with a client name; a library one is a $ref, and an
  // autorest file's inline one has no client name and stays the client's
  // (azwebpubsub, armservicefabric)
  let method_api_version = wire == "api-version" && one.is_empty() && raw.get("$ref").is_none() && str_of(p.get("x-ms-client-name")) != ""
  let constant = if wire == "api-version" && one.len() == 1 && one_lit.is_some() {
    // its own one value (Key Vault's vault list is 2015-11-01)
    if one_lit == Some("\"${b.api_version}\"") { Some("API_VERSION") } else { one_lit }
  } else if method_api_version {
    None
  } else if wire == "api-version" {
    // The operation's own file's version (compute mixes several);
    // API_VERSION when it is the package's.
    let fv = str_of(b.files.get(file).and_then(fn(d: json.Value) -> json.Value? { d.get("info") }).and_then(fn(i: json.Value) -> json.Value? { i.get("version") }))
    if fv == "" || fv == b.api_version { Some("API_VERSION") } else { Some("\"${fv}\"") }
  } else if required && sealed_one {
    one_lit
  } else {
    None
  }
  // TypeSpec's Go emitter camel-cases a quoted name (`setting-name` is
  // settingName)
  let plain = if b.custom.data_plane && wire.contains("-") { dash_camel(wire) } else { wire }
  // a form field keeps its wire name: the schema's property, which
  // x-ms-client-name does not rename (azcontainerregistry's refresh_token
  // is refreshToken, not acrRefreshToken)
  let client_name = if loc == "formData" { "" } else { str_of(p.get("x-ms-client-name")) }
  let go_name = b.custom.params.get(wire) ?? (if client_name != "" { client_name } else { plain })
  let client = wire == "subscriptionId" || (b.custom.client_params.contains(wire) && loc == "path") || (str_of(p.get("x-ms-parameter-location")) == "client" && wire != "api-version" && loc == "path")
  Param{
    name: param_name(go_name),
    go_name: go_name,
    wire: wire,
    loc: loc,
    required: required,
    typ: typ,
    skip_encoding: bool_of(p.get("x-ms-skip-url-encoding")),
    multi: str_of(p.get("collectionFormat")) == "multi" && loc == "query",
    client: client,
    date: loc != "body" && str_of(p.get("format")) == "date",
    constant: constant,
    opt_constant: if !required && sealed_one && wire != "api-version" { one_lit } else { None },
    doc: doc_of(p),
    binary: binary,
  }
}

/// The package's operations from `files` (its input files).
pub fn (var b: Builder) build(inputs: List[Str]) -> Api {
  b.primary = inputs.get(0) ?? ""
  var ops: List[Op] = []
  var version = ""
  // The default group (operations without one) is named after the
  // package's title, the first input file's (NetworkManagementClient is
  // ManagementClient).
  let title = str_of(b.files.get(inputs.get(0) ?? "").and_then(fn(d: json.Value) -> json.Value? { d.get("info") }).and_then(fn(i: json.Value) -> json.Value? { i.get("title") })).trim_suffix("Client")
  for file in inputs {
    let doc = b.files.get(file) ?? json.Value.Null
    if version == "" && (fields_of(doc.get("paths")).len() + fields_of(doc.get("x-ms-paths")).len()) > 0 {
      version = str_of(doc.get("info").and_then(fn(i: json.Value) -> json.Value? { i.get("version") }))
      b.api_version = version
    }
    for section in ["paths", "x-ms-paths"] {
      for (path, item) in fields_of(doc.get(section)) {
        let shared = list_of(item.get("parameters"))
        for (method, o) in fields_of(Some(item)) {
          if !["get", "put", "post", "delete", "patch", "head"].contains(method) {
            continue
          }
          let id = str_of(o.get("operationId"))
          let (raw_group, raw_name) = match b.custom.tsp_ops.get(id.to_lower()) {
            Some((g, n)) => (g, n[0..1].to_upper() + n[1..n.len()])
            None => match id.find("_") {
              Some(i) => (id[0..i], id[i + 1..id.len()])
              None => ("", id)
            }
          }
          if !b.custom.client_ops.is_empty() && !b.custom.client_ops.contains(id.to_lower()) {
            continue
          }
          let name = b.custom.client_ops.get(id.to_lower()) ?? b.custom.ops.get(id.to_lower()) ?? raw_name
          // Go drops the package name from a group too (StorageAccounts
          // is armstorage's Accounts), except a group named as the package.
          // An operation without a group is in the default one, named after
          // the file's title (NetworkManagementClient is ManagementClient);
          // a data-plane module keeps them on its Client.
          // Go's group names are case-folded (configurationPolicyGroups and
          // ConfigurationPolicyGroups are one client).
          let group = if !b.custom.client_ops.is_empty() { "" } else { part(b.unstutter(if raw_group == "" && !b.custom.data_plane { title } else { raw_group })) }
          var params: List[Param] = []
          for raw in shared + list_of(o.get("parameters")) {
            let p = b.param(file, raw)
            if b.custom.drop_params.contains(p.wire) {
              continue
            }
            params = params.filter(fn(q: Param) -> Bool { q.wire != p.wire || q.loc != p.loc })
            params.push(p)
          }
          // TypeSpec's Go emitter takes a PUT's or PATCH's optional body as
          // a parameter of the method, as a required one (armstorage's
          // TableClient.Create); an action's stays in the options.
          if b.custom.tsp && !b.custom.data_plane && (method == "put" || method == "patch") {
            params = params.map(fn(q: Param) -> Param { if q.loc == "body" { q with {required: true} } else { q } })
          }
          // TypeSpec's ArmResourcePatch<R, P>: Go's body is R itself, not
          // the OpenAPI file's `RUpdate` visibility variant
          // (armcommvaultcontentstore's CloudAccounts.BeginUpdate)
          if let Some(r) = b.custom.patch_bodies.get(id.to_lower()) {
            let has_def = b.files.get(file).and_then(fn(d: json.Value) -> json.Value? { spec.at(d, "/definitions/${r}") }).is_some()
            if has_def {
              let rt = b.type_of(file, json.Value.Object([("\$ref", json.Value.Str("#/definitions/${r}"))]), r)
              params = params.map(fn(q: Param) -> Param { if q.loc == "body" { q with {typ: rt} } else { q } })
            }
          }
          // a client parameter moved onto this operation is the method's
          params = params.map(fn(q: Param) -> Param { if q.client && b.custom.method_params.contains("${id.to_lower()}#${q.wire}") { q with {client: false} } else { q } })
          if let Some(order) = b.custom.param_order.get(id.to_lower()) {
            params = reordered(params, order)
          }
          // autorest.go takes the body last (azcontainerregistry's
          // uploadChunk(location, chunkData))
          if !b.custom.tsp {
            params = params.filter(fn(q: Param) -> Bool { q.loc != "body" }) + params.filter(fn(q: Param) -> Bool { q.loc == "body" })
          }
          let consumes = list_of(o.get("consumes")).map(fn(x: json.Value) -> Str { str_of(Some(x)) }).filter(fn(t: Str) -> Bool { t != "" })
          // a binary body of several content types: autorest.go's
          // `contentType ContentType` parameter before it
          if consumes.len() > 1 && params.any(fn(q: Param) -> Bool { q.binary }) {
            let ct = b.str_enum("ContentType", json.Value.Object([("type", json.Value.Str("string")), ("description", json.Value.Str("Content type for upload")), ("enum", json.Value.List(consumes.map(fn(c: Str) -> json.Value { json.Value.Str(c) })))]))
            var at = params.len()
            for (i, q) in params.indexed() {
              if q.binary && at == params.len() {
                at = i
              }
            }
            params = params[0..at] + [Param{name: "content_type", go_name: "contentType", wire: "Content-Type", loc: "header", required: true, typ: ct, doc: "Upload file type"}] + params[at..params.len()]
          }
          var okc: List[Int] = []
          var resp: Str? = None
          var binary_resp = false
          // autorest.go sends Accept when any response, the error one
          // too, has a schema
          var accept = false
          var resp_headers: List[(Str, Str)] = []
          let produces = list_of(o.get("produces")).map(fn(x: json.Value) -> Str { str_of(Some(x)) }).filter(fn(t: Str) -> Bool { t != "" })
          // an operation that produces only a binary type sends no Accept
          // for its error schema alone (ACR's DeleteBlob)
          let json_out = produces.is_empty() || produces.any(fn(t: Str) -> Bool { t.contains("json") })
          for (code, r) in fields_of(o.get("responses")) {
            if b.deref(file, r).2.get("schema").is_some() && (code != "default" || json_out) {
              accept = true
            }
            if code == "default" {
              // Go emits the error schema as a type too.
              if let Some(es) = if b.custom.reachable_only { None } else { b.deref(file, r).2.get("schema") } {
                b.type_of(file, es, "${group}${name}Error")
              }
            }
            let n = Int.parse(code) ?? continue
            // autorest.go: every declared status not marked as an error
            // response is a success (ACR's deletes declare 404)
            let error_response = b.deref(file, r).2.get("x-ms-error-response") == Some(json.Value.Bool(true))
            if n >= 300 && !error_response {
              okc.push(n)
            }
            if n >= 200 && n < 300 {
              okc.push(n)
              for (h, hv) in fields_of(b.deref(file, r).2.get("headers")) {
                if !resp_headers.any(fn(x: (Str, Str)) -> Bool { x.0 == h }) {
                  resp_headers.push((h, header_kind(hv)))
                }
              }
              if resp.is_none() {
                if let Some(s) = b.deref(file, r).2.get("schema") {
                  if is_binary(Some(s)) {
                    resp = Some("Bytes")
                    binary_resp = true
                  } else {
                    resp = Some(b.type_of(file, s, "${group}${name}Response"))
                  }
                }
              }
            }
          }
          // typespec-go reads a binary body's media type into ContentType
          // (the tsp's implicit content-type header), absent from the
          // OpenAPI headers (azbatch's GetNodeFile)
          if b.custom.tsp && binary_resp && !resp_headers.any(fn(x: (Str, Str)) -> Bool { x.0.to_lower() == "content-type" }) {
            resp_headers.push(("content-type", ""))
          }
          let pg = o.get("x-ms-pageable")
          let lro = bool_of(o.get("x-ms-long-running-operation"))
          let next = match pg.and_then(fn(x: json.Value) -> json.Value? { x.get("nextLinkName") }) {
            Some(json.Value.Str(s)) => Some(s)
            _ => None
          }
          let item_name = str_of(pg.and_then(fn(x: json.Value) -> json.Value? { x.get("itemName") }))
          let fsv = if b.custom.tsp && !b.custom.data_plane { b.custom.final_states.get(id.to_lower()) ?? "" } else { str_of(o.get("x-ms-long-running-operation-options").and_then(fn(x: json.Value) -> json.Value? { x.get("final-state-via") })) }
          for (k, _) in fields_of(Some(o)) {
            if k.starts_with("x-ms-") && !["x-ms-pageable", "x-ms-long-running-operation", "x-ms-long-running-operation-options", "x-ms-examples", "x-ms-odata", "x-ms-azure-rbac-permissions-required"].contains(k) {
              b.report.push("${id}: extension ${k} not handled")
            }
          }
          ops.push(Op{
            group: group,
            name: name,
            method: method.to_upper(),
            path: match b.custom.action_routes.get(id.to_lower()) {
              Some((old, new)) if path.ends_with("/${old}") => path[0..path.len() - old.len()] + new
              _ => path
            },
            params: params,
            ok: okc.sort(),
            resp: resp,
            pageable: pg.is_some() && !lro,
            next_link: next,
            item_name: if item_name == "" { "value" } else { item_name },
            lro: lro,
            paged_lro: pg.is_some() && lro,
            final_state: fsv,
            accept: accept,
            status_poller: lro && b.custom.status_pollers.contains(id.to_lower()),
            doc: doc_of(o),
            produces: produces,
            resp_headers: resp_headers,
            consumes: consumes,
            binary_resp: binary_resp,
            text_resp: resp == Some("Str") && produces.any(fn(t: Str) -> Bool { t.starts_with("text/") }),
            body_field: if binary_resp { b.custom.body_fields.get(id.to_lower()) ?? "Body" } else { "" },
          })
        }
      }
    }
  }
  // autorest.go emits every definition of the input files, used or not.
  for file in if b.custom.reachable_only && !b.custom.all_definitions { [] } else { inputs } {
    let doc = b.files.get(file) ?? json.Value.Null
    for (def, v) in fields_of(doc.get("definitions")) {
      // x-ms-external types come from elsewhere: Go does not emit them.
      if bool_of(v.get("x-ms-external")) {
        continue
      }
      b.named(file, def, v)
    }
  }
  // TypeSpec's Go emitter writes an action's inline `@bodyRoot` request
  // model too, though no operation uses it: a model of one required
  // field, the definition it names.
  for (name, field, ty, doc) in b.custom.body_roots {
    for (file, d) in b.files {
      if fields_of(d.get("definitions")).any(fn(p: (Str, json.Value)) -> Bool { p.0 == ty }) {
        let prop = json.Value.Object([("$ref", json.Value.Str("#/definitions/${ty}")), ("description", json.Value.Str(doc))])
        let schema = json.Value.Object([("type", json.Value.Str("object")), ("required", json.Value.List([json.Value.Str(field)])), ("properties", json.Value.Object([(field, prop)]))])
        b.named(file, name, schema)
        break
      }
    }
  }
  let patched = if b.custom.patch_twins { patch_only(ops, b.models, b.polys) } else { #{} }
  let models = with_twins(b.models, patched, b.polys)
  Api{api_version: version, ops: ops, models: models, enums: b.enums, polys: b.polys, report: b.report}
}

/// The models with PATCH fields: those only PATCH bodies reach, and a
/// patch twin (`<Name>Patch`) of each shared model one of them, or a
/// twin, holds directly (not in a list or map, which merge patch
/// replaces whole), so a nested field can be sent as null too. Fields
/// that hold such a model hold its twin.
fn with_twins(models: List[Model], patched: Set[Str], polys: List[Poly]) -> List[Model] {
  var ms: Map[Str, Model] = {}
  for m in models {
    ms[m.name] = m
  }
  var poly_names: Set[Str] = #{}
  for p in polys {
    poly_names.add(p.name)
  }
  let direct = fn(t: Str) -> Bool { ms.contains(t) && !patched.contains(t) && !poly_names.contains(t) }
  var twins: Set[Str] = #{}
  var order: List[Str] = []
  var stack: List[Str] = []
  for m in models {
    if patched.contains(m.name) {
      for f in m.fields {
        if direct(f.typ) {
          stack.push(f.typ)
        }
      }
    }
  }
  while let Some(n) = stack.pop() {
    if twins.contains(n) {
      continue
    }
    twins.add(n)
    order.push(n)
    for f in (ms.get(n) ?? Model{name: n, fields: []}).fields {
      if direct(f.typ) {
        stack.push(f.typ)
      }
    }
  }
  // a twin is `<Name>Patch`, or `<Name>MergePatch` when the spec has a
  // `<Name>Patch` of its own (armmanagednetworkfabric's
  // ImportRoutePolicyPatch)
  let twin = fn(n: Str) -> Str { if ms.contains("${n}Patch") { "${n}MergePatch" } else { "${n}Patch" } }
  let retype = fn(fs: List[Field]) -> List[Field] {
    fs.map(fn(f: Field) -> Field { if twins.contains(f.typ) { Field{name: f.name, wire: f.wire, typ: twin(f.typ), doc: f.doc} } else { f } })
  }
  var out: List[Model] = []
  for m in models {
    if patched.contains(m.name) {
      out.push(Model{name: m.name, fields: retype(m.fields), doc: m.doc, patch: true})
    } else {
      out.push(m)
    }
  }
  for n in order.sort() {
    let m = ms.get(n) ?? continue
    out.push(Model{name: twin(n), fields: retype(m.fields), doc: "${twin(n)}: ${n} in a PATCH body, each field Absent (left out), Null (removed) or a value.", patch: true, twin_of: n})
  }
  out
}

/// The type names in a type (`Map[Str, List[Foo]]` has Map, Str, List
/// and Foo).
fn idents(t: Str) -> List[Str] {
  var u = t
  for c in ["[", "]", ",", "?", "(", ")"] {
    u = u.replace(c, " ")
  }
  u.split(" ").filter(fn(x: Str) -> Bool { x != "" })
}

/// The models and polymorphic types `roots` reach through fields.
fn reach(roots: List[Str], models: Map[Str, Model], polys: Map[Str, Poly]) -> Set[Str] {
  var seen: Set[Str] = #{}
  var stack = roots
  while let Some(n) = stack.pop() {
    if seen.contains(n) {
      continue
    }
    if let Some(m) = models.get(n) {
      seen.add(n)
      for f in m.fields {
        stack = stack + idents(f.typ)
      }
    } else if let Some(p) = polys.get(n) {
      seen.add(n)
      stack.push(p.base)
      for (t, _) in p.variants {
        stack.push(t)
      }
    }
  }
  seen
}

/// The models reached from a PATCH operation's body and from nothing
/// else (no response, no other body): Go's update models
/// (`VirtualMachineUpdate`, `TagsObject`). A model a response also
/// reaches keeps `T?`, so reading it stays as it was.
fn patch_only(ops: List[Op], models: List[Model], polys: List[Poly]) -> Set[Str] {
  var ms: Map[Str, Model] = {}
  for m in models {
    ms[m.name] = m
  }
  var ps: Map[Str, Poly] = {}
  for p in polys {
    ps[p.name] = p
  }
  var mine: List[Str] = []
  var other: List[Str] = []
  for op in ops {
    for p in op.params {
      if p.loc == "body" {
        if op.method == "PATCH" {
          mine = mine + idents(p.typ)
        } else {
          other = other + idents(p.typ)
        }
      }
    }
    if let Some(r) = op.resp {
      other = other + idents(r)
    }
  }
  let shared = reach(other, ms, ps)
  // A polymorphic type's members encode through json.to_value: keep them.
  var poly_members = reach(ps.keys(), ms, ps)
  var out: Set[Str] = #{}
  for n in reach(mine, ms, ps) {
    if ms.contains(n) && !shared.contains(n) && !poly_members.contains(n) {
      out.add(n)
    }
  }
  out
}

/// The `$ref`ed files of `doc` (not examples), relative to `file`.
pub fn refs_of(file: Str, doc: json.Value) -> List[Str] {
  var out: List[Str] = []
  var stack = [doc]
  while let Some(v) = stack.pop() {
    match v {
      json.Value.Object(fs) => {
        for (k, x) in fs {
          if k == "x-ms-examples" {
            continue
          }
          if k == "$ref" {
            if let json.Value.Str(r) = x {
              let (f, _) = spec.split_ref(file, r)
              if f != file && !out.contains(f) {
                out.push(f)
              }
            }
          } else {
            stack.push(x)
          }
        }
      }
      json.Value.List(xs) => {
        for x in xs {
          stack.push(x)
        }
      }
      _ => {}
    }
  }
  out
}

/// `setting-name` as `settingName`.
fn dash_camel(s: Str) -> Str {
  let parts = s.split("-")
  var out = parts[0]
  for w in parts[1..] {
    out = out + (if w == "" { "" } else { w[0..1].to_upper() + w[1..] })
  }
  out
}

/// An enum's `modelAsString`, when it says. An enum of one value is a
/// constant when it is false (armnetwork's `singletonResource`), or
/// unset in a module that seals them; Go keeps one that says true a
/// parameter of its type (armstorage's `blobInventoryPolicyName`).
fn model_as_string(p: json.Value) -> Bool? {
  match p.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("modelAsString") }) {
    Some(json.Value.Bool(t)) => Some(t)
    _ => None
  }
}

/// A response header's kind, as Go's emitter reads it: an integer (or a
/// string of format int64, Content-Length), a boolean, an RFC 1123 time,
/// or text.
fn header_kind(hv: json.Value) -> Str {
  let t = str_of(hv.get("type"))
  let f = str_of(hv.get("format"))
  if t == "integer" || f == "int64" || f == "int32" {
    "int"
  } else if t == "boolean" {
    "bool"
  } else if f == "date-time-rfc7231" || f == "date-time-rfc1123" {
    "time"
  } else {
    ""
  }
}

/// An additionalProperties schema that is any value: `{}`, or a bare
/// `{"type": "object"}` (armazurearcdata's K8sResourceRequirements),
/// which modelerfour also reads as any.
fn untyped_object(fs: List[(Str, json.Value)]) -> Bool {
  fs.all(fn(f: (Str, json.Value)) -> Bool { (f.0 == "type" && f.1 == json.Value.Str("object")) || f.0 == "description" })
}

/// Whether `v` or one of its allOf parents has an untyped
/// `additionalProperties` (`{}` or `true`), Go's AdditionalProperties.
fn (b: Builder) has_extra(file: Str, v: json.Value, depth: Int) -> Bool {
  if depth > 8 {
    return false
  }
  match v.get("additionalProperties") {
    Some(json.Value.Object(fs)) if untyped_object(fs) => return true
    Some(json.Value.Bool(true)) => return true
    _ => {}
  }
  for parent in list_of(v.get("allOf")) {
    if str_of(parent.get("$ref")) != "" {
      let (pf, _, pv) = b.deref(file, parent)
      if b.has_extra(pf, pv, depth + 1) {
        return true
      }
    }
  }
  false
}
