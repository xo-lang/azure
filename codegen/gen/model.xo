// The model of one ARM package, built from its OpenAPI 2.0 files: the
// operations grouped into clients as Go groups them (the operationId's
// `Group_Op`), and the types they reach. A type is carried as its Xo
// source text (`List[ResourceGroup]`).

use std/json
use github.com/xo-lang/azure/codegen/spec

pub struct Field {
  pub name: Str
  pub wire: Str
  pub typ: Str
  pub doc: Str = ""
}

pub struct Model {
  pub name: Str
  pub fields: List[Field]
  pub doc: Str = ""
  /// Only ever sent as (part of) a PATCH body: its fields are
  /// json.Patch[T], so a caller can send an explicit null (Go's
  /// azcore.NullValue), which JSON merge patch reads as "remove".
  pub patch: Bool = false
  /// The model this is the patch twin of (`VirtualMachineProperties` for
  /// `VirtualMachinePropertiesPatch`), "" for a spec model.
  pub twin_of: Str = ""
}

/// An extensible string enum (x-ms-enum): a newtype with constants.
pub struct StrEnum {
  pub name: Str
  pub values: List[(Str, Str, Str)]
  pub doc: Str = ""
  /// The value type: Str, or Int for an integer enum (Go's int32).
  pub base: Str = "Str"
}

/// A number's name, as autorest.go names an integer enum's values
/// (`FirewallPolicyIDPSSignatureDirectionFive`).
fn number_name(v: Str) -> Str {
  let names = ["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen", "Twenty"]
  let n = Int.parse(v) ?? return v
  if n >= 0 && n < names.len() { names[n] } else { v }
}

pub struct Param {
  pub name: Str
  /// Go's parameter name (in its error messages).
  pub go_name: Str = ""
  pub wire: Str
  /// path, query, header or body
  pub loc: Str
  pub required: Bool
  pub typ: Str
  pub skip_encoding: Bool = false
  /// subscriptionId: a client field
  pub client: Bool = false
  /// api-version and other constants
  pub constant: Str? = None
  pub doc: Str = ""
}

pub struct Op {
  /// Go's client group (`ResourceGroups`) and method (`CreateOrUpdate`).
  pub group: Str
  pub name: Str
  pub method: Str
  pub path: Str
  pub params: List[Param]
  pub ok: List[Int]
  /// The response body's type name, None without a body.
  pub resp: Str? = None
  pub pageable: Bool = false
  pub next_link: Str? = None
  pub item_name: Str = "value"
  pub lro: Bool = false
  /// A pageable long-running operation: its result is a pager whose
  /// first page is the operation's final response (Go's
  /// `Poller[*Pager[T]]`).
  pub paged_lro: Bool = false
  pub final_state: Str = ""
  /// The operation's poller is runtime.new_status_poller (a Go
  /// module's custom handler, such as azadmin's restorePoller).
  pub status_poller: Bool = false
  pub doc: Str = ""
}

/// A polymorphic type (a definition with a `discriminator`): Go's
/// `<Base>Classification` interface, here an enum of its subtypes and,
/// for any other discriminator value, the base.
pub struct Poly {
  pub name: Str
  pub base: Str
  /// The discriminator's wire key (`ruleType`).
  pub tag: Str
  /// Each subtype and its discriminator value.
  pub variants: List[(Str, Str)]
  pub doc: Str = ""
}

pub struct Api {
  pub api_version: Str
  pub ops: List[Op]
  pub models: List[Model]
  pub enums: List[StrEnum]
  pub polys: List[Poly] = []
  pub report: List[Str]
}

/// A module's renames and fixes beyond the OpenAPI: TypeSpec's Go
/// `@@clientName`s (read from client.tsp) and the transforms Go's
/// module applies after generating (codegen/custom/<module>.toml).
pub struct Custom {
  /// operationId (any case) to Go's operation name.
  pub ops: Map[Str, Str] = {}
  /// A TypeSpec `@client` block's operations (operationId, lower case)
  /// to Go's names; when set, the others are left out and these are on
  /// the package's Client.
  pub client_ops: Map[Str, Str] = {}
  /// `Definition.property` to its type (TypeSpec's `@@alternateType`).
  pub alt_fields: Map[Str, Str] = {}
  /// Parameter wire name to its type (`@alternateType` on a parameter).
  pub param_types: Map[Str, Str] = {}
  /// Long-running operations (operationId, lower case) whose Go module
  /// polls them with a custom handler that runtime.new_status_poller ports.
  pub status_pollers: List[Str] = []
  /// definition name to Go's type name.
  pub models: Map[Str, Str] = {}
  /// `Definition.property` to Go's field name.
  pub fields: Map[Str, Str] = {}
  /// parameter wire name to Go's parameter name.
  pub params: Map[Str, Str] = {}
  /// Go field name (lower case) of a `Str` field to its type (`ID`).
  pub field_types: Map[Str, Str] = {}
  /// Generated type names replaced by another type (`DeletionRecoveryLevel` by `Str`).
  pub replace_types: Map[Str, Str] = {}
  /// Parameters dropped from every operation (wire names).
  pub drop_params: List[Str] = []
  /// Path parameters that may be empty (wire names).
  pub allow_empty: List[Str] = []
  /// autorest's modelerfour `seal-single-value-enum-by-default`: an
  /// enum with one value is that string (a required parameter, a
  /// constant), not a type.
  pub seal_single_value_enums: Bool = false
  /// Enum values Go's transforms delete, by enum: wire values.
  pub drop_values: Map[Str, List[Str]] = {}
  /// A data-plane module: operations without a group stay on its Client.
  pub data_plane: Bool = false
  /// Emit only the types operations reach (TypeSpec's Go emitter), not
  /// every definition (autorest.go).
  pub reachable_only: Bool = false
}

pub struct Builder {
  custom: Custom = Custom{}
  files: Map[Str, json.Value]
  models: List[Model] = []
  enums: List[StrEnum] = []
  polys: List[Poly] = []
  known: Map[Str, Str] = {}
  /// The package's api-version: the first input file with operations.
  api_version: Str = ""
  /// `file#definition` to its type, so two definitions with one name
  /// stay apart (the later one is `<Name>AutoGenerated`, as modelerfour
  /// names it).
  ids: Map[Str, Str] = {}
  /// A model name's first definition (file, schema), to merge an
  /// identical later one (modelerfour's lenient deduplication).
  firsts: Map[Str, (Str, json.Value)] = {}
  /// Definitions whose shape is being computed.
  shaping: List[Str] = []
  report: List[Str] = []
  /// The package's name without `arm` (`resources`): Go's generator
  /// drops it from the front of type names (`ResourcesMoveInfo` is
  /// `MoveInfo`), so names don't stutter.
  stutter: Str = ""
}

pub fn builder(files: Map[Str, json.Value], package: Str, custom: Custom = Custom{}) -> Builder {
  let p = package.to_lower()
  Builder{files: files, custom: custom, stutter: if p.starts_with("arm") { p[3..p.len()] } else { p }}
}

/// A name with a word repeated back to back said once, as modelerfour
/// names types (`RoleInstanceInstanceView` is `RoleInstanceView`).
fn dedup_words(s: Str) -> Str {
  var out: List[Str] = []
  for w in words(s) {
    if out.is_empty() || (out.last() ?? "").to_lower() != w.to_lower() {
      out.push(w)
    }
  }
  out.map(fn(w: Str) -> Str { "${w[0..1].to_upper()}${w[1..w.len()]}" }).join("")
}

/// An x-ms-enum's type name: Go keeps the package name in it
/// (armstorage's StorageAccountExpand).
fn (b: Builder) enum_name(s: Str) -> Str {
  b.custom.models.get(s).map(fn(r: Str) -> Str { reserve(r) }) ?? pascal(s)
}

/// `n` without the package name in front (when more follows it).
fn (b: Builder) unstutter(n: Str) -> Str {
  let k = b.stutter.len()
  if k > 0 && n.len() > k && n[0..k].to_lower() == b.stutter {
    let rest = n[k..n.len()]
    if rest[0..1] >= "A" && rest[0..1] <= "Z" {
      return rest
    }
  }
  n
}

/// A schema name as a type name, without the package's stutter.
fn (b: Builder) type_name(s: Str, dedup: Bool = true) -> Str {
  if let Some(r) = b.custom.models.get(s) {
    return reserve(r)
  }
  let n = pascal(if dedup { dedup_words(s) } else { s })
  let k = b.stutter.len()
  if k > 0 && n.len() > k && n[0..k].to_lower() == b.stutter {
    let rest = n[k..n.len()]
    if rest[0..1] >= "A" && rest[0..1] <= "Z" {
      return pascal(rest)
    }
  }
  n
}

fn str_of(v: json.Value?) -> Str {
  match v {
    Some(json.Value.Str(s)) => s
    _ => ""
  }
}

fn bool_of(v: json.Value?) -> Bool {
  match v {
    Some(json.Value.Bool(b)) => b
    _ => false
  }
}

fn list_of(v: json.Value?) -> List[json.Value] {
  match v {
    Some(json.Value.List(xs)) => xs
    _ => []
  }
}

fn fields_of(v: json.Value?) -> List[(Str, json.Value)] {
  match v {
    Some(json.Value.Object(fs)) => fs
    _ => []
  }
}

fn doc_of(v: json.Value) -> Str {
  let d = str_of(v.get("description"))
  if d != "" { d } else { str_of(v.get("title")) }
}

/// Follows `$ref`s to the schema itself: its file, pointer and value.
fn (b: Builder) deref(file: Str, v: json.Value) -> (Str, Str, json.Value) {
  var f = file
  var p = ""
  var x = v
  var hops = 0
  while hops < 20 {
    let r = str_of(x.get("$ref"))
    if r == "" {
      break
    }
    let (nf, np) = spec.split_ref(f, r)
    let doc = b.files.get(nf) ?? break
    x = spec.at(doc, np) ?? break
    f = nf
    p = np
    hops += 1
  }
  (f, p, x)
}

/// The Xo type of a schema; `hint` names an inline object.
pub fn (var b: Builder) type_of(file: Str, v: json.Value, hint: Str) -> Str {
  if str_of(v.get("$ref")) != "" {
    let (f, p, x) = b.deref(file, v)
    if p.starts_with("/definitions/") {
      let t = b.named(f, spec.last(p), x)
      // A struct with a discriminator stands for its subtypes too.
      if str_of(x.get("discriminator")) != "" && b.known.get(t) == Some(t) {
        return b.poly(f, spec.last(p), x, t)
      }
      return t
    }
    return b.type_of(f, x, hint)
  }
  b.inline(file, v, hint)
}

/// Whether definition `v` (in `file`) has the definition `root_def` of
/// `root_file` among its allOf ancestors.
fn (b: Builder) descends(file: Str, v: json.Value, root_file: Str, root_def: Str, depth: Int) -> Bool {
  if depth > 10 {
    return false
  }
  for parent in list_of(v.get("allOf")) {
    let r = str_of(parent.get("$ref"))
    if r == "" {
      continue
    }
    let (pf, pp, px) = b.deref(file, parent)
    if pf == root_file && pp == "/definitions/${root_def}" {
      return true
    }
    if b.descends(pf, px, root_file, root_def, depth + 1) {
      return true
    }
  }
  false
}

/// The polymorphic type of the definition `def` (type `base`): its
/// subtypes are the definitions of every file that descend from it.
fn (var b: Builder) poly(file: Str, def: Str, v: json.Value, base: Str) -> Str {
  let name = "${base}Classification"
  if b.known.contains(name) {
    return name
  }
  b.known[name] = name
  var variants: List[(Str, Str)] = []
  for (f, doc) in b.files {
    for (d, x) in fields_of(doc.get("definitions")) {
      if (f == file && d == def) || !b.descends(f, x, file, def, 0) {
        continue
      }
      let t = b.named(f, d, x)
      if variants.any(fn(e: (Str, Str)) -> Bool { e.0 == t }) {
        continue
      }
      let value = str_of(x.get("x-ms-discriminator-value"))
      variants.push((t, if value != "" { value } else { d }))
    }
  }
  b.polys.push(Poly{name: name, base: base, tag: str_of(v.get("discriminator")), variants: variants, doc: "${name}: a ${base} by its ${str_of(v.get("discriminator"))}, Go's ${name} interface."})
  name
}

/// A schema's structure without its documentation, keys sorted and
/// each `$ref` replaced by the type it resolves to, to compare two
/// definitions of one name. A definition being shaped stands for
/// itself (recursive types).
fn (var b: Builder) shape(file: Str, v: json.Value) -> Str {
  b.strip_docs(file, v).encode()
}

fn (var b: Builder) strip_docs(file: Str, v: json.Value) -> json.Value {
  match v {
    json.Value.Object(fs) => {
      var out: List[(Str, json.Value)] = []
      for (k, x) in fs.sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }) {
        if k == "description" || k == "title" || k == "x-ms-examples" {
          continue
        }
        if k == "$ref" {
          if let json.Value.Str(r) = x {
            let (f, p) = spec.split_ref(file, r)
            let id = "${f}#${spec.last(p)}"
            let t = if b.shaping.contains(id) { id } else { b.type_of(file, json.Value.Object([("$ref", x)]), "") }
            out.push((k, json.Value.Str(t)))
            continue
          }
        }
        out.push((k, b.strip_docs(file, x)))
      }
      json.Value.Object(out)
    }
    json.Value.List(xs) => {
      var out: List[json.Value] = []
      for x in xs {
        out.push(b.strip_docs(file, x))
      }
      json.Value.List(out)
    }
    other => other
  }
}

/// Whether `v` is an enum of one value that is sealed to a string.
fn (b: Builder) sealed(v: json.Value) -> Bool {
  if list_of(v.get("enum")).len() != 1 {
    return false
  }
  // modelAsString false always seals; unset, only with the flag.
  match v.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("modelAsString") }) {
    Some(json.Value.Bool(m)) => !m
    _ => b.custom.seal_single_value_enums
  }
}

fn (var b: Builder) inline(file: Str, v: json.Value, hint: Str) -> Str {
  if b.sealed(v) {
    return "Str"
  }
  if v.get("x-ms-enum").is_some() && str_of(v.get("type")) == "integer" {
    let name = str_of(v.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("name") }))
    if name != "" {
      return b.str_enum(b.enum_name(name), v, base: "Int")
    }
  }
  if v.get("x-ms-enum").is_some() && str_of(v.get("type")) == "string" {
    let name = str_of(v.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("name") }))
    if name != "" {
      return b.str_enum(b.enum_name(name), v)
    }
  }
  match str_of(v.get("type")) {
    "string" => match str_of(v.get("format")) {
      "date-time" => "azcore.DateTime"
      "date-time-rfc1123" => "azcore.DateTimeRFC1123"
      "base64url" => "azcore.Base64URL"
      "byte" => "Bytes"
      _ => "Str"
    }
    "integer" => if str_of(v.get("format")) == "unixtime" { "azcore.UnixTime" } else { "Int" }
    "number" => "Float"
    "boolean" => "Bool"
    "array" => {
      let items = v.get("items") ?? return "List[json.Value]"
      "List[${b.type_of(file, items, "${hint}Item")}]"
    }
    _ => {
      let props = fields_of(v.get("properties"))
      if props.is_empty() && v.get("allOf").is_none() {
        if let Some(ap) = v.get("additionalProperties") {
          if let json.Value.Object(_) = ap {
            return "Map[Str, ${b.type_of(file, ap, "${hint}Value")}]"
          }
        }
        return "json.Value"
      }
      b.named(file, hint, v, inline: true)
    }
  }
}

fn (var b: Builder) str_enum(name: Str, v: json.Value, base: Str = "Str") -> Str {
  if b.known.contains(name) {
    return name
  }
  b.known[name] = name
  var vals: List[(Str, Str, Str)] = []
  let named = list_of(v.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("values") }))
  if !named.is_empty() {
    for x in named {
      let value = match x.get("value") {
        Some(json.Value.Str(s)) => s
        Some(other) => other.encode()
        None => ""
      }
      let n = str_of(x.get("name"))
      vals.push((screaming(if n != "" { n } else { value }), value, str_of(x.get("description"))))
    }
  } else {
    for x in list_of(v.get("enum")) {
      let value = match x {
        json.Value.Str(s) => s
        other => other.encode()
      }
      vals.push((screaming(if base == "Int" { number_name(value) } else { value }), value, ""))
    }
  }
  let dropped = b.custom.drop_values.get(name) ?? []
  vals = vals.filter(fn(x: (Str, Str, Str)) -> Bool { !dropped.contains(x.1) })
  b.enums.push(StrEnum{name: name, values: vals, doc: doc_of(v), base: base})
  name
}

/// A definition: a struct, an enum, or the primitive it stands for.
fn (var b: Builder) named(file: Str, def: Str, v: json.Value, inline: Bool = false) -> Str {
  let id = "${file}#${def}"
  if let Some(t) = b.ids.get(id) {
    return t
  }
  // A definition's x-ms-client-name renames its type; on an inline
  // schema it names the property. A repeated word is said once only in a
  // definition's own name, not in a name composed for an inline schema.
  let cn = if inline { "" } else { str_of(v.get("x-ms-client-name")) }
  var name = if inline { b.type_name(def, dedup: false) } else { b.type_name(if cn != "" { cn } else { def }) }
  if bool_of(v.get("x-ms-external")) {
    b.ids[id] = "json.Value"
    return "json.Value"
  }
  if b.sealed(v) {
    b.ids[id] = "Str"
    return "Str"
  }
  // An object with no properties, parent, or map values is any JSON, as
  // modelerfour reads it (Go's `any`): NspAssociationReconcile.
  if !inline && list_of(v.get("enum")).is_empty() && fields_of(v.get("properties")).is_empty() && v.get("allOf").is_none() && v.get("additionalProperties").is_none() && v.get("discriminator").is_none() && (str_of(v.get("type")) == "object" || str_of(v.get("type")) == "") {
    b.ids[id] = "json.Value"
    return "json.Value"
  }
  if let Some(r) = b.custom.replace_types.get(name) {
    b.ids[id] = r
    return r
  }
  // An enum is known by its x-ms-enum name, which may repeat.
  if !list_of(v.get("enum")).is_empty() {
    let en = str_of(v.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("name") }))
    let t = b.str_enum(if en != "" { b.enum_name(en) } else { name }, v)
    b.ids[id] = t
    return t
  }
  if let Some((ff, fv)) = b.firsts.get(name) {
    b.shaping.push(id)
    let same = b.shape(ff, fv) == b.shape(file, v)
    b.shaping.pop()
    if same {
      let t = b.known.get(name) ?? name
      b.ids[id] = t
      return t
    }
  }
  if b.known.contains(name) {
    var n = 1
    var cand = "${name}AutoGenerated"
    while b.known.contains(cand) {
      n += 1
      cand = "${name}AutoGenerated${n}"
    }
    name = cand
  }
  let t = b.named_as(file, def, name, v)
  b.ids[id] = t
  t
}

fn (var b: Builder) named_as(file: Str, def: Str, name: Str, v: json.Value) -> Str {
  if let Some(r) = b.custom.replace_types.get(name) {
    b.known[name] = r
    return r
  }
  if !list_of(v.get("enum")).is_empty() {
    let en = str_of(v.get("x-ms-enum").and_then(fn(e: json.Value) -> json.Value? { e.get("name") }))
    return b.str_enum(if en != "" { b.type_name(en) } else { name }, v)
  }
  let props = fields_of(v.get("properties"))
  let t = str_of(v.get("type"))
  if props.is_empty() && v.get("allOf").is_none() && (t != "object" && t != "") {
    return b.inline(file, v, def)
  }
  if props.is_empty() && v.get("allOf").is_none() {
    if let Some(ap) = v.get("additionalProperties") {
      if let json.Value.Object(_) = ap {
        let m = "Map[Str, ${b.type_of(file, ap, "${def}Value")}]"
        b.known[name] = m
        return m
      }
    }
  }
  // mark before the fields, for recursive types
  b.known[name] = name
  if !b.firsts.contains(name) {
    b.firsts[name] = (file, v)
  }
  b.ids["${file}#${def}"] = name
  // Go emits allOf parents as types of their own too, unless it keeps
  // only the types operations reach (a parent's fields are copied).
  for parent in if b.custom.reachable_only { [] } else { list_of(v.get("allOf")) } {
    if str_of(parent.get("$ref")) != "" {
      b.type_of(file, parent, "")
    }
  }
  var fields: List[Field] = []
  var seen: List[Str] = []
  for (wire, prop, pf) in b.properties(file, v) {
    if seen.contains(wire) {
      continue
    }
    seen.push(wire)
    let raw_client = str_of(prop.get("x-ms-client-name"))
    let client = b.custom.fields.get("${def}.${if raw_client != "" { raw_client } else { wire }}") ?? raw_client
    var typ = b.custom.alt_fields.get("${def}.${wire}") ?? b.type_of(pf, prop, "${name}${pascal(wire)}")
    let go_name = if client != "" { client } else { wire }
    if typ == "Str" {
      // `Model.field` first (one model's), then the field in every model.
      if let Some(t) = b.custom.field_types.get("${name}.${go_name}".to_lower()) ?? b.custom.field_types.get(go_name.to_lower()) {
        typ = t
      }
    }
    fields.push(Field{name: snake(go_name), wire: wire, typ: typ, doc: doc_of(prop)})
  }
  b.models.push(Model{name: name, fields: fields, doc: doc_of(v)})
  name
}

/// Every property of a schema, its allOf parents' first, with the file
/// each is in.
fn (b: Builder) properties(file: Str, v: json.Value) -> List[(Str, json.Value, Str)] {
  var out: List[(Str, json.Value, Str)] = []
  for parent in list_of(v.get("allOf")) {
    let (f, _, x) = b.deref(file, parent)
    out = out + b.properties(f, x)
  }
  for (k, p) in fields_of(v.get("properties")) {
    out.push((k, p, file))
  }
  out
}

fn (var b: Builder) param(file: Str, raw: json.Value) -> Param {
  let (f, _, p) = b.deref(file, raw)
  let wire = str_of(p.get("name"))
  let loc = str_of(p.get("in"))
  // The api-version is a constant: its enum (some files have one) is
  // not a type, as in Go.
  let typ = if wire == "api-version" {
    "Str"
  } else if loc == "body" {
    b.type_of(f, p.get("schema") ?? json.Value.Object([]), pascal(wire))
  } else {
    b.custom.param_types.get(wire) ?? b.inline(f, p, pascal(wire))
  }
  let required = bool_of(p.get("required")) || loc == "path"
  let one = list_of(p.get("enum"))
  let constant = if wire == "api-version" {
    // The operation's own file's version (compute mixes several);
    // API_VERSION when it is the package's.
    let fv = str_of(b.files.get(file).and_then(fn(d: json.Value) -> json.Value? { d.get("info") }).and_then(fn(i: json.Value) -> json.Value? { i.get("version") }))
    if fv == "" || fv == b.api_version { Some("API_VERSION") } else { Some("\"${fv}\"") }
  } else if b.custom.seal_single_value_enums && required && one.len() == 1 {
    match one[0] {
      json.Value.Str(c) => Some("\"${c.replace("\\", "\\\\").replace("\"", "\\\"")}\"")
      _ => None
    }
  } else {
    None
  }
  // TypeSpec's Go emitter camel-cases a quoted name (`setting-name` is
  // settingName)
  let plain = if b.custom.data_plane && wire.contains("-") { dash_camel(wire) } else { wire }
  let go_name = b.custom.params.get(wire) ?? (if str_of(p.get("x-ms-client-name")) != "" { str_of(p.get("x-ms-client-name")) } else { plain })
  let client = wire == "subscriptionId" || (str_of(p.get("x-ms-parameter-location")) == "client" && wire != "api-version" && loc == "path")
  Param{
    name: snake(go_name), go_name: go_name,
    wire: wire, loc: loc, required: required, typ: typ,
    skip_encoding: bool_of(p.get("x-ms-skip-url-encoding")), client: client, constant: constant, doc: doc_of(p),
  }
}

/// The package's operations from `files` (its input files).
pub fn (var b: Builder) build(inputs: List[Str]) -> Api {
  var ops: List[Op] = []
  var version = ""
  // The default group (operations without one) is named after the
  // package's title, the first input file's (NetworkManagementClient is
  // ManagementClient).
  let title = str_of(b.files.get(inputs.get(0) ?? "").and_then(fn(d: json.Value) -> json.Value? { d.get("info") }).and_then(fn(i: json.Value) -> json.Value? { i.get("title") })).trim_suffix("Client")
  for file in inputs {
    let doc = b.files.get(file) ?? json.Value.Null
    if version == "" && (fields_of(doc.get("paths")).len() + fields_of(doc.get("x-ms-paths")).len()) > 0 {
      version = str_of(doc.get("info").and_then(fn(i: json.Value) -> json.Value? { i.get("version") }))
      b.api_version = version
    }
    for section in ["paths", "x-ms-paths"] {
      for (path, item) in fields_of(doc.get(section)) {
        let shared = list_of(item.get("parameters"))
        for (method, o) in fields_of(Some(item)) {
          if !["get", "put", "post", "delete", "patch", "head"].contains(method) {
            continue
          }
          let id = str_of(o.get("operationId"))
          let (raw_group, raw_name) = match id.find("_") {
            Some(i) => (id[0..i], id[i + 1..id.len()])
            None => ("", id)
          }
          if !b.custom.client_ops.is_empty() && !b.custom.client_ops.contains(id.to_lower()) {
            continue
          }
          let name = b.custom.client_ops.get(id.to_lower()) ?? b.custom.ops.get(id.to_lower()) ?? raw_name
          // Go drops the package name from a group too (StorageAccounts
          // is armstorage's Accounts), except a group named as the package.
          // An operation without a group is in the default one, named after
          // the file's title (NetworkManagementClient is ManagementClient);
          // a data-plane module keeps them on its Client.
          // Go's group names are case-folded (configurationPolicyGroups and
          // ConfigurationPolicyGroups are one client).
          let group = if !b.custom.client_ops.is_empty() { "" } else { part(b.unstutter(if raw_group == "" && !b.custom.data_plane { title } else { raw_group })) }
          var params: List[Param] = []
          for raw in shared + list_of(o.get("parameters")) {
            let p = b.param(file, raw)
            if b.custom.drop_params.contains(p.wire) {
              continue
            }
            params = params.filter(fn(q: Param) -> Bool { q.wire != p.wire || q.loc != p.loc })
            params.push(p)
          }
          var okc: List[Int] = []
          var resp: Str? = None
          for (code, r) in fields_of(o.get("responses")) {
            if code == "default" {
              // Go emits the error schema as a type too.
              if let Some(es) = if b.custom.reachable_only { None } else { b.deref(file, r).2.get("schema") } {
                b.type_of(file, es, "${group}${name}Error")
              }
            }
            let n = Int.parse(code) ?? continue
            if n >= 200 && n < 300 {
              okc.push(n)
              if resp.is_none() {
                if let Some(s) = b.deref(file, r).2.get("schema") {
                  resp = Some(b.type_of(file, s, "${group}${name}Response"))
                }
              }
            }
          }
          let pg = o.get("x-ms-pageable")
          let lro = bool_of(o.get("x-ms-long-running-operation"))
          let next = match pg.and_then(fn(x: json.Value) -> json.Value? { x.get("nextLinkName") }) {
            Some(json.Value.Str(s)) => Some(s)
            _ => None
          }
          let item_name = str_of(pg.and_then(fn(x: json.Value) -> json.Value? { x.get("itemName") }))
          let fsv = str_of(o.get("x-ms-long-running-operation-options").and_then(fn(x: json.Value) -> json.Value? { x.get("final-state-via") }))
          for (k, _) in fields_of(Some(o)) {
            if k.starts_with("x-ms-") && !["x-ms-pageable", "x-ms-long-running-operation", "x-ms-long-running-operation-options", "x-ms-examples", "x-ms-odata", "x-ms-azure-rbac-permissions-required"].contains(k) {
              b.report.push("${id}: extension ${k} not handled")
            }
          }
          ops.push(Op{
            group: group, name: name, method: method.to_upper(), path: path, params: params, ok: okc.sort(), resp: resp,
            pageable: pg.is_some() && !lro, next_link: next, item_name: if item_name == "" { "value" } else { item_name },
            lro: lro, paged_lro: pg.is_some() && lro, final_state: fsv, status_poller: lro && b.custom.status_pollers.contains(id.to_lower()), doc: doc_of(o),
          })
        }
      }
    }
  }
  // autorest.go emits every definition of the input files, used or not.
  for file in if b.custom.reachable_only { [] } else { inputs } {
    let doc = b.files.get(file) ?? json.Value.Null
    for (def, v) in fields_of(doc.get("definitions")) {
      // x-ms-external types come from elsewhere: Go does not emit them.
      if bool_of(v.get("x-ms-external")) {
        continue
      }
      b.named(file, def, v)
    }
  }
  let patched = patch_only(ops, b.models, b.polys)
  let models = with_twins(b.models, patched, b.polys)
  Api{api_version: version, ops: ops, models: models, enums: b.enums, polys: b.polys, report: b.report}
}

/// The models with PATCH fields: those only PATCH bodies reach, and a
/// patch twin (`<Name>Patch`) of each shared model one of them, or a
/// twin, holds directly (not in a list or map, which merge patch
/// replaces whole), so a nested field can be sent as null too. Fields
/// that hold such a model hold its twin.
fn with_twins(models: List[Model], patched: Set[Str], polys: List[Poly]) -> List[Model] {
  var ms: Map[Str, Model] = {}
  for m in models {
    ms[m.name] = m
  }
  var poly_names: Set[Str] = #{}
  for p in polys {
    poly_names.add(p.name)
  }
  let direct = fn(t: Str) -> Bool { ms.contains(t) && !patched.contains(t) && !poly_names.contains(t) }
  var twins: Set[Str] = #{}
  var order: List[Str] = []
  var stack: List[Str] = []
  for m in models {
    if patched.contains(m.name) {
      for f in m.fields {
        if direct(f.typ) {
          stack.push(f.typ)
        }
      }
    }
  }
  while let Some(n) = stack.pop() {
    if twins.contains(n) {
      continue
    }
    twins.add(n)
    order.push(n)
    for f in (ms.get(n) ?? Model{name: n, fields: []}).fields {
      if direct(f.typ) {
        stack.push(f.typ)
      }
    }
  }
  let retype = fn(fs: List[Field]) -> List[Field] {
    fs.map(fn(f: Field) -> Field { if twins.contains(f.typ) { Field{name: f.name, wire: f.wire, typ: "${f.typ}Patch", doc: f.doc} } else { f } })
  }
  var out: List[Model] = []
  for m in models {
    if patched.contains(m.name) {
      out.push(Model{name: m.name, fields: retype(m.fields), doc: m.doc, patch: true})
    } else {
      out.push(m)
    }
  }
  for n in order.sort() {
    let m = ms.get(n) ?? continue
    out.push(Model{name: "${n}Patch", fields: retype(m.fields), doc: "${n}Patch: ${n} in a PATCH body, each field Absent (left out), Null (removed) or a value.", patch: true, twin_of: n})
  }
  out
}

/// The type names in a type (`Map[Str, List[Foo]]` has Map, Str, List
/// and Foo).
fn idents(t: Str) -> List[Str] {
  var u = t
  for c in ["[", "]", ",", "?", "(", ")"] {
    u = u.replace(c, " ")
  }
  u.split(" ").filter(fn(x: Str) -> Bool { x != "" })
}

/// The models and polymorphic types `roots` reach through fields.
fn reach(roots: List[Str], models: Map[Str, Model], polys: Map[Str, Poly]) -> Set[Str] {
  var seen: Set[Str] = #{}
  var stack = roots
  while let Some(n) = stack.pop() {
    if seen.contains(n) {
      continue
    }
    if let Some(m) = models.get(n) {
      seen.add(n)
      for f in m.fields {
        stack = stack + idents(f.typ)
      }
    } else if let Some(p) = polys.get(n) {
      seen.add(n)
      stack.push(p.base)
      for (t, _) in p.variants {
        stack.push(t)
      }
    }
  }
  seen
}

/// The models reached from a PATCH operation's body and from nothing
/// else (no response, no other body): Go's update models
/// (`VirtualMachineUpdate`, `TagsObject`). A model a response also
/// reaches keeps `T?`, so reading it stays as it was.
fn patch_only(ops: List[Op], models: List[Model], polys: List[Poly]) -> Set[Str] {
  var ms: Map[Str, Model] = {}
  for m in models {
    ms[m.name] = m
  }
  var ps: Map[Str, Poly] = {}
  for p in polys {
    ps[p.name] = p
  }
  var mine: List[Str] = []
  var other: List[Str] = []
  for op in ops {
    for p in op.params {
      if p.loc == "body" {
        if op.method == "PATCH" {
          mine = mine + idents(p.typ)
        } else {
          other = other + idents(p.typ)
        }
      }
    }
    if let Some(r) = op.resp {
      other = other + idents(r)
    }
  }
  let shared = reach(other, ms, ps)
  // A polymorphic type's members encode through json.to_value: keep them.
  var poly_members = reach(ps.keys(), ms, ps)
  var out: Set[Str] = #{}
  for n in reach(mine, ms, ps) {
    if ms.contains(n) && !shared.contains(n) && !poly_members.contains(n) {
      out.add(n)
    }
  }
  out
}

/// The `$ref`ed files of `doc` (not examples), relative to `file`.
pub fn refs_of(file: Str, doc: json.Value) -> List[Str] {
  var out: List[Str] = []
  var stack = [doc]
  while let Some(v) = stack.pop() {
    match v {
      json.Value.Object(fs) => {
        for (k, x) in fs {
        if k == "x-ms-examples" {
          continue
        }
        if k == "$ref" {
          if let json.Value.Str(r) = x {
            let (f, _) = spec.split_ref(file, r)
            if f != file && !out.contains(f) {
              out.push(f)
            }
          }
        } else {
          stack.push(x)
        }
        }
      }
      json.Value.List(xs) => {
        for x in xs {
          stack.push(x)
        }
      }
      _ => {}
    }
  }
  out
}

/// `setting-name` as `settingName`.
fn dash_camel(s: Str) -> Str {
  let parts = s.split("-")
  var out = parts[0]
  for w in parts[1..] {
    out = out + (if w == "" { "" } else { w[0..1].to_upper() + w[1..] })
  }
  out
}
