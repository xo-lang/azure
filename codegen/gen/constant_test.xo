// A CONSTANT field (a one-value enum sealed to a string) as Go writes
// it: its constant always when required, when set when optional.

use std/json

test "a sealed one-value enum field is Go's constant, required or not" {
  var b = builder({}, "armx")
  b.files["f.json"] = json.parse_value("{\"definitions\":{\"Req\":{\"required\":[\"kind\"],\"properties\":{\"kind\":{\"type\":\"string\",\"enum\":[\"K\"],\"x-ms-enum\":{\"name\":\"Kind\",\"modelAsString\":false}},\"mode\":{\"type\":\"string\",\"enum\":[\"M\"],\"x-ms-enum\":{\"name\":\"Mode\",\"modelAsString\":false}},\"open\":{\"type\":\"string\",\"enum\":[\"O\"],\"x-ms-enum\":{\"name\":\"Open\",\"modelAsString\":true}}}}}}")?
  let _ = b.type_of("f.json", json.parse_value("{\"$ref\":\"#/definitions/Req\"}")?, "")
  let m = b.models.filter(fn(m: Model) -> Bool { m.name == "Req" })[0]
  let f = fn(w: Str) -> Field { m.fields.filter(fn(f: Field) -> Bool { f.wire == w })[0] }
  expect((f("kind").constant, f("kind").required)) == ("K", true)
  expect((f("mode").constant, f("mode").required)) == ("M", false)
  expect(f("open").constant) == ""
  let api = Api{api_version: "1", ops: [], models: [m], enums: [], report: []}
  let text = emit_models(Package{name: "armx", module: "m", version: "v0.1.0", source: "s"}, api).text
  expect(text.contains("    kind: Some(\"K\"),\n")) == true
  expect(text.contains("    mode: x.mode.map(fn(_: Str) -> Str { \"M\" }),\n")) == true
  expect(text.contains("    open: x.open,\n")) == true
}
