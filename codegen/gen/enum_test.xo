// An enum's values in Go's order: autorest.go and the TypeSpec Go
// emitter sort a type's constants by Go name, case and all
// (PolicyViolationCategoryIPTheft before ...ImageFlaggedUnsafe in
// armcompute v6.4.0).

use std/json

test "enum values are sorted by Go constant name" {
  var b = builder({}, "armx")
  let spec = json.parse_value("{\"type\":\"string\",\"enum\":[\"x\"],\"x-ms-enum\":{\"name\":\"Cat\",\"values\":[{\"value\":\"Other\",\"name\":\"Other\"},{\"value\":\"ImageFlaggedUnsafe\",\"name\":\"ImageFlaggedUnsafe\"},{\"value\":\"IpTheft\",\"name\":\"IpTheft\"},{\"value\":\"CopyrightValidation\",\"name\":\"CopyrightValidation\"}]}}")?
  let _ = b.str_enum("Cat", spec)
  expect(b.enums[0].values.map(fn(v: (Str, Str, Str)) -> Str { v.1 })) == ["CopyrightValidation", "IpTheft", "ImageFlaggedUnsafe", "Other"]
  let plain = json.parse_value("{\"type\":\"string\",\"enum\":[\"rotate\",\"Notify\"]}")?
  let _ = b.str_enum("Action", plain)
  expect(b.enums[1].values.map(fn(v: (Str, Str, Str)) -> Str { v.1 })) == ["Notify", "rotate"]
}
