// Emits an ARM module from its model (decision 0002): types with
// `derive Json` (wire names, nil fields omitted), string enums as
// newtypes with constants, and one client per operation group with
// Go's operations: plain, HEAD (a Bool), pageable (runtime.Pager) and
// long-running (runtime.Poller, resumable).

pub struct File {
  pub name: Str
  pub text: Str
}

pub struct Package {
  /// `armresources`
  pub name: Str
  pub module: Str
  pub version: Str
  pub source: Str
  /// A data plane module (TypeSpec's Go emitter, one `Client`): names
  /// are `<Op>Options` and `<Op>Response`, and the client struct and
  /// constructor are written by hand (custom_client.xo), as Go's are.
  pub data_plane: Bool = false
  /// Path parameters that may be empty (wire names).
  pub allow_empty: List[Str] = []
  /// The Go package's import path, for a paged operation's resume token
  /// type (`*Pager[<path>.<Response>]`, as reflect names it).
  pub go_package: Str = ""
  /// Accept on every data plane operation (custom/<module>.toml).
  pub accept_always: Bool = false
}

/// A string literal's contents.
pub fn esc(s: Str) -> Str {
  s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\${", "\\\${").replace("\n", "\\n").replace("\r", "").replace("\t", " ")
}

/// A one-line doc comment, or none.
fn doc(indent: Str, text: Str) -> Str {
  let t = text.replace("\r", "").replace("\n", " ").replace("\t", " ").trim()
  if t == "" { "" } else { "${indent}/// ${t}\n" }
}

fn header(p: Package) -> Str {
  "// Code generated by xo-lang/azure codegen from azure-rest-api-specs\n// ${p.source}; MIT, Copyright (c) Microsoft Corporation (NOTICE.md).\n// DO NOT EDIT.\n\n"
}

fn is_model(api: Api, t: Str) -> Bool {
  api.models.any(fn(m: Model) -> Bool { m.name == t }) || api.polys.any(fn(p: Poly) -> Bool { p.name == t })
}

fn is_enum(api: Api, t: Str) -> Bool {
  api.enums.any(fn(e: StrEnum) -> Bool { e.name == t })
}

/// The text of a query or header value of type `t` held in `v`.
fn to_text(api: Api, t: Str, v: Str) -> Str {
  if t == "Str" {
    v
  } else if is_enum(api, t) {
    if api.enums.any(fn(e: StrEnum) -> Bool { e.name == t && e.base == "Int" }) { "\"\${${v}.0}\"" } else { "${v}.0" }
  } else if t == "Int" || t == "Float" || t == "Bool" {
    "\"\${${v}}\""
  } else if t == "azcore.DateTime" {
    "azcore.date_time_text(${v})"
  } else if t == "azcore.DateTimeRFC1123" {
    "azcore.rfc1123_text(${v})"
  } else if t == "azcore.UnixTime" {
    "\"\${azcore.unix_seconds(${v})}\""
  } else if t == "azcore.Base64URL" {
    "azcore.base64url_text(${v})"
  } else if t == "List[Str]" {
    "${v}.join(\",\")"
  } else {
    "json.encode_str(${v})"
  }
}

pub fn emit_models(p: Package, api: Api) -> File {
  var s = header(p)
  let wire_types = api.models.any(fn(m: Model) -> Bool { m.fields.any(fn(f: Field) -> Bool { f.typ.contains("azcore.") }) })
  let head = s
  s = ""
  s = s + "pub const MODULE: Str = \"${p.name}\"\npub const VERSION: Str = \"${p.version}\"\n/// The REST API version these operations are generated for.\npub const API_VERSION: Str = \"${esc(api.api_version)}\"\n"
  for e in api.enums {
    s = s + "\n" + doc("", e.doc) + "pub type ${e.name} struct(${e.base})\n"
    for (n, v, d) in e.values {
      let lit = if e.base == "Int" { v } else { "\"${esc(v)}\"" }
      s = s + doc("", d) + "pub const ${screaming(e.name)}_${n}: ${e.name} = ${e.name}(${lit})\n"
    }
    s = s + "\n/// The values of ${e.name} this version knows; the service may send others.\npub fn possible_${snake(e.name)}_values() -> List[${e.name}] {\n  [${e.values.map(fn(v: (Str, Str, Str)) -> Str { "${screaming(e.name)}_${v.0}" }).join(", ")}]\n}\n"
  }
  for p in api.polys {
    let sn = snake(p.name)
    s = s + "\n" + doc("", p.doc) + "pub enum ${p.name} {\n"
    for (t, v) in p.variants {
      s = s + "  /// ${p.tag} \"${esc(v)}\"\n  ${t}(from ${t})\n"
    }
    s = s + "  /// Any other ${p.tag}, as the base type.\n  ${p.base}(from ${p.base})\n} derive Json(via: json.Value, to: ${sn}_json, from: parse_${sn})\n"
    s = s + "\nfn ${sn}_json(c: ${p.name}) -> json.Value {\n  match c {\n"
    for (t, v) in p.variants {
      s = s + "    ${p.name}.${t}(x) => with_discriminator(json.to_value(x), \"${esc(p.tag)}\", \"${esc(v)}\")\n"
    }
    s = s + "    ${p.name}.${p.base}(x) => json.to_value(x)\n  }\n}\n"
    s = s + "\nfn parse_${sn}(v: json.Value) -> ${p.name} ! json.DecodeErr {\n  match v.get(\"${esc(p.tag)}\") {\n"
    for (t, v) in p.variants {
      s = s + "    Some(json.Value.Str(\"${esc(v)}\")) => Ok(${p.name}.${t}(json.from_value[${t}](v)?))\n"
    }
    s = s + "    _ => Ok(${p.name}.${p.base}(json.from_value[${p.base}](v)?))\n  }\n}\n"
  }
  if !api.polys.is_empty() {
    s = s + "\n/// `v` with its discriminator `key` set to `value`, as Go's\n/// MarshalJSON writes a subtype's (its keys sorted).\nfn with_discriminator(v: json.Value, key: Str, value: Str) -> json.Value {\n  match v {\n    json.Value.Object(fs) => json.Value.Object((fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != key }) + [(key, json.Value.Str(value))]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))\n    other => other\n  }\n}\n"
  }
  for m in api.models {
    s = s + "\n" + doc("", m.doc) + "pub struct ${m.name} {\n"
    // Go's MarshalJSON fills a map[string]any, so json.Marshal writes the
    // keys sorted: the fields are declared in that order
    for f in m.fields.sort_by(fn(f: Field) -> Str { f.wire }) {
      s = s + doc("  ", f.doc) + (if m.patch { "  pub ${f.name} as \"${esc(f.wire)},omitempty\": json.Patch[${f.typ}] = json.Patch.Absent\n" } else { "  pub ${f.name} as \"${esc(f.wire)},omitempty\": ${f.typ}? = None\n" })
    }
    s = s + "} derive Json\n"
    if m.twin_of != "" {
      s = s + "\n/// `m` as a patch: each set field a value, each unset one Absent.\npub fn (m: ${m.twin_of}) patch() -> ${m.name} {\n  ${m.name}{\n"
      for f in m.fields {
        let v = if f.typ.ends_with("Patch") && api.models.any(fn(x: Model) -> Bool { x.name == f.typ && x.twin_of != "" }) { "json.Patch.Value(x.patch())" } else { "json.Patch.Value(x)" }
        s = s + "    ${f.name}: match m.${f.name} {\n      Some(x) => ${v}\n      None => json.Patch.Absent\n    },\n"
      }
      s = s + "  }\n}\n"
    }
  }
  let imports = (if s.contains("json.") { "use std/json\n" } else { "" }) + (if wire_types { "use github.com/xo-lang/azure/azcore\n" } else { "" })
  File{name: "models.xo", text: head + imports + (if imports == "" { "" } else { "\n" }) + s}
}

/// The parameters an operation's method takes in order, and those its
/// options hold.
fn split_params(op: Op) -> (List[Param], List[Param]) {
  let mine = op.params.filter(fn(x: Param) -> Bool { !x.client && x.constant.is_none() })
  (mine.filter(fn(x: Param) -> Bool { x.required }), mine.filter(fn(x: Param) -> Bool { !x.required }))
}

/// Go's client name: `<Group>Client`, or `Client` for the group named
/// as the package (armresources' Resources).
fn client_name(group: Str) -> Str {
  "${part(group)}Client"
}

fn client_name_in(p: Package, group: Str) -> Str {
  if "arm${group.to_lower()}" == p.name { "Client" } else { client_name(group) }
}

fn resp_name(p: Package, op: Op) -> Str {
  if p.data_plane {
    return "${part(op.name)}Response"
  }
  "${client_name_in(p, op.group)}${part(op.name)}Response"
}

fn opts_name(p: Package, op: Op) -> Str {
  let cn = if p.data_plane { "" } else { client_name_in(p, op.group) }
  if op.lro { "${cn}Begin${part(op.name)}Options" } else { "${cn}${part(op.name)}Options" }
}

fn method_name(op: Op) -> Str {
  if op.lro { "begin_${snake(op.name)}" } else if op.pageable { "new_${snake(op.name)}_pager" } else { snake(op.name) }
}

/// The response struct's field holding the body.
fn body_field(api: Api, op: Op) -> Str {
  match op.resp {
    Some(t) => if is_model(api, t) { snake(unreserve(t)) } else { "value" }
    None => ""
  }
}

fn emit_op(p: Package, api: Api, op: Op, has_sub: Bool) -> Str {
  let cn = client_name_in(p, op.group)
  let (req, opt) = split_params(op)
  let rn = resp_name(p, op)
  let on = opts_name(p, op)
  let snake_op = snake(op.name)
  let hname = if op.group == "" { "${snake_op}_handle" } else { "${snake(op.group)}_${snake_op}_handle" }
  var s = "\n" + doc("", "${on}: the optional parameters of ${cn}.${method_name(op)}.") + "pub struct ${on} {\n"
  for x in opt {
    s = s + doc("  ", x.doc) + "  pub ${x.name}: ${x.typ}? = None\n"
  }
  if op.lro {
    s = s + "  /// Resumes the operation from a poller's resume_token instead of starting it.\n  pub resume_token: Str = \"\"\n"
  }
  s = s + "}\n"
  // the response
  s = s + "\n" + doc("", "${rn}: the response of ${cn}.${method_name(op)}.") + "pub struct ${rn} {\n"
  if op.method == "HEAD" {
    s = s + "  /// Whether the resource exists (a 2xx response, not a 404).\n  pub success: Bool = false\n"
  } else if let Some(t) = op.resp {
    s = s + "  pub ${body_field(api, op)}: ${t}\n"
  }
  s = s + "}\n"
  // the pure response handler
  s = s + "\nfn ${hname}(resp: http.Response) -> ${rn} ! Str {\n"
  if op.method == "HEAD" {
    s = s + "  Ok(${rn}{success: resp.status >= 200 && resp.status < 300})\n"
  } else if let Some(t) = op.resp {
    s = s + "  if resp.body.is_empty() {\n    return Err(\"the response has no body\")\n  }\n"
    s = s + "  let v = json.decode[${t}](resp.body) ?? e => return Err(e.display())\n  Ok(${rn}{${body_field(api, op)}: v})\n"
  } else {
    s = s + "  Ok(${rn}{})\n"
  }
  s = s + "}\n"
  // the request
  let args = req.map(fn(x: Param) -> Str { "${x.name}: ${x.typ}" }).join(", ")
  let sep = if args == "" { "" } else { ", " }
  s = s + "\nfn (c: ${cn}) ${snake_op}_create_request(${args}${sep}options: ${on}) -> policy.Request ! azcore.CallErr {\n"
  // a path that carries a query to tell two operations apart
  // (`/{roleId}?disambiguation_dummy`) is Go's urlPath without it
  let tmpl = op.path.cut("?").map(fn(t: (Str, Str)) -> Str { t.0 }) ?? op.path
  s = s + "  var path = \"${esc(tmpl)}\"\n"
  for x in op.params.filter(fn(x: Param) -> Bool { x.loc == "path" }) {
    let v = if x.client {
      "c.${x.name}"
    } else {
      match x.constant {
        Some(k) => k
        None => to_text(api, x.typ, x.name)
      }
    }
    // Go checks a string parameter that it escapes: not a reserved
    // (x-ms-skip-url-encoding) one, nor a number
    let stringy = x.typ == "Str" || is_enum(api, x.typ)
    if !p.allow_empty.contains(x.wire) && x.constant.is_none() && !x.skip_encoding && stringy {
      s = s + "  if ${v} == \"\" {\n    return Err(azcore.CallErr.InvalidInput(\"parameter ${esc(go_param_name(p, x))} cannot be empty\"))\n  }\n"
    }
    let enc = if x.skip_encoding { v } else { "url.path_escape(${v})" }
    s = s + "  path = path.replace(\"{${esc(x.wire)}}\", ${enc})\n"
  }
  // autorest.go: Accept when any response, the error one too, has a
  // schema; TypeSpec's emitter: when the success response has a body
  let accept = if p.data_plane { op.resp.is_some() || p.accept_always } else { op.accept }
  let accept_h = if accept { "(\"Accept\", \"application/json\")" } else { "" }
  s = s + "  var q = url.values()\n  var headers: List[(Str, Str)] = [${accept_h}]\n"
  // a reserved (x-ms-skip-url-encoding) query parameter goes after the
  // encoded query as it is, as Go's unencodedParams
  let has_raw = op.params.any(fn(x: Param) -> Bool { x.loc == "query" && x.skip_encoding })
  if has_raw {
    s = s + "  var raw_q: List[Str] = []\n"
  }
  for x in op.params.filter(fn(x: Param) -> Bool { x.loc == "query" || x.loc == "header" }) {
    let raw = x.loc == "query" && x.skip_encoding
    let target = if raw { "raw_q.push(\"${esc(x.wire)}=\" + " } else if x.loc == "query" { "q.add(\"${esc(x.wire)}\", " } else { "headers.push((\"${esc(x.wire)}\", " }
    let close = if x.loc == "query" { ")" } else { "))" }
    if let Some(k) = x.constant {
      s = s + "  ${target}${k}${close}\n"
    } else if x.required {
      s = s + "  ${target}${to_text(api, x.typ, x.name)}${close}\n"
    } else {
      s = s + "  if let Some(v) = options.${x.name} {\n    ${target}${to_text(api, x.typ, "v")}${close}\n  }\n"
    }
  }
  var body = "b\"\""
  for x in op.params.filter(fn(x: Param) -> Bool { x.loc == "body" }) {
    if x.required {
      s = s + "  headers.push((\"Content-Type\", \"application/json\"))\n"
      body = "runtime.marshal_json(${x.name})"
    } else {
      s = s + "  var body = b\"\"\n  if let Some(v) = options.${x.name} {\n    headers.push((\"Content-Type\", \"application/json\"))\n    body = runtime.marshal_json(v)\n  }\n"
      body = "body"
    }
  }
  // joined as Go's code does (runtime.JoinPaths, which cleans the path:
  // `/{scope}/...` with scope `/keys` is `/keys/...`)
  let base = "\${runtime.join_paths(c.setup.endpoint, path)}"
  let qs_expr = if has_raw { "([q.encode()] + raw_q).join(\"&\")" } else { "q.encode()" }
  s = s + "  let qs = ${qs_expr}\n  Ok(policy.Request{method: \"${op.method}\", url: \"${base}\${if qs == \"\" { \"\" } else { \"?\${qs}\" }}\", headers: headers, body: ${body}})\n}\n"
  let ok = op.ok.map(fn(n: Int) -> Str { "${n}" }).join(", ")
  let ok_list = if op.method == "HEAD" { "[${ok}, 404]" } else { "[${ok}]" }
  let call_args = req.map(fn(x: Param) -> Str { x.name }).join(", ")
  let handler = "fn(r: http.Response) -> ${rn} ! Str { ${hname}(r) }"
  s = s + "\n" + doc("", op.doc)
  if op.pageable {
    let pg = opts_name(p, op)
    s = s + "pub fn (c: ${cn}) ${method_name(op)}(${args}${sep}options: ${pg} = ${pg}{}) -> runtime.Pager[${rn}] ! azcore.CallErr {\n"
    s = s + "  let req = c.${snake_op}_create_request(${call_args}${sep}options)?\n"
    let next = match (op.next_link, op.resp) {
      (Some(nl), Some(t)) => if is_model(api, t) { "fn(r: ${rn}) -> Str? { r.${body_field(api, op)}.${snake(nl)} }" } else { "fn(r: ${rn}) -> Str? { None }" }
      _ => "fn(r: ${rn}) -> Str? { None }"
    }
    s = s + "  Ok(runtime.new_pager(c.setup.pipeline, req, ${handler}, ${next}))\n}\n"
  } else if op.lro && op.paged_lro {
    // Go's Poller[*Pager[T]]: the final response is the first page, and
    // the pager GETs each page's nextLink after it.
    let fsv = if op.final_state != "" { op.final_state } else { "" }
    let next = match (op.next_link, op.resp) {
      (Some(nl), Some(t)) => if is_model(api, t) { "fn(r: ${rn}) -> Str? { r.${body_field(api, op)}.${snake(nl)} }" } else { "fn(r: ${rn}) -> Str? { None }" }
      _ => "fn(r: ${rn}) -> Str? { None }"
    }
    let paged = "fn(r: http.Response) -> runtime.Pager[${rn}] ! Str { Ok(runtime.new_pager(pipeline, req, ${handler}, ${next}).starting_with(${hname}(r)?)) }"
    s = s + "pub fn (c: ${cn}) ${method_name(op)}(${args}${sep}options: ${on} = ${on}{}) -> runtime.Poller[runtime.Pager[${rn}]] ! azcore.CallErr uses (net.dial, clock, rand) {\n"
    s = s + "  let req = c.${snake_op}_create_request(${call_args}${sep}options)?\n  let pipeline = c.setup.pipeline\n"
    s = s + "  if options.resume_token != \"\" {\n    return runtime.resume_poller(c.setup.pipeline, options.resume_token, \"*Pager[${p.go_package}.${rn}]\", ${paged})\n  }\n"
    s = s + "  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))\n"
    s = s + "  if ![${ok}].contains(resp.status) {\n    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))\n  }\n"
    s = s + "  runtime.new_poller(c.setup.pipeline, req, resp, \"${esc(fsv)}\", \"*Pager[${p.go_package}.${rn}]\", ${paged})\n}\n"
  } else if op.lro {
    let fsv = if op.final_state != "" { op.final_state } else { "" }
    s = s + "pub fn (c: ${cn}) ${method_name(op)}(${args}${sep}options: ${on} = ${on}{}) -> runtime.Poller[${rn}] ! azcore.CallErr uses (net.dial, clock, rand) {\n"
    let kind = if op.status_poller { "status_" } else { "" }
    s = s + "  if options.resume_token != \"\" {\n    return runtime.resume_${kind}poller(c.setup.pipeline, options.resume_token, \"${rn}\", ${handler})\n  }\n"
    s = s + "  let req = c.${snake_op}_create_request(${call_args}${sep}options)?\n"
    s = s + "  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))\n"
    s = s + "  if ![${ok}].contains(resp.status) {\n    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))\n  }\n"
    s = s + "  runtime.new_${kind}poller(c.setup.pipeline, req, resp, \"${esc(fsv)}\", \"${rn}\", ${handler})\n}\n"
  } else {
    s = s + "pub fn (c: ${cn}) ${method_name(op)}(${args}${sep}options: ${on} = ${on}{}) -> ${rn} ! azcore.CallErr uses (net.dial, clock, rand) {\n"
    s = s + "  let req = c.${snake_op}_create_request(${call_args}${sep}options)?\n"
    s = s + "  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))\n"
    s = s + "  if !${ok_list}.contains(resp.status) {\n    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))\n  }\n"
    s = s + "  ${hname}(resp) ?? e => Err(azcore.CallErr.Decode(e))\n}\n"
  }
  s
}

pub fn emit_clients(p: Package, api: Api) -> List[File] {
  var groups: List[Str] = []
  for op in api.ops {
    if !groups.contains(op.group) {
      groups.push(op.group)
    }
  }
  var out: List[File] = []
  for g in groups.sort() {
    let ops = api.ops.filter(fn(o: Op) -> Bool { o.group == g })
    let has_sub = ops.any(fn(o: Op) -> Bool { o.params.any(fn(x: Param) -> Bool { x.client && x.name == "subscription_id" }) })
    let cn = client_name_in(p, g)
    var s = header(p)
    var body_text = ""
    for op in ops {
      body_text = body_text + emit_op(p, api, op, has_sub)
    }
    s = s + "use std/http\n"
    if body_text.contains("json.") {
      s = s + "use std/json\n"
    }
    s = s + "use std/url\n" + (if p.data_plane { "" } else { "use github.com/xo-lang/azure/arm\n" }) + "use github.com/xo-lang/azure/azcore\nuse github.com/xo-lang/azure/policy\n"
    if body_text.contains("runtime.") {
      s = s + "use github.com/xo-lang/azure/runtime\n"
    }
    s = s + "\n"
    if p.data_plane {
      s = s + body_text
      out.push(File{name: if g == "" { "client.xo" } else { "${snake(g)}_client.xo" }, text: s})
      continue
    }
    s = s + "/// ${cn}: the ${g} operations (Go's ${p.name}.${cn}).\npub struct ${cn} {\n  setup: arm.Setup\n"
    if has_sub {
      s = s + "  subscription_id: Str\n"
    }
    s = s + "}\n\n"
    let sub_arg = if has_sub { "subscription_id: Str, " } else { "" }
    let sub_set = if has_sub { ", subscription_id: subscription_id" } else { "" }
    s = s + "pub fn new_${snake(cn)}(net: Net, clock: Clock, rand: Rand, ${sub_arg}cred: azcore.TokenCredential, opts: arm.ClientOptions = arm.ClientOptions{}) -> ${cn} ! Str {\n"
    s = s + "  let setup = arm.new_pipeline(MODULE, VERSION, net, clock, rand, cred, opts)?\n  Ok(${cn}{setup: setup${sub_set}})\n}\n"
    s = s + body_text
    out.push(File{name: "${snake(g)}_client.xo", text: s})
  }
  out
}

const GO_KEYWORDS: List[Str] = ["break", "case", "chan", "const", "continue", "default", "defer", "else", "fallthrough", "for", "func", "go", "goto", "if", "import", "interface", "map", "package", "range", "return", "select", "struct", "switch", "type", "var"]

/// The name Go's generated code gives a parameter in its empty-value
/// error: autorest.go's Go casing with the first letter lowered
/// (`instanceID`, `publicIPAddressName`), `Param` after a Go keyword
/// (`typeParam`), and `client.<field>` for a client parameter
/// (`client.subscriptionID`). A data plane module's are TypeSpec's
/// (`settingName`).
fn go_param_name(p: Package, x: Param) -> Str {
  let n = if x.go_name != "" { x.go_name } else { x.wire }
  if p.data_plane {
    return n
  }
  var g = uncap_go(n)
  if GO_KEYWORDS.contains(g) {
    g = g + "Param"
  }
  if x.client { "client.${g}" } else { g }
}

/// autorest.go's parameter casing: the first word as written, its first
/// letter lowered (`vmName`, `skus`, `p2SVPNGatewayName`), each other
/// word in Go's casing (`instanceID`, `publicIPAddressName`).
fn uncap_go(n: Str) -> Str {
  let ws = type_words(n)
  if ws.is_empty() {
    return n
  }
  ws[0][0..1].to_lower() + ws[0][1..] + ws[1..].map(fn(w: Str) -> Str { cap(w) }).join("")
}
