// Emits an ARM module from its model (decision 0002): types with
// `derive Json` (wire names, nil fields omitted), string enums as
// newtypes with constants, and one client per operation group with
// Go's operations: plain, HEAD (a Bool), pageable (runtime.Pager) and
// long-running (runtime.Poller, resumable).

use std/regexp

pub struct File {
  pub name: Str
  pub text: Str
}

pub struct Package {
  /// Go's base type of a polymorphic model writes its discriminator
  /// always, null when unset (`objectMap["kind"] = b.Kind`, the older
  /// generators: azopenai v0.9.0, armauthorization v2.2.0); otherwise
  /// only when set (`populate`).
  pub null_base_discriminator: Bool = false
  /// tspconfig.yaml's typespec-go `stutter` (Custom.stutter): a group
  /// named so is `Client` in place of the one named as the package.
  pub stutter: Str = ""
  /// `armresources`
  pub name: Str
  pub module: Str
  pub version: Str
  pub source: Str
  /// A data plane module (TypeSpec's Go emitter, one `Client`): names
  /// are `<Op>Options` and `<Op>Response`, and the client struct and
  /// constructor are written by hand (custom_client.xo), as Go's are.
  pub data_plane: Bool = false
  /// Path parameters that may be empty (wire names).
  pub allow_empty: List[Str] = []
  /// The Go package's import path, for a paged operation's resume token
  /// type (`*Pager[<path>.<Response>]`, as reflect names it).
  pub go_package: Str = ""
  /// Accept on every data plane operation (custom/<module>.toml).
  pub accept_always: Bool = false
  /// The query's spaces as `%20` (see codegen/cmd/gen's CustomFile).
  pub query_pct20: Bool = false
  /// TypeSpec's Go emitter (custom `reachable_only`): responses carry
  /// their headers, and a HEAD operation fails on any status but its own.
  pub typespec: Bool = false
  /// An ARM module that TypeSpec's Go emitter writes (an `openapi` row):
  /// a client parameter's empty-value error names it bare
  /// (`subscriptionID`), Accept is sent only when a 2xx response has a
  /// body, and the query's spaces are `%20`.
  pub tsp_arm: Bool = false
  /// tspconfig.yaml's typespec-go `head-as-boolean: true`: a HEAD
  /// operation's response is `success` (armresources v4's CheckExistence),
  /// as autorest's readme.go.md option made it.
  pub head_as_boolean: Bool = false
  /// A hand-written function a next link header passes through before
  /// it is joined to the endpoint (azcontainerregistry's
  /// extractNextLink, from autorest.md's replace of `result.Link = &val`).
  pub next_link_transform: Str = ""
  /// Operations (operationId, lower case) and types Go's module hides
  /// (renamed lower case) for its own wrappers: not `pub` here.
  pub private_ops: List[Str] = []
  pub private_types: List[Str] = []
  /// A response header's field name where Go's differs from the
  /// header's words (`ocp-batch-file-isdirectory` is
  /// `ocp_batch_file_is_directory`, Go's OCPBatchFileIsDirectory).
  pub header_names: Map[Str, Str] = {}
}

/// A string literal's contents.
pub fn esc(s: Str) -> Str {
  s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\${", "\\\${").replace("\n", "\\n").replace("\r", "").replace("\t", " ")
}

/// A one-line doc comment, or none.
fn doc(indent: Str, text: Str) -> Str {
  let t = doc_ips(zero_guids(text.replace("\r", "").replace("\n", " ").replace("\t", " ").trim()))
  if t == "" { "" } else { "${indent}/// ${t}\n" }
}

/// `s` with every GUID (8-4-4-4-12 hex digits) written as the all-zero
/// GUID: a spec's example ids (`Ex: f83c6b1b-...`) are not copied into
/// the repository's documentation.
pub fn zero_guids(s: Str) -> Str {
  let b = s.bytes()
  let hex = fn(c: UInt8) -> Bool { (c >= 0x30 && c <= 0x39) || (c >= 0x61 && c <= 0x66) || (c >= 0x41 && c <= 0x46) }
  let groups = [8, 4, 4, 4, 12]
  var out = ""
  var last = 0
  var i = 0
  while i + 36 <= b.len() {
    var j = i
    var ok = i == 0 || !hex(b[i - 1])
    for (k, g) in groups.indexed() {
      if !ok {
        break
      }
      for _ in 0..g {
        if !hex(b[j]) {
          ok = false
          break
        }
        j += 1
      }
      if ok && k < 4 {
        if b[j] != 0x2d {
          ok = false
        }
        j += 1
      }
    }
    if ok && (j == b.len() || !hex(b[j])) {
      out = out + s[last..i] + "00000000-0000-0000-0000-000000000000"
      last = j
      i = j
    } else {
      i += 1
    }
  }
  out + s[last..s.len()]
}

/// `s` with every IPv4 address written in 192.0.2.0/24, its last byte
/// kept, but the ones scripts/check-public.sh allows: loopback, a network
/// prefix (`x.0.0.0`), the metadata endpoint, Key Vault's documented
/// 124.56.78.0/24 and the RFC 5737 ranges. A spec's examples (azbatch's
/// private address and subnet) are not copied into the documentation.
pub fn doc_ips(s: Str) -> Str {
  let b = s.bytes()
  let digit = fn(i: Int) -> Bool { i >= 0 && i < b.len() && b[i] >= 0x30 && b[i] <= 0x39 }
  let dot = fn(i: Int) -> Bool { i >= 0 && i < b.len() && b[i] == 0x2e }
  var out = ""
  var last = 0
  var i = 0
  while i < b.len() {
    if !digit(i) || digit(i - 1) || dot(i - 1) {
      i += 1
      continue
    }
    // four groups of one to three digits joined by dots
    var j = i
    var starts: List[Int] = []
    var ok = true
    for k in 0..4 {
      if k > 0 {
        if !dot(j) {
          ok = false
          break
        }
        j += 1
      }
      starts.push(j)
      var n = 0
      while digit(j) && n < 3 {
        j += 1
        n += 1
      }
      if n == 0 {
        ok = false
        break
      }
    }
    if !ok || digit(j) || (dot(j) && digit(j + 1)) {
      // not an address: skip the whole dotted number
      while digit(i) || (dot(i) && digit(i + 1)) {
        i += 1
      }
      continue
    }
    let ip = s[i..j]
    let keep = ip.starts_with("127.") || ip.ends_with(".0.0.0") || ip == "169.254.169.254" || ip.starts_with("124.56.78.") || ip.starts_with("192.0.2.") || ip.starts_with("198.51.100.") || ip.starts_with("203.0.113.")
    if !keep {
      out = out + s[last..i] + "192.0.2." + s[starts[3]..j]
      last = j
    }
    i = j
  }
  out + s[last..s.len()]
}

fn header(p: Package) -> Str {
  "// Code generated by xo-lang/azure codegen from azure-rest-api-specs\n// ${p.source}; MIT, Copyright (c) Microsoft Corporation (NOTICE.md).\n// DO NOT EDIT.\n\n"
}

fn is_model(api: Api, t: Str) -> Bool {
  api.models.any(fn(m: Model) -> Bool { m.name == t }) || api.polys.any(fn(p: Poly) -> Bool { p.name == t })
}

fn is_enum(api: Api, t: Str) -> Bool {
  api.enums.any(fn(e: StrEnum) -> Bool { e.name == t })
}

/// The text of a query or header value of type `t` held in `v`.
fn to_text(api: Api, t: Str, v: Str) -> Str {
  if t == "Str" {
    v
  } else if is_enum(api, t) {
    if api.enums.any(fn(e: StrEnum) -> Bool { e.name == t && e.base == "Int" }) { "\"\${${v}.0}\"" } else { "${v}.0" }
  } else if t == "Float32" {
    "azcore.float32_text(${v})"
  } else if t == "Int" || t == "Float" || t == "Bool" {
    "\"\${${v}}\""
  } else if t == "azcore.DateTime" {
    "azcore.date_time_text(${v})"
  } else if t == "azcore.DateTimeUTC" {
    "azcore.date_time_utc_text(${v})"
  } else if t == "azcore.DateTimeRFC1123" {
    "azcore.rfc1123_text(${v})"
  } else if t == "azcore.DateTimeRFC7231" {
    "azcore.rfc7231_text(${v})"
  } else if t == "Time" {
    "runtime.rfc1123_header_text(${v})"
  } else if t == "azcore.UnixTime" {
    "\"\${azcore.unix_seconds(${v})}\""
  } else if t == "azcore.Base64URL" {
    "azcore.base64url_text(${v})"
  } else if t == "List[Str]" {
    "${v}.join(\",\")"
  } else if t.starts_with("List[") && is_enum(api, t[5..t.len() - 1]) {
    // Go's strings.Join of fmt.Sprint's words: the values, comma joined
    "${v}.map(fn(x: ${t[5..t.len() - 1]}) -> Str { \"\${x.0}\" }).join(\",\")"
  } else {
    "json.encode_str(${v})"
  }
}

pub fn emit_models(p: Package, api: Api) -> File {
  var s = header(p)
  let wire_types = api.models.any(fn(m: Model) -> Bool { m.fields.any(fn(f: Field) -> Bool { f.typ.contains("azcore.") }) })
  let head = s
  s = ""
  s = s + "pub const MODULE: Str = \"${p.name}\"\npub const VERSION: Str = \"${p.version}\"\n/// The REST API version these operations are generated for.\npub const API_VERSION: Str = \"${esc(api.api_version)}\"\n"
  for e in api.enums {
    s = s + "\n" + doc("", e.doc) + "pub type ${e.name} struct(${e.base})\n"
    for (n, v, d) in e.values {
      let lit = if e.base == "Int" { v } else { "\"${esc(v)}\"" }
      s = s + doc("", d) + "pub const ${screaming(e.name)}_${n}: ${e.name} = ${e.name}(${lit})\n"
    }
    s = s + "\n/// The values of ${e.name} this version knows; the service may send others.\npub fn possible_${snake(e.name)}_values() -> List[${e.name}] {\n  [${e.values.map(fn(v: (Str, Str, Str)) -> Str { "${screaming(e.name)}_${v.0}" }).join(", ")}]\n}\n"
  }
  for p in api.polys {
    let sn = snake(p.name)
    s = s + "\n" + doc("", p.doc) + "pub enum ${p.name} {\n"
    for (t, v) in p.variants {
      s = s + "  /// ${p.tag} \"${esc(v)}\"\n  ${t}(from ${t})\n"
    }
    s = s + "  /// Any other ${p.tag}, as the base type.\n  ${p.base}(from ${p.base})\n} derive Json(via: json.Value, to: ${sn}_json, from: parse_${sn})\n"
    s = s + "\nfn ${sn}_json(c: ${p.name}) -> json.Value {\n  match c {\n"
    for (t, _) in p.variants {
      // the subtype's own JSON writes its discriminator value
      s = s + "    ${p.name}.${t}(x) => json.to_value(x)\n"
    }
    // the base's own JSON: its discriminator always (null when unset)
    // when Go's base writes it so, else only when set
    s = s + "    ${p.name}.${p.base}(x) => json.to_value(x)\n  }\n}\n"
    s = s + "\nfn parse_${sn}(v: json.Value) -> ${p.name} ! json.DecodeErr {\n  match v.get(\"${esc(p.tag)}\") {\n"
    for (t, v) in p.variants {
      s = s + "    Some(json.Value.Str(\"${esc(v)}\")) => Ok(${p.name}.${t}(json.from_value[${t}](v)?))\n"
    }
    s = s + "    _ => Ok(${p.name}.${p.base}(json.from_value[${p.base}](v)?))\n  }\n}\n"
  }
  if !api.polys.is_empty() {
    s = s + "\n/// `v` with its discriminator `key` set to `value`, as Go's\n/// MarshalJSON writes a subtype's (its keys sorted).\nfn with_discriminator(v: json.Value, key: Str, value: Str) -> json.Value {\n  match v {\n    json.Value.Object(fs) => json.Value.Object((fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != key }) + [(key, json.Value.Str(value))]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))\n    other => other\n  }\n}\n"
    if p.null_base_discriminator {
      s = s + "\n/// `v` with its discriminator `key` null when it has none, as Go's\n/// base type's MarshalJSON writes it (its keys sorted).\nfn with_discriminator_value(v: json.Value, key: Str) -> json.Value {\n  match v {\n    json.Value.Object(fs) if !fs.any(fn(f: (Str, json.Value)) -> Bool { f.0 == key }) => json.Value.Object((fs + [(key, json.Value.Null)]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))\n    other => other\n  }\n}\n"
    }
  }
  for m in api.models {
    // Go's unexported types (`internalACSRouterCommunicationError`) are
    // the module's own: UpperCamel, without `pub`
    let head = if m.private { "struct ${m.name}" } else { "pub struct ${m.name}" }
    s = s + "\n" + doc("", m.doc) + "${head} {\n"
    // Go's MarshalJSON fills a map[string]any, so json.Marshal writes the
    // keys sorted: the fields are declared in that order
    for f in m.fields.sort_by(fn(f: Field) -> Str { f.wire }) {
      s = s + doc("  ", f.doc) + (if m.patch { "  pub ${f.name} as \"${esc(f.wire)},omitempty\": json.Patch[${f.typ}] = json.Patch.Absent\n" } else { "  pub ${f.name} as \"${esc(f.wire)},omitempty\": ${f.typ}? = None\n" })
    }
    let disc = if m.patch { None } else { disc_of(api, m.name, p.null_base_discriminator) }
    let consts = !m.patch && m.fields.any(fn(f: Field) -> Bool { f.constant != "" })
    if (m.extra && !m.patch) || disc.is_some() || consts {
      s = s + emit_extra(m, disc)
    } else {
      s = s + "} derive Json\n"
    }
    if m.twin_of != "" {
      s = s + "\n/// `m` as a patch: each set field a value, each unset one Absent.\npub fn (m: ${m.twin_of}) patch() -> ${m.name} {\n  ${m.name}{\n"
      for f in m.fields {
        let v = if f.typ.ends_with("Patch") && api.models.any(fn(x: Model) -> Bool { x.name == f.typ && x.twin_of != "" }) { "json.Patch.Value(x.patch())" } else { "json.Patch.Value(x)" }
        s = s + "    ${f.name}: match m.${f.name} {\n      Some(x) => ${v}\n      None => json.Patch.Absent\n    },\n"
      }
      s = s + "  }\n}\n"
    }
  }
  if api.models.any(fn(m: Model) -> Bool { m.extra && !m.patch }) {
    s = s + "\n/// `v` with `extra`'s keys added (over a field's of the same name), as\n/// Go's MarshalJSON writes AdditionalProperties (its keys sorted).\nfn with_additional(v: json.Value, extra: Map[Str, json.Value]?) -> json.Value {\n  let m = extra ?? return v\n  match v {\n    json.Value.Object(fs) => {\n      var all = fs.filter(fn(f: (Str, json.Value)) -> Bool { !m.contains(f.0) })\n      for (k, x) in m {\n        all.push((k, x))\n      }\n      json.Value.Object(all.sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))\n    }\n    other => other\n  }\n}\n"
    s = s + "\n/// The keys of `v` no field names (Go's AdditionalProperties); None\n/// when there are none.\nfn additional_of(v: json.Value, known: List[Str]) -> Map[Str, json.Value]? {\n  match v {\n    json.Value.Object(fs) => {\n      var m: Map[Str, json.Value] = {}\n      for (k, x) in fs {\n        if !known.contains(k) {\n          m[k] = x\n        }\n      }\n      if m.is_empty() { None } else { Some(m) }\n    }\n    _ => None\n  }\n}\n"
  }
  let imports = (if s.contains("json.") { "use std/json\n" } else { "" }) + (if wire_types { "use github.com/xo-lang/azure/azcore\n" } else { "" })
  File{name: "models.xo", text: head + imports + (if imports == "" { "" } else { "\n" }) + s}
}

/// The parameters an operation's method takes in order, and those its
/// options hold.
fn split_params(op: Op) -> (List[Param], List[Param]) {
  let mine = op.params.filter(fn(x: Param) -> Bool { !x.client && x.constant.is_none() })
  (mine.filter(fn(x: Param) -> Bool { x.required }), mine.filter(fn(x: Param) -> Bool { !x.required }))
}

/// Go's client name: `<Group>Client`, or `Client` for the group named
/// as the package (armresources' Resources), or as tspconfig's `stutter`
/// when it names one (armdeployments' Deployments stays
/// DeploymentsClient).
fn client_name(group: Str) -> Str {
  "${part(group)}Client"
}

fn client_name_in(p: Package, group: Str) -> Str {
  let own = if p.stutter != "" { group.to_lower() == p.stutter.to_lower() } else { "arm${group.to_lower()}" == p.name }
  if own || (grouped(p) && (group == "" || "az${group.to_lower()}" == p.name)) { "Client" } else { client_name(group) }
}

/// A data plane module that autorest.go writes (not TypeSpec's emitter):
/// one client per operation group, the group named as the package
/// (without `az`) the package's `Client`, and options and responses
/// named after their client (`BlobClientGetBlobOptions`), as an ARM
/// module's are.
fn grouped(p: Package) -> Bool {
  p.data_plane && !p.typespec
}

fn resp_name(p: Package, op: Op) -> Str {
  if p.data_plane && !grouped(p) {
    return "${part(op.name)}Response"
  }
  "${client_name_in(p, op.group)}${part(op.name)}Response"
}

fn opts_name(p: Package, op: Op) -> Str {
  let cn = if p.data_plane && !grouped(p) { "" } else { client_name_in(p, op.group) }
  let on = if op.lro { "${cn}Begin${part(op.name)}Options" } else { "${cn}${part(op.name)}Options" }
  // a private options type (Go's lower case one) leaves its name to the
  // hand written public one that wraps it
  if p.private_types.contains(on) { "Raw${on}" } else { on }
}

fn method_name(op: Op) -> Str {
  if op.lro { "begin_${snake(op.name)}" } else if op.pageable { "new_${snake(op.name)}_pager" } else { snake(op.name) }
}

/// The response struct's field holding the body.
fn body_field(api: Api, op: Op) -> Str {
  if op.binary_resp {
    return snake(op.body_field)
  }
  match op.resp {
    Some(t) => if is_model(api, t) { snake(unreserve(t)) } else { "value" }
    None => ""
  }
}

/// The response field of header `wire`: Go's name (`x-ms-` dropped, each
/// `-` a word break: `Azure-AsyncOperation` is AzureAsyncOperation),
/// here azure_async_operation.
fn header_field(p: Package, wire: Str) -> Str {
  if let Some(n) = p.header_names.get(wire.to_lower()) {
    return n
  }
  var w = wire
  if w.to_lower().starts_with("x-ms-") {
    w = w[5..w.len()]
  }
  let n = snake(w.split("-").map(fn(x: Str) -> Str { cap(x) }).join(""))
  // Go's ETag, etag as the models name the property
  if n == "e_tag" { "etag" } else { n }
}

/// The headers a response struct carries: TypeSpec's Go emitter writes
/// a field for each header of a success response, but not on a
/// long-running operation (its result is the final body).
fn resp_headers(p: Package, op: Op) -> List[(Str, Str)] {
  if (p.typespec || grouped(p)) && !op.lro { op.resp_headers.sort_by(fn(h: (Str, Str)) -> Str { header_field(p, h.0) }) } else { [] }
}

/// The Accept value: the operation's `produces` but `application/json`
/// when it lists others (TypeSpec's Go emitter, from the success and
/// error content types), else `application/json`. From a swagger that
/// lists JSON and other types for a JSON body, autorest.go sends the
/// JSON ones (modelerfour's media types of the schema response:
/// azwebpubsub's `text/plain, application/json, text/json` is
/// `application/json, text/json`).
fn accept_value(p: Package, op: Op) -> Str {
  let jsons = op.produces.filter(fn(t: Str) -> Bool { t.contains("json") })
  if !p.typespec && !jsons.is_empty() && jsons.len() < op.produces.len() {
    return jsons.join(", ")
  }
  let own = op.produces.filter(fn(t: Str) -> Bool { t != "application/json" })
  if own.is_empty() { "application/json" } else { own.join(", ") }
}

fn emit_op(p: Package, api: Api, op: Op, has_sub: Bool) -> Str {
  let cn = client_name_in(p, op.group)
  let (req, opt) = split_params(op)
  let rn = resp_name(p, op)
  let on = opts_name(p, op)
  let snake_op = snake(op.name)
  let hname = if op.group == "" { "${snake_op}_handle" } else { "${snake(op.group)}_${snake_op}_handle" }
  let opts_vis = if on.starts_with("Raw") && p.private_types.contains(on[3..on.len()]) { "" } else { "pub " }
  var s = "\n" + doc("", "${on}: the optional parameters of ${cn}.${method_name(op)}.") + "${opts_vis}struct ${on} {\n"
  for x in opt {
    s = s + doc("  ", x.doc) + "  pub ${x.name}: ${x.typ}? = None\n"
  }
  if op.lro {
    s = s + "  /// Resumes the operation from a poller's resume_token instead of starting it.\n  pub resume_token: Str = \"\"\n"
  }
  s = s + "}\n"
  // the response
  s = s + "\n" + doc("", "${rn}: the response of ${cn}.${method_name(op)}.") + "pub struct ${rn} {\n"
  // ARM's head-as-boolean (autorest's readme.go.md option for ARM,
  // TypeSpec's tspconfig); not a data plane module's
  let exists_check = op.method == "HEAD" && ((!p.typespec && !grouped(p)) || p.head_as_boolean)
  let hs = resp_headers(p, op)
  if exists_check {
    s = s + "  /// Whether the resource exists (a 2xx response, not a 404).\n  pub success: Bool = false\n"
  } else if let Some(t) = op.resp {
    s = s + "  pub ${body_field(api, op)}: ${t}\n"
  }
  for (h, kind) in hs {
    let t = match kind {
      "int" => "Int"
      "bool" => "Bool"
      "time" => "Time"
      _ => "Str"
    }
    s = s + "  /// The `${esc(h)}` header.\n  pub ${header_field(p, h)}: ${t}? = None\n"
  }
  s = s + "}\n"
  // a pageable operation whose next link is a header (Go's response
  // field of the header hides the body's one of the same name)
  let link_header = if op.pageable { hs.map(fn(h: (Str, Str)) -> Str { h.0 }).filter(fn(h: Str) -> Bool { header_field(p, h) == snake(op.next_link ?? "") }).get(0) } else { None }
  let link_join = link_header.is_some() && p.next_link_transform != ""
  let hset = hs.map(fn(h: (Str, Str)) -> Str {
    let v = if h.1 != "" {
      header_field(p, h.0)
    } else if link_join && Some(h.0) == link_header {
      "runtime.header_value(resp, \"${esc(h.0)}\").map(fn(v: Str) -> Str { runtime.join_paths(endpoint, ${p.next_link_transform}(v)) })"
    } else {
      "runtime.header_value(resp, \"${esc(h.0)}\")"
    }
    ", ${header_field(p, h.0)}: ${v}"
  }).join("")
  // the pure response handler (given the endpoint when it joins a link)
  let endpoint_arg = if link_join { ", endpoint: Str" } else { "" }
  s = s + "\nfn ${hname}(resp: http.Response${endpoint_arg}) -> ${rn} ! Str {\n"
  // an integer header that does not parse fails as Go's strconv.ParseInt
  for (h, kind) in hs {
    let f = header_field(p, h)
    if kind == "int" {
      s = s + "  var ${f}: Int? = None\n  if let Some(v) = runtime.header_value(resp, \"${esc(h)}\") {\n    ${f} = Some(Int.parse(v) ?? return Err(\"strconv.ParseInt: parsing \\\"\${v}\\\": invalid syntax\"))\n  }\n"
    } else if kind == "bool" {
      s = s + "  var ${f}: Bool? = None\n  if let Some(v) = runtime.header_value(resp, \"${esc(h)}\") {\n    ${f} = Some(runtime.parse_bool(v)?)\n  }\n"
    } else if kind == "time" {
      s = s + "  var ${f}: Time? = None\n  if let Some(v) = runtime.header_value(resp, \"${esc(h)}\") {\n    ${f} = Some(runtime.parse_rfc1123_header(v)?)\n  }\n"
    }
  }
  if exists_check {
    s = s + "  Ok(${rn}{success: resp.status >= 200 && resp.status < 300})\n"
  } else if op.binary_resp {
    // the body as received (Go's io.ReadCloser, read whole here)
    s = s + "  Ok(${rn}{${body_field(api, op)}: resp.body${hset}})\n"
  } else if let Some(t) = op.resp {
    let zero = if api.models.any(fn(m: Model) -> Bool { m.name == t }) { Some("${t}{}") } else if t.starts_with("List[") { Some("[]") } else if t.starts_with("Map[") { Some("{}") } else if t == "Str" { Some("\"\"") } else if t == "json.Value" { Some("json.Value.Null") } else { None }
    if let Some(z) = zero {
      // Go's UnmarshalAsJSON leaves an empty body's result at its zero
      // value (a 304 page has none; a nil slice, map or any here is
      // empty, a nil string ""); a polymorphic result has none here
      // and keeps the error
      s = s + "  let v = if resp.body.is_empty() { ${z} } else { json.decode[${t}](resp.body) ?? e => return Err(e.display()) }\n  Ok(${rn}{${body_field(api, op)}: v${hset}})\n"
    } else {
      s = s + "  if resp.body.is_empty() {\n    return Err(\"the response has no body\")\n  }\n"
      s = s + "  let v = json.decode[${t}](resp.body) ?? e => return Err(e.display())\n  Ok(${rn}{${body_field(api, op)}: v${hset}})\n"
    }
  } else if hset != "" {
    s = s + "  Ok(${rn}{${hset[2..hset.len()]}})\n"
  } else {
    s = s + "  Ok(${rn}{})\n"
  }
  s = s + "}\n"
  // the request
  let args = req.map(fn(x: Param) -> Str { "${x.name}: ${x.typ}" }).join(", ")
  let sep = if args == "" { "" } else { ", " }
  s = s + "\nfn (c: ${cn}) ${snake_op}_create_request(${args}${sep}options: ${on}) -> policy.Request ! azcore.CallErr {\n"
  // a path that carries a query to tell two operations apart
  // (`/{roleId}?disambiguation_dummy`) is Go's urlPath without it
  let tmpl = op.path.cut("?").map(fn(t: (Str, Str)) -> Str { t.0 }) ?? op.path
  s = s + "  var path = \"${esc(tmpl)}\"\n"
  for x in op.params.filter(fn(x: Param) -> Bool { x.loc == "path" }) {
    let v = if x.client {
      "c.${x.name}"
    } else {
      match x.constant {
        Some(k) => k
        None => to_text(api, x.typ, x.name)
      }
    }
    // Go checks a string parameter that it escapes: not a reserved
    // (x-ms-skip-url-encoding) one, nor a number
    let stringy = x.typ == "Str" || is_enum(api, x.typ)
    if !p.allow_empty.contains(x.wire) && x.constant.is_none() && !x.skip_encoding && stringy {
      s = s + "  if ${v} == \"\" {\n    return Err(azcore.CallErr.InvalidInput(\"parameter ${esc(go_param_name(p, x))} cannot be empty\"))\n  }\n"
    }
    let enc = if x.skip_encoding { v } else { "url.path_escape(${v})" }
    s = s + "  path = path.replace(\"{${esc(x.wire)}}\", ${enc})\n"
  }
  // autorest.go: Accept when any response, the error one too, has a
  // schema; TypeSpec's emitter: when the success response has a body
  let accept = if (p.data_plane && !grouped(p)) || p.tsp_arm { op.resp.is_some() || p.accept_always } else { op.accept }
  let accept_h = if accept { "(\"Accept\", \"${esc(accept_value(p, op))}\")" } else { "" }
  s = s + "  var q = url.values()\n  var headers: List[(Str, Str)] = [${accept_h}]\n"
  // TypeSpec's Go emitter keeps the path's query (`?$expand=Properties`)
  // in the URL it parses, and each query parameter then replaces its
  // key: the path's keys that no parameter sets are sent
  if p.tsp_arm {
    if let Some((_, pq)) = op.path.cut("?") {
      let set = op.params.filter(fn(x: Param) -> Bool { x.loc == "query" }).map(fn(x: Param) -> Str { x.wire })
      for kv in pq.split("&") {
        let (k, v) = kv.cut("=") ?? (kv, "")
        if k != "" && !set.contains(k) && k != "api-version" {
          s = s + "  q.add(\"${esc(k)}\", \"${esc(v)}\")\n"
        }
      }
    }
  }
  // a reserved (x-ms-skip-url-encoding) query parameter goes after the
  // encoded query as it is, as Go's unencodedParams
  let has_raw = op.params.any(fn(x: Param) -> Bool { x.loc == "query" && x.skip_encoding })
  if has_raw {
    s = s + "  var raw_q: List[Str] = []\n"
  }
  for x in op.params.filter(fn(x: Param) -> Bool { x.loc == "query" || x.loc == "header" }) {
    let raw = x.loc == "query" && x.skip_encoding
    let target = if raw { "raw_q.push(\"${esc(x.wire)}=\" + " } else if x.loc == "query" { "q.add(\"${esc(x.wire)}\", " } else { "headers.push((\"${esc(x.wire)}\", " }
    let close = if x.loc == "query" { ")" } else { "))" }
    let elem = if x.typ.starts_with("List[") { x.typ[5..x.typ.len() - 1] } else { "Str" }
    let one = if elem == "Str" { "qv" } else { to_text(api, elem, "qv") }
    if x.multi && !raw && x.constant.is_none() {
      if x.required {
        s = s + "  for qv in ${x.name} {\n    q.add(\"${esc(x.wire)}\", ${one})\n  }\n"
      } else {
        s = s + "  if let Some(v) = options.${x.name} {\n    for qv in v {\n      q.add(\"${esc(x.wire)}\", ${one})\n    }\n  }\n"
      }
    } else if let Some(k) = x.constant {
      s = s + "  ${target}${k}${close}\n"
    } else if x.required {
      s = s + "  ${target}${to_text(api, x.typ, x.name)}${close}\n"
    } else {
      s = s + "  if let Some(v) = options.${x.name} {\n    ${target}${to_text(api, x.typ, "v")}${close}\n  }\n"
    }
  }
  var body = "b\"\""
  // form fields: one x-www-form-urlencoded body, each field set
  // (Go's url.Values Set, then Encode, which sorts the keys)
  let form = op.params.filter(fn(x: Param) -> Bool { x.loc == "formData" })
  if !form.is_empty() {
    s = s + "  var form = url.values()\n"
    for x in form {
      if let Some(k) = x.constant {
        s = s + "  form.set(\"${esc(x.wire)}\", ${k})\n"
      } else if x.required {
        s = s + "  form.set(\"${esc(x.wire)}\", ${to_text(api, x.typ, x.name)})\n"
      } else {
        s = s + "  if let Some(v) = options.${x.name} {\n    form.set(\"${esc(x.wire)}\", ${to_text(api, x.typ, "v")})\n  }\n"
      }
    }
    s = s + "  headers.push((\"Content-Type\", \"application/x-www-form-urlencoded\"))\n"
    body = "form.encode().bytes()"
  }
  for x in op.params.filter(fn(x: Param) -> Bool { x.loc == "body" }) {
    if x.binary {
      // sent as it is, with the content type parameter's value or the
      // operation's one content type
      let has_ct = op.params.any(fn(q: Param) -> Bool { q.loc == "header" && q.wire.to_lower() == "content-type" })
      let ct = if has_ct { "" } else { "  headers.push((\"Content-Type\", \"${esc(op.consumes.get(0) ?? "application/octet-stream")}\"))\n" }
      if x.required {
        s = s + ct
        body = x.name
      } else {
        s = s + "  var body = b\"\"\n  if let Some(v) = options.${x.name} {\n  ${ct}    body = v\n  }\n"
        body = "body"
      }
      continue
    }
    // the operation's one JSON content type (Batch's `application/json;
    // odata=minimalmetadata`); application/json when it has several
    let jct = if op.consumes.len() == 1 && op.consumes[0].contains("json") { esc(op.consumes[0]) } else { "application/json" }
    if x.required {
      s = s + "  headers.push((\"Content-Type\", \"${jct}\"))\n"
      body = "runtime.marshal_json(${x.name})"
    } else {
      s = s + "  var body = b\"\"\n  if let Some(v) = options.${x.name} {\n    headers.push((\"Content-Type\", \"${jct}\"))\n    body = runtime.marshal_json(v)\n  }\n"
      body = "body"
    }
  }
  // joined as Go's code does (runtime.JoinPaths, which cleans the path:
  // `/{scope}/...` with scope `/keys` is `/keys/...`)
  let base = "\${runtime.join_paths(c.setup.endpoint, path)}"
  let encoded = if p.query_pct20 || p.tsp_arm { "q.encode().replace(\"+\", \"%20\")" } else { "q.encode()" }
  let qs_expr = if has_raw { "([${encoded}] + raw_q).join(\"&\")" } else { encoded }
  // query parameters go into a query the joined URL already has (an
  // endpoint's, a Location's), as Go's code sets them on URL.Query()
  let sets_query = s.contains("  q.add(") || s.contains("    q.add(")
  if sets_query && !has_raw {
    let pct = if p.query_pct20 || p.tsp_arm { ", pct20: true" } else { "" }
    s = s + "  Ok(policy.Request{method: \"${op.method}\", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q${pct}), headers: headers, body: ${body}})\n}\n"
  } else {
    s = s + "  let qs = ${qs_expr}\n  Ok(policy.Request{method: \"${op.method}\", url: \"${base}\${if qs == \"\" { \"\" } else { \"?\${qs}\" }}\", headers: headers, body: ${body}})\n}\n"
  }
  let ok = op.ok.map(fn(n: Int) -> Str { "${n}" }).join(", ")
  let ok_list = if op.method == "HEAD" && ((!p.typespec && !grouped(p)) || p.head_as_boolean) && !op.ok.contains(404) { "[${ok}, 404]" } else { "[${ok}]" }
  let call_args = req.map(fn(x: Param) -> Str { x.name }).join(", ")
  let handler = "fn(r: http.Response) -> ${rn} ! Str { ${hname}(r${if link_join { ", c.setup.endpoint" } else { "" }}) }"
  s = s + "\n" + doc("", op.doc)
  // a private operation (Go's lower case one) is raw_<name>, leaving
  // <name> to a hand written public one that wraps it, if any
  let private = p.private_ops.contains("${cn}.${part(op.name)}")
  let vis = if private { "" } else { "pub " }
  let mname = if private { "raw_${method_name(op)}" } else { method_name(op) }
  if op.pageable {
    let pg = opts_name(p, op)
    s = s + "${vis}fn (c: ${cn}[fx]) ${mname}(${args}${sep}options: ${pg} = ${pg}{}) -> runtime.Pager[${rn}, fx] ! azcore.CallErr {\n"
    s = s + "  let req = c.${snake_op}_create_request(${call_args}${sep}options)?\n"
    let next = match (op.next_link, op.resp, link_header) {
      (_, _, Some(h)) => "fn(r: ${rn}) -> Str? { r.${header_field(p, h)} }"
      (Some(nl), Some(t), _) => if is_model(api, t) { "fn(r: ${rn}) -> Str? { r.${body_field(api, op)}.${snake(nl)} }" } else { "fn(r: ${rn}) -> Str? { None }" }
      _ => "fn(r: ${rn}) -> Str? { None }"
    }
    s = s + (if p.tsp_arm { "  Ok(runtime.new_next_link_pager(c.setup.pipeline, req, ${handler}, c.setup.endpoint, ${next}))\n}\n" } else { "  Ok(runtime.new_pager(c.setup.pipeline, req, ${handler}, ${next}))\n}\n" })
  } else if op.lro && op.paged_lro {
    // Go's Poller[*Pager[T]]: the final response is the first page, and
    // the pager GETs each page's nextLink after it.
    let fsv = if op.final_state != "" { op.final_state } else { "" }
    let next = match (op.next_link, op.resp) {
      (Some(nl), Some(t)) => if is_model(api, t) { "fn(r: ${rn}) -> Str? { r.${body_field(api, op)}.${snake(nl)} }" } else { "fn(r: ${rn}) -> Str? { None }" }
      _ => "fn(r: ${rn}) -> Str? { None }"
    }
    let paged = "fn(r: http.Response) -> runtime.Pager[${rn}, fx] ! Str { Ok(runtime.new_pager(pipeline, req, ${handler}, ${next}).starting_with(${hname}(r)?)) }"
    s = s + "pub fn (c: ${cn}[fx]) ${method_name(op)}(${args}${sep}options: ${on} = ${on}{}) -> runtime.Poller[runtime.Pager[${rn}, fx], fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {\n"
    s = s + "  let req = c.${snake_op}_create_request(${call_args}${sep}options)?\n  let pipeline = c.setup.pipeline\n"
    s = s + "  if options.resume_token != \"\" {\n    return runtime.resume_poller(c.setup.pipeline, options.resume_token, \"*Pager[${p.go_package}.${rn}]\", ${paged})\n  }\n"
    s = s + "  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))\n"
    s = s + "  if ![${ok}].contains(resp.status) {\n    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))\n  }\n"
    s = s + "  runtime.new_poller(c.setup.pipeline, req, resp, \"${esc(fsv)}\", \"*Pager[${p.go_package}.${rn}]\", ${paged})\n}\n"
  } else if op.lro {
    let fsv = if op.final_state != "" { op.final_state } else { "" }
    s = s + "pub fn (c: ${cn}[fx]) ${method_name(op)}(${args}${sep}options: ${on} = ${on}{}) -> runtime.Poller[${rn}, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {\n"
    let kind = if op.status_poller { "status_" } else { "" }
    s = s + "  if options.resume_token != \"\" {\n    return runtime.resume_${kind}poller(c.setup.pipeline, options.resume_token, \"${rn}\", ${handler})\n  }\n"
    s = s + "  let req = c.${snake_op}_create_request(${call_args}${sep}options)?\n"
    s = s + "  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))\n"
    s = s + "  if ![${ok}].contains(resp.status) {\n    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))\n  }\n"
    s = s + "  runtime.new_${kind}poller(c.setup.pipeline, req, resp, \"${esc(fsv)}\", \"${rn}\", ${handler})\n}\n"
  } else {
    s = s + "${vis}fn (c: ${cn}) ${mname}(${args}${sep}options: ${on} = ${on}{}) -> ${rn} ! azcore.CallErr uses (net.dial, clock, rand) {\n"
    s = s + "  let req = c.${snake_op}_create_request(${call_args}${sep}options)?\n"
    s = s + "  let resp = c.setup.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))\n"
    s = s + "  if !${ok_list}.contains(resp.status) {\n    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))\n  }\n"
    s = s + "  ${hname}(resp) ?? e => Err(azcore.CallErr.Decode(e))\n}\n"
  }
  s
}

pub fn emit_clients(p: Package, api: Api) -> List[File] {
  var groups: List[Str] = []
  for op in api.ops {
    if !groups.contains(op.group) {
      groups.push(op.group)
    }
  }
  var out: List[File] = []
  for g in groups.sort() {
    let ops = api.ops.filter(fn(o: Op) -> Bool { o.group == g })
    let has_sub = ops.any(fn(o: Op) -> Bool { o.params.any(fn(x: Param) -> Bool { x.client && x.name == "subscription_id" }) })
    let cn = client_name_in(p, g)
    var s = header(p)
    var body_text = ""
    for op in ops {
      body_text = body_text + emit_op(p, api, op, has_sub)
    }
    s = s + "use std/http\n"
    if body_text.contains("json.") {
      s = s + "use std/json\n"
    }
    s = s + "use std/url\n" + (if p.data_plane { "" } else { "use github.com/xo-lang/azure/arm\n" }) + "use github.com/xo-lang/azure/azcore\nuse github.com/xo-lang/azure/policy\n"
    if body_text.contains("runtime.") {
      s = s + "use github.com/xo-lang/azure/runtime\n"
    }
    s = s + "\n"
    if p.data_plane {
      s = s + body_text
      out.push(File{name: if grouped(p) { "${snake(cn)}.xo" } else if g == "" { "client.xo" } else { "${snake(g)}_client.xo" }, text: s})
      continue
    }
    s = s + "/// ${cn}: the ${g} operations (Go's ${p.name}.${cn}).\npub struct ${cn}[fx: Effects] {\n  setup: arm.Setup[fx]\n"
    if has_sub {
      s = s + "  subscription_id: Str\n"
    }
    s = s + "}\n\n"
    let sub_arg = if has_sub { "subscription_id: Str, " } else { "" }
    let sub_set = if has_sub { ", subscription_id: subscription_id" } else { "" }
    s = s + "pub fn new_${snake(cn)}[fx: Effects](net: Net, clock: Clock, rand: Rand, ${sub_arg}cred: azcore.TokenCredential[fx], opts: arm.ClientOptions[fx] = arm.ClientOptions{}) -> ${cn}[fx] ! Str {\n"
    s = s + "  let setup = arm.new_pipeline(MODULE, VERSION, net, clock, rand, cred, opts)?\n  Ok(${cn}{setup: setup${sub_set}})\n}\n"
    s = s + body_text
    out.push(File{name: "${snake(g)}_client.xo", text: s})
  }
  out
}

const GO_KEYWORDS: List[Str] = ["break", "case", "chan", "const", "continue", "default", "defer", "else", "fallthrough", "for", "func", "go", "goto", "if", "import", "interface", "map", "package", "range", "return", "select", "struct", "switch", "type", "var"]

/// The name Go's generated code gives a parameter in its empty-value
/// error: autorest.go's Go casing with the first letter lowered
/// (`instanceID`, `publicIPAddressName`), `Param` after a Go keyword
/// (`typeParam`), and `client.<field>` for a client parameter
/// (`client.subscriptionID`). A data plane module's are TypeSpec's
/// (`settingName`).
fn go_param_name(p: Package, x: Param) -> Str {
  let n = if x.go_name != "" { x.go_name } else { x.wire }
  // Go's casing, data plane too (autorest's `connectionID`, TypeSpec's
  // `jobID` and `workspaceID`)
  var g = uncap_go(n)
  if GO_KEYWORDS.contains(g) {
    g = g + "Param"
  }
  if x.client && !p.tsp_arm { "client.${g}" } else { g }
}

/// autorest.go's parameter casing: the first word as written, its first
/// letter lowered (`vmName`, `skus`, `p2SVPNGatewayName`), each other
/// word in Go's casing (`instanceID`, `publicIPAddressName`).
fn uncap_go(n: Str) -> Str {
  let ws = type_words(n)
  if ws.is_empty() {
    return n
  }
  ws[0][0..1].to_lower() + ws[0][1..] + ws[1..].map(fn(w: Str) -> Str { cap(w) }).join("")
}

/// Go's azsystemevents internal/generate constants (system_events.go):
/// for each model whose documentation names an event type (`<Model> -
/// ... for a Microsoft.X.Y event`, the first dotted name of three or four
/// parts), `TYPE_<model without EventData>`, sorted by the type.
pub fn emit_event_types(p: Package, api: Api) -> File ! Str {
  let re = regexp.compile("([^ ]+) -.+?([A-Za-z0-9]+(?:\\.[A-Za-z0-9]+){2,3})") ?? e => return Err(e.display())
  var found: Map[Str, (Str, Str)] = {}
  for m in api.models {
    // Go's comment lines for the type, joined with spaces
    let text = "${m.name} - ${m.doc.split("\n").map(fn(l: Str) -> Str { l.trim() }).filter(fn(l: Str) -> Bool { l != "" }).join(" ")}"
    let c = re.captures(text) ?? continue
    let ty = c[1] ?? ""
    let value = c[2] ?? ""
    let name = match ty.find("EventData") {
      Some(i) => ty[0..i] + ty[i + 9..ty.len()]
      None => ty
    }
    found[value] = ("Type${name}", ty)
  }
  var s = header(p)
  for value in found.keys().sort_by(fn(k: Str) -> Str { k }) {
    let (name, ty) = found.get(value) ?? continue
    s = s + "\n/// ${value}: data of ${ty}.\npub const ${screaming(name)}: Str = \"${esc(value)}\"\n"
  }
  Ok(File{name: "system_events.xo", text: s})
}

/// Generated text in xo fmt's layout where the emitters leave it
/// otherwise: an empty struct on one line (`pub struct X {}`) and no run
/// of blank lines longer than one.
pub fn tidy(text: Str) -> Str {
  let lines = text.split("\n")
  var out: List[Str] = []
  var i = 0
  while i < lines.len() {
    let l = lines[i]
    let is_struct = l.starts_with("pub struct ") || l.starts_with("struct ")
    if is_struct && l.ends_with(" {") && (lines.get(i + 1) ?? "") == "}" {
      out.push(l + "}")
      i += 2
      continue
    }
    if l == "" && !out.is_empty() && out[out.len() - 1] == "" && i + 1 < lines.len() {
      i += 1
      continue
    }
    out.push(l)
    i += 1
  }
  out.join("\n")
}

/// A polymorphic model's discriminator: (wire key, value, is the base).
/// Go's MarshalJSON writes a subtype's own value always, and the base's
/// field as it is (null when unset), however the model is reached.
fn disc_of(api: Api, name: Str, null_base: Bool) -> (Str, Str, Bool)? {
  for p in api.polys {
    for (t, v) in p.variants {
      if t == name {
        return Some((p.tag, v, false))
      }
    }
  }
  for p in api.polys {
    if null_base && p.base == name {
      return Some((p.tag, "", true))
    }
  }
  None
}

/// The end of a model with Go's AdditionalProperties, a discriminator
/// or a CONSTANT field: the extra field, its JSON through a private twin
/// of the named fields (constants as Go writes them), then the
/// discriminator and the unknown keys inline (Go's MarshalJSON and
/// UnmarshalJSON).
fn emit_extra(m: Model, disc: (Str, Str, Bool)? = None) -> Str {
  let sn = snake(m.name)
  let known = "${m.name}Known"
  let fs = m.fields.sort_by(fn(f: Field) -> Str { f.wire })
  var s = if m.extra && !m.patch { "  /// The keys no field names, as they came (Go's AdditionalProperties).\n  pub additional_properties: Map[Str, json.Value]? = None\n" } else { "" }
  s = s + "} derive Json(via: json.Value, to: ${sn}_json, from: parse_${sn})\n"
  s = s + "\n/// ${m.name}'s named fields, for its JSON.\nstruct ${known} {\n"
  for f in fs {
    s = s + "  ${f.name} as \"${esc(f.wire)},omitempty\": ${f.typ}? = None\n"
  }
  s = s + "} derive Json\n"
  s = s + "\nfn ${sn}_json(x: ${m.name}) -> json.Value {\n  let known = ${known}{\n"
  for f in fs {
    // Go writes a CONSTANT field as its constant: always when
    // required, when set when optional
    let c = "\"${esc(f.constant)}\""
    let value = if f.constant == "" { "x.${f.name}" } else if f.required { "Some(${c})" } else { "x.${f.name}.map(fn(_: Str) -> Str { ${c} })" }
    s = s + "    ${f.name}: ${value},\n"
  }
  let v = match disc {
    Some((tag, _, true)) => "with_discriminator_value(json.to_value(known), \"${esc(tag)}\")"
    Some((tag, value, false)) => "with_discriminator(json.to_value(known), \"${esc(tag)}\", \"${esc(value)}\")"
    None => "json.to_value(known)"
  }
  s = s + if m.extra && !m.patch { "  }\n  with_additional(${v}, x.additional_properties)\n}\n" } else { "  }\n  ${v}\n}\n" }
  s = s + "\nfn parse_${sn}(v: json.Value) -> ${m.name} ! json.DecodeErr {\n  let k = json.from_value[${known}](v)?\n  Ok(${m.name}{\n"
  for f in fs {
    s = s + "    ${f.name}: k.${f.name},\n"
  }
  if m.extra && !m.patch {
    let wires = fs.map(fn(f: Field) -> Str { "\"${esc(f.wire)}\"" }).join(", ")
    s = s + "    additional_properties: additional_of(v, [${wires}]),\n"
  }
  s = s + "  })\n}\n"
  s
}
