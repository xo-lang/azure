// A polymorphic model's JSON as Go's MarshalJSON writes it: a subtype
// its own discriminator value always; the base its field only when set,
// or always (null when unset) for the older generators' modules.

use std/json

fn poly_api() -> Api {
  let f = fn(n: Str, w: Str) -> Field { Field{name: n, wire: w, typ: "Str"} }
  Api{
    api_version: "1",
    ops: [],
    models: [Model{name: "Pet", fields: [f("kind", "kind")]}, Model{name: "Cat", fields: [f("kind", "kind"), f("lives", "lives")]}],
    enums: [],
    polys: [Poly{name: "PetClassification", base: "Pet", tag: "kind", variants: [("Cat", "cat")]}],
    report: [],
  }
}

test "a subtype writes its own discriminator; the base by the module's rule" {
  let p = Package{name: "armx", module: "m", version: "v0.1.0", source: "s"}
  let text = emit_models(p, poly_api()).text
  expect(text.contains("  with_discriminator(json.to_value(known), \"kind\", \"cat\")\n")) == true
  expect(text.contains("PetClassification.Cat(x) => json.to_value(x)\n")) == true
  expect(text.contains("PetClassification.Pet(x) => json.to_value(x)\n")) == true
  expect(text.contains("struct PetKnown")) == false
  expect(text.contains("fn with_discriminator_value")) == false
  let old = emit_models(p with {null_base_discriminator: true}, poly_api()).text
  expect(old.contains("  with_discriminator_value(json.to_value(known), \"kind\")\n")) == true
  expect(old.contains("struct PetKnown")) == true
}

test "a subtype with subtypes of its own is polymorphic by the inherited discriminator (armservicefabricmesh)" {
  var b = builder({}, "armx")
  b.files["f.json"] = json.parse_value("{\"definitions\":{\"Base\":{\"type\":\"object\",\"discriminator\":\"kind\",\"required\":[\"kind\"],\"properties\":{\"kind\":{\"type\":\"string\"}}},\"Mid\":{\"allOf\":[{\"$ref\":\"#/definitions/Base\"}],\"properties\":{\"a\":{\"type\":\"string\"}}},\"Leaf\":{\"x-ms-discriminator-value\":\"Local\",\"allOf\":[{\"$ref\":\"#/definitions/Mid\"}],\"properties\":{\"b\":{\"type\":\"string\"}}},\"Other\":{\"allOf\":[{\"$ref\":\"#/definitions/Base\"}]}}}")?
  expect(b.type_of("f.json", json.parse_value("{\"$ref\":\"#/definitions/Mid\"}")?, "")) == "MidClassification"
  expect(b.type_of("f.json", json.parse_value("{\"$ref\":\"#/definitions/Other\"}")?, "")) == "Other"
  let mid = b.polys.filter(fn(p: Poly) -> Bool { p.name == "MidClassification" }).get(0) ?? fault("no MidClassification")
  expect(mid.tag) == "kind"
  expect(mid.variants) == [("Leaf", "Local")]
}
