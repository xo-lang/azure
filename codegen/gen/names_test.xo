use std/json


test "names in Xo style from spec and Go names" {
  expect(snake("resourceGroupName")) == "resource_group_name"
  expect(snake("CreateOrUpdate")) == "create_or_update"
  expect(snake("HTTPServer")) == "http_server"
  expect(snake("subscriptionID")) == "subscription_id"
  expect(snake("$schema")) == "schema"
  expect(snake("type")) == "type_"
  expect(snake("x-ms-client-request-id")) == "x_ms_client_request_id"
  expect(pascal("resourceGroup")) == "ResourceGroup"
  expect(pascal("Error")) == "ErrorModel"
  expect(part("List")) == "List"
  expect(part("GetByID")) == "GetByID"
  expect(part("getById")) == "GetByID"
  expect(pascal("skuName")) == "SKUName"
  expect(part("Skus")) == "SKUs"
  expect(part("Status")) == "Status"
  expect(part("VirtualMachineScaleSetVMs")) == "VirtualMachineScaleSetVMs"
  expect(snake("VirtualMachineScaleSetVMs")) == "virtual_machine_scale_set_vms"
  expect(snake("select")) == "select_"
  expect(snake("ListByVMSize")) == "list_by_vm_size"
  expect(screaming("Succeeded")) == "SUCCEEDED"
  expect(screaming("Standard_LRS")) == "STANDARD_LRS"
}

test "autorest.go's acronyms, per word, and modelerfour's digit split" {
  expect(pascal("P2sVpnGateway")) == "P2SVPNGateway"
  expect(part("VirtualHubRouteTableV2s")) == "VirtualHubRouteTableV2S"
  expect(pascal("ApplicationGatewaySslPolicy")) == "ApplicationGatewaySSLPolicy"
  expect(pascal("AadAuthenticationParameters")) == "AADAuthenticationParameters"
  expect(pascal("VpnClientIpsecParameters")) == "VPNClientIPSecParameters"
  expect(pascal("Ipv6CircuitConnectionConfig")) == "IPv6CircuitConnectionConfig"
  expect(snake("ipsecPolicies")) == "ip_sec_policies"
  expect(snake("vmId")) == "vm_id"
  expect(snake("x-ms-snapshot")) == "x_ms_snapshot"
  expect(screaming("Standard_ND6s")) == "STANDARD_ND6S"
}

test "doc text writes every GUID as the all-zero GUID" {
  // made-up ids, joined here so no GUID is written in the repository
  let g = ["abcdef01", "2345", "6789", "abcd", "ef0123456789"].join("-")
  let z = "00000000-0000-0000-0000-000000000000"
  expect(zero_guids("Ex: ${g}.")) == "Ex: ${z}."
  expect(zero_guids("/subscriptions/${g.to_upper()}/rg")) == "/subscriptions/${z}/rg"
  expect(zero_guids("no id, 12345678-1234 and x1${g}")) == "no id, 12345678-1234 and x1${g}"
}

test "a number enum of whole values is an integer enum, as Go's int32" {
  let num = json.decode_str[json.Value]("{\"type\":\"number\",\"enum\":[0,1,5]}")?
  let frac = json.decode_str[json.Value]("{\"type\":\"number\",\"enum\":[0.5,1]}")?
  let int = json.decode_str[json.Value]("{\"type\":\"integer\",\"enum\":[1]}")?
  let str = json.decode_str[json.Value]("{\"type\":\"string\",\"enum\":[\"1\"]}")?
  expect([int_enum(num), int_enum(frac), int_enum(int), int_enum(str)]) == [true, false, true, false]
}
