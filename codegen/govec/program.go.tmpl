// {{.Pkg}} {{.Version}} vectors: every public method of each client called by
// reflection with every option and argument filled, through a fake
// transport (no network). Each call prints its inputs as JSON (for the
// Xo test to rebuild), the request, the response it was served and the
// result.
package main

import (
	"bytes"
	"context"
	"encoding/json"
