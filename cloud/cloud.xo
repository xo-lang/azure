// Azure clouds: the Entra ID authority host and each service's endpoint
// and token audience, as azcore's cloud package (MIT, Copyright (c)
// Microsoft Corporation; NOTICE.md).

/// A service's endpoint and the audience its tokens are for.
pub struct ServiceConfiguration {
  pub audience: Str
  pub endpoint: Str
}

/// A cloud: where tokens come from and where its services are.
pub struct Configuration {
  /// The Entra ID authority, with a trailing slash.
  pub authority_host: Str
  /// Keyed by service name (RESOURCE_MANAGER, ...).
  pub services: Map[Str, ServiceConfiguration] = {}
}

/// The key of Azure Resource Manager in `Configuration.services`.
pub const RESOURCE_MANAGER: Str = "resourceManager"

pub const AZURE_PUBLIC: Configuration = Configuration{
  authority_host: "https://login.microsoftonline.com/",
  services: {RESOURCE_MANAGER: ServiceConfiguration{audience: "https://management.core.windows.net/", endpoint: "https://management.azure.com"}},
}

pub const AZURE_CHINA: Configuration = Configuration{
  authority_host: "https://login.chinacloudapi.cn/",
  services: {RESOURCE_MANAGER: ServiceConfiguration{audience: "https://management.core.chinacloudapi.cn/", endpoint: "https://management.chinacloudapi.cn"}},
}

pub const AZURE_GOVERNMENT: Configuration = Configuration{
  authority_host: "https://login.microsoftonline.us/",
  services: {RESOURCE_MANAGER: ServiceConfiguration{audience: "https://management.core.usgovcloudapi.net/", endpoint: "https://management.usgovcloudapi.net"}},
}
