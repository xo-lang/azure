use std/json

struct Doc {
  pub at as "at,omitempty": DateTime? = None
  pub http as "http,omitempty": DateTimeRFC1123? = None
  pub unix as "unix,omitempty": UnixTime? = None
  pub raw as "raw,omitempty": Base64URL? = None
} derive Json

const T: Int = 1793847845

test "date-time reads RFC 3339 with or without an offset, as Go's generated code does" {
  for s in ["2026-11-05T03:04:05Z", "2026-11-05T03:04:05.1234567Z", "2026-11-05T03:04:05.1234567", "2026-11-05T05:04:05+02:00", "2026-11-04T22:04:05-05:00", "2026-11-05t03:04:05z"] {
    let d = json.decode_str[Doc]("{\"at\":\"${s}\"}")?
    expect(d.at.map(fn(t: DateTime) -> Int { t.0.unix() })) == Some(T)
  }
  expect(json.decode_str[Doc]("{\"at\":\"yesterday\"}").is_err()) == true
  expect(json.encode_str(Doc{at: Some(DateTime(Time.from_unix(T)))})) == "{\"at\":\"2026-11-05T03:04:05Z\"}"
}

test "date-time-rfc1123, unixtime and base64url have their own wire forms" {
  let d = json.decode_str[Doc]("{\"http\":\"Thu, 05 Nov 2026 03:04:05 GMT\",\"unix\":1793847845,\"raw\":\"-_8\"}")?
  expect(d.http.map(fn(t: DateTimeRFC1123) -> Int { t.0.unix() })) == Some(T)
  expect(d.unix.map(fn(t: UnixTime) -> Int { t.0.unix() })) == Some(T)
  expect(d.raw.map(fn(b: Base64URL) -> Bytes { b.0 })) == Some(b"\xfb\xff")
  expect(json.decode_str[Doc]("{\"raw\":\"-_8=\"}")?.raw.map(fn(b: Base64URL) -> Bytes { b.0 })) == Some(b"\xfb\xff")
  let out = Doc{http: Some(DateTimeRFC1123(Time.from_unix(T))), unix: Some(UnixTime(Time.from_unix(T))), raw: Some(Base64URL(b"\xfb\xff"))}
  expect(json.encode_str(out)) == "{\"http\":\"Thu, 05 Nov 2026 03:04:05 GMT\",\"unix\":1793847845,\"raw\":\"-_8\"}"
}
