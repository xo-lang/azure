// URLs read and written the way Go's net/url reads and writes them
// (url.Parse, URL.String, URL.Query, host and path escaping, and
// strconv.Quote for its errors), for the
// modules that must split or rebuild a URL as Go's do: the storage
// modules' URLParts and SAS URLs, and Web PubSub's connection strings
// and client access URLs. Written to Go's behavior and checked against
// Go's output (azqueue's sasvectors_test.xo, azfile's
// urlvectors_test.xo, azwebpubsub's vectors_test.xo), not copied from
// it. User info is checked but not kept, and an opaque URL keeps only
// its scheme and query, as storage's ParseURL sees it.

use std/netip
use std/url

/// Go's strconv.Quote of ASCII text: `\a`, `\b`, `\f`, `\n`, `\r`, `\t`
/// and `\v` by name, the other control bytes and DEL as `\xNN`.
pub fn go_quote(s: Str) -> Str {
  var out = "\""
  for c in s.runes() {
    let n = Int(c)
    out = out + (if c == '"' { "\\\"" } else if c == '\\' { "\\\\" } else if c == '\n' { "\\n" } else if c == '\t' { "\\t" } else if c == '\r' { "\\r" } else if n == 7 { "\\a" } else if n == 8 { "\\b" } else if n == 12 { "\\f" } else if n == 11 { "\\v" } else if n < 0x20 || n == 0x7f { "\\x" + n.to_str_width(2, base: 16, zero: true) } else { "${c}" })
  }
  out + "\""
}

/// Whether `f` holds for every byte of `s`.
pub fn all_bytes(s: Str, f: fn(UInt8) -> Bool) -> Bool {
  let bs = s.bytes()
  for i in 0..bs.len() {
    if !f(bs[i]) {
      return false
    }
  }
  true
}

/// Whether `b` is one of the bytes of `set`.
pub fn has_byte(set: Str, b: UInt8) -> Bool {
  !all_bytes(set, fn(c: UInt8) -> Bool { c != b })
}

/// Whether `b` is one of RFC 3986's unreserved bytes (Go's shouldEscape
/// keeps them in every mode).
pub fn is_unreserved(b: UInt8) -> Bool {
  (b >= 0x41 && b <= 0x5a) || (b >= 0x61 && b <= 0x7a) || (b >= 0x30 && b <= 0x39) || b == 0x2d || b == 0x5f || b == 0x2e || b == 0x7e
}

/// A path escaped as Go's url.URL writes one (escape with encodePath):
/// `$&+,/:;=@` and the unreserved bytes kept, the rest `%XX`.
pub fn go_escape_path(s: Str) -> Str {
  var out = ""
  let bs = s.bytes()
  for i in 0..bs.len() {
    let b = bs[i]
    if is_unreserved(b) || has_byte("$&+,/:;=@", b) {
      out = out + bs[i..i + 1].to_str_lossy()
    } else {
      out = out + "%" + Int(b).to_str_width(2, base: 16, zero: true).to_upper()
    }
  }
  out
}

/// A URL as Go's url.Parse splits it: the scheme lower-cased, the host as
/// written, the path unescaped and the raw query. The fragment is
/// dropped.
pub struct GoUrl {
  pub scheme: Str = ""
  pub host: Str = ""
  pub path: Str = ""
  pub raw_query: Str = ""
}

/// The scheme and the rest, as Go's getScheme: a letter, then letters,
/// digits, `+`, `-` or `.`, up to a `:`; anything else first means no
/// scheme.
fn split_scheme(raw: Str) -> (Str, Str) ! Str {
  var i = 0
  for c in raw.runes() {
    let letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
    let more = (c >= '0' && c <= '9') || c == '+' || c == '-' || c == '.'
    if letter || (more && i > 0) {
      i = i + 1
      continue
    }
    if c == ':' {
      if i == 0 {
        return Err("missing protocol scheme")
      }
      return Ok((raw[0..i].to_lower(), raw[i + 1..raw.len()]))
    }
    return Ok(("", raw))
  }
  Ok(("", raw))
}

fn hex_val(c: UInt8) -> Int? {
  if c >= 0x30 && c <= 0x39 { Some(Int(c) - 0x30) } else if c >= 0x61 && c <= 0x66 { Some(Int(c) - 0x61 + 10) } else if c >= 0x41 && c <= 0x46 { Some(Int(c) - 0x41 + 10) } else { None }
}

/// Whether Go's shouldEscape(c, encodeHost) escapes `c`.
fn host_escapes(c: UInt8) -> Bool {
  !(is_unreserved(c) || has_byte("!$&'()*+,;=:[]<>\"", c))
}

/// The modes of Go's unescape this file reads: a host, an IPv6 zone
/// (from its `%25`), and a fragment or user info, where only an escape's
/// form is checked.
const UNESCAPE_HOST: Int = 0
const UNESCAPE_ZONE: Int = 1
const UNESCAPE_OTHER: Int = 2

/// `s` unescaped as Go's unescape does in `mode`: a `%` needs two hex
/// digits; in a host only `%25` and bytes from 0x80 may be escaped and
/// the other bytes must be ones a host keeps; a zone may escape a space
/// and those bytes too.
fn go_unescape(s: Str, mode: Int) -> Str ! Str {
  let bs = s.bytes()
  var i = 0
  while i < bs.len() {
    let b = bs[i]
    if b == 0x25 {
      let bad = bs[i..(if i + 3 < bs.len() { i + 3 } else { bs.len() })].to_str_lossy()
      if i + 2 >= bs.len() {
        return Err("invalid URL escape ${go_quote(bad)}")
      }
      let hi = hex_val(bs[i + 1]) ?? return Err("invalid URL escape ${go_quote(bad)}")
      let lo = hex_val(bs[i + 2]) ?? return Err("invalid URL escape ${go_quote(bad)}")
      let is25 = hi == 2 && lo == 5
      if mode == UNESCAPE_HOST && hi < 8 && !is25 {
        return Err("invalid URL escape ${go_quote(bad)}")
      }
      let v = UInt8(hi * 16 + lo)
      if mode == UNESCAPE_ZONE && !is25 && v != 0x20 && host_escapes(v) {
        return Err("invalid URL escape ${go_quote(bad)}")
      }
      i = i + 3
      continue
    }
    if mode != UNESCAPE_OTHER && b < 0x80 && host_escapes(b) {
      return Err("invalid character ${go_quote(bs[i..i + 1].to_str_lossy())} in host name")
    }
    i = i + 1
  }
  var out = BytesBuilder.new()
  i = 0
  while i < bs.len() {
    if bs[i] == 0x25 {
      out.write_byte(UInt8((hex_val(bs[i + 1]) ?? 0) * 16 + (hex_val(bs[i + 2]) ?? 0)))
      i = i + 3
    } else {
      out.write_byte(bs[i])
      i = i + 1
    }
  }
  Ok(out.freeze().to_str_lossy())
}

/// Go's validOptionalPort: empty, or `:` and digits.
fn valid_optional_port(p: Str) -> Bool {
  p == "" || (p.starts_with(":") && all_bytes(p[1..p.len()], fn(b: UInt8) -> Bool { b >= 0x30 && b <= 0x39 }))
}

/// The host as Go's parseHost reads it: an IP literal in brackets must
/// be an IPv6 address (its zone after `%25`), and a port must be digits.
fn parse_host(host: Str) -> Str ! Str {
  if let Some(open) = host.rfind("[") {
    if open > 0 {
      return Err("invalid IP-literal")
    }
    let close = host.rfind("]") ?? return Err("missing ']' in host")
    let colon_port = host[close + 1..host.len()]
    if !valid_optional_port(colon_port) {
      return Err("invalid port ${go_quote(colon_port)} after host")
    }
    let name = host[1..close]
    let unescaped = match name.find("%25") {
      Some(z) => go_unescape(name[0..z], UNESCAPE_HOST)? + go_unescape(name[z..name.len()], UNESCAPE_ZONE)?
      None => go_unescape(name, UNESCAPE_HOST)?
    }
    let addr = netip.parse_addr(unescaped) ?? e => return Err("invalid host: ${e.display()}")
    if addr.is_4() {
      return Err("invalid IP-literal")
    }
    return Ok("[${unescaped}]${colon_port}")
  }
  if let Some(i) = host.find(":") {
    let colon_port = host[i..host.len()]
    if !valid_optional_port(colon_port) {
      return Err("invalid port ${go_quote(colon_port)} after host")
    }
  }
  go_unescape(host, UNESCAPE_HOST)
}

/// Go's validUserinfo.
fn valid_userinfo(s: Str) -> Bool {
  s.runes().all(fn(r: Rune) -> Bool { (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') || "-._:~!$&'()*+,;=%@".contains("${r}") })
}

/// The host of an authority, as Go's parseAuthority: after the last `@`,
/// the user info before it checked but not kept.
fn parse_authority(auth: Str) -> Str ! Str {
  let at = auth.rfind("@") ?? return parse_host(auth)
  let host = parse_host(auth[at + 1..auth.len()])?
  let info = auth[0..at]
  if !valid_userinfo(info) {
    return Err("net/url: invalid userinfo")
  }
  match info.find(":") {
    Some(c) => {
      go_unescape(info[0..c], UNESCAPE_OTHER)?
      go_unescape(info[c + 1..info.len()], UNESCAPE_OTHER)?
    }
    None => { go_unescape(info, UNESCAPE_OTHER)? }
  }
  Ok(host)
}

/// A host escaped as Go's URL.String writes one (escape with encodeHost).
fn escape_host(h: Str) -> Str {
  var out = ""
  let bs = h.bytes()
  for i in 0..bs.len() {
    let b = bs[i]
    if host_escapes(b) {
      out = out + "%" + Int(b).to_str_width(2, base: 16, zero: true).to_upper()
    } else {
      out = out + bs[i..i + 1].to_str_lossy()
    }
  }
  out
}

/// `u` read as Go's url.Parse reads it, with its error text: an error
/// names the URL without its fragment, but one in the fragment names
/// all of it.
pub fn parse_go_url(u: Str) -> GoUrl ! Str {
  let (raw, frag) = match u.find("#") {
    Some(i) => (u[0..i], u[i + 1..u.len()])
    None => (u, "")
  }
  let g = parse_go_ref(raw) ?? e => return Err("parse ${go_quote(raw)}: ${e}")
  if frag != "" {
    go_unescape(frag, UNESCAPE_OTHER) ?? e => return Err("parse ${go_quote(u)}: ${e}")
  }
  Ok(g)
}

/// Go's parse of a URL without its fragment.
fn parse_go_ref(raw: Str) -> GoUrl ! Str {
  if !all_bytes(raw, fn(b: UInt8) -> Bool { b >= 0x20 && b != 0x7f }) {
    return Err("net/url: invalid control character in URL")
  }
  let (scheme, after) = split_scheme(raw)?
  let (rest, query) = match after.find("?") {
    Some(i) => (after[0..i], after[i + 1..after.len()])
    None => (after, "")
  }
  if !rest.starts_with("/") {
    // Go: after a scheme it is opaque (no path); without one a colon in
    // the first segment is an error.
    if scheme != "" {
      return Ok(GoUrl{scheme: scheme, raw_query: query})
    }
    if (rest.split("/")[0]).contains(":") {
      return Err("first path segment in URL cannot contain colon")
    }
  }
  var host = ""
  var path = rest
  if (scheme != "" || !rest.starts_with("///")) && rest.starts_with("//") {
    let auth_path = rest[2..rest.len()]
    let (auth, p) = match auth_path.find("/") {
      Some(i) => (auth_path[0..i], auth_path[i..auth_path.len()])
      None => (auth_path, "")
    }
    host = parse_authority(auth)?
    path = p
  }
  let unescaped = url.path_unescape(path) ?? e => return Err(e.display())
  Ok(GoUrl{scheme: scheme, host: host, path: unescaped, raw_query: query})
}

/// A query as Go's URL.Query reads one: pairs split on `&`, then the
/// first `=`, both query-unescaped. A pair with a `;` or a bad escape is
/// left out and the rest kept; more than 10000 pairs read as none.
pub fn go_query(raw: Str) -> url.Values {
  var v = url.values()
  if raw.count("&") + 1 > 10000 {
    return v
  }
  for pair in raw.split("&") {
    if pair == "" || pair.contains(";") {
      continue
    }
    let (k, val) = match pair.find("=") {
      Some(i) => (pair[0..i], pair[i + 1..pair.len()])
      None => (pair, "")
    }
    let key = url.query_unescape(k) ?? _ => continue
    let value = url.query_unescape(val) ?? _ => continue
    v.add(key, value)
  }
  v
}

/// The URL as Go's URL.String writes one with these fields: `//` before
/// a host (or before a path when there is a scheme), the path escaped, a
/// `/` added between a host and a relative path, `./` before a relative
/// path whose first segment has a `:`, and the query.
pub fn (g: GoUrl) to_str() -> Str {
  var out = ""
  if g.scheme != "" {
    out = "${g.scheme}:"
  }
  if g.scheme != "" || g.host != "" {
    if g.host != "" || g.path != "" {
      out = out + "//"
    }
    out = out + escape_host(g.host)
  }
  let p = if g.path == "*" { "*" } else { go_escape_path(g.path) }
  if p != "" && !p.starts_with("/") && g.host != "" {
    out = out + "/"
  }
  if out == "" && (p.split("/")[0]).contains(":") {
    out = "./"
  }
  out = out + p
  if g.raw_query != "" {
    out = "${out}?${g.raw_query}"
  }
  out
}
