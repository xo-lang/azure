test "go_quote is Go's strconv.Quote for every ASCII byte" {
  var out: List[Str] = []
  for b in 0..128 {
    var bb = BytesBuilder.new()
    bb.write_byte(UInt8(b))
    out.push(go_quote("a" + bb.freeze().to_str_lossy() + "z"))
  }
  out.push(go_quote("été ✓"))
  expect(out) == QUOTE_OUTPUT
}
