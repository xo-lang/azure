// The wire forms of Azure's times and bytes, as the generated Go
// modules' time_rfc3339.go, time_rfc1123.go, time_unix.go and azcore's
// runtime.EncodeByteArray handle them (MIT, Copyright (c) Microsoft
// Corporation; NOTICE.md). Generated models use these for the spec
// formats `date-time`, `date-time-rfc1123`, `unixtime` and `base64url`.

use std/base64
use std/time

/// A `date-time`: RFC 3339, read and written as Go's generated
/// dateTimeRFC3339 (a time.Time) reads and writes it. The offset
/// round-trips: a time read as `2026-01-02T04:04:05+01:00` keeps `offset`
/// +01:00 and is written back as `2026-01-02T04:04:05+01:00`, as Go's
/// time.Time keeps the offset it parsed. A time without an offset
/// (`2026-11-05T03:04:05.1234567`, which some services send) is UTC, a
/// space may stand for the `T`, and a zero offset is written `Z`.
/// Equality compares the offset too, as Go's == on a time.Time compares
/// its location; compare `time` for the instant alone.
pub struct DateTime {
  /// The instant.
  pub time: Time
  /// The offset from UTC it is written with (east positive); 0 writes `Z`.
  pub offset: Duration = 0s
} derive Json(via: Str, to: date_time_text, from: parse_date_time)

/// `t` as a DateTime written in UTC.
pub fn utc_date_time(t: Time) -> DateTime {
  DateTime{time: t}
}

pub fn date_time_text(t: DateTime) -> Str {
  time.format(t.time, time.fixed("", t.offset), time.RFC3339)
}

/// Whether `s` ends in an offset: `Z`, `z`, or `+hh:mm`/`-hh:mm` after
/// the time.
fn has_offset(s: Str) -> Bool {
  if s.ends_with("Z") || s.ends_with("z") {
    return true
  }
  let t = s.find("T") ?? s.find("t") ?? return false
  let rest = s[t..s.len()]
  rest.contains("+") || rest.contains("-")
}

pub fn parse_date_time(s: Str) -> DateTime ! Str {
  var text = s.replace("t", "T").replace("z", "Z")
  if !text.contains("T") {
    // Go's layouts without the T take a space there
    text = text.replace_n(" ", "T", 1)
  }
  if !has_offset(text) {
    text = "${text}Z"
  }
  let bad = Err("invalid date-time \"${s}\"")
  let t = Time.parse_rfc3339(text) ?? return bad
  // the offset std reads with the instant (Go's Zone() after time.Parse)
  let offset = Time.rfc3339_offset(text) ?? return bad
  if offset.abs() >= 24h {
    return bad
  }
  Ok(DateTime{time: t, offset: offset})
}

/// A `date-time-rfc1123`: `Thu, 05 Nov 2026 03:04:05 GMT`.
pub type DateTimeRFC1123 struct(Time) derive Json(via: Str, to: rfc1123_text, from: parse_rfc1123)

pub fn rfc1123_text(t: DateTimeRFC1123) -> Str {
  time.format(t.0, time.utc(), time.RFC1123).replace(" UTC", " GMT")
}

pub fn parse_rfc1123(s: Str) -> DateTimeRFC1123 ! Str {
  let t = time.parse(s.replace(" GMT", " UTC"), time.RFC1123, time.utc()) ?? _ => return Err("invalid date-time-rfc1123 \"${s}\"")
  Ok(DateTimeRFC1123(t))
}

/// azcore v1.22.0's datetime.RFC7231: an RFC 1123 time written in GMT
/// (`Fri, 06 Nov 2026 09:04:05 GMT`) and read as Go reads it, case
/// insensitively, any zone abbreviation (`GMT`, `UTC`, `CET`, ...) at
/// offset 0 as Go's time.Parse takes an abbreviation it does not know.
pub type DateTimeRFC7231 struct(Time) derive Json(via: Str, to: rfc7231_text, from: parse_rfc7231)

pub fn rfc7231_text(t: DateTimeRFC7231) -> Str {
  rfc1123_text(DateTimeRFC1123(t.0))
}

pub fn parse_rfc7231(s: Str) -> DateTimeRFC7231 ! Str {
  let bad = Err("invalid date-time-rfc7231 \"${s}\"")
  let parts = s.to_upper().split(" ")
  if parts.len() != 6 || !zone_abbreviation(parts[5]) {
    return bad
  }
  // Go reads the weekday's name but does not check it against the date
  if !["MON,", "TUE,", "WED,", "THU,", "FRI,", "SAT,", "SUN,"].contains(parts[0]) {
    return bad
  }
  let text = "${parts[1]} ${title(parts[2])} ${parts[3]} ${parts[4]} UTC"
  let t = time.parse(text, "{day} {month:short} {year} {hour}:{minute}:{second} {zone}", time.utc()) ?? _ => return bad
  Ok(DateTimeRFC7231(t))
}

/// `FRI,` as `Fri,`.
fn title(w: Str) -> Str {
  if w.len() < 2 { w } else { w[0..1] + w[1..w.len()].to_lower() }
}

/// A zone Go's parseTimeZone reads as an abbreviation: three letters,
/// or four or five ending in `T`.
fn zone_abbreviation(z: Str) -> Bool {
  for c in z.bytes() {
    if c < 65 || c > 90 {
      return false
    }
  }
  z.len() == 3 || ((z.len() == 4 || z.len() == 5) && z.ends_with("T"))
}

/// A `unixtime`: whole seconds since 1970 as a JSON number.
pub type UnixTime struct(Time) derive Json(via: Int, to: unix_seconds, from: from_unix_seconds)

pub fn unix_seconds(t: UnixTime) -> Int {
  t.0.unix()
}

fn from_unix_seconds(n: Int) -> UnixTime {
  UnixTime(Time.from_unix(n))
}

/// A `base64url` byte string: URL alphabet, no padding (Go's
/// Base64URLFormat); padding is accepted when reading.
pub type Base64URL struct(Bytes) derive Json(via: Str, to: base64url_text, from: parse_base64url)

pub fn base64url_text(b: Base64URL) -> Str {
  base64.encode(b.0, base64.Base64.RawUrl)
}

pub fn parse_base64url(s: Str) -> Base64URL ! Str {
  let b = base64.decode(s.trim_end_chars("="), base64.Base64.RawUrl) ?? e => return Err(e.display())
  Ok(Base64URL(b))
}

/// Go's zero time (January 1 of year 1, midnight UTC) in RFC 3339, as
/// Go writes `time.Time{}` where a service or a signature expects a time.
pub const GO_ZERO_TIME_RFC3339: Str = "0001-01-01T00:00:00Z"

/// Whether `text` is Go's zero time, January 1 of year 1 at midnight
/// UTC, which Azure services send for "unset", in either form below.
/// Xo's Time is int64 nanoseconds, years 1677 to 2262 (ADR 0364), so it
/// cannot hold that time; a port matches its text instead and reads it
/// as no time. Where a field has one wire form, use that form's check,
/// so text in the other form stays the parse error Go gives.
pub fn is_go_zero_time(text: Str) -> Bool {
  is_go_zero_time_rfc1123(text) || is_go_zero_time_rfc3339(text)
}

/// Go's zero time as an HTTP date (RFC 1123 or 7231): `<any weekday>,
/// 01 Jan 0001 00:00:00` and `GMT` or `UTC`; Go's time.Parse does not
/// check the weekday.
pub fn is_go_zero_time_rfc1123(text: Str) -> Bool {
  let (_, rest) = text.cut(", ") ?? return false
  rest == "01 Jan 0001 00:00:00 GMT" || rest == "01 Jan 0001 00:00:00 UTC"
}

/// Go's zero time in RFC 3339 or ISO 8601: `0001-01-01T00:00:00`, `T` or
/// a space (any case), any all-zero fraction, then nothing, `Z` or a
/// zero offset.
pub fn is_go_zero_time_rfc3339(text: Str) -> Bool {
  let u = text.to_upper()
  if u.len() < 19 || u[0..10] != "0001-01-01" || (u[10..11] != "T" && u[10..11] != " ") || u[11..19] != "00:00:00" {
    return false
  }
  var rest = u[19..u.len()]
  if rest.starts_with(".") {
    var i = 1
    while i < rest.len() && rest[i..i + 1] == "0" {
      i = i + 1
    }
    if i == 1 {
      return false
    }
    rest = rest[i..rest.len()]
  }
  rest == "" || rest == "Z" || rest == "+00:00" || rest == "-00:00"
}
