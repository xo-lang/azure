use std/json

struct F32Body {
  pub f: Float32? = None
} derive Json

// KNOWN difference, pinned until std/json writes a Float32 as its float32
// shortest text (assigned to the std lane): Go's encoding/json writes a
// float32 field of 1.1 as `1.1`, std/json today as the float64 shortest
// form of the float32. When this test fails, std has the fix: expect
// Go's text here and drop this note.
test "KNOWN: a Float32 in a JSON body is not yet Go's text" {
  let text = json.encode_str(F32Body{f: Some(Float32(1.1))})
  expect(text) == "{\"f\":1.100000023841858}"
  expect(text == "{\"f\":1.1}") == false
}
