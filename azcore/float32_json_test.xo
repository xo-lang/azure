use std/json

struct F32Body {
  pub f: Float32? = None
} derive Json

// std/json writes a Float32 with its own shortest digits, as Go's
// encoding/json writes a float32 (xo a762dc2e3, in xo builds since
// 2026-11-08; decision 0010's std change). Inside [1e-6, 1e21) Go's JSON
// text is strconv's 'f' form, which GO_F32 (float32_test.xo) has from Go.
test "a Float32 in a JSON body is Go's text" {
  var n = 0
  var bad: List[Str] = []
  for l in GO_F32 {
    let (b, want) = l.cut(" ") ?? fault(l)
    let f = Float32.from_bits(UInt32(Int.parse(b) ?? fault(b)))
    let a = shortest32(f).abs()
    if a != 0.0 && (a < 0.000001 || a >= 1e21) {
      continue
    }
    let got = json.encode_str(F32Body{f: Some(f)})
    if got != "{\"f\":${want}}" {
      bad.push("${b}: got ${got}, Go ${want}")
    }
    n += 1
  }
  expect(bad.join("\n")) == ""
  expect(n > 100) == true
}
