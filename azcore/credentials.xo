// Key and shared access signature credentials, as azcore's KeyCredential
// and SASCredential (internal/exported/exported.go of azcore v1.23.0;
// MIT, Copyright (c) Microsoft Corporation; NOTICE.md): a value shared
// by every copy, replaced in place by `update` (Go's atomic.Value).

/// An API key a service takes in a header (azcore.KeyCredential).
pub struct KeyCredential {
  key: Mutex[Secret[Str]]
}

pub fn new_key_credential(key: Str) -> KeyCredential {
  KeyCredential{key: Mutex.new(Secret.new(key))}
}

/// Replaces the key; every client holding this credential sends the new
/// one from its next request.
pub fn (k: KeyCredential) update(key: Str) {
  k.key.with(fn(var s: Secret[Str]) { s = Secret.new(key) })
}

/// The current key (Go's exported.KeyCredentialGet).
pub fn (k: KeyCredential) get() -> Str {
  k.key.with_read(fn(s: Secret[Str]) -> Str { s.reveal() })
}

/// A shared access signature a service takes in a header
/// (azcore.SASCredential).
pub struct SASCredential {
  sas: Mutex[Secret[Str]]
}

pub fn new_sas_credential(sas: Str) -> SASCredential {
  SASCredential{sas: Mutex.new(Secret.new(sas))}
}

/// Replaces the signature, as `KeyCredential.update`.
pub fn (k: SASCredential) update(sas: Str) {
  k.sas.with(fn(var s: Secret[Str]) { s = Secret.new(sas) })
}

/// The current signature (Go's exported.SASCredentialGet).
pub fn (k: SASCredential) get() -> Str {
  k.sas.with_read(fn(s: Secret[Str]) -> Str { s.reveal() })
}
