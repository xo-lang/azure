// Tokens and the credential interface, as azcore's TokenCredential,
// AccessToken and policy.TokenRequestOptions (MIT, Copyright (c)
// Microsoft Corporation; NOTICE.md).

pub struct AccessToken {
  pub token: Secret[Str]
  pub expires_on: Time
  /// When to refresh it (the token endpoint's `refresh_in`); None for
  /// 5 minutes before it expires.
  pub refresh_on: Time? = None
}

pub struct TokenRequestOptions {
  /// Such as `https://management.core.windows.net//.default`.
  pub scopes: List[Str]
  /// Another tenant than the credential's (auxiliary tenants).
  pub tenant_id: Str = ""
  /// A claims challenge from a 401 (`WWW-Authenticate: ... claims=`),
  /// decoded JSON. A request with claims is never answered from a cache.
  pub claims: Str = ""
  /// Ask for a token that works with Continuous Access Evaluation (the
  /// `CP1` client capability); the bearer token policy always does.
  pub enable_cae: Bool = false
}

/// Why a credential gave no token.
pub struct AuthErr {
  /// The credential's name (`ClientSecretCredential`, ...).
  pub credential: Str
  pub msg: Str
  /// When true the credential cannot work here (a chain tries the next
  /// one): no environment variables, no managed identity endpoint.
  pub unavailable: Bool = false
}

pub fn (e: AuthErr) display() -> Str {
  "${e.credential}: ${e.msg}"
}

/// A source of Entra ID tokens.
pub interface TokenCredential {
  fn get_token(self, opts: TokenRequestOptions) -> AccessToken ! AuthErr uses (net.dial, clock, rand)
}

/// Whether `t` should be refreshed at `now`: at its refresh time, else
/// 5 minutes before it expires, as azcore's bearer token policy.
pub fn needs_refresh(t: AccessToken, now: Time) -> Bool {
  let at = t.refresh_on ?? Time.from_unix_millis(t.expires_on.unix_millis() - 5 * 60 * 1000)
  now.unix_millis() >= at.unix_millis()
}
