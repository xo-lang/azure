test "float32_text is Go's FormatFloat(.., 'f', -1, 32)" {
  var bad: List[Str] = []
  for l in GO_F32 {
    let (b, want) = l.cut(" ") ?? fault(l)
    let f = Float32.from_bits(UInt32(Int.parse(b) ?? fault(b)))
    let got = float32_text(f)
    if got != want {
      bad.push("${b}: got ${got}, Go ${want}")
    }
  }
  expect(bad.join("\n")) == ""
}
