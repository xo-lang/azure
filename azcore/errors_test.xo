use std/http

test "the error code comes from the header, then the JSON or XML body" {
  expect(error_code_of(http.text(404, "{\"error\":{\"code\":\"ResourceGroupNotFound\",\"message\":\"m\"}}").with_header("x-ms-error-code", "FromHeader"))) == "FromHeader"
  expect(error_code_of(http.text(404, "{\"error\":{\"code\":\"ResourceGroupNotFound\",\"message\":\"m\"}}"))) == "ResourceGroupNotFound"
  expect(error_code_of(http.text(400, "{\"odata.error\":{\"code\":\"TableNotFound\"}}"))) == "TableNotFound"
  expect(error_code_of(http.text(409, "{\"code\":\"Conflict\"}"))) == "Conflict"
  expect(error_code_of(http.text(404, "<?xml version=\"1.0\"?><Error><Code>BlobNotFound</Code><Message>m</Message></Error>"))) == "BlobNotFound"
  expect(error_code_of(http.text(500, ""))) == ""
  let e = response_error("GET", "https://h/p", http.text(404, "{\"error\":{\"code\":\"NotFound\"}}"))
  expect(e.display().starts_with("GET https://h/p\nRESPONSE 404\nERROR CODE: NotFound")) == true
}
