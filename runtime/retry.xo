// azcore's retry policy (MIT, Copyright (c) Microsoft Corporation;
// NOTICE.md): up to max_retries more tries on a transport error or a
// retried status, waiting (2^try - 1) * retry_delay with jitter in
// [0.8, 1.3), at most max_retry_delay, or the server's delay
// (Retry-After-Ms, x-ms-retry-after-ms, Retry-After). A server delay
// longer than max_retry_delay is not waited for: the response is
// returned.

use std/http
use std/time
use github.com/xo-lang/azure/policy

pub struct RetryPolicy {
  pub opts: policy.RetryOptions
  pub clock: Clock
  pub rand: Rand
}

fn (p: RetryPolicy) send(req: policy.Request, next: policy.Next) -> http.Response ! policy.SendErr uses (net.dial, clock, rand) {
  let one = if let Some(d) = p.opts.try_timeout { req with {timeout: Some(d)} } else { req }
  var try = 1
  while true {
    let r = next.send(one)
    let last = try > p.opts.max_retries
    match r {
      Ok(resp) => {
        if !p.opts.status_codes.contains(resp.status) || last {
          return Ok(resp)
        }
        let wait = match retry_after(resp, p.clock.now()) {
          Some(d) => if d > p.opts.max_retry_delay { return Ok(resp) } else { d }
          None => delay(p.opts, try, p.rand.float())
        }
        p.clock.sleep(wait)
      }
      Err(e) => {
        if last || !retryable(e) {
          return Err(e)
        }
        p.clock.sleep(delay(p.opts, try, p.rand.float()))
      }
    }
    try += 1
  }
  Err(policy.SendErr.Auth("unreachable"))
}

fn retryable(e: policy.SendErr) -> Bool {
  match e {
    Http(he) => match he {
      InvalidUrl(_) | Canceled => false
      _ => true
    }
    Auth(_) | Final(_) | FinalResponse(_) => false
  }
}

/// The delay before retry `try` (1 for the first), with `jitter` in
/// [0, 1) mapped to azcore's [0.8, 1.3).
pub fn delay(opts: policy.RetryOptions, try: Int, jitter: Float) -> Duration {
  let base = ((1 << try) - 1) * opts.retry_delay.millis()
  let ms = Int(Float(base) * (0.8 + jitter * 0.5))
  let d = Duration.from_millis(ms)
  if d > opts.max_retry_delay { opts.max_retry_delay } else { d }
}

/// The server's requested delay, as azcore's shared.RetryAfter: the first
/// field of `Retry-After-Ms`, `x-ms-retry-after-ms`, then `Retry-After`,
/// whichever first gives a delay above zero (a whole number, as
/// strconv.Atoi reads one, or for `Retry-After` an RFC 1123 date in the
/// future). None where Go's is 0.
pub fn retry_after(resp: http.Response, now: Time) -> Duration? {
  for (h, unit) in [("Retry-After-Ms", 1), ("x-ms-retry-after-ms", 1), ("Retry-After", 1000)] {
    let v = resp.header_values(h).first() ?? continue
    if v == "" {
      continue
    }
    if let Some(n) = go_atoi(v) {
      if n > 0 {
        return Some(Duration.from_millis(n * unit))
      }
    }
    if h == "Retry-After" {
      if let Ok(t) = time.parse(v, time.RFC1123, time.utc()) {
        let ms = t.unix_millis() - now.unix_millis()
        if ms > 0 {
          return Some(Duration.from_millis(ms))
        }
      }
    }
  }
  None
}

/// Go's strconv.Atoi: an optional sign and decimal digits, nothing else.
fn go_atoi(v: Str) -> Int? {
  let digits = if v.starts_with("+") || v.starts_with("-") { v[1..v.len()] } else { v }
  if digits == "" || !digits.runes().all(fn(r: Rune) -> Bool { r >= '0' && r <= '9' }) {
    return None
  }
  Int.parse(v.trim_prefix("+"))
}
