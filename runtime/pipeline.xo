// The pipeline every client sends through, in azcore's order (MIT,
// Copyright (c) Microsoft Corporation; NOTICE.md): api-version,
// telemetry, request ID, the per-call policies, retry, the per-retry
// policies, then the transport (decision 0003).

use std/http
use std/uuid
use std/url
use github.com/xo-lang/azure/policy

/// What the client itself adds (its generated code).
pub struct PipelineOptions[fx: Effects] {
  /// The query parameter of the api-version (`api-version`).
  pub api_version_name: Str = "api-version"
  /// The client's api-version, overridden by ClientOptions.api_version.
  pub api_version: Str = ""
  pub per_call: List[policy.Policy[fx]] = []
  pub per_retry: List[policy.Policy[fx]] = []
}

pub struct Pipeline[fx: Effects] {
  pub policies: List[policy.Policy[fx]]
  pub transport: http.Client
}

/// The pipeline of a client of module `module` (`armstorage`) at
/// `version`.
pub fn new_pipeline[fx: Effects](module: Str, version: Str, net: Net, clock: Clock, rand: Rand, pl: PipelineOptions[fx], opts: policy.ClientOptions[fx]) -> Pipeline[fx] {
  var ps: List[policy.Policy[fx]] = []
  let api = if opts.api_version != "" { opts.api_version } else { pl.api_version }
  if api != "" {
    ps.push(ApiVersionPolicy{name: pl.api_version_name, version: api})
  }
  if !opts.telemetry.disabled {
    ps.push(TelemetryPolicy{user_agent: user_agent(module, version, opts.telemetry.application_id)})
  }
  ps.push(RequestIdPolicy{rand: rand})
  ps = ps + pl.per_call + opts.per_call_policies
  ps.push(RetryPolicy{opts: opts.retry, clock: clock, rand: rand})
  ps = ps + pl.per_retry + opts.per_retry_policies
  Pipeline{policies: ps, transport: http.client(net, opts.timeout)}
}

/// Sends `req` through every policy.
pub fn (p: Pipeline) send(req: policy.Request) -> http.Response ! policy.SendErr uses (net.dial, clock, rand) {
  policy.Next{policies: p.policies, transport: p.transport}.send(req)
}

/// `xo-lang-azure-<module>/<version> (xo/<xo version>; <os>)`, with the
/// application id in front: azcore's shape under this SDK's own name
/// (decision 0003).
pub fn user_agent(module: Str, version: Str, application_id: Str) -> Str {
  let base = "xo-lang-azure-${module}/${version} (xo; ${os_name()})"
  if application_id == "" {
    return base
  }
  var id = application_id.replace(" ", "/")
  if id.len() > 24 {
    id = id[0..24]
  }
  "${id} ${base}"
}

fn os_name() -> Str {
  match target.os {
    Linux => "linux"
    Darwin => "darwin"
    Windows => "windows"
    Wasi => "wasi"
  }
}

/// Sets the api-version query parameter as azcore's apiVersionPolicy
/// does: the query parsed as Go's `URL.Query()`, the parameter set, and
/// the query encoded again, sorted (`url.Values.Encode`).
// 0540: phantom fx so send can name next's effects; removed when xo ADR 0540 is accepted
pub struct ApiVersionPolicy[fx: Effects] {
  pub name: Str
  pub version: Str
}

fn (p: ApiVersionPolicy[fx]) send(req: policy.Request, next: policy.Next[fx]) -> http.Response ! policy.SendErr uses (net.dial, clock, rand, fx) {
  next.send(req with {url: set_query_sorted(req.url, p.name, p.version)})
}

/// `u` with query parameter `name` set to `value`, as Go's
/// `q := u.Query(); q.Set(name, value); u.RawQuery = q.Encode()`: the
/// whole query encoded again, keys sorted, each value query-escaped.
pub fn set_query_sorted(u: Str, name: Str, value: Str) -> Str {
  let (rest, fragment) = match u.find("#") {
    Some(i) => (u[0..i], u[i..u.len()])
    None => (u, "")
  }
  let (base, raw) = rest.cut("?") ?? (rest, "")
  var q = go_query(raw)
  q.set(name, value)
  "${base}?${q.encode()}${fragment}"
}

/// A raw query as Go's `URL.Query()` reads it (url.ParseQuery with its
/// error dropped): a pair with a `;` or a bad escape is skipped and the
/// others kept, where `url.parse_query` fails the whole query.
fn go_query(raw: Str) -> url.Values {
  var q = url.values()
  for pair in raw.split("&") {
    if pair == "" || pair.contains(";") {
      continue
    }
    let (k, v) = pair.cut("=") ?? (pair, "")
    let key = url.query_unescape(k) ?? _ => continue
    let val = url.query_unescape(v) ?? _ => continue
    q.add(key, val)
  }
  q
}

/// `u` with query parameter `name` set to `value` (others kept in order).
pub fn set_query(u: Str, name: Str, value: Str) -> Str {
  let (base, query) = match u.find("?") {
    Some(i) => (u[0..i], u[i + 1..u.len()])
    None => (u, "")
  }
  var parts = query.split("&").filter(fn(p: Str) -> Bool { p != "" && (p.split("=").first() ?? "") != name })
  parts.push("${name}=${url.query_escape(value)}")
  "${base}?${parts.join("&")}"
}

/// Sets the User-Agent, keeping any the caller set after it.
// 0540: phantom fx so send can name next's effects; removed when xo ADR 0540 is accepted
pub struct TelemetryPolicy[fx: Effects] {
  pub user_agent: Str
}

fn (p: TelemetryPolicy[fx]) send(req: policy.Request, next: policy.Next[fx]) -> http.Response ! policy.SendErr uses (net.dial, clock, rand, fx) {
  let ua = match req.header("User-Agent") {
    Some(v) => "${p.user_agent} ${v}"
    None => p.user_agent
  }
  next.send(req.with_header("User-Agent", ua))
}

/// Sets `x-ms-client-request-id` to a new UUID when the request has none
/// (decision 0003: on by default, as the other Azure SDKs).
// 0540: phantom fx so send can name next's effects; removed when xo ADR 0540 is accepted
pub struct RequestIdPolicy[fx: Effects] {
  pub rand: Rand
}

fn (p: RequestIdPolicy[fx]) send(req: policy.Request, next: policy.Next[fx]) -> http.Response ! policy.SendErr uses (net.dial, clock, rand, fx) {
  if req.header("x-ms-client-request-id").is_some() {
    return next.send(req)
  }
  next.send(req.with_header("x-ms-client-request-id", uuid.v4(p.rand).display()))
}

/// Response header `name` as Go's generated handlers read one:
/// `resp.Header.Get(name)`, its first field, with an empty value as
/// absent.
pub fn header_value(resp: http.Response, name: Str) -> Str? {
  match resp.header(name) {
    Some(v) => if v == "" { None } else { Some(v) }
    None => None
  }
}
