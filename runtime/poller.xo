// Long-running operations, as azcore's runtime.Poller and its pollers
// (internal/pollers: async, op, loc, body; MIT, Copyright (c) Microsoft
// Corporation; NOTICE.md). The kind comes from the first response:
// `Azure-AsyncOperation`, then `Operation-Location`, then `Location`,
// then a PUT or PATCH body's provisioningState; otherwise the operation
// is already done. The final result is fetched by method and
// `final-state-via`, as azcore does. Resume tokens are azcore's JSON.

use std/http
use std/json
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/policy

pub enum Kind {
  Async
  Op
  Loc
  Body
  /// Done with the first response.
  Done
  /// A custom handler that polls `Azure-AsyncOperation` and whose result
  /// is the last status response, with no final GET (azadmin's
  /// restorePoller; new_status_poller).
  Status
}

fn kind_name(k: Kind) -> Str {
  match k {
    Async => "async"
    Op => "op"
    Loc => "loc"
    Body => "body"
    Done => "nop"
    Status => "status"
  }
}

/// `final-state-via` values (x-ms-long-running-operation-options).
pub const AZURE_ASYNC_OPERATION: Str = "azure-async-operation"
pub const LOCATION: Str = "location"
pub const ORIGINAL_URI: Str = "original-uri"
pub const OPERATION_LOCATION: Str = "operation-location"

pub struct Poller[T, fx: Effects] {
  pub pipeline: Pipeline[fx]
  pub decode: fn(http.Response) -> T ! Str
  /// The result type's name in resume tokens, as azcore's
  /// getTokenTypeName writes it: the bare Go type name
  /// (`AccountsClientCreateResponse`), or `*Pager[<import path>.<name>]`
  /// for a paged operation.
  pub type_name: Str
  kind: Kind
  method: Str
  orig_url: Str
  poll_url: Str = ""
  loc_url: Str = ""
  final_state: Str = ""
  /// InProgress, Succeeded, Failed, Canceled (as the service writes it).
  state: Str = "InProgress"
  last: http.Response? = None
  /// The request `last` answered (its method and URL), for its error.
  last_method: Str = ""
  last_url: Str = ""
}

/// `name`'s first field when it is not empty, as azcore's pollers read
/// one (`resp.Header.Get(name) != ""`).
fn header_of(resp: http.Response, name: Str) -> Str? {
  let v = resp.header_values(name).first() ?? return None
  if v == "" { None } else { Some(v) }
}

/// The poller of the operation `req` started with `resp`.
pub fn new_poller[T, fx: Effects](pipeline: Pipeline[fx], req: policy.Request, resp: http.Response, final_state_via: Str, type_name: Str, decode: fn(http.Response) -> T ! Str) -> Poller[T, fx] ! azcore.CallErr {
  if ![200, 201, 202, 204].contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  let base = Poller{pipeline: pipeline, decode: decode, type_name: type_name, kind: Kind.Done, method: req.method, orig_url: req.url, final_state: final_state_via, last: Some(resp), last_method: req.method, last_url: req.url}
  // azcore's NewPoller: async, op, loc, then body for a PUT or PATCH; a
  // polling URL must be absolute (poller.IsValidURL)
  let loc = header_of(resp, "Location") ?? ""
  if let Some(a) = header_of(resp, "Azure-AsyncOperation") {
    valid_url(a)?
    // async.New: the body's provisioning state, else InProgress
    return Ok(base with {kind: Kind.Async, poll_url: a, loc_url: loc, state: non_empty(state_from_body(resp)) ?? "InProgress"})
  }
  if let Some(o) = header_of(resp, "Operation-Location") {
    valid_url(o)?
    // op.New: the body's status, else InProgress
    return Ok(base with {kind: Kind.Op, poll_url: o, loc_url: loc, state: non_empty(status_of(resp)) ?? "InProgress"})
  }
  if loc != "" {
    valid_url(loc)?
    return Ok(base with {kind: Kind.Loc, poll_url: loc, state: non_empty(state_from_body(resp)) ?? "InProgress"})
  }
  if req.method == "PUT" || req.method == "PATCH" {
    // body.New
    let prov = non_empty(state_from_body(resp))
    let st = match resp.status {
      201 => prov ?? "InProgress"
      200 => prov ?? "Succeeded"
      204 => "Succeeded"
      _ => "InProgress"
    }
    return Ok(base with {kind: Kind.Body, poll_url: req.url, state: st})
  }
  if resp.status == 202 && (req.method == "DELETE" || req.method == "POST") {
    return Err(azcore.CallErr.InvalidInput("response is missing polling URL"))
  }
  Ok(base with {state: "Succeeded"})
}

/// poller.IsValidURL's check, with azcore's error.
fn valid_url(u: Str) -> () ! azcore.CallErr {
  if !is_absolute(u) {
    return Err(azcore.CallErr.InvalidInput("invalid polling URL ${u}"))
  }
  Ok(())
}

/// The poller of `req`, started with `resp`, as azadmin's restorePoller
/// (backup/internal/pollers of azadmin v1.5.0; MIT, Copyright (c)
/// Microsoft Corporation; NOTICE.md): it polls the `Azure-AsyncOperation`
/// URL, as sent, and the last status response is the result.
pub fn new_status_poller[T, fx: Effects](pipeline: Pipeline[fx], req: policy.Request, resp: http.Response, final_state_via: Str, type_name: Str, decode: fn(http.Response) -> T ! Str) -> Poller[T, fx] ! azcore.CallErr {
  let a = header_of(resp, "Azure-AsyncOperation") ?? return Err(azcore.CallErr.InvalidInput("response is missing Azure-AsyncOperation header"))
  if !is_absolute(a) {
    return Err(azcore.CallErr.InvalidInput("invalid polling URL ${a}"))
  }
  let state = state_from_body(resp) ?? "InProgress"
  Ok(Poller{pipeline: pipeline, decode: decode, type_name: type_name, kind: Kind.Status, method: req.method, orig_url: req.url, poll_url: a, loc_url: header_of(resp, "Location") ?? "", final_state: final_state_via, state: if state == "" { "InProgress" } else { state }, last: Some(resp)})
}

/// A status poller from `token` (its resume_token, or Go's restorePoller's).
pub fn resume_status_poller[T, fx: Effects](pipeline: Pipeline[fx], token: Str, type_name: Str, decode: fn(http.Response) -> T ! Str) -> Poller[T, fx] ! azcore.CallErr {
  let doc = json.parse_value(token) ?? e => return Err(azcore.CallErr.InvalidInput("a resume token is JSON: ${e.display()}"))
  let f = fn(v: json.Value?, k: Str) -> Str {
    match v.and_then(fn(x: json.Value) -> json.Value? { x.get(k) }) {
      Some(json.Value.Str(s)) => s
      _ => ""
    }
  }
  check_token_type(doc, type_name)?
  let t = Some(doc.get("token") ?? return Err(azcore.CallErr.InvalidInput("missing token value")))
  Ok(Poller{pipeline: pipeline, decode: decode, type_name: type_name, kind: Kind.Status, method: f(t, "method"), orig_url: f(t, "origURL"), poll_url: f(t, "asyncURL"), loc_url: f(t, "locURL"), final_state: f(t, "finalState"), state: f(t, "state")})
}

/// Whether `s` has a scheme, as Go's `url.Parse(s).IsAbs()` (azcore's
/// poller.IsValidURL).
fn is_absolute(s: Str) -> Bool {
  let i = s.find(":") ?? return false
  if i == 0 {
    return false
  }
  for j in 0..i {
    let ch = s[j..j + 1]
    let letter = (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z")
    if !(letter || (j > 0 && ((ch >= "0" && ch <= "9") || ch == "+" || ch == "-" || ch == "."))) {
      return false
    }
  }
  true
}

/// `properties.provisioningState`, as the body poller reads it.
fn state_from_body(resp: http.Response) -> Str? {
  let doc = json.parse_value(resp.body.to_str_lossy()) ?? _ => return None
  match doc.get("properties").and_then(fn(p: json.Value) -> json.Value? { p.get("provisioningState") }) {
    Some(json.Value.Str(s)) => Some(s)
    _ => None
  }
}

/// `s` unless it is empty (azcore reads an empty state as none).
fn non_empty(s: Str?) -> Str? {
  match s {
    Some(x) => if x == "" { None } else { Some(x) }
    None => None
  }
}

/// The `status` field of an operation status body (async and op).
fn status_of(resp: http.Response) -> Str? {
  let doc = json.parse_value(resp.body.to_str_lossy()) ?? _ => return None
  match doc.get("status") {
    Some(json.Value.Str(s)) => Some(s)
    _ => None
  }
}

fn succeeded(s: Str) -> Bool {
  let l = s.to_lower()
  l == "succeeded" || l == "completed"
}

fn failed(s: Str) -> Bool {
  let l = s.to_lower()
  l == "failed" || l == "canceled" || l == "cancelled"
}

/// `ref` made absolute against `base`'s scheme and host.
pub fn resolve(base: Str, ref: Str) -> Str {
  if ref.starts_with("http://") || ref.starts_with("https://") {
    return ref
  }
  let after = (base.find("://") ?? 0) + 3
  let host_end = base[after..base.len()].find("/").map(fn(i: Int) -> Int { after + i }) ?? base.len()
  let path = if ref.starts_with("/") { ref } else { "/${ref}" }
  "${base[0..host_end]}${path}"
}

/// Whether the operation reached a terminal state.
pub fn (p: Poller[T, fx]) done() -> Bool {
  succeeded(p.state) || failed(p.state)
}

/// The operation's state as last seen.
pub fn (p: Poller[T, fx]) status() -> Str {
  p.state
}

/// Polls once; returns the poll's response.
pub fn (var p: Poller[T, fx]) poll() -> http.Response ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if p.done() {
    return Ok(p.last ?? http.text(200, ""))
  }
  let req = policy.Request{method: "GET", url: p.poll_url}
  let resp = p.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  match p.kind {
    // async.Poll and op.Poll
    Async | Op => {
      if !status_code_valid(resp.status) {
        p.last = Some(resp)
        p.last_method = "GET"
        p.last_url = p.poll_url
        return Err(azcore.CallErr.Response(azcore.response_error("GET", p.poll_url, resp)))
      }
      let doc = json_body(resp)?
      p.state = match doc.get("status") {
        Some(json.Value.Str(st)) => if st == "" { return Err(azcore.CallErr.Decode("the response did not contain a status")) } else { st }
        _ => return Err(azcore.CallErr.Decode("the response did not contain a status"))
      }
    }
    // loc.Poll: a failure is a state, its response the result's error
    Loc => {
      if let Some(l) = header_of(resp, "Location") {
        p.poll_url = resolve(p.poll_url, l)
      }
      if let Some(st) = non_empty(state_from_body(resp)) {
        p.state = st
      } else if resp.status == 202 {
        p.state = "InProgress"
      } else if resp.status > 199 && resp.status < 300 {
        p.state = "Succeeded"
      } else if ![408, 429, 500, 502, 503, 504].contains(resp.status) {
        p.state = "Failed"
      }
    }
    // body.Poll
    Body => {
      if !status_code_valid(resp.status) {
        p.last = Some(resp)
        p.last_method = "GET"
        p.last_url = p.poll_url
        return Err(azcore.CallErr.Response(azcore.response_error("GET", p.poll_url, resp)))
      }
      if resp.status == 204 {
        p.state = "Succeeded"
      } else if resp.body.is_empty() {
        return Err(azcore.CallErr.Decode("the response did not contain a body"))
      } else {
        p.state = non_empty(state_from_body(resp)) ?? "Succeeded"
      }
    }
    Status => {
      if ![200, 201, 202, 204].contains(resp.status) {
        p.last = Some(resp)
        return Err(azcore.CallErr.Response(azcore.response_error("GET", p.poll_url, resp)))
      }
      if resp.body.is_empty() {
        return Err(azcore.CallErr.Decode("the response did not contain a body"))
      }
      let s = status_of(resp) ?? ""
      if s == "" {
        return Err(azcore.CallErr.Decode("the response did not contain a status"))
      }
      p.state = s
    }
    Done => {}
  }
  p.last = Some(resp)
  p.last_method = "GET"
  p.last_url = p.poll_url
  Ok(resp)
}

/// The final result, as each of azcore's pollers gives it: an error when
/// the operation failed, else the result body, fetched by method and
/// final-state-via.
pub fn (var p: Poller[T, fx]) result() -> T ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if !p.done() {
    return Err(azcore.CallErr.InvalidInput("poller is in a non-terminal state"))
  }
  let last = p.last ?? http.text(200, "")
  match p.kind {
    Status => {
      if failed(p.state) {
        return Err(azcore.CallErr.Response(azcore.response_error(p.method, p.orig_url, last)))
      }
      // restorePoller.Result: a 204 or an empty body is the zero result
      if last.status == 204 || last.body.is_empty() {
        return p.zero()
      }
      if !status_code_valid(last.status) {
        return Err(azcore.CallErr.Response(azcore.response_error("GET", p.poll_url, last)))
      }
      (p.decode)(last) ?? e => Err(azcore.CallErr.Decode(e))
    }
    // async.Result
    Async => {
      if last.status == 204 {
        return p.zero()
      }
      if failed(p.state) {
        return Err(azcore.CallErr.Response(azcore.response_error(p.last_method, p.last_url, last)))
      }
      let url = match p.method {
        "PUT" | "PATCH" => Some(p.orig_url)
        "POST" => if p.final_state == AZURE_ASYNC_OPERATION {
          None
        } else if p.final_state == ORIGINAL_URI {
          Some(p.orig_url)
        } else if p.loc_url != "" {
          Some(p.loc_url)
        } else {
          None
        }
        _ => None
      }
      p.final_get(url)?
      p.result_of(false)
    }
    // op.Result: the final GET comes before the failure check
    Op => {
      var url: Str? = None
      if p.final_state == LOCATION && p.loc_url != "" {
        url = Some(p.loc_url)
      } else if let Some(rl) = resource_location(last)? {
        url = Some(rl)
      } else if p.method == "PUT" || p.method == "PATCH" {
        url = Some(p.orig_url)
      } else if p.method == "POST" && p.loc_url != "" {
        url = Some(p.loc_url)
      }
      p.final_get(url)?
      p.result_of(failed(p.state))
    }
    Loc | Body => p.result_of(failed(p.state))
    // NewNopPoller: the first response
    Done => p.result_of(false)
  }
}

/// GETs `url`, when there is one, as the response the result comes from.
fn (var p: Poller[T, fx]) final_get(url: Str?) -> () ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if let Some(u) = url {
    let r = p.pipeline.send(policy.Request{method: "GET", url: u}) ?? e => return Err(azcore.CallErr.Send(e))
    p.last = Some(r)
    p.last_method = "GET"
    p.last_url = u
  }
  Ok(())
}

/// azcore's ResultHelper over the last response: a 204 is the zero
/// result, a failure or an unexpected status the response's error, an
/// empty body the zero result.
fn (p: Poller[T, fx]) result_of(op_failed: Bool) -> T ! azcore.CallErr {
  let resp = p.last ?? http.text(200, "")
  if resp.status == 204 {
    return p.zero()
  }
  if !status_code_valid(resp.status) || op_failed {
    return Err(azcore.CallErr.Response(azcore.response_error(p.last_method, p.last_url, resp)))
  }
  if resp.body.is_empty() {
    return p.zero()
  }
  (p.decode)(resp) ?? e => Err(azcore.CallErr.Decode(e))
}

/// Go's zero result: a model's from `{}`; a string, list or map result
/// (no `{}` decodes to it) from an empty body, which a generated
/// response's decoder takes as Go's zero value ("", empty).
fn (p: Poller[T, fx]) zero() -> T ! azcore.CallErr {
  match (p.decode)(http.text(200, "{}")) {
    Ok(v) => Ok(v)
    Err(e) => (p.decode)(http.text(200, "")) ?? _ => Err(azcore.CallErr.Decode(e))
  }
}

/// azcore's poller.StatusCodeValid.
fn status_code_valid(status: Int) -> Bool {
  [200, 201, 202, 204].contains(status)
}

/// The body as a JSON object (azcore's poller.GetJSON).
fn json_body(resp: http.Response) -> json.Value ! azcore.CallErr {
  if resp.body.is_empty() {
    return Err(azcore.CallErr.Decode("the response did not contain a body"))
  }
  json.parse_value(resp.body.to_str_lossy()) ?? e => Err(azcore.CallErr.Decode(e.display()))
}

/// The `resourceLocation` of an operation status body
/// (poller.GetResourceLocation); none without a body.
fn resource_location(resp: http.Response) -> Str? ! azcore.CallErr {
  if resp.body.is_empty() {
    return Ok(None)
  }
  let doc = json_body(resp)?
  match doc.get("resourceLocation") {
    Some(json.Value.Str(r)) => Ok(non_empty(Some(r)))
    Some(other) => Err(azcore.CallErr.Decode("the resourceLocation value ${other.encode()} was not in string format"))
    None => Ok(None)
  }
}

/// Polls until done, waiting `frequency` (at least 1 s) or the
/// response's Retry-After between polls, then gives the result.
pub fn (var p: Poller[T, fx]) poll_until_done(clock: Clock, frequency: Duration = 30s) -> T ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  let every = if frequency < 1s { 1s } else { frequency }
  while !p.done() {
    let resp = p.poll()?
    if !p.done() {
      clock.sleep(retry_after(resp, clock.now()) ?? every)
    }
  }
  p.result()
}

/// azcore's resume token: `{"type": ..., "token": {...}}`.
pub fn (p: Poller[T, fx]) resume_token() -> Str ! Str {
  if p.done() {
    return Err("poller is in a terminal state")
  }
  // each poller's own JSON, in its struct's field order: async and op
  // have no `type` field (Go tells them apart by asyncURL and oplocURL)
  let s = fn(v: Str) -> json.Value { json.Value.Str(v) }
  let fields: List[(Str, json.Value)] = match p.kind {
    Async | Status => [("asyncURL", s(p.poll_url)), ("locURL", s(p.loc_url)), ("origURL", s(p.orig_url)), ("method", s(p.method)), ("finalState", s(p.final_state)), ("state", s(p.state))]
    Op => [("oplocURL", s(p.poll_url)), ("locURL", s(p.loc_url)), ("origURL", s(p.orig_url)), ("method", s(p.method)), ("finalState", s(p.final_state)), ("resultPath", s("")), ("state", s(p.state))]
    Loc | Body => [("type", s(kind_name(p.kind))), ("pollURL", s(p.poll_url)), ("state", s(p.state))]
    Done => return Err("poller is in a terminal state")
  }
  // encoding/json's Marshal escapes <, > and & in strings
  var w = json.json_writer()
  w.value(json.Value.Object([("type", json.Value.Str(p.type_name)), ("token", json.Value.Object(fields))])) ?? e => return Err(e.display())
  Ok(w.finish().to_str_lossy())
}

/// A poller from `token` (resume_token's, or a Go program's).
pub fn resume_poller[T, fx: Effects](pipeline: Pipeline[fx], token: Str, type_name: Str, decode: fn(http.Response) -> T ! Str) -> Poller[T, fx] ! azcore.CallErr {
  let doc = json.parse_value(token) ?? e => return Err(azcore.CallErr.InvalidInput("a resume token is JSON: ${e.display()}"))
  let f = fn(v: json.Value?, k: Str) -> Str {
    match v.and_then(fn(x: json.Value) -> json.Value? { x.get(k) }) {
      Some(json.Value.Str(s)) => s
      _ => ""
    }
  }
  check_token_type(doc, type_name)?
  let t = Some(doc.get("token") ?? return Err(azcore.CallErr.InvalidInput("missing token value")))
  let base = Poller{pipeline: pipeline, decode: decode, type_name: type_name, kind: Kind.Done, method: f(t, "method"), orig_url: f(t, "origURL"), loc_url: f(t, "locURL"), final_state: f(t, "finalState"), state: f(t, "state")}
  // azcore's NewPollerFromResumeToken order: async, body, loc, op
  let has = fn(k: Str) -> Bool { t.and_then(fn(x: json.Value) -> json.Value? { x.get(k) }).is_some() }
  if has("asyncURL") {
    Ok(base with {kind: Kind.Async, poll_url: f(t, "asyncURL")})
  } else if f(t, "type") == "body" {
    Ok(base with {kind: Kind.Body, poll_url: f(t, "pollURL"), orig_url: f(t, "pollURL"), method: "PUT"})
  } else if f(t, "type") == "loc" {
    Ok(base with {kind: Kind.Loc, poll_url: f(t, "pollURL")})
  } else if has("oplocURL") {
    Ok(base with {kind: Kind.Op, poll_url: f(t, "oplocURL")})
  } else {
    Err(azcore.CallErr.InvalidInput("unhandled poller token ${t.map(fn(x: json.Value) -> Str { x.encode() }) ?? "null"}"))
  }
}

/// azcore's IsTokenValid: the token's `type` must be `type_name`.
fn check_token_type(doc: json.Value, type_name: Str) -> () ! azcore.CallErr {
  match doc.get("type") {
    Some(json.Value.Str(tt)) => if tt != type_name {
      return Err(azcore.CallErr.InvalidInput("cannot resume from this poller token. token is for type ${tt}, not ${type_name}"))
    }
    Some(other) => return Err(azcore.CallErr.InvalidInput("invalid type format ${json_type_name(other)}"))
    None => return Err(azcore.CallErr.InvalidInput("missing type value"))
  }
  Ok(())
}

/// The Go type that encoding/json gives a JSON value in a map[string]any.
fn json_type_name(v: json.Value) -> Str {
  match v {
    json.Value.Null => "<nil>"
    json.Value.Bool(_) => "bool"
    json.Value.Int(_) | json.Value.Num(_) => "float64"
    json.Value.Trusted(_, _) => "string"
    json.Value.Str(_) => "string"
    json.Value.List(_) => "[]interface {}"
    json.Value.Object(_) => "map[string]interface {}"
  }
}
