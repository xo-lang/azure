// The key and SAS credential policies, as azcore's
// runtime/policy_key_credential.go and policy_sas_credential.go (v1.23.0;
// MIT, Copyright (c) Microsoft Corporation; NOTICE.md).

use std/http
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/policy

/// Go's checkHTTPSForAuth: a credential goes only over HTTPS, unless
/// allowed; the error is not retried.
fn check_https_for_auth(req: policy.Request, allow_http: Bool) -> () ! policy.SendErr {
  let scheme = (req.url.cut("://").map(fn(t: (Str, Str)) -> Str { t.0 }) ?? "").to_lower()
  if scheme != "https" && !allow_http {
    return Err(policy.SendErr.Final(http.ClientErr.Connect("authorized requests are not permitted for non-TLS protected (https) endpoints")))
  }
  Ok(())
}

pub struct KeyCredentialPolicyOptions {
  /// Sends the key over plain HTTP too (for local testing only).
  pub insecure_allow_credential_with_http: Bool = false
  /// Written before the key (`Bearer `, ...).
  pub prefix: Str = ""
}

/// Adds the key to each request in header `header`
/// (azcore.KeyCredentialPolicy).
// 0540: phantom fx so send can name next's effects; removed when xo ADR 0540 is accepted
pub struct KeyCredentialPolicy[fx: Effects] {
  cred: azcore.KeyCredential
  header: Str
  prefix: Str
  allow_http: Bool
}

pub fn new_key_credential_policy[fx: Effects](cred: azcore.KeyCredential, header: Str, options: KeyCredentialPolicyOptions = KeyCredentialPolicyOptions{}) -> KeyCredentialPolicy[fx] {
  KeyCredentialPolicy{cred: cred, header: header, prefix: options.prefix, allow_http: options.insecure_allow_credential_with_http}
}

fn (p: KeyCredentialPolicy[fx]) send(req: policy.Request, next: policy.Next[fx]) -> http.Response ! policy.SendErr uses (net.dial, clock, rand, fx) {
  check_https_for_auth(req, p.allow_http)?
  next.send(req with {headers: req.headers + [(p.header, "${p.prefix}${p.cred.get()}")]})
}

pub struct SASCredentialPolicyOptions {
  /// Sends the signature over plain HTTP too (for local testing only).
  pub insecure_allow_credential_with_http: Bool = false
}

/// Adds the signature to each request in header `header`
/// (azcore.SASCredentialPolicy).
// 0540: phantom fx so send can name next's effects; removed when xo ADR 0540 is accepted
pub struct SASCredentialPolicy[fx: Effects] {
  cred: azcore.SASCredential
  header: Str
  allow_http: Bool
}

pub fn new_sas_credential_policy[fx: Effects](cred: azcore.SASCredential, header: Str, options: SASCredentialPolicyOptions = SASCredentialPolicyOptions{}) -> SASCredentialPolicy[fx] {
  SASCredentialPolicy{cred: cred, header: header, allow_http: options.insecure_allow_credential_with_http}
}

fn (p: SASCredentialPolicy[fx]) send(req: policy.Request, next: policy.Next[fx]) -> http.Response ! policy.SendErr uses (net.dial, clock, rand, fx) {
  check_https_for_auth(req, p.allow_http)?
  next.send(req with {headers: req.headers + [(p.header, p.cred.get())]})
}
