// Typed response headers as Go's TypeSpec emitter reads them
// (strconv.ParseBool, time.Parse(time.RFC1123, ...)).

use std/time

/// Go's strconv.ParseBool: 1, t, T, TRUE, true, True, 0, f, F, FALSE,
/// false, False.
pub fn parse_bool(v: Str) -> Bool ! Str {
  match v {
    "1" | "t" | "T" | "TRUE" | "true" | "True" => Ok(true)
    "0" | "f" | "F" | "FALSE" | "false" | "False" => Ok(false)
    _ => Err("strconv.ParseBool: parsing \"${v}\": invalid syntax")
  }
}

/// An RFC 1123 time header (`Fri, 06 Nov 2026 10:00:00 GMT`), as Go's
/// time.Parse(time.RFC1123, v) reads one sent in GMT or UTC.
pub fn parse_rfc1123_header(v: Str) -> Time ! Str {
  time.parse(v.replace(" GMT", " UTC"), time.RFC1123, time.utc()) ?? e => Err("parsing time \"${v}\" as \"Mon, 02 Jan 2006 15:04:05 MST\": ${e}")
}

/// A time as Go's `t.Format(time.RFC1123)` writes a UTC one
/// (`Fri, 06 Nov 2026 10:00:00 UTC`), for a request header.
pub fn rfc1123_header_text(t: Time) -> Str {
  time.format(t, time.utc(), time.RFC1123)
}

/// A `format: date` parameter's text: Go's t.Format("2006-01-02").
pub fn date_text(t: Time) -> Str {
  time.format(t, time.utc(), time.DATE)
}
