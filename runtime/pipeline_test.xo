use std/http
use std/testing
use github.com/xo-lang/azure/policy

const URL: Str = "https://example.management.test/subscriptions/x/resourceGroups?existing=1"

fn pipeline(net: testing.FakeNet, clock: Clock, rand: Rand, opts: policy.ClientOptions) -> Pipeline {
  new_pipeline("armtest", "v0.1.0", net, clock, rand, PipelineOptions{api_version: "2024-01-01"}, opts)
}

test "the pipeline sets api-version, the User-Agent and a request ID" {
  let seen = Mutex[List[http.Request]].new([])
  os.net.handle("GET https://example.management.test/subscriptions/x/resourceGroups", fn(req: http.Request) -> http.Response {
    seen.with(fn(var xs: List[http.Request]) { xs.push(req) })
    http.text(200, "{}")
  })
  let p = pipeline(os.net, os.clock, os.rand, policy.ClientOptions{telemetry: policy.TelemetryOptions{application_id: "my app"}})
  let resp = p.send(policy.Request{method: "GET", url: URL})?
  expect(resp.status) == 200
  let r = seen.with_read(fn(xs: List[http.Request]) -> http.Request { xs[0] })
  expect(r.url.query.get("api-version")) == Some("2024-01-01")
  expect(r.url.query.get("existing")) == Some("1")
  expect((r.header("User-Agent") ?? "").starts_with("my/app xo-lang-azure-armtest/v0.1.0 (xo; ")) == true
  expect((r.header("x-ms-client-request-id") ?? "").len()) == 36
}

test "a client option overrides the api-version" {
  expect(set_query("https://h/p?api-version=1&a=b", "api-version", "2")) == "https://h/p?a=b&api-version=2"
  expect(set_query("https://h/p", "api-version", "2")) == "https://h/p?api-version=2"
}

test "retries a 503 then succeeds, and honors Retry-After" {
  let n = Atomic[Int].new(0)
  os.net.handle("GET https://example.management.test/subscriptions/x/resourceGroups", fn(req: http.Request) -> http.Response {
    match n.add(1) {
      1 => http.text(503, "")
      2 => http.text(429, "").with_header("Retry-After", "7")
      _ => http.text(200, "ok")
    }
  })
  let start = os.clock.now()
  let resp = pipeline(os.net, os.clock, os.rand, policy.ClientOptions{}).send(policy.Request{method: "GET", url: URL})?
  expect(resp.status) == 200
  expect(n.get()) == 3
  // the first retry waits 0.64 s to 1.04 s, the second the 7 s asked
  let waited = os.clock.since(start).millis()
  expect(waited >= 7640 && waited <= 8040) == true
}

test "gives up after max_retries and returns the last response" {
  let n = Atomic[Int].new(0)
  os.net.handle("GET https://example.management.test/subscriptions/x/resourceGroups", fn(req: http.Request) -> http.Response {
    n.add(1)
    http.text(500, "")
  })
  let resp = pipeline(os.net, os.clock, os.rand, policy.ClientOptions{retry: policy.RetryOptions{max_retries: 2}}).send(policy.Request{method: "GET", url: URL})?
  expect(resp.status) == 500
  expect(n.get()) == 3
}

test "a server delay past max_retry_delay is not waited for" {
  let n = Atomic[Int].new(0)
  os.net.handle("GET https://example.management.test/subscriptions/x/resourceGroups", fn(req: http.Request) -> http.Response {
    n.add(1)
    http.text(429, "").with_header("x-ms-retry-after-ms", "120000")
  })
  let resp = pipeline(os.net, os.clock, os.rand, policy.ClientOptions{}).send(policy.Request{method: "GET", url: URL})?
  expect(resp.status) == 429
  expect(n.get()) == 1
}

test "the delay doubles with azcore's jitter and is capped" {
  let o = policy.RetryOptions{}
  expect(delay(o, 1, 0.0).millis()) == 640
  expect(delay(o, 1, 0.999).millis() < 1040) == true
  expect(delay(o, 3, 0.4).millis()) == 5600
  expect(delay(o, 10, 0.5)) == 60s
}
