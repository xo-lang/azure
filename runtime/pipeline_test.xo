use std/http
use std/testing
use github.com/xo-lang/azure/policy

const URL: Str = "https://example.management.test/subscriptions/x/resourceGroups?existing=1"

fn pipeline(net: testing.FakeNet, clock: Clock, rand: Rand, opts: policy.ClientOptions) -> Pipeline {
  new_pipeline("armtest", "v0.1.0", net, clock, rand, PipelineOptions{api_version: "2024-01-01"}, opts)
}

test "the pipeline sets api-version, the User-Agent and a request ID" {
  let seen = Mutex[List[http.Request]].new([])
  os.net.handle("GET https://example.management.test/subscriptions/x/resourceGroups", fn(req: http.Request) -> http.Response {
    seen.with(fn(var xs: List[http.Request]) { xs.push(req) })
    http.text(200, "{}")
  })
  let p = pipeline(os.net, os.clock, os.rand, policy.ClientOptions{telemetry: policy.TelemetryOptions{application_id: "my app"}})
  let resp = p.send(policy.Request{method: "GET", url: URL})?
  expect(resp.status) == 200
  let r = seen.with_read(fn(xs: List[http.Request]) -> http.Request { xs[0] })
  expect(r.url.query.get("api-version")) == Some("2024-01-01")
  expect(r.url.query.get("existing")) == Some("1")
  expect((r.header("User-Agent") ?? "").starts_with("my/app xo-lang-azure-armtest/v0.1.0 (xo; ")) == true
  expect((r.header("x-ms-client-request-id") ?? "").len()) == 36
}

test "the api-version policy writes the query as azcore's does" {
  // Go's apiVersionPolicy does nothing without a version; Xo adds no
  // policy then (new_pipeline), so only the set versions are replayed
  var n = 0
  for (version, u, sent) in API_VERSION_VECTORS {
    if version != "" {
      expect(set_query_sorted(u, "api-version", version)) == sent
      n = n + 1
    }
  }
  expect(n) == 24
  expect(set_query_sorted("https://h/p?b=1#frag", "api-version", "2")) == "https://h/p?api-version=2&b=1#frag"
}

test "a client option overrides the api-version, the query sorted as Go's" {
  let seen = Mutex[List[Str]].new([])
  os.net.handle("GET https://example.management.test/subscriptions/x/resourceGroups", fn(req: http.Request) -> http.Response {
    seen.with(fn(var xs: List[Str]) { xs.push(req.raw_query()) })
    http.text(200, "{}")
  })
  let p = pipeline(os.net, os.clock, os.rand, policy.ClientOptions{api_version: "2025-02-02"})
  p.send(policy.Request{method: "GET", url: "https://example.management.test/subscriptions/x/resourceGroups?z=1&api-version=2020-01-01&a=x+y"})?
  expect(seen.with_read(fn(xs: List[Str]) -> Str { xs[0] })) == "a=x+y&api-version=2025-02-02&z=1"
}

test "set_query keeps the other parameters in their order" {
  expect(set_query("https://h/p?api-version=1&a=b", "api-version", "2")) == "https://h/p?a=b&api-version=2"
  expect(set_query("https://h/p", "api-version", "2")) == "https://h/p?api-version=2"
}

test "retries a 503 then succeeds, and honors Retry-After" {
  let n = Atomic[Int].new(0)
  os.net.handle("GET https://example.management.test/subscriptions/x/resourceGroups", fn(req: http.Request) -> http.Response {
    match n.add(1) {
      1 => http.text(503, "")
      2 => http.text(429, "").with_header("Retry-After", "7")
      _ => http.text(200, "ok")
    }
  })
  let start = os.clock.now()
  let resp = pipeline(os.net, os.clock, os.rand, policy.ClientOptions{}).send(policy.Request{method: "GET", url: URL})?
  expect(resp.status) == 200
  expect(n.get()) == 3
  // the first retry waits 0.64 s to 1.04 s, the second the 7 s asked
  let waited = os.clock.since(start).millis()
  expect(waited >= 7640 && waited <= 8040) == true
}

test "gives up after max_retries and returns the last response" {
  let n = Atomic[Int].new(0)
  os.net.handle("GET https://example.management.test/subscriptions/x/resourceGroups", fn(req: http.Request) -> http.Response {
    n.add(1)
    http.text(500, "")
  })
  let resp = pipeline(os.net, os.clock, os.rand, policy.ClientOptions{retry: policy.RetryOptions{max_retries: 2}}).send(policy.Request{method: "GET", url: URL})?
  expect(resp.status) == 500
  expect(n.get()) == 3
}

test "a server delay past max_retry_delay is not waited for" {
  let n = Atomic[Int].new(0)
  os.net.handle("GET https://example.management.test/subscriptions/x/resourceGroups", fn(req: http.Request) -> http.Response {
    n.add(1)
    http.text(429, "").with_header("x-ms-retry-after-ms", "120000")
  })
  let resp = pipeline(os.net, os.clock, os.rand, policy.ClientOptions{}).send(policy.Request{method: "GET", url: URL})?
  expect(resp.status) == 429
  expect(n.get()) == 1
}

test "the delay doubles with azcore's jitter and is capped" {
  let o = policy.RetryOptions{}
  expect(delay(o, 1, 0.0).millis()) == 640
  expect(delay(o, 1, 0.999).millis() < 1040) == true
  expect(delay(o, 3, 0.4).millis()) == 5600
  expect(delay(o, 10, 0.5)) == 60s
}

test "a transport error is retried, then the response returned" {
  os.net.handle("GET https://example.management.test/subscriptions/x/resourceGroups", fn(req: http.Request) -> http.Response { http.text(200, "ok") })
  os.net.fail_next("GET https://example.management.test/subscriptions/x/resourceGroups", http.ClientErr.Connect("refused"))
  let resp = pipeline(os.net, os.clock, os.rand, policy.ClientOptions{}).send(policy.Request{method: "GET", url: URL})?
  expect(resp.status) == 200
  expect(os.net.requests().len()) == 2
}

test "an invalid URL is not retried" {
  os.net.fail("GET https://example.management.test/subscriptions/x/resourceGroups", http.ClientErr.InvalidUrl("bad"))
  let r = pipeline(os.net, os.clock, os.rand, policy.ClientOptions{}).send(policy.Request{method: "GET", url: URL})
  expect(r.is_err()) == true
  expect(os.net.requests().len()) == 1
}

test "a status outside the retried set returns at once" {
  let n = Atomic[Int].new(0)
  os.net.handle("GET https://example.management.test/subscriptions/x/resourceGroups", fn(req: http.Request) -> http.Response {
    n.add(1)
    http.text(404, "")
  })
  expect(pipeline(os.net, os.clock, os.rand, policy.ClientOptions{}).send(policy.Request{method: "GET", url: URL})?.status) == 404
  expect(n.get()) == 1
}

test "x-ms-retry-after-ms is honored; a delay past max_retry_delay is not waited for" {
  let n = Atomic[Int].new(0)
  os.net.handle("GET https://example.management.test/subscriptions/x/resourceGroups", fn(req: http.Request) -> http.Response {
    match n.add(1) {
      1 => http.text(503, "").with_header("x-ms-retry-after-ms", "1500")
      2 => http.text(503, "").with_header("Retry-After", "120")
      _ => http.text(200, "")
    }
  })
  let start = os.clock.now()
  let resp = pipeline(os.net, os.clock, os.rand, policy.ClientOptions{retry: policy.RetryOptions{max_retry_delay: 60s}}).send(policy.Request{method: "GET", url: URL})?
  // the second 503 asks for 120 s, past the 60 s cap: azcore returns it
  expect(resp.status) == 503
  expect(n.get()) == 2
  expect(os.clock.since(start).millis()) == 1500
}

test "the backoff doubles with jitter in [0.8, 1.3) and stops at max_retry_delay" {
  let o = policy.RetryOptions{retry_delay: 800ms, max_retry_delay: 60s}
  expect(delay(o, 1, 0.0).millis()) == 640
  expect(delay(o, 1, 0.5).millis()) == 840
  expect(delay(o, 2, 0.0).millis()) == 1920
  expect(delay(o, 3, 0.999).millis() < 7280) == true
  expect(delay(o, 10, 0.5)) == 60s
}


test "the marker pager's next page sets the marker with the query sorted, as Go's" {
  os.net.handle("GET https://h.example.test/c", fn(req: http.Request) -> http.Response { http.text(200, if req.url.query.get("marker").is_some() { "" } else { "m 2" }) })
  var p = new_marker_pager(new_pipeline("t", "v0", os.net, os.clock, os.rand, PipelineOptions{}, policy.ClientOptions{}), policy.Request{method: "GET", url: "https://h.example.test/c?restype=container&comp=list"}, fn(r: http.Response) -> Str ! Str { Ok(r.body.to_str_lossy()) }, "marker", fn(s: Str) -> Str? { Some(s) })
  while p.more() {
    p.next_page()?
  }
  expect(os.net.requests().map(fn(r: http.Request) -> Str { r.raw_query() })) == ["restype=container&comp=list", "comp=list&marker=m+2&restype=container"]
}

test "join_paths is azcore's JoinPaths with one path" {
  // rows from a local Go program calling runtime.JoinPaths (azcore v1.21.0)
  for (root, seg, want) in [
    ("https://h.example.test", "//keys/providers/x", "https://h.example.test/keys/providers/x"),
    ("https://h.example.test/", "/a/../b/", "https://h.example.test/b/"),
    ("https://h.example.test/base", "keys/k1/", "https://h.example.test/base/keys/k1/"),
    ("https://h.example.test/base?sv=1&sig=a", "/x", "https://h.example.test/base/x?sv=1&sig=a"),
    ("https://h.example.test/base?a=1?b=2", "/x", "https://h.example.test/base/x?a=1"),
    ("https://h.example.test", "", "https://h.example.test/"),
    ("https://h.example.test", "/k%2F1/./v", "https://h.example.test/k%2F1/v"),
  ] {
    expect("${root} + ${seg} = ${join_paths(root, seg)}") == "${root} + ${seg} = ${want}"
  }
}

struct Sas {
  token as "token,omitempty": Str? = None
  uri as "uri,omitempty": Str? = None
} derive Json

test "marshal_json escapes as Go's json.Marshal" {
  // Go: json.Marshal(struct{...}{"sv=1&sig=<a>", ...})
  expect(marshal_json(Sas{token: Some("sv=1&sig=<a>"), uri: Some("https://h.example.test/c")}).to_str_lossy()) == "{\"token\":\"sv=1\\u0026sig=\\u003ca\\u003e\",\"uri\":\"https://h.example.test/c\"}"
  expect(marshal_json(Sas{}).to_str_lossy()) == "{}"
}
