// Generated from the output of a local Go program that runs azcore
// v1.24.0's SSE reader (streaming.NewSSEReader) over scripted bodies and
// connections, then through a pipeline with a fake transport and
// runtime.SSEResponse; do not edit. A frame's data longer than 100
// bytes is its length; RECONNECT is a reconnection delay above zero.

const SSE_GO: List[Str] = [
  "CASE basic",
  "CONNECT \"\"",
  "FRAME type=\"\" data=\"a\" id=<nil> retry=<nil>",
  "EVENT \"a\" last=\"\"",
  "NEXT EOF last=\"\"",
  "AFTER CLOSE EOF",
  "CASE fields",
  "CONNECT \"\"",
  "FRAME type=\"e\" data=\"l1\\nl2\" id=\"7\" retry=15",
  "EVENT \"l1\\nl2\" last=\"7\"",
  "NEXT EOF last=\"7\"",
  "AFTER CLOSE EOF",
  "CASE line ends",
  "CONNECT \"\"",
  "FRAME type=\"\" data=\"x\\ny\" id=<nil> retry=<nil>",
  "EVENT \"x\\ny\" last=\"\"",
  "FRAME type=\"\" data=\"z\" id=<nil> retry=<nil>",
  "EVENT \"z\" last=\"\"",
  "FRAME type=\"\" data=\"w\" id=<nil> retry=<nil>",
  "EVENT \"w\" last=\"\"",
  "NEXT EOF last=\"\"",
  "AFTER CLOSE EOF",
