  "CONNECT \"\"",
  "FRAME type=\"\" data=\"bom\" id=<nil> retry=<nil>",
  "EVENT \"bom\" last=\"\"",
  "NEXT EOF last=\"\"",
  "AFTER CLOSE EOF",
