  "REQ GET https://sse.example.test/events?x=1 last-event-id=\"\" accept=\"text/event-stream\"",
  "FRAME type=\"\" data=\"a\" id=\"1\" retry=<nil>",
  "EVENT \"a\" last=\"1\"",
  "FRAME type=\"\" data=\"b\" id=<nil> retry=<nil>",
  "EVENT \"b\" last=\"1\"",
  "NEXT EOF last=\"1\"",
  "CASE sse charset",
  "REQ GET https://sse.example.test/events?x=1 last-event-id=\"\" accept=\"text/event-stream\"",
