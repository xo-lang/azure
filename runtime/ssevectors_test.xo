  "CONNECT \"\"",
  "FRAME type=\"\" data=\"s\" id=<nil> retry=<nil>",
  "EVENT \"s\" last=\"\"",
  "NEXT EOF last=\"\"",
  "AFTER CLOSE EOF",
  "CASE comments and bare fields",
  "CONNECT \"\"",
  "FRAME type=\"\" data=\"\" id=<nil> retry=<nil>",
  "EVENT \"\" last=\"\"",
  "FRAME type=\"\" data=\"\" id=<nil> retry=<nil>",
  "EVENT \"\" last=\"\"",
  "NEXT EOF last=\"\"",
  "AFTER CLOSE EOF",
  "CASE spaces",
  "CONNECT \"\"",
  "FRAME type=\"\" data=\"nospace\" id=<nil> retry=<nil>",
  "EVENT \"nospace\" last=\"\"",
  "FRAME type=\"\" data=\" two\" id=<nil> retry=<nil>",
  "EVENT \" two\" last=\"\"",
  "FRAME type=\"\" data=\"\" id=<nil> retry=<nil>",
  "EVENT \"\" last=\"\"",
  "NEXT EOF last=\"\"",
  "AFTER CLOSE EOF",
  "CASE ids",
  "CONNECT \"seed\"",
  "FRAME type=\"\" data=\"a\" id=\"1\" retry=<nil>",
  "EVENT \"a\" last=\"1\"",
  "FRAME type=\"\" data=\"b\" id=<nil> retry=<nil>",
  "EVENT \"b\" last=\"1\"",
  "FRAME type=\"\" data=\"c\" id=\"\" retry=<nil>",
  "EVENT \"c\" last=\"\"",
  "NEXT EOF last=\"9\"",
  "AFTER CLOSE EOF",
  "CASE retry values",
  "CONNECT \"\"",
  "FRAME type=\"\" data=\"r\" id=<nil> retry=7",
  "EVENT \"r\" last=\"\"",
  "NEXT EOF last=\"\"",
  "AFTER CLOSE EOF",
  "CASE metadata only",
  "CONNECT \"\"",
  "NEXT EOF last=\"m\"",
  "AFTER CLOSE EOF",
  "CASE unfinished",
  "CONNECT \"\"",
  "FRAME type=\"\" data=\"a\" id=<nil> retry=<nil>",
  "EVENT \"a\" last=\"\"",
  "NEXT EOF last=\"\"",
  "AFTER CLOSE EOF",
  "CASE unknown fields",
  "CONNECT \"\"",
  "FRAME type=\"\" data=\"a\" id=<nil> retry=<nil>",
  "EVENT \"a\" last=\"\"",
  "NEXT EOF last=\"\"",
  "AFTER CLOSE EOF",
  "CASE done sentinel",
  "CONNECT \"\"",
  "FRAME type=\"\" data=\"a\" id=<nil> retry=<nil>",
  "EVENT \"a\" last=\"\"",
  "FRAME type=\"\" data=\"[DONE]\" id=<nil> retry=<nil>",
  "NEXT EOF last=\"\"",
  "AFTER CLOSE EOF",
  "CASE terminal",
  "CONNECT \"\"",
  "FRAME type=\"end\" data=\"last\" id=<nil> retry=<nil>",
  "EVENT \"last\" last=\"\"",
  "NEXT EOF last=\"\"",
  "AFTER CLOSE EOF",
  "CASE decode error",
  "CONNECT \"\"",
  "FRAME type=\"bad\" data=\"x\" id=<nil> retry=<nil>",
  "NEXT decode: bad frame last=\"\"",
  "AFTER CLOSE EOF",
  "CASE read error",
  "CONNECT \"\"",
  "FRAME type=\"\" data=\"a\" id=<nil> retry=<nil>",
  "EVENT \"a\" last=\"\"",
  "NEXT read last=\"\"",
  "AFTER CLOSE EOF",
