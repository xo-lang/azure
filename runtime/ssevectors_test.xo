  "EVENT \"a\" last=\"1\"",
  "RECONNECT 2ms",
  "CONNECT \"1\"",
  "FRAME type=\"\" data=\"b\" id=\"2\" retry=<nil>",
  "EVENT \"b\" last=\"2\"",
  "RECONNECT 2ms",
