  "EVENT \"c\" last=\"\"",
  "NEXT EOF last=\"\"",
  "CASE sse upper case",
  "REQ GET https://sse.example.test/events?x=1 last-event-id=\"\" accept=\"text/event-stream\"",
  "FRAME type=\"\" data=\"u\" id=<nil> retry=<nil>",
  "EVENT \"u\" last=\"\"",
  "NEXT EOF last=\"\"",
  "CASE sse json",
  "REQ GET https://sse.example.test/events?x=1 last-event-id=\"\" accept=\"text/event-stream\"",
  "NEW error unexpected SSE Content-Type \"application/json\"",
  "CASE sse no content type",
  "REQ GET https://sse.example.test/events?x=1 last-event-id=\"\" accept=\"text/event-stream\"",
