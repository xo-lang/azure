use std/json
use std/path

/// `root` with `segment` joined to its path, cleaned as Go's path.Join
/// cleans it (a trailing slash kept), and root's query kept after it.
pub fn join_paths(root: Str, segment: Str) -> Str {
  var r = root
  var qps = ""
  if r.contains("?") {
    // Go splits on every "?" and keeps the first two parts
    let parts = r.split("?")
    r = parts[0]
    qps = parts[1]
  }
  var p = if segment == "" { "" } else { path.clean(segment) }
  if segment.ends_with("/") && !p.ends_with("/") {
    p = p + "/"
  }
  if qps != "" {
    p = "${p}?${qps}"
  }
  if r.ends_with("/") && p.starts_with("/") {
    r = r[0..r.len() - 1]
  } else if !r.ends_with("/") && !p.starts_with("/") {
    p = "/" + p
  }
  r + p
}

/// `v` as azcore's MarshalAsJSON writes a request body: Go's
/// json.Marshal, so `<`, `>` and `&` in strings are `<`, `>`
/// and `&` (json.encode leaves them as they are).
pub fn marshal_json[T: Json](v: T) -> Bytes {
  var w = json.json_writer(escape_html: true)
  match w.value(json.to_value(v)) {
    Ok(_) => w.finish().to_str_lossy().trim_end_chars("\n").bytes()
    Err(_) => json.encode(v)
  }
}
