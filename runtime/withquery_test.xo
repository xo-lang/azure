// with_query against Go's generated request code (azcore v1.23.0's
// NewRequest of JoinPaths, then `reqQP := URL.Query(); reqQP.Set(...);
// RawQuery = reqQP.Encode()`), from a local Go program's output.

use std/url

fn wq(root: Str, path: Str, set: List[(Str, Str)], pct20: Bool = false) -> Str {
  var q = url.values()
  for (k, v) in set {
    q.set(k, v)
  }
  with_query(join_paths(root, path), q, pct20: pct20)
}

test "parameters join a query the URL already has, as Go's generated code" {
  expect(wq("https://h.example.test", "/v2/a/blobs/uploads/u1?_state=s2", [("digest", "sha256:ab")])) == "https://h.example.test/v2/a/blobs/uploads/u1?_state=s2&digest=sha256%3Aab"
  expect(wq("https://h.example.test?x=1&a=b%20c", "/keys/k", [("api-version", "7.5")])) == "https://h.example.test/keys/k?a=b+c&api-version=7.5&x=1"
  expect(wq("https://h.example.test?api-version=old&z=1", "/keys/k", [("api-version", "7.5")])) == "https://h.example.test/keys/k?api-version=7.5&z=1"
  // URL.Query drops a pair with `;` or a bad escape
  expect(wq("https://h.example.test", "/p?a=1;b=2&c=%zz&d=x+y", [("e", "a b")])) == "https://h.example.test/p?d=x+y&e=a+b"
  expect(wq("https://h.example.test", "/p?q=a+b", [("e", "a b")], pct20: true)) == "https://h.example.test/p?e=a%20b&q=a%20b"
  expect(wq("https://h.example.test", "/p", [("e", "1"), ("b", "2")])) == "https://h.example.test/p?b=2&e=1"
}
