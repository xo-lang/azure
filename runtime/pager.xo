// Pages of a list operation, as azcore's runtime.Pager with its
// PagingHandler (MIT, Copyright (c) Microsoft Corporation; NOTICE.md):
// the first request, then the request for each next page until a page
// has none. Two shapes come with it, as Go's callers write them:
// `new_pager`, a GET of the page's next link (ARM's nextLink,
// FetcherForNextLink), and `new_marker_pager`, the first request again
// with a marker query parameter (Storage's NextMarker).
//
// A Pager holds the pipeline and pure functions (the decoder and the
// next request builder); the sends are its own, since an interface
// method's effects are fixed (decision 0006, item 4).

use std/http
use std/url
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/policy

pub struct Pager[T, fx: Effects] {
  pub pipeline: Pipeline[fx]
  pub first: policy.Request
  pub decode: fn(http.Response) -> T ! Str
  /// The request for the page after `page` (fetched with `prev`), None
  /// after the last page.
  pub next: fn(policy.Request, T) -> policy.Request?
  /// Statuses of a page besides 200.
  pub ok_status: List[Int] = []
  started: Bool = false
  pending: policy.Request? = None
  /// A first page already in hand (a pageable long-running operation's
  /// final response), returned before any request.
  seed: T? = None
  /// The error of a failed fetch: the pager's terminal state (azcore
  /// v1.23.0), `more` false and every later `next_page` this error.
  failed: azcore.CallErr? = None
  /// For `new_next_link_pager`: the client endpoint a next link is sent
  /// against (azcore's NewRequestForNextLink).
  link_endpoint: Str? = None
}

/// The pager with `page` as its first page, fetched by its first
/// request: a pageable long-running operation's result, as Go's
/// Poller[*Pager[T, fx]] decodes the final response into the pager.
pub fn (p: Pager[T, fx]) starting_with(page: T) -> Pager[T, fx] {
  p with {seed: Some(page)}
}

/// A pager with any next-request rule (azcore's PagingHandler).
pub fn new_pager_with[T, fx: Effects](pipeline: Pipeline[fx], first: policy.Request, decode: fn(http.Response) -> T ! Str, next: fn(policy.Request, T) -> policy.Request?) -> Pager[T, fx] {
  Pager{pipeline: pipeline, first: first, decode: decode, next: next}
}

/// A pager that GETs each page's next link, its query re-encoded
/// (azcore's FetcherForNextLink); a link of "" ends it.
pub fn new_pager[T, fx: Effects](pipeline: Pipeline[fx], first: policy.Request, decode: fn(http.Response) -> T ! Str, next_link: fn(T) -> Str?) -> Pager[T, fx] {
  new_pager_with(pipeline, first, decode, fn(prev: policy.Request, page: T) -> policy.Request? {
    let link = next_link(page) ?? return None
    if link == "" {
      return None
    }
    // a bare GET, as azcore's FetcherForNextLink makes it (NewRequest):
    // the first request's headers, Accept among them, are not sent again
    Some(policy.Request{method: "GET", url: encode_query(link)})
  })
}

/// A pager that GETs each page's next link as TypeSpec's Go emitter
/// does (azcore's NewRequestForNextLink): the link's query encoded with
/// a space as `%20`, a relative link joined to `endpoint`, and a link
/// that does not parse failing the pager.
pub fn new_next_link_pager[T, fx: Effects](pipeline: Pipeline[fx], first: policy.Request, decode: fn(http.Response) -> T ! Str, endpoint: Str, next_link: fn(T) -> Str?) -> Pager[T, fx] {
  let p = new_pager_with(pipeline, first, decode, fn(prev: policy.Request, page: T) -> policy.Request? {
    let link = next_link(page) ?? return None
    if link == "" {
      return None
    }
    Some(policy.Request{method: "GET", url: link})
  })
  p with {link_endpoint: Some(endpoint)}
}

/// A pager that sends the first request again with query parameter
/// `name` (Storage's `marker`) set to each page's marker, the query
/// encoded sorted as Go's generated code encodes it (set_query_sorted;
/// a service that writes a space as `%20`, as azblob, rewrites it); a
/// marker of "" ends it.
pub fn new_marker_pager[T, fx: Effects](pipeline: Pipeline[fx], first: policy.Request, decode: fn(http.Response) -> T ! Str, name: Str, marker: fn(T) -> Str?) -> Pager[T, fx] {
  new_pager_with(pipeline, first, decode, fn(prev: policy.Request, page: T) -> policy.Request? {
    let m = marker(page) ?? return None
    if m == "" {
      return None
    }
    Some(prev with {url: set_query_sorted(prev.url, name, m)})
  })
}

/// Whether another page can be fetched: false once a fetch failed.
pub fn (p: Pager[T, fx]) more() -> Bool {
  p.failed.is_none() && (!p.started || p.pending.is_some())
}

/// The next page. A failed fetch is returned again by every later call,
/// with no request sent, as azcore v1.23.0's Pager does.
pub fn (var p: Pager[T, fx]) next_page() -> T ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  if let Some(e) = p.failed {
    return Err(e)
  }
  if !p.started {
    if let Some(page) = p.seed {
      p.started = true
      p.seed = None
      p.pending = (p.next)(p.first, page)
      return Ok(page)
    }
  }
  var req = if !p.started { p.first } else {
    p.pending ?? return Err(azcore.CallErr.InvalidInput("no more pages"))
  }
  if p.started {
    if let Some(ep) = p.link_endpoint {
      req = new_request_for_next_link("GET", ep, req.url) ?? e => {
        let ce = azcore.CallErr.InvalidInput(e)
        p.failed = Some(ce)
        return Err(ce)
      }
    }
  }
  let page = match p.fetch(req) {
    Ok(v) => v
    Err(e) => {
      p.failed = Some(e)
      return Err(e)
    }
  }
  p.started = true
  p.pending = (p.next)(req, page)
  Ok(page)
}

fn (p: Pager[T, fx]) fetch(req: policy.Request) -> T ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  let resp = p.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if resp.status != 200 && !p.ok_status.contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  (p.decode)(resp) ?? e => Err(azcore.CallErr.Decode(e))
}

/// `link` with its query re-encoded (sorted, escaped), as azcore's
/// EncodeQueryParams.
pub fn encode_query(link: Str) -> Str {
  let i = link.find("?") ?? return link
  let q = url.parse_query(link[i + 1..link.len()]) ?? _ => return link
  "${link[0..i]}?${q.encode()}"
}
