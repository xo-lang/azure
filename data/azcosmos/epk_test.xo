// The partition key hashes against the Cosmos DB baselines Go's epk tests
// use (epkvectors_test.xo), and Go's comparison and masking cases.

test "partition key hashes match the service's baselines, version 1 and 2" {
  for c in EPK_CASES {
    expect((c.name, epk_v1(c.values))) == (c.name, c.v1)
    let v2 = if c.multi { epk_v2_multi(c.values) } else { epk_v2(c.values) }
    expect((c.name, v2)) == (c.name, c.v2)
  }
}

test "effective partition keys compare as Go's CompareEPK" {
  expect(compare_epk("06AB34CFE4E48223", "06AB34CFE4E48223")) == 0
  expect(compare_epk("06AB34CFE4E48223", "06AB34CFE4E48224")) == -1
  expect(compare_epk("06AB34CFE4E48224", "06AB34CFE4E48223")) == 1
  let partial = "06AB34CFE4E482236BCACBBF50E234AB"
  expect(compare_epk(partial, "${partial}00000000000000000000000000000000")) == 0
  expect(compare_epk("${partial}00000000000000000000000000000000", partial)) == 0
  expect(compare_epk(partial, "${partial}00000000000000000000000000000001")) == -1
  expect(compare_epk("${partial}00000000000000000000000000000001", partial)) == 1
  expect(compare_epk("", "")) == 0
  expect(compare_epk("", "00000")) == 0
  expect(compare_epk("", "00001")) == -1
  expect(compare_epk("FF", "3FFFFFFFFFFFFFFF")) == 1
  expect(compare_epk("3FFFFFFFFFFFFFFF", "FF")) == -1
}

test "routing masks the top two bits of each component" {
  expect(mask_top_bits("3FAABBCC")) == "3FAABBCC"
  expect(mask_top_bits("FFAABBCC")) == "3FAABBCC"
  expect(mask_top_bits("C0AABBCC")) == "00AABBCC"
  expect(mask_top_bits("80112233")) == "00112233"
  expect(mask_top_bits("40112233")) == "00112233"
  expect(mask_top_bits("")) == ""
  expect(mask_top_bits("A")) == "A"
  let r = epk_v2_multi_routing([EpkValue.Str(s: "hello"), EpkValue.Str(s: "world")])
  expect(r.len()) == 64
  expect("0123".contains(r[0..1]) && "0123".contains(r[32..33])) == true
}
