// Containers with vector embedding and full text policies and indexes,
// compared with Go's azcosmos v1.5.0 (polvectors_test.xo): the create
// body, and the properties read back written again.

use std/http
use github.com/xo-lang/azure/policy

const F1_REPLY: Str = "{\"id\":\"v1\",\"_rid\":\"r1\",\"partitionKey\":{\"paths\":[\"/pk\"],\"kind\":\"Hash\",\"version\":2},\"indexingPolicy\":{\"automatic\":true,\"indexingMode\":\"consistent\",\"includedPaths\":[{\"path\":\"/*\"}],\"excludedPaths\":[{\"path\":\"/emb/*\"},{\"path\":\"/\\\"_etag\\\"/?\"}],\"vectorIndexes\":[{\"path\":\"/emb\",\"type\":\"diskANN\",\"quantizationByteSize\":96}],\"fullTextIndexes\":[{\"path\":\"/text\"}]},\"vectorEmbeddingPolicy\":{\"vectorEmbeddings\":[{\"path\":\"/emb\",\"dataType\":\"float32\",\"distanceFunction\":\"cosine\",\"dimensions\":1536}]},\"fullTextPolicy\":{\"defaultLanguage\":\"en-US\",\"fullTextPaths\":[{\"path\":\"/text\",\"language\":\"en-US\"}]}}"
const F2_REPLY: Str = "{\"id\":\"v2\",\"partitionKey\":{\"paths\":[\"/pk\"],\"kind\":\"Hash\"},\"vectorEmbeddingPolicy\":{\"vectorEmbeddings\":[]},\"fullTextPolicy\":{\"defaultLanguage\":\"\",\"fullTextPaths\":null}}"
const F3_REPLY: Str = "{\"id\":\"v3\",\"partitionKey\":{\"paths\":[\"/pk\"],\"kind\":\"Hash\"},\"indexingPolicy\":{\"automatic\":true,\"indexingMode\":\"consistent\"}}"

test "vector and full text policies are written and read as Go writes and reads them" {
  let log = Mutex[List[Str]].new([])
  let reply = Mutex[Str].new("")
  os.net.handle("GET ${EP}/", fn(req: http.Request) -> http.Response { js_resp(200, "{\"id\":\"acct1\",\"writableLocations\":[],\"readableLocations\":[]}") })
  os.net.handle("POST ${EP}/dbs/db1/colls", fn(req: http.Request) -> http.Response {
    log.with(fn(var l: List[Str]) { l.push("BODY ${req.body.to_str_lossy()}") })
    js_resp(201, reply.with_read(fn(r: Str) -> Str { r }))
  })
  let cred = new_key_credential(KEY)?
  let c = new_client_with_key(os.net, os.clock, os.rand, "${EP}/", cred, ClientOptions{client: policy.ClientOptions{retry: policy.RetryOptions{max_retries: -1}}})
  let db = c.new_database("db1")?
  var out: List[Str] = []
  let create = fn(name: Str, p: ContainerProperties, svc: Str) -> List[Str] uses (net.dial, clock, rand) {
    reply.with(fn(var r: Str) { r = svc })
    let resp = db.create_container(p) ?? e => fault("create: ${e.display()}")
    let read = (resp.container_properties ?? fault("no properties")).to_json()
    let body = log.with(fn(var l: List[Str]) -> List[Str] {
      let xs = l
      l = []
      xs
    })
    ["== ${name}"] + body + ["READ ${read} <nil>"]
  }
  let pk = PartitionKeyDefinition{paths: ["/pk"], version: 2}
  let full = ContainerProperties{
    id: "v1", partition_key_definition: pk,
    indexing_policy: Some(IndexingPolicy{automatic: true, indexing_mode: INDEXING_MODE_CONSISTENT, included_paths: [IncludedPath{path: "/*"}], excluded_paths: [ExcludedPath{path: "/emb/*"}], vector_indexes: [VectorIndex{path: "/emb", index_type: VECTOR_INDEX_TYPE_DISK_ANN}, VectorIndex{path: "/emb2", index_type: VECTOR_INDEX_TYPE_QUANTIZED_FLAT}], full_text_indexes: [FullTextIndex{path: "/text"}]}),
    vector_embedding_policy: Some(VectorEmbeddingPolicy{vector_embeddings: [
      VectorEmbedding{path: "/emb", data_type: VECTOR_DATA_TYPE_FLOAT32, distance_function: VECTOR_DISTANCE_FUNCTION_COSINE, dimensions: 1536},
      VectorEmbedding{path: "/emb2", data_type: VECTOR_DATA_TYPE_INT8, distance_function: VECTOR_DISTANCE_FUNCTION_DOT_PRODUCT, dimensions: 8},
    ]}),
    full_text_policy: Some(FullTextPolicy{default_language: "en-US", full_text_paths: [FullTextPath{path: "/text", language: "en-US"}]}),
  }
  out = out + create("f1 vector and full text policies and indexes", full, F1_REPLY)
  let simple = PartitionKeyDefinition{paths: ["/pk"]}
  out = out + create("f2 empty policies", ContainerProperties{id: "v2", partition_key_definition: simple, vector_embedding_policy: Some(VectorEmbeddingPolicy{}), full_text_policy: Some(FullTextPolicy{})}, F2_REPLY)
  out = out + create("f3 a service reply without them", ContainerProperties{id: "v3", partition_key_definition: simple}, F3_REPLY)
  // The one difference: Go keeps a decoded empty list ([]) apart from a
  // missing one (null); the port's List writes both as null.
  let want = POLICY_OUTPUT.map(fn(l: Str) -> Str { if l.starts_with("READ {\"id\":\"v2\"") { l.replace("\"vectorEmbeddings\":[]", "\"vectorEmbeddings\":null") } else { l } })
  expect(out) == want
}
