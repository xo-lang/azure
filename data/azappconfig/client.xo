/// What archive_snapshot and recover_snapshot give.
pub struct UpdateSnapshotStatusResponse {
  pub snapshot: Snapshot
  pub link: Str? = None
  pub sync_token: SyncToken = ""
}

pub type ArchiveSnapshotResponse = UpdateSnapshotStatusResponse
pub type RecoverSnapshotResponse = UpdateSnapshotStatusResponse

/// Archives a ready snapshot (ArchiveSnapshot).
pub fn (c: Client) archive_snapshot(snapshot_name: Str, options: ArchiveSnapshotOptions = ArchiveSnapshotOptions{}) -> ArchiveSnapshotResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  c.update_snapshot_status(snapshot_name, SNAPSHOT_STATUS_ARCHIVED, options.if_match, options.if_none_match)
}

/// Makes an archived snapshot ready again (RecoverSnapshot).
pub fn (c: Client) recover_snapshot(snapshot_name: Str, options: RecoverSnapshotOptions = RecoverSnapshotOptions{}) -> RecoverSnapshotResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  c.update_snapshot_status(snapshot_name, SNAPSHOT_STATUS_READY, options.if_match, options.if_none_match)
}

fn (c: Client) update_snapshot_status(name: Str, status: SnapshotStatus, if_match: Str?, if_none_match: Str?) -> UpdateSnapshotStatusResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let entity = generated.SnapshotUpdateParameters{status: json.Patch.Value(status)}
  let r = c.gen.update_snapshot(name, entity, generated.UpdateSnapshotOptions{if_match: if_match, if_none_match: if_none_match})?
  Ok(UpdateSnapshotStatusResponse{snapshot: snapshot_of(r.snapshot), link: r.link, sync_token: r.sync_token ?? ""})
}

// Pagers, each over the generated layer's (Go's runtime.Pager over a
// PagingHandler): once a page fails, `more` is false and `next_page`
// gives that error again.

/// The pages of new_list_settings_pager.
pub struct ListSettingsPager {
  inner: generated.Pager[generated.GetKeyValuesResponse]
}

pub fn (p: ListSettingsPager) more() -> Bool {
  p.inner.more()
}

pub fn (var p: ListSettingsPager) next_page() -> ListSettingsPageResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let page = p.inner.next_page()?
  Ok(ListSettingsPageResponse{settings: (page.key_value_list_result.items ?? []).map(setting_of), etag: page.etag, sync_token: page.sync_token ?? ""})
}

