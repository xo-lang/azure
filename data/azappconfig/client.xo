  ListSnapshotsPager{inner: c.gen.new_get_snapshots_pager_with_next_links(generated.GetSnapshotsOptions{after: options.after, name: options.name, select_: options.select_, status: options.status})}
}

pub struct ListSettingsForSnapshotOptions {
  pub accept_datetime: Str? = None
  pub after: Str? = None
  pub if_match: Str? = None
  pub if_none_match: Str? = None
  pub select_: List[SettingFields]? = None
  /// Sent as `key` even when empty, as Go's.
  pub key: Str = ""
  /// Sent as `label` even when empty, as Go's.
  pub label: Str = ""
}

pub struct ListSettingsForSnapshotResponse {
  pub settings: List[Setting] = []
  pub sync_token: SyncToken = ""
}

/// Lists the settings of snapshot `snapshot_name`
/// (NewListSettingsForSnapshotPager).
pub fn (c: Client) new_list_settings_for_snapshot_pager(snapshot_name: Str, options: ListSettingsForSnapshotOptions = ListSettingsForSnapshotOptions{}) -> ListSettingsForSnapshotPager {
  let o = generated.GetKeyValuesOptions{accept_datetime: options.accept_datetime, after: options.after, if_match: options.if_match, if_none_match: options.if_none_match, select_: options.select_, snapshot: Some(snapshot_name), key: Some(options.key), label: Some(options.label)}
  ListSettingsForSnapshotPager{inner: c.gen.new_get_key_values_pager_with_next_links(o)}
}

pub struct BeginCreateSnapshotOptions {
  /// Resumes the operation from a poller's resume_token instead of
  /// starting it.
  pub resume_token: Str = ""
  pub composition_type: CompositionType? = None
  pub description: Str? = None
  pub retention_period: Int? = None
  pub tags: Map[Str, Str]? = None
}

pub struct CreateSnapshotResponse {
  pub snapshot: Snapshot
}

/// Starts making snapshot `snapshot_name` of the settings the filters
/// match (no filter is one empty filter, as Go's), and polls it
/// (BeginCreateSnapshot).
pub fn (c: Client[fx]) begin_create_snapshot(snapshot_name: Str, setting_filter: List[SettingFilter], options: BeginCreateSnapshotOptions = BeginCreateSnapshotOptions{}) -> runtime.Poller[CreateSnapshotResponse, fx] ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  var filters = setting_filter.map(fn(f: SettingFilter) -> generated.KeyValueFilter { generated.KeyValueFilter{key: f.key_filter, label: f.label_filter} })
  if filters.is_empty() {
    filters = [generated.KeyValueFilter{}]
  }
  let decode = fn(r: http.Response) -> CreateSnapshotResponse ! Str { create_snapshot_result(r) }
  if options.resume_token != "" {
    return runtime.resume_poller(c.gen.pipeline(), options.resume_token, "CreateSnapshotResponse", decode)
  }
  let entity = generated.Snapshot{composition_type: options.composition_type, description: options.description, filters: Some(filters), name: Some(snapshot_name), retention_period: options.retention_period, tags: options.tags}
  let req = c.gen.create_snapshot_request(snapshot_name, entity)?
  let resp = c.gen.pipeline().send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if resp.status != 201 {
    return Err(azcore.CallErr.Response(azcore.response_error(req.method, req.url, resp)))
  }
  runtime.new_poller(c.gen.pipeline(), req, resp, "", "CreateSnapshotResponse", decode)
}

/// A finished snapshot operation's result, decoded as Go decodes it into
/// its public Snapshot: the filters' keys and labels are lost, since
/// SettingFilter has no JSON names (`key` is not `KeyFilter`), so each
/// filter is empty.
fn create_snapshot_result(r: http.Response) -> CreateSnapshotResponse ! Str {
  if r.body.is_empty() {
    return Ok(CreateSnapshotResponse{snapshot: Snapshot{}})
  }
  let s = json.decode[generated.Snapshot](r.body) ?? e => return Err(e.display())
  let snap = snapshot_of(s)
  Ok(CreateSnapshotResponse{snapshot: snap with {filters: snap.filters.map(fn(f: SettingFilter) -> SettingFilter { SettingFilter{} })}})
}

pub struct GetSnapshotOptions {
  pub if_match: Str? = None
  pub if_none_match: Str? = None
  pub select_: List[SnapshotFields]? = None
}

pub struct GetSnapshotResponse {
  pub snapshot: Snapshot
  pub link: Str? = None
  pub sync_token: SyncToken = ""
}

/// Gets a snapshot (GetSnapshot).
pub fn (c: Client) get_snapshot(snapshot_name: Str, options: GetSnapshotOptions = GetSnapshotOptions{}) -> GetSnapshotResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let r = c.gen.get_snapshot(snapshot_name, generated.GetSnapshotOptions{if_match: options.if_match, if_none_match: options.if_none_match, select_: options.select_})?
  Ok(GetSnapshotResponse{snapshot: snapshot_of(r.snapshot), link: r.link, sync_token: r.sync_token ?? ""})
}

pub struct ArchiveSnapshotOptions {
  pub if_match: Str? = None
  pub if_none_match: Str? = None
}

pub struct RecoverSnapshotOptions {
  pub if_match: Str? = None
  pub if_none_match: Str? = None
