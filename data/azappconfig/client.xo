pub const COMPOSITION_TYPE_KEY_LABEL: CompositionType = generated.COMPOSITION_TYPE_KEY_LABEL

/// A sync token: `<id>=<value>;sn=<version>`, comma separated
/// (Go's SyncToken).
pub type SyncToken = Str

/// Options of the constructors.
pub struct ClientOptions[fx: Effects] {
  pub client: policy.ClientOptions[fx] = policy.ClientOptions{}
}

/// Client reads and writes the settings and snapshots of one App
/// Configuration store.
pub struct Client {
  gen: generated.Client
  cache: SyncTokenCache
}

/// The audience of a store's endpoint host, as Go's getAudience: the
/// staging domain's, else the domain from the last `appconfig` or
/// `azconfig` label, else the public cloud's.
fn audience_of(endpoint: Str) -> Str {
  let (host, _) = host_and_path(endpoint)
  // Go's URL.Hostname: the port dropped, an IPv6 address unbracketed
  var h = host.to_lower()
  if h.starts_with("[") {
    h = (h.cut("]").map(fn(t: (Str, Str)) -> Str { t.0 }) ?? h)[1..]
  } else if let Some((name, _)) = h.cut(":") {
    h = name
  }
  if h.ends_with(".${APP_CONFIG_STAGING_DOMAIN}") {
    return "https://${APP_CONFIG_STAGING_DOMAIN}"
  }
  let labels = h.split(".")
  var i = labels.len() - 1
  while i >= 0 {
    if labels[i] == "appconfig" || labels[i] == "azconfig" {
      return "https://${labels[i..labels.len()].join(".")}"
    }
    i -= 1
  }
  DEFAULT_AUDIENCE
}

/// The audience the options' cloud sets, if any: its own `SERVICE_NAME`
/// entry, else the built-in one of China's or Government's cloud (Go's
/// cloud_config.go adds them). The public cloud is the options' default,
/// so it counts as no cloud set, as Go's zero Cloud: the endpoint gives
/// the audience.
fn configured_audience[fx: Effects](o: ClientOptions[fx]) -> Str? {
  let c = o.client.cloud
  match c.services.get(SERVICE_NAME) {
    Some(s) => if s.audience == "" { None } else { Some(s.audience) }
    None => if c == cloud.AZURE_PUBLIC { None } else { builtin_audience(c) }
  }
}

/// A client for the store at `endpoint` (`https://<store>.azconfig.io`),
/// authorized by Entra ID tokens for the endpoint's audience, or the
/// cloud's own `SERVICE_NAME` entry when the options set a cloud
/// (NewClient). An endpoint that is not a URL is an error, as Go's.
pub fn new_client[fx: Effects](net: Net, clock: Clock, rand: Rand, endpoint: Str, cred: azcore.TokenCredential[fx], options: ClientOptions[fx] = ClientOptions{}) -> Client ! Str {
  http.parse_url(endpoint) ?? e => return Err(e.msg)
  let audience = configured_audience(options) ?? audience_of(endpoint)
  Ok(client_with(net, clock, rand, endpoint, runtime.new_bearer_token_policy(cred, ["${audience}/.default"], clock), options))
}

/// A client signing each request with the connection string's HMAC key
/// (`Endpoint=...;Id=...;Secret=...`; NewClientFromConnectionString).
pub fn new_client_from_connection_string[fx: Effects](net: Net, clock: Clock, rand: Rand, connection_string: Str, options: ClientOptions[fx] = ClientOptions{}) -> Client ! Str {
  let cs = parse_connection_string(connection_string)?
  Ok(client_with(net, clock, rand, cs.endpoint, HmacPolicy{credential: cs.credential, secret: cs.secret, clock: clock}, options))
}

fn client_with[fx: Effects](net: Net, clock: Clock, rand: Rand, endpoint: Str, auth: policy.Policy[fx], options: ClientOptions[fx]) -> Client {
  let cache = new_sync_token_cache()
  let pl = runtime.new_pipeline(MODULE, VERSION, net, clock, rand, runtime.PipelineOptions{per_retry: [QueryNormalizationPolicy{}, auth, SyncTokenPolicy{cache: cache}, AudiencePolicy{configured: configured_audience(options).is_some()}]}, options.client)
  Client{gen: generated.new_client(pl, endpoint), cache: cache}
}

/// Adds sync tokens to the client's cache, so the next requests read at
/// least that state (SetSyncToken).
pub fn (c: Client) set_sync_token(token: SyncToken) -> () ! Str {
  c.cache.set(token)
}

// Settings.

/// A setting: a key, a label and a value, with their metadata.
pub struct Setting {
  pub key: Str? = None
  pub value: Str? = None
  pub label: Str? = None
  pub content_type: Str? = None
  pub description: Str? = None
  pub etag: Str? = None
  pub tags: Map[Str, Str]? = None
  pub last_modified: Time? = None
  pub is_read_only: Bool? = None
}

fn setting_of(kv: generated.KeyValue) -> Setting {
  Setting{key: kv.key, value: kv.value, label: kv.label, content_type: kv.content_type, description: kv.description, etag: kv.etag, tags: kv.tags, last_modified: kv.last_modified.map(fn(d: azcore.DateTime) -> Time { d.time }), is_read_only: kv.locked}
}

fn key_value_of(s: Setting) -> generated.KeyValue {
  generated.KeyValue{content_type: s.content_type, description: s.description, etag: s.etag, key: s.key, label: s.label, last_modified: s.last_modified.map(fn(t: Time) -> azcore.DateTime { azcore.utc_date_time(t) }), locked: s.is_read_only, tags: s.tags, value: s.value}
}

/// An ETag as Go's toGeneratedETagString sends it: in quotes, but `*`.
fn quoted_etag(etag: Str?) -> Str? {
  match etag {
    Some(e) => if e == "*" { Some(e) } else { Some("\"${e}\"") }
    None => None
  }
}

/// Go's time format for Accept-Datetime: RFC 3339 with the fraction it
/// needs, in UTC.
fn accept_time(t: Time?) -> Str? {
  // Go's Format keeps the time's zone; a Time here has none, so UTC
  t.map(fn(x: Time) -> Str { time.format(x, time.utc(), time.RFC3339) })
}

pub struct AddSettingOptions {
  pub content_type: Str? = None
  pub description: Str? = None
  pub label: Str? = None
  pub tags: Map[Str, Str]? = None
}

pub struct AddSettingResponse {
  pub setting: Setting
  pub sync_token: SyncToken = ""
}

/// Creates a setting that must not exist yet (If-None-Match `*`;
/// AddSetting).
pub fn (c: Client) add_setting(key: Str, value: Str?, options: AddSettingOptions = AddSettingOptions{}) -> AddSettingResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let s = Setting{key: Some(key), value: value, label: options.label, content_type: options.content_type, description: options.description, tags: options.tags}
  let r = c.gen.put_key_value(key, generated.PutKeyValueOptions{entity: Some(key_value_of(s)), if_none_match: quoted_etag(Some("*")), label: s.label})?
  Ok(AddSettingResponse{setting: setting_of(r.key_value), sync_token: r.sync_token ?? ""})
}

pub struct DeleteSettingOptions {
  pub label: Str? = None
  /// Delete only if the setting's ETag is this (If-Match).
  pub only_if_unchanged: Str? = None
}

pub struct DeleteSettingResponse {
  pub setting: Setting
  pub sync_token: SyncToken = ""
}

/// Deletes a setting (DeleteSetting).
pub fn (c: Client) delete_setting(key: Str, options: DeleteSettingOptions = DeleteSettingOptions{}) -> DeleteSettingResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let r = c.gen.delete_key_value(key, generated.DeleteKeyValueOptions{if_match: quoted_etag(options.only_if_unchanged), label: options.label})?
  Ok(DeleteSettingResponse{setting: setting_of(r.key_value), sync_token: r.sync_token ?? ""})
}

pub struct GetSettingOptions {
  /// The setting as it was at this time (Accept-Datetime).
  pub accept_date_time: Time? = None
  pub label: Str? = None
  /// Return it only if its ETag is not this (If-None-Match; a 304 is an
  /// error, as Go's).
  pub only_if_changed: Str? = None
}

pub struct GetSettingResponse {
  pub setting: Setting
  /// The setting's `last_modified`, as Go's.
  pub last_modified: Time? = None
  pub sync_token: SyncToken = ""
}

/// Gets a setting (GetSetting).
pub fn (c: Client) get_setting(key: Str, options: GetSettingOptions = GetSettingOptions{}) -> GetSettingResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let r = c.gen.get_key_value(key, generated.GetKeyValueOptions{accept_datetime: accept_time(options.accept_date_time), if_none_match: quoted_etag(options.only_if_changed), label: options.label})?
  let st = setting_of(r.key_value)
  Ok(GetSettingResponse{setting: st, last_modified: st.last_modified, sync_token: r.sync_token ?? ""})
}

pub struct SetReadOnlyOptions {
  pub label: Str? = None
  pub only_if_unchanged: Str? = None
}

pub struct SetReadOnlyResponse {
  pub setting: Setting
  pub sync_token: SyncToken = ""
}

/// Locks (`is_read_only` true) or unlocks a setting (SetReadOnly).
pub fn (c: Client) set_read_only(key: Str, is_read_only: Bool, options: SetReadOnlyOptions = SetReadOnlyOptions{}) -> SetReadOnlyResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  if is_read_only {
    let r = c.gen.put_lock(key, generated.PutLockOptions{if_match: quoted_etag(options.only_if_unchanged), label: options.label})?
    return Ok(SetReadOnlyResponse{setting: setting_of(r.key_value), sync_token: r.sync_token ?? ""})
  }
  let r = c.gen.delete_lock(key, generated.DeleteLockOptions{if_match: quoted_etag(options.only_if_unchanged), label: options.label})?
  Ok(SetReadOnlyResponse{setting: setting_of(r.key_value), sync_token: r.sync_token ?? ""})
}

pub struct SetSettingOptions {
  pub content_type: Str? = None
  pub description: Str? = None
  pub label: Str? = None
  pub tags: Map[Str, Str]? = None
  pub only_if_unchanged: Str? = None
}

pub struct SetSettingResponse {
  pub setting: Setting
  pub sync_token: SyncToken = ""
}

/// Creates or replaces a setting (SetSetting).
pub fn (c: Client) set_setting(key: Str, value: Str?, options: SetSettingOptions = SetSettingOptions{}) -> SetSettingResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let s = Setting{key: Some(key), value: value, label: options.label, content_type: options.content_type, description: options.description, tags: options.tags}
  let r = c.gen.put_key_value(key, generated.PutKeyValueOptions{entity: Some(key_value_of(s)), if_match: quoted_etag(options.only_if_unchanged), label: s.label})?
  Ok(SetSettingResponse{setting: setting_of(r.key_value), sync_token: r.sync_token ?? ""})
}

// Listing settings.

/// Which settings a list returns (Go's SettingSelector).
pub struct SettingSelector {
  /// Keys to match (`app/*`; https://aka.ms/azconfig/docs/keyvaluefiltering).
  pub key_filter: Str? = None
  /// Labels to match (`\0` for no label).
  pub label_filter: Str? = None
  /// Tags to match, each `name=value`.
  pub tags_filter: List[Str]? = None
  /// The settings as they were at this time. Go's list and revisions
  /// pagers send it as the `after` page token, not Accept-Datetime; so
  /// does this port, for the same requests (the check pager sends
  /// Accept-Datetime).
  pub accept_date_time: Time? = None
  /// The fields to return; none is all.
  pub fields: List[SettingFields]? = None
}

/// An If-Match and an If-None-Match ETag (azcore.MatchConditions).
pub type MatchConditions = generated.MatchConditions

pub struct ListSettingsOptions {
  /// One per page, in order: the page is fetched only if its ETag differs
  /// (a 304 page has no settings), as Go's.
  pub match_conditions: List[MatchConditions] = []
}

pub struct ListSettingsPageResponse {
  pub settings: List[Setting] = []
  pub etag: Str? = None
  pub sync_token: SyncToken = ""
}

/// Lists the settings the selector matches (NewListSettingsPager).
pub fn (c: Client) new_list_settings_pager(selector: SettingSelector, options: ListSettingsOptions = ListSettingsOptions{}) -> ListSettingsPager {
  let o = generated.GetKeyValuesOptions{after: accept_time(selector.accept_date_time), key: selector.key_filter, label: selector.label_filter, select_: Some(selector.fields ?? []), tags: selector.tags_filter}
  ListSettingsPager{inner: c.gen.new_get_key_values_pager_with_match_conditions(options.match_conditions, o)}
}

pub struct ListRevisionsOptions {}

pub struct ListRevisionsPageResponse {
  pub settings: List[Setting] = []
  pub sync_token: SyncToken = ""
}

/// Lists the revisions of the settings the selector matches
/// (NewListRevisionsPager).
pub fn (c: Client) new_list_revisions_pager(selector: SettingSelector, options: ListRevisionsOptions = ListRevisionsOptions{}) -> ListRevisionsPager {
  let o = generated.GetRevisionsOptions{after: accept_time(selector.accept_date_time), key: selector.key_filter, label: selector.label_filter, select_: Some(selector.fields ?? []), tags: selector.tags_filter}
  ListRevisionsPager{inner: c.gen.new_get_revisions_pager_with_next_links(o)}
}

pub struct CheckSettingsOptions {
  pub match_conditions: List[MatchConditions] = []
}

pub struct CheckSettingsPageResponse {
  pub etag: Str? = None
  pub sync_token: SyncToken = ""
}

/// HEADs the pages of the settings the selector matches: each page's
/// ETag and sync token without its settings (NewCheckSettingsPager).
pub fn (c: Client) new_check_settings_pager(selector: SettingSelector, options: CheckSettingsOptions = CheckSettingsOptions{}) -> CheckSettingsPager {
  let o = generated.CheckKeyValuesOptions{accept_datetime: accept_time(selector.accept_date_time), key: selector.key_filter, label: selector.label_filter, select_: Some(selector.fields ?? []), tags: selector.tags_filter}
  CheckSettingsPager{inner: c.gen.new_check_key_values_pager_with_match_conditions(options.match_conditions, o)}
}

// Snapshots.

/// A key and label filter of a snapshot (Go's SettingFilter).
pub struct SettingFilter {
  pub key_filter: Str? = None
  pub label_filter: Str? = None
}

/// A snapshot: the settings that matched its filters when it was made.
pub struct Snapshot {
  pub filters: List[SettingFilter] = []
  pub composition_type: CompositionType? = None
  pub description: Str? = None
  pub retention_period: Int? = None
  pub tags: Map[Str, Str]? = None
  pub created: Time? = None
  pub etag: Str? = None
  pub expires: Time? = None
  pub items_count: Int? = None
  pub name: Str? = None
  pub size: Int? = None
  pub status: SnapshotStatus? = None
}

fn snapshot_of(s: generated.Snapshot) -> Snapshot {
  Snapshot{
    filters: (s.filters ?? []).map(fn(f: generated.KeyValueFilter) -> SettingFilter { SettingFilter{key_filter: f.key, label_filter: f.label} }),
    composition_type: s.composition_type, description: s.description, retention_period: s.retention_period, tags: s.tags,
    created: s.created.map(fn(d: azcore.DateTime) -> Time { d.time }), etag: s.etag, expires: s.expires.map(fn(d: azcore.DateTime) -> Time { d.time }),
    items_count: s.items_count, name: s.name, size: s.size, status: s.status,
  }
}

pub struct ListSnapshotsOptions {
  pub after: Str? = None
  pub name: Str? = None
  pub select_: List[SnapshotFields]? = None
  pub status: List[SnapshotStatus]? = None
}

pub struct ListSnapshotsResponse {
  pub snapshots: List[Snapshot] = []
  pub sync_token: SyncToken = ""
}

