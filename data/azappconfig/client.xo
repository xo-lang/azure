pub const SETTING_FIELDS_IS_READ_ONLY: SettingFields = generated.SETTING_FIELDS_LOCKED
pub const SETTING_FIELDS_TAGS: SettingFields = generated.SETTING_FIELDS_TAGS

/// Every SettingFields value, in Go's order (AllSettingFields).
pub fn all_setting_fields() -> List[SettingFields] {
  [SETTING_FIELDS_KEY, SETTING_FIELDS_LABEL, SETTING_FIELDS_VALUE, SETTING_FIELDS_CONTENT_TYPE, SETTING_FIELDS_DESCRIPTION, SETTING_FIELDS_ETAG, SETTING_FIELDS_LAST_MODIFIED, SETTING_FIELDS_IS_READ_ONLY, SETTING_FIELDS_TAGS]
}

