/// The key of this service in `cloud.Configuration.services` (Go's
/// ServiceName).
pub const SERVICE_NAME: Str = "data/azappconfig"

const APP_CONFIG_STAGING_DOMAIN: Str = "appconfig-staging.azure.com"
const DEFAULT_AUDIENCE: Str = "https://appconfig.azure.com"

/// The token audience of each Azure cloud, as Go's cloud_config.go adds
/// them to azcore's clouds.
fn builtin_audience(c: cloud.Configuration) -> Str? {
  if c == cloud.AZURE_PUBLIC {
    Some("https://appconfig.azure.com")
  } else if c == cloud.AZURE_CHINA {
    Some("https://appconfig.azure.cn")
  } else if c == cloud.AZURE_GOVERNMENT {
    Some("https://appconfig.azure.us")
  } else {
    None
  }
}

