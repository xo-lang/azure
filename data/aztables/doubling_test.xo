// A policy at the bottom of the pipeline that repeats each response
// header field: the first field as the fake answered it, then "zz" (the
// same value for Content-Length, as Go's transport refuses two lengths).
// The vector tests rerun with it, as the Go programs print the same
// output when their fakes answer this way.

use std/http
use github.com/xo-lang/azure/policy

struct Doubling {}

fn (p: Doubling) send(req: policy.Request, next: policy.Next) -> http.Response ! policy.SendErr uses (net.dial, clock, rand) {
  let r = next.send(req)?
  var x = r
  for (k, v) in r.headers {
    x = x.add_header(k, if k.to_lower() == "content-length" { v } else { "zz" })
  }
  Ok(x)
}
