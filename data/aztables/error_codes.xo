use github.com/xo-lang/azure/azcore

pub const DUPLICATE_PROPERTIES_SPECIFIED: Str = "DuplicatePropertiesSpecified"
pub const ENTITY_ALREADY_EXISTS: Str = "EntityAlreadyExists"
pub const ENTITY_NOT_FOUND: Str = "EntityNotFound"
pub const ENTITY_TOO_LARGE: Str = "EntityTooLarge"
pub const HOST_INFORMATION_NOT_PRESENT: Str = "HostInformationNotPresent"
pub const INVALID_DUPLICATE_ROW: Str = "InvalidDuplicateRow"
pub const INVALID_INPUT: Str = "InvalidInput"
pub const INVALID_VALUE_TYPE: Str = "InvalidValueType"
pub const INVALID_XML_DOCUMENT: Str = "InvalidXmlDocument"
pub const JSON_FORMAT_NOT_SUPPORTED: Str = "JsonFormatNotSupported"
pub const METHOD_NOT_ALLOWED: Str = "MethodNotAllowed"
pub const NOT_IMPLEMENTED: Str = "NotImplemented"
pub const OUT_OF_RANGE_INPUT: Str = "OutOfRangeInput"
pub const PROPERTIES_NEED_VALUE: Str = "PropertiesNeedValue"
pub const PROPERTY_NAME_INVALID: Str = "PropertyNameInvalid"
pub const PROPERTY_NAME_TOO_LONG: Str = "PropertyNameTooLong"
pub const PROPERTY_VALUE_TOO_LARGE: Str = "PropertyValueTooLarge"
pub const RESOURCE_NOT_FOUND: Str = "ResourceNotFound"
pub const TABLE_ALREADY_EXISTS: Str = "TableAlreadyExists"
pub const TABLE_BEING_DELETED: Str = "TableBeingDeleted"
pub const TABLE_NOT_FOUND: Str = "TableNotFound"
pub const TOO_MANY_PROPERTIES: Str = "TooManyProperties"
pub const UPDATE_CONDITION_NOT_SATISFIED: Str = "UpdateConditionNotSatisfied"
pub const X_METHOD_INCORRECT_COUNT: Str = "XMethodIncorrectCount"
pub const X_METHOD_INCORRECT_VALUE: Str = "XMethodIncorrectValue"
pub const X_METHOD_NOT_USING_POST: Str = "XMethodNotUsingPost"

/// Whether `err` is a response whose error code is one of `codes`.
pub fn has_error_code(err: azcore.CallErr, codes: List[Str]) -> Bool {
  match err {
    Response(r) => codes.contains(r.error_code)
    _ => false
  }
}
