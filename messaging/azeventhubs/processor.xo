// The Processor, as azeventhubs's Processor, its load balancer and
// ProcessorPartitionClient (processor.go, processor_load_balancer.go,
// processor_partition_client.go) (MIT, Copyright (c) Microsoft
// Corporation; NOTICE.md). It claims partitions in a CheckpointStore,
// balancing them among the Processors of a consumer group, and hands out
// a partition client for each partition it gets, starting from the
// partition's checkpoint.

/// How a Processor takes partitions.
pub type ProcessorStrategy = Str

/// One partition per update until each Processor has its share.
pub const PROCESSOR_STRATEGY_BALANCED: ProcessorStrategy = "balanced"
/// Its whole share at once.
pub const PROCESSOR_STRATEGY_GREEDY: ProcessorStrategy = "greedy"

/// Where partitions start when they have no checkpoint.
pub struct StartPositions {
  pub per_partition: Map[Str, StartPosition] = {}
  pub default: StartPosition = StartPosition{}
}

pub struct ProcessorOptions {
  /// "" for PROCESSOR_STRATEGY_BALANCED.
  pub load_balancing_strategy: ProcessorStrategy = ""
  /// How often ownership is renewed and rebalanced; 0 for 10 s.
  pub update_interval: Duration = 0s
  /// How long an ownership holds without renewal; 0 for 1 minute.
  pub partition_expiration_duration: Duration = 0s
  pub start_positions: StartPositions = StartPositions{}
  /// The partition clients' prefetch (PartitionClientOptions.prefetch).
  pub prefetch: Int = 0
}

/// The consumer client's identity in the store, Go's consumerClientDetails.
struct Details {
  fully_qualified_namespace: Str
  consumer_group: Str
  event_hub_name: Str
  client_id: Str
}

/// The owner id of a given up ownership.
const RELINQUISHED_OWNERSHIP_ID: Str = ""

/// What the store says about the partitions, Go's loadBalancerInfo.
struct LoadBalancerInfo {
  current: List[Ownership]
  unowned_or_expired: List[Ownership]
  above_max: List[Ownership]
  claim_more_partitions: Bool
  max_allowed: Int
}

struct LoadBalancer {
  store: CheckpointStore
  details: Details
  strategy: ProcessorStrategy
  expiration: Duration
  clock: Clock
  rand: Rand
}

/// Go's getAvailablePartitions: the ownerships grouped by owner, which
/// are free (unowned, given up or expired), and how many this Processor
/// may hold (the share, plus one when the partitions do not divide
/// evenly and it already has its share).
fn (lb: LoadBalancer) available(partition_ids: List[Str]) -> LoadBalancerInfo ! EventHubsErr uses (net.dial, clock, rand) {
  let d = lb.details
  let ownerships = lb.store.list_ownership(d.fully_qualified_namespace, d.event_hub_name, d.consumer_group, ListOwnershipOptions{})?
  let now = lb.clock.now().unix_millis()
  var added: Map[Str, Bool] = {}
  var by_owner: Map[Str, List[Ownership]] = {d.client_id: []}
  var free: List[Ownership] = []
  for o in ownerships {
    added[o.partition_id] = true
    let modified = o.last_modified_time.map(fn(t: Time) -> Int { t.unix_millis() }) ?? 0
    if now - modified > lb.expiration.millis() || o.owner_id == RELINQUISHED_OWNERSHIP_ID {
      free.push(o)
      continue
    }
    var mine = by_owner.get(o.owner_id) ?? []
    mine.push(o)
    by_owner[o.owner_id] = mine
  }
  for id in partition_ids {
    if added.get(id).is_some() {
      continue
    }
    free.push(Ownership{fully_qualified_namespace: d.fully_qualified_namespace, consumer_group: d.consumer_group, event_hub_name: d.event_hub_name, partition_id: id, owner_id: d.client_id})
  }
  let owners = by_owner.len()
  let current = by_owner.get(d.client_id) ?? []
  let min_required = partition_ids.len() / owners
  let extra = partition_ids.len() % owners > 0
  let max_allowed = if extra && current.len() >= min_required { min_required + 1 } else { min_required }
  var above: List[Ownership] = []
  for (id, os) in by_owner {
    if id != d.client_id && os.len() > max_allowed {
      above = above + os
    }
  }
  let claim_more = if current.len() >= max_allowed {
    false
  } else if extra && current.len() == max_allowed - 1 {
    !free.is_empty() || !above.is_empty()
  } else {
    true
  }
  Ok(LoadBalancerInfo{current: current, unowned_or_expired: free, above_max: above, claim_more_partitions: claim_more, max_allowed: max_allowed})
}

/// Go's getRandomOwnerships: up to `count` of `os`. Go draws
/// rnd.Perm(limit), a permutation of the first `limit` indexes, so it
/// always takes the first `limit` ownerships; so does this.
fn first_ownerships(os: List[Ownership], count: Int) -> List[Ownership] {
  let limit = if count < os.len() { count } else { os.len() }
  if limit <= 0 { [] } else { os[0..limit] }
}

/// Claims this Processor's ownerships (renewing those it has) and
/// returns what the store granted, Go's LoadBalance.
fn (lb: LoadBalancer) load_balance(partition_ids: List[Str]) -> List[Ownership] ! EventHubsErr uses (net.dial, clock, rand) {
  let info = lb.available(partition_ids)?
  let me = lb.details.client_id
  var ours = info.current
  if info.claim_more_partitions {
    if lb.strategy == PROCESSOR_STRATEGY_GREEDY {
      ours = ours + first_ownerships(info.unowned_or_expired, info.max_allowed - ours.len())
      if ours.len() < info.max_allowed {
        ours = ours + first_ownerships(info.above_max, info.max_allowed - ours.len())
      }
      ours = ours.map(fn(o: Ownership) -> Ownership { o with {owner_id: me} })
    } else if !info.unowned_or_expired.is_empty() {
      let o = info.unowned_or_expired[lb.rand.int(0, info.unowned_or_expired.len())]
      ours.push(o with {owner_id: me})
    } else if !info.above_max.is_empty() {
      let o = info.above_max[lb.rand.int(0, info.above_max.len())]
      ours.push(o with {owner_id: me})
    }
  }
  lb.store.claim_ownership(ours, ClaimOwnershipOptions{})
}

/// A partition client the Processor handed out, with its checkpointing.
pub struct ProcessorPartitionClient {
  pid: Str
  inner: PartitionClient
  store: CheckpointStore
  details: Details
  consumers: Mutex[Map[Str, Bool]]
}

pub fn (c: ProcessorPartitionClient) receive_events(count: Int, options: ReceiveEventsOptions = ReceiveEventsOptions{}) -> List[ReceivedEventData] ! EventHubsErr uses (net.dial, clock, rand) {
  c.inner.receive_events(count, options)
}

pub struct UpdateCheckpointOptions {}

/// Records `latest_event` as processed: the partition restarts after it.
pub fn (c: ProcessorPartitionClient) update_checkpoint(latest_event: ReceivedEventData, options: UpdateCheckpointOptions = UpdateCheckpointOptions{}) -> () ! EventHubsErr uses (net.dial, clock, rand) {
  c.store.set_checkpoint(Checkpoint{
    consumer_group: c.details.consumer_group, event_hub_name: c.details.event_hub_name,
    fully_qualified_namespace: c.details.fully_qualified_namespace, partition_id: c.pid,
    sequence_number: Some(latest_event.sequence_number), offset: Some(latest_event.offset),
  }, SetCheckpointOptions{})
}

pub fn (c: ProcessorPartitionClient) partition_id() -> Str {
  c.pid
}

/// Closes the link; the Processor hands the partition out again on a
/// later update if it still owns it.
pub fn (c: ProcessorPartitionClient) close() -> () ! EventHubsErr uses (net.dial, clock) {
  let id = c.pid
  c.consumers.with(fn(var m: Map[Str, Bool]) { m.remove(id) })
  c.inner.close()
}

const STATE_NONE: Int = 0
const STATE_STOPPED: Int = 1
const STATE_RUNNING: Int = 2

pub struct Processor {
  cc: ConsumerClient
  store: CheckpointStore
  update_interval: Duration
  start_positions: StartPositions
  prefetch: Int
  details: Details
  lb: LoadBalancer
  state: Mutex[Int]
  /// The partition clients ready to hand out, sized to the partitions
  /// once run has read them.
  next: Mutex[Chan[ProcessorPartitionClient]?]
  /// Closed when `next` is made (or the Processor stops first).
  ready: Chan[()]
  ready_closed: Atomic[Bool]
  /// The partitions with a partition client out.
  consumers: Mutex[Map[Str, Bool]]
  /// The clients out, to close when run ends.
  clients: Mutex[List[ProcessorPartitionClient]]
  current: Mutex[List[Ownership]]
}

/// A Processor for the consumer client's hub and group, owning
/// partitions in `checkpoint_store` as the client's instance id.
pub fn new_processor(consumer_client: ConsumerClient, checkpoint_store: CheckpointStore, options: ProcessorOptions = ProcessorOptions{}) -> Processor ! EventHubsErr {
  let strategy = match options.load_balancing_strategy {
    "" => PROCESSOR_STRATEGY_BALANCED
    "balanced" | "greedy" => options.load_balancing_strategy
    other => return Err(fatal("invalid load balancing strategy '${other}'"))
  }
  let cc = consumer_client
  let details = Details{fully_qualified_namespace: cc.ns.fqdn, consumer_group: cc.consumer_group, event_hub_name: cc.event_hub, client_id: cc.id}
  let expiration = if options.partition_expiration_duration == 0s { 60s } else { options.partition_expiration_duration }
  Ok(Processor{
    cc: cc, store: checkpoint_store, update_interval: if options.update_interval == 0s { 10s } else { options.update_interval },
    start_positions: options.start_positions, prefetch: options.prefetch, details: details,
    lb: LoadBalancer{store: checkpoint_store, details: details, strategy: strategy, expiration: expiration, clock: cc.ns.clock, rand: cc.ns.rand},
    state: Mutex[Int].new(STATE_NONE), next: Mutex[Chan[ProcessorPartitionClient]?].new(None), ready: Chan[()].new(),
    ready_closed: Atomic[Bool].new(false), consumers: Mutex[Map[Str, Bool]].new({}),
    clients: Mutex[List[ProcessorPartitionClient]].new([]), current: Mutex[List[Ownership]].new([]),
  })
}

/// The next partition client, once run has one; None when the Processor
/// stopped. Cancel the calling task to stop waiting (Go's context).
pub fn (p: Processor) next_partition_client() -> ProcessorPartitionClient? {
  let _ = p.ready.recv()
  let ch = p.next.with_read(fn(c: Chan[ProcessorPartitionClient]?) -> Chan[ProcessorPartitionClient]? { c }) ?? return None
  ch.recv()
}

fn (p: Processor) close_ready() {
  if !p.ready_closed.swap(true) {
    p.ready.close()
  }
}

/// Claims and balances partitions every update interval (with Go's
/// jitter of 0.8 to 1.3 times) and hands out a partition client for each
/// new one, until the calling task is cancelled; then it closes the
/// clients and gives its partitions up. Run once per Processor.
pub fn (p: Processor) run() -> () ! EventHubsErr uses (net.dial, clock, rand) {
  let err = p.state.with(fn(var s: Int) -> Str? {
    match s {
      STATE_NONE => {
        s = STATE_RUNNING
        None
      }
      STATE_RUNNING => Some("the Processor is currently running. Concurrent calls to Run() are not allowed.")
      _ => Some("the Processor has been stopped. Create a new instance to start processing again")
    }
  })
  if let Some(m) = err {
    return Err(fatal(m))
  }
  defer {
    p.shutdown()
  }
  let props = p.cc.get_event_hub_properties()?
  p.next.with(fn(var c: Chan[ProcessorPartitionClient]?) { c = Some(Chan[ProcessorPartitionClient].new(cap: props.partition_ids.len())) })
  p.close_ready()
  let clock = p.cc.ns.clock
  let rand = p.cc.ns.rand
  while {
    p.dispatch(props.partition_ids)?
    clock.sleep(p.update_interval.scale(rand.float() / 2.0 + 0.8))
  }
}

/// One load balancing round: claim, then a partition client for each
/// owned partition that has none out. A partition whose client cannot be
/// made is skipped this round, as Go's.
fn (p: Processor) dispatch(partition_ids: List[Str]) -> () ! EventHubsErr uses (net.dial, clock, rand) {
  let owned = p.lb.load_balance(partition_ids)?
  p.current.with(fn(var c: List[Ownership]) { c = owned })
  var checkpoints: Map[Str, Checkpoint]? = None
  for o in owned {
    let id = o.partition_id
    let fresh = p.consumers.with(fn(var m: Map[Str, Bool]) -> Bool {
      if m.get(id).is_some() {
        return false
      }
      m[id] = true
      true
    })
    if !fresh {
      continue
    }
    if checkpoints.is_none() {
      let d = p.details
      var m: Map[Str, Checkpoint] = {}
      for cp in p.store.list_checkpoints(d.fully_qualified_namespace, d.event_hub_name, d.consumer_group, ListCheckpointsOptions{})? {
        m[cp.partition_id] = cp
      }
      checkpoints = Some(m)
    }
    match p.add_partition_client(id, checkpoints ?? {}) {
      Ok(_) => {}
      Err(_) => p.consumers.with(fn(var m: Map[Str, Bool]) { m.remove(id) })
    }
  }
  Ok(())
}

/// Where a partition starts, Go's getStartPosition: after its checkpoint
/// (offset first), else its own or the default start position.
fn (p: Processor) start_position(id: Str, checkpoints: Map[Str, Checkpoint]) -> StartPosition ! EventHubsErr {
  match checkpoints.get(id) {
    Some(cp) => {
      if let Some(off) = cp.offset {
        return Ok(StartPosition{offset: Some(off)})
      }
      if let Some(n) = cp.sequence_number {
        return Ok(StartPosition{sequence_number: Some(n)})
      }
      Err(fatal("invalid checkpoint for ${id}, no offset or sequence number"))
    }
    None => Ok(p.start_positions.per_partition.get(id) ?? p.start_positions.default)
  }
}

fn (p: Processor) add_partition_client(id: Str, checkpoints: Map[Str, Checkpoint]) -> () ! EventHubsErr uses (net.dial, clock, rand) {
  let start = p.start_position(id, checkpoints)?
  let part = open_with_geo_fallback(start, fn(sp: StartPosition) -> PartitionClient ! EventHubsErr uses (net.dial, clock, rand) { p.open_partition_client(id, sp) })?
  let client = ProcessorPartitionClient{pid: id, inner: part, store: p.store, details: p.details, consumers: p.consumers}
  let ch = p.next.with_read(fn(c: Chan[ProcessorPartitionClient]?) -> Chan[ProcessorPartitionClient]? { c }) ?? return Err(fatal("the Processor is not running"))
  if !ch.try_send(client) {
    client.close() ?? _ => {}
    return Err(fatal("partitions channel full, consumer for partition ${id} could not be returned"))
  }
  p.clients.with(fn(var cs: List[ProcessorPartitionClient]) { cs.push(client) })
  Ok(())
}

/// `open(start)`, and when a geo-replicated hub refuses the start's
/// numeric offset, `open` again from the earliest event, inclusive (Go
/// v2's addPartitionClient).
fn open_with_geo_fallback[T](start: StartPosition, open: fn(StartPosition) -> T ! EventHubsErr uses (net.dial, clock, rand)) -> T ! EventHubsErr uses (net.dial, clock, rand) {
  match open(start) {
    Ok(v) => Ok(v)
    Err(e) if is_geo_replication_offset_error(e) => open(StartPosition{earliest: true, inclusive: true})
    Err(e) => Err(e)
  }
}

/// A partition client with its link open now (Go's
/// openPartitionClientImpl), so a stolen partition is claimed at once.
fn (p: Processor) open_partition_client(id: Str, start: StartPosition) -> PartitionClient ! EventHubsErr uses (net.dial, clock, rand) {
  // Owner level 0, as Go's processorOwnerLevel.
  let part = p.cc.new_partition_client(id, PartitionClientOptions{start_position: start, owner_level: Some(0), prefetch: p.prefetch})?
  part.init() ?? e => {
    part.close() ?? _ => {}
    return Err(e)
  }
  Ok(part)
}

/// Go's Processor.close: the clients closed, the ownerships given up,
/// the Processor stopped and the channel of clients closed.
fn (p: Processor) shutdown() uses (net.dial, clock, rand) {
  let cs = p.clients.with(fn(var cs: List[ProcessorPartitionClient]) -> List[ProcessorPartitionClient] {
    let was = cs
    cs = []
    was
  })
  for c in cs {
    c.close() ?? _ => {}
  }
  let mine = p.current.with_read(fn(c: List[Ownership]) -> List[Ownership] { c })
  let given_up = mine.map(fn(o: Ownership) -> Ownership { o with {owner_id: RELINQUISHED_OWNERSHIP_ID} })
  p.store.claim_ownership(given_up, ClaimOwnershipOptions{}) ?? _ => []
  p.state.with(fn(var s: Int) { s = STATE_STOPPED })
  p.next.with_read(fn(c: Chan[ProcessorPartitionClient]?) {
    if let Some(ch) = c {
      ch.close()
    }
  })
  p.close_ready()
}
