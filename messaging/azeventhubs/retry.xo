// Retries and recovery, as azeventhubs's RetryOptions
// (internal/exported), utils.Retry and calcDelay (internal/utils), and
// GetRecoveryKind (internal/errors.go) (MIT, Copyright (c) Microsoft
// Corporation; NOTICE.md).

/// How operations are retried. Zero values take Go's defaults: 3
/// retries, a 4 s first delay, at most 120 s; a negative max_retries is
/// no retries, a negative delay none, a negative max_retry_delay no cap.
pub struct RetryOptions {
  pub max_retries: Int = 0
  pub retry_delay: Duration = 0s
  pub max_retry_delay: Duration = 0s
}

/// What a failure needs before the operation can run again.
pub enum RecoveryKind {
  /// Nothing: retry as it is (server busy, a timeout).
  None
  /// A new link (a forced detach).
  Link
  /// A new connection and new links (a dropped connection).
  Conn
  /// Retrying cannot help (not found, unauthorized, ownership lost).
  Fatal
}

/// Go's setDefaults.
fn defaults(o: RetryOptions) -> RetryOptions {
  RetryOptions{
    max_retries: if o.max_retries == 0 { 3 } else if o.max_retries < 0 { 0 } else { o.max_retries },
    retry_delay: if o.retry_delay == 0s { 4s } else if o.retry_delay < 0s { 0s } else { o.retry_delay },
    max_retry_delay: if o.max_retry_delay == 0s { 120s } else if o.max_retry_delay < 0s { Duration.from_secs_int(9000000000) } else { o.max_retry_delay },
  }
}

/// The delay before try `n` (1 for the first retry): (2^n - 1) times
/// the delay, times a jitter in [0.8, 1.3), capped, as Go's calcDelay.
pub fn retry_delay(o: RetryOptions, n: Int, jitter: Float) -> Duration {
  let ro = defaults(o)
  let factor = if n < 40 { (1 << n) - 1 } else { 1 << 40 }
  let d = ro.retry_delay.scale(Float(factor) * (jitter / 2.0 + 0.8))
  if d > ro.max_retry_delay { ro.max_retry_delay } else { d }
}

/// The recovery an AMQP error condition needs, Go's
/// amqpConditionsToRecoveryKind; None for a condition it does not list.
fn recovery_of_condition(condition: Str) -> RecoveryKind? {
  match condition {
    "com.microsoft:server-busy" | "com.microsoft:timeout" | "com.microsoft:operation-cancelled" => Some(RecoveryKind.None)
    "amqp:link:detach-forced" | "amqp:link:transfer-limit-exceeded" => Some(RecoveryKind.Link)
    "amqp:connection:forced" | "amqp:internal-error" => Some(RecoveryKind.Conn)
    // A stolen link (a receiver with a higher epoch took the partition)
    // is checked first in Go (IsOwnershipLostError).
    "amqp:link:stolen" | "amqp:resource-limit-exceeded" | "amqp:link:message-size-exceeded" | "amqp:unauthorized-access" | "amqp:not-found" | "amqp:not-allowed" | "com.microsoft:entity-disabled" | "com.microsoft:session-cannot-be-locked" | "com.microsoft:argument-out-of-range" | "com.microsoft:message-lock-lost" | "com.microsoft:georeplication:invalid-offset" => Some(RecoveryKind.Fatal)
    _ => None
  }
}

/// The recovery a management reply's status needs (Go's RPCError
/// cases): 404 and 401 are fatal, 408, 503 and 500 are
/// retried as they are, anything else resets the connection.
fn recovery_of_status(code: Int) -> RecoveryKind {
  match code {
    404 | 401 => RecoveryKind.Fatal
    408 | 503 | 500 => RecoveryKind.None
    _ => RecoveryKind.Conn
  }
}

/// Runs `f` with up to `max_retries` retries: before each retry it
/// sleeps the backoff and does the recovery the last error asked for
/// (`recover`). A fatal error is returned at once. A link error on the
/// first try gets one quick retry that does not count, as Go's
/// AMQPLinksImpl.Retry ("the link was previously detached").
fn (c: Namespace) retry[T](o: RetryOptions, f: fn(Int) -> T ! EventHubsErr uses (net.dial, clock, rand), recover: fn(RecoveryKind) uses (net.dial, clock)) -> T ! EventHubsErr uses (net.dial, clock, rand) {
  let ro = defaults(o)
  var i = 0
  var quick = false
  var last: EventHubsErr? = None
  while i <= ro.max_retries {
    if let Some(e) = last {
      recover(e.recovery)
      if i > 0 {
        c.clock.sleep(retry_delay(o, i, c.rand.float()))
      }
    }
    match f(i) {
      Ok(v) => return Ok(v)
      Err(e) => {
        if e.recovery == RecoveryKind.Fatal {
          return Err(e)
        }
        if i == 0 && !quick && e.recovery == RecoveryKind.Link {
          quick = true
          last = Some(e)
          continue
        }
        last = Some(e)
      }
    }
    i += 1
  }
  Err(last ?? EventHubsErr{msg: "no attempt ran"})
}
