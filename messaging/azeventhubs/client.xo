// The namespace connection the producer and consumer clients share the
// shape of, as azeventhubs's internal Namespace, its connection string
// parser (internal/exported) and SAS signer (internal/sas) (MIT,
// Copyright (c) Microsoft Corporation; NOTICE.md). One AMQP connection
// and session per client, opened on first use; each link's entity is
// authorized with a CBS put-token first, as Go's NegotiateClaim.

use std/amqp
use std/base64
use std/crypto
use std/url
use github.com/xo-lang/azure/azcore

pub const VERSION: Str = "v0.1.0"

/// The parts of a connection string (`Endpoint=sb://...;SharedAccessKeyName=...`).
pub struct ConnectionStringProperties {
  pub endpoint: Str = ""
  pub fully_qualified_namespace: Str = ""
  pub entity_path: Str? = None
  pub shared_access_key_name: Str? = None
  pub shared_access_key: Secret[Str]? = None
  pub shared_access_signature: Secret[Str]? = None
  /// `UseDevelopmentEmulator=true`: plain `amqp://` without TLS, and the
  /// endpoint may carry a port (`sb://localhost:5672`).
  pub emulator: Bool = false
}

/// Parses a connection string as Go's ParseConnectionString: keys are
/// case-insensitive, unknown keys are ignored, and it needs an endpoint
/// and either a key name with a key or a signature.
pub fn parse_connection_string(s: Str) -> ConnectionStringProperties ! Str {
  var p = ConnectionStringProperties{}
  for part in s.split(";") {
    if part == "" {
      continue
    }
    let i = part.find("=") ?? return Err("failed parsing connection string due to unmatched key value separated by '='")
    let key = part[0..i].to_lower()
    let value = part[i + 1..part.len()]
    if key == "endpoint" {
      // Go's url.Parse(value).Host: what follows `scheme://`, up to a `/`.
      let i = value.find("://") ?? return Err("failed parsing connection string due to an incorrectly formatted Endpoint value")
      let rest = value[i + 3..value.len()]
      p.endpoint = value
      p.fully_qualified_namespace = match rest.find("/") {
        Some(j) => rest[0..j]
        None => rest
      }
    } else if key == "sharedaccesskeyname" {
      p.shared_access_key_name = Some(value)
    } else if key == "sharedaccesskey" {
      p.shared_access_key = Some(Secret.new(value))
    } else if key == "entitypath" {
      p.entity_path = Some(value)
    } else if key == "sharedaccesssignature" {
      p.shared_access_signature = Some(Secret.new(value))
    } else if key == "usedevelopmentemulator" {
      p.emulator = match value.to_lower() {
        "true" | "1" | "t" => true
        "false" | "0" | "f" => false
        _ => return Err("strconv.ParseBool: parsing \"${value}\": invalid syntax")
      }
    }
  }
  if p.emulator && !p.endpoint.starts_with("sb://") {
    return Err("UseDevelopmentEmulator=true can only be used with sb://<emulator hostname> or sb://<emulator hostname>:<port number>, not ${p.endpoint}")
  }
  if p.fully_qualified_namespace == "" {
    return Err("key \"Endpoint\" must not be empty")
  }
  if p.shared_access_signature.is_none() && p.shared_access_key_name.is_none() {
    return Err("key \"SharedAccessKeyName\" must not be empty")
  }
  if p.shared_access_key.is_none() && p.shared_access_signature.is_none() {
    return Err("key \"SharedAccessKey\" or \"SharedAccessSignature\" cannot both be empty")
  }
  Ok(p)
}

/// The event hub a connection string names, as Go's parseConn: its
/// EntityPath or `event_hub`, exactly one of them.
fn event_hub_of(p: ConnectionStringProperties, event_hub: Str) -> Str ! Str {
  match p.entity_path {
    None => if event_hub == "" {
      Err("connection string does not contain an EntityPath. eventHub cannot be an empty string")
    } else {
      Ok(event_hub)
    }
    Some(path) => if event_hub != "" {
      Err("connection string contains an EntityPath. eventHub must be an empty string")
    } else {
      Ok(path)
    }
  }
}

/// A SAS token for `uri` signed with the key, expiring at `expiry` (Unix
/// seconds): `SharedAccessSignature sr=...&sig=...&se=...&skn=...`, as
/// Go's Signer.SignWithExpiry.
pub fn sign_sas(key_name: Str, key: Secret[Str], uri: Str, expiry: Int) -> Str {
  let audience = url.query_escape(uri).to_lower()
  let sig = url.query_escape(base64.encode(crypto.hmac_sha256(key.reveal().bytes(), "${audience}\n${expiry}".bytes())))
  "SharedAccessSignature sr=${audience}&sig=${sig}&se=${expiry}&skn=${key_name}"
}

/// How the client authorizes its links.
enum Auth {
  /// A key: a SAS token per entity, valid for two hours.
  Key(name: Str, key: Secret[Str])
  /// A ready signature from the connection string, sent as it is.
  Signature(sig: Secret[Str])
  /// Entra ID tokens for `https://eventhubs.azure.net//.default`.
  Credential(c: azcore.TokenCredential)
}

/// A CBS token: the token, its type, and its expiry as Go's auth.Token
/// keeps it, a string of Unix seconds ("0" for a ready signature).
struct Token {
  token: Str
  kind: Str
  expiry: Str
}

/// The open connection and which one it is: links made on an earlier
/// connection are attached again.
struct Conn {
  c: amqp.Connection
  s: amqp.Session
  gen: Int
}

/// The connection to a namespace and how it authorizes, Go's Namespace.
struct Namespace {
  net: Net
  clock: Clock
  rand: Rand
  fqdn: Str
  tls: Bool
  auth: Auth
  application_id: Str
  timeout_ms: Int
  /// The address dialed instead of the namespace (a TCP proxy), as Go's
  /// CustomEndpoint; the Open's hostname and the audiences keep the
  /// namespace.
  custom_endpoint: Str = ""
  conn: Mutex[Conn?]
  links: Atomic[Int]
  gens: Atomic[Int]
  closed: Atomic[Bool]
}

fn namespace(net: Net, clock: Clock, rand: Rand, fqdn: Str, tls: Bool, auth: Auth, application_id: Str, timeout_ms: Int) -> Namespace {
  Namespace{net: net, clock: clock, rand: rand, fqdn: fqdn, tls: tls, auth: auth, application_id: application_id, timeout_ms: timeout_ms, conn: Mutex[Conn?].new(None), links: Atomic[Int].new(0), gens: Atomic[Int].new(0), closed: Atomic[Bool].new(false)}
}

/// The namespace of a connection string and the event hub it names.
fn namespace_from_connection_string(net: Net, clock: Clock, rand: Rand, connection_string: Str, event_hub: Str, application_id: Str, timeout_ms: Int) -> (Namespace, Str) ! Str {
  let p = parse_connection_string(connection_string)?
  let hub = event_hub_of(p, event_hub)?
  let auth = match (p.shared_access_signature, p.shared_access_key_name, p.shared_access_key) {
    (Some(sig), _, _) => Auth.Signature(sig)
    (None, Some(n), Some(k)) => Auth.Key(name: n, key: k)
    _ => return Err("key \"SharedAccessKey\" or \"SharedAccessSignature\" cannot both be empty")
  }
  Ok((namespace(net, clock, rand, p.fully_qualified_namespace, !p.emulator, auth, application_id, timeout_ms), hub))
}

/// The CBS audience of an entity: `amqps://<namespace>/<entity>`, Go's
/// GetEntityAudience.
fn (ns: Namespace) audience(entity: Str) -> Str {
  "${if ns.tls { "amqps" } else { "amqp" }}://${ns.fqdn}/${entity}"
}

/// The connection, opened on first use and after a reset.
fn (ns: Namespace) open() -> Conn ! EventHubsErr uses (net.dial, clock) {
  if ns.closed.get() {
    return Err(fatal("the client is closed"))
  }
  // Go's getAMQPHostURI(true): the custom endpoint when there is one.
  let addr = "${if ns.tls { "amqps" } else { "amqp" }}://${if ns.custom_endpoint != "" { ns.custom_endpoint } else { ns.fqdn }}"
  let net = ns.net
  let clock = ns.clock
  let gens = ns.gens
  let host = ns.fqdn.split(":")[0]
  let agent = if ns.application_id == "" { "azsdk-xo-azeventhubs/${VERSION}" } else { "${ns.application_id} azsdk-xo-azeventhubs/${VERSION}" }
  let timeout_ms = ns.timeout_ms
  ns.conn.with(fn(var slot: Conn?) -> Conn ! EventHubsErr uses (net.dial, clock) {
    if let Some(x) = slot {
      return Ok(x)
    }
    let conn = amqp.dial(net, addr, amqp.ConnOptions{hostname: host, clock: Some(clock), sasl: amqp.Sasl.Anonymous, timeout_ms: timeout_ms, properties: [("user-agent", amqp.Value.Str(v: agent))]}) ?? e => return Err(from_amqp(e))
    let s = conn.begin() ?? e => {
      conn.abort()
      return Err(from_amqp(e))
    }
    let x = Conn{c: conn, s: s, gen: gens.add(1)}
    slot = Some(x)
    Ok(x)
  })
}

/// The open connection's generation, 0 when none is open.
fn (ns: Namespace) current_gen() -> Int {
  ns.conn.with_read(fn(slot: Conn?) -> Int { slot.map(fn(x: Conn) -> Int { x.gen }) ?? 0 })
}

/// Drops connection `gen` (when it is still the open one), so the next
/// operation dials again: Go's RecoveryKindConn.
fn (ns: Namespace) reset(gen: Int) {
  let old = ns.conn.with(fn(var slot: Conn?) -> Conn? {
    match slot {
      Some(x) => if x.gen == gen || gen == 0 {
        slot = None
        Some(x)
      } else {
        None
      }
      None => None
    }
  })
  if let Some(x) = old {
    x.c.abort()
  }
}

/// The token for an entity's audience, Go's TokenProvider.GetToken.
fn (ns: Namespace) token_for(entity: Str) -> Token ! EventHubsErr uses (net.dial, clock, rand) {
  let aud = ns.audience(entity)
  let now = ns.clock.now().unix()
  match ns.auth {
    Auth.Key(name: n, key: k) => Ok(Token{token: sign_sas(n, k, aud, now + 7200), kind: "servicebus.windows.net:sastoken", expiry: "${now + 7200}"})
    Auth.Signature(sig) => Ok(Token{token: sig.reveal(), kind: "servicebus.windows.net:sastoken", expiry: "0"})
    Auth.Credential(cred) => {
      let t = cred.get_token(azcore.TokenRequestOptions{scopes: ["https://eventhubs.azure.net//.default"]}) ?? e => return Err(fatal(e.display()))
      Ok(Token{token: t.token.reveal(), kind: "jwt", expiry: "${t.expires_on.unix()}"})
    }
  }
}

/// Puts a token for the entity on the connection's `$cbs` node, the
/// expiration a string as Go's.
fn (ns: Namespace) authorize(conn: Conn, entity: Str) -> () ! EventHubsErr uses (net.dial, clock, rand) {
  let t = ns.token_for(entity)?
  amqp.cbs_put_token(conn.c, conn.s, ns.audience(entity), t.token, token_type: t.kind, expiration: Some(amqp.Value.Str(v: t.expiry))) ?? e => return Err(from_amqp(e))
  Ok(())
}

/// A link name unique within the client.
fn (ns: Namespace) link_name(kind: Str, entity: Str) -> Str {
  "${kind}-${entity}-${ns.links.add(1)}"
}

/// Closes the connection for good.
fn (ns: Namespace) close() -> () ! EventHubsErr uses (net.dial, clock) {
  ns.closed.set(true)
  let x = ns.conn.with(fn(var slot: Conn?) -> Conn? {
    let was = slot
    slot = None
    was
  })
  match x {
    Some(conn) => conn.c.close() ?? _ => conn.c.abort()
    None => {}
  }
  Ok(())
}
