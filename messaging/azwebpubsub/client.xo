/// SendToUserOptions: the optional parameters of Client.send_to_user.
pub struct SendToUserOptions {
  /// Following OData filter syntax to filter out the subscribers receiving the messages.
  pub filter: Str? = None
  /// The time-to-live (TTL) value in seconds for messages sent to the service. 0 is the default value, which means the message never expires. 300 is the maximum value. If this parameter is non-zero, messages that are not consumed by the client within the specified TTL will be dropped by the service. This parameter can help when the client's bandwidth is limited.
  pub message_ttl_seconds: Int? = None
}

/// SendToUserResponse: the response of Client.send_to_user.
pub struct SendToUserResponse {}

fn web_pub_sub_send_to_user_handle(resp: http.Response) -> SendToUserResponse ! Str {
  Ok(SendToUserResponse{})
}

fn (c: Client) send_to_user_create_request(hub: Str, user_id: Str, content_type: ContentType, message: Bytes, options: SendToUserOptions) -> policy.Request ! azcore.CallErr {
  var path = "/api/hubs/{hub}/users/{userId}/:send"
  if hub == "" {
    return Err(azcore.CallErr.InvalidInput("parameter hub cannot be empty"))
  }
  path = path.replace("{hub}", url.path_escape(hub))
  if user_id == "" {
    return Err(azcore.CallErr.InvalidInput("parameter userID cannot be empty"))
  }
  path = path.replace("{userId}", url.path_escape(user_id))
  var q = url.values()
  var headers: List[(Str, Str)] = [("Accept", "application/json")]
  q.add("api-version", API_VERSION)
  if let Some(v) = options.filter {
    q.add("filter", v)
  }
  if let Some(v) = options.message_ttl_seconds {
    q.add("messageTtlSeconds", "${v}")
  }
  headers.push(("Content-Type", content_type.0))
  Ok(policy.Request{method: "POST", url: runtime.with_query(runtime.join_paths(c.setup.endpoint, path), q), headers: headers, body: message})
}

pub fn (c: Client) send_to_user(hub: Str, user_id: Str, content_type: ContentType, message: Bytes, options: SendToUserOptions = SendToUserOptions{}) -> SendToUserResponse ! azcore.CallErr uses (net.dial, clock, rand) {
