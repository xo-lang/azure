// A custom endpoint: the connection goes to a TCP relay in front of the
// broker while the namespace itself has no listener; the AMQP Open and
// the token audiences still name the namespace, as Go's CustomEndpoint.

use std/amqptest
use std/task

const REAL: Str = "sb-real.servicebus.example.test"

/// Relays each connection to `to`, keeping what the client sent. (The
/// connections are not annotated: this module's own `Conn` hides the
/// prelude's.)
fn relay(g: task.Group, net: Net, l: Listener, to: Str, sent: Mutex[Bytes]) uses (net.listen, net.dial) {
  g.spawn(fn() uses (net.listen, net.dial) {
    let accept_all = fn() -> () ! NetErr uses (net.listen, net.dial) {
      while {
        let c = l.accept()?
        let up = net.dial(to)?
        g.spawn(fn() uses (net.listen, net.dial) {
          defer up.close()
          let pump = fn() -> () ! NetErr uses (net.listen, net.dial) {
            while let Some(b) = c.read(65536)? {
              sent.with(fn(var all: Bytes) { all = all + b })
              up.write(b)?
            }
            Ok(())
          }
          pump().ignore_err("the client closed or the test ended")
        })
        g.spawn(fn() uses (net.listen, net.dial) {
          defer c.close()
          let pump = fn() -> () ! NetErr uses (net.listen, net.dial) {
            while let Some(b) = up.read(65536)? {
              c.write(b)?
            }
            Ok(())
          }
          pump().ignore_err("the broker closed or the test ended")
        })
      }
      Ok(())
    }
    accept_all().ignore_err("the listener closed or the test ended")
  })
}

test "the client connects through the custom endpoint; the Open and the audiences name the namespace" {
  let b = amqptest.new(os.clock)
  b.queue("q1")
  b.require_token(true)
  let bl = os.net.listen("broker.example.test:5672").or_fault("listen")
  let pl = os.net.listen("proxy.example.test:5672").or_fault("listen")
  let sent = Mutex[Bytes].new(b"")
  let cs = "Endpoint=sb://${REAL};SharedAccessKeyName=k;SharedAccessKey=aW52ZW50ZWQta2V5;UseDevelopmentEmulator=true"
  scope s {
    b.serve(s.group(), bl)
    relay(s.group(), os.net, pl, bl.addr(), sent)
    let c = new_client_from_connection_string(os.net, os.clock, os.rand, cs, ClientOptions{custom_endpoint: pl.addr()})?
    let snd = c.new_sender("q1")?
    snd.send_message(Message{body: b"via the relay"})?
    let r = c.new_receiver_for_queue("q1")?
    let got = r.receive_messages(1, ReceiveMessagesOptions{timeout_ms: 2000})?
    expect(got.map(fn(m: ReceivedMessage) -> Bytes { m.body })) == [b"via the relay"]
    var auds: List[Str] = []
    for (a, _) in b.tokens() {
      if !auds.contains(a) {
        auds.push(a)
      }
    }
    expect(auds) == ["amqp://${REAL}/q1"]
    let bytes = sent.with_read(fn(all: Bytes) -> Bytes { all })
    expect(bytes.contains(REAL.bytes())) == true
    expect(bytes.contains(b"proxy.example.test")) == false
    c.close()?
    s.cancel()
  }
}
