use std/amqp

/// What kind of failure an Error is; "" for one with no code.
pub type Code = Str

pub const CODE_UNAUTHORIZED_ACCESS: Code = "unauthorized"
pub const CODE_CONNECTION_LOST: Code = "connlost"
pub const CODE_LOCK_LOST: Code = "locklost"
pub const CODE_TIMEOUT: Code = "timeout"
pub const CODE_NOT_FOUND: Code = "notfound"
pub const CODE_CLOSED: Code = "closed"

pub struct ServiceBusErr {
  pub code: Code = ""
  pub msg: Str
  /// The AMQP error condition (`com.microsoft:message-lock-lost`), when
  /// the service sent one.
  pub condition: Str = ""
  /// What a retry would have to recover first; Fatal when retrying
  /// cannot help.
  pub recovery: RecoveryKind = RecoveryKind.Fatal
}

pub fn (e: ServiceBusErr) display() -> Str {
  "(${if e.code == "" { "unknown" } else { e.code }}): ${e.msg}"
}

/// The code of an error, as Go's TransformError: lock lost, timeout,
/// unauthorized and not found by condition, then connlost for anything
/// a link or connection recovery would fix.
fn code_for(condition: Str, recovery: RecoveryKind) -> Code {
  match condition {
    "com.microsoft:message-lock-lost" | "com.microsoft:session-lock-lost" => CODE_LOCK_LOST
    "com.microsoft:timeout" => CODE_TIMEOUT
    "amqp:unauthorized-access" => CODE_UNAUTHORIZED_ACCESS
    "amqp:not-found" => CODE_NOT_FOUND
    _ => match recovery {
      RecoveryKind.Link | RecoveryKind.Conn => CODE_CONNECTION_LOST
      RecoveryKind.None | RecoveryKind.Fatal => ""
    }
  }
}

/// An error a peer sent: its condition's recovery, else a link one (the
/// error came on a link, session or connection close; a dead connection
/// then fails the new link and escalates).
fn from_wire(w: amqp.WireError) -> ServiceBusErr {
  let rk = recovery_of_condition(w.condition) ?? RecoveryKind.Link
  ServiceBusErr{code: code_for(w.condition, rk), msg: if w.description == "" { w.condition } else { "${w.condition}: ${w.description}" }, condition: w.condition, recovery: rk}
}

fn from_amqp(e: amqp.AmqpErr) -> ServiceBusErr {
  match e {
    amqp.AmqpErr.Peer(w) => from_wire(w)
    // Go: io.EOF and net errors reset the connection; a receive that
    // timed out is not an error there (its context ends instead).
    amqp.AmqpErr.Net(m) => ServiceBusErr{code: if m.contains("i/o timeout") { CODE_TIMEOUT } else { CODE_CONNECTION_LOST }, msg: m, recovery: RecoveryKind.Conn}
    amqp.AmqpErr.Protocol(m) => ServiceBusErr{code: CODE_CONNECTION_LOST, msg: m, recovery: RecoveryKind.Conn}
    other => ServiceBusErr{msg: "${other:?}"}
  }
}

/// A client-side misuse or state that retrying cannot change.
fn fatal(msg: Str, code: Code = "") -> ServiceBusErr {
  ServiceBusErr{code: code, msg: msg, recovery: RecoveryKind.Fatal}
}
