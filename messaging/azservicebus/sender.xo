use std/amqp
use std/uuid

pub struct NewSenderOptions {}

/// The sender's link and the connection it is on.
struct SenderLink {
  l: amqp.Sender
  gen: Int
}

pub struct Sender {
  client: Client
  entity: Str
  name: Str
  link: Mutex[SenderLink?]
  closed: Atomic[Bool]
}

/// A sender to a queue or a topic; its link attaches on first send, as
/// Go's.
pub fn (c: Client) new_sender(queue_or_topic: Str, options: NewSenderOptions = NewSenderOptions{}) -> Sender ! ServiceBusErr {
  if c.closed.get() {
    return Err(fatal("the client is closed", CODE_CLOSED))
  }
  Ok(Sender{client: c, entity: queue_or_topic, name: c.link_name("sender", queue_or_topic), link: Mutex[SenderLink?].new(None), closed: Atomic[Bool].new(false)})
}

/// The link, attached again when there is none or it is on a dropped
/// connection.
fn (s: Sender) get() -> SenderLink ! ServiceBusErr uses (net.dial, clock, rand) {
  if s.closed.get() {
    return Err(fatal("the sender is closed", CODE_CLOSED))
  }
  let c = s.client
  let entity = s.entity
  let name = s.name
  s.link.with(fn(var slot: SenderLink?) -> SenderLink ! ServiceBusErr uses (net.dial, clock, rand) {
    if let Some(x) = slot {
      if x.gen == c.current_gen() {
        return Ok(x)
      }
    }
    let conn = c.open()?
    c.authorize(conn, entity)?
    let l = conn.c.new_sender(conn.s, entity, amqp.SenderOptions{name: "${name}-${c.links.add(1)}"}) ?? e => return Err(from_amqp(e))
    let x = SenderLink{l: l, gen: conn.gen}
    slot = Some(x)
    Ok(x)
  })
}

/// Recovery before a retry: a new link, or a new connection.
fn (s: Sender) recover(k: RecoveryKind) uses (net.dial, clock) {
  let old = s.link.with(fn(var slot: SenderLink?) -> SenderLink? {
    let was = slot
    if k == RecoveryKind.Link || k == RecoveryKind.Conn {
      slot = None
    }
    was
  })
  if k == RecoveryKind.Conn {
    s.client.reset(old.map(fn(x: SenderLink) -> Int { x.gen }) ?? 0)
  }
}

/// Sends `m` on the link with retries.
fn (s: Sender) send_amqp(m: amqp.Message, message_format: Int = 0) -> () ! ServiceBusErr uses (net.dial, clock, rand) {
  s.client.retry(s.client.opts.retry_options, fn(_: Int) -> () ! ServiceBusErr uses (net.dial, clock, rand) {
    let x = s.get()?
    let st = x.l.send(m, message_format: message_format) ?? e => return Err(from_amqp(e))
    match outcome(st) {
      Some(e) => Err(e)
      None => Ok(())
    }
  }, fn(k: RecoveryKind) uses (net.dial, clock) { s.recover(k) })
}

/// The outcome of a send as an error, None when accepted.
fn outcome(s: amqp.DeliveryState?) -> ServiceBusErr? {
  match s {
    None | Some(amqp.DeliveryState.Accepted) => None
    Some(amqp.DeliveryState.Rejected(Some(w))) => Some(from_wire(w))
    Some(other) => Some(ServiceBusErr{msg: "the message was not accepted: ${other:?}", recovery: RecoveryKind.None})
  }
}

pub struct SendMessageOptions {}

/// Sends one message and waits for the service to accept it, retrying
/// after a recoverable failure.
pub fn (s: Sender) send_message(message: Message, options: SendMessageOptions = SendMessageOptions{}) -> () ! ServiceBusErr uses (net.dial, clock, rand) {
  s.send_amqp(message.to_amqp())
}

pub struct SendAMQPAnnotatedMessageOptions {}

/// Sends an AMQP message with all its sections, as send_message.
pub fn (s: Sender) send_amqp_annotated_message(message: AMQPAnnotatedMessage, options: SendAMQPAnnotatedMessageOptions = SendAMQPAnnotatedMessageOptions{}) -> () ! ServiceBusErr uses (net.dial, clock, rand) {
  s.send_amqp(annotated_to_amqp(message))
}

pub struct MessageBatchOptions {
  /// The batch's size limit in bytes; 0 for the link's: its
  /// `com.microsoft:max-message-batch-size` property, else its max
  /// message size, as Go's NewMessageBatch.
  pub max_bytes: Int = 0
}

/// Messages sent as one transfer of message format 0x80013700: the first
/// message without its body is the envelope, and each message is one data
/// section of the body, as Go's MessageBatch.
pub struct MessageBatch {
  max_bytes: Int
  rand: Rand
  size: Int = 0
  envelope: amqp.Message? = None
  encoded: List[Bytes] = []
}

pub const ERR_MESSAGE_TOO_LARGE: Str = "the message is too large"

/// The message format of a batch transfer.
const BATCH_MESSAGE_FORMAT: Int = 0x80013700

fn int_value(v: amqp.Value) -> Int? {
  match v {
    amqp.Value.ULong(x) => Some(Int(x))
    amqp.Value.UInt(x) => Some(Int(x))
    amqp.Value.Long(x) => if x > 0 { Some(Int(x)) } else { None }
    amqp.Value.Int(x) => if x > 0 { Some(Int(x)) } else { None }
    _ => None
  }
}

/// An empty batch, sized for the link (which attaches here, as Go's). A
/// link that names no size (0, AMQP's no limit) takes no limit.
pub fn (s: Sender) new_message_batch(options: MessageBatchOptions = MessageBatchOptions{}) -> MessageBatch ! ServiceBusErr uses (net.dial, clock, rand) {
  let max = s.client.retry(s.client.opts.retry_options, fn(_: Int) -> Int ! ServiceBusErr uses (net.dial, clock, rand) {
    let x = s.get()?
    let a = x.l.remote_attach() ?? return Ok(0)
    var m = a.max_message_size
    for (k, v) in a.properties {
      if k == "com.microsoft:max-message-batch-size" {
        if let Some(n) = int_value(v) {
          m = n
        }
      }
    }
    Ok(m)
  }, fn(k: RecoveryKind) uses (net.dial, clock) { s.recover(k) })?
  Ok(MessageBatch{max_bytes: if options.max_bytes != 0 { options.max_bytes } else { max }, rand: s.client.rand})
}

pub struct AddMessageOptions {}

/// A data section's encoded size: its bytes with a vbin8 or vbin32
/// header (Go's calcActualSizeForPayload).
fn payload_size(n: Int) -> Int {
  if n < 256 { 5 + n } else { 8 + n }
}

/// Adds a message (given a message id when it has none, as Go's);
/// ERR_MESSAGE_TOO_LARGE when it would pass the limit.
pub fn (var b: MessageBatch) add_message(m: Message, options: AddMessageOptions = AddMessageOptions{}) -> () ! ServiceBusErr uses rand {
  b.add_amqp(m.to_amqp())
}

pub struct AddAMQPAnnotatedMessageOptions {}

/// Adds an AMQP message with all its sections, as add_message.
pub fn (var b: MessageBatch) add_amqp_annotated_message(m: AMQPAnnotatedMessage, options: AddAMQPAnnotatedMessageOptions = AddAMQPAnnotatedMessageOptions{}) -> () ! ServiceBusErr uses rand {
  b.add_amqp(annotated_to_amqp(m))
}

/// Go's addAMQPMessage: a UUID message id when it has none (Null or
/// ""), then the size check.
fn (var b: MessageBatch) add_amqp(m: amqp.Message) -> () ! ServiceBusErr uses rand {
  var p = m.properties ?? amqp.Properties{}
  if p.message_id == amqp.Value.Null || p.message_id == amqp.Value.Str(v: "") {
    p.message_id = amqp.Value.Str(v: uuid.v4(b.rand).display())
  }
  let am = m with {properties: Some(p)}
  let bs = amqp.encode_message(am) ?? e => return Err(from_amqp(e))
  var size = b.size
  var envelope = b.envelope
  if b.encoded.is_empty() {
    let env = am with {body: amqp.Body.Data(sections: [])}
    let eb = amqp.encode_message(env) ?? e => return Err(from_amqp(e))
    size = eb.len()
    envelope = Some(env)
  }
  let grown = size + payload_size(bs.len())
  if b.max_bytes > 0 && grown > b.max_bytes {
    if b.encoded.is_empty() {
      b.size = 0
      b.envelope = None
    }
    return Err(ServiceBusErr{msg: ERR_MESSAGE_TOO_LARGE})
  }
  b.envelope = envelope
  b.encoded.push(bs)
  b.size = grown
  Ok(())
}

pub fn (b: MessageBatch) num_bytes() -> Int {
  b.size
}

pub fn (b: MessageBatch) num_messages() -> Int {
  b.encoded.len()
}

pub struct SendMessageBatchOptions {}

/// Sends the batch in one transfer (message format 0x80013700).
pub fn (s: Sender) send_message_batch(batch: MessageBatch, options: SendMessageBatchOptions = SendMessageBatchOptions{}) -> () ! ServiceBusErr uses (net.dial, clock, rand) {
  let env = batch.envelope ?? return Ok(())
  s.send_amqp(env with {body: amqp.Body.Data(sections: batch.encoded)}, BATCH_MESSAGE_FORMAT)
}

pub struct ScheduleMessagesOptions {}

/// Schedules the messages to appear at `scheduled_enqueue_time` and
/// returns their sequence numbers, to cancel them with.
pub fn (s: Sender) schedule_messages(messages: List[Message], scheduled_enqueue_time: Time, options: ScheduleMessagesOptions = ScheduleMessagesOptions{}) -> List[Int] ! ServiceBusErr uses (net.dial, clock, rand) {
  s.schedule_amqp(messages.map(fn(m: Message) -> amqp.Message { m.to_amqp() }), scheduled_enqueue_time)
}

pub struct ScheduleAMQPAnnotatedMessagesOptions {}

/// Schedules AMQP messages with all their sections, as schedule_messages.
pub fn (s: Sender) schedule_amqp_annotated_messages(messages: List[AMQPAnnotatedMessage], scheduled_enqueue_time: Time, options: ScheduleAMQPAnnotatedMessagesOptions = ScheduleAMQPAnnotatedMessagesOptions{}) -> List[Int] ! ServiceBusErr uses (net.dial, clock, rand) {
  s.schedule_amqp(messages.map(annotated_to_amqp), scheduled_enqueue_time)
}

/// Go's internal ScheduleMessages: each message gets the scheduled time
/// annotation and a UUID id when it has none, and goes as an entry with
/// its id, encoding, session id and partition keys.
fn (s: Sender) schedule_amqp(messages: List[amqp.Message], t: Time) -> List[Int] ! ServiceBusErr uses (net.dial, clock, rand) {
  if messages.is_empty() {
    return Err(ServiceBusErr{msg: "expected one or more messages"})
  }
  var entries: List[amqp.Value] = []
  for m0 in messages {
    let anns = m0.annotations ?? return Err(ServiceBusErr{msg: "message does not have an initialized Annotations property"})
    var p = m0.properties ?? amqp.Properties{}
    if p.message_id == amqp.Value.Null {
      p.message_id = amqp.Value.Str(v: uuid.v4(s.client.rand).display())
    }
    let m = m0 with {annotations: Some(set_annotation(anns, SCHEDULED_ENQUEUE_TIME, amqp.Value.Timestamp(ms: t.unix_millis()))), properties: Some(p)}
    let bs = amqp.encode_message(m) ?? e => return Err(from_amqp(e))
    var e: List[(amqp.Value, amqp.Value)] = [(key("message-id"), p.message_id), (key("message"), amqp.Value.Binary(v: bs))]
    if let Some(sid) = p.group_id {
      e.push((key("session-id"), amqp.Value.Str(v: sid)))
    }
    if let Some(pk) = lookup(m.annotations ?? [], PARTITION_KEY).and_then(val_str) {
      e.push((key("partition-key"), amqp.Value.Str(v: pk)))
    }
    if let Some(vpk) = lookup(m.annotations ?? [], "x-opt-via-partition-key").and_then(val_str) {
      e.push((key("via-partition-key"), amqp.Value.Str(v: vpk)))
    }
    entries.push(amqp.Value.Map(pairs: e))
  }
  let reply = s.client.rpc(s.entity, s.name, "schedule-message", [("messages", amqp.Value.List(items: entries))])?
  Ok(items(field(reply.body, "sequence-numbers")).map(fn(v: amqp.Value) -> Int { val_int(v) ?? 0 }))
}

pub struct CancelScheduledMessagesOptions {}

/// Cancels scheduled messages by their sequence numbers.
pub fn (s: Sender) cancel_scheduled_messages(sequence_numbers: List[Int], options: CancelScheduledMessagesOptions = CancelScheduledMessagesOptions{}) -> () ! ServiceBusErr uses (net.dial, clock, rand) {
  s.client.rpc(s.entity, s.name, "cancel-scheduled-message", [("sequence-numbers", longs(sequence_numbers))])?
  Ok(())
}

/// Detaches the sender's link; later sends fail with CODE_CLOSED.
pub fn (s: Sender) close() -> () ! ServiceBusErr uses (net.dial, clock) {
  s.closed.set(true)
  let old = s.link.with(fn(var slot: SenderLink?) -> SenderLink? {
    let was = slot
    slot = None
    was
  })
  if let Some(x) = old {
    x.l.close() ?? e => return Err(from_amqp(e))
  }
  Ok(())
}
