use std/amqp

/// How messages are taken: locked until settled, or deleted as they are
/// delivered.
pub enum ReceiveMode {
  PeekLock
  ReceiveAndDelete
}

/// A queue's or subscription's sub-queue.
pub enum SubQueue {
  None
  DeadLetter
  TransferDeadLetter
}

pub struct ReceiverOptions {
  pub receive_mode: ReceiveMode = ReceiveMode.PeekLock
  pub sub_queue: SubQueue = SubQueue.None
}

pub struct Receiver {
  client: Client
  /// The entity the links are on (`q`, `t/Subscriptions/s`, with a
  /// sub-queue suffix).
  entity: Str
  mode: ReceiveMode
  /// The link, attached on first receive as Go's (its credit would lock
  /// a message before anyone asked for one), and again after recovery.
  link: Mutex[RecvLink?]
  opts: amqp.ReceiverOptions
  name: Str
  /// The last peeked sequence number, where the next peek starts.
  last_peeked: Atomic[Int]
  /// Lock tokens (hex) of messages this receiver settled, so a second
  /// settle of one fails here instead of going to the service.
  settled: Mutex[Set[Str]]
  closed: Atomic[Bool]
}

/// A receiving link, the connection it is on, and its name: a message
/// settles on the link it came on while that link is the current one.
struct RecvLink {
  l: amqp.Receiver
  gen: Int
  key: Str
}

fn entity_of(base: Str, sub: SubQueue) -> Str {
  match sub {
    SubQueue.None => base
    SubQueue.DeadLetter => "${base}/$DeadLetterQueue"
    SubQueue.TransferDeadLetter => "${base}/$Transfer/$DeadLetterQueue"
  }
}

fn (c: Client) receiver(entity: Str, options: ReceiverOptions, filters: List[(Str, amqp.Value)] = []) -> Receiver ! ServiceBusErr {
  if c.closed.get() {
    return Err(fatal("the client is closed", CODE_CLOSED))
  }
  let name = c.link_name("receiver", entity)
  let opts = match options.receive_mode {
    ReceiveMode.PeekLock => amqp.ReceiverOptions{name: name, credit: 1, filters: filters, settle_mode: Some(amqp.ReceiverSettleMode.Second), sender_settle_mode: Some(amqp.SenderSettleMode.Unsettled)}
    ReceiveMode.ReceiveAndDelete => amqp.ReceiverOptions{name: name, credit: 1, filters: filters, settle_mode: Some(amqp.ReceiverSettleMode.First), sender_settle_mode: Some(amqp.SenderSettleMode.Settled)}
  }
  Ok(Receiver{client: c, entity: entity, mode: options.receive_mode, link: Mutex[RecvLink?].new(None), opts: opts, name: name, last_peeked: Atomic[Int].new(0), settled: Mutex[Set[Str]].new(#{}), closed: Atomic[Bool].new(false)})
}

/// The receiving link, attached (after a put-token) when there is none
/// or it is on a dropped connection.
fn (r: Receiver) attached() -> RecvLink ! ServiceBusErr uses (net.dial, clock, rand) {
  if r.closed.get() {
    return Err(fatal("the receiver is closed", CODE_CLOSED))
  }
  let c = r.client
  let entity = r.entity
  let opts = r.opts
  r.link.with(fn(var slot: RecvLink?) -> RecvLink ! ServiceBusErr uses (net.dial, clock, rand) {
    if let Some(x) = slot {
      if x.gen == c.current_gen() {
        return Ok(x)
      }
    }
    let conn = c.open()?
    c.authorize(conn, entity)?
    let key = "${opts.name}-${c.links.add(1)}"
    let l = conn.c.new_receiver(conn.s, entity, opts with {name: key}) ?? e => return Err(from_amqp(e))
    let x = RecvLink{l: l, gen: conn.gen, key: key}
    slot = Some(x)
    Ok(x)
  })
}

/// The link now, when it is still on the open connection.
fn (r: Receiver) current() -> RecvLink? {
  let gen = r.client.current_gen()
  r.link.with_read(fn(x: RecvLink?) -> RecvLink? { x }).and_then(fn(x: RecvLink) -> RecvLink? { if x.gen == gen { Some(x) } else { None } })
}

/// Recovery before a retry: a new link, or a new connection.
fn (r: Receiver) recover(k: RecoveryKind) uses (net.dial, clock) {
  let old = r.link.with(fn(var slot: RecvLink?) -> RecvLink? {
    let was = slot
    if k == RecoveryKind.Link || k == RecoveryKind.Conn {
      slot = None
    }
    was
  })
  if k == RecoveryKind.Conn {
    r.client.reset(old.map(fn(x: RecvLink) -> Int { x.gen }) ?? 0)
  }
}

/// A receiver for a queue.
pub fn (c: Client) new_receiver_for_queue(queue_name: Str, options: ReceiverOptions = ReceiverOptions{}) -> Receiver ! ServiceBusErr {
  c.receiver(entity_of(queue_name, options.sub_queue), options)
}

/// A receiver for a topic's subscription.
pub fn (c: Client) new_receiver_for_subscription(topic_name: Str, subscription_name: Str, options: ReceiverOptions = ReceiverOptions{}) -> Receiver ! ServiceBusErr {
  c.receiver(entity_of("${topic_name}/Subscriptions/${subscription_name}", options.sub_queue), options)
}

pub struct ReceiveMessagesOptions {
  /// How long to wait for the first message; 0 waits for the client's
  /// timeout. Go waits until its context ends.
  pub timeout_ms: Int = 0
  /// After the first message, how long to wait for each further one (Go's
  /// 20 ms, "TimeAfterFirstMessage").
  pub time_after_first_message_ms: Int = 20
}

/// Up to `max_messages` messages: it waits for the first, then takes
/// what arrives within `time_after_first_message_ms` of each. An empty
/// list when none came in time. A recoverable failure before the first
/// message is retried on a new link or connection; one after it returns
/// the messages so far and recovers for the next call.
pub fn (r: Receiver) receive_messages(max_messages: Int, options: ReceiveMessagesOptions = ReceiveMessagesOptions{}) -> List[ReceivedMessage] ! ServiceBusErr uses (net.dial, clock, rand) {
  let first = if options.timeout_ms > 0 { options.timeout_ms } else { r.client.opts.timeout_ms }
  r.client.retry(r.client.opts.retry_options, fn(_: Int) -> List[ReceivedMessage] ! ServiceBusErr uses (net.dial, clock, rand) {
    let x = r.attached()?
    var out: List[ReceivedMessage] = []
    while out.len() < max_messages {
      let wait = if out.is_empty() { first } else { options.time_after_first_message_ms }
      match x.l.receive(wait) {
        Ok(d) => out.push(received(d.message, Some(d), x.key))
        Err(amqp.AmqpErr.Net(m)) if m.contains("i/o timeout") => break
        Err(e) => {
          let se = from_amqp(e)
          if out.is_empty() {
            return Err(se)
          }
          r.recover(se.recovery)
          break
        }
      }
    }
    Ok(out)
  }, fn(k: RecoveryKind) uses (net.dial, clock) { r.recover(k) })
}

/// Settles `m`: on the link it came on while that link is current (and
/// on `$management` when that link fails under it, as Go's
/// shouldSettleOnMgmtLink), else on `$management` by its lock token. A
/// settlement that went through is not sent again.
fn (r: Receiver) settle(m: ReceivedMessage, on_link: fn(amqp.Receiver, amqp.Delivery) -> () ! amqp.AmqpErr uses (net.dial, clock), status: Str, extra: List[(Str, amqp.Value)]) -> () ! ServiceBusErr uses (net.dial, clock, rand) {
  match r.mode {
    ReceiveMode.ReceiveAndDelete => return Err(fatal("messages that are received in `ReceiveModeReceiveAndDelete` mode are not settleable"))
    ReceiveMode.PeekLock => {}
  }
  let tok = m.lock_token.to_hex()
  let first = r.settled.with(fn(var xs: Set[Str]) -> Bool {
    if tok != "" && xs.contains(tok) {
      return false
    }
    xs.add(tok)
    true
  })
  if !first {
    return Err(fatal("the message was already settled", CODE_LOCK_LOST))
  }
  let res = r.settle_once(m, on_link, status, extra)
  if res.is_err() {
    // Not settled: a later call may try again.
    r.settled.with(fn(var xs: Set[Str]) { xs.remove(tok) })
  }
  res
}

fn (r: Receiver) settle_once(m: ReceivedMessage, on_link: fn(amqp.Receiver, amqp.Delivery) -> () ! amqp.AmqpErr uses (net.dial, clock), status: Str, extra: List[(Str, amqp.Value)]) -> () ! ServiceBusErr uses (net.dial, clock, rand) {
  if let (Some(d), Some(x)) = (m.delivery, r.current()) {
    if x.key == m.link_key {
      match on_link(x.l, d) {
        Ok(_) => return Ok(())
        Err(e) => {
          let se = from_amqp(e)
          if se.recovery == RecoveryKind.Fatal || se.recovery == RecoveryKind.None {
            return Err(se)
          }
          r.recover(se.recovery)
        }
      }
    }
  }
  if m.lock_token.len() != 16 {
    return Err(fatal("lock token on the message is not set, thus cannot send disposition"))
  }
  r.client.rpc(r.entity, r.name, "update-disposition", [("disposition-status", amqp.Value.Str(v: status)), ("lock-tokens", amqp.Value.Array(items: [amqp.Value.Uuid(bytes: m.lock_token)]))] + extra)?
  Ok(())
}

pub struct CompleteMessageOptions {}

/// Completes the message: the service deletes it.
pub fn (r: Receiver) complete_message(message: ReceivedMessage, options: CompleteMessageOptions = CompleteMessageOptions{}) -> () ! ServiceBusErr uses (net.dial, clock, rand) {
  r.settle(message, fn(l: amqp.Receiver, d: amqp.Delivery) -> () ! amqp.AmqpErr uses (net.dial, clock) { l.accept(d) }, "completed", [])
}

pub struct AbandonMessageOptions {}

/// Gives the message back: it can be received again, its delivery count
/// up by one.
pub fn (r: Receiver) abandon_message(message: ReceivedMessage, options: AbandonMessageOptions = AbandonMessageOptions{}) -> () ! ServiceBusErr uses (net.dial, clock, rand) {
  r.settle(message, fn(l: amqp.Receiver, d: amqp.Delivery) -> () ! amqp.AmqpErr uses (net.dial, clock) { l.modify(d, false, false) }, "abandoned", [])
}

pub struct DeferMessageOptions {}

/// Defers the message: it is only received again by its sequence number
/// (receive_deferred_messages).
pub fn (r: Receiver) defer_message(message: ReceivedMessage, options: DeferMessageOptions = DeferMessageOptions{}) -> () ! ServiceBusErr uses (net.dial, clock, rand) {
  r.settle(message, fn(l: amqp.Receiver, d: amqp.Delivery) -> () ! amqp.AmqpErr uses (net.dial, clock) { l.modify(d, false, true) }, "defered", [])
}

pub struct DeadLetterOptions {
  pub reason: Str? = None
  pub error_description: Str? = None
}

/// Moves the message to the dead letter queue with the reason and
/// description as its DeadLetterReason and DeadLetterErrorDescription.
pub fn (r: Receiver) dead_letter_message(message: ReceivedMessage, options: DeadLetterOptions = DeadLetterOptions{}) -> () ! ServiceBusErr uses (net.dial, clock, rand) {
  let reason = options.reason ?? ""
  let desc = options.error_description ?? ""
  let werr = amqp.WireError{condition: "com.microsoft:dead-letter", info: [("DeadLetterReason", amqp.Value.Str(v: reason)), ("DeadLetterErrorDescription", amqp.Value.Str(v: desc))]}
  r.settle(message, fn(l: amqp.Receiver, d: amqp.Delivery) -> () ! amqp.AmqpErr uses (net.dial, clock) { l.reject(d, Some(werr)) }, "suspended", [("deadletter-reason", amqp.Value.Str(v: reason)), ("deadletter-description", amqp.Value.Str(v: desc))])
}

pub struct ReceiveDeferredMessagesOptions {}

/// The deferred messages with these sequence numbers, locked for
/// settling (on `$management`).
pub fn (r: Receiver) receive_deferred_messages(sequence_numbers: List[Int], options: ReceiveDeferredMessagesOptions = ReceiveDeferredMessagesOptions{}) -> List[ReceivedMessage] ! ServiceBusErr uses (net.dial, clock, rand) {
  let mode = match r.mode {
    ReceiveMode.PeekLock => 1
    ReceiveMode.ReceiveAndDelete => 0
  }
  let reply = r.client.rpc(r.entity, r.name, "receive-by-sequence-number", [("sequence-numbers", longs(sequence_numbers)), ("receiver-settle-mode", amqp.Value.UInt(v: UInt32(mode)))])?
  let out = messages_of(reply)?
  Ok(out.map(fn(m: ReceivedMessage) -> ReceivedMessage { m with {state: MESSAGE_STATE_DEFERRED} }))
}

pub struct PeekMessagesOptions {
  /// Where to start; None continues after the last peeked message.
  pub from_sequence_number: Int? = None
}

/// Up to `max_message_count` messages without locking them.
pub fn (r: Receiver) peek_messages(max_message_count: Int, options: PeekMessagesOptions = PeekMessagesOptions{}) -> List[ReceivedMessage] ! ServiceBusErr uses (net.dial, clock, rand) {
  let from = options.from_sequence_number ?? (r.last_peeked.get() + 1)
  let reply = r.client.rpc(r.entity, r.name, "peek-message", [("from-sequence-number", amqp.Value.Long(v: Int64(from))), ("message-count", amqp.Value.Int(v: Int32.wrapping_from(max_message_count)))])?
  let out = messages_of(reply)?
  if let Some(last) = out.last() {
    r.last_peeked.set(last.sequence_number ?? from)
  }
  Ok(out)
}

pub struct RenewMessageLockOptions {}

/// Renews the message's lock and returns its new expiry; a lock that ran
/// out is CODE_LOCK_LOST.
pub fn (r: Receiver) renew_message_lock(message: ReceivedMessage, options: RenewMessageLockOptions = RenewMessageLockOptions{}) -> Time ! ServiceBusErr uses (net.dial, clock, rand) {
  let reply = r.client.rpc(r.entity, r.name, "renew-lock", [("lock-tokens", amqp.Value.Array(items: [amqp.Value.Uuid(bytes: message.lock_token)]))])?
  match items(field(reply.body, "expirations")).get(0).and_then(val_time) {
    Some(t) => Ok(t)
    None => Err(fatal("the renew-lock reply has no expiration"))
  }
}

/// Detaches the receiver's link; later calls fail with CODE_CLOSED.
pub fn (r: Receiver) close() -> () ! ServiceBusErr uses (net.dial, clock) {
  r.closed.set(true)
  let old = r.link.with(fn(var x: RecvLink?) -> RecvLink? {
    let was = x
    x = None
    was
  })
  if let Some(link) = old {
    link.l.close() ?? e => return Err(from_amqp(e))
  }
  Ok(())
}
