use std/json

/// Go's MongoDBChatExtensionParametersEmbeddingDependency: one of the two
/// vectorization sources MongoDB takes, written as that source (its
/// `type` included). Go has no way to read one back (its one field is
/// unexported and it has no UnmarshalJSON): any object read is `Unread`,
/// written as `null`, and a value other than an object or null is a
/// decode error, all as Go's.
pub enum MongoDBChatExtensionParametersEmbeddingDependency {
  DeploymentName(source: OnYourDataDeploymentNameVectorizationSource)
  Endpoint(source: OnYourDataEndpointVectorizationSource)
  Unread
} derive Json(via: json.Value, to: mongo_embedding_dependency_json, from: parse_mongo_embedding_dependency)

fn mongo_embedding_dependency_json(d: MongoDBChatExtensionParametersEmbeddingDependency) -> json.Value {
  match d {
    MongoDBChatExtensionParametersEmbeddingDependency.DeploymentName(s) => json.to_value(OnYourDataVectorizationSourceClassification.OnYourDataDeploymentNameVectorizationSource(s))
    MongoDBChatExtensionParametersEmbeddingDependency.Endpoint(s) => json.to_value(OnYourDataVectorizationSourceClassification.OnYourDataEndpointVectorizationSource(s))
    MongoDBChatExtensionParametersEmbeddingDependency.Unread => json.Value.Null
  }
}

fn parse_mongo_embedding_dependency(v: json.Value) -> MongoDBChatExtensionParametersEmbeddingDependency ! json.DecodeErr {
  match v {
    json.Value.Object(_) => Ok(MongoDBChatExtensionParametersEmbeddingDependency.Unread)
    _ => Err(json.DecodeErr{path: "$", msg: "expected object"})
  }
}
