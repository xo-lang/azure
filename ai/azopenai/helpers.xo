//
// Go's helpers work on openai-go's types; these work on the JSON those
// types are read from and written as: a request body before it is sent,
// and a response's objects as received.

use std/json

/// Go's WithDataSources: the request body with `data_sources` set to the
/// Azure OpenAI On Your Data sources (in place when the body has the key,
/// last otherwise, as openai-go's WithJSONSet); no sources is `null`.
pub fn with_data_sources(body: json.Value, sources: List[AzureChatExtensionConfigurationClassification]) -> json.Value {
  let v = if sources.is_empty() { json.Value.Null } else { json.to_value(sources) }
  set_key(body, "data_sources", v)
}

/// Go's WithEnhancements: the request body with `enhancements` set.
pub fn with_enhancements(body: json.Value, config: AzureChatEnhancementConfiguration) -> json.Value {
  set_key(body, "enhancements", json.to_value(config))
}

fn set_key(body: json.Value, key: Str, v: json.Value) -> json.Value {
  match body {
    json.Value.Object(fs) => {
      if fs.any(fn(f: (Str, json.Value)) -> Bool { f.0 == key }) {
        json.Value.Object(fs.map(fn(f: (Str, json.Value)) -> (Str, json.Value) { if f.0 == key { (key, v) } else { f } }))
      } else {
        json.Value.Object(fs + [(key, v)])
      }
    }
    _ => json.Value.Object([(key, v)])
  }
}

/// Go's PromptFilterResults (of ChatCompletion, ChatCompletionChunk and
/// Completion): the `prompt_filter_results` of a completion object, None
/// without one (or with null, where Go's dereference panics).
pub fn prompt_filter_results(completion: json.Value) -> List[ContentFilterResultsForPrompt]? ! json.DecodeErr {
  let v = completion.get("prompt_filter_results") ?? return Ok(None)
  if v == json.Value.Null {
    return Ok(None)
  }
  Ok(Some(json.from_value[List[ContentFilterResultsForPrompt]](v)?))
}

/// Go's ContentFilterResults (of ChatCompletionChoice and
/// CompletionChoice): a choice's `content_filter_results`.
pub fn content_filter_results(choice: json.Value) -> ContentFilterResultsForChoice? ! json.DecodeErr {
  let v = choice.get("content_filter_results") ?? return Ok(None)
  if v == json.Value.Null {
    return Ok(None)
  }
  Ok(Some(json.from_value[ContentFilterResultsForChoice](v)?))
}

/// Go's Context (of ChatCompletionMessage and
/// ChatCompletionChunkChoiceDelta): a message's or delta's `context`.
pub fn message_context(message: json.Value) -> AzureChatExtensionsMessageContext? ! json.DecodeErr {
  let v = message.get("context") ?? return Ok(None)
  if v == json.Value.Null {
    return Ok(None)
  }
  Ok(Some(json.from_value[AzureChatExtensionsMessageContext](v)?))
}
