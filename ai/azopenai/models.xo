/// `v` with its discriminator `key` set to `value`, as Go's
/// MarshalJSON writes a subtype's (its keys sorted).
fn with_discriminator(v: json.Value, key: Str, value: Str) -> json.Value {
  match v {
    json.Value.Object(fs) => json.Value.Object((fs.filter(fn(f: (Str, json.Value)) -> Bool { f.0 != key }) + [(key, json.Value.Str(value))]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    other => other
  }
}

/// `v` with its discriminator `key` null when it has none, as Go's
/// base type's MarshalJSON writes it (its keys sorted).
fn with_discriminator_value(v: json.Value, key: Str) -> json.Value {
  match v {
    json.Value.Object(fs) if !fs.any(fn(f: (Str, json.Value)) -> Bool { f.0 == key }) => json.Value.Object((fs + [(key, json.Value.Null)]).sort_by(fn(f: (Str, json.Value)) -> Str { f.0 }))
    other => other
  }
}

