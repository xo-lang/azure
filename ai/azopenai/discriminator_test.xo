// Go's JSON for polymorphic models, from a Go program over Go's
// azopenai v0.9.0: a subtype alone (its discriminator unset, or set to
// another value), the base alone, and each through a field of the
// base's interface type. Go's subtype writes its own value always.

use github.com/xo-lang/azure/runtime

/// Where ours still differs from Go's: (Go's line, ours).
const DISC_KNOWN: List[(Str, Str)] = []

test "polymorphic models encode as Go's, alone and through the base" {
  let got = [
    "openai.derived ${runtime.marshal_json(OnYourDataAPIKeyAuthenticationOptions{key: Some("k")}).to_str_lossy()}",
    "openai.base ${runtime.marshal_json(OnYourDataAuthenticationOptions{}).to_str_lossy()}",
    "openai.through ${runtime.marshal_json(AzureCosmosDBChatExtensionParameters{authentication: Some(OnYourDataAuthenticationOptionsClassification.OnYourDataAPIKeyAuthenticationOptions(OnYourDataAPIKeyAuthenticationOptions{}))}).to_str_lossy()}",
    "openai.through_base ${runtime.marshal_json(AzureCosmosDBChatExtensionParameters{authentication: Some(OnYourDataAuthenticationOptionsClassification.OnYourDataAuthenticationOptions(OnYourDataAuthenticationOptions{}))}).to_str_lossy()}",
  ]
  let want = [
    "openai.derived {\"key\":\"k\",\"type\":\"api_key\"}",
    "openai.base {\"type\":null}",
    "openai.through {\"authentication\":{\"type\":\"api_key\"}}",
    "openai.through_base {\"authentication\":{\"type\":null}}",
  ]
  expect(got.len()) == want.len()
  var bad: List[Str] = []
  var i = 0
  while i < want.len() {
    let w = want[i]
    let ours = DISC_KNOWN.filter(fn(p: (Str, Str)) -> Bool { p.0 == w }).get(0).map(fn(p: (Str, Str)) -> Str { p.1 }) ?? w
    if got[i] != ours {
      bad.push("want: ${ours}\n  got:  ${got[i]}")
    }
    i += 1
  }
  expect(bad.join("\n")) == ""
}
