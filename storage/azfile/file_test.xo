// The file client (no data calls) against the Go program's fake
// (filevectors_test.xo): every request byte for byte, every field read
// back as Go dumps it.

use std/http
use std/testing
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/policy

const FILE_GO_DATE: Str = "Fri, 06 Nov 2026 11:01:39 GMT"

const FHANDLES: Str = "<?xml version=\"1.0\" encoding=\"utf-8\"?><EnumerationResults><Entries><Handle><HandleId>h1</HandleId><Path>d1/f.txt</Path><FileId>11529285414812647424</FileId><SessionId>s-1</SessionId><ClientIp>192.0.2.10:445</ClientIp><OpenTime>Thu, 05 Nov 2026 01:00:00 GMT</OpenTime></Handle></Entries><NextMarker /></EnumerationResults>"

struct FileFixed {}

fn (p: FileFixed) send(req: policy.Request, next: policy.Next) -> http.Response ! policy.SendErr uses (net.dial, clock, rand) {
  next.send(req.with_header("x-ms-date", FILE_GO_DATE).with_header("x-ms-client-request-id", "00000000-0000-0000-0000-000000000000"))
}

/// Every header any file response reads; each call keeps its subset.
const EVERY: List[(Str, Str)] = [
  ("ETag", "\"0x8DF\""), ("Last-Modified", "Thu, 05 Nov 2026 03:00:00 GMT"),
  ("x-ms-file-attributes", "Archive|ReadOnly"), ("x-ms-file-creation-time", "2026-11-01T01:02:03.1234567Z"),
  ("x-ms-file-last-write-time", "2026-11-02T01:02:03.0000000Z"), ("x-ms-file-change-time", "2026-11-03T01:02:03.5000000Z"),
  ("x-ms-file-id", "11529285414812647424"), ("x-ms-file-parent-id", "13835128424026341376"), ("x-ms-file-permission-key", "4066*123"),
  ("x-ms-request-server-encrypted", "true"), ("x-ms-server-encrypted", "false"),
  ("x-ms-mode", "0644"), ("x-ms-owner", "1000"), ("x-ms-group", "1001"), ("x-ms-file-file-type", "Regular"), ("x-ms-link-count", "2"),
  ("x-ms-copy-id", "c-1"), ("x-ms-copy-status", "pending"), ("x-ms-copy-progress", "10/100"), ("x-ms-copy-source", "http://src.example.test/s/f"),
  ("x-ms-copy-completion-time", "Thu, 05 Nov 2026 02:30:00 GMT"), ("x-ms-copy-status-description", "going"),
  ("x-ms-type", "File"), ("Cache-Control", "no-cache"), ("Content-Disposition", "inline"), ("Content-Encoding", "gzip"),
  ("Content-Language", "en"), ("Content-MD5", "AQID"), ("x-ms-lease-duration", "infinite"), ("x-ms-lease-state", "leased"),
  ("x-ms-lease-status", "locked"), ("x-ms-link-text", "..%2Ft"), ("x-ms-meta-color", "blue"), ("x-ms-meta-two-words", "x"),
  ("x-ms-client-request-id", "echo-1"), ("Content-Length", "0"),
]

fn file_answer(req: http.Request) -> http.Response {
  let q = req.url.query
  let comp = q.get("comp") ?? ""
  let restype = q.get("restype") ?? ""
  let m = req.method
  if comp == "listhandles" { return xml_resp(200, FHANDLES) }
  if comp == "forceclosehandles" {
    return with_headers(http.text(200, ""), [("x-ms-marker", "fm1"), ("x-ms-number-of-handles-closed", "1"), ("x-ms-number-of-handles-failed", "0")])
  }
  let status = if comp == "copy" {
    204
  } else if restype == "hardlink" || (restype == "symboliclink" && m == "PUT") {
    201
  } else if comp != "" {
    200
  } else if req.header("x-ms-copy-source").is_some() || m == "DELETE" {
    202
  } else if m == "PUT" {
    201
  } else {
    200
  }
  with_headers(http.empty(status), EVERY)
}

fn file_dump(x: FileResponse) -> Dump {
  var d = Dump{}
  d.s("CacheControl", x.cache_control)
  d.s("ClientRequestID", x.client_request_id)
  d.s("ContentDisposition", x.content_disposition)
  d.s("ContentEncoding", x.content_encoding)
  d.s("ContentLanguage", x.content_language)
  d.i("ContentLength", x.content_length)
  if let Some(b) = x.content_md5 { d.lines.push("ContentMD5=${b.quote()}") }
  d.s("ContentType", x.content_type)
  d.t("CopyCompletionTime", x.copy_completion_time)
  d.s("CopyID", x.copy_id)
  d.s("CopyProgress", x.copy_progress)
  d.s("CopySource", x.copy_source)
  d.s("CopyStatus", x.copy_status)
  d.s("CopyStatusDescription", x.copy_status_description)
  d.t("Date", x.date)
  d.s("ETag", x.etag)
  d.s("FileAttributes", x.file_attributes)
  d.t("FileChangeTime", x.file_change_time)
  d.t("FileCreationTime", x.file_creation_time)
  d.t("FileLastWriteTime", x.file_last_write_time)
  d.s("FileMode", x.file_mode)
  d.s("FilePermissionKey", x.file_permission_key)
  d.s("FileType", x.file_type)
  d.s("Group", x.group)
  d.s("ID", x.id)
  d.b("IsServerEncrypted", x.is_server_encrypted)
  d.t("LastModified", x.last_modified)
  d.s("LeaseDuration", x.lease_duration)
  d.s("LeaseState", x.lease_state)
  d.s("LeaseStatus", x.lease_status)
  d.i("LinkCount", x.link_count)
  d.s("LinkText", x.link_text)
  d.m("Metadata", if x.metadata.is_empty() { None } else { Some(x.metadata) })
  d.s("NFSFileType", x.nfs_file_type)
  d.s("Owner", x.owner)
  d.s("ParentID", x.parent_id)
  d.r(x.response)
  d
}

test "the file client sends what Go sends and reads what Go reads" {
  expect(file_run(os.net, os.clock, os.rand, [])?) == FILE_OUTPUT
}

test "the file client sends what Go sends and reads what Go reads, each response header field repeated" {
  // Go's program prints the same output when its fake answers every
  // header twice (the second field "zz"): Go reads the first field
  expect(file_run(os.net, os.clock, os.rand, [Doubling{}])?) == FILE_OUTPUT
}

fn file_run(net: testing.FakeNet, clock: Clock, rand: Rand, extra: List[policy.Policy]) -> List[Str] ! Str uses (net.dial, clock, rand) {
  let log = Mutex[List[Str]].new([])
  let h = fn(req: http.Request) -> http.Response {
    record(req, log)
    stamped(file_answer(req))
  }
  for m in ["GET", "PUT", "DELETE", "HEAD"] {
    for path in ["/{a}/{b}", "/{a}/{b}/{c}", "/{a}/{b}/{c}/{d}"] {
      net.handle("${m} ${EP}${path}", h)
    }
  }
  let cred = new_shared_key_credential("acct1", KEY)?
  let opts = ClientOptions{client: policy.ClientOptions{per_call_policies: [FileFixed{}], per_retry_policies: extra, retry: policy.RetryOptions{max_retries: -1}}}
  let sh = new_share_client_with_shared_key_credential(net, clock, rand, "${EP}/s1", cred, opts)
  let f = sh.new_directory_client("d1").new_file_client("f.txt")
  var out: List[Str] = []
  let take = fn() -> List[Str] {
    log.with(fn(var l: List[Str]) -> List[Str] {
      let xs = l
      l = []
      xs
    })
  }
  let add = fn(lines: List[Str]) -> List[Str] { take() + lines }
  let res = fn(name: Str, r: Result[FileResponse, azcore.CallErr]) -> List[Str] {
    match r {
      Ok(x) => file_dump(x).show(name)
      Err(e) => err_lines(name, e)
    }
  }
  let pick = fn(name: Str, r: Result[FileResponse, azcore.CallErr], get: fn(FileResponse) -> Str?) -> List[Str] {
    match r {
      Ok(x) => one(name, get(x))
      Err(e) => err_lines(name, e)
    }
  }
  let etag = fn(x: FileResponse) -> Str? { x.etag }
  // The times the Go program sends (all UTC).
  let t1 = Time.from_unix(1793494923) + Duration.from_nanos(123456700)
  let t2 = Time.from_unix(1793581323)
  let t3 = Time.from_unix(1793667723) + Duration.from_millis(500)
  let hh = HttpHeaders{cache_control: Some("no-cache"), content_disposition: Some("attachment"), content_encoding: Some("gzip"), content_language: Some("en"), content_md5: Some(b"\x01\x02\x03"), content_type: Some("text/plain")}
  let lease = Some("lease-1")

  out = out + add(res("f1 create with SMB properties, a permission and HTTP headers", f.create(1024, CreateFileOptions{
    smb_properties: Some(SmbProperties{attributes: Some(NtfsFileAttributes{read_only: true, archive: true}), creation_time: Some(t1), last_write_time: Some(t2), change_time: Some(t3)}),
    permissions: Some(Permissions{permission: Some("O:BAG:SYD:(A;;FA;;;SY)")}), http_headers: Some(hh), lease_id: lease,
    metadata: Some({"color": "blue"}), file_property_semantics: Some(FILE_PROPERTY_SEMANTICS_NEW), content_md5: Some(b"\x04\x05"),
  })))
  out = out + add(pick("f2 create with a permission and a key", f.create(5, CreateFileOptions{permissions: Some(Permissions{permission: Some("p"), permission_key: Some("4066*123")}), file_permission_format: Some(FILE_PERMISSION_FORMAT_BINARY)}), etag))
  out = out + add(pick("f2b create with a permission and a format", f.create(6, CreateFileOptions{permissions: Some(Permissions{permission: Some("p")}), file_permission_format: Some(FILE_PERMISSION_FORMAT_BINARY)}), etag))
  out = out + add(res("f3 create with NFS properties", f.create(7, CreateFileOptions{
    nfs_properties: Some(NfsProperties{creation_time: Some(t1), last_write_time: Some(t2), file_mode: Some("0644"), owner: Some("1000"), group: Some("1001")}),
    smb_properties: Some(SmbProperties{attributes: Some(NtfsFileAttributes{hidden: true})}), permissions: Some(Permissions{permission_key: Some("k")}),
    file_property_semantics: Some(FILE_PROPERTY_SEMANTICS_RESTORE), metadata: Some({"k": "v"}),
  })))
  out = out + add(pick("f4 create, no options", f.create(0), etag))
  out = out + add(res("f5 delete with a lease", f.delete(lease)))
  out = out + add(pick("f6 delete, no options", f.delete(), fn(x: FileResponse) -> Str? { x.response.request_id }))
  out = out + add(res("f7 properties", f.get_properties(Some("2026-11-05T01:00:00.0000000Z"), lease)))
  out = out + add(res("f8 set HTTP headers with SMB properties", f.set_http_headers(SetHttpHeadersOptions{
    file_content_length: Some(2048), smb_properties: Some(SmbProperties{attributes: Some(NtfsFileAttributes{none: true}), change_time: Some(t3)}),
    permissions: Some(Permissions{permission_key: Some("preserve")}), file_permission_format: Some(FILE_PERMISSION_FORMAT_BINARY), http_headers: Some(hh), lease_id: lease,
  })))
  out = out + add(pick("f9 set HTTP headers with a permission key", f.set_http_headers(SetHttpHeadersOptions{permissions: Some(Permissions{permission_key: Some("4066*123")}), file_permission_format: Some(FILE_PERMISSION_FORMAT_BINARY)}), etag))
  out = out + add(pick("f10 set HTTP headers with NFS properties", f.set_http_headers(SetHttpHeadersOptions{nfs_properties: Some(NfsProperties{last_write_time: Some(t2), file_mode: Some("0600"), owner: Some("0"), group: Some("0")}), smb_properties: Some(SmbProperties{change_time: Some(t3)}), file_content_length: Some(3)}), etag))
  out = out + add(pick("f11 set HTTP headers, no options", f.set_http_headers(), etag))
  out = out + add(res("f12 set metadata", f.set_metadata(Some({"a": "1"}), lease)))
  out = out + add(pick("f13 set metadata, no options", f.set_metadata(), etag))
  out = out + add(res("f14 start copy with SMB info", f.start_copy_from_url("http://src.example.test/s/f?sv=1", StartCopyFromUrlOptions{
    metadata: Some({"m": "1"}), permissions: Some(Permissions{permission: Some("p"), permission_key: Some("4066*123")}),
    copy_file_smb_info: Some(CopyFileSmbInfo{
      attributes: Some(CopyFileAttributes.Destination(NtfsFileAttributes{read_only: true, no_scrub_data: true})), creation_time: Some(CopyFileTime.Source),
      last_write_time: Some(CopyFileTime.Destination(t1)), change_time: Some(CopyFileTime.Source), permission_copy_mode: Some(PERMISSION_COPY_MODE_OVERRIDE),
      ignore_read_only: Some(true), set_archive_attribute: Some(false),
    }),
    lease_id: lease,
  })))
  let copy_id = fn(x: FileResponse) -> Str? { x.copy_id }
  let copy_status = fn(x: FileResponse) -> Str? { x.copy_status }
  out = out + add(pick("f15 start copy with NFS properties", f.start_copy_from_url("http://src.example.test/s/f", StartCopyFromUrlOptions{
    permissions: Some(Permissions{permission: Some("ignored")}),
    copy_file_nfs_properties: Some(CopyFileNfsProperties{creation_time: Some(CopyFileTime.Destination(t2)), last_write_time: Some(CopyFileTime.Source), file_mode: Some("0600"), owner: Some("1"), group: Some("2"), file_mode_copy_mode: Some(MODE_COPY_MODE_OVERRIDE), file_owner_copy_mode: Some(OWNER_COPY_MODE_SOURCE)}),
  }), copy_id))
  out = out + add(pick("f16 start copy, no options", f.start_copy_from_url("http://src.example.test/s/f"), copy_status))
  out = out + add(pick("f16b start copy, source attributes", f.start_copy_from_url("http://src.example.test/s/f", StartCopyFromUrlOptions{copy_file_smb_info: Some(CopyFileSmbInfo{attributes: Some(CopyFileAttributes.Source), creation_time: Some(CopyFileTime.Destination(t2)), change_time: Some(CopyFileTime.Destination(t3)), last_write_time: Some(CopyFileTime.Source)})}), copy_status))
  out = out + add(res("f17 abort copy", f.abort_copy("c-1", lease)))
  out = out + add(pick("f18 resize", f.resize(4096, lease), etag))
  out = out + add(pick("f18b resize, no options", f.resize(0), etag))
  let dots = new_share_client_with_shared_key_credential(net, clock, rand, "${EP}/s1", cred, opts with {allow_trailing_dot: Some(true), allow_source_trailing_dot: Some(true), file_request_intent: Some(TOKEN_INTENT_BACKUP)})
  let src = dots.new_root_directory_client().new_file_client("old.")
  out = out + add(res("f19 rename with options, trailing dots and an intent", src.rename(" /d2/new name.txt?sv=1 ", RenameFileOptions{
    smb_properties: Some(SmbProperties{attributes: Some(NtfsFileAttributes{temporary: true}), last_write_time: Some(t2)}),
    permissions: Some(Permissions{permission: Some("p")}), file_permission_format: Some(FILE_PERMISSION_FORMAT_BINARY), content_type: Some("text/csv"),
    ignore_read_only: Some(false), metadata: Some({"m": "2"}), replace_if_exists: Some(true), source_lease_id: Some("lease-s"), destination_lease_id: Some("lease-d"),
  })))
  out = out + add(pick("f19b start copy with trailing dots", src.start_copy_from_url("http://src.example.test/s/f."), copy_id))
  out = out + add(pick("f20 rename, key preserve", f.rename("f2.txt", RenameFileOptions{permissions: Some(Permissions{permission_key: Some("preserve")}), file_permission_format: Some(FILE_PERMISSION_FORMAT_BINARY)}), etag))
  out = out + add(pick("f20b rename, a key", f.rename("f2.txt", RenameFileOptions{permissions: Some(Permissions{permission_key: Some("k")})}), etag))
  out = out + add(pick("f20c rename, no options", f.rename("f2.txt"), etag))
  out = out + add(match f.rename("//") {
    Ok(_) => ["== f20d rename to nothing", "  no error"]
    Err(azcore.CallErr.InvalidInput(m)) => ["== f20d rename to nothing", "  error ${m}"]
    Err(e) => err_lines("f20d rename to nothing", e)
  })
  out = out + add(match src.list_handles(ListFileHandlesOptions{marker: Some("m"), max_results: Some(3), share_snapshot: Some("2026-11-05T01:00:00.0000000Z")}) {
    Ok(page) => handles_dump(page).show("f21 list handles")
    Err(e) => err_lines("f21", e)
  })
  let fc_dump = fn(name: Str, r: Result[ForceCloseHandlesResponse, azcore.CallErr]) -> List[Str] {
    match r {
      Ok(x) => {
        var dd = Dump{}
        dd.t("Date", x.date)
        dd.s("Marker", x.marker)
        dd.i("NumberOfHandlesClosed", x.number_of_handles_closed)
        dd.i("NumberOfHandlesFailedToClose", x.number_of_handles_failed_to_close)
        dd.r(x.response)
        dd.show(name)
      }
      Err(e) => err_lines(name, e)
    }
  }
  out = out + add(fc_dump("f22 force close handles", src.force_close_handles("h1", ForceCloseFileHandlesOptions{marker: Some("fm0"), share_snapshot: Some("2026-11-05T01:00:00.0000000Z")})))
  out = out + add(match f.force_close_handles("*") {
    Ok(x) => one("f22b force close handles, no options", x.marker)
    Err(e) => err_lines("f22b", e)
  })
  out = out + add(res("f23 create a hard link", src.create_hard_link("d1/target.txt", lease)))
  out = out + add(pick("f23b create a hard link, no options", f.create_hard_link("t"), etag))
  out = out + add(res("f24 create a symbolic link", src.create_symbolic_link("../t x", CreateSymbolicLinkOptions{
    lease_id: lease, nfs_properties: Some(NfsProperties{creation_time: Some(t1), last_write_time: Some(t2), file_mode: Some("0777"), owner: Some("5"), group: Some("6")}), metadata: Some({"s": "1"}),
  })))
  out = out + add(pick("f24b create a symbolic link, metadata without NFS", f.create_symbolic_link("t", CreateSymbolicLinkOptions{metadata: Some({"dropped": "1"}), lease_id: lease}), etag))
  out = out + add(pick("f24c create a symbolic link, no options", f.create_symbolic_link("t"), etag))
  out = out + add(res("f25 get a symbolic link", src.get_symbolic_link(Some("2026-11-05T01:00:00.0000000Z"))))
  out = out + add(pick("f25b get a symbolic link, no options", f.get_symbolic_link(), fn(x: FileResponse) -> Str? { x.link_text }))
  let cs = new_file_client_from_connection_string(net, clock, rand, "DefaultEndpointsProtocol=http;AccountName=acct1;AccountKey=${KEY};FileEndpoint=${EP}/", "s1", "d1\\a b\\f.txt", opts)?
  out = out + ["== f26 urls", "  ${f.url}", "  ${src.url}", "  ${cs.url}"]
  out = out + add(pick("f27 delete from a connection string client", cs.delete(), fn(x: FileResponse) -> Str? { x.response.request_id }))
  Ok(out)
}
