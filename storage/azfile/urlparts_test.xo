// parse_url and URLParts.to_url against Go's sas.ParseURL and
// URLParts.String (urlvectors_test.xo): IP hosts as Go's
// IsIPEndpointStyle sees them, Go's host, port and escape errors, the
// path escaped as url.URL writes it, and the query read as URL.Query.

use github.com/xo-lang/azure/azcore

test "parse_url and to_url are Go's sas.ParseURL and URLParts.String" {
  var out: List[Str] = []
  for (name, u) in URL_CASES {
    out.push("== ${name}")
    match parse_url(u) {
      Ok(up) => {
        out.push("  scheme=${azcore.go_quote(up.scheme)} host=${azcore.go_quote(up.host)} ip_account=${azcore.go_quote(up.ip_account_name)} share=${azcore.go_quote(up.share_name)} path=${azcore.go_quote(up.directory_or_file_path)} snapshot=${azcore.go_quote(up.share_snapshot)} unparsed=${azcore.go_quote(up.unparsed_params)}")
        out.push("  encode=${azcore.go_quote(up.sas.encode())}")
        out.push("  string=${azcore.go_quote(up.to_url())}")
      }
      Err(e) => out.push("  error ${e}")
    }
  }
  out.push("== built")
  for up in url_built_cases() {
    out.push("  ${azcore.go_quote(up.to_url())}")
  }
  expect(out) == URL_OUTPUT
}

test "a query of more than 10000 pairs reads as none, as Go's URL.Query" {
  // A local Go program on azfile v1.7.1: 10000 pairs give 39999 bytes
  // of unparsed parameters ending in &b=2, 10001 give none.
  let at = parse_url("https://acct1.file.example.test/s1?" + "a=1&".repeat(9999) + "b=2")?
  expect(at.unparsed_params.len()) == 39999
  expect(at.unparsed_params.ends_with("&b=2")) == true
  let over = parse_url("https://acct1.file.example.test/s1?" + "a=1&".repeat(10000) + "b=2")?
  expect(over.unparsed_params) == ""
}
