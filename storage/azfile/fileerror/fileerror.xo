// The File service's error codes, as azfile's fileerror package
// (error_codes.go; MIT, Copyright (c) Microsoft Corporation; NOTICE.md).

use github.com/xo-lang/azure/azcore

/// Whether `err` is a response whose error code is one of `codes`
/// (fileerror.HasCode).
pub fn has_code(err: azcore.CallErr, codes: List[Str]) -> Bool {
  match err {
    Response(r) => codes.contains(r.error_code)
    _ => false
  }
}

/// A SAS URL asked of a client without an account key
/// (fileerror.MissingSharedKeyCredential).
pub const MISSING_SHARED_KEY_CREDENTIAL: Str = "SAS can only be signed with a SharedKeyCredential"

