// An access policy's times against Go v2.1.2's generated
// dateTimeRFC3339 (timevectors_test.xo): the inputs are the ones in
// those lines; an error is compared up to Go's ": cannot parse" tail.

use std/json
use std/time

test "access policy times read as Go v2.1.2's dateTimeRFC3339" {
  var got: List[Str] = []
  var want: List[Str] = []
  for l in TIME_OUTPUT {
    let end = l.find(" => ") ?? l.len()
    let q = l[5..end]
    let input = json.decode_str[Str](q)?
    got.push(match rfc3339_strict(input) {
      Ok(t) => "TIME ${q} => ${time.format(t, time.utc(), time.RFC3339)}"
      Err(e) => "TIME ${q} => error ${e}"
    })
    want.push(if l.contains("parsing time") { l.split(": cannot parse")[0] } else { l })
  }
  expect(got) == want
}
