// Azure Queue Storage, as azqueue v1.0.1 (MIT, Copyright (c) Microsoft
// Corporation; NOTICE.md): the ServiceClient and QueueClient over the
// REST API version 2024-08-04, their options and responses, connection
// strings and URL parts. The Shared Key credential and policy are
// azblob's (`exported`), signing with azqueue's byte-order header sort.

use std/http
use std/time
use std/url
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/policy
use github.com/xo-lang/azure/runtime
use github.com/xo-lang/azure/storage/azblob
use github.com/xo-lang/azure/storage/azblob/exported
use github.com/xo-lang/azure/storage/azqueue/sas

pub const VERSION: Str = "v0.1.0"

/// The REST API version the calls are written for (azqueue v1.0.1's).
pub const SERVICE_VERSION: Str = "2024-08-04"

/// The scope of a token for Storage.
pub const TOKEN_SCOPE: Str = "https://storage.azure.com/.default"

pub type SharedKeyCredential = exported.SharedKeyCredential

/// The credential of `account_name` with `account_key` (base64).
pub fn new_shared_key_credential(account_name: Str, account_key: Str) -> SharedKeyCredential ! Str {
  exported.new_shared_key_credential(account_name, account_key)
}

pub struct ClientOptions {
  pub client: policy.ClientOptions = policy.ClientOptions{}
  /// The token audience (`<audience>/.default`) when it is not
  /// Storage's (base.ClientOptions.Audience). As in Go, only
  /// new_queue_client reads it: new_service_client (and the queue
  /// clients it makes) ask for Storage's scope.
  pub audience: Str = ""
  /// Sends a token over plain http (Go's
  /// azcore.ClientOptions.InsecureAllowCredentialWithHTTP); for local
  /// fakes and emulators only.
  pub insecure_allow_credential_with_http: Bool = false
}

/// What both clients share: the pipeline, and the key for SAS URLs.
struct Core {
  url: Str
  pipeline: runtime.Pipeline
  cred: SharedKeyCredential?
}

fn pipeline(net: Net, clock: Clock, rand: Rand, auth: List[policy.Policy], opts: ClientOptions) -> runtime.Pipeline {
  runtime.new_pipeline("azqueue", VERSION, net, clock, rand, runtime.PipelineOptions{per_call: [azblob.VersionPolicy{version: SERVICE_VERSION}], per_retry: auth}, opts.client)
}

fn shared_key(cred: SharedKeyCredential, clock: Clock) -> policy.Policy {
  exported.SharedKeyPolicy{credential: cred, clock: clock, plain_header_order: true}
}

fn core_with_shared_key(net: Net, clock: Clock, rand: Rand, u: Str, cred: SharedKeyCredential, opts: ClientOptions) -> Core {
  Core{url: u, pipeline: pipeline(net, clock, rand, [shared_key(cred, clock)], opts), cred: Some(cred)}
}

/// The token scope (base.GetAudience).
fn audience_scope(opts: ClientOptions) -> Str {
  if opts.audience.trim() == "" { TOKEN_SCOPE } else { "${opts.audience.trim_end_chars("/")}/.default" }
}

/// A service client's token policy (NewServiceClient): Storage's scope,
/// whatever the audience, and no challenge handling, as Go.
fn service_core_with_token(net: Net, clock: Clock, rand: Rand, u: Str, cred: azcore.TokenCredential, opts: ClientOptions) -> Core {
  let bp = runtime.new_bearer_token_policy(cred, [TOKEN_SCOPE], clock, runtime.BearerTokenOptions{insecure_allow_credential_with_http: opts.insecure_allow_credential_with_http})
  Core{url: u, pipeline: pipeline(net, clock, rand, [bp], opts), cred: None}
}

/// A queue client's token policy (NewQueueClient): the storage
/// challenge policy for the audience.
fn queue_core_with_token(net: Net, clock: Clock, rand: Rand, u: Str, cred: azcore.TokenCredential, opts: ClientOptions) -> Core {
  let cp = exported.new_storage_challenge_policy(cred, audience_scope(opts), clock, allow_http: opts.insecure_allow_credential_with_http)
  Core{url: u, pipeline: pipeline(net, clock, rand, [cp], opts), cred: None}
}

fn core_with_no_credential(net: Net, clock: Clock, rand: Rand, u: Str, opts: ClientOptions) -> Core {
  Core{url: u, pipeline: pipeline(net, clock, rand, [], opts), cred: None}
}

/// `base` with `segment` joined to its path, its query kept
/// (runtime.JoinPaths).
fn join_paths(base: Str, segment: Str) -> Str {
  let (path, query) = match base.find("?") {
    Some(i) => (base[0..i], base[i..base.len()])
    None => (base, "")
  }
  "${path.trim_end_chars("/")}/${segment}${query}"
}

/// `u` with `query` merged into the query it has, the keys sorted as Go's
/// url.Values.Encode sorts them.
fn with_query(u: Str, query: List[(Str, Str)]) -> Str {
  let (base, raw) = match u.find("?") {
    Some(i) => (u[0..i], u[i + 1..u.len()])
    None => (u, "")
  }
  var v = url.parse_query(raw).ok() ?? url.values()
  for (k, x) in query {
    v.set(k, x)
  }
  let q = v.encode()
  if q == "" { base } else { "${base}?${q}" }
}

fn (c: Core) call(method: Str, u: Str, ok: List[Int], headers: List[(Str, Str)] = [], body: Str? = None) -> http.Response ! azcore.CallErr uses (net.dial, clock, rand) {
  var hs = headers + [("Accept", "application/xml")]
  var b = b""
  if let Some(x) = body {
    hs.push(("Content-Type", "application/xml"))
    b = x.bytes()
  }
  let req = policy.Request{method: method, url: u, headers: hs, body: b}
  let resp = c.pipeline.send(req) ?? e => return Err(azcore.CallErr.Send(e))
  if !ok.contains(resp.status) {
    return Err(azcore.CallErr.Response(azcore.response_error(method, u, resp)))
  }
  Ok(resp)
}

fn meta_headers(metadata: Map[Str, Str]) -> List[(Str, Str)] {
  var hs: List[(Str, Str)] = []
  for k in metadata.keys().sort() {
    hs.push(("x-ms-meta-${k}", metadata.get(k) ?? ""))
  }
  hs
}

/// `x-ms-meta-*` response headers, prefix removed, names as they came.
fn metadata_of(resp: http.Response) -> Map[Str, Str] {
  var m: Map[Str, Str] = {}
  for (k, v) in resp.headers {
    if k.to_lower().starts_with("x-ms-meta-") {
      m[k[10..k.len()]] = v
    }
  }
  m
}

/// An HTTP date (`Thu, 05 Nov 2026 03:04:05 GMT`) as a Time.
fn rfc1123(v: Str) -> Time? {
  if v == "" {
    return None
  }
  time.parse(v.replace(" GMT", " UTC"), time.RFC1123, time.utc()).ok()
}

/// An ISO 8601 time (`2026-11-05T00:00:00.0000000Z`) as a Time, as Go's
/// generated timeRFC3339 reads it: upper-cased, UTC when it has no zone.
fn rfc3339(v: Str) -> Time? {
  rfc3339_strict(v).ok()
}

/// As rfc3339, with Go's error up to the layout (an empty text is one).
fn rfc3339_strict(v: Str) -> Time ! Str {
  let u = v.to_upper()
  let tz = tz_offset(u)
  let layout = if tz { "2006-01-02T15:04:05.999999999Z07:00" } else { "2006-01-02T15:04:05.999999999" }
  let t = Time.parse_rfc3339(if tz { u } else { "${u}Z" }) ?? return Err("parsing time ${go_quote(u)} as ${go_quote(layout)}")
  Ok(t)
}

/// Go's tzOffsetRegex, `(Z|z|\+|-)(\d+:\d+)*"*$`, on upper-cased text.
fn tz_offset(v: Str) -> Bool {
  var s = v.trim_end_chars("\"")
  while {
    let bs = s.bytes()
    let n = bs.len()
    var i = n
    while i > 0 && bs[i - 1] >= 0x30 && bs[i - 1] <= 0x39 { i = i - 1 }
    if i == n || i == 0 || bs[i - 1] != 0x3a {
      break
    }
    var j = i - 1
    while j > 0 && bs[j - 1] >= 0x30 && bs[j - 1] <= 0x39 { j = j - 1 }
    if j == i - 1 {
      break
    }
    s = s[0..j]
  }
  s.ends_with("Z") || s.ends_with("+") || s.ends_with("-")
}

/// What every call returns: the service's request ID, version and date.
pub struct Response {
  pub request_id: Str = ""
  pub version: Str = ""
  pub date: Time? = None
}

fn response_of(resp: http.Response) -> Response {
  Response{request_id: resp.header("x-ms-request-id") ?? "", version: resp.header("x-ms-version") ?? "", date: rfc1123(resp.header("Date") ?? "")}
}

/// Go's error for an HTTP date that does not parse. (Go's goes on to say
/// which part did not parse; this one stops at the layout.)
fn rfc1123_err(v: Str) -> Str {
  "parsing time ${go_quote(v)} as \"Mon, 02 Jan 2006 15:04:05 MST\""
}

/// A header's HTTP date as Go's generated handlers read it: None when the
/// header is absent or empty, an error when it does not parse.
fn strict_time(resp: http.Response, name: Str) -> Time? ! azcore.CallErr {
  let v = resp.header(name) ?? ""
  if v == "" {
    return Ok(None)
  }
  match rfc1123(v) {
    Some(t) => Ok(Some(t))
    None => Err(azcore.CallErr.Decode(rfc1123_err(v)))
  }
}

/// The response as the calls whose Go response has a Date read it: a Date
/// that does not parse fails the call, as in Go. (Go's service properties
/// calls read no Date; they use response_of.)
fn strict_response(resp: http.Response) -> Response ! azcore.CallErr {
  let date = strict_time(resp, "Date")?
  Ok(response_of(resp) with {date: date})
}

/// Go's strconv.Quote of ASCII text.
fn go_quote(s: Str) -> Str {
  var out = "\""
  for c in s.runes() {
    out = out + (if c == '"' { "\\\"" } else if c == '\\' { "\\\\" } else { "${c}" })
  }
  out + "\""
}

/// A parsed connection string: the service URL (with the SAS when it
/// has one) and the account key.
pub struct ParsedConnectionString {
  pub service_url: Str
  pub account_name: Str = ""
  pub account_key: Str = ""
}

/// Parses a storage connection string as azqueue does: `QueueEndpoint`
/// or `AccountName` (with `DefaultEndpointsProtocol` and
/// `EndpointSuffix`), and `AccountKey` or `SharedAccessSignature`.
pub fn parse_connection_string(connection_string: Str) -> ParsedConnectionString ! Str {
  let malformed = "connection string is either blank or malformed. The expected connection string should contain key value pairs separated by semicolons. For example 'DefaultEndpointsProtocol=https;AccountName=<accountName>;AccountKey=<accountKey>;EndpointSuffix=core.windows.net'"
  var m: Map[Str, Str] = {}
  for part in connection_string.trim_end_chars(";").split(";") {
    let i = part.find("=") ?? return Err(malformed)
    m[part[0..i]] = part[i + 1..part.len()]
  }
  let protocol = m.get("DefaultEndpointsProtocol") ?? "https"
  let suffix = m.get("EndpointSuffix") ?? "core.windows.net"
  var service_url = match (m.get("QueueEndpoint"), m.get("AccountName")) {
    (Some(e), _) => e
    (None, Some(a)) => "${protocol}://${a}.queue.${suffix}"
    _ => return Err("connection string needs either AccountName or QueueEndpoint")
  }
  if !service_url.ends_with("/") {
    service_url = service_url + "/"
  }
  match (m.get("AccountName"), m.get("AccountKey"), m.get("SharedAccessSignature")) {
    (Some(a), Some(k), _) => Ok(ParsedConnectionString{service_url: service_url, account_name: a, account_key: k})
    (_, _, Some(s)) => Ok(ParsedConnectionString{service_url: "${service_url}?${s}"})
    _ => Err("connection string needs either AccountKey or SharedAccessSignature")
  }
}

/// A queue URL's parts (azqueue.URLParts, an alias of sas.URLParts).
pub type URLParts = sas.URLParts

/// The parts of `u` (azqueue.ParseURL, which is sas.ParseURL).
pub fn parse_url(u: Str) -> URLParts ! Str {
  sas.parse_url(u)
}
