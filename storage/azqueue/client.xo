// The ServiceClient and QueueClient, as azqueue's service_client.go,
// queue_client.go and models.go (MIT, Copyright (c) Microsoft
// Corporation; NOTICE.md), with the requests of its generated clients:
// the query in Go's sorted order, `Accept: application/xml`, and the
// option defaults its format() functions fill in.

use std/http
use std/url
use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/policy
use github.com/xo-lang/azure/runtime
use github.com/xo-lang/azure/storage/azqueue/queueerror
use github.com/xo-lang/azure/storage/azqueue/sas

/// A client of one storage account's Queue service.
pub struct ServiceClient {
  /// The service URL (`https://<account>.queue.core.windows.net/`), with
  /// a SAS query when the client has no credential.
  pub url: Str
  core: Core
}

/// A client of one queue.
pub struct QueueClient {
  /// The queue's URL.
  pub url: Str
  core: Core
}

fn service(c: Core) -> ServiceClient {
  ServiceClient{url: c.url, core: c}
}

fn queue(c: Core) -> QueueClient {
  QueueClient{url: c.url, core: c}
}

/// A service client with Entra ID tokens (azqueue.NewServiceClient).
pub fn new_service_client(net: Net, clock: Clock, rand: Rand, service_url: Str, cred: azcore.TokenCredential, options: ClientOptions = ClientOptions{}) -> ServiceClient {
  service(service_core_with_token(net, clock, rand, service_url, cred, options))
}

/// A service client with the account key.
pub fn new_service_client_with_shared_key_credential(net: Net, clock: Clock, rand: Rand, service_url: Str, cred: SharedKeyCredential, options: ClientOptions = ClientOptions{}) -> ServiceClient {
  service(core_with_shared_key(net, clock, rand, service_url, cred, options))
}

/// A service client with no credential: a SAS in `service_url`.
pub fn new_service_client_with_no_credential(net: Net, clock: Clock, rand: Rand, service_url: Str, options: ClientOptions = ClientOptions{}) -> ServiceClient {
  service(core_with_no_credential(net, clock, rand, service_url, options))
}

/// A service client from a connection string with a key or a SAS.
pub fn new_service_client_from_connection_string(net: Net, clock: Clock, rand: Rand, connection_string: Str, options: ClientOptions = ClientOptions{}) -> ServiceClient ! Str {
  let p = parse_connection_string(connection_string)?
  if p.account_key != "" && p.account_name != "" {
    return Ok(new_service_client_with_shared_key_credential(net, clock, rand, p.service_url, new_shared_key_credential(p.account_name, p.account_key)?, options))
  }
  Ok(new_service_client_with_no_credential(net, clock, rand, p.service_url, options))
}

/// A queue client with Entra ID tokens (azqueue.NewQueueClient).
pub fn new_queue_client(net: Net, clock: Clock, rand: Rand, queue_url: Str, cred: azcore.TokenCredential, options: ClientOptions = ClientOptions{}) -> QueueClient {
  queue(queue_core_with_token(net, clock, rand, queue_url, cred, options))
}

pub fn new_queue_client_with_shared_key_credential(net: Net, clock: Clock, rand: Rand, queue_url: Str, cred: SharedKeyCredential, options: ClientOptions = ClientOptions{}) -> QueueClient {
  queue(core_with_shared_key(net, clock, rand, queue_url, cred, options))
}

pub fn new_queue_client_with_no_credential(net: Net, clock: Clock, rand: Rand, queue_url: Str, options: ClientOptions = ClientOptions{}) -> QueueClient {
  queue(core_with_no_credential(net, clock, rand, queue_url, options))
}

pub fn new_queue_client_from_connection_string(net: Net, clock: Clock, rand: Rand, connection_string: Str, queue_name: Str, options: ClientOptions = ClientOptions{}) -> QueueClient ! Str {
  let p = parse_connection_string(connection_string)?
  let u = join_paths(p.service_url, queue_name)
  if p.account_key != "" && p.account_name != "" {
    return Ok(new_queue_client_with_shared_key_credential(net, clock, rand, u, new_shared_key_credential(p.account_name, p.account_key)?, options))
  }
  Ok(new_queue_client_with_no_credential(net, clock, rand, u, options))
}

fn decoded[T](resp: http.Response, parse: fn(Str) -> T ! Str) -> T ! azcore.CallErr {
  parse(resp.body.to_str_lossy()) ?? e => Err(azcore.CallErr.Decode(e))
}

// The service.

pub struct GetServicePropertiesResponse {
  pub response: Response
  pub properties: StorageServiceProperties
}

pub fn (s: ServiceClient) get_service_properties() -> GetServicePropertiesResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let resp = s.core.call("GET", with_query(s.url, [("comp", "properties"), ("restype", "service")]), [200])?
  Ok(GetServicePropertiesResponse{response: response_of(resp), properties: decoded(resp, parse_properties)?})
}

/// Sets the service's properties; versions default to "1.0" and a CORS
/// rule's headers to "" and its max age to 0, as Go's format() fills
/// them.
pub fn (s: ServiceClient) set_properties(options: StorageServiceProperties = StorageServiceProperties{}) -> Response ! azcore.CallErr uses (net.dial, clock, rand) {
  let ver = fn(v: Str?) -> Str? { Some(v ?? "1.0") }
  let p = StorageServiceProperties{
    cors: options.cors.map(fn(rs: List[CorsRule]) -> List[CorsRule] {
      rs.map(fn(r: CorsRule) -> CorsRule { r with {allowed_headers: Some(r.allowed_headers ?? ""), exposed_headers: Some(r.exposed_headers ?? ""), max_age_in_seconds: Some(r.max_age_in_seconds ?? 0)} })
    }),
    hour_metrics: options.hour_metrics.map(fn(m: Metrics) -> Metrics { m with {version: ver(m.version)} }),
    logging: options.logging.map(fn(l: Logging) -> Logging { l with {version: ver(l.version)} }),
    minute_metrics: options.minute_metrics.map(fn(m: Metrics) -> Metrics { m with {version: ver(m.version)} }),
  }
  let resp = s.core.call("PUT", with_query(s.url, [("comp", "properties"), ("restype", "service")]), [202], body: Some(properties_xml(p)))?
  Ok(response_of(resp))
}

pub struct GetStatisticsResponse {
  pub response: Response
  pub stats: StorageServiceStats
}

pub fn (s: ServiceClient) get_statistics() -> GetStatisticsResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let resp = s.core.call("GET", with_query(s.url, [("comp", "stats"), ("restype", "service")]), [200])?
  Ok(GetStatisticsResponse{response: strict_response(resp)?, stats: decoded(resp, parse_stats)?})
}

pub struct ListQueuesOptions {
  pub include_metadata: Bool = false
  pub marker: Str? = None
  pub max_results: Int? = None
  pub prefix: Str? = None
}

fn list_url(base: Str, o: ListQueuesOptions, marker: Str?) -> Str {
  var q = [("comp", "list")]
  if o.include_metadata { q.push(("include", "metadata")) }
  if let Some(m) = marker { q.push(("marker", m)) }
  if let Some(n) = o.max_results { q.push(("maxresults", "${n}")) }
  if let Some(p) = o.prefix { q.push(("prefix", p)) }
  with_query(base, q)
}

/// The account's queues, a page a call (Go's NewListQueuesPager): the
/// next page asks from the last one's NextMarker until it is empty.
pub fn (s: ServiceClient) new_list_queues_pager(options: ListQueuesOptions = ListQueuesOptions{}) -> runtime.Pager[ListQueuesSegmentResponse] {
  let base = s.url
  runtime.new_pager_with(s.core.pipeline, policy.Request{method: "GET", url: list_url(base, options, options.marker), headers: [("Accept", "application/xml")]}, fn(r: http.Response) -> ListQueuesSegmentResponse ! Str {
    let resp = strict_response(r) ?? e => return Err(match e {
      Decode(m) => m
      _ => e.display()
    })
    Ok(parse_queues(r.body.to_str_lossy())? with {response: resp})
  }, fn(prev: policy.Request, page: ListQueuesSegmentResponse) -> policy.Request? {
    let m = page.next_marker ?? return None
    if m == "" {
      return None
    }
    Some(prev with {url: list_url(base, options, Some(m))})
  })
}

/// A client of the queue `queue_name` on the same pipeline.
pub fn (s: ServiceClient) new_queue_client(queue_name: Str) -> QueueClient {
  // Go escapes the name (url.PathEscape) before joining it.
  queue(s.core with {url: join_paths(s.url, url.path_escape(queue_name))})
}

pub fn (s: ServiceClient) create_queue(queue_name: Str, options: CreateOptions = CreateOptions{}) -> Response ! azcore.CallErr uses (net.dial, clock, rand) {
  s.new_queue_client(queue_name).create(options)
}

pub fn (s: ServiceClient) delete_queue(queue_name: Str) -> Response ! azcore.CallErr uses (net.dial, clock, rand) {
  s.new_queue_client(queue_name).delete()
}

/// An account SAS URL for the Queue service, over HTTPS, signed with the
/// client's account key (Go's GetSASURL). `permissions` and
/// `resource_types` are letters of `rwdxylacuptfi` and `sco`.
pub fn (s: ServiceClient) get_sas_url(resource_types: Str, permissions: Str, expiry: Time, start: Time? = None) -> Str ! Str {
  let cred = s.core.cred ?? return Err(queueerror.MISSING_SHARED_KEY_CREDENTIAL)
  let qps = sas.AccountSignatureValues{version: sas.VERSION, protocol: sas.PROTOCOL_HTTPS, start: start, expiry: Some(expiry), permissions: permissions, resource_types: resource_types}.sign_with_shared_key(cred)?
  let base = s.url.trim_end_chars("/")
  Ok("${base}/?${qps.encode()}")
}

// The queue.

pub struct CreateOptions {
  pub metadata: Map[Str, Str] = {}
}

/// Creates the queue (201, or 204 when it exists with the same metadata).
pub fn (q: QueueClient) create(options: CreateOptions = CreateOptions{}) -> Response ! azcore.CallErr uses (net.dial, clock, rand) {
  strict_response(q.core.call("PUT", q.url, [201, 204], headers: meta_headers(options.metadata))?)
}

pub fn (q: QueueClient) delete() -> Response ! azcore.CallErr uses (net.dial, clock, rand) {
  strict_response(q.core.call("DELETE", q.url, [204])?)
}

/// Replaces the queue's metadata.
pub fn (q: QueueClient) set_metadata(metadata: Map[Str, Str] = {}) -> Response ! azcore.CallErr uses (net.dial, clock, rand) {
  strict_response(q.core.call("PUT", with_query(q.url, [("comp", "metadata")]), [204], headers: meta_headers(metadata))?)
}

pub struct GetQueuePropertiesResponse {
  pub response: Response
  /// Names as the service sent them (Go canonicalizes them: `Color`).
  pub metadata: Map[Str, Str] = {}
  pub approximate_messages_count: Int? = None
}

pub fn (q: QueueClient) get_properties() -> GetQueuePropertiesResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let resp = q.core.call("GET", with_query(q.url, [("comp", "metadata")]), [200])?
  let r = strict_response(resp)?
  let count = match resp.header("x-ms-approximate-messages-count") {
    Some(v) if v != "" => Some(Int.parse(v) ?? return Err(azcore.CallErr.Decode("strconv.ParseInt: parsing ${go_quote(v)}: invalid syntax")))
    _ => None
  }
  Ok(GetQueuePropertiesResponse{response: r, metadata: metadata_of(resp), approximate_messages_count: count})
}

pub struct GetAccessPolicyResponse {
  pub response: Response
  pub signed_identifiers: List[SignedIdentifier] = []
}

pub fn (q: QueueClient) get_access_policy() -> GetAccessPolicyResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let resp = q.core.call("GET", with_query(q.url, [("comp", "acl")]), [200])?
  Ok(GetAccessPolicyResponse{response: strict_response(resp)?, signed_identifiers: decoded(resp, parse_signed_identifiers)?})
}

/// Replaces the queue's stored access policies.
pub fn (q: QueueClient) set_access_policy(queue_acl: List[SignedIdentifier] = []) -> Response ! azcore.CallErr uses (net.dial, clock, rand) {
  strict_response(q.core.call("PUT", with_query(q.url, [("comp", "acl")]), [204], body: Some(signed_identifiers_xml(queue_acl)))?)
}

pub struct EnqueueMessageOptions {
  /// Seconds the message lives; -1 for never expiring.
  pub time_to_live: Int? = None
  /// Seconds before it becomes visible.
  pub visibility_timeout: Int? = None
}

pub struct EnqueueMessagesResponse {
  pub response: Response
  pub messages: List[EnqueuedMessage] = []
}

fn messages_url(q: QueueClient) -> Str {
  join_paths(q.url, "messages")
}

/// A message's URL, as Go's getMessageIDURL: runtime.JoinPaths(url,
/// "messages", id), the two cleaned together (path.Join), so an empty
/// id is the messages URL and `..` steps out of it.
fn message_id_url(q: QueueClient, message_id: Str) -> Str {
  join_paths(q.url, if message_id == "" { "messages" } else { "messages/${message_id}" })
}

pub fn (q: QueueClient) enqueue_message(content: Str, options: EnqueueMessageOptions = EnqueueMessageOptions{}) -> EnqueueMessagesResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  var qp: List[(Str, Str)] = []
  if let Some(t) = options.time_to_live { qp.push(("messagettl", "${t}")) }
  if let Some(v) = options.visibility_timeout { qp.push(("visibilitytimeout", "${v}")) }
  let resp = q.core.call("POST", with_query(messages_url(q), qp), [201], body: Some(queue_message_xml(content)))?
  Ok(EnqueueMessagesResponse{response: strict_response(resp)?, messages: decoded(resp, parse_enqueued)?})
}

pub struct DequeueMessagesOptions {
  /// 1 to 32; the service's default (1) when None.
  pub number_of_messages: Int? = None
  /// Seconds the messages stay hidden.
  pub visibility_timeout: Int? = None
}

pub struct DequeueMessagesResponse {
  pub response: Response
  pub messages: List[DequeuedMessage] = []
}

/// One message (number of messages 1, as Go's DequeueMessage sends).
pub fn (q: QueueClient) dequeue_message(visibility_timeout: Int? = None) -> DequeueMessagesResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  q.dequeue_messages(DequeueMessagesOptions{number_of_messages: Some(1), visibility_timeout: visibility_timeout})
}

pub fn (q: QueueClient) dequeue_messages(options: DequeueMessagesOptions = DequeueMessagesOptions{}) -> DequeueMessagesResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  var qp: List[(Str, Str)] = []
  if let Some(n) = options.number_of_messages { qp.push(("numofmessages", "${n}")) }
  if let Some(v) = options.visibility_timeout { qp.push(("visibilitytimeout", "${v}")) }
  let resp = q.core.call("GET", with_query(messages_url(q), qp), [200])?
  Ok(DequeueMessagesResponse{response: strict_response(resp)?, messages: decoded(resp, parse_dequeued)?})
}

pub struct UpdateMessageResponse {
  pub response: Response
  pub pop_receipt: Str? = None
  pub time_next_visible: Time? = None
}

/// Replaces a message's text and hides it for `visibility_timeout`
/// seconds (0 by default, as Go's format() sets). The message id joins
/// the path as given, as Go's JoinPaths does.
pub fn (q: QueueClient) update_message(message_id: Str, pop_receipt: Str, content: Str, visibility_timeout: Int = 0) -> UpdateMessageResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  let u = with_query(message_id_url(q, message_id), [("popreceipt", pop_receipt), ("visibilitytimeout", "${visibility_timeout}")])
  let resp = q.core.call("PUT", u, [204], body: Some(queue_message_xml(content)))?
  let r = strict_response(resp)?
  Ok(UpdateMessageResponse{response: r, pop_receipt: resp.header("x-ms-popreceipt"), time_next_visible: strict_time(resp, "x-ms-time-next-visible")?})
}

pub fn (q: QueueClient) delete_message(message_id: Str, pop_receipt: Str) -> Response ! azcore.CallErr uses (net.dial, clock, rand) {
  strict_response(q.core.call("DELETE", with_query(message_id_url(q, message_id), [("popreceipt", pop_receipt)]), [204])?)
}

pub struct PeekMessagesResponse {
  pub response: Response
  pub messages: List[PeekedMessage] = []
}

/// One message without hiding it (number of messages 1).
pub fn (q: QueueClient) peek_message() -> PeekMessagesResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  q.peek_messages(Some(1))
}

pub fn (q: QueueClient) peek_messages(number_of_messages: Int? = None) -> PeekMessagesResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  var qp = [("peekonly", "true")]
  if let Some(n) = number_of_messages { qp.push(("numofmessages", "${n}")) }
  let resp = q.core.call("GET", with_query(messages_url(q), qp), [200])?
  Ok(PeekMessagesResponse{response: strict_response(resp)?, messages: decoded(resp, parse_peeked)?})
}

/// Deletes every message.
pub fn (q: QueueClient) clear_messages() -> Response ! azcore.CallErr uses (net.dial, clock, rand) {
  strict_response(q.core.call("DELETE", messages_url(q), [204])?)
}

/// A queue SAS URL over HTTPS with the letters of `raup` (Go's
/// GetSASURL), signed with the client's account key.
pub fn (q: QueueClient) get_sas_url(permissions: Str, expiry: Time, start: Time? = None) -> Str ! Str {
  let cred = q.core.cred ?? return Err(queueerror.MISSING_SHARED_KEY_CREDENTIAL)
  let parts = parse_url(q.url)?
  let qps = sas.QueueSignatureValues{version: sas.VERSION, protocol: sas.PROTOCOL_HTTPS, start: start, expiry: Some(expiry), permissions: permissions, queue_name: parts.queue_name}.sign_with_shared_key(cred)?
  Ok("${q.url}?${qps.encode()}")
}
