// A response value with a control byte reads in an error as Go's
// strconv.Quote writes it (a local Go program on azqueue v1.0.1 gives
// `strconv.ParseInt: parsing "1\t2": invalid syntax`).

use std/http

test "a count with a tab is quoted in the error as Go quotes it" {
  os.net.handle("GET http://quote.queue.example.test/q1", fn(req: http.Request) -> http.Response {
    http.text(200, "").with_header("x-ms-approximate-messages-count", "1\t2")
  })
  let q = new_queue_client_with_no_credential(os.net, os.clock, os.rand, "http://quote.queue.example.test/q1", ClientOptions{})
  match q.get_properties() {
    Err(Decode(m)) => expect(m) == "strconv.ParseInt: parsing \"1\\t2\": invalid syntax"
    _ => fault("want the ParseInt error")
  }
}
