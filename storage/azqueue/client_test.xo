
test "a list page's URL with a SAS is Go's: the query sorted, a space in the marker as +" {
  // azqueue v1.0.1's two pages, from a local Go program
  let o = ListQueuesOptions{include_metadata: true, max_results: Some(2), prefix: Some("q")}
  let base = "https://acct1.queue.example.test/?sv=2025-05-05&sig=a%2Bb%3D"
  expect(list_url(base, o, None)) == "https://acct1.queue.example.test/?comp=list&include=metadata&maxresults=2&prefix=q&sig=a%2Bb%3D&sv=2025-05-05"
  expect(list_url(base, o, Some("/acct1/q 2"))) == "https://acct1.queue.example.test/?comp=list&include=metadata&marker=%2Facct1%2Fq+2&maxresults=2&prefix=q&sig=a%2Bb%3D&sv=2025-05-05"
}
