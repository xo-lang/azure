// storage's shared.IsIPEndpointStyle, for the storage modules'
// URLParts. Go's url.Parse, URL.String and strconv.Quote are azcore's
// (azcore/gourl.xo).

use std/netip

/// shared.IsIPEndpointStyle: the host, its port removed, is an IP address
/// (Go's net.ParseIP, which takes no zone).
pub fn is_ip_endpoint(host: Str) -> Bool {
  if host == "" {
    return false
  }
  var h = host
  if h.starts_with("[") {
    if let Some(j) = h.find("]") { h = h[1..j] }
  } else if let Some(j) = h.rfind(":") {
    if !h[0..j].contains(":") { h = h[0..j] }
  }
  match netip.parse_addr(h) {
    Ok(a) => a.zone == ""
    Err(_) => false
  }
}
