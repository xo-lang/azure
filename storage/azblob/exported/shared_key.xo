// Storage Shared Key authorization, as azblob's SharedKeyCredential and
// SharedKeyCredPolicy (internal/exported/shared_key_credential.go, MIT,
// Copyright (c) Microsoft Corporation; NOTICE.md): the HMAC-SHA256 of
// the verb, 11 standard headers (Date left empty: x-ms-date is sent),
// the `x-ms-` headers in the service's culture-aware order, and the
// canonicalized resource.

use std/base64
use std/crypto
use std/http
use std/time
use std/url
use github.com/xo-lang/azure/policy

/// An account name and its key.
pub struct SharedKeyCredential {
  pub account_name: Str
  key: Secret[Bytes]
}

/// The credential of `account_name` with `account_key`, the base64 key
/// the portal shows.
pub fn new_shared_key_credential(account_name: Str, account_key: Str) -> SharedKeyCredential ! Str {
  let key = base64.decode(account_key) ?? e => return Err("the account key is not base64: ${e.display()}")
  Ok(SharedKeyCredential{account_name: account_name, key: Secret.new(key)})
}

/// The credential with another key (key rotation).
pub fn (c: SharedKeyCredential) with_account_key(account_key: Str) -> SharedKeyCredential ! Str {
  new_shared_key_credential(c.account_name, account_key)
}

/// The base64 HMAC-SHA256 of `message` with the account key (SAS
/// signatures use it too).
pub fn (c: SharedKeyCredential) compute_hmac_sha256(message: Str) -> Str {
  base64.encode(crypto.hmac_sha256(c.key.reveal(), message.bytes()))
}

/// The string the signature covers. `plain_order` sorts the `x-ms-`
/// headers byte by byte, as azqueue's copy of this code does (azblob
/// uses the service's culture-aware order).
pub fn (c: SharedKeyCredential) string_to_sign(req: policy.Request, plain_order: Bool = false) -> Str ! Str {
  let h = fn(name: Str) -> Str { req.header(name) ?? "" }
  let len = match req.header("Content-Length") {
    Some(n) => n
    None => "${req.body.len()}"
  }
  let resource = c.canonicalized_resource(req.url)?
  Ok([
    req.method,
    h("Content-Encoding"),
    h("Content-Language"),
    if len == "0" { "" } else { len },
    h("Content-MD5"),
    h("Content-Type"),
    "",
    h("If-Modified-Since"),
    h("If-Match"),
    h("If-None-Match"),
    h("If-Unmodified-Since"),
    h("Range"),
    canonicalized_headers(req.headers, plain_order),
    resource,
  ].join("\n"))
}

/// The `x-ms-` headers, lowercased, in the service's order (byte order
/// with `plain_order`), as `name:value` lines (values of a repeated
/// header joined by `,`).
pub fn canonicalized_headers(headers: List[(Str, Str)], plain_order: Bool = false) -> Str {
  var names: List[Str] = []
  var values: Map[Str, List[Str]] = {}
  for (k, v) in headers {
    let n = k.trim().to_lower()
    if n.starts_with("x-ms-") {
      if !values.contains(n) {
        names.push(n)
        values[n] = []
      }
      values[n] = (values.get(n) ?? []) + [v]
    }
  }
  names = if plain_order { names.sort() } else { sort_headers(names) }
  names.map(fn(n: Str) -> Str { "${n}:${(values.get(n) ?? []).join(",")}" }).join("\n")
}

/// `/<account><escaped path>` and the query's parameters, lowercased
/// and sorted, one `\nname:v1,v2` each with the values sorted.
fn (c: SharedKeyCredential) canonicalized_resource(raw: Str) -> Str ! Str {
  let (path, query) = split_url(raw)
  var cr = "/${c.account_name}${if path == "" { "/" } else { path }}"
  if query != "" {
    let params = url.parse_query(query) ?? e => return Err("the query cannot be parsed: ${e.display()}")
    for name in params.keys().sort() {
      cr = cr + "\n${name.to_lower()}:${params.all(name).sort().join(",")}"
    }
  }
  Ok(cr)
}

/// The escaped path and the raw query of an absolute URL.
fn split_url(raw: Str) -> (Str, Str) {
  let no_frag = raw[0..(raw.find("#") ?? raw.len())]
  let (before, query) = match no_frag.find("?") {
    Some(i) => (no_frag[0..i], no_frag[i + 1..no_frag.len()])
    None => (no_frag, "")
  }
  let after = (before.find("://") ?? -3) + 3
  let path = match before[after..before.len()].find("/") {
    Some(i) => before[after + i..before.len()]
    None => ""
  }
  (path, query)
}

/// The service's header order (azblob's weight tables): at the first
/// level `-` and `'` weigh nothing, at the second they decide ties.
pub fn sort_headers(names: List[Str]) -> List[Str] {
  var out = names
  // insertion sort: a handful of headers
  var i = 1
  while i < out.len() {
    var j = i
    while j > 0 && compare_headers(out[j], out[j - 1]) < 0 {
      let t = out[j]
      out[j] = out[j - 1]
      out[j - 1] = t
      j -= 1
    }
    i += 1
  }
  out
}

const LEVEL0: List[Int] = [
  0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
  0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
  0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x71c, 0x0, 0x71f, 0x721, 0x723, 0x725,
  0x0, 0x0, 0x0, 0x72d, 0x803, 0x0, 0x0, 0x733, 0x0, 0xd03, 0xd1a, 0xd1c, 0xd1e,
  0xd20, 0xd22, 0xd24, 0xd26, 0xd28, 0xd2a, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
  0xe02, 0xe09, 0xe0a, 0xe1a, 0xe21, 0xe23, 0xe25, 0xe2c, 0xe32, 0xe35, 0xe36, 0xe48, 0xe51,
  0xe70, 0xe7c, 0xe7e, 0xe89, 0xe8a, 0xe91, 0xe99, 0xe9f, 0xea2, 0xea4, 0xea6, 0xea7, 0xea9,
  0x0, 0x0, 0x0, 0x743, 0x744, 0x748, 0xe02, 0xe09, 0xe0a, 0xe1a, 0xe21, 0xe23, 0xe25,
  0xe2c, 0xe32, 0xe35, 0xe36, 0xe48, 0xe51, 0xe70, 0xe7c, 0xe7e, 0xe89, 0xe8a, 0xe91, 0xe99,
  0xe9f, 0xea2, 0xea4, 0xea6, 0xea7, 0xea9, 0x0, 0x74c, 0x0, 0x750, 0x0,
]

const LEVEL2: List[Int] = [
  0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
  0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
  0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x8012, 0x0, 0x0, 0x0, 0x0, 0x0, 0x8212, 0x0, 0x0,
  0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
  0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
  0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
  0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
  0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0,
]

fn weight(level: Int, s: Bytes, i: Int) -> Int {
  if i >= s.len() {
    return 0x1
  }
  let t = if level == 0 { LEVEL0 } else { LEVEL2 }
  let b = Int(s[i])
  if b < t.len() { t[b] } else { 0x0 }
}

/// azblob's compareHeaders, step for step.
pub fn compare_headers(lhs: Str, rhs: Str) -> Int {
  let l = lhs.bytes()
  let r = rhs.bytes()
  var level = 0
  var i = 0
  var j = 0
  while level < 2 {
    if level == 1 && i != j {
      return if i > j { -1 } else if i < j { 1 } else { 0 }
    }
    let w1 = weight(level, l, i)
    let w2 = weight(level, r, j)
    if w1 == 0x1 && w2 == 0x1 {
      i = 0
      j = 0
      level += 1
    } else if w1 == w2 {
      i += 1
      j += 1
    } else if w1 == 0 {
      i += 1
    } else if w2 == 0 {
      j += 1
    } else {
      return if w1 < w2 { -1 } else { 1 }
    }
  }
  0
}

/// The Shared Key policy: sets x-ms-date when the request has none,
/// then the Authorization header.
pub struct SharedKeyPolicy {
  pub credential: SharedKeyCredential
  pub clock: Clock
  /// Sort the `x-ms-` headers byte by byte (azqueue's signer).
  pub plain_header_order: Bool = false
}

pub fn shared_key_policy(credential: SharedKeyCredential, clock: Clock) -> SharedKeyPolicy {
  SharedKeyPolicy{credential: credential, clock: clock}
}

/// The x-ms-date value for `t` (`Mon, 02 Jan 2006 15:04:05 GMT`).
pub fn http_date(t: Time) -> Str {
  time.format(t, time.utc(), time.RFC1123).replace(" UTC", " GMT")
}

fn (p: SharedKeyPolicy) send(req: policy.Request, next: policy.Next) -> http.Response ! policy.SendErr uses (net.dial, clock, rand) {
  let dated = if (req.header("x-ms-date") ?? "") == "" { req.with_header("x-ms-date", http_date(p.clock.now())) } else { req }
  let sts = p.credential.string_to_sign(dated, p.plain_header_order) ?? e => return Err(policy.SendErr.Auth("Shared Key: ${e}"))
  next.send(dated.with_header("Authorization", "SharedKey ${p.credential.account_name}:${p.credential.compute_hmac_sha256(sts)}"))
}
