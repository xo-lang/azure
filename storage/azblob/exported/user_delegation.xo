// The user delegation credential, as azblob's UserDelegationCredential
// (MIT, Copyright (c) Microsoft Corporation; NOTICE.md): a key the
// service gives an Entra ID identity (GetUserDelegationKey), used to
// sign user delegation SAS.

use std/base64
use std/crypto

/// A user delegation key, as the service returns it.
pub struct UserDelegationKey {
  pub signed_oid: Str
  pub signed_tid: Str
  pub signed_start: Time
  pub signed_expiry: Time
  /// `b` for Blob.
  pub signed_service: Str
  pub signed_version: Str
  /// The base64 key.
  pub value: Secret[Str]
  /// The delegated user's tenant (`SignedDelegatedUserTid`; azfile signs
  /// it as `skdutid`), "" when the key has none.
  pub signed_delegated_user_tenant_id: Str = ""
}

pub struct UserDelegationCredential {
  pub account_name: Str
  pub key: UserDelegationKey
}

pub fn new_user_delegation_credential(account_name: Str, key: UserDelegationKey) -> UserDelegationCredential {
  UserDelegationCredential{account_name: account_name, key: key}
}

/// The base64 HMAC-SHA256 of `message` with the delegation key.
pub fn (c: UserDelegationCredential) compute_hmac_sha256(message: Str) -> Str ! Str {
  let k = base64.decode(c.key.value.reveal()) ?? e => return Err("the user delegation key is not base64: ${e.display()}")
  Ok(base64.encode(crypto.hmac_sha256(k, message.bytes())))
}
