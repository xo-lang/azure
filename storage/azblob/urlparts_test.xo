// parse_url and URLParts.to_url against Go's azblob.ParseURL and
// URLParts.String (urlvectors_test.xo).

use github.com/xo-lang/azure/azcore

test "parse_url and to_url are Go's ParseURL and URLParts.String" {
  var out: List[Str] = []
  for (name, u) in BLOB_URL_CASES {
    out.push("== ${name}")
    match parse_url(u) {
      Ok(up) => {
        let q = azcore.go_quote
        out.push("  scheme=${q(up.scheme)} host=${q(up.host)} ip_account=${q(up.ip_account_name)} container=${q(up.container_name)} blob=${q(up.blob_name)} snapshot=${q(up.snapshot)} version=${q(up.version_id)} unparsed=${q(up.unparsed_params)}")
        out.push("  encode=${q(up.sas.encode())}")
        out.push("  string=${q(up.to_url())}")
      }
      Err(e) => out.push("  error ${e}")
    }
  }
  // the first difference, for a readable failure
  for i in 0..out.len() {
    if i < BLOB_URL_OUTPUT.len() && out[i] != BLOB_URL_OUTPUT[i] {
      expect(out[i]) == BLOB_URL_OUTPUT[i]
      break
    }
  }
  expect(out.len()) == BLOB_URL_OUTPUT.len()
}

fn with_line(kind: Str, op: Str, r: Result[Str, Str]) -> Str {
  match r {
    Ok(u) => "  ${kind} ${op} ${azcore.go_quote(u)}"
    Err(e) => "  ${kind} ${op} error ${e}"
  }
}

test "with_snapshot and with_version_id are Go's WithSnapshot and WithVersionID" {
  let snap = "2026-01-02T03:04:05.0000000Z"
  let ver = "2026-01-02T03:04:05.1234567Z"
  var out: List[Str] = []
  for (name, u) in BLOB_URL_CASES {
    out.push("== ${name}")
    let b = new_blob_client_with_no_credential(os.net, os.clock, os.rand, u)
    out.push(with_line("blob", "snapshot", b.with_snapshot(snap).map(fn(c) { c.url })))
    out.push(with_line("blob", "nosnapshot", b.with_snapshot("").map(fn(c) { c.url })))
    out.push(with_line("blob", "version", b.with_version_id(ver).map(fn(c) { c.url })))
    let a = new_append_blob_client_with_no_credential(os.net, os.clock, os.rand, u)
    out.push(with_line("append", "snapshot", a.with_snapshot(snap).map(fn(c) { c.url })))
    out.push(with_line("append", "version", a.with_version_id(ver).map(fn(c) { c.url })))
    let p = new_page_blob_client_with_no_credential(os.net, os.clock, os.rand, u)
    out.push(with_line("page", "snapshot", p.with_snapshot(snap).map(fn(c) { c.url })))
    out.push(with_line("page", "version", p.with_version_id(ver).map(fn(c) { c.url })))
    let k = new_block_blob_client_with_no_credential(os.net, os.clock, os.rand, u)
    out.push(with_line("block", "snapshot", k.with_snapshot(snap).map(fn(c) { c.url })))
    out.push(with_line("block", "version", k.with_version_id(ver).map(fn(c) { c.url })))
  }
  for i in 0..out.len() {
    if i < WITH_URL_OUTPUT.len() && out[i] != WITH_URL_OUTPUT[i] {
      expect(out[i]) == WITH_URL_OUTPUT[i]
      break
    }
  }
  expect(out.len()) == WITH_URL_OUTPUT.len()
}
