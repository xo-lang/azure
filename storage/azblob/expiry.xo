// A block or append blob's expiry, as azblob v1.8.3's blockblob and
// appendblob Client.SetExpiry with exported.ExpiryType (MIT, Copyright
// (c) Microsoft Corporation; NOTICE.md).

use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/storage/azblob/exported

/// When a blob expires (Go's ExpiryType).
pub enum ExpiryType {
  /// At this time (ExpiryTypeAbsolute).
  Absolute(at: Time)
  /// This long from now, in whole milliseconds (ExpiryTypeRelativeToNow).
  RelativeToNow(after: Duration)
  /// This long from the blob's creation, in whole milliseconds
  /// (ExpiryTypeRelativeToCreation).
  RelativeToCreation(after: Duration)
  /// Never (ExpiryTypeNever, Go's default for a nil ExpiryType).
  Never
}

/// Go's time.Duration.Milliseconds: truncated toward zero.
fn whole_millis(d: Duration) -> Str {
  "${d.nanos() / 1000000}"
}

fn expiry_headers(e: ExpiryType) -> List[(Str, Str)] {
  match e {
    Absolute(t) => [("x-ms-expiry-option", "Absolute"), ("x-ms-expiry-time", exported.http_date(t))]
    RelativeToNow(d) => [("x-ms-expiry-option", "RelativeToNow"), ("x-ms-expiry-time", whole_millis(d))]
    RelativeToCreation(d) => [("x-ms-expiry-option", "RelativeToCreation"), ("x-ms-expiry-time", whole_millis(d))]
    Never => [("x-ms-expiry-option", "NeverExpire")]
  }
}

fn set_expiry_call[fx: Effects](core: Core[fx], e: ExpiryType) -> ETagResponse ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  Ok(etag_response(core.send(Call{method: "PUT", query: [("comp", "expiry")], headers: expiry_headers(e), ok: [200]})?))
}

/// Sets when the blob expires (blockblob.Client.SetExpiry). The account
/// must have a hierarchical namespace.
pub fn (b: BlockBlobClient[fx]) set_expiry(expiry: ExpiryType = ExpiryType.Never) -> ETagResponse ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  set_expiry_call(b.blob_client().core, expiry)
}

/// Sets when the blob expires (appendblob.Client.SetExpiry).
pub fn (a: AppendBlobClient[fx]) set_expiry(expiry: ExpiryType = ExpiryType.Never) -> ETagResponse ! azcore.CallErr uses (net.dial, clock, rand, fx) {
  set_expiry_call(a.blob_client().core, expiry)
}
