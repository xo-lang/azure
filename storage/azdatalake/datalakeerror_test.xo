// datalakeerror.has_code on the errors the clients return, after the
// DFS rename (the lease fake of lease_test.xo answers).

use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/storage/azdatalake/datalakeerror

test "has_code matches the renamed codes a client returns" {
  let log = serve(os.net, dl_lease_answer)
  let cred = new_shared_key_credential("acct1", BKEY)?
  let opts = go_options("")
  let fs = new_file_system_client_with_shared_key_credential(os.net, os.clock, os.rand, "${DEP}/missing", cred, opts)
  let e1 = new_file_system_lease_client(os.rand, fs, Some("l1")).acquire_lease(15).err() ?? fault("no error")
  expect(datalakeerror.has_code(e1, [datalakeerror.FILE_SYSTEM_NOT_FOUND])) == true
  expect(datalakeerror.has_code(e1, [datalakeerror.PATH_NOT_FOUND, datalakeerror.FILE_SYSTEM_NOT_FOUND])) == true
  expect(datalakeerror.has_code(e1, [datalakeerror.PATH_NOT_FOUND])) == false
  expect(datalakeerror.has_code(e1, [])) == false
  let f = new_file_client_with_shared_key_credential(os.net, os.clock, os.rand, "${DEP}/fs1/missing.txt", cred, opts)
  let e2 = new_file_lease_client(os.rand, f, Some("q1")).renew_lease().err() ?? fault("no error")
  expect(datalakeerror.has_code(e2, [datalakeerror.PATH_NOT_FOUND])) == true
  expect(datalakeerror.has_code(e2, [datalakeerror.BLOB_NOT_FOUND])) == false
  expect(datalakeerror.has_code(azcore.CallErr.InvalidInput(datalakeerror.MISSING_PARAMETERS), [datalakeerror.PATH_NOT_FOUND])) == false
  drain(log)
}

test "the error constants are Go's" {
  expect(datalakeerror.LEASE_ID_MISMATCH_WITH_FILE_SYSTEM_OPERATION) == "LeaseIdMismatchWithFileSystemOperation"
  expect(datalakeerror.INVALID_SOURCE_URI) == "InvalidSourceUri"
  expect(datalakeerror.CRC64_MISMATCH) == "Crc64Mismatch"
  expect(MISSING_SHARED_KEY_CREDENTIAL) == datalakeerror.MISSING_SHARED_KEY_CREDENTIAL
}
