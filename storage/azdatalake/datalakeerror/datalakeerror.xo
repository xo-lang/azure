// Data Lake's error codes, as azdatalake v1.7.1's datalakeerror package
// (error_codes.go; MIT, Copyright (c) Microsoft Corporation; NOTICE.md).
// The blob codes are as the clients report them, after Go's DFS rename
// (`Blob` to `Path`, `Container` to `FileSystem`), Go's list kept as it
// is (`BlobNotFound` too).

use github.com/xo-lang/azure/azcore

/// Whether `err` is a response whose error code is one of `codes`
/// (datalakeerror.HasCode).
pub fn has_code(err: azcore.CallErr, codes: List[Str]) -> Bool {
  match err {
    Response(r) => codes.contains(r.error_code)
    _ => false
  }
}

/// A SAS URL asked of a client without an account key
/// (datalakeerror.MissingSharedKeyCredential, azblob's).
pub const MISSING_SHARED_KEY_CREDENTIAL: Str = "SAS can only be signed with a SharedKeyCredential"

/// A set_access_control with nothing to set (datalakeerror.MissingParameters).
pub const MISSING_PARAMETERS: Str = "at least one parameter should be set for SetAccessControl API"

/// A precomputed checksum on a multipart upload
/// (datalakeerror.UnsupportedChecksum; the ported uploads take none).
pub const UNSUPPORTED_CHECKSUM: Str = "for multi-part uploads, user generated checksums cannot be validated"

