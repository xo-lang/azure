// The directory and file clients against a fake that answers as the Go
// program's fake does (pathvectors_test.xo).

use std/http
use std/testing
use github.com/xo-lang/azure/policy

const PATH_GO_DATE: Str = "Fri, 06 Nov 2026 15:05:22 GMT"

const REC_PAGE0: Str = "{\"directoriesSuccessful\":2,\"filesSuccessful\":3,\"failureCount\":0,\"failedEntries\":[]}"
const REC_PAGE1: Str = "{\"directoriesSuccessful\":1,\"filesSuccessful\":4,\"failureCount\":2,\"failedEntries\":[{\"errorMessage\":\"denied\",\"name\":\"rec/a\",\"type\":\"FILE\"},{\"errorMessage\":\"busy\",\"name\":\"rec/b\",\"type\":\"DIRECTORY\"}]}"
const REC_PAGE2: Str = "{\"directoriesSuccessful\":5,\"filesSuccessful\":6,\"failureCount\":0}"
const RECERR_PAGE0: Str = "{\"directoriesSuccessful\":1,\"filesSuccessful\":1,\"failureCount\":1,\"failedEntries\":[{\"errorMessage\":\"x\",\"name\":\"recerr/z\",\"type\":\"FILE\"}]}"
const REC2_PAGE0: Str = "{\"directoriesSuccessful\":1,\"filesSuccessful\":0,\"failureCount\":1,\"failedEntries\":[{\"errorMessage\":\"m1\",\"name\":\"rec2/a\",\"type\":\"FILE\"}]}"
const REC2_PAGE1: Str = "{\"directoriesSuccessful\":0,\"filesSuccessful\":2,\"failureCount\":1,\"failedEntries\":[{\"errorMessage\":\"m2\",\"name\":\"rec2/b\",\"type\":\"FILE\"}]}"
const NOFAIL_PAGE: Str = "{\"directoriesSuccessful\":0,\"filesSuccessful\":1,\"failureCount\":0}"
const ONE_FILE_PAGE: Str = "{\"directoriesSuccessful\":0,\"filesSuccessful\":1,\"failureCount\":0,\"failedEntries\":[]}"
const TAGS_XML: Str = "<?xml version=\"1.0\" encoding=\"utf-8\"?><Tags><TagSet><Tag><Key>a</Key><Value>1</Value></Tag><Tag><Key>b</Key><Value>2</Value></Tag></TagSet></Tags>"

fn path_answer(req: http.Request) -> http.Response {
  let q = fn(k: Str) -> Str { req.url.query.get(k) ?? "" }
  let p = req.url.path
  let last = match p.rfind("/") {
    Some(i) => p[i + 1..p.len()]
    None => p
  }
  let common = [("x-ms-request-id", "r1"), ("x-ms-version", "2026-06-06"), ("Date", BDATE), ("x-ms-client-request-id", "echo-1")]
  let stamp = [("ETag", "\"0x8D9\""), ("Last-Modified", "Thu, 05 Nov 2026 03:00:00 GMT")]
  let empty = fn(status: Int, hs: List[(Str, Str)]) -> http.Response { with_hs(http.empty(status), common + hs) }
  if p.contains("missing") {
    return empty(404, [("x-ms-error-code", "BlobNotFound")])
  }
  let m = req.method
  if q("action") == "setAccessControlRecursive" {
    let c = q("continuation")
    if last == "recerr" && c == "e1" {
      return empty(409, [("x-ms-error-code", "ContainerBeingDeleted")])
    }
    let next = if last == "rec" && c == "" { "k1" } else if last == "rec" && c == "k1" { "k2" } else if last == "recerr" && c == "" { "e1" } else if last == "rec2" && c == "" { "j1" } else { "" }
    let page = if last == "rec" && c == "" { REC_PAGE0 } else if last == "rec" && c == "k1" { REC_PAGE1 } else if last == "rec" && c == "k2" { REC_PAGE2 } else if last == "recerr" && c == "" { RECERR_PAGE0 } else if last == "rec2" && c == "" { REC2_PAGE0 } else if last == "rec2" && c == "j1" { REC2_PAGE1 } else if last == "nofail.txt" { NOFAIL_PAGE } else { ONE_FILE_PAGE }
    let hs = [("Content-Type", "application/json;charset=utf-8")] + (if next == "" { [] } else { [("x-ms-continuation", next)] })
    return with_hs(http.text(200, page), common + hs)
  }
  if q("action") == "setAccessControl" {
    return empty(200, stamp)
  }
  if m == "HEAD" && q("action") != "" {
    return empty(200, stamp + [
      ("x-ms-owner", "o1"), ("x-ms-group", "g1"), ("x-ms-permissions", "rwxr-x---+"), ("x-ms-acl", "user::rwx,group::r-x,other::---"),
      ("x-ms-resource-type", "directory"), ("x-ms-properties", "k=dg=="), ("Content-Length", "0"), ("Content-MD5", "AQID"),
      ("x-ms-server-encrypted", "true"), ("x-ms-creation-time", "Mon, 02 Nov 2026 01:02:03 GMT"), ("x-ms-expiry-time", "Sun, 08 Nov 2026 01:02:03 GMT"),
      ("x-ms-lease-state", "available"), ("x-ms-encryption-context", "ctx"),
    ])
  }
  if m == "HEAD" {
    return empty(200, stamp + [
      ("x-ms-owner", "o2"), ("x-ms-group", "g2"), ("x-ms-permissions", "rw-r-----"), ("x-ms-acl", "user::rw-"), ("x-ms-resource-type", "file"),
      ("x-ms-encryption-context", "ctx2"), ("Content-Length", "12"), ("Content-Type", "text/plain"), ("Content-MD5", "AQID"),
      ("x-ms-blob-type", "BlockBlob"), ("x-ms-meta-color", "blue"), ("x-ms-lease-status", "unlocked"), ("x-ms-access-tier", "Hot"),
      ("x-ms-access-tier-inferred", "true"), ("x-ms-server-encrypted", "true"), ("x-ms-creation-time", "Mon, 02 Nov 2026 01:02:03 GMT"),
      ("x-ms-expiry-time", "Sun, 08 Nov 2026 01:02:03 GMT"), ("x-ms-tag-count", "2"),
    ])
  }
  if m == "PUT" && q("comp") == "expiry" {
    return empty(200, stamp)
  }
  if m == "PUT" && q("comp") == "metadata" {
    return empty(200, stamp + [("x-ms-request-server-encrypted", "true"), ("x-ms-version-id", "v9")])
  }
  if m == "PUT" && q("comp") == "properties" {
    return empty(200, stamp + [("x-ms-blob-sequence-number", "4")])
  }
  if m == "PUT" && q("comp") == "tags" {
    return empty(204, [])
  }
  if m == "GET" && q("comp") == "tags" {
    return with_hs(http.text(200, TAGS_XML), common + [("Content-Type", "application/xml")])
  }
  if m == "PUT" && last == "ok200" {
    return empty(200, [])
  }
  if m == "PUT" {
    let enc = if last == "badbool" { "yes" } else { "true" }
    let rn = if q("mode") == "legacy" { [("x-ms-continuation", "rn1")] } else { [] }
    return empty(201, stamp + [("Content-Length", "0"), ("x-ms-request-server-encrypted", enc), ("x-ms-encryption-key-sha256", "k256")] + rn)
  }
  if m == "DELETE" {
    let c = if last == "d1" && q("continuation") == "" { [("x-ms-continuation", "del 1+")] } else if last == "f.txt" { [("x-ms-continuation", "fc")] } else { [] }
    return empty(200, c + [("x-ms-deletion-id", "132")])
  }
  empty(400, [])
}

fn path_urls(name: Str, dfs: Str, blob: Str) -> List[Str] {
  ["== ${name}", "  DFSURL=${dfs}", "  BlobURL=${blob}"]
}

fn create_dump(x: CreatePathResponse) -> Dump {
  var d = Dump{}
  d.r(x.response)
  d.i("ContentLength", x.content_length)
  d.s("Continuation", x.continuation)
  d.s("ETag", x.etag)
  d.s("EncryptionKeySHA256", x.encryption_key_sha256)
  d.b("IsServerEncrypted", x.is_server_encrypted)
  d.t("LastModified", x.last_modified)
  d
}

/// Go's RenameResponse: a create's, without the client request ID.
fn rename_dump(x: CreatePathResponse) -> Dump {
  create_dump(x with {response: x.response with {client_request_id: None}})
}

fn delete_dump(x: DeletePathResponse) -> Dump {
  var d = Dump{}
  d.r(x.response)
  d.s("Continuation", x.continuation)
  d.s("DeletionID", x.deletion_id)
  d.s("XMSContinuation", x.continuation)
  d.s("XMSRequestID", x.response.request_id)
  d.s("XMSVersion", x.response.version)
  d
}

