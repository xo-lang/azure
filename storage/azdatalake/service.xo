use github.com/xo-lang/azure/azcore
use github.com/xo-lang/azure/storage/azblob

pub type StorageServiceProperties = azblob.StorageServiceProperties
pub type ServicePropertiesResponse = azblob.ServicePropertiesResponse
pub type RetentionPolicy = azblob.RetentionPolicy
pub type Metrics = azblob.Metrics
pub type Logging = azblob.Logging
pub type CorsRule = azblob.CorsRule
pub type StaticWebsite = azblob.StaticWebsite

/// A client of one account's Data Lake service.
pub struct ServiceClient {
  /// The service's dfs URL.
  pub dfs_url: Str
  /// The service's blob URL.
  pub blob_url: Str
  service: azblob.ServiceClient
}

fn service_of(service_url: Str, blob: fn(Str) -> azblob.ServiceClient) -> ServiceClient {
  let (blob_url, dfs_url) = get_urls(service_url)
  ServiceClient{dfs_url: dfs_url, blob_url: blob_url, service: blob(blob_url)}
}

/// A service client with Entra ID tokens (service.NewClient);
/// `service_url` may be the dfs or the blob URL.
pub fn new_service_client(net: Net, clock: Clock, rand: Rand, service_url: Str, cred: azcore.TokenCredential, options: ClientOptions = ClientOptions{}) -> ServiceClient {
  service_of(service_url, fn(u: Str) -> azblob.ServiceClient { azblob.new_service_client(net, clock, rand, u, cred, blob_options(options)) })
}

pub fn new_service_client_with_shared_key_credential(net: Net, clock: Clock, rand: Rand, service_url: Str, cred: SharedKeyCredential, options: ClientOptions = ClientOptions{}) -> ServiceClient {
  service_of(service_url, fn(u: Str) -> azblob.ServiceClient { azblob.new_service_client_with_shared_key_credential(net, clock, rand, u, cred, blob_options(options)) })
}

pub fn new_service_client_with_no_credential(net: Net, clock: Clock, rand: Rand, service_url: Str, options: ClientOptions = ClientOptions{}) -> ServiceClient {
  service_of(service_url, fn(u: Str) -> azblob.ServiceClient { azblob.new_service_client_with_no_credential(net, clock, rand, u, blob_options(options)) })
}

pub fn new_service_client_from_connection_string(net: Net, clock: Clock, rand: Rand, connection_string: Str, options: ClientOptions = ClientOptions{}) -> ServiceClient ! Str {
  let p = azblob.parse_connection_string(connection_string)?
  if p.account_key != "" && p.account_name != "" {
    return Ok(new_service_client_with_shared_key_credential(net, clock, rand, p.service_url, new_shared_key_credential(p.account_name, p.account_key)?, options))
  }
  Ok(new_service_client_with_no_credential(net, clock, rand, p.service_url, options))
}

/// The client of the file system `file_system_name`, its name joined to
/// the URLs unescaped, as Go joins it.
pub fn (s: ServiceClient) new_file_system_client(file_system_name: Str) -> FileSystemClient {
  let (blob_url, dfs_url) = get_urls(join_paths(s.dfs_url, file_system_name))
  FileSystemClient{dfs_url: dfs_url, blob_url: blob_url, container: s.service.new_container_client(file_system_name)}
}

pub fn (s: ServiceClient) create_file_system(file_system_name: Str, options: CreateFileSystemOptions = CreateFileSystemOptions{}) -> ETagResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  s.new_file_system_client(file_system_name).create(options)
}

pub fn (s: ServiceClient) delete_file_system(file_system_name: Str, options: DeleteFileSystemOptions = DeleteFileSystemOptions{}) -> Response ! azcore.CallErr uses (net.dial, clock, rand) {
  s.new_file_system_client(file_system_name).delete(options)
}

pub fn (s: ServiceClient) get_properties() -> ServicePropertiesResponse ! azcore.CallErr uses (net.dial, clock, rand) {
  s.service.get_properties().map_err(to_dfs_error)
}

/// Sets the service's properties, with azblob's (Go's) defaults.
pub fn (s: ServiceClient) set_properties(properties: StorageServiceProperties = StorageServiceProperties{}) -> Response ! azcore.CallErr uses (net.dial, clock, rand) {
  s.service.set_properties(properties).map_err(to_dfs_error)
}
