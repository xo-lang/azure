use github.com/xo-lang/azure/policy
use github.com/xo-lang/azure/runtime

/// Options of new_authentication_client.
pub struct AuthenticationClientOptions[fx: Effects] {
  pub client: policy.ClientOptions[fx] = policy.ClientOptions{}
}

/// AuthenticationClient: the registry's token exchange (`/oauth2/...`).
pub struct AuthenticationClient[fx: Effects] {
  setup: Setup[fx]
}

/// A client of the registry at `endpoint`'s token exchange, which
/// authorizes nothing itself (NewAuthenticationClient).
pub fn new_authentication_client[fx: Effects](net: Net, clock: Clock, rand: Rand, endpoint: Str, options: AuthenticationClientOptions[fx] = AuthenticationClientOptions{}) -> AuthenticationClient[fx] {
  let pl = runtime.new_pipeline(MODULE, VERSION, net, clock, rand, runtime.PipelineOptions{}, options.client)
  AuthenticationClient{setup: Setup{pipeline: pl, endpoint: endpoint}}
}
